/*!
 * \file dirichlet.asc
 * \brief Dirichlet-distribution sampling operator for Ascend NPU (dav-3510)
 *
 * torch._sample_dirichlet(alpha) equivalent, exposed functionally:
 *   ops_multimodal_fusion.dirichlet(alpha, seed) -> Tensor (shape/dtype of alpha)
 *
 * The last dimension K is the event/simplex axis: each contiguous row of K
 * elements is one concentration vector and produces one point on the
 * probability simplex (row >= 0, row sums to 1). The input IS read.
 *
 * Algorithm (PyTorch _s_dirichlet, Distributions.cpp + Distributions.cu):
 *   g_i  = sample_gamma(alpha_i)            // Marsaglia-Tsang, per element
 *   S    = sum_j g_j                        // reduce over the last dim
 *   x_i  = clamp(g_i / S, [min_value, max_value])
 *          min_value = numeric_limits<T>::min()   (smallest positive normal)
 *          max_value = nexttoward((T)1, 0)        (largest representable < 1)
 *
 * The per-element gamma sampler is identical to csrc/gamma (Marsaglia-Tsang,
 * Distributions.h sample_gamma), so its validated __simd_vf__ forms
 * are reused verbatim (CastHalfToFloat / CastFloatToHalf / Preproc / NormalR
 * / Theta / AcceptStep). Only log/sqrt/pow + a normal draw -- NO lgamma --
 * so the whole sampler is RegBase; pow(a,b)=exp(b*ln a), normal via
 * Box-Muller (sqrt/ln + adv_api cos). The SIMD adaptation is the same as
 * gamma: a fixed MAX_REJ rejection loop with a persistent per-lane "done"
 * flag (MaskReg cannot persist across __simd_vf__ calls). Per-step accept
 * prob ~0.94, MAX_REJ=24 truncation prob ~1e-29 (negligible; documented).
 *
 * Dirichlet adds only the normalization layer: a per-row Reg::Reduce<SUM>
 * (mirrors csrc/rms_norm_gated ReduceSumRegVf) and a broadcast divide +
 * two-sided clamp (Reg::Div / Maxs / Mins, the cauchy clamp form).
 *
 * Tiling is one row per ProcessRow. When K fits UB, the full aligned row is
 * resident; otherwise a streaming two-pass tile path runs: pass 1 accumulates
 * S = sum(gamma samples) over K tiles, pass 2 resamples gamma (same Philox
 * counters) and writes clamp(g/S). DMA in/out is contiguous per tile.
 *
 * alpha==0 component: sample_gamma returns 0 -> g clamped to FLT_MIN ->
 * after normalization the component is clamped to min_value (matches
 * PyTorch). K==1: S==g, x = clamp(1, ...) = max_value. alpha<0 / NaN:
 * PyTorch is lenient/UB; rejected on host per the repo convention.
 * PhiloxRandom counter->element map differs from PyTorch curand, so
 * acceptance is structural (simplex) + statistical (moments), never
 * bit-exact; see tests/dirichlet/test_dirichlet.py.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "adv_api/math/philox.h"
#include "adv_api/math/cos.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Dirichlet {

constexpr float kFloor = 1.1754944e-38f;            // FLT_MIN (ln guard + clamp)
constexpr float kTwoPi = 6.28318530717958647692f;
constexpr int64_t MAX_REJ = 24;                     // rejection-step cap

// PyTorch _s_dirichlet clamps in the OUTPUT dtype to
//   [numeric_limits<T>::min(), nexttoward((T)1, 0)].
// Hardcoded per dtype (no <cmath>/<limits> in this kernel TU, matching the
// gamma kFloor convention):
//   fp32: FLT_MIN = 1.17549435e-38 ;  largest float < 1 = 1-2^-24
//   fp16: smallest normal = 2^-14   ;  largest half  < 1 = 1-2^-11
// fp16 clamp is applied in the float domain then downcast; 0.99951172f
// rounds to the half 0x3BFF (= nexttoward((half)1,0)).
constexpr float kF32Min   = 1.1754944e-38f;
constexpr float kF32MaxLt1 = 0.99999994f;
constexpr float kF16Min   = 6.1035156e-05f;
constexpr float kF16MaxLt1 = 0.99951172f;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("dirichlet(Tensor alpha, int seed=0) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor dirichlet_meta(const torch::Tensor &alpha, int64_t seed)
{
    (void)seed;
    TORCH_CHECK(alpha.scalar_type() == torch::kFloat32 ||
                alpha.scalar_type() == torch::kFloat16,
                "dirichlet: only float32 and float16 are supported on dav-3510, got ",
                alpha.scalar_type());
    TORCH_CHECK(alpha.dim() >= 1,
                "dirichlet: alpha must have at least 1 dimension (the last dim is the simplex axis)");
    return torch::empty_like(alpha);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("dirichlet", dirichlet_meta);
}

// ===================== 3. Tiling =====================

// One row (K elements) per ProcessRow. bufElems is either the aligned row
// length (when it fits UB) or the largest vec-aligned tile that fits UB for
// the streaming two-pass path over large K.
static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t numRows, int64_t rowLen, int64_t elemSize)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t SCRATCH_FLOATS = 8;   // aL,scale,d,c,done,res,ua,ub
    constexpr static int64_t VEC_WIDTH = 64;       // VECTOR_REG_WIDTH/sizeof(float)
    constexpr static int64_t PHILOX_CAP = 32768; // PhiloxRandom count is uint16_t
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "dirichlet: coreNum must be positive.");

    // 32B scalar slot for the per-row reduce result (LoadAlign reads a full
    // vector register, so allocate one register width).
    int64_t sBufBytes = VEC_WIDTH * static_cast<int64_t>(sizeof(float));
    int64_t bytesPerBufElem = PIPELINE_DEPTH * 2 * elemSize +
        SCRATCH_FLOATS * static_cast<int64_t>(sizeof(float));

    int64_t maxBufElems = (static_cast<int64_t>(ubSize) - sBufBytes) / bytesPerBufElem;
    maxBufElems = (maxBufElems / VEC_WIDTH) * VEC_WIDTH;
    maxBufElems = std::max(maxBufElems, VEC_WIDTH);
    if (maxBufElems > PHILOX_CAP) {
        maxBufElems = (PHILOX_CAP / VEC_WIDTH) * VEC_WIDTH;
    }
    TORCH_CHECK(maxBufElems > 0,
        "dirichlet: UB too small for one tile (need at least ", VEC_WIDTH, " elems)");

    int64_t alignedRow = ((rowLen + VEC_WIDTH - 1) / VEC_WIDTH) * VEC_WIDTH;
    int64_t needFullRow = alignedRow * bytesPerBufElem + sBufBytes;
    int64_t bufElems = (needFullRow <= static_cast<int64_t>(ubSize)) ? alignedRow : maxBufElems;
    TORCH_CHECK(bufElems <= PHILOX_CAP,
        "dirichlet: tile size too large (", bufElems, " > ", PHILOX_CAP, " Philox cap)");

    int64_t numBlocks = std::min(coreNum, numRows);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockRows = (numRows + numBlocks - 1) / numBlocks;
    return std::make_tuple(numBlocks, blockRows, bufElems);
}

// ===================== 4. Kernel =====================

// --- gamma sampler vf forms: reused verbatim from csrc/gamma (validated) ---

// half -> float (fp16 alpha input).
__simd_vf__ inline void CastHalfToFloatRegVf(__ubuf__ float *dstAddr, __ubuf__ half *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, half, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastHalfToFloatReg(AscendC::LocalTensor<float> &dst,
                                          AscendC::LocalTensor<half> &src, int64_t count)
{
    __ubuf__ float *d = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ half *s = (__ubuf__ half *)src.GetPhyAddr();
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<CastHalfToFloatRegVf>(d, s, ec, (ec + vl - 1) / vl);
}

// float -> half (fp16 output).
__simd_vf__ inline void CastFloatToHalfRegVf(__ubuf__ half *dstAddr, __ubuf__ float *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<half> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<half, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastFloatToHalfReg(AscendC::LocalTensor<half> &dst,
                                          AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ half *d = (__ubuf__ half *)dst.GetPhyAddr();
    __ubuf__ float *s = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<CastFloatToHalfRegVf>(d, s, ec, (ec + vl - 1) / vl);
}

// Preprocess: alpha<1 boost, d, c, done/result init (verbatim from gamma).
//   scale = (0<a<1) ? exp(ln(max(1-u0,FLT_MIN))/a) : 1
//   aEff  = (0<a<1) ? a+1 : a ;  d = aEff-1/3 ;  c = 1/sqrt(9 d)
//   done  = (a==0) ? 1 : 0 ;  result = 0
__simd_vf__ inline void PreprocRegVf(__ubuf__ float *aAddr, __ubuf__ float *u0Addr,
                                     __ubuf__ float *scaleAddr, __ubuf__ float *dAddr,
                                     __ubuf__ float *cAddr, __ubuf__ float *doneAddr,
                                     __ubuf__ float *resAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> aReg, u0Reg, oneReg, zeroReg, tmpReg, tmp2Reg;
    AscendC::Reg::RegTensor<float> scaleReg, aEffReg, dReg, cReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(aReg, aAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(u0Reg, u0Addr + offset);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::MaskReg gt0, lt1, boost, isZero;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(gt0, aReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(lt1, aReg, 1.0f, mask);
        AscendC::Reg::And(boost, gt0, lt1, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(isZero, aReg, 0.0f, mask);
        AscendC::Reg::Muls(tmpReg, u0Reg, -1.0f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, 1.0f, mask);          // 1-u0
        AscendC::Reg::Maxs(tmpReg, tmpReg, kFloor, mask);
        AscendC::Reg::Ln(tmpReg, tmpReg, mask);                  // ln(1-u0)
        AscendC::Reg::Div(tmp2Reg, tmpReg, aReg, mask);          // ln / a
        AscendC::Reg::Exp(tmp2Reg, tmp2Reg, mask);               // pow(1-u0,1/a)
        AscendC::Reg::Select(scaleReg, tmp2Reg, oneReg, boost);  // boost? .. : 1
        AscendC::Reg::Adds(tmpReg, aReg, 1.0f, mask);
        AscendC::Reg::Select(aEffReg, tmpReg, aReg, boost);      // aEff = boost? a+1 : a
        AscendC::Reg::Adds(dReg, aEffReg, -0.33333333f, mask);   // d = aEff - 1/3
        AscendC::Reg::Muls(tmpReg, dReg, 9.0f, mask);
        AscendC::Reg::Sqrt(tmpReg, tmpReg, mask);
        AscendC::Reg::Div(cReg, oneReg, tmpReg, mask);           // c = 1/sqrt(9 d)
        AscendC::Reg::Select(tmpReg, oneReg, zeroReg, isZero);   // done = isZero? 1 : 0
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(scaleAddr + offset, scaleReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dAddr + offset, dReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(cAddr + offset, cReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(doneAddr + offset, tmpReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(resAddr + offset, zeroReg, mask);
    }
}

__aicore__ inline void PreprocReg(AscendC::LocalTensor<float> &a, AscendC::LocalTensor<float> &u0,
    AscendC::LocalTensor<float> &scale, AscendC::LocalTensor<float> &d,
    AscendC::LocalTensor<float> &c, AscendC::LocalTensor<float> &done,
    AscendC::LocalTensor<float> &res, int64_t count)
{
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<PreprocRegVf>((__ubuf__ float *)a.GetPhyAddr(), (__ubuf__ float *)u0.GetPhyAddr(),
        (__ubuf__ float *)scale.GetPhyAddr(), (__ubuf__ float *)d.GetPhyAddr(),
        (__ubuf__ float *)c.GetPhyAddr(), (__ubuf__ float *)done.GetPhyAddr(),
        (__ubuf__ float *)res.GetPhyAddr(), ec, (ec + vl - 1) / vl);
}

// Box-Muller radius in place: uA = sqrt(-2 ln(max(uA,FLT_MIN))).
__simd_vf__ inline void NormalRRegVf(__ubuf__ float *uAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> r;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(r, uAddr + offset);
        AscendC::Reg::Maxs(r, r, kFloor, mask);
        AscendC::Reg::Ln(r, r, mask);
        AscendC::Reg::Muls(r, r, -2.0f, mask);
        AscendC::Reg::Sqrt(r, r, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(uAddr + offset, r, mask);
    }
}

__aicore__ inline void NormalRReg(AscendC::LocalTensor<float> &u, int64_t count)
{
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<NormalRRegVf>((__ubuf__ float *)u.GetPhyAddr(), ec, (ec + vl - 1) / vl);
}

// theta = 2*pi*u in place (prep for adv_api cos).
__simd_vf__ inline void ThetaRegVf(__ubuf__ float *uAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> t;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(t, uAddr + offset);
        AscendC::Reg::Muls(t, t, kTwoPi, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(uAddr + offset, t, mask);
    }
}

__aicore__ inline void ThetaReg(AscendC::LocalTensor<float> &u, int64_t count)
{
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<ThetaRegVf>((__ubuf__ float *)u.GetPhyAddr(), ec, (ec + vl - 1) / vl);
}

// One Marsaglia-Tsang rejection step (verbatim from gamma). x = R*cosTheta;
// y = 1+c*x; accept = (y>0) && ( u < 1-0.0331 x^4 || ln u < 0.5 x^2 +
// d(1-v+ln v) ), v=y^3, u=1-u3. result/done latched on first accept
// (nested Select + Or, no Reg::Not).
__simd_vf__ inline void AcceptStepRegVf(__ubuf__ float *resAddr, __ubuf__ float *doneAddr,
    __ubuf__ float *rAddr, __ubuf__ float *cosAddr, __ubuf__ float *u3Addr,
    __ubuf__ float *dAddr, __ubuf__ float *cAddr, __ubuf__ float *scaleAddr,
    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> R, cs, u3, dR, cR, scR, res, doneF;
    AscendC::Reg::RegTensor<float> x, y, v, u, xx, t1, t2, cand, inner;
    AscendC::Reg::RegTensor<float> oneReg, zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(R, rAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(cs, cosAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(u3, u3Addr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(dR, dAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(cR, cAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(scR, scaleAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(res, resAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(doneF, doneAddr + offset);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::MaskReg doneM;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(doneM, doneF, 0.5f, mask);
        AscendC::Reg::Mul(x, R, cs, mask);                       // x = R*cos
        AscendC::Reg::Mul(t1, cR, x, mask);
        AscendC::Reg::Adds(y, t1, 1.0f, mask);                   // y = 1 + c*x
        AscendC::Reg::MaskReg yPos;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(yPos, y, 0.0f, mask);
        AscendC::Reg::Mul(v, y, y, mask);
        AscendC::Reg::Mul(v, v, y, mask);                        // v = y^3
        AscendC::Reg::Muls(u, u3, -1.0f, mask);
        AscendC::Reg::Adds(u, u, 1.0f, mask);                    // u = 1 - u3
        AscendC::Reg::Mul(xx, x, x, mask);                       // xx = x^2
        AscendC::Reg::Mul(t1, xx, xx, mask);
        AscendC::Reg::Muls(t1, t1, -0.0331f, mask);
        AscendC::Reg::Adds(t1, t1, 1.0f, mask);                  // 1 - 0.0331 x^4
        AscendC::Reg::MaskReg sq;
        AscendC::Reg::Compare<float, AscendC::CMPMODE::LT>(sq, u, t1, mask);
        AscendC::Reg::Maxs(t2, v, kFloor, mask);
        AscendC::Reg::Ln(t2, t2, mask);                          // ln v
        AscendC::Reg::Muls(t1, v, -1.0f, mask);
        AscendC::Reg::Adds(t1, t1, 1.0f, mask);                  // 1 - v
        AscendC::Reg::Add(t1, t1, t2, mask);                     // 1 - v + ln v
        AscendC::Reg::Mul(t1, dR, t1, mask);                     // d(1-v+ln v)
        AscendC::Reg::Muls(t2, xx, 0.5f, mask);
        AscendC::Reg::Add(t1, t1, t2, mask);                     // rhs
        AscendC::Reg::Maxs(t2, u, kFloor, mask);
        AscendC::Reg::Ln(t2, t2, mask);                          // ln u
        AscendC::Reg::MaskReg lg;
        AscendC::Reg::Compare<float, AscendC::CMPMODE::LT>(lg, t2, t1, mask);
        AscendC::Reg::MaskReg acc;
        AscendC::Reg::Or(acc, sq, lg, mask);
        AscendC::Reg::And(acc, yPos, acc, mask);                 // acc = yPos && (sq||lg)
        AscendC::Reg::Mul(cand, scR, dR, mask);
        AscendC::Reg::Mul(cand, cand, v, mask);                  // cand = scale*d*v
        AscendC::Reg::Select(inner, cand, res, acc);             // acc? cand : res
        AscendC::Reg::Select(res, res, inner, doneM);            // done? res : inner
        AscendC::Reg::MaskReg doneN;
        AscendC::Reg::Or(doneN, doneM, acc, mask);
        AscendC::Reg::Select(doneF, oneReg, zeroReg, doneN);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(resAddr + offset, res, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(doneAddr + offset, doneF, mask);
    }
}

__aicore__ inline void AcceptStepReg(AscendC::LocalTensor<float> &res, AscendC::LocalTensor<float> &done,
    AscendC::LocalTensor<float> &r, AscendC::LocalTensor<float> &cosT, AscendC::LocalTensor<float> &u3,
    AscendC::LocalTensor<float> &d, AscendC::LocalTensor<float> &c, AscendC::LocalTensor<float> &scale,
    int64_t count)
{
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<AcceptStepRegVf>((__ubuf__ float *)res.GetPhyAddr(), (__ubuf__ float *)done.GetPhyAddr(),
        (__ubuf__ float *)r.GetPhyAddr(), (__ubuf__ float *)cosT.GetPhyAddr(),
        (__ubuf__ float *)u3.GetPhyAddr(), (__ubuf__ float *)d.GetPhyAddr(),
        (__ubuf__ float *)c.GetPhyAddr(), (__ubuf__ float *)scale.GetPhyAddr(),
        ec, (ec + vl - 1) / vl);
}

// --- Dirichlet normalization layer ---

// Per-row reduce-sum S = sum_{j<count} g_j (mirrors rms_norm_gated
// ReduceSumRegVf). Reduce<SUM,ZEROING>: out-of-range lanes contribute 0, so
// the [count, bufElems) padding is excluded; the SUM ZEROING semantics are
// identity-safe (unlike Reduce<MIN>). Scalar written to sAddr (slot is one
// full vector register so LoadAlign on read stays in-bounds).
__simd_vf__ inline void ReduceSumRegVf(
    __ubuf__ float *sAddr, __ubuf__ float *gAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> gReg;
    AscendC::Reg::RegTensor<float> reduceReg;

    AscendC::Reg::Duplicate<float>(sumReg, 0.0f, scalarMask);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(gReg, gAddr + offset);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float, AscendC::Reg::MaskMergeMode::ZEROING>(
            reduceReg, gReg, mask);
        AscendC::Reg::Add(sumReg, sumReg, reduceReg, scalarMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(sAddr, sumReg, scalarMask);
}

__aicore__ inline void ReduceSumReg(
    AscendC::LocalTensor<float> &s, AscendC::LocalTensor<float> &g, int64_t count)
{
    __ubuf__ float *sAddr = (__ubuf__ float *)s.GetPhyAddr();
    __ubuf__ float *gAddr = (__ubuf__ float *)g.GetPhyAddr();
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<ReduceSumRegVf>(sAddr, gAddr, ec, (ec + vl - 1) / vl);
}

__simd_vf__ inline void InitScalarZeroRegVf(__ubuf__ float *sAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, scalarMask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        sAddr, zeroReg, scalarMask);
}

__aicore__ inline void InitScalarZero(AscendC::LocalTensor<float> &s)
{
    asc_vf_call<InitScalarZeroRegVf>((__ubuf__ float *)s.GetPhyAddr());
}

// Accumulate sum_{j<count} g_j into *sAddr (for streaming pass 1).
__simd_vf__ inline void AccReduceSumRegVf(
    __ubuf__ float *sAddr, __ubuf__ float *gAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> gReg;
    AscendC::Reg::RegTensor<float> reduceReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(sumReg, sAddr);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(gReg, gAddr + offset);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float, AscendC::Reg::MaskMergeMode::ZEROING>(
            reduceReg, gReg, mask);
        AscendC::Reg::Add(sumReg, sumReg, reduceReg, scalarMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(sAddr, sumReg, scalarMask);
}

__aicore__ inline void AccReduceSumReg(
    AscendC::LocalTensor<float> &s, AscendC::LocalTensor<float> &g, int64_t count)
{
    __ubuf__ float *sAddr = (__ubuf__ float *)s.GetPhyAddr();
    __ubuf__ float *gAddr = (__ubuf__ float *)g.GetPhyAddr();
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<AccReduceSumRegVf>(sAddr, gAddr, ec, (ec + vl - 1) / vl);
}

// ret = clamp(g / S, [minv, maxv]).  invS computed once (scalar Div), then
// broadcast across the register (Duplicate reg-scalar, rms_norm_gated form);
// per element  g*invS  then two-sided clamp (Maxs/Mins, the cauchy form).
__simd_vf__ inline void NormalizeClampRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *gAddr, __ubuf__ float *sAddr,
    float minv, float maxv, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    uint32_t fullCount = vectorLength;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::UpdateMask<float>(fullCount);
    AscendC::Reg::RegTensor<float> sReg, oneReg, invReg, invBcReg, gReg, dstReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(sReg, sAddr);
    AscendC::Reg::Duplicate<float>(oneReg, 1.0f, scalarMask);
    AscendC::Reg::Div(invReg, oneReg, sReg, scalarMask);             // invS = 1/S
    AscendC::Reg::Duplicate<float>(invBcReg, invReg, fullMask);       // broadcast invS
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(gReg, gAddr + offset);
        AscendC::Reg::Mul(dstReg, gReg, invBcReg, mask);             // g / S
        AscendC::Reg::Maxs(dstReg, dstReg, minv, mask);              // >= min_value
        AscendC::Reg::Mins(dstReg, dstReg, maxv, mask);              // <= max_value
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void NormalizeClampReg(
    AscendC::LocalTensor<float> &dst, AscendC::LocalTensor<float> &g,
    AscendC::LocalTensor<float> &s, float minv, float maxv, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *gAddr = (__ubuf__ float *)g.GetPhyAddr();
    __ubuf__ float *sAddr = (__ubuf__ float *)s.GetPhyAddr();
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<NormalizeClampRegVf>(dstAddr, gAddr, sAddr, minv, maxv, ec, (ec + vl - 1) / vl);
}

template <typename T>
class KernelDirichlet {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;

public:
    __aicore__ inline KernelDirichlet() {}

    __aicore__ inline void Init(GM_ADDR alphaGm, GM_ADDR y, int64_t numRows,
        int64_t rowLen, int64_t blockRows, int64_t bufElems,
        float minv, float maxv, uint32_t key0, uint32_t key1)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        rowLen_ = rowLen;
        bufElems_ = bufElems;
        minv_ = minv;
        maxv_ = maxv;
        rowBase_ = blockRows * blockIdx;
        int64_t rows = numRows - rowBase_;
        if (rows > blockRows) rows = blockRows;
        if (rows < 0) rows = 0;
        rowsThisBlock_ = rows;

        // Element offset of this core's first row (Philox stream is keyed by
        // the global flat element index, exactly as csrc/gamma).
        blockBaseElem_ = rowBase_ * rowLen;
        alphaGm_.SetGlobalBuffer((__gm__ T *)alphaGm + blockBaseElem_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockBaseElem_);

        pipe_.InitBuffer(inQueue_,  PIPELINE_DEPTH, bufElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, PIPELINE_DEPTH, bufElems * sizeof(T));
        pipe_.InitBuffer(tbufA_,     bufElems * sizeof(float));
        pipe_.InitBuffer(tbufScale_, bufElems * sizeof(float));
        pipe_.InitBuffer(tbufD_,     bufElems * sizeof(float));
        pipe_.InitBuffer(tbufC_,     bufElems * sizeof(float));
        pipe_.InitBuffer(tbufDone_,  bufElems * sizeof(float));
        pipe_.InitBuffer(tbufRes_,   bufElems * sizeof(float));
        pipe_.InitBuffer(tbufUa_,    bufElems * sizeof(float));
        pipe_.InitBuffer(tbufUb_,    bufElems * sizeof(float));
        pipe_.InitBuffer(tbufS_, kScalarSlot * sizeof(float));

        key0_ = key0;
        key1_ = key1;
    }

    __aicore__ inline void Process()
    {
        for (int64_t r = 0; r < rowsThisBlock_; ++r) {
            ProcessRow(r);
        }
    }

private:
    __aicore__ inline void RandTile(AscendC::LocalTensor<float> &buf, int64_t cnt,
        uint32_t ctrLo, uint32_t ctrHi, uint32_t w2, uint32_t w3)
    {
        AscendC::PhiloxKey key{key0_, key1_};
        AscendC::PhiloxCounter ctr{ctrLo, ctrHi, w2, w3};
        AscendC::PhiloxRandom<7, float>(buf, key, ctr, static_cast<uint16_t>(cnt));
        AscendC::PipeBarrier<PIPE_V>();
    }

    // Sample gamma for alpha[tileStart : tileStart+tileCount); result in resL.
    __aicore__ inline void SampleGammaTile(int64_t elemOffset, int64_t tileStart, int64_t tileCount)
    {
        int64_t buf = bufElems_;

        AscendC::DataCopyExtParams inP;
        inP.blockCount = 1;
        inP.blockLen = tileCount * sizeof(T);
        inP.srcStride = 0;
        inP.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padP{false, 0, 0, 0};
        AscendC::LocalTensor<T> aIn = inQueue_.template AllocTensor<T>();
        AscendC::DataCopyPad(aIn, alphaGm_[elemOffset + tileStart], inP, padP);
        inQueue_.EnQue(aIn);
        aIn = inQueue_.template DeQue<T>();

        AscendC::LocalTensor<float> aL = tbufA_.Get<float>();
        AscendC::LocalTensor<float> scaleL = tbufScale_.Get<float>();
        AscendC::LocalTensor<float> dL = tbufD_.Get<float>();
        AscendC::LocalTensor<float> cL = tbufC_.Get<float>();
        AscendC::LocalTensor<float> doneL = tbufDone_.Get<float>();
        AscendC::LocalTensor<float> resL = tbufRes_.Get<float>();
        AscendC::LocalTensor<float> uaL = tbufUa_.Get<float>();
        AscendC::LocalTensor<float> ubL = tbufUb_.Get<float>();

        if constexpr (kIsFloat) {
            AscendC::DataCopy(aL, aIn, buf);
        } else {
            CastHalfToFloatReg(aL, aIn, buf);
        }
        inQueue_.FreeTensor(aIn);
        AscendC::PipeBarrier<PIPE_V>();

        int64_t globalElem = blockBaseElem_ + elemOffset + tileStart;
        uint32_t ctrLo = static_cast<uint32_t>(static_cast<uint64_t>(globalElem) & 0xFFFFFFFFu);
        uint32_t ctrHi = static_cast<uint32_t>((static_cast<uint64_t>(globalElem) >> 32) & 0xFFFFFFFFu);

        RandTile(uaL, buf, ctrLo, ctrHi, 0u, 1u);
        PreprocReg(aL, uaL, scaleL, dL, cL, doneL, resL, buf);
        AscendC::PipeBarrier<PIPE_V>();

        for (int64_t j = 0; j < MAX_REJ; ++j) {
            uint32_t base = static_cast<uint32_t>(j) * 3u;
            RandTile(uaL, buf, ctrLo, ctrHi, base + 0u, 0u);
            RandTile(ubL, buf, ctrLo, ctrHi, base + 1u, 0u);
            NormalRReg(uaL, buf);
            ThetaReg(ubL, buf);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cos<float>(ubL, ubL, static_cast<uint32_t>(buf));
            AscendC::PipeBarrier<PIPE_V>();
            RandTile(aL, buf, ctrLo, ctrHi, base + 2u, 0u);
            AcceptStepReg(resL, doneL, uaL, ubL, aL, dL, cL, scaleL, buf);
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void CopyOutTile(int64_t elemOffset, int64_t tileStart, int64_t tileCount,
        AscendC::LocalTensor<float> &resL, AscendC::LocalTensor<float> &sL)
    {
        AscendC::LocalTensor<T> yTile = outQueue_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            NormalizeClampReg(yTile, resL, sL, minv_, maxv_, tileCount);
        } else {
            NormalizeClampReg(resL, resL, sL, minv_, maxv_, tileCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastFloatToHalfReg(yTile, resL, tileCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueue_.EnQue(yTile);
        yTile = outQueue_.template DeQue<T>();
        AscendC::DataCopyExtParams oP;
        oP.blockCount = 1;
        oP.blockLen = tileCount * sizeof(T);
        oP.srcStride = 0;
        oP.dstStride = 0;
        AscendC::DataCopyPad(yGm_[elemOffset + tileStart], yTile, oP);
        outQueue_.FreeTensor(yTile);
    }

    __aicore__ inline void ProcessRow(int64_t rLocal)
    {
        int64_t elemOffset = rLocal * rowLen_;
        int64_t K = rowLen_;
        int64_t buf = bufElems_;

        AscendC::LocalTensor<float> resL = tbufRes_.Get<float>();
        AscendC::LocalTensor<float> sL = tbufS_.Get<float>();

        // Pass 1: accumulate S = sum_i gamma(alpha_i) over K (tiled when K > buf).
        InitScalarZero(sL);
        for (int64_t tileStart = 0; tileStart < K; tileStart += buf) {
            int64_t tileCount = K - tileStart;
            if (tileCount > buf) {
                tileCount = buf;
            }
            SampleGammaTile(elemOffset, tileStart, tileCount);
            AccReduceSumReg(sL, resL, tileCount);
            AscendC::PipeBarrier<PIPE_V>();
        }

        // Pass 2: resample gamma (same Philox counters) and write clamp(g/S).
        for (int64_t tileStart = 0; tileStart < K; tileStart += buf) {
            int64_t tileCount = K - tileStart;
            if (tileCount > buf) {
                tileCount = buf;
            }
            SampleGammaTile(elemOffset, tileStart, tileCount);
            CopyOutTile(elemOffset, tileStart, tileCount, resL, sL);
        }
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    static constexpr int64_t kScalarSlot = 64;   // one vector register width
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> alphaGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufScale_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufD_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufC_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufDone_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRes_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufUa_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufUb_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufS_;
    int64_t rowLen_ = 0;
    int64_t bufElems_ = 0;
    int64_t rowBase_ = 0;
    int64_t rowsThisBlock_ = 0;
    int64_t blockBaseElem_ = 0;
    float minv_ = 0.0f;
    float maxv_ = 1.0f;
    uint32_t key0_ = 0;
    uint32_t key1_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void dirichlet_kernel(
    GM_ADDR alphaGm, GM_ADDR y, int64_t numRows, int64_t rowLen,
    int64_t blockRows, int64_t bufElems, float minv, float maxv,
    uint32_t key0, uint32_t key1)
{
    KernelDirichlet<T> op;
    op.Init(alphaGm, y, numRows, rowLen, blockRows, bufElems, minv, maxv, key0, key1);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor dirichlet_npu(const torch::Tensor &alpha, int64_t seed)
{
    TORCH_CHECK(alpha.scalar_type() == torch::kFloat32 ||
                alpha.scalar_type() == torch::kFloat16,
                "dirichlet: only float32 and float16 are supported on dav-3510, got ",
                alpha.scalar_type());
    TORCH_CHECK(alpha.dim() >= 1,
                "dirichlet: alpha must have at least 1 dimension (the last dim is the simplex axis)");
    if (alpha.numel() > 0) {
        // Concentration must be non-negative (PyTorch is lenient/UB for <0;
        // rejected here per the repo's conservative convention; NaN fails
        // ">= 0" and is rejected too).
        auto ac = alpha.detach().to(torch::kCPU).to(torch::kFloat32);
        TORCH_CHECK(ac.min().item<double>() >= 0.0,
                    "dirichlet expects concentration (alpha) to be non-negative");
    }

    const c10::OptionalDeviceGuard guard(alpha.device());
    auto y = torch::empty_like(alpha);

    int64_t totalLength = y.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t rowLen = alpha.size(-1);
    TORCH_CHECK(rowLen > 0, "dirichlet: the last dimension (simplex axis) must be non-empty");
    int64_t numRows = totalLength / rowLen;

    // Per-dtype clamp bounds (PyTorch _s_dirichlet clamps in the output
    // dtype: [numeric_limits<T>::min(), nexttoward((T)1, 0)]).
    float minv = (alpha.scalar_type() == torch::kFloat32) ? kF32Min : kF16Min;
    float maxv = (alpha.scalar_type() == torch::kFloat32) ? kF32MaxLt1 : kF16MaxLt1;

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockRows, bufElems;
    std::tie(numBlocks, blockRows, bufElems) =
        calc_tiling_params(numRows, rowLen, y.element_size());

    auto a_ptr = (GM_ADDR)alpha.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();
    uint32_t key0 = static_cast<uint32_t>(static_cast<uint64_t>(seed) & 0xFFFFFFFFu);
    uint32_t key1 = static_cast<uint32_t>((static_cast<uint64_t>(seed) >> 32) & 0xFFFFFFFFu);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            alpha.scalar_type(), "dirichlet_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                dirichlet_kernel<float><<<numBlocks, nullptr, stream>>>(
                    a_ptr, y_ptr, numRows, rowLen, blockRows, bufElems,
                    minv, maxv, key0, key1);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                dirichlet_kernel<half><<<numBlocks, nullptr, stream>>>(
                    a_ptr, y_ptr, numRows, rowLen, blockRows, bufElems,
                    minv, maxv, key0, key1);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Dirichlet", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("dirichlet", dirichlet_npu);
}

} // namespace Dirichlet
} // namespace ops_multimodal_fusion
