/*!
 * \file log_normal.asc
 * \brief Log-normal-distribution sampling operator for Ascend NPU (dav-3510)
 *
 * torch.Tensor.log_normal_(mean=1, std=2) equivalent, exposed functionally:
 *   ops_multimodal_fusion.log_normal(x, mean, std, seed) -> Tensor (same shape/dtype/dev)
 *
 * x supplies only shape/dtype/device; its data is NOT read. The output is
 * filled with i.i.d. LogNormal(mean, std) samples:
 *
 *   u1,u2 ~ Uniform[0,1)                   (AscendC::PhiloxRandom, two streams)
 *   R = sqrt( -2 * ln( max(u1, FLT_MIN) ) )            (Box-Muller radius)
 *   Z = R * cos( 2*pi*u2 )                             (standard normal)
 *   Y = Z * std + mean                                 (N(mean, std^2))
 *   X = exp( Y )                                       (log-normal)
 *
 * PyTorch transformation::log_normal(normal(rand,mean,std)) = exp(rand*std+
 * mean) with rand from curand_normal4 (Box-Muller; accscalar_t == float for
 * fp16/fp32). curand is (0,1] so it never hits ln(0); AscendC::PhiloxRandom
 * is [0,1) and can yield exactly 0 (ln(0) = -inf -> R = +inf), so u1 gets a
 * low clamp at FLT_MIN (platform adaptation, same as exponential/geometric);
 * u2 needs no clamp (cos(2*pi*u2) is well defined on all of [0,1)).
 *
 * Box-Muller's two uniforms produce two independent normals (R*cos, R*sin);
 * this kernel uses only the cos branch (2 uniforms -> 1 normal): simplest and
 * statistically correct (the sin branch is a future RNG-halving optimization).
 * u1/u2 are independent substreams: same Philox key, distinct counter (the
 * counter's 3rd word selects the stream) => same seed+shape is deterministic,
 * distinct (core,tile) are disjoint substreams, u1 _|_ u2.
 *
 * cos has no Reg-level primitive on dav-3510, so the adv_api AscendC::Cos
 * kernel is used (non-classic-compute; not hook-blocked), exactly as cauchy
 * uses adv_api AscendC::Tan. Everything else (clamp/ln/sqrt/mul/affine/exp)
 * is all-Reg. RegBase 3-layer shape (__simd_vf__ / asc_vf_call / harness);
 * normal AscendC only for GM/UB movement, queues, sync. Bit-exact match with
 * PyTorch's curand layout is NOT a goal; acceptance is distributional (see
 * tests/log_normal/test_log_normal.py).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "adv_api/math/philox.h"
#include "adv_api/math/cos.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace LogNormal {

// Low guard for u1: [0,1) Philox can yield exactly 0 -> ln(0) = -inf;
// curand (0,1] cannot, so PyTorch omits any clamp. u2 needs no clamp.
constexpr float kFloor = 1.1754944e-38f;
constexpr float kTwoPi = 6.28318530717958647692f;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("log_normal(Tensor x, float mean=1.0, float std=2.0, int seed=0) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor log_normal_meta(const torch::Tensor &x, double mean, double std, int64_t seed)
{
    (void)mean;
    (void)seed;
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "log_normal: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    TORCH_CHECK(std > 0.0,
                "log_normal_ expects std > 0.0, but found std=", std);
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("log_normal", log_normal_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // Per element UB: output queue (double-buffered, T) + 3 float scratch
    // (u1 -> R; u2 -> theta; cos output). fp16 reuses u1 as the float
    // accumulator before the half cast, so no extra buffer.
    constexpr static int64_t SCRATCH_FLOATS = 3;
    // PhiloxRandom count is uint16_t; keep one tile well under 65535.
    constexpr static int64_t MAX_TILE_ELEMS = 32768;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "log_normal: coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t bytesPerElem = PIPELINE_DEPTH * elemSize +
        SCRATCH_FLOATS * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / static_cast<int64_t>(sizeof(float));
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min(tileElems, MAX_TILE_ELEMS);
    TORCH_CHECK(tileElems > 0, "log_normal: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel =====================

// Box-Muller radius, in place: R = sqrt( -2 * ln( max(u1, FLT_MIN) ) ).
__simd_vf__ inline void BoxMullerRRegVf(__ubuf__ float *u1Addr,
                                        uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> rReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(rReg, u1Addr + offset);
        AscendC::Reg::Maxs(rReg, rReg, kFloor, mask);   // u1 >= FLT_MIN
        AscendC::Reg::Ln(rReg, rReg, mask);             // ln(u1) < 0
        AscendC::Reg::Muls(rReg, rReg, -2.0f, mask);    // -2 ln(u1) > 0
        AscendC::Reg::Sqrt(rReg, rReg, mask);           // R = sqrt(-2 ln u1)
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            u1Addr + offset, rReg, mask);
    }
}

__aicore__ inline void BoxMullerRReg(AscendC::LocalTensor<float> &u1, int64_t count)
{
    __ubuf__ float *u1Addr = (__ubuf__ float *)u1.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BoxMullerRRegVf>(u1Addr, elementCount, chunkCount);
}

// theta = 2*pi*u2, in place (prep for adv_api Cos).
__simd_vf__ inline void ScaleThetaRegVf(__ubuf__ float *u2Addr,
                                        uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> tReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(tReg, u2Addr + offset);
        AscendC::Reg::Muls(tReg, tReg, kTwoPi, mask);   // theta = 2*pi*u2
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            u2Addr + offset, tReg, mask);
    }
}

__aicore__ inline void ScaleThetaReg(AscendC::LocalTensor<float> &u2, int64_t count)
{
    __ubuf__ float *u2Addr = (__ubuf__ float *)u2.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ScaleThetaRegVf>(u2Addr, elementCount, chunkCount);
}

// X = exp( (R * cosTheta) * std + mean )   (float in, float out)
__simd_vf__ inline void LogNormalCombineRegVf(__ubuf__ float *dstAddr,
                                              __ubuf__ float *rAddr, __ubuf__ float *cosAddr,
                                              float mean, float std,
                                              uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> rReg;
    AscendC::Reg::RegTensor<float> cReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(rReg, rAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(cReg, cosAddr + offset);
        AscendC::Reg::Mul(rReg, rReg, cReg, mask);      // Z = R * cosTheta ~ N(0,1)
        AscendC::Reg::Muls(rReg, rReg, std, mask);      // Z * std
        AscendC::Reg::Adds(rReg, rReg, mean, mask);     // + mean  => N(mean,std^2)
        AscendC::Reg::Exp(rReg, rReg, mask);            // exp     => log-normal
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, rReg, mask);
    }
}

__aicore__ inline void LogNormalCombineReg(AscendC::LocalTensor<float> &dst,
                                           AscendC::LocalTensor<float> &r,
                                           AscendC::LocalTensor<float> &cosTheta,
                                           float mean, float std, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *rAddr = (__ubuf__ float *)r.GetPhyAddr();
    __ubuf__ float *cosAddr = (__ubuf__ float *)cosTheta.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LogNormalCombineRegVf>(dstAddr, rAddr, cosAddr, mean, std,
        elementCount, chunkCount);
}

// float -> half cast for fp16 output (mirrors cauchy/exponential path).
__simd_vf__ inline void CastFloatToHalfRegVf(__ubuf__ half *dstAddr, __ubuf__ float *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<half> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<half, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastFloatToHalfReg(AscendC::LocalTensor<half> &dst,
                                          AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ half *dstAddr = (__ubuf__ half *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFloatToHalfRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
class KernelLogNormal {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;

public:
    __aicore__ inline KernelLogNormal() {}

    __aicore__ inline void Init(GM_ADDR y, int64_t totalLength, int64_t blockLength,
        int64_t tileElems, uint32_t key0, uint32_t key1, float mean, float std)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        blockBase_ = blockLength * blockIdx;
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockBase_);

        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufU1_,  tileElems * sizeof(float));
        pipe_.InitBuffer(tbufU2_,  tileElems * sizeof(float));
        pipe_.InitBuffer(tbufCos_, tileElems * sizeof(float));

        key0_ = key0;
        key1_ = key1;
        mean_ = mean;
        std_ = std;

        int64_t currentBlockLength = totalLength - blockBase_;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileElems;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
        alignElems_ = 32 / static_cast<int64_t>(sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        // Aligned span used for RNG + Reg (avoids reading uninitialized tail
        // lanes); only `count` elements are stored / copied out.
        int64_t alignedCount = ((count + alignElems_ - 1) / alignElems_) * alignElems_;

        // Global element index of this tile -> 128-bit Philox counter.
        // u1 uses counter word2=0, u2 uses word2=1: same key, distinct
        // counter => independent substreams (u1 _|_ u2); fixed for a given
        // seed+shape => deterministic; distinct (core,tile) => disjoint.
        int64_t globalElem = blockBase_ + offset;
        uint32_t ctrLo = static_cast<uint32_t>(static_cast<uint64_t>(globalElem) & 0xFFFFFFFFu);
        uint32_t ctrHi = static_cast<uint32_t>((static_cast<uint64_t>(globalElem) >> 32) & 0xFFFFFFFFu);
        AscendC::PhiloxKey key{key0_, key1_};
        AscendC::PhiloxCounter ctr1{ctrLo, ctrHi, 0u, 0u};
        AscendC::PhiloxCounter ctr2{ctrLo, ctrHi, 1u, 0u};

        AscendC::LocalTensor<float> u1Local = tbufU1_.Get<float>();
        AscendC::LocalTensor<float> u2Local = tbufU2_.Get<float>();
        AscendC::LocalTensor<float> cosLocal = tbufCos_.Get<float>();

        AscendC::PhiloxRandom<7, float>(u1Local, key, ctr1,
            static_cast<uint16_t>(alignedCount));
        AscendC::PhiloxRandom<7, float>(u2Local, key, ctr2,
            static_cast<uint16_t>(alignedCount));
        AscendC::PipeBarrier<PIPE_V>();

        BoxMullerRReg(u1Local, alignedCount);            // u1 -> R (in place)
        ScaleThetaReg(u2Local, alignedCount);            // u2 -> theta (in place)
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Cos<float>(cosLocal, u2Local, static_cast<uint32_t>(alignedCount));
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            LogNormalCombineReg(yLocal, u1Local, cosLocal, mean_, std_, alignedCount);
        } else {
            // combine in float (reuse u1 buffer), then cast down to half.
            LogNormalCombineReg(u1Local, u1Local, cosLocal, mean_, std_, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastFloatToHalfReg(yLocal, u1Local, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.template DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufU1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufU2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCos_;
    int64_t blockBase_ = 0;
    uint32_t key0_ = 0;
    uint32_t key1_ = 0;
    float mean_ = 1.0f;
    float std_ = 2.0f;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
    int64_t alignElems_ = 8;
};

template <typename T>
__global__ __aicore__ __vector__ void log_normal_kernel(
    GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileElems,
    uint32_t key0, uint32_t key1, float mean, float std)
{
    KernelLogNormal<T> op;
    op.Init(y, totalLength, blockLength, tileElems, key0, key1, mean, std);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor log_normal_npu(const torch::Tensor &x, double mean, double std, int64_t seed)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "log_normal: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    TORCH_CHECK(std > 0.0,
                "log_normal_ expects std > 0.0, but found std=", std);

    const c10::OptionalDeviceGuard guard(x.device());
    auto y = torch::empty_like(x);

    int64_t totalLength = y.numel();
    if (totalLength == 0) {
        return y;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(totalLength, y.element_size());

    auto y_ptr = (GM_ADDR)y.data_ptr();
    uint32_t key0 = static_cast<uint32_t>(static_cast<uint64_t>(seed) & 0xFFFFFFFFu);
    uint32_t key1 = static_cast<uint32_t>((static_cast<uint64_t>(seed) >> 32) & 0xFFFFFFFFu);
    float meanF = static_cast<float>(mean);
    float stdF = static_cast<float>(std);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "log_normal_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                log_normal_kernel<float><<<numBlocks, nullptr, stream>>>(
                    y_ptr, totalLength, blockLength, tileElems,
                    key0, key1, meanF, stdF);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                log_normal_kernel<half><<<numBlocks, nullptr, stream>>>(
                    y_ptr, totalLength, blockLength, tileElems,
                    key0, key1, meanF, stdF);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("LogNormal", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("log_normal", log_normal_npu);
}

} // namespace LogNormal
} // namespace ops_multimodal_fusion
