/*!
 * \file sinc.asc
 * \brief RegBase-form normalized sinc for Ascend NPU (dav-3510)
 *
 * torch.sinc(x) = sin(pi * x) / (pi * x), with sinc(0) = 1.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <tuple>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Sinc {

static constexpr int64_t kBlockBytes = 32;
static constexpr int64_t kMinElemsPerCore = 1024;
static constexpr int64_t kPipelineDepth = 2;
static constexpr int64_t kQueueBuffers = 4;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("sinc(Tensor x) -> Tensor");
}

torch::Tensor sinc_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat16 ||
                x.scalar_type() == torch::kFloat32,
                "sinc: expected Half or Float input on dav-3510 Reg path, got ",
                x.scalar_type());
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("sinc", sinc_meta);
}

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "sinc: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + kMinElemsPerCore - 1) / kMinElemsPerCore);
    numBlocks = std::max<int64_t>(numBlocks, 1);
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / kQueueBuffers / kBlockBytes) * kBlockBytes;
    if (tileBytes < kBlockBytes) {
        tileBytes = kBlockBytes;
    }
    int64_t alignElems = kBlockBytes / elemSize;
    int64_t tileElems = (tileBytes / elemSize / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "sinc: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

#define SINC_EVAL_FROM_FLOAT(OUT_REG, X_REG, MASK) \
    AscendC::Reg::Abs(absReg, X_REG, MASK); \
    AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(infMask, absReg, infValue, MASK); \
    AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, X_REG, X_REG, MASK); \
    AscendC::Reg::Muls(zReg, X_REG, PI, MASK); \
    AscendC::Reg::Abs(absZReg, zReg, MASK); \
    AscendC::Reg::Mul(tReg, zReg, zReg, MASK); \
    AscendC::Reg::Duplicate<float>(smallPolyReg, 1.0f / 6227020800.0f, MASK); \
    AscendC::Reg::Mul(smallPolyReg, smallPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(smallPolyReg, smallPolyReg, -1.0f / 39916800.0f, MASK); \
    AscendC::Reg::Mul(smallPolyReg, smallPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(smallPolyReg, smallPolyReg, 1.0f / 362880.0f, MASK); \
    AscendC::Reg::Mul(smallPolyReg, smallPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(smallPolyReg, smallPolyReg, -1.0f / 5040.0f, MASK); \
    AscendC::Reg::Mul(smallPolyReg, smallPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(smallPolyReg, smallPolyReg, 1.0f / 120.0f, MASK); \
    AscendC::Reg::Mul(smallPolyReg, smallPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(smallPolyReg, smallPolyReg, -1.0f / 6.0f, MASK); \
    AscendC::Reg::Mul(smallPolyReg, smallPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(smallPolyReg, smallPolyReg, 1.0f, MASK); \
    AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(smallMask, absZReg, 0.5f, MASK); \
    AscendC::Reg::Muls(kReg, X_REG, 1.0f, MASK); \
    AscendC::Reg::Adds(kReg, kReg, ROUND_MAGIC, MASK); \
    AscendC::Reg::Adds(kReg, kReg, -ROUND_MAGIC, MASK); \
    AscendC::Reg::Muls(tmpReg, kReg, PI, MASK); \
    AscendC::Reg::Sub(rReg, zReg, tmpReg, MASK); \
    AscendC::Reg::Muls(halfKReg, kReg, 0.5f, MASK); \
    AscendC::Reg::Adds(halfKReg, halfKReg, ROUND_MAGIC, MASK); \
    AscendC::Reg::Adds(halfKReg, halfKReg, -ROUND_MAGIC, MASK); \
    AscendC::Reg::Muls(halfKReg, halfKReg, 2.0f, MASK); \
    AscendC::Reg::Sub(signReg, kReg, halfKReg, MASK); \
    AscendC::Reg::Abs(signReg, signReg, MASK); \
    AscendC::Reg::Muls(signReg, signReg, -2.0f, MASK); \
    AscendC::Reg::Adds(signReg, signReg, 1.0f, MASK); \
    AscendC::Reg::Mul(tReg, rReg, rReg, MASK); \
    AscendC::Reg::Duplicate<float>(sinPolyReg, 1.0f / 362880.0f, MASK); \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(sinPolyReg, sinPolyReg, -1.0f / 5040.0f, MASK); \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(sinPolyReg, sinPolyReg, 1.0f / 120.0f, MASK); \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(sinPolyReg, sinPolyReg, -1.0f / 6.0f, MASK); \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, tReg, MASK); \
    AscendC::Reg::Adds(sinPolyReg, sinPolyReg, 1.0f, MASK); \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, rReg, MASK); \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, signReg, MASK); \
    AscendC::Reg::Div(OUT_REG, sinPolyReg, zReg, MASK); \
    AscendC::Reg::Select<float>(OUT_REG, smallPolyReg, OUT_REG, smallMask); \
    AscendC::Reg::Duplicate<float>(tmpReg, 0.0f, MASK); \
    AscendC::Reg::Select<float>(OUT_REG, tmpReg, OUT_REG, infMask); \
    AscendC::Reg::Select<float>(OUT_REG, X_REG, OUT_REG, nanMask)
__simd_vf__ inline void SincFloatRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    constexpr float PI = 3.14159265358979323846f;
    constexpr float ROUND_MAGIC = 12582912.0f;
    const float infValue = INFINITY;

    AscendC::Reg::RegTensor<float> xReg, outReg, tmpReg;
    AscendC::Reg::RegTensor<float> zReg, absReg, absZReg, tReg, smallPolyReg;
    AscendC::Reg::RegTensor<float> kReg, rReg, signReg, halfKReg, sinPolyReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg smallMask;
        AscendC::Reg::MaskReg infMask;
        AscendC::Reg::MaskReg nanMask;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, srcAddr + offset);
        SINC_EVAL_FROM_FLOAT(outReg, xReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, outReg, mask);
    }
}

__simd_vf__ inline void SincHalfRegVf(
    __ubuf__ half *dstAddr, __ubuf__ half *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    constexpr float PI = 3.14159265358979323846f;
    constexpr float ROUND_MAGIC = 12582912.0f;
    const float infValue = INFINITY;
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    static constexpr AscendC::Reg::CastTrait castFromFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};

    AscendC::Reg::RegTensor<half> srcHalfReg, dstHalfReg;
    AscendC::Reg::RegTensor<float> xReg, outReg, tmpReg;
    AscendC::Reg::RegTensor<float> zReg, absReg, absZReg, tReg, smallPolyReg;
    AscendC::Reg::RegTensor<float> kReg, rReg, signReg, halfKReg, sinPolyReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg smallMask;
        AscendC::Reg::MaskReg infMask;
        AscendC::Reg::MaskReg nanMask;

        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            srcHalfReg, srcAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, srcHalfReg, mask);
        SINC_EVAL_FROM_FLOAT(outReg, xReg, mask);
        AscendC::Reg::Cast<half, float, castFromFloat>(dstHalfReg, outReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstHalfReg, mask);
    }
}

#undef SINC_EVAL_FROM_FLOAT

template <typename T>
__aicore__ inline void SincReg(AscendC::LocalTensor<T> &dst, AscendC::LocalTensor<T> &src, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    if constexpr (std::is_same<T, half>::value) {
        asc_vf_call<SincHalfRegVf>((__ubuf__ half *)dstAddr, (__ubuf__ half *)srcAddr,
                                   elementCount, chunkCount);
    } else {
        asc_vf_call<SincFloatRegVf>((__ubuf__ float *)dstAddr, (__ubuf__ float *)srcAddr,
                                    elementCount, chunkCount);
    }
}

template <typename T>
class KernelSinc {
public:
    __aicore__ inline KernelSinc() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength,
                                int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockIdx * blockLength);

        int64_t tileBytes = ((tileLength_ * static_cast<int64_t>(sizeof(T)) + kBlockBytes - 1) /
                             kBlockBytes) * kBlockBytes;
        pipe_.InitBuffer(inQueue_, kPipelineDepth, tileBytes);
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            ProcessTile(offset, count);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignElems = kBlockBytes / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;

        AscendC::DataCopyExtParams inParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};
        auto inLocal = inQueue_.template AllocTensor<T>();
        AscendC::DataCopyPad(inLocal, xGm_[offset], inParams, padParams);
        inQueue_.EnQue(inLocal);

        inLocal = inQueue_.template DeQue<T>();
        auto outLocal = outQueue_.template AllocTensor<T>();
        SincReg<T>(outLocal, inLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);

        outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyExtParams outParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, outParams);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void sinc_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelSinc<T> op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

torch::Tensor sinc_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat16 ||
                x.scalar_type() == torch::kFloat32,
                "sinc: expected Half or Float input on dav-3510 Reg path, got ",
                x.scalar_type());

    auto input = x.contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) =
        calc_tiling_params(totalLength, input.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();
    auto aclCall = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input.scalar_type(), "sinc_npu",
            AT_DISPATCH_CASE(at::ScalarType::Half, [&] {
                sinc_kernel<half><<<numBlocks, nullptr, stream>>>(
                    xPtr, yPtr, totalLength, blockLength, tileLength);
            })
            AT_DISPATCH_CASE(at::ScalarType::Float, [&] {
                sinc_kernel<float><<<numBlocks, nullptr, stream>>>(
                    xPtr, yPtr, totalLength, blockLength, tileLength);
            }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("SincReg", aclCall);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("sinc", sinc_npu);
}

} // namespace Sinc
} // namespace ops_multimodal_fusion
