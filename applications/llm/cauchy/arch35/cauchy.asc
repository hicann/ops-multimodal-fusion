/*!
 * \file cauchy.asc
 * \brief Cauchy-distribution sampling operator for Ascend NPU (dav-3510)
 *
 * torch.Tensor.cauchy_(median=0, sigma=1) equivalent, exposed functionally:
 *   ops_multimodal_fusion.cauchy(x, median, sigma, seed) -> Tensor (same shape/dtype/device as x)
 *
 * x supplies only shape/dtype/device; its data is NOT read. The output is
 * filled with i.i.d. Cauchy(median, sigma) samples via inverse-transform
 * sampling on a uniform stream:
 *
 *   u ~ Uniform[0,1)                       (AscendC::PhiloxRandom, float)
 *   u = clip(u, eps, 1-eps)                eps = FLT_EPSILON (PyTorch CUDA
 *                                          accscalar_t == float for fp16/fp32)
 *   y = median + sigma * tan(pi*(u-0.5))   (AscendC::Tan, then Reg affine)
 *
 * RegBase compute shape (3 layers): __simd_vf__ Reg functions, __aicore__
 * asc_vf_call wrappers, normal AscendC code only for GM/UB movement, queues,
 * sync. tan() has no Reg-level primitive on dav-3510, so the adv_api
 * AscendC::Tan kernel is used (non-classic-compute; not hook-blocked), exactly
 * as zeta/modified_bessel_k0 mix Reg arithmetic with transcendental helpers.
 *
 * Reproducibility: Philox is counter-based. seed -> PhiloxKey; the per-core,
 * per-tile global element index -> PhiloxCounter. Same seed + same shape =>
 * identical output (deterministic); disjoint counter ranges per core/tile =>
 * independent substreams; different seed => different stream. Bit-exact match
 * with PyTorch's curand layout is NOT a goal (different counter->element map);
 * acceptance is distributional (see tests/cauchy/test_cauchy.py).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "adv_api/math/philox.h"
#include "adv_api/math/tan.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Cauchy {

// FLT_EPSILON; clip bound matches PyTorch transformation::cauchy<float>
// (accscalar_t == float for both fp16 and fp32 on the CUDA path).
constexpr float kCauchyEps = 1.1920928955078125e-7f;
constexpr float kPi = 3.14159265358979323846f;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("cauchy(Tensor x, float median=0.0, float sigma=1.0, int seed=0) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor cauchy_meta(const torch::Tensor &x, double median, double sigma, int64_t seed)
{
    (void)median;
    (void)seed;
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "cauchy: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    TORCH_CHECK(sigma > 0.0,
                "cauchy expects sigma > 0.0, but found sigma=", sigma);
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("cauchy", cauchy_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // Per element UB: output queue (double-buffered, T) + 2 float scratch
    // (tbufU: uniform/theta in-place; tbufTan: tan output). For fp16 the
    // float accumulator reuses tbufU, so no extra buffer.
    constexpr static int64_t SCRATCH_FLOATS = 2;
    // PhiloxRandom count is uint16_t; keep one tile well under 65535.
    constexpr static int64_t MAX_TILE_ELEMS = 32768;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "cauchy: coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t bytesPerElem = PIPELINE_DEPTH * elemSize +
        SCRATCH_FLOATS * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / static_cast<int64_t>(sizeof(float));
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min(tileElems, MAX_TILE_ELEMS);
    TORCH_CHECK(tileElems > 0, "cauchy: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel =====================

// clip u to [eps, 1-eps] then map to angle theta = pi*(u-0.5), in place.
__simd_vf__ inline void CauchyAngleRegVf(__ubuf__ float *uAddr,
                                         uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> uReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(uReg, uAddr + offset);
        AscendC::Reg::Maxs(uReg, uReg, kCauchyEps, mask);
        AscendC::Reg::Mins(uReg, uReg, 1.0f - kCauchyEps, mask);
        AscendC::Reg::Adds(uReg, uReg, -0.5f, mask);
        AscendC::Reg::Muls(uReg, uReg, kPi, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            uAddr + offset, uReg, mask);
    }
}

__aicore__ inline void CauchyAngleReg(AscendC::LocalTensor<float> &u, int64_t count)
{
    __ubuf__ float *uAddr = (__ubuf__ float *)u.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CauchyAngleRegVf>(uAddr, elementCount, chunkCount);
}

// y = median + sigma * tanTheta  (float in, float out)
__simd_vf__ inline void CauchyScaleRegVf(__ubuf__ float *dstAddr, __ubuf__ float *tanAddr,
                                         float median, float sigma,
                                         uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::RegTensor<float> tanReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(tanReg, tanAddr + offset);
        AscendC::Reg::Muls(dstReg, tanReg, sigma, mask);
        AscendC::Reg::Adds(dstReg, dstReg, median, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CauchyScaleReg(AscendC::LocalTensor<float> &dst,
                                      AscendC::LocalTensor<float> &tanTheta,
                                      float median, float sigma, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *tanAddr = (__ubuf__ float *)tanTheta.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CauchyScaleRegVf>(dstAddr, tanAddr, median, sigma, elementCount, chunkCount);
}

// float -> half cast for fp16 output (mirrors zeta's CastFromFloat path).
__simd_vf__ inline void CastFloatToHalfRegVf(__ubuf__ half *dstAddr, __ubuf__ float *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<half> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<half, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastFloatToHalfReg(AscendC::LocalTensor<half> &dst,
                                          AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ half *dstAddr = (__ubuf__ half *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFloatToHalfRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
class KernelCauchy {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;

public:
    __aicore__ inline KernelCauchy() {}

    __aicore__ inline void Init(GM_ADDR y, int64_t totalLength, int64_t blockLength,
        int64_t tileElems, uint32_t key0, uint32_t key1, float median, float sigma)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        blockBase_ = blockLength * blockIdx;
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockBase_);

        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufU_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufTan_, tileElems * sizeof(float));

        key0_ = key0;
        key1_ = key1;
        median_ = median;
        sigma_ = sigma;

        int64_t currentBlockLength = totalLength - blockBase_;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileElems;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
        alignElems_ = 32 / static_cast<int64_t>(sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        // Aligned span used for RNG + Tan + Reg (avoids reading uninitialized
        // tail lanes); only `count` elements are stored / copied out.
        int64_t alignedCount = ((count + alignElems_ - 1) / alignElems_) * alignElems_;

        // Global element index of this tile -> 128-bit Philox counter.
        // Distinct (core, tile) => disjoint counter range => independent
        // substream; fixed for a given seed+shape => deterministic.
        int64_t globalElem = blockBase_ + offset;
        AscendC::PhiloxKey key{key0_, key1_};
        AscendC::PhiloxCounter ctr{
            static_cast<uint32_t>(static_cast<uint64_t>(globalElem) & 0xFFFFFFFFu),
            static_cast<uint32_t>((static_cast<uint64_t>(globalElem) >> 32) & 0xFFFFFFFFu),
            0u, 0u};

        AscendC::LocalTensor<float> uLocal = tbufU_.Get<float>();
        AscendC::LocalTensor<float> tanLocal = tbufTan_.Get<float>();

        AscendC::PhiloxRandom<7, float>(uLocal, key, ctr,
            static_cast<uint16_t>(alignedCount));
        AscendC::PipeBarrier<PIPE_V>();

        CauchyAngleReg(uLocal, alignedCount);          // u -> theta (in place)
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Tan<float>(tanLocal, uLocal, static_cast<uint32_t>(alignedCount));
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            CauchyScaleReg(yLocal, tanLocal, median_, sigma_, alignedCount);
        } else {
            // median + sigma*tan in float, then cast down to half.
            AscendC::LocalTensor<float> accLocal = tbufU_.Get<float>();
            CauchyScaleReg(accLocal, tanLocal, median_, sigma_, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastFloatToHalfReg(yLocal, accLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.template DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufU_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufTan_;
    int64_t blockBase_ = 0;
    uint32_t key0_ = 0;
    uint32_t key1_ = 0;
    float median_ = 0.0f;
    float sigma_ = 1.0f;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
    int64_t alignElems_ = 8;
};

template <typename T>
__global__ __aicore__ __vector__ void cauchy_kernel(
    GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileElems,
    uint32_t key0, uint32_t key1, float median, float sigma)
{
    KernelCauchy<T> op;
    op.Init(y, totalLength, blockLength, tileElems, key0, key1, median, sigma);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor cauchy_npu(const torch::Tensor &x, double median, double sigma, int64_t seed)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "cauchy: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    TORCH_CHECK(sigma > 0.0,
                "cauchy expects sigma > 0.0, but found sigma=", sigma);

    const c10::OptionalDeviceGuard guard(x.device());
    auto y = torch::empty_like(x);

    int64_t totalLength = y.numel();
    if (totalLength == 0) {
        return y;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(totalLength, y.element_size());

    auto y_ptr = (GM_ADDR)y.data_ptr();
    uint32_t key0 = static_cast<uint32_t>(static_cast<uint64_t>(seed) & 0xFFFFFFFFu);
    uint32_t key1 = static_cast<uint32_t>((static_cast<uint64_t>(seed) >> 32) & 0xFFFFFFFFu);
    float medianF = static_cast<float>(median);
    float sigmaF = static_cast<float>(sigma);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "cauchy_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                cauchy_kernel<float><<<numBlocks, nullptr, stream>>>(
                    y_ptr, totalLength, blockLength, tileElems,
                    key0, key1, medianF, sigmaF);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                cauchy_kernel<half><<<numBlocks, nullptr, stream>>>(
                    y_ptr, totalLength, blockLength, tileElems,
                    key0, key1, medianF, sigmaF);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Cauchy", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("cauchy", cauchy_npu);
}

} // namespace Cauchy
} // namespace ops_multimodal_fusion
