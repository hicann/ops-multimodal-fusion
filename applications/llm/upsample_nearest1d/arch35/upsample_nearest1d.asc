/*!
 * \file upsample_nearest1d.asc
 * \brief UpsampleNearest1d forward operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.upsample_nearest1d(input, output_size, scale=-1.0) -> output
 *
 * input       : [N, C, W], fp16/fp32
 * output_size : output width OW
 * scale       : default -1.0 means W / OW; positive values follow PyTorch
 *               scale_factor nearest semantics, using source scale 1 / scale
 *
 * output[n, c, ow] = input[n, c, floor(ow * source_scale)]
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace UpsampleNearest1d {

static constexpr int64_t kScalarSlotBytes = 32;
static constexpr double kMaxInt64AsDouble = 9.2233720368547758e18;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("upsample_nearest1d(Tensor input, int output_size, float scale=-1.) -> Tensor");
}

static void check_common(const torch::Tensor &input, int64_t outputSize, double scale)
{
    TORCH_CHECK(input.dim() == 3,
                "upsample_nearest1d: input must be 3-D [N, C, W], got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "upsample_nearest1d: only float16 and float32 are supported, got ",
                input.scalar_type());
    TORCH_CHECK(input.size(0) > 0 && input.size(1) > 0 && input.size(2) > 0,
                "upsample_nearest1d: N, C, and W must be positive, got ",
                input.sizes());
    TORCH_CHECK(outputSize > 0,
                "upsample_nearest1d: output_size must be positive, got ",
                outputSize);
    TORCH_CHECK(scale == -1.0 || (scale == scale && scale > 0.0 && scale < kMaxInt64AsDouble),
                "upsample_nearest1d: scale must be -1.0 (derive from output_size) "
                "or a finite positive scale_factor, got ", scale);
    if (scale > 0.0) {
        double scaledOutput = static_cast<double>(input.size(2)) * scale;
        TORCH_CHECK(scaledOutput >= 1.0 && scaledOutput < kMaxInt64AsDouble,
                    "upsample_nearest1d: floor(input_width * scale) must be in int64 range, got ",
                    scaledOutput);
        int64_t expectedOutputSize = static_cast<int64_t>(scaledOutput);
        TORCH_CHECK(outputSize == expectedOutputSize,
                    "upsample_nearest1d: when scale_factor is provided, output_size must equal "
                    "floor(input_width * scale_factor); got output_size=", outputSize,
                    ", expected=", expectedOutputSize, " for input_width=", input.size(2),
                    " and scale_factor=", scale);
    }

    const int64_t totalOutput = input.size(0) * input.size(1) * outputSize;
    TORCH_CHECK(totalOutput <= static_cast<int64_t>(0x7fffffff),
                "upsample_nearest1d: output numel exceeds INT32_MAX");
}

torch::Tensor upsample_nearest1d_meta(
    const torch::Tensor &input, int64_t outputSize, double scale)
{
    check_common(input, outputSize, scale);
    return torch::empty({input.size(0), input.size(1), outputSize}, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("upsample_nearest1d", upsample_nearest1d_meta);
}

static int64_t calc_block_count(int64_t totalOutputs)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "upsample_nearest1d: coreNum must be positive");
    return std::max<int64_t>(1, std::min<int64_t>(totalOutputs, coreNum));
}

template <typename T>
__simd_vf__ inline void CopyScalarRegVf(__ubuf__ T *dstAddr, __ubuf__ T *srcAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(scalarCount);
    AscendC::Reg::RegTensor<T> valueReg;
    if constexpr (sizeof(T) == 2) {
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            valueReg, srcAddr);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr, valueReg, mask);
    } else {
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            valueReg, srcAddr);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr, valueReg, mask);
    }
}

template <typename T>
__aicore__ inline void CopyScalarReg(
    AscendC::LocalTensor<T> dstLocal, AscendC::LocalTensor<T> srcLocal)
{
    asc_vf_call<CopyScalarRegVf<T>>(
        (__ubuf__ T *)dstLocal.GetPhyAddr(),
        (__ubuf__ T *)srcLocal.GetPhyAddr());
}

template <typename T>
class KernelUpsampleNearest1d {
public:
    __aicore__ inline KernelUpsampleNearest1d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR output,
        int64_t totalOutputs, int64_t blockLength,
        int64_t inputWidth, int64_t outputWidth,
        float sourceScale)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        totalOutputs_ = totalOutputs;
        blockLength_ = blockLength;
        inputWidth_ = inputWidth;
        outputWidth_ = outputWidth;
        sourceScale_ = sourceScale;

        pipe_.InitBuffer(tbufInput_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufOutput_, static_cast<uint32_t>(kScalarSlotBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
        int64_t start = blockIdx * blockLength_;
        int64_t end = start + blockLength_;
        if (end > totalOutputs_) {
            end = totalOutputs_;
        }
        for (int64_t linear = start; linear < end; ++linear) {
            ComputeOne(linear);
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams()
    {
        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(sizeof(T));
        copy.srcStride = 0;
        copy.dstStride = 0;
        return copy;
    }

    __aicore__ inline void LoadScalar(
        AscendC::LocalTensor<T> local, AscendC::GlobalTensor<T> &gm, int64_t offset)
    {
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(local, gm[offset], CopyParams(), pad);
    }

    __aicore__ inline void StoreScalar(
        AscendC::GlobalTensor<T> &gm, int64_t offset, AscendC::LocalTensor<T> local)
    {
        AscendC::DataCopyPad(gm[offset], local, CopyParams());
    }

    __aicore__ inline int64_t FloorNonNegative(float value, int64_t upper)
    {
        int64_t result = 0;
        while (result < upper && static_cast<float>(result + 1) <= value) {
            ++result;
        }
        return result;
    }

    __aicore__ inline int64_t SourceIndex(int64_t ow)
    {
        if (sourceScale_ > 0.0f) {
            return FloorNonNegative(static_cast<float>(ow) * sourceScale_, inputWidth_ - 1);
        }
        // derive-from-size path: match PyTorch nearest, which computes the source
        // index as (int)(ow * (float)W/OW) in fp32 — NOT integer (ow*W)/OW. The two
        // disagree by one at extreme downsample boundaries (fp32 rounding of W/OW),
        // and the fp32 form is the reference contract the golden mirrors.
        float sizeScale = static_cast<float>(inputWidth_) / static_cast<float>(outputWidth_);
        int64_t iw = static_cast<int64_t>(static_cast<float>(ow) * sizeScale);
        return iw < inputWidth_ ? iw : inputWidth_ - 1;
    }

    __aicore__ inline void ComputeOne(int64_t linear)
    {
        int64_t ow = linear - (linear / outputWidth_) * outputWidth_;
        int64_t plane = linear / outputWidth_;
        int64_t iw = SourceIndex(ow);
        int64_t inputOffset = plane * inputWidth_ + iw;

        auto inputLocal = tbufInput_.template Get<T>();
        auto outputLocal = tbufOutput_.template Get<T>();
        LoadScalar(inputLocal, inputGm_, inputOffset);
        AscendC::PipeBarrier<PIPE_ALL>();
        CopyScalarReg<T>(outputLocal, inputLocal);
        AscendC::PipeBarrier<PIPE_ALL>();
        StoreScalar(outputGm_, linear, outputLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    int64_t totalOutputs_ = 0;
    int64_t blockLength_ = 0;
    int64_t inputWidth_ = 0;
    int64_t outputWidth_ = 0;
    float sourceScale_ = -1.0f;
};

template <typename T>
__global__ __aicore__ __vector__ void upsample_nearest1d_kernel(
    GM_ADDR input, GM_ADDR output,
    int64_t totalOutputs, int64_t blockLength,
    int64_t inputWidth, int64_t outputWidth,
    float sourceScale)
{
    KernelUpsampleNearest1d<T> op;
    op.Init(input, output, totalOutputs, blockLength, inputWidth, outputWidth, sourceScale);
    op.Process();
}

torch::Tensor upsample_nearest1d_npu(
    const torch::Tensor &input, int64_t outputSize, double scale)
{
    check_common(input, outputSize, scale);
    const c10::OptionalDeviceGuard guard(input.device());

    auto inputC = input.contiguous();
    auto output = torch::empty({inputC.size(0), inputC.size(1), outputSize}, inputC.options());

    int64_t totalOutputs = output.numel();
    int64_t numBlocks = calc_block_count(totalOutputs);
    int64_t blockLength = (totalOutputs + numBlocks - 1) / numBlocks;
    int64_t inputWidth = inputC.size(2);
    float sourceScale = (scale > 0.0) ? (1.0f / static_cast<float>(scale)) : -1.0f;

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            inputC.scalar_type(), "upsample_nearest1d_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                upsample_nearest1d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, outputPtr, totalOutputs, blockLength, inputWidth, outputSize,
                    sourceScale);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                upsample_nearest1d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, outputPtr, totalOutputs, blockLength, inputWidth, outputSize,
                    sourceScale);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("UpsampleNearest1d", acl_call);

    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("upsample_nearest1d", upsample_nearest1d_npu);
}

} // namespace UpsampleNearest1d
} // namespace ops_multimodal_fusion
