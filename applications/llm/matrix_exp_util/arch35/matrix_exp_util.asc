/*!
 * \file matrix_exp_util.asc
 * \brief MatrixExpUtil linear-combination helper for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.matrix_exp_util(input, coefficients) -> output
 *
 * input        : [T, *S], fp16/fp32
 * coefficients : [N, T], same dtype as input
 * output       : [N, *S], same dtype as input
 *
 * output[k, ...] = sum_j coefficients[k, j] * input[j, ...]
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>
#include <vector>

namespace ops_multimodal_fusion {
namespace MatrixExpUtil {

static constexpr int64_t kPipelineDepth = 1;
static constexpr int64_t kSafetyBytes = 2048;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("matrix_exp_util(Tensor input, Tensor coefficients) -> Tensor");
}

static void check_common(const torch::Tensor &input, const torch::Tensor &coefficients)
{
    TORCH_CHECK(input.dim() >= 1,
                "matrix_exp_util: input must have rank >= 1, got ", input.dim());
    TORCH_CHECK(coefficients.dim() == 2,
                "matrix_exp_util: coefficients must be 2-D, got ",
                coefficients.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "matrix_exp_util: expected Half or Float input on dav-3510 Reg path, got ",
                input.scalar_type());
    TORCH_CHECK(input.scalar_type() == coefficients.scalar_type(),
                "matrix_exp_util: input and coefficients must have the same dtype, got ",
                input.scalar_type(), " and ", coefficients.scalar_type());

    int64_t t = input.size(0);
    int64_t n = coefficients.size(0);
    TORCH_CHECK(t >= 1, "matrix_exp_util: T must be >= 1, got ", t);
    TORCH_CHECK(n >= 1, "matrix_exp_util: N must be >= 1, got ", n);
    TORCH_CHECK(coefficients.size(1) == t,
                "matrix_exp_util: coefficients.size(1) must match input.size(0); got ",
                coefficients.size(1), " and ", t);
}

static std::vector<int64_t> output_shape(const torch::Tensor &input,
                                         const torch::Tensor &coefficients)
{
    std::vector<int64_t> shape;
    shape.reserve(input.dim());
    shape.push_back(coefficients.size(0));
    for (int64_t i = 1; i < input.dim(); ++i) {
        shape.push_back(input.size(i));
    }
    return shape;
}

torch::Tensor matrix_exp_util_meta(const torch::Tensor &input,
                                   const torch::Tensor &coefficients)
{
    check_common(input, coefficients);
    return torch::empty(output_shape(input, coefficients), input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("matrix_exp_util", matrix_exp_util_meta);
}

static int64_t product_spatial(const torch::Tensor &input)
{
    int64_t innerSize = 1;
    for (int64_t i = 1; i < input.dim(); ++i) {
        innerSize *= input.size(i);
    }
    return innerSize;
}

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t n, int64_t innerSize, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "matrix_exp_util: coreNum must be positive");

    int64_t bytesPerElem = elemSize + elemSize + static_cast<int64_t>(sizeof(float));
    int64_t tileElems = (static_cast<int64_t>(ubSize) - kSafetyBytes - 32) / bytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min<int64_t>(tileElems, 32768);
    TORCH_CHECK(tileElems > 0,
                "matrix_exp_util: UB is too small for one aligned tile");

    int64_t tileCount = (innerSize + tileElems - 1) / tileElems;
    int64_t jobCount = n * tileCount;
    int64_t numBlocks = std::min<int64_t>(coreNum, jobCount);
    numBlocks = std::max<int64_t>(numBlocks, 1);
    int64_t jobsPerBlock = (jobCount + numBlocks - 1) / numBlocks;
    return std::make_tuple(numBlocks, jobsPerBlock, tileElems);
}

__simd_vf__ inline void MatrixExpUtilFloatInitVf(
    __ubuf__ float *accAddr, __ubuf__ float *xAddr,
    float coefficient, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::Muls(xReg, xReg, coefficient, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, xReg, mask);
    }
}

__simd_vf__ inline void MatrixExpUtilFloatStepVf(
    __ubuf__ float *accAddr, __ubuf__ float *xAddr,
    float coefficient, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg;
    AscendC::Reg::RegTensor<float> xReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::Muls(xReg, xReg, coefficient, mask);
        AscendC::Reg::Add(accReg, accReg, xReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__simd_vf__ inline void MatrixExpUtilHalfInitVf(
    __ubuf__ float *accAddr, __ubuf__ half *xAddr,
    float coefficient, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<float> xReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, xHalfReg, mask);
        AscendC::Reg::Muls(xReg, xReg, coefficient, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, xReg, mask);
    }
}

__simd_vf__ inline void MatrixExpUtilHalfStepVf(
    __ubuf__ float *accAddr, __ubuf__ half *xAddr,
    float coefficient, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<float> accReg;
    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<float> xReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, xHalfReg, mask);
        AscendC::Reg::Muls(xReg, xReg, coefficient, mask);
        AscendC::Reg::Add(accReg, accReg, xReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__simd_vf__ inline void MatrixExpUtilCastFloatToHalfVf(
    __ubuf__ half *outAddr, __ubuf__ float *accAddr,
    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> accReg;
    AscendC::Reg::RegTensor<half> outReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::Cast<half, float, castToHalf>(outReg, accReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            outAddr + offset, outReg, mask);
    }
}

__aicore__ inline void MatrixExpUtilFloatInit(
    AscendC::LocalTensor<float> &acc, AscendC::LocalTensor<float> &x,
    float coefficient, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MatrixExpUtilFloatInitVf>(
        (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ float *)x.GetPhyAddr(),
        coefficient, elementCount, chunkCount);
}

__aicore__ inline void MatrixExpUtilFloatStep(
    AscendC::LocalTensor<float> &acc, AscendC::LocalTensor<float> &x,
    float coefficient, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MatrixExpUtilFloatStepVf>(
        (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ float *)x.GetPhyAddr(),
        coefficient, elementCount, chunkCount);
}

__aicore__ inline void MatrixExpUtilHalfInit(
    AscendC::LocalTensor<float> &acc, AscendC::LocalTensor<half> &x,
    float coefficient, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MatrixExpUtilHalfInitVf>(
        (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ half *)x.GetPhyAddr(),
        coefficient, elementCount, chunkCount);
}

__aicore__ inline void MatrixExpUtilHalfStep(
    AscendC::LocalTensor<float> &acc, AscendC::LocalTensor<half> &x,
    float coefficient, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MatrixExpUtilHalfStepVf>(
        (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ half *)x.GetPhyAddr(),
        coefficient, elementCount, chunkCount);
}

__aicore__ inline void MatrixExpUtilCastFloatToHalf(
    AscendC::LocalTensor<half> &out, AscendC::LocalTensor<float> &acc,
    int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MatrixExpUtilCastFloatToHalfVf>(
        (__ubuf__ half *)out.GetPhyAddr(), (__ubuf__ float *)acc.GetPhyAddr(),
        elementCount, chunkCount);
}

template <typename T>
class KernelMatrixExpUtil {
public:
    __aicore__ inline KernelMatrixExpUtil() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR coefficients, GM_ADDR output,
        int64_t t, int64_t n, int64_t innerSize,
        int64_t tileElems, int64_t jobsPerBlock)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        coefficientsGm_.SetGlobalBuffer((__gm__ T *)coefficients);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        t_ = t;
        n_ = n;
        innerSize_ = innerSize;
        tileElems_ = tileElems;
        tileCount_ = (innerSize_ + tileElems_ - 1) / tileElems_;
        jobStart_ = AscendC::GetBlockIdx() * jobsPerBlock;
        jobCount_ = n_ * tileCount_ - jobStart_;
        if (jobCount_ > jobsPerBlock) {
            jobCount_ = jobsPerBlock;
        }
        if (jobCount_ < 0) {
            jobCount_ = 0;
        }

        pipe_.InitBuffer(tbufInput_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufAccum_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufOutput_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufCoefficient_, 32);
        alignElems_ = 32 / static_cast<int64_t>(sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (int64_t localJob = 0; localJob < jobCount_; ++localJob) {
            int64_t job = jobStart_ + localJob;
            int64_t row = job / tileCount_;
            int64_t tile = job - row * tileCount_;
            int64_t innerStart = tile * tileElems_;
            int64_t count = innerSize_ - innerStart;
            if (count > tileElems_) {
                count = tileElems_;
            }
            ProcessTile(row, innerStart, count);
        }
    }

private:
    __aicore__ inline float ReadCoefficient(int64_t row, int64_t j)
    {
        AscendC::LocalTensor<T> coefLocal = tbufCoefficient_.template Get<T>();
        AscendC::DataCopyExtParams copyOne;
        copyOne.blockCount = 1;
        copyOne.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOne.srcStride = 0;
        copyOne.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padOne{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(coefLocal, coefficientsGm_[row * t_ + j], copyOne, padOne);
        AscendC::PipeBarrier<PIPE_ALL>();
        if constexpr (std::is_same<T, half>::value) {
            half value = coefLocal.GetValue(0);
            return static_cast<float>(value);
        } else {
            return coefLocal.GetValue(0);
        }
    }

    __aicore__ inline void ProcessTile(int64_t row, int64_t innerStart, int64_t count)
    {
        int64_t alignedCount = ((count + alignElems_ - 1) / alignElems_) * alignElems_;
        AscendC::LocalTensor<T> inputLocal = tbufInput_.template Get<T>();
        AscendC::LocalTensor<float> accumLocal = tbufAccum_.template Get<float>();

        AscendC::DataCopyExtParams copyInput;
        copyInput.blockCount = 1;
        copyInput.blockLen = static_cast<uint32_t>(count * sizeof(T));
        copyInput.srcStride = 0;
        copyInput.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padInput{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};

        for (int64_t j = 0; j < t_; ++j) {
            float coef = ReadCoefficient(row, j);
            AscendC::DataCopyPad(
                inputLocal, inputGm_[j * innerSize_ + innerStart],
                copyInput, padInput);
            AscendC::PipeBarrier<PIPE_ALL>();

            if constexpr (std::is_same<T, half>::value) {
                if (j == 0) {
                    MatrixExpUtilHalfInit(accumLocal, inputLocal, coef, alignedCount);
                } else {
                    MatrixExpUtilHalfStep(accumLocal, inputLocal, coef, alignedCount);
                }
            } else {
                if (j == 0) {
                    MatrixExpUtilFloatInit(accumLocal, inputLocal, coef, alignedCount);
                } else {
                    MatrixExpUtilFloatStep(accumLocal, inputLocal, coef, alignedCount);
                }
            }
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        AscendC::DataCopyExtParams copyOutput;
        copyOutput.blockCount = 1;
        copyOutput.blockLen = static_cast<uint32_t>(count * sizeof(T));
        copyOutput.srcStride = 0;
        copyOutput.dstStride = 0;
        if constexpr (std::is_same<T, half>::value) {
            AscendC::LocalTensor<half> outLocal = tbufOutput_.template Get<half>();
            MatrixExpUtilCastFloatToHalf(outLocal, accumLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyPad(
                outputGm_[row * innerSize_ + innerStart], outLocal, copyOutput);
        } else {
            AscendC::DataCopyPad(
                outputGm_[row * innerSize_ + innerStart], accumLocal, copyOutput);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> coefficientsGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufAccum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCoefficient_;
    int64_t t_ = 0;
    int64_t n_ = 0;
    int64_t innerSize_ = 0;
    int64_t tileElems_ = 0;
    int64_t tileCount_ = 0;
    int64_t jobStart_ = 0;
    int64_t jobCount_ = 0;
    int64_t alignElems_ = 1;
};

template <typename T>
__global__ __aicore__ __vector__ void matrix_exp_util_kernel(
    GM_ADDR input, GM_ADDR coefficients, GM_ADDR output,
    int64_t t, int64_t n, int64_t innerSize,
    int64_t tileElems, int64_t jobsPerBlock)
{
    KernelMatrixExpUtil<T> op;
    op.Init(input, coefficients, output, t, n, innerSize, tileElems, jobsPerBlock);
    op.Process();
}

torch::Tensor matrix_exp_util_npu(const torch::Tensor &input,
                                  const torch::Tensor &coefficients)
{
    check_common(input, coefficients);
    const c10::OptionalDeviceGuard guard(input.device());

    auto inputC = input.contiguous();
    auto coefficientsC = coefficients.contiguous();
    auto output = torch::empty(output_shape(inputC, coefficientsC), inputC.options());

    int64_t innerSize = product_spatial(inputC);
    if (innerSize == 0 || output.numel() == 0) {
        return output;
    }

    int64_t t = inputC.size(0);
    int64_t n = coefficientsC.size(0);
    int64_t numBlocks = 1;
    int64_t jobsPerBlock = 1;
    int64_t tileElems = 1;
    std::tie(numBlocks, jobsPerBlock, tileElems) =
        calc_tiling_params(n, innerSize, inputC.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto coefficientsPtr = (GM_ADDR)coefficientsC.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            inputC.scalar_type(), "matrix_exp_util_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                matrix_exp_util_kernel<half><<<numBlocks, nullptr, stream>>>(
                    inputPtr, coefficientsPtr, outputPtr,
                    t, n, innerSize, tileElems, jobsPerBlock);
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                matrix_exp_util_kernel<float><<<numBlocks, nullptr, stream>>>(
                    inputPtr, coefficientsPtr, outputPtr,
                    t, n, innerSize, tileElems, jobsPerBlock);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("MatrixExpUtil", acl_call);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("matrix_exp_util", matrix_exp_util_npu);
}

} // namespace MatrixExpUtil
} // namespace ops_multimodal_fusion
