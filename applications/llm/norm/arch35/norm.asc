/*!
 * \file norm.asc
 * \brief Norm (Lp norm reduction) operator implementation for Ascend NPU
 *
 * norm(x, p, dim, keepdim) = (sum |x_i|^p)^(1/p)
 * Special cases: p=1 -> sum|x_i|, p=2 -> sqrt(sum x_i^2), p=inf -> max|x_i|
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <cmath>

namespace ops_multimodal_fusion {
namespace Norm {

// 1. Register the operator's schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("norm(Tensor x, Scalar p, int dim, bool keepdim) -> Tensor");
}

// 2. Meta function: shape/dtype inference without computation
torch::Tensor norm_meta(const torch::Tensor &x, const torch::Scalar &p, int64_t dim, bool keepdim)
{
    int64_t ndim = x.dim();
    TORCH_CHECK(ndim > 0, "norm requires at least 1 dimension");
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");

    auto sizes = x.sizes().vec();
    if (keepdim) {
        sizes[dim] = 1;
    } else {
        sizes.erase(sizes.begin() + dim);
    }
    return torch::empty(sizes, x.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("norm", norm_meta);
}

// 3. Tiling parameter calculation
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t outerSize)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t BUFFER_NUM = 2;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, outerSize);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t blockLength = (outerSize + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / PIPELINE_DEPTH / BUFFER_NUM;
    tileSize = (tileSize / 32) * 32;
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// 4. Kernel implementation
//
// Layout: input is viewed as outerSize x dimSize x innerSize (contiguous).
// Each core handles a block of outer indices. For each outer index, we
// accumulate |x_i|^p along dimSize slices of innerSize elements,
// then raise the result to 1/p power.
template <typename T>
class KernelNorm {
public:
    __aicore__ inline KernelNorm() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t outerSize, int64_t blockOuter, uint32_t tileSize,
        int64_t dimSize, int64_t innerSize, float pVal)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        yGm_.SetGlobalBuffer((__gm__ T *)y);

        int64_t outerStart = blockOuter * AscendC::GetBlockIdx();
        currentBlockOuter_ = outerSize - outerStart;
        if (currentBlockOuter_ > blockOuter) currentBlockOuter_ = blockOuter;
        outerStart_ = outerStart;
        dimSize_ = dimSize;
        innerSize_ = innerSize;
        elementNumPerTile_ = tileSize / sizeof(T);
        pVal_ = pVal;
        invP_ = (pVal != 0.0f) ? (1.0f / pVal) : 0.0f;

        pipe_.InitBuffer(inQueue_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueue_, PIPELINE_DEPTH, tileSize);
    }

    __aicore__ inline void Process()
    {
        for (int64_t o = 0; o < currentBlockOuter_; ++o) {
            int64_t outerIdx = outerStart_ + o;
            ProcessOuter(outerIdx);
        }
    }

private:
    __aicore__ inline void ProcessOuter(int64_t outerIdx)
    {
        int64_t innerRemaining = innerSize_;
        int64_t innerOffset = 0;
        while (innerRemaining > 0) {
            int64_t tileCount = innerRemaining;
            if (tileCount > elementNumPerTile_) tileCount = elementNumPerTile_;
            ProcessTile(outerIdx, innerOffset, tileCount);
            innerOffset += tileCount;
            innerRemaining -= tileCount;
        }
    }

    __aicore__ inline void ProcessTile(int64_t outerIdx, int64_t innerOffset, int64_t count)
    {
        bool isInf = (pVal_ > 1e30f);

        // Allocate output buffer and initialize
        AscendC::LocalTensor<T> yLocal = outQueue_.AllocTensor<T>();
        if (isInf) {
            // For inf norm, initialize to 0 (will take max of abs values)
            AscendC::Duplicate(yLocal, (T)0, count);
        } else {
            // For Lp norm, accumulate sum of |x|^p, start at 0
            AscendC::Duplicate(yLocal, (T)0, count);
        }
        AscendC::PipeBarrier<PIPE_V>();

        // Accumulate over the reduction dimension
        for (int64_t d = 0; d < dimSize_; ++d) {
            int64_t srcOffset = outerIdx * dimSize_ * innerSize_ + d * innerSize_ + innerOffset;

            AscendC::DataCopyExtParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen = count * sizeof(T);
            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::LocalTensor<T> xLocal = inQueue_.AllocTensor<T>();
            AscendC::DataCopyPad(xLocal, xGm_[srcOffset], copyParams, padParams);
            inQueue_.EnQue(xLocal);

            xLocal = inQueue_.DeQue<T>();

            // Compute |x|
            AscendC::Abs(xLocal, xLocal, count);
            AscendC::PipeBarrier<PIPE_V>();

            if (isInf) {
                // inf norm: max(|x_i|)
                AscendC::Max(yLocal, yLocal, xLocal, count);
            } else if (pVal_ == 1.0f) {
                // L1 norm: sum(|x_i|)
                AscendC::Add(yLocal, yLocal, xLocal, count);
            } else if (pVal_ == 2.0f) {
                // L2 norm: sum(x_i^2) - Mul self for squaring
                AscendC::Mul(xLocal, xLocal, xLocal, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(yLocal, yLocal, xLocal, count);
            } else {
                // General Lp: sum(|x_i|^p)
                // Use ln -> muls(p) -> exp to compute |x|^p
                AscendC::Ln(xLocal, xLocal, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(xLocal, xLocal, (T)pVal_, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Exp(xLocal, xLocal, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(yLocal, yLocal, xLocal, count);
            }
            AscendC::PipeBarrier<PIPE_V>();
            inQueue_.FreeTensor(xLocal);
        }

        // Final step: raise to 1/p power
        if (!isInf && pVal_ != 1.0f) {
            if (pVal_ == 2.0f) {
                // sqrt for L2 norm
                AscendC::Sqrt(yLocal, yLocal, count);
            } else {
                // General: result^(1/p) via ln -> muls(1/p) -> exp
                AscendC::Ln(yLocal, yLocal, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(yLocal, yLocal, (T)invP_, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Exp(yLocal, yLocal, count);
            }
            AscendC::PipeBarrier<PIPE_V>();
        }

        // Write result to global memory
        int64_t dstOffset = outerIdx * innerSize_ + innerOffset;
        outQueue_.EnQue(yLocal);
        yLocal = outQueue_.DeQue<T>();
        AscendC::DataCopyExtParams outCopyParams;
        outCopyParams.blockCount = 1;
        outCopyParams.blockLen = count * sizeof(T);
        outCopyParams.srcStride = 0;
        outCopyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[dstOffset], yLocal, outCopyParams);
        outQueue_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueue_;
    int64_t outerStart_ = 0;
    int64_t currentBlockOuter_ = 0;
    int64_t dimSize_ = 0;
    int64_t innerSize_ = 0;
    int64_t elementNumPerTile_ = 0;
    float pVal_ = 2.0f;
    float invP_ = 0.5f;
};

template <typename T>
__global__ __aicore__ __vector__ void norm_kernel(GM_ADDR x, GM_ADDR y,
    int64_t outerSize, int64_t blockOuter, uint32_t tileSize,
    int64_t dimSize, int64_t innerSize, float pVal)
{
    KernelNorm<T> op;
    op.Init(x, y, outerSize, blockOuter, tileSize, dimSize, innerSize, pVal);
    op.Process();
}

// 5. NPU dispatch function
torch::Tensor norm_npu(const torch::Tensor &x, const torch::Scalar &p, int64_t dim, bool keepdim)
{
    const c10::OptionalDeviceGuard guard(x.device());

    auto x_contig = x.contiguous();

    // Normalize negative dim
    int64_t ndim = x_contig.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");

    float pVal = p.toFloat();
    TORCH_CHECK(pVal >= 0.0f, "norm order must be non-negative");

    // Decompose tensor into outer x dim x inner
    int64_t outerSize = 1;
    for (int64_t i = 0; i < dim; ++i) outerSize *= x_contig.size(i);
    int64_t dimSize = x_contig.size(dim);
    int64_t innerSize = 1;
    for (int64_t i = dim + 1; i < ndim; ++i) innerSize *= x_contig.size(i);

    auto y = norm_meta(x_contig, p, dim, keepdim);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t numBlocks, blockOuter, tileSize;
    std::tie(numBlocks, blockOuter, tileSize) = calc_tiling_params(outerSize);

    auto x_ptr = (GM_ADDR)x_contig.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x_contig.scalar_type(), "norm_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                norm_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(x_ptr, y_ptr, outerSize, blockOuter, tileSize, dimSize, innerSize, pVal);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Norm", acl_call);
    return y;
}

// Register the NPU implementation
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("norm", norm_npu);
}

} // namespace Norm
} // namespace ops_multimodal_fusion
