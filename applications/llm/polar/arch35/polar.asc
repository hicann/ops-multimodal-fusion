/*!
 * \file polar.asc
 * \brief Polar construction operator for Ascend NPU (dav-3510)
 *
 * torch.polar(abs, angle) -> out
 *   out = abs * (cos(angle) + sin(angle) * 1j)
 *
 * Scope: float16 -> complex32 and float32 -> complex64. bfloat16, float64
 * and integer inputs are rejected because the dav-3510 Reg path does not
 * provide double arithmetic for the polar trigonometric polynomial.
 *
 * The device path uses Ascend950 Reg wrappers for polynomial trigonometry
 * and interleaved complex stores. Normal AscendC code is used only for
 * GM/UB movement and queueing.
 */

#include <ATen/ExpandUtils.h>
#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <array>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Polar {

static constexpr int64_t kPipelineDepth = 2;
static constexpr int64_t kMaxBroadcastDims = 8;

struct BroadcastShapeInfo {
    int64_t rank = 0;
    int64_t outShape[kMaxBroadcastDims] = {};
    int64_t absShape[kMaxBroadcastDims] = {};
    int64_t angleShape[kMaxBroadcastDims] = {};
    int64_t absStride[kMaxBroadcastDims] = {};
    int64_t angleStride[kMaxBroadcastDims] = {};
};

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("polar(Tensor abs, Tensor angle) -> Tensor");
}

torch::Tensor polar_meta(const torch::Tensor &abs, const torch::Tensor &angle)
{
    TORCH_CHECK(abs.scalar_type() == angle.scalar_type(),
                "polar: abs and angle must have the same dtype, got ",
                abs.scalar_type(), " vs ", angle.scalar_type());
    TORCH_CHECK(abs.scalar_type() == torch::kFloat16 ||
                abs.scalar_type() == torch::kFloat32,
                "polar: expected Half or Float inputs on dav-3510 Reg path, got ",
                abs.scalar_type());
    auto out_shape = at::infer_size(abs.sizes(), angle.sizes());
    return torch::empty(out_shape, abs.options().dtype(c10::toComplexType(abs.scalar_type())));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("polar", polar_meta);
}

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t QUEUE_ELEMS = 4; // abs + angle + complex output(real,imag)
    constexpr static int64_t FLOAT_SCRATCH_ELEMS = 4; // abs + angle + real + imag
    constexpr static int64_t HALF_SCRATCH_ELEMS = 2; // real + imag scratch for half output
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "polar: coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t bytesPerElem = kPipelineDepth * QUEUE_ELEMS * elemSize +
        FLOAT_SCRATCH_ELEMS * static_cast<int64_t>(sizeof(float)) +
        HALF_SCRATCH_ELEMS * elemSize;
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "polar: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// Maclaurin sin/cos for a SMALL argument R_REG (|r| <= pi/4 after range
// reduction). SIN_REG/COS_REG receive sin(r)/cos(r); x2Reg is scratch.
#define POLAR_EVAL_SIN_COS_SMALL(SIN_REG, COS_REG, R_REG) \
    AscendC::Reg::Mul(x2Reg, R_REG, R_REG, mask); \
    AscendC::Reg::Duplicate<float>(SIN_REG, -1.0f / 39916800.0f, mask); \
    AscendC::Reg::Mul(SIN_REG, SIN_REG, x2Reg, mask); \
    AscendC::Reg::Adds(SIN_REG, SIN_REG, 1.0f / 362880.0f, mask); \
    AscendC::Reg::Mul(SIN_REG, SIN_REG, x2Reg, mask); \
    AscendC::Reg::Adds(SIN_REG, SIN_REG, -1.0f / 5040.0f, mask); \
    AscendC::Reg::Mul(SIN_REG, SIN_REG, x2Reg, mask); \
    AscendC::Reg::Adds(SIN_REG, SIN_REG, 1.0f / 120.0f, mask); \
    AscendC::Reg::Mul(SIN_REG, SIN_REG, x2Reg, mask); \
    AscendC::Reg::Adds(SIN_REG, SIN_REG, -1.0f / 6.0f, mask); \
    AscendC::Reg::Mul(SIN_REG, SIN_REG, x2Reg, mask); \
    AscendC::Reg::Adds(SIN_REG, SIN_REG, 1.0f, mask); \
    AscendC::Reg::Mul(SIN_REG, SIN_REG, R_REG, mask); \
    AscendC::Reg::Duplicate<float>(COS_REG, -1.0f / 3628800.0f, mask); \
    AscendC::Reg::Mul(COS_REG, COS_REG, x2Reg, mask); \
    AscendC::Reg::Adds(COS_REG, COS_REG, 1.0f / 40320.0f, mask); \
    AscendC::Reg::Mul(COS_REG, COS_REG, x2Reg, mask); \
    AscendC::Reg::Adds(COS_REG, COS_REG, -1.0f / 720.0f, mask); \
    AscendC::Reg::Mul(COS_REG, COS_REG, x2Reg, mask); \
    AscendC::Reg::Adds(COS_REG, COS_REG, 1.0f / 24.0f, mask); \
    AscendC::Reg::Mul(COS_REG, COS_REG, x2Reg, mask); \
    AscendC::Reg::Adds(COS_REG, COS_REG, -0.5f, mask); \
    AscendC::Reg::Mul(COS_REG, COS_REG, x2Reg, mask); \
    AscendC::Reg::Adds(COS_REG, COS_REG, 1.0f, mask)

// Full-range sin/cos via Cody-Waite range reduction to r in [-pi/4, pi/4]:
//   k = round(angle / (pi/2)); r = angle - k*(pi/2)  (k*(pi/2) split in 3
//   high-precision terms so r stays accurate even near multiples of pi/2).
// The polynomial is then evaluated only on the small r, eliminating the
// large-|angle| truncation undershoot of a bare Maclaurin series.
// Quadrant q = k mod 4 selects the trig identity:
//   q=0: sin= sinr, cos= cosr;  q=1: sin= cosr, cos=-sinr
//   q=2: sin=-sinr, cos=-cosr;  q=3: sin=-cosr, cos= sinr
// All registers are fp32; selection uses Compares/Select masks (no scalar
// reads, no int cast). Requires scratch regs: x2Reg, kReg, rReg, sinrReg,
// cosrReg, qReg, tmpReg, swapSinReg, swapCosReg and mask `mask`.
#define POLAR_RANGE_REDUCE_SIN_COS(SIN_REG, COS_REG, ANGLE_REG) \
    do { \
        constexpr float kTwoOverPi = 0.63661977236758134308f; \
        /* pi/2 split (Cody-Waite, 3 terms summing to pi/2 in extended precision). */ \
        /* Hi is fp32(pi/2) truncated to keep k*Hi exact for small k; Mid and Lo */ \
        /* are the exact fp32 remainders fp32(pi/2 - Hi) and fp32(pi/2 - Hi - Mid), */ \
        /* so Hi+Mid+Lo reproduces pi/2 to fp64 accuracy. */ \
        constexpr float kHalfPiHi = 1.5707963109016418457f; \
        constexpr float kHalfPiMid = 7.5497901264043321e-08f; \
        constexpr float kHalfPiLo = -1.7763568394002505e-15f; \
        constexpr float kRoundMagic = 12582912.0f; /* 1.5 * 2^23 */ \
        /* k = round(angle * 2/pi) via add/sub of round magic */ \
        AscendC::Reg::Muls(kReg, ANGLE_REG, kTwoOverPi, mask); \
        AscendC::Reg::Adds(kReg, kReg, kRoundMagic, mask); \
        AscendC::Reg::Adds(kReg, kReg, -kRoundMagic, mask); \
        /* r = angle - k*(pi/2) computed in 3 stages for accuracy */ \
        AscendC::Reg::Muls(tmpReg, kReg, -kHalfPiHi, mask); \
        AscendC::Reg::Add(rReg, ANGLE_REG, tmpReg, mask); \
        AscendC::Reg::Muls(tmpReg, kReg, -kHalfPiMid, mask); \
        AscendC::Reg::Add(rReg, rReg, tmpReg, mask); \
        AscendC::Reg::Muls(tmpReg, kReg, -kHalfPiLo, mask); \
        AscendC::Reg::Add(rReg, rReg, tmpReg, mask); \
        POLAR_EVAL_SIN_COS_SMALL(sinrReg, cosrReg, rReg); \
        /* q = k mod 4 in {0,1,2,3}. frac = k/4 - round(k/4) in (-0.5,0.5]; */ \
        /* q0 = round(frac*4) in {-2..2}; fold negatives by +4 (round-to-even */ \
        /* makes the k/4==n.5 boundary land consistently). */ \
        AscendC::Reg::Muls(qReg, kReg, 0.25f, mask); \
        AscendC::Reg::Adds(tmpReg, qReg, kRoundMagic, mask); \
        AscendC::Reg::Adds(tmpReg, tmpReg, -kRoundMagic, mask); \
        AscendC::Reg::Sub(qReg, qReg, tmpReg, mask); /* frac in (-0.5,0.5] */ \
        AscendC::Reg::Muls(qReg, qReg, 4.0f, mask); \
        AscendC::Reg::Adds(qReg, qReg, kRoundMagic, mask); \
        AscendC::Reg::Adds(qReg, qReg, -kRoundMagic, mask); /* q0 in {-2,-1,0,1,2} */ \
        { \
            AscendC::Reg::MaskReg negQMask; \
            AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(negQMask, qReg, 0.0f, mask); \
            AscendC::Reg::Adds(tmpReg, qReg, 4.0f, mask); \
            AscendC::Reg::Select<float>(qReg, tmpReg, qReg, negQMask); /* q in {0,1,2,3} */ \
        } \
        /* select trig identity per quadrant q in {0,1,2,3} */ \
        AscendC::Reg::MaskReg q1Mask; \
        AscendC::Reg::MaskReg q2Mask; \
        AscendC::Reg::MaskReg q3Mask; \
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(q1Mask, qReg, 1.0f, mask); \
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(q2Mask, qReg, 2.0f, mask); \
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(q3Mask, qReg, 3.0f, mask); \
        /* start from q==0 identity */ \
        SIN_REG = sinrReg; \
        COS_REG = cosrReg; \
        /* q==1: sin= cosr, cos=-sinr */ \
        AscendC::Reg::Muls(swapSinReg, sinrReg, -1.0f, mask); \
        AscendC::Reg::Select<float>(SIN_REG, cosrReg, SIN_REG, q1Mask); \
        AscendC::Reg::Select<float>(COS_REG, swapSinReg, COS_REG, q1Mask); \
        /* q==2: sin=-sinr, cos=-cosr */ \
        AscendC::Reg::Muls(swapSinReg, sinrReg, -1.0f, mask); \
        AscendC::Reg::Muls(swapCosReg, cosrReg, -1.0f, mask); \
        AscendC::Reg::Select<float>(SIN_REG, swapSinReg, SIN_REG, q2Mask); \
        AscendC::Reg::Select<float>(COS_REG, swapCosReg, COS_REG, q2Mask); \
        /* q==3: sin=-cosr, cos= sinr */ \
        AscendC::Reg::Muls(swapCosReg, cosrReg, -1.0f, mask); \
        AscendC::Reg::Select<float>(SIN_REG, swapCosReg, SIN_REG, q3Mask); \
        AscendC::Reg::Select<float>(COS_REG, sinrReg, COS_REG, q3Mask); \
    } while (0)

__simd_vf__ inline void PolarFloatRegVf(__ubuf__ float *outAddr, __ubuf__ float *absAddr,
                                        __ubuf__ float *angleAddr, uint32_t count,
                                        uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> absReg;
    AscendC::Reg::RegTensor<float> angleReg;
    AscendC::Reg::RegTensor<float> x2Reg;
    AscendC::Reg::RegTensor<float> sinReg;
    AscendC::Reg::RegTensor<float> cosReg;
    AscendC::Reg::RegTensor<float> realReg;
    AscendC::Reg::RegTensor<float> imagReg;
    AscendC::Reg::RegTensor<float> kReg;
    AscendC::Reg::RegTensor<float> rReg;
    AscendC::Reg::RegTensor<float> sinrReg;
    AscendC::Reg::RegTensor<float> cosrReg;
    AscendC::Reg::RegTensor<float> qReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::RegTensor<float> swapSinReg;
    AscendC::Reg::RegTensor<float> swapCosReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            absReg, absAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            angleReg, angleAddr + offset);

        POLAR_RANGE_REDUCE_SIN_COS(sinReg, cosReg, angleReg);
        AscendC::Reg::Mul(realReg, absReg, cosReg, mask);
        AscendC::Reg::Mul(imagReg, absReg, sinReg, mask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_INTLV_B32>(
            outAddr + offset * 2, realReg, imagReg, mask);
    }
}

template <typename T>
__simd_vf__ inline void PolarHalfToScratchRegVf(__ubuf__ T *realAddr, __ubuf__ T *imagAddr,
                                                __ubuf__ T *absAddr, __ubuf__ T *angleAddr,
                                                uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    static constexpr AscendC::Reg::CastTrait castFromFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<T> absHalfReg;
    AscendC::Reg::RegTensor<T> angleHalfReg;
    AscendC::Reg::RegTensor<T> realHalfReg;
    AscendC::Reg::RegTensor<T> imagHalfReg;
    AscendC::Reg::RegTensor<float> absReg;
    AscendC::Reg::RegTensor<float> angleReg;
    AscendC::Reg::RegTensor<float> x2Reg;
    AscendC::Reg::RegTensor<float> sinReg;
    AscendC::Reg::RegTensor<float> cosReg;
    AscendC::Reg::RegTensor<float> realReg;
    AscendC::Reg::RegTensor<float> imagReg;
    AscendC::Reg::RegTensor<float> kReg;
    AscendC::Reg::RegTensor<float> rReg;
    AscendC::Reg::RegTensor<float> sinrReg;
    AscendC::Reg::RegTensor<float> cosrReg;
    AscendC::Reg::RegTensor<float> qReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::RegTensor<float> swapSinReg;
    AscendC::Reg::RegTensor<float> swapCosReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            absHalfReg, absAddr + offset);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            angleHalfReg, angleAddr + offset);
        AscendC::Reg::Cast<float, T, castToFloat>(absReg, absHalfReg, mask);
        AscendC::Reg::Cast<float, T, castToFloat>(angleReg, angleHalfReg, mask);

        POLAR_RANGE_REDUCE_SIN_COS(sinReg, cosReg, angleReg);
        AscendC::Reg::Mul(realReg, absReg, cosReg, mask);
        AscendC::Reg::Mul(imagReg, absReg, sinReg, mask);
        AscendC::Reg::Cast<T, float, castFromFloat>(realHalfReg, realReg, mask);
        AscendC::Reg::Cast<T, float, castFromFloat>(imagHalfReg, imagReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            realAddr + offset, realHalfReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            imagAddr + offset, imagHalfReg, mask);
    }
}

template <typename T>
__simd_vf__ inline void InterleaveRegVf(__ubuf__ T *outAddr, __ubuf__ T *realAddr,
                                        __ubuf__ T *imagAddr, uint32_t count,
                                        uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> realReg;
    AscendC::Reg::RegTensor<T> imagReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            realReg, realAddr + offset);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            imagReg, imagAddr + offset);
        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_INTLV_B16>(
                outAddr + offset * 2, realReg, imagReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_INTLV_B32>(
                outAddr + offset * 2, realReg, imagReg, mask);
        }
    }
}

template <typename T>
__aicore__ inline void PolarFloatReg(AscendC::LocalTensor<T> &out,
                                     AscendC::LocalTensor<T> &abs,
                                     AscendC::LocalTensor<T> &angle,
                                     int64_t count)
{
    __ubuf__ T *outAddr = (__ubuf__ T *)out.GetPhyAddr();
    __ubuf__ T *absAddr = (__ubuf__ T *)abs.GetPhyAddr();
    __ubuf__ T *angleAddr = (__ubuf__ T *)angle.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<PolarFloatRegVf>(outAddr, absAddr, angleAddr, elementCount, chunkCount);
}

template <typename T>
__aicore__ inline void PolarHalfToScratchReg(AscendC::LocalTensor<T> &real,
                                             AscendC::LocalTensor<T> &imag,
                                             AscendC::LocalTensor<T> &abs,
                                             AscendC::LocalTensor<T> &angle,
                                             int64_t count)
{
    __ubuf__ T *realAddr = (__ubuf__ T *)real.GetPhyAddr();
    __ubuf__ T *imagAddr = (__ubuf__ T *)imag.GetPhyAddr();
    __ubuf__ T *absAddr = (__ubuf__ T *)abs.GetPhyAddr();
    __ubuf__ T *angleAddr = (__ubuf__ T *)angle.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<PolarHalfToScratchRegVf<T>>(
        realAddr, imagAddr, absAddr, angleAddr, elementCount, chunkCount);
}

template <typename T>
__aicore__ inline void InterleaveReg(AscendC::LocalTensor<T> &out,
                                     AscendC::LocalTensor<T> &real,
                                     AscendC::LocalTensor<T> &imag,
                                     int64_t count)
{
    __ubuf__ T *outAddr = (__ubuf__ T *)out.GetPhyAddr();
    __ubuf__ T *realAddr = (__ubuf__ T *)real.GetPhyAddr();
    __ubuf__ T *imagAddr = (__ubuf__ T *)imag.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<InterleaveRegVf<T>>(outAddr, realAddr, imagAddr, elementCount, chunkCount);
}

template <typename T>
__simd_vf__ inline void BroadcastScalarRegVf(__ubuf__ T *dstAddr, uint32_t count,
                                             uint32_t chunkCount)
{
    // Chunk by the element width of T: a B16 register holds 128 half lanes, so
    // float-width (64-lane) chunking + UpdateMask<float> only covers half the lanes
    // per chunk -> the odd 2-byte lanes keep stale values (wrong scalar broadcast for
    // fp16). sizeof(T)==sizeof(float) for fp32 so that path is unchanged.
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> scalarReg;
    AscendC::Reg::RegTensor<T> dstReg;
    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(scalarReg, dstAddr);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::Duplicate<T>(dstReg, scalarReg, mask);
        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
                dstAddr + offset, dstReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + offset, dstReg, mask);
        }
    }
}

template <typename T>
__aicore__ inline void BroadcastScalarReg(AscendC::LocalTensor<T> &dst, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    // Match the vf's T-width lane chunking (B16 register = 128 half lanes).
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BroadcastScalarRegVf<T>>(dstAddr, elementCount, chunkCount);
}

template <typename T>
class KernelPolar {
public:
    __aicore__ inline KernelPolar() {}

    __aicore__ inline void Init(GM_ADDR abs, GM_ADDR angle, GM_ADDR out,
        int64_t totalLength, int64_t blockLength, uint32_t tileElems)
    {
        absGm_.SetGlobalBuffer((__gm__ T *)abs + blockLength * AscendC::GetBlockIdx());
        angleGm_.SetGlobalBuffer((__gm__ T *)angle + blockLength * AscendC::GetBlockIdx());
        outGm_.SetGlobalBuffer((__gm__ T *)out + blockLength * AscendC::GetBlockIdx() * 2);

        pipe_.InitBuffer(inQueueAbs_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(inQueueAngle_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileElems * sizeof(T) * 2);
        if constexpr (std::is_same<T, half>::value) {
            pipe_.InitBuffer(tbufRealHalf_, tileElems * sizeof(T));
            pipe_.InitBuffer(tbufImagHalf_, tileElems * sizeof(T));
        }

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileElems;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        AscendC::DataCopyExtParams inParams;
        inParams.blockCount = 1;
        inParams.blockLen = count * sizeof(T);
        inParams.srcStride = 0;
        inParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};

        AscendC::LocalTensor<T> absLocal = inQueueAbs_.template AllocTensor<T>();
        AscendC::LocalTensor<T> angleLocal = inQueueAngle_.template AllocTensor<T>();
        AscendC::DataCopyPad(absLocal, absGm_[offset], inParams, padParams);
        AscendC::DataCopyPad(angleLocal, angleGm_[offset], inParams, padParams);
        inQueueAbs_.EnQue(absLocal);
        inQueueAngle_.EnQue(angleLocal);
        absLocal = inQueueAbs_.template DeQue<T>();
        angleLocal = inQueueAngle_.template DeQue<T>();

        AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
        if constexpr (std::is_same<T, half>::value) {
            auto realHalf = tbufRealHalf_.template Get<T>();
            auto imagHalf = tbufImagHalf_.template Get<T>();
            PolarHalfToScratchReg<T>(realHalf, imagHalf, absLocal, angleLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            InterleaveReg<T>(outLocal, realHalf, imagHalf, alignedCount);
        } else {
            PolarFloatReg<T>(outLocal, absLocal, angleLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueue_.EnQue(outLocal);
        inQueueAbs_.FreeTensor(absLocal);
        inQueueAngle_.FreeTensor(angleLocal);

        outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyExtParams outParams;
        outParams.blockCount = 1;
        outParams.blockLen = count * sizeof(T) * 2;
        outParams.srcStride = 0;
        outParams.dstStride = 0;
        AscendC::DataCopyPad(outGm_[offset * 2], outLocal, outParams);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> absGm_, angleGm_, outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueAbs_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueAngle_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRealHalf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufImagHalf_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void polar_kernel(
    GM_ADDR abs, GM_ADDR angle, GM_ADDR out,
    int64_t totalLength, int64_t blockLength, uint32_t tileElems)
{
    KernelPolar<T> op;
    op.Init(abs, angle, out, totalLength, blockLength, tileElems);
    op.Process();
}

template <typename T>
class KernelPolarBroadcastNd {
public:
    __aicore__ inline KernelPolarBroadcastNd() {}

    __aicore__ inline void Init(GM_ADDR abs, GM_ADDR angle, GM_ADDR out,
        BroadcastShapeInfo shapeInfo, int64_t rowsPerBlock, uint32_t tileElems)
    {
        shapeInfo_ = shapeInfo;
        innerDim_ = shapeInfo_.outShape[shapeInfo_.rank - 1];
        rows_ = 1;
        for (int64_t i = 0; i < shapeInfo_.rank - 1; ++i) {
            rows_ *= shapeInfo_.outShape[i];
        }
        rowsPerBlock_ = rowsPerBlock;
        blockRowStart_ = AscendC::GetBlockIdx() * rowsPerBlock;
        int64_t remaining = rows_ - blockRowStart_;
        blockRows_ = (remaining < rowsPerBlock) ? remaining : rowsPerBlock;
        if (blockRows_ < 0) {
            blockRows_ = 0;
        }
        tileElems_ = tileElems;

        absGm_.SetGlobalBuffer((__gm__ T *)abs);
        angleGm_.SetGlobalBuffer((__gm__ T *)angle);
        outGm_.SetGlobalBuffer((__gm__ T *)out);
        pipe_.InitBuffer(inQueueAbs_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(inQueueAngle_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileElems * sizeof(T) * 2);
        if constexpr (std::is_same<T, half>::value) {
            pipe_.InitBuffer(tbufRealHalf_, tileElems * sizeof(T));
            pipe_.InitBuffer(tbufImagHalf_, tileElems * sizeof(T));
        }
    }

    __aicore__ inline void Process()
    {
        for (int64_t r = 0; r < blockRows_; ++r) {
            int64_t row = blockRowStart_ + r;
            for (int64_t col = 0; col < innerDim_; col += tileElems_) {
                int64_t count = innerDim_ - col;
                if (count > tileElems_) {
                    count = tileElems_;
                }
                ProcessTile(row, col, count);
            }
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        return copyParams;
    }

    __aicore__ inline int64_t OffsetOuter(
        int64_t row, const int64_t *shape, const int64_t *stride)
    {
        int64_t offset = 0;
        int64_t tmp = row;
        for (int64_t d = shapeInfo_.rank - 2; d >= 0; --d) {
            int64_t coord = tmp % shapeInfo_.outShape[d];
            tmp /= shapeInfo_.outShape[d];
            if (shape[d] != 1) {
                offset += coord * stride[d];
            }
        }
        return offset;
    }

    __aicore__ inline void LoadBroadcasted(
        AscendC::LocalTensor<T> &local, AscendC::GlobalTensor<T> &gm,
        AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> &queue,
        int64_t baseOffset, int64_t col, int64_t count, int64_t alignedCount,
        int64_t lastDim)
    {
        if (lastDim == 1) {
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(local, gm[baseOffset], CopyParams(1), padParams);
            queue.EnQue(local);
            local = queue.template DeQue<T>();
            BroadcastScalarReg<T>(local, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
        } else {
            AscendC::DataCopyPadExtParams<T> padParams{
                true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};
            AscendC::DataCopyPad(local, gm[baseOffset + col], CopyParams(count), padParams);
            queue.EnQue(local);
            local = queue.template DeQue<T>();
        }
    }

    __aicore__ inline void ProcessTile(int64_t row, int64_t col, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        int64_t absBase = OffsetOuter(row, shapeInfo_.absShape, shapeInfo_.absStride);
        int64_t angleBase = OffsetOuter(row, shapeInfo_.angleShape, shapeInfo_.angleStride);

        AscendC::LocalTensor<T> absLocal = inQueueAbs_.template AllocTensor<T>();
        AscendC::LocalTensor<T> angleLocal = inQueueAngle_.template AllocTensor<T>();
        LoadBroadcasted(absLocal, absGm_, inQueueAbs_, absBase, col, count, alignedCount,
                        shapeInfo_.absShape[shapeInfo_.rank - 1]);
        LoadBroadcasted(angleLocal, angleGm_, inQueueAngle_, angleBase, col, count, alignedCount,
                        shapeInfo_.angleShape[shapeInfo_.rank - 1]);

        AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
        if constexpr (std::is_same<T, half>::value) {
            auto realHalf = tbufRealHalf_.template Get<T>();
            auto imagHalf = tbufImagHalf_.template Get<T>();
            PolarHalfToScratchReg<T>(realHalf, imagHalf, absLocal, angleLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            InterleaveReg<T>(outLocal, realHalf, imagHalf, alignedCount);
        } else {
            PolarFloatReg<T>(outLocal, absLocal, angleLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueue_.EnQue(outLocal);
        inQueueAbs_.FreeTensor(absLocal);
        inQueueAngle_.FreeTensor(angleLocal);

        outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyExtParams outParams;
        outParams.blockCount = 1;
        outParams.blockLen = count * sizeof(T) * 2;
        outParams.srcStride = 0;
        outParams.dstStride = 0;
        AscendC::DataCopyPad(outGm_[(row * innerDim_ + col) * 2], outLocal, outParams);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> absGm_, angleGm_, outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueAbs_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueAngle_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRealHalf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufImagHalf_;
    BroadcastShapeInfo shapeInfo_;
    int64_t innerDim_ = 0;
    int64_t rows_ = 0;
    int64_t rowsPerBlock_ = 0;
    int64_t blockRowStart_ = 0;
    int64_t blockRows_ = 0;
    int64_t tileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void polar_broadcast_nd_kernel(
    GM_ADDR abs, GM_ADDR angle, GM_ADDR out,
    BroadcastShapeInfo shapeInfo, int64_t rowsPerBlock, uint32_t tileElems)
{
    KernelPolarBroadcastNd<T> op;
    op.Init(abs, angle, out, shapeInfo, rowsPerBlock, tileElems);
    op.Process();
}

static void fill_normalized_shape(
    c10::IntArrayRef shape, int64_t rank, int64_t *normalizedShape, int64_t *normalizedStride)
{
    int64_t pad = rank - static_cast<int64_t>(shape.size());
    for (int64_t i = 0; i < rank; ++i) {
        normalizedShape[i] = (i < pad) ? 1 : shape[i - pad];
    }
    int64_t stride = 1;
    for (int64_t i = rank - 1; i >= 0; --i) {
        normalizedStride[i] = stride;
        stride *= normalizedShape[i];
    }
}

static BroadcastShapeInfo make_broadcast_shape_info(
    c10::IntArrayRef outShape, c10::IntArrayRef absShape, c10::IntArrayRef angleShape)
{
    TORCH_CHECK(outShape.size() > 0, "polar: broadcast output rank must be positive");
    TORCH_CHECK(outShape.size() <= kMaxBroadcastDims,
                "polar: broadcast rank exceeds supported max rank ", kMaxBroadcastDims,
                ", got ", outShape.size());
    BroadcastShapeInfo info;
    info.rank = static_cast<int64_t>(outShape.size());
    for (int64_t i = 0; i < info.rank; ++i) {
        info.outShape[i] = outShape[i];
    }
    fill_normalized_shape(absShape, info.rank, info.absShape, info.absStride);
    fill_normalized_shape(angleShape, info.rank, info.angleShape, info.angleStride);
    for (int64_t i = 0; i < info.rank; ++i) {
        TORCH_CHECK(info.absShape[i] == 1 || info.absShape[i] == info.outShape[i],
                    "polar: invalid abs broadcast shape");
        TORCH_CHECK(info.angleShape[i] == 1 || info.angleShape[i] == info.outShape[i],
                    "polar: invalid angle broadcast shape");
    }
    return info;
}

torch::Tensor polar_npu(const torch::Tensor &abs_in, const torch::Tensor &angle_in)
{
    TORCH_CHECK(abs_in.scalar_type() == angle_in.scalar_type(),
                "polar: abs and angle must have the same dtype, got ",
                abs_in.scalar_type(), " vs ", angle_in.scalar_type());
    TORCH_CHECK(abs_in.scalar_type() == torch::kFloat16 ||
                abs_in.scalar_type() == torch::kFloat32,
                "polar: expected Half or Float inputs on dav-3510 Reg path, got ",
                abs_in.scalar_type());

    const c10::OptionalDeviceGuard guard(abs_in.device());
    auto out_shape = at::infer_size(abs_in.sizes(), angle_in.sizes());
    auto abs = abs_in.contiguous();
    auto angle = angle_in.contiguous();
    auto out = torch::empty(out_shape, abs_in.options().dtype(c10::toComplexType(abs_in.scalar_type())));

    int64_t totalLength = out.numel();
    if (totalLength == 0) {
        return out;
    }
    bool needsBroadcast = (abs.sizes() != out_shape) || (angle.sizes() != out_shape);
    BroadcastShapeInfo shapeInfo;
    int64_t broadcastRows = 0;
    if (needsBroadcast) {
        shapeInfo = make_broadcast_shape_info(out.sizes(), abs.sizes(), angle.sizes());
        int64_t innerDim = shapeInfo.outShape[shapeInfo.rank - 1];
        broadcastRows = totalLength / innerDim;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) = calc_tiling_params(totalLength, abs.element_size());
    auto abs_ptr = (GM_ADDR)abs.data_ptr();
    auto angle_ptr = (GM_ADDR)angle.data_ptr();
    auto out_ptr = (GM_ADDR)out.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            abs.scalar_type(), "polar_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                if (needsBroadcast) {
                    int64_t rowsPerBlock = (broadcastRows + numBlocks - 1) / numBlocks;
                    polar_broadcast_nd_kernel<half><<<numBlocks, nullptr, stream>>>(
                        abs_ptr, angle_ptr, out_ptr, shapeInfo, rowsPerBlock, tileElems);
                } else {
                    polar_kernel<half><<<numBlocks, nullptr, stream>>>(
                        abs_ptr, angle_ptr, out_ptr, totalLength, blockLength, tileElems);
                }
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                if (needsBroadcast) {
                    int64_t rowsPerBlock = (broadcastRows + numBlocks - 1) / numBlocks;
                    polar_broadcast_nd_kernel<float><<<numBlocks, nullptr, stream>>>(
                        abs_ptr, angle_ptr, out_ptr, shapeInfo, rowsPerBlock, tileElems);
                } else {
                    polar_kernel<float><<<numBlocks, nullptr, stream>>>(
                        abs_ptr, angle_ptr, out_ptr, totalLength, blockLength, tileElems);
                }
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Polar", acl_call);
    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("polar", polar_npu);
}

} // namespace Polar
} // namespace ops_multimodal_fusion

#undef POLAR_RANGE_REDUCE_SIN_COS
#undef POLAR_EVAL_SIN_COS_SMALL
