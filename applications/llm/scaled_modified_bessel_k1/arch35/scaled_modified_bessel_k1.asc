/*!
 * \file scaled_modified_bessel_k1.asc
 * \brief RegBase-form scaled_modified_bessel_k1 for Ascend NPU (dav-3510)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <tuple>

namespace ops_multimodal_fusion {
namespace ScaledModifiedBesselK1 {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;
constexpr int64_t TOTAL_TILE_BUFFERS = 6;

#define I1_SMALL_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, smallArgReg, qReg, mask);          \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

#define I1_LARGE_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, largeArgReg, qReg, mask);          \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

#define K1_SMALL_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, smallPolyArgReg, qReg, mask);      \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

#define K1_LARGE_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, largePolyArgReg, qReg, mask);      \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

__simd_vf__ inline void ModifiedBesselI1RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg, absReg, signReg, smallArgReg, largeArgReg;
    AscendC::Reg::RegTensor<float> pReg, qReg, currReg, nextReg, smallResReg, largeResReg, tmpReg, sqrtReg, outReg;
    AscendC::Reg::MaskReg negMask;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::Abs(absReg, xReg, mask);

        AscendC::Reg::Muls(smallArgReg, absReg, 0.5f, mask);
        AscendC::Reg::Adds(smallArgReg, smallArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, +9.38153738649577178388e-9f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        I1_SMALL_STEP(-4.44505912879632808065e-8f)
        I1_SMALL_STEP(+2.00329475355213526229e-7f)
        I1_SMALL_STEP(-8.56872026469545474066e-7f)
        I1_SMALL_STEP(+3.47025130813767847674e-6f)
        I1_SMALL_STEP(-1.32731636560394358279e-5f)
        I1_SMALL_STEP(+4.78156510755005422638e-5f)
        I1_SMALL_STEP(-1.61760815825896745588e-4f)
        I1_SMALL_STEP(+5.12285956168575772895e-4f)
        I1_SMALL_STEP(-1.51357245063125314899e-3f)
        I1_SMALL_STEP(+4.15642294431288815669e-3f)
        I1_SMALL_STEP(-1.05640848946261981558e-2f)
        I1_SMALL_STEP(+2.47264490306265168283e-2f)
        I1_SMALL_STEP(-5.29459812080949914269e-2f)
        I1_SMALL_STEP(+1.02643658689847095384e-1f)
        I1_SMALL_STEP(-1.76416518357834055153e-1f)
        I1_SMALL_STEP(+2.52587186443633654823e-1f)
        AscendC::Reg::Sub(smallResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(smallResReg, smallResReg, 0.5f, mask);
        AscendC::Reg::Mul(smallResReg, smallResReg, absReg, mask);
        AscendC::Reg::Exp(tmpReg, absReg, mask);
        AscendC::Reg::Mul(smallResReg, smallResReg, tmpReg, mask);

        AscendC::Reg::Duplicate<float>(tmpReg, 32.0f, mask);
        AscendC::Reg::Div(largeArgReg, tmpReg, absReg, mask);
        AscendC::Reg::Adds(largeArgReg, largeArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, -3.83538038596423702205e-9f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        I1_LARGE_STEP(-2.63146884688951950684e-8f)
        I1_LARGE_STEP(-2.51223623787020892529e-7f)
        I1_LARGE_STEP(-3.88256480887769039346e-6f)
        I1_LARGE_STEP(-1.10588938762623716291e-4f)
        I1_LARGE_STEP(-9.76109749136146840777e-3f)
        I1_LARGE_STEP(+7.78576235018280120474e-1f)
        AscendC::Reg::Sub(largeResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(largeResReg, largeResReg, 0.5f, mask);
        AscendC::Reg::Exp(tmpReg, absReg, mask);
        AscendC::Reg::Mul(largeResReg, largeResReg, tmpReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, absReg, mask);
        AscendC::Reg::Div(largeResReg, largeResReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(negMask, xReg, 8.0f, mask);
        AscendC::Reg::Select<float>(outReg, smallResReg, largeResReg, negMask);

        AscendC::Reg::Duplicate<float>(signReg, 1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(negMask, xReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, -1.0f, mask);
        AscendC::Reg::Select<float>(signReg, tmpReg, signReg, negMask);
        AscendC::Reg::Mul(outReg, outReg, signReg, mask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void ModifiedBesselI1Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ModifiedBesselI1RegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void ScaledModifiedBesselK1RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, __ubuf__ float *i1Addr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg, i1Reg, pReg, qReg, currReg, nextReg;
    AscendC::Reg::RegTensor<float> smallPolyArgReg, largePolyArgReg, smallResReg, largeResReg, tmpReg, sqrtReg, outReg;
    const float infValue = INFINITY;
    const float nanValue = NAN;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg branchMask;
        AscendC::Reg::MaskReg specialMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(i1Reg, i1Addr + offset);

        AscendC::Reg::Mul(smallPolyArgReg, xReg, xReg, mask);
        AscendC::Reg::Adds(smallPolyArgReg, smallPolyArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, -7.02386347938628759343e-18f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        K1_SMALL_STEP(-2.42744985051936593393e-15f)
        K1_SMALL_STEP(-6.66690169419932900609e-13f)
        K1_SMALL_STEP(-1.41148839263352776110e-10f)
        K1_SMALL_STEP(-2.21338763073472585583e-8f)
        K1_SMALL_STEP(-2.43340614156596823496e-6f)
        K1_SMALL_STEP(-1.73028895751305206302e-4f)
        K1_SMALL_STEP(-6.97572385963986435018e-3f)
        K1_SMALL_STEP(-1.22611180822657148235e-1f)
        K1_SMALL_STEP(-3.53155960776544875667e-1f)
        K1_SMALL_STEP(+1.52530022733894777053e+0f)
        AscendC::Reg::Sub(smallResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(smallResReg, smallResReg, 0.5f, mask);
        AscendC::Reg::Div(smallResReg, smallResReg, xReg, mask);
        AscendC::Reg::Muls(tmpReg, xReg, 0.5f, mask);
        AscendC::Reg::Ln(tmpReg, tmpReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, i1Reg, mask);
        AscendC::Reg::Add(smallResReg, smallResReg, tmpReg, mask);
        AscendC::Reg::Exp(tmpReg, xReg, mask);
        AscendC::Reg::Mul(smallResReg, smallResReg, tmpReg, mask);

        AscendC::Reg::Duplicate<float>(tmpReg, 8.0f, mask);
        AscendC::Reg::Div(largePolyArgReg, tmpReg, xReg, mask);
        AscendC::Reg::Adds(largePolyArgReg, largePolyArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, -5.75674448366501715755e-18f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        K1_LARGE_STEP(+1.79405087314755922667e-17f)
        K1_LARGE_STEP(-5.68946255844285935196e-17f)
        K1_LARGE_STEP(+1.83809354436663880070e-16f)
        K1_LARGE_STEP(-6.05704724837331885336e-16f)
        K1_LARGE_STEP(+2.03870316562433424052e-15f)
        K1_LARGE_STEP(-7.01983709041831346144e-15f)
        K1_LARGE_STEP(+2.47715442448130437068e-14f)
        K1_LARGE_STEP(-8.97670518232499435011e-14f)
        K1_LARGE_STEP(+3.34841966607842919884e-13f)
        K1_LARGE_STEP(-1.28917396095102890680e-12f)
        K1_LARGE_STEP(+5.13963967348173025100e-12f)
        K1_LARGE_STEP(-2.12996783842756842877e-11f)
        K1_LARGE_STEP(+9.21831518760500529508e-11f)
        K1_LARGE_STEP(-4.19035475934189648750e-10f)
        K1_LARGE_STEP(+2.01504975519703286596e-9f)
        K1_LARGE_STEP(-1.03457624656780970260e-8f)
        K1_LARGE_STEP(+5.74108412545004946722e-8f)
        K1_LARGE_STEP(-3.50196060308781257119e-7f)
        K1_LARGE_STEP(+2.40648494783721712015e-6f)
        K1_LARGE_STEP(-1.93619797416608296024e-5f)
        K1_LARGE_STEP(+1.95215518471351631108e-4f)
        K1_LARGE_STEP(-2.85781685962277938680e-3f)
        K1_LARGE_STEP(+1.03923736576817238437e-1f)
        K1_LARGE_STEP(+2.72062619048444266945e+0f)
        AscendC::Reg::Sub(largeResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(largeResReg, largeResReg, 0.5f, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, xReg, mask);
        AscendC::Reg::Div(largeResReg, largeResReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(branchMask, xReg, 2.0f, mask);
        AscendC::Reg::Select<float>(outReg, smallResReg, largeResReg, branchMask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(specialMask, xReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, infValue, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, specialMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(specialMask, xReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, nanValue, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, specialMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(specialMask, xReg, infValue, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, specialMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(specialMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, specialMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void ScaledModifiedBesselK1Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src,
    const AscendC::LocalTensor<float> &i1, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    __ubuf__ float *i1Addr = (__ubuf__ float *)i1.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ScaledModifiedBesselK1RegVf>(dstAddr, srcAddr, i1Addr, elementCount, chunkCount);
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("scaled_modified_bessel_k1(Tensor x) -> Tensor");
}

torch::Tensor scaled_modified_bessel_k1_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "scaled_modified_bessel_k1 only supports float32");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("scaled_modified_bessel_k1", scaled_modified_bessel_k1_meta);
}

std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / TOTAL_TILE_BUFFERS / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) {
        tileBytes = BLOCK_BYTES;
    }
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) {
        tileElems = 8;
    }
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

class KernelScaledModifiedBesselK1 {
public:
    __aicore__ inline KernelScaledModifiedBesselK1() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockIdx * blockLength);

        int64_t tileBytes =
            ((tileLength_ * static_cast<int64_t>(sizeof(float)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(inQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
        pipe_.InitBuffer(tmp0_, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto inLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(inLocal, xGm_[offset], p, pad);
        inQueue_.EnQue(inLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto inLocal = inQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        auto i1Local = tmp0_.Get<float>();
        ModifiedBesselI1Reg(i1Local, inLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        ScaledModifiedBesselK1Reg(outLocal, inLocal, i1Local, count);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp0_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

__global__ __aicore__ __vector__ void scaled_modified_bessel_k1_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelScaledModifiedBesselK1 op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

torch::Tensor scaled_modified_bessel_k1_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "scaled_modified_bessel_k1 only supports float32");

    auto input = x.contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) = calc_tiling_params(totalLength, input.element_size());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        scaled_modified_bessel_k1_kernel<<<numBlocks, nullptr, stream>>>(xPtr, yPtr, totalLength, blockLength, tileLength);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("ScaledModifiedBesselK1", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("scaled_modified_bessel_k1", scaled_modified_bessel_k1_npu);
}

} // namespace ScaledModifiedBesselK1
} // namespace ops_multimodal_fusion

#undef I1_SMALL_STEP
#undef I1_LARGE_STEP
#undef K1_SMALL_STEP
#undef K1_LARGE_STEP
