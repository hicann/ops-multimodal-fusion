/*!
 * \file airy_ai.asc
 * \brief RegBase-form airy_ai for Ascend NPU (dav-3510)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <tuple>

namespace ops_multimodal_fusion {
namespace AiryAi {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;
constexpr int64_t TOTAL_TILE_BUFFERS = 5;

#define AIRY_POLY_STEP(TARGET, ARG, COEFF)                      \
    AscendC::Reg::Mul(TARGET, TARGET, ARG, mask);              \
    AscendC::Reg::Adds(TARGET, TARGET, COEFF, mask);

#define AIRY_SERIES_STEP()                                       \
    AscendC::Reg::Mul(mReg, mReg, zReg, mask);                  \
    AscendC::Reg::Adds(kReg, kReg, 1.0f, mask);                 \
    AscendC::Reg::Div(mReg, mReg, kReg, mask);                  \
    AscendC::Reg::Mul(nReg, nReg, zReg, mask);                  \
    AscendC::Reg::Adds(kReg, kReg, 1.0f, mask);                 \
    AscendC::Reg::Div(nReg, nReg, kReg, mask);                  \
    AscendC::Reg::Div(mReg, mReg, kReg, mask);                  \
    AscendC::Reg::Add(fReg, fReg, mReg, mask);                  \
    AscendC::Reg::Adds(kReg, kReg, 1.0f, mask);                 \
    AscendC::Reg::Div(nReg, nReg, kReg, mask);                  \
    AscendC::Reg::Add(gReg, gReg, nReg, mask);

__simd_vf__ inline void AiryAiRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    constexpr float PI = 3.14159265358979323846f;
    constexpr float INV_PI = 0.31830988618379067154f;
    constexpr float ROUND_MAGIC = 12582912.0f;
    constexpr float AIRY_SCALE = 5.64189583547756286948e-01f;
    constexpr float SERIES_F_COEFF = 0.355028053887817239260f;
    constexpr float SERIES_G_COEFF = 0.258819403792806798405f;

    AscendC::Reg::RegTensor<float> xReg, absReg, outReg, tmpReg, tmp1Reg, tmp2Reg;
    AscendC::Reg::RegTensor<float> zReg, z2Reg, trigArg2Reg, zetaReg, invZetaReg;
    AscendC::Reg::RegTensor<float> polyReg, poly2Reg, anReg, adReg, afnReg, afdReg, agnReg, agdReg;
    AscendC::Reg::RegTensor<float> sqrtReg, sqrt2Reg, denomReg, tReg, sinReg, cosReg, signReg;
    AscendC::Reg::RegTensor<float> rReg, aReg, kRoundReg, fReg, gReg, kReg, mReg, nReg;
    AscendC::Reg::RegTensor<float> seriesOutReg, negAsymOutReg, posAsymOutReg;
    const float nanValue = NAN;
    const float infValue = INFINITY;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg negAsymMask;
        AscendC::Reg::MaskReg posAsymMask;
        AscendC::Reg::MaskReg overflowMask;
        AscendC::Reg::MaskReg infMask;
        AscendC::Reg::MaskReg nanMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::Abs(absReg, xReg, mask);

        AscendC::Reg::Duplicate<float>(fReg, 1.0f, mask);
        gReg = xReg;
        AscendC::Reg::Duplicate<float>(kReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(mReg, 1.0f, mask);
        nReg = xReg;
        AscendC::Reg::Mul(zReg, xReg, xReg, mask);
        AscendC::Reg::Mul(zReg, zReg, xReg, mask);
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AIRY_SERIES_STEP()
        AscendC::Reg::Muls(seriesOutReg, fReg, SERIES_F_COEFF, mask);
        AscendC::Reg::Muls(tmpReg, gReg, SERIES_G_COEFF, mask);
        AscendC::Reg::Sub(seriesOutReg, seriesOutReg, tmpReg, mask);
        outReg = seriesOutReg;

        AscendC::Reg::Muls(tmpReg, xReg, -1.0f, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, tmpReg, mask);
        AscendC::Reg::Mul(tmp1Reg, xReg, sqrtReg, mask);
        AscendC::Reg::Muls(tmp1Reg, tmp1Reg, -2.0f / 3.0f, mask);
        AscendC::Reg::Duplicate<float>(tmp2Reg, 1.0f, mask);
        AscendC::Reg::Div(zReg, tmp2Reg, tmp1Reg, mask);
        AscendC::Reg::Mul(z2Reg, zReg, zReg, mask);

        afnReg = z2Reg;
        AscendC::Reg::Duplicate<float>(polyReg, -1.31696323418331795333e-01f, mask);
        AIRY_POLY_STEP(polyReg, afnReg, -6.26456544431912369773e-01f)
        AIRY_POLY_STEP(polyReg, afnReg, -6.93158036036933542233e-01f)
        AIRY_POLY_STEP(polyReg, afnReg, -2.79779981545119124951e-01f)
        AIRY_POLY_STEP(polyReg, afnReg, -4.91900132609500318020e-02f)
        AIRY_POLY_STEP(polyReg, afnReg, -4.06265923594885404393e-03f)
        AIRY_POLY_STEP(polyReg, afnReg, -1.59276496239262096340e-04f)
        AIRY_POLY_STEP(polyReg, afnReg, -2.77649108155232920844e-06f)
        AIRY_POLY_STEP(polyReg, afnReg, -1.67787698489114633780e-08f)
        afnReg = polyReg;

        afdReg = z2Reg;
        AscendC::Reg::Duplicate<float>(polyReg, 1.33560420706553243746e+01f, mask);
        AIRY_POLY_STEP(polyReg, afdReg, 3.26825032795224613948e+01f)
        AIRY_POLY_STEP(polyReg, afdReg, 2.67367040941499554804e+01f)
        AIRY_POLY_STEP(polyReg, afdReg, 9.18707402907259625840e+00f)
        AIRY_POLY_STEP(polyReg, afdReg, 1.47529146771666414581e+00f)
        AIRY_POLY_STEP(polyReg, afdReg, 1.15687173795188044134e-01f)
        AIRY_POLY_STEP(polyReg, afdReg, 4.40291641615211203805e-03f)
        AIRY_POLY_STEP(polyReg, afdReg, 7.54720348287414296618e-05f)
        AIRY_POLY_STEP(polyReg, afdReg, 4.51850092970580378464e-07f)
        afdReg = polyReg;

        agnReg = z2Reg;
        AscendC::Reg::Duplicate<float>(polyReg, 1.97339932091685679179e-02f, mask);
        AIRY_POLY_STEP(polyReg, agnReg, 3.91103029615688277255e-01f)
        AIRY_POLY_STEP(polyReg, agnReg, 1.06579897599595591108e+00f)
        AIRY_POLY_STEP(polyReg, agnReg, 9.39169229816650230044e-01f)
        AIRY_POLY_STEP(polyReg, agnReg, 3.51465656105547619242e-01f)
        AIRY_POLY_STEP(polyReg, agnReg, 6.33888919628925490927e-02f)
        AIRY_POLY_STEP(polyReg, agnReg, 5.85804113048388458567e-03f)
        AIRY_POLY_STEP(polyReg, agnReg, 2.82851600836737019778e-04f)
        AIRY_POLY_STEP(polyReg, agnReg, 6.98793669997260967291e-06f)
        AIRY_POLY_STEP(polyReg, agnReg, 8.11789239554389293311e-08f)
        AIRY_POLY_STEP(polyReg, agnReg, 3.41551784765923618484e-10f)
        agnReg = polyReg;

        agdReg = z2Reg;
        AscendC::Reg::Duplicate<float>(polyReg, 9.30892908077441974853e+00f, mask);
        AIRY_POLY_STEP(polyReg, agdReg, 1.98352928718312140417e+01f)
        AIRY_POLY_STEP(polyReg, agdReg, 1.55646628932864612953e+01f)
        AIRY_POLY_STEP(polyReg, agdReg, 5.47686069422975497931e+00f)
        AIRY_POLY_STEP(polyReg, agdReg, 9.54293611618961883998e-01f)
        AIRY_POLY_STEP(polyReg, agdReg, 8.64580826352392193095e-02f)
        AIRY_POLY_STEP(polyReg, agdReg, 4.12656523824222607191e-03f)
        AIRY_POLY_STEP(polyReg, agdReg, 1.01259085116509135510e-04f)
        AIRY_POLY_STEP(polyReg, agdReg, 1.17166733214413521882e-06f)
        AIRY_POLY_STEP(polyReg, agdReg, 4.91834570062930015649e-09f)
        agdReg = polyReg;

        AscendC::Reg::Adds(tReg, tmp1Reg, PI * 0.25f, mask);
        AscendC::Reg::Muls(kRoundReg, tReg, INV_PI, mask);
        AscendC::Reg::Adds(kRoundReg, kRoundReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(kRoundReg, kRoundReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, kRoundReg, PI, mask);
        AscendC::Reg::Sub(rReg, tReg, tmpReg, mask);

        AscendC::Reg::Muls(tmpReg, kRoundReg, 0.5f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 2.0f, mask);
        AscendC::Reg::Sub(signReg, kRoundReg, tmpReg, mask);
        AscendC::Reg::Abs(signReg, signReg, mask);
        AscendC::Reg::Muls(signReg, signReg, -2.0f, mask);
        AscendC::Reg::Adds(signReg, signReg, 1.0f, mask);

        AscendC::Reg::Mul(trigArg2Reg, rReg, rReg, mask);
        AscendC::Reg::Duplicate<float>(polyReg, -1.0f / 39916800.0f, mask);
        AIRY_POLY_STEP(polyReg, trigArg2Reg, 1.0f / 362880.0f)
        AIRY_POLY_STEP(polyReg, trigArg2Reg, -1.0f / 5040.0f)
        AIRY_POLY_STEP(polyReg, trigArg2Reg, 1.0f / 120.0f)
        AIRY_POLY_STEP(polyReg, trigArg2Reg, -1.0f / 6.0f)
        AIRY_POLY_STEP(polyReg, trigArg2Reg, 1.0f)
        AscendC::Reg::Mul(sinReg, polyReg, rReg, mask);
        AscendC::Reg::Mul(sinReg, sinReg, signReg, mask);

        AscendC::Reg::Duplicate<float>(poly2Reg, -1.0f / 3628800.0f, mask);
        AIRY_POLY_STEP(poly2Reg, trigArg2Reg, 1.0f / 40320.0f)
        AIRY_POLY_STEP(poly2Reg, trigArg2Reg, -1.0f / 720.0f)
        AIRY_POLY_STEP(poly2Reg, trigArg2Reg, 1.0f / 24.0f)
        AIRY_POLY_STEP(poly2Reg, trigArg2Reg, -1.0f / 2.0f)
        AIRY_POLY_STEP(poly2Reg, trigArg2Reg, 1.0f)
        cosReg = poly2Reg;
        AscendC::Reg::Mul(cosReg, cosReg, signReg, mask);

        AscendC::Reg::Duplicate<float>(tmpReg, 1.0f, mask);
        AscendC::Reg::Div(polyReg, afnReg, afdReg, mask);
        AscendC::Reg::Mul(polyReg, polyReg, z2Reg, mask);
        AscendC::Reg::Add(polyReg, polyReg, tmpReg, mask);
        AscendC::Reg::Mul(polyReg, polyReg, sinReg, mask);
        AscendC::Reg::Div(poly2Reg, agnReg, agdReg, mask);
        AscendC::Reg::Mul(poly2Reg, poly2Reg, zReg, mask);
        AscendC::Reg::Mul(poly2Reg, poly2Reg, cosReg, mask);
        AscendC::Reg::Sub(polyReg, polyReg, poly2Reg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrt2Reg, sqrtReg, mask);
        AscendC::Reg::Div(negAsymOutReg, polyReg, sqrt2Reg, mask);
        AscendC::Reg::Muls(negAsymOutReg, negAsymOutReg, AIRY_SCALE, mask);

        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, xReg, mask);
        AscendC::Reg::Mul(zetaReg, xReg, sqrtReg, mask);
        AscendC::Reg::Muls(zetaReg, zetaReg, 2.0f / 3.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, 1.0f, mask);
        AscendC::Reg::Div(invZetaReg, tmpReg, zetaReg, mask);

        AscendC::Reg::Duplicate<float>(polyReg, 3.46538101525629032477e-01f, mask);
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.20075952739645805542e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 7.62796053615234516538e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.68089224934630576269e+02f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.59756391350164413639e+02f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 7.05360906840444183113e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.40264691163389668864e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 9.99999999999999995305e-01f)
        anReg = polyReg;

        AscendC::Reg::Duplicate<float>(polyReg, 5.67594532638770212846e-01f, mask);
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.47562562584847203173e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 8.45138970141474626562e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.77318088145400459522e+02f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.64234692871529701831e+02f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 7.14778400825575695274e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.40959135607834029598e+01f)
        AIRY_POLY_STEP(polyReg, invZetaReg, 1.00000000000000000470e+00f)
        adReg = polyReg;

        AscendC::Reg::Div(tmpReg, anReg, adReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, xReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrt2Reg, sqrtReg, mask);
        AscendC::Reg::Duplicate<float>(tmp1Reg, 2.0f, mask);
        AscendC::Reg::Mul(denomReg, tmp1Reg, sqrt2Reg, mask);
        AscendC::Reg::Exp(tmp1Reg, zetaReg, mask);
        AscendC::Reg::Mul(denomReg, denomReg, tmp1Reg, mask);
        AscendC::Reg::Div(posAsymOutReg, tmpReg, denomReg, mask);
        AscendC::Reg::Muls(posAsymOutReg, posAsymOutReg, AIRY_SCALE, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(negAsymMask, xReg, -2.09f, mask);
        AscendC::Reg::Select<float>(outReg, negAsymOutReg, outReg, negAsymMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GE>(posAsymMask, xReg, 2.09f, mask);
        AscendC::Reg::Select<float>(outReg, posAsymOutReg, outReg, posAsymMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(overflowMask, xReg, 103.892f, mask);
        AscendC::Reg::Duplicate<float>(tmp1Reg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, tmp1Reg, outReg, overflowMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(infMask, absReg, infValue, mask);
        AscendC::Reg::Duplicate<float>(tmp1Reg, nanValue, mask);
        AscendC::Reg::Select<float>(outReg, tmp1Reg, outReg, infMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void AiryAiReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<AiryAiRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("airy_ai(Tensor x) -> Tensor");
}

torch::Tensor airy_ai_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "airy_ai only supports float32");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("airy_ai", airy_ai_meta);
}

std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / TOTAL_TILE_BUFFERS / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) {
        tileBytes = BLOCK_BYTES;
    }
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) {
        tileElems = 8;
    }
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

class KernelAiryAi {
public:
    __aicore__ inline KernelAiryAi() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockIdx * blockLength);

        int64_t tileBytes = ((tileLength_ * static_cast<int64_t>(sizeof(float)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(inQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto inLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(inLocal, xGm_[offset], p, pad);
        inQueue_.EnQue(inLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto inLocal = inQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        AiryAiReg(outLocal, inLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

__global__ __aicore__ __vector__ void airy_ai_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelAiryAi op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

torch::Tensor airy_ai_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "airy_ai only supports float32");

    auto input = x.contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) = calc_tiling_params(totalLength, input.element_size());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        airy_ai_kernel<<<numBlocks, nullptr, stream>>>(xPtr, yPtr, totalLength, blockLength, tileLength);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("AiryAi", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("airy_ai", airy_ai_npu);
}

} // namespace AiryAi
} // namespace ops_multimodal_fusion
