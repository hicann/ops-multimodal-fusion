/*!
 * \file gru_cell.asc
 * \brief GRUCell forward operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * Schema:
 *   gru_cell(input, hx, weight_ih, weight_hh, bias_ih, bias_hh) -> hy
 *
 * Supports 1-D unbatched input/state and 2-D batched input/state.
 * Gate order follows PyTorch: reset, update, new (r, z, n).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace GruCell {

static constexpr int64_t kScalarSlotBytes = 32;
static constexpr int64_t kFloatSlotElems = kScalarSlotBytes / static_cast<int64_t>(sizeof(float));
static constexpr int64_t kGateCount = 3;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("gru_cell(Tensor input, Tensor hx, Tensor weight_ih, Tensor weight_hh, "
          "Tensor? bias_ih=None, Tensor? bias_hh=None) -> Tensor");
}

static void check_common(
    const torch::Tensor &input,
    const torch::Tensor &hx,
    const torch::Tensor &weightIh,
    const torch::Tensor &weightHh,
    const c10::optional<torch::Tensor> &biasIhOpt,
    const c10::optional<torch::Tensor> &biasHhOpt)
{
    bool batched = (input.dim() == 2);
    bool unbatched = (input.dim() == 1);
    TORCH_CHECK(batched || unbatched,
                "gru_cell: input must be 1-D [input_size] or 2-D [batch, input_size], got ",
                input.dim(), "-D");
    TORCH_CHECK(hx.dim() == input.dim(),
                "gru_cell: hx must have the same rank as input; got input=",
                input.dim(), "-D hx=", hx.dim(), "-D");

    const int64_t inputSize = unbatched ? input.size(0) : input.size(1);
    const int64_t hiddenSize = unbatched ? hx.size(0) : hx.size(1);
    if (batched) {
        TORCH_CHECK(input.size(0) == hx.size(0),
                    "gru_cell: input batch must match hx batch");
        TORCH_CHECK(input.size(0) > 0, "gru_cell: batch must be positive");
    }
    TORCH_CHECK(inputSize > 0 && hiddenSize > 0,
                "gru_cell: input_size and hidden_size must be positive");

    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "gru_cell: only float16 and float32 are supported, got ",
                input.scalar_type());
    TORCH_CHECK(hx.scalar_type() == input.scalar_type() &&
                weightIh.scalar_type() == input.scalar_type() &&
                weightHh.scalar_type() == input.scalar_type(),
                "gru_cell: input, hx, weight_ih, and weight_hh must have the same dtype");

    TORCH_CHECK(weightIh.dim() == 2,
                "gru_cell: weight_ih must be 2-D [3 * hidden_size, input_size]");
    TORCH_CHECK(weightHh.dim() == 2,
                "gru_cell: weight_hh must be 2-D [3 * hidden_size, hidden_size]");
    TORCH_CHECK(weightIh.size(0) == 3 * hiddenSize && weightIh.size(1) == inputSize,
                "gru_cell: weight_ih must have shape [3 * hidden_size, input_size], got ",
                weightIh.sizes());
    TORCH_CHECK(weightHh.size(0) == 3 * hiddenSize && weightHh.size(1) == hiddenSize,
                "gru_cell: weight_hh must have shape [3 * hidden_size, hidden_size], got ",
                weightHh.sizes());

    if (biasIhOpt.has_value()) {
        const auto &bias = biasIhOpt.value();
        TORCH_CHECK(bias.defined(), "gru_cell: bias_ih is undefined");
        TORCH_CHECK(bias.dim() == 1 && bias.size(0) == 3 * hiddenSize,
                    "gru_cell: bias_ih must have shape [3 * hidden_size]");
        TORCH_CHECK(bias.scalar_type() == input.scalar_type(),
                    "gru_cell: bias_ih dtype must match input dtype");
    }
    if (biasHhOpt.has_value()) {
        const auto &bias = biasHhOpt.value();
        TORCH_CHECK(bias.defined(), "gru_cell: bias_hh is undefined");
        TORCH_CHECK(bias.dim() == 1 && bias.size(0) == 3 * hiddenSize,
                    "gru_cell: bias_hh must have shape [3 * hidden_size]");
        TORCH_CHECK(bias.scalar_type() == input.scalar_type(),
                    "gru_cell: bias_hh dtype must match input dtype");
    }
}

torch::Tensor gru_cell_meta(
    const torch::Tensor &input,
    const torch::Tensor &hx,
    const torch::Tensor &weightIh,
    const torch::Tensor &weightHh,
    const c10::optional<torch::Tensor> &biasIhOpt,
    const c10::optional<torch::Tensor> &biasHhOpt)
{
    check_common(input, hx, weightIh, weightHh, biasIhOpt, biasHhOpt);
    return torch::empty_like(hx);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("gru_cell", gru_cell_meta);
}

static int64_t calc_block_count(int64_t totalOutputs)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "gru_cell: coreNum must be positive");
    return std::max<int64_t>(1, std::min<int64_t>(totalOutputs, coreNum));
}

__simd_vf__ inline void InitGatesZeroVf(__ubuf__ float *gateAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
    for (int32_t gate = 0; gate < kGateCount; ++gate) {
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            gateAddr + gate * kFloatSlotElems, zeroReg, mask);
    }
}

template <typename T>
__simd_vf__ inline void AddScalarToAccumVf(__ubuf__ float *accumAddr, __ubuf__ T *valueAddr)
{
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(accumReg, accumAddr);
    if constexpr (std::is_same<T, half>::value) {
        AscendC::Reg::RegTensor<half> halfReg;
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(halfReg, valueAddr);
        AscendC::Reg::Cast<float, half, castToFloat>(valueReg, halfReg, mask);
    } else {
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            valueReg, (__ubuf__ float *)valueAddr);
    }
    AscendC::Reg::Add(accumReg, accumReg, valueReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, mask);
}

template <typename T>
__simd_vf__ inline void AccumulateProductVf(
    __ubuf__ float *accumAddr, __ubuf__ T *lhsAddr, __ubuf__ T *rhsAddr)
{
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<float> lhsReg;
    AscendC::Reg::RegTensor<float> rhsReg;
    AscendC::Reg::RegTensor<float> prodReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(accumReg, accumAddr);
    if constexpr (std::is_same<T, half>::value) {
        AscendC::Reg::RegTensor<half> lhsHalfReg;
        AscendC::Reg::RegTensor<half> rhsHalfReg;
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(lhsHalfReg, lhsAddr);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(rhsHalfReg, rhsAddr);
        AscendC::Reg::Cast<float, half, castToFloat>(lhsReg, lhsHalfReg, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(rhsReg, rhsHalfReg, mask);
    } else {
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            lhsReg, (__ubuf__ float *)lhsAddr);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            rhsReg, (__ubuf__ float *)rhsAddr);
    }
    AscendC::Reg::Mul(prodReg, lhsReg, rhsReg, mask);
    AscendC::Reg::Add(accumReg, accumReg, prodReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, mask);
}

template <typename T>
__simd_vf__ inline void CastScalarToFloatVf(__ubuf__ float *dstAddr, __ubuf__ T *srcAddr)
{
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> dstReg;
    if constexpr (std::is_same<T, half>::value) {
        AscendC::Reg::RegTensor<half> srcReg;
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr);
        AscendC::Reg::Cast<float, half, castToFloat>(dstReg, srcReg, mask);
    } else {
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            dstReg, (__ubuf__ float *)srcAddr);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        dstAddr, dstReg, mask);
}

__simd_vf__ inline void CombineGruVf(
    __ubuf__ float *hyAddr,
    __ubuf__ float *inputGateAddr,
    __ubuf__ float *hiddenGateAddr,
    __ubuf__ float *hxAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> iRReg, iZReg, iNReg;
    AscendC::Reg::RegTensor<float> hRReg, hZReg, hNReg;
    AscendC::Reg::RegTensor<float> hxReg;
    AscendC::Reg::RegTensor<float> resetReg, updateReg, newReg;
    AscendC::Reg::RegTensor<float> denomReg, oneReg, twoReg;
    AscendC::Reg::RegTensor<float> tmpReg, hyReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        iRReg, inputGateAddr + 0 * kFloatSlotElems);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        iZReg, inputGateAddr + 1 * kFloatSlotElems);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        iNReg, inputGateAddr + 2 * kFloatSlotElems);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        hRReg, hiddenGateAddr + 0 * kFloatSlotElems);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        hZReg, hiddenGateAddr + 1 * kFloatSlotElems);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        hNReg, hiddenGateAddr + 2 * kFloatSlotElems);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(hxReg, hxAddr);

    AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
    AscendC::Reg::Duplicate<float>(twoReg, 2.0f, mask);

    AscendC::Reg::Add(resetReg, iRReg, hRReg, mask);
    AscendC::Reg::Muls(denomReg, resetReg, -1.0f, mask);
    AscendC::Reg::Exp(denomReg, denomReg, mask);
    AscendC::Reg::Adds(denomReg, denomReg, 1.0f, mask);
    AscendC::Reg::Div(resetReg, oneReg, denomReg, mask);

    AscendC::Reg::Add(updateReg, iZReg, hZReg, mask);
    AscendC::Reg::Muls(denomReg, updateReg, -1.0f, mask);
    AscendC::Reg::Exp(denomReg, denomReg, mask);
    AscendC::Reg::Adds(denomReg, denomReg, 1.0f, mask);
    AscendC::Reg::Div(updateReg, oneReg, denomReg, mask);

    AscendC::Reg::Mul(tmpReg, resetReg, hNReg, mask);
    AscendC::Reg::Add(newReg, iNReg, tmpReg, mask);
    AscendC::Reg::Muls(denomReg, newReg, -2.0f, mask);
    AscendC::Reg::Exp(denomReg, denomReg, mask);
    AscendC::Reg::Adds(denomReg, denomReg, 1.0f, mask);
    AscendC::Reg::Div(newReg, twoReg, denomReg, mask);
    AscendC::Reg::Adds(newReg, newReg, -1.0f, mask);

    AscendC::Reg::Sub(tmpReg, hxReg, newReg, mask);
    AscendC::Reg::Mul(tmpReg, updateReg, tmpReg, mask);
    AscendC::Reg::Add(hyReg, newReg, tmpReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(hyAddr, hyReg, mask);
}

template <typename T>
__simd_vf__ inline void StoreScalarFromFloatVf(__ubuf__ T *dstAddr, __ubuf__ float *srcAddr)
{
    static constexpr AscendC::Reg::CastTrait castFromFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr);
    if constexpr (std::is_same<T, half>::value) {
        AscendC::Reg::RegTensor<half> dstReg;
        AscendC::Reg::Cast<half, float, castFromFloat>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            (__ubuf__ half *)dstAddr, dstReg, mask);
    } else {
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            (__ubuf__ float *)dstAddr, srcReg, mask);
    }
}

__aicore__ inline void InitGatesZero(AscendC::LocalTensor<float> gateLocal)
{
    asc_vf_call<InitGatesZeroVf>((__ubuf__ float *)gateLocal.GetPhyAddr());
}

template <typename T>
__aicore__ inline void AddScalarToAccum(
    AscendC::LocalTensor<float> accumLocal, AscendC::LocalTensor<T> valueLocal)
{
    asc_vf_call<AddScalarToAccumVf<T>>(
        (__ubuf__ float *)accumLocal.GetPhyAddr(),
        (__ubuf__ T *)valueLocal.GetPhyAddr());
}

template <typename T>
__aicore__ inline void AccumulateProduct(
    AscendC::LocalTensor<float> accumLocal,
    AscendC::LocalTensor<T> lhsLocal,
    AscendC::LocalTensor<T> rhsLocal)
{
    asc_vf_call<AccumulateProductVf<T>>(
        (__ubuf__ float *)accumLocal.GetPhyAddr(),
        (__ubuf__ T *)lhsLocal.GetPhyAddr(),
        (__ubuf__ T *)rhsLocal.GetPhyAddr());
}

template <typename T>
__aicore__ inline void CastScalarToFloat(
    AscendC::LocalTensor<float> dstLocal, AscendC::LocalTensor<T> srcLocal)
{
    asc_vf_call<CastScalarToFloatVf<T>>(
        (__ubuf__ float *)dstLocal.GetPhyAddr(),
        (__ubuf__ T *)srcLocal.GetPhyAddr());
}

__aicore__ inline void CombineGru(
    AscendC::LocalTensor<float> hyLocal,
    AscendC::LocalTensor<float> inputGates,
    AscendC::LocalTensor<float> hiddenGates,
    AscendC::LocalTensor<float> hxLocal)
{
    asc_vf_call<CombineGruVf>(
        (__ubuf__ float *)hyLocal.GetPhyAddr(),
        (__ubuf__ float *)inputGates.GetPhyAddr(),
        (__ubuf__ float *)hiddenGates.GetPhyAddr(),
        (__ubuf__ float *)hxLocal.GetPhyAddr());
}

template <typename T>
__aicore__ inline void StoreScalarFromFloat(
    AscendC::LocalTensor<T> dstLocal, AscendC::LocalTensor<float> srcLocal)
{
    asc_vf_call<StoreScalarFromFloatVf<T>>(
        (__ubuf__ T *)dstLocal.GetPhyAddr(),
        (__ubuf__ float *)srcLocal.GetPhyAddr());
}

template <typename T>
class KernelGruCell {
public:
    __aicore__ inline KernelGruCell() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR hx,
        GM_ADDR weightIh, GM_ADDR weightHh,
        GM_ADDR biasIh, GM_ADDR biasHh,
        GM_ADDR hy,
        int64_t totalOutputs, int64_t blockLength,
        int64_t batch, int64_t inputSize, int64_t hiddenSize,
        bool hasBiasIh, bool hasBiasHh)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        hxGm_.SetGlobalBuffer((__gm__ T *)hx);
        weightIhGm_.SetGlobalBuffer((__gm__ T *)weightIh);
        weightHhGm_.SetGlobalBuffer((__gm__ T *)weightHh);
        biasIhGm_.SetGlobalBuffer((__gm__ T *)biasIh);
        biasHhGm_.SetGlobalBuffer((__gm__ T *)biasHh);
        hyGm_.SetGlobalBuffer((__gm__ T *)hy);
        totalOutputs_ = totalOutputs;
        blockLength_ = blockLength;
        batch_ = batch;
        inputSize_ = inputSize;
        hiddenSize_ = hiddenSize;
        hasBiasIh_ = hasBiasIh;
        hasBiasHh_ = hasBiasHh;

        pipe_.InitBuffer(tbufLhs_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufRhs_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufHxT_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufHyT_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufInputGates_, static_cast<uint32_t>(kGateCount * kScalarSlotBytes));
        pipe_.InitBuffer(tbufHiddenGates_, static_cast<uint32_t>(kGateCount * kScalarSlotBytes));
        pipe_.InitBuffer(tbufHxF_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufHyF_, static_cast<uint32_t>(kScalarSlotBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t start = blockIdx * blockLength_;
        int64_t end = start + blockLength_;
        if (end > totalOutputs_) {
            end = totalOutputs_;
        }
        for (int64_t linear = start; linear < end; ++linear) {
            ComputeOne(linear);
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams()
    {
        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(sizeof(T));
        copy.srcStride = 0;
        copy.dstStride = 0;
        return copy;
    }

    __aicore__ inline void LoadScalar(AscendC::LocalTensor<T> local, AscendC::GlobalTensor<T> &gm, int64_t offset)
    {
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(local, gm[offset], CopyParams(), pad);
    }

    __aicore__ inline void StoreScalar(AscendC::GlobalTensor<T> &gm, int64_t offset, AscendC::LocalTensor<T> local)
    {
        AscendC::DataCopyPad(gm[offset], local, CopyParams());
    }

    __aicore__ inline void AddInputBiasIfPresent(
        int64_t gate, int64_t h, AscendC::LocalTensor<float> gateAccum)
    {
        if (!hasBiasIh_) {
            return;
        }
        auto rhsLocal = tbufRhs_.template Get<T>();
        LoadScalar(rhsLocal, biasIhGm_, gate * hiddenSize_ + h);
        AscendC::PipeBarrier<PIPE_ALL>();
        AddScalarToAccum<T>(gateAccum, rhsLocal);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void AddHiddenBiasIfPresent(
        int64_t gate, int64_t h, AscendC::LocalTensor<float> gateAccum)
    {
        if (!hasBiasHh_) {
            return;
        }
        auto rhsLocal = tbufRhs_.template Get<T>();
        LoadScalar(rhsLocal, biasHhGm_, gate * hiddenSize_ + h);
        AscendC::PipeBarrier<PIPE_ALL>();
        AddScalarToAccum<T>(gateAccum, rhsLocal);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void AccumulateInputDot(
        int64_t b, int64_t gate, int64_t h, AscendC::LocalTensor<float> gateAccum)
    {
        auto lhsLocal = tbufLhs_.template Get<T>();
        auto rhsLocal = tbufRhs_.template Get<T>();
        int64_t weightRow = gate * hiddenSize_ + h;
        for (int64_t k = 0; k < inputSize_; ++k) {
            LoadScalar(lhsLocal, inputGm_, b * inputSize_ + k);
            LoadScalar(rhsLocal, weightIhGm_, weightRow * inputSize_ + k);
            AscendC::PipeBarrier<PIPE_ALL>();
            AccumulateProduct<T>(gateAccum, lhsLocal, rhsLocal);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

    __aicore__ inline void AccumulateHiddenDot(
        int64_t b, int64_t gate, int64_t h, AscendC::LocalTensor<float> gateAccum)
    {
        auto lhsLocal = tbufLhs_.template Get<T>();
        auto rhsLocal = tbufRhs_.template Get<T>();
        int64_t weightRow = gate * hiddenSize_ + h;
        for (int64_t k = 0; k < hiddenSize_; ++k) {
            LoadScalar(lhsLocal, hxGm_, b * hiddenSize_ + k);
            LoadScalar(rhsLocal, weightHhGm_, weightRow * hiddenSize_ + k);
            AscendC::PipeBarrier<PIPE_ALL>();
            AccumulateProduct<T>(gateAccum, lhsLocal, rhsLocal);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

    __aicore__ inline void ComputeOne(int64_t linear)
    {
        (void)batch_;
        int64_t b = linear / hiddenSize_;
        int64_t h = linear - b * hiddenSize_;
        auto inputGates = tbufInputGates_.template Get<float>();
        auto hiddenGates = tbufHiddenGates_.template Get<float>();

        InitGatesZero(inputGates);
        InitGatesZero(hiddenGates);
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t gate = 0; gate < kGateCount; ++gate) {
            auto iAccum = inputGates[static_cast<int32_t>(gate * kFloatSlotElems)];
            auto hAccum = hiddenGates[static_cast<int32_t>(gate * kFloatSlotElems)];
            AddInputBiasIfPresent(gate, h, iAccum);
            AddHiddenBiasIfPresent(gate, h, hAccum);
            AccumulateInputDot(b, gate, h, iAccum);
            AccumulateHiddenDot(b, gate, h, hAccum);
        }

        auto hxT = tbufHxT_.template Get<T>();
        auto hxF = tbufHxF_.template Get<float>();
        LoadScalar(hxT, hxGm_, linear);
        AscendC::PipeBarrier<PIPE_ALL>();
        CastScalarToFloat<T>(hxF, hxT);
        AscendC::PipeBarrier<PIPE_ALL>();

        auto hyF = tbufHyF_.template Get<float>();
        CombineGru(hyF, inputGates, hiddenGates, hxF);
        AscendC::PipeBarrier<PIPE_ALL>();

        auto hyT = tbufHyT_.template Get<T>();
        StoreScalarFromFloat<T>(hyT, hyF);
        AscendC::PipeBarrier<PIPE_ALL>();
        StoreScalar(hyGm_, linear, hyT);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> hxGm_;
    AscendC::GlobalTensor<T> weightIhGm_;
    AscendC::GlobalTensor<T> weightHhGm_;
    AscendC::GlobalTensor<T> biasIhGm_;
    AscendC::GlobalTensor<T> biasHhGm_;
    AscendC::GlobalTensor<T> hyGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufLhs_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRhs_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufHxT_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufHyT_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInputGates_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufHiddenGates_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufHxF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufHyF_;
    int64_t totalOutputs_ = 0;
    int64_t blockLength_ = 1;
    int64_t batch_ = 0;
    int64_t inputSize_ = 0;
    int64_t hiddenSize_ = 0;
    bool hasBiasIh_ = false;
    bool hasBiasHh_ = false;
};

template <typename T>
__global__ __aicore__ __vector__ void gru_cell_kernel(
    GM_ADDR input, GM_ADDR hx,
    GM_ADDR weightIh, GM_ADDR weightHh,
    GM_ADDR biasIh, GM_ADDR biasHh,
    GM_ADDR hy,
    int64_t totalOutputs, int64_t blockLength,
    int64_t batch, int64_t inputSize, int64_t hiddenSize,
    bool hasBiasIh, bool hasBiasHh)
{
    KernelGruCell<T> op;
    op.Init(input, hx, weightIh, weightHh, biasIh, biasHh, hy,
            totalOutputs, blockLength, batch, inputSize, hiddenSize,
            hasBiasIh, hasBiasHh);
    op.Process();
}

torch::Tensor gru_cell_npu(
    const torch::Tensor &input,
    const torch::Tensor &hx,
    const torch::Tensor &weightIh,
    const torch::Tensor &weightHh,
    const c10::optional<torch::Tensor> &biasIhOpt,
    const c10::optional<torch::Tensor> &biasHhOpt)
{
    check_common(input, hx, weightIh, weightHh, biasIhOpt, biasHhOpt);
    const c10::OptionalDeviceGuard guard(input.device());

    auto inputC = input.contiguous();
    auto hxC = hx.contiguous();
    auto weightIhC = weightIh.contiguous();
    auto weightHhC = weightHh.contiguous();
    bool hasBiasIh = biasIhOpt.has_value();
    bool hasBiasHh = biasHhOpt.has_value();
    torch::Tensor biasIhC = hasBiasIh ? biasIhOpt.value().contiguous()
                                      : torch::empty({1}, inputC.options());
    torch::Tensor biasHhC = hasBiasHh ? biasHhOpt.value().contiguous()
                                      : torch::empty({1}, inputC.options());

    auto hy = torch::empty_like(hxC);
    bool unbatched = (inputC.dim() == 1);
    int64_t batch = unbatched ? 1 : inputC.size(0);
    int64_t inputSize = unbatched ? inputC.size(0) : inputC.size(1);
    int64_t hiddenSize = unbatched ? hxC.size(0) : hxC.size(1);
    int64_t totalOutputs = batch * hiddenSize;
    int64_t numBlocks = calc_block_count(totalOutputs);
    int64_t blockLength = (totalOutputs + numBlocks - 1) / numBlocks;

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto hxPtr = (GM_ADDR)hxC.data_ptr();
    auto weightIhPtr = (GM_ADDR)weightIhC.data_ptr();
    auto weightHhPtr = (GM_ADDR)weightHhC.data_ptr();
    auto biasIhPtr = (GM_ADDR)biasIhC.data_ptr();
    auto biasHhPtr = (GM_ADDR)biasHhC.data_ptr();
    auto hyPtr = (GM_ADDR)hy.data_ptr();

    auto aclCall = [=]() -> int {
        AT_DISPATCH_SWITCH(
            inputC.scalar_type(), "gru_cell_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                gru_cell_kernel<float><<<numBlocks, nullptr, stream>>>(
                    inputPtr, hxPtr, weightIhPtr, weightHhPtr,
                    biasIhPtr, biasHhPtr, hyPtr,
                    totalOutputs, blockLength, batch, inputSize, hiddenSize,
                    hasBiasIh, hasBiasHh);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                gru_cell_kernel<half><<<numBlocks, nullptr, stream>>>(
                    inputPtr, hxPtr, weightIhPtr, weightHhPtr,
                    biasIhPtr, biasHhPtr, hyPtr,
                    totalOutputs, blockLength, batch, inputSize, hiddenSize,
                    hasBiasIh, hasBiasHh);
            }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("GruCellReg", aclCall);
    return hy;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("gru_cell", gru_cell_npu);
}

} // namespace GruCell
} // namespace ops_multimodal_fusion
