/*!
 * \file poisson.asc
 * \brief Poisson-distribution sampling operator for Ascend NPU (dav-3510)
 *
 * torch.poisson(input) equivalent, exposed functionally:
 *   ops_multimodal_fusion.poisson(x, seed) -> Tensor (same shape/dtype/device as x)
 *
 * Unlike cauchy/exponential/geometric/log_normal (where x only supplies
 * shape), here x IS the per-element rate lambda and its data is read. The
 * output y[i] ~ Poisson(x[i]),  P(X=k) = lambda^k e^-lambda / k!.
 *
 * PyTorch CUDA calls curand_poisson (not portable). The portable ground
 * truth is the CPU sample_poisson (Numpy rk_poisson): Knuth's product
 * algorithm for lambda < 10, a PTRS transformed-rejection for lambda >= 10,
 * lambda == 0 -> 0, lambda < 0 rejected. This kernel implements ONLY Knuth
 * (numerically correct for all lambda >= 0; the PTRS large-lambda speedup
 * needs lgamma, which has no Reg primitive on dav-3510 -> deferred).
 *
 * Knuth (scalar): L=exp(-lambda); k=0; p=1; do{ k++; p*=U; } while(p>L);
 * return k-1.  Vectorized: p is multiplied by U in [0,1) each step so it is
 * monotonically non-increasing; once p<=L it stays <=L. Hence the predicate
 * "active = (p > L)", recomputed every step from the current p, is
 * self-sticky -- no persistent mask buffer is needed. PhiloxRandom is a
 * harness-level call (cannot run inside __simd_vf__), so the iteration loop
 * lives in ProcessTile: a fixed MAX_ITERS steps, each drawing a fresh
 * independent uniform (Philox counter word2 = iteration index). MAX_ITERS is
 * chosen so the truncation probability is negligible for the supported
 * lambda range (Knuth step count ~ Poisson(lambda)+1; MAX_ITERS=128 covers
 * lambda up to ~20 with truncation prob far below fp rounding). Larger
 * lambda is biased by truncation -> documented, removed by the deferred PTRS.
 *
 * lambda == 0: L = exp(0) = 1, p starts at 1, (p > L) == (1 > 1) == false,
 * so k stays 0 and result = max(0-1, 0) = 0 (matches PyTorch). PhiloxRandom
 * is [0,1) so U == 0 is possible; in Knuth that just makes p*U == 0 <= L,
 * an immediate (correct) convergence -- no clamp needed.
 *
 * RegBase 3-layer shape (__simd_vf__ / asc_vf_call / harness); normal
 * AscendC only for GM/UB movement, queues, sync. Reproducibility and the
 * statistical (non-bit-exact) acceptance basis match cauchy/geometric
 * (see tests/poisson/test_poisson.py).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "adv_api/math/philox.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Poisson {

// Knuth iteration cap. Step count ~ Poisson(lambda)+1; 128 keeps the
// truncation probability negligible for lambda up to ~20 (tested range).
constexpr int64_t MAX_ITERS = 128;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("poisson(Tensor x, int seed=0) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor poisson_meta(const torch::Tensor &x, int64_t seed)
{
    (void)seed;
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "poisson: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("poisson", poisson_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // Per element UB: input queue (T) + output queue (T), both double-
    // buffered, + 5 float scratch (lambda, L, p, k, u).
    constexpr static int64_t SCRATCH_FLOATS = 5;
    // PhiloxRandom count is uint16_t; keep one tile well under 65535.
    constexpr static int64_t MAX_TILE_ELEMS = 32768;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "poisson: coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t bytesPerElem = PIPELINE_DEPTH * 2 * elemSize +
        SCRATCH_FLOATS * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / static_cast<int64_t>(sizeof(float));
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min(tileElems, MAX_TILE_ELEMS);
    TORCH_CHECK(tileElems > 0, "poisson: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel =====================

// half -> float cast for fp16 rate input.
__simd_vf__ inline void CastHalfToFloatRegVf(__ubuf__ float *dstAddr, __ubuf__ half *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, half, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastHalfToFloatReg(AscendC::LocalTensor<float> &dst,
                                          AscendC::LocalTensor<half> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ half *srcAddr = (__ubuf__ half *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastHalfToFloatRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

// L = exp(-lambda).  lambda == 0 -> L = 1.
__simd_vf__ inline void NegExpRegVf(__ubuf__ float *lAddr, __ubuf__ float *lamAddr,
                                    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(reg, lamAddr + offset);
        AscendC::Reg::Muls(reg, reg, -1.0f, mask);
        AscendC::Reg::Exp(reg, reg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            lAddr + offset, reg, mask);
    }
}

__aicore__ inline void NegExpReg(AscendC::LocalTensor<float> &L,
                                 AscendC::LocalTensor<float> &lam, int64_t count)
{
    __ubuf__ float *lAddr = (__ubuf__ float *)L.GetPhyAddr();
    __ubuf__ float *lamAddr = (__ubuf__ float *)lam.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<NegExpRegVf>(lAddr, lamAddr, elementCount, chunkCount);
}

// p = 1.0, k = 0.0 (Knuth init).
__simd_vf__ inline void InitPKRegVf(__ubuf__ float *pAddr, __ubuf__ float *kAddr,
                                    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> pReg;
    AscendC::Reg::RegTensor<float> kReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<float>(pReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(kReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            pAddr + offset, pReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            kAddr + offset, kReg, mask);
    }
}

__aicore__ inline void InitPKReg(AscendC::LocalTensor<float> &p,
                                 AscendC::LocalTensor<float> &k, int64_t count)
{
    __ubuf__ float *pAddr = (__ubuf__ float *)p.GetPhyAddr();
    __ubuf__ float *kAddr = (__ubuf__ float *)k.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<InitPKRegVf>(pAddr, kAddr, elementCount, chunkCount);
}

// One Knuth step: active = (p > L); p = active ? p*u : p; k = active ? k+1 : k.
// p is monotone non-increasing => the predicate is self-sticky.
__simd_vf__ inline void KnuthStepRegVf(__ubuf__ float *pAddr, __ubuf__ float *kAddr,
                                       __ubuf__ float *lAddr, __ubuf__ float *uAddr,
                                       uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> pReg;
    AscendC::Reg::RegTensor<float> kReg;
    AscendC::Reg::RegTensor<float> lReg;
    AscendC::Reg::RegTensor<float> uReg;
    AscendC::Reg::RegTensor<float> newReg;
    AscendC::Reg::RegTensor<float> selReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(pReg, pAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(kReg, kAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(lReg, lAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(uReg, uAddr + offset);
        // active = (p > L).  CMPMODE lives in AscendC::, not AscendC::Reg::.
        AscendC::Reg::MaskReg active;
        AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(active, pReg, lReg, mask);
        // Select(dst, src0, src1, mask): mask-true -> src0, mask-false -> src1.
        // p = active ? p*u : p
        AscendC::Reg::Mul(newReg, pReg, uReg, mask);
        AscendC::Reg::Select(selReg, newReg, pReg, active);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            pAddr + offset, selReg, mask);
        // k = active ? k+1 : k
        AscendC::Reg::Adds(newReg, kReg, 1.0f, mask);
        AscendC::Reg::Select(selReg, newReg, kReg, active);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            kAddr + offset, selReg, mask);
    }
}

__aicore__ inline void KnuthStepReg(AscendC::LocalTensor<float> &p,
                                    AscendC::LocalTensor<float> &k,
                                    AscendC::LocalTensor<float> &L,
                                    AscendC::LocalTensor<float> &u, int64_t count)
{
    __ubuf__ float *pAddr = (__ubuf__ float *)p.GetPhyAddr();
    __ubuf__ float *kAddr = (__ubuf__ float *)k.GetPhyAddr();
    __ubuf__ float *lAddr = (__ubuf__ float *)L.GetPhyAddr();
    __ubuf__ float *uAddr = (__ubuf__ float *)u.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<KnuthStepRegVf>(pAddr, kAddr, lAddr, uAddr, elementCount, chunkCount);
}

// result = max(k - 1, 0)  (Knuth returns count-1; clamp guards lambda==0).
__simd_vf__ inline void FinalizeRegVf(__ubuf__ float *dstAddr, __ubuf__ float *kAddr,
                                      uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(reg, kAddr + offset);
        AscendC::Reg::Adds(reg, reg, -1.0f, mask);
        AscendC::Reg::Maxs(reg, reg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, reg, mask);
    }
}

__aicore__ inline void FinalizeReg(AscendC::LocalTensor<float> &dst,
                                   AscendC::LocalTensor<float> &k, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *kAddr = (__ubuf__ float *)k.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<FinalizeRegVf>(dstAddr, kAddr, elementCount, chunkCount);
}

// float -> half cast for fp16 output (mirrors cauchy/geometric path).
__simd_vf__ inline void CastFloatToHalfRegVf(__ubuf__ half *dstAddr, __ubuf__ float *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<half> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<half, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastFloatToHalfReg(AscendC::LocalTensor<half> &dst,
                                          AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ half *dstAddr = (__ubuf__ half *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFloatToHalfRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
class KernelPoisson {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;

public:
    __aicore__ inline KernelPoisson() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength,
        int64_t blockLength, int64_t tileElems, uint32_t key0, uint32_t key1)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        blockBase_ = blockLength * blockIdx;
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockBase_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockBase_);

        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufLam_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufL_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufP_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufK_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufU_,   tileElems * sizeof(float));

        key0_ = key0;
        key1_ = key1;

        int64_t currentBlockLength = totalLength - blockBase_;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileElems;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
        alignElems_ = 32 / static_cast<int64_t>(sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignedCount = ((count + alignElems_ - 1) / alignElems_) * alignElems_;

        // Copy in the rate lambda (this op reads its input).
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        AscendC::DataCopyExtParams inParams;
        inParams.blockCount = 1;
        inParams.blockLen = count * sizeof(T);
        inParams.srcStride = 0;
        inParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(xLocal, xGm_[offset], inParams, padParams);
        inQueueX_.EnQue(xLocal);
        xLocal = inQueueX_.template DeQue<T>();

        AscendC::LocalTensor<float> lamLocal = tbufLam_.Get<float>();
        AscendC::LocalTensor<float> LLocal = tbufL_.Get<float>();
        AscendC::LocalTensor<float> pLocal = tbufP_.Get<float>();
        AscendC::LocalTensor<float> kLocal = tbufK_.Get<float>();
        AscendC::LocalTensor<float> uLocal = tbufU_.Get<float>();

        if constexpr (kIsFloat) {
            AscendC::DataCopy(lamLocal, xLocal, alignedCount);
        } else {
            CastHalfToFloatReg(lamLocal, xLocal, alignedCount);
        }
        inQueueX_.FreeTensor(xLocal);
        AscendC::PipeBarrier<PIPE_V>();

        NegExpReg(LLocal, lamLocal, alignedCount);       // L = exp(-lambda)
        InitPKReg(pLocal, kLocal, alignedCount);          // p = 1, k = 0
        AscendC::PipeBarrier<PIPE_V>();

        int64_t globalElem = blockBase_ + offset;
        uint32_t ctrLo = static_cast<uint32_t>(static_cast<uint64_t>(globalElem) & 0xFFFFFFFFu);
        uint32_t ctrHi = static_cast<uint32_t>((static_cast<uint64_t>(globalElem) >> 32) & 0xFFFFFFFFu);
        AscendC::PhiloxKey key{key0_, key1_};

        for (int64_t j = 0; j < MAX_ITERS; ++j) {
            // Distinct counter per Knuth step => independent uniform stream;
            // fixed for a given seed+shape+input => deterministic.
            AscendC::PhiloxCounter ctr{ctrLo, ctrHi, static_cast<uint32_t>(j), 0u};
            AscendC::PhiloxRandom<7, float>(uLocal, key, ctr,
                static_cast<uint16_t>(alignedCount));
            AscendC::PipeBarrier<PIPE_V>();
            KnuthStepReg(pLocal, kLocal, LLocal, uLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
        }

        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            FinalizeReg(yLocal, kLocal, alignedCount);
        } else {
            // finalize in float (reuse lambda buffer), then cast to half.
            FinalizeReg(lamLocal, kLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastFloatToHalfReg(yLocal, lamLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.template DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufLam_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufL_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufP_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufK_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufU_;
    int64_t blockBase_ = 0;
    uint32_t key0_ = 0;
    uint32_t key1_ = 0;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
    int64_t alignElems_ = 8;
};

template <typename T>
__global__ __aicore__ __vector__ void poisson_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength,
    int64_t tileElems, uint32_t key0, uint32_t key1)
{
    KernelPoisson<T> op;
    op.Init(x, y, totalLength, blockLength, tileElems, key0, key1);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor poisson_npu(const torch::Tensor &x, int64_t seed)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "poisson: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    // Rate must be non-negative (PyTorch asserts lambda >= 0 per element).
    // Validate on a host copy: robust and avoids relying on a PrivateUse1
    // reduction. NaN fails ">= 0" and is therefore rejected too.
    if (x.numel() > 0) {
        auto xc = x.detach().to(torch::kCPU).to(torch::kFloat32);
        TORCH_CHECK(xc.min().item<double>() >= 0.0,
                    "invalid Poisson rate, expected rate to be non-negative");
    }

    const c10::OptionalDeviceGuard guard(x.device());
    auto y = torch::empty_like(x);

    int64_t totalLength = y.numel();
    if (totalLength == 0) {
        return y;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(totalLength, y.element_size());

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();
    uint32_t key0 = static_cast<uint32_t>(static_cast<uint64_t>(seed) & 0xFFFFFFFFu);
    uint32_t key1 = static_cast<uint32_t>((static_cast<uint64_t>(seed) >> 32) & 0xFFFFFFFFu);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "poisson_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                poisson_kernel<float><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileElems, key0, key1);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                poisson_kernel<half><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileElems, key0, key1);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Poisson", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("poisson", poisson_npu);
}

} // namespace Poisson
} // namespace ops_multimodal_fusion
