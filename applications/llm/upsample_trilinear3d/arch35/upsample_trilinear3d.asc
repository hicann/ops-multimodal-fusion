/*!
 * \file upsample_trilinear3d.asc
 * \brief UpsampleTrilinear3d forward operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.upsample_trilinear3d(
 *     input, output_size, align_corners=False,
 *     scales_d=-1.0, scales_h=-1.0, scales_w=-1.0) -> output
 *
 * input       : [N, C, D, H, W], fp16/fp32
 * output_size : [OD, OH, OW]
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <array>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace UpsampleTrilinear3d {

static constexpr int64_t kScalarSlotBytes = 32;
static constexpr double kMaxInt64AsDouble = 9.2233720368547758e18;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("upsample_trilinear3d(Tensor input, int[3] output_size, "
          "bool align_corners=False, float scales_d=-1., float scales_h=-1., "
          "float scales_w=-1.) -> Tensor");
}

static std::array<int64_t, 3> parse_int3(at::IntArrayRef ref, const char *name)
{
    TORCH_CHECK(ref.size() == 3,
                "upsample_trilinear3d: ", name,
                " must contain exactly three integers");
    return {ref[0], ref[1], ref[2]};
}

static bool valid_default_or_positive(double scale)
{
    return scale == -1.0 ||
           (scale == scale && scale > 0.0 && scale < kMaxInt64AsDouble);
}

static bool all_default_scales(double scalesD, double scalesH, double scalesW)
{
    return scalesD == -1.0 && scalesH == -1.0 && scalesW == -1.0;
}

static bool all_positive_scales(double scalesD, double scalesH, double scalesW)
{
    return scalesD > 0.0 && scalesH > 0.0 && scalesW > 0.0;
}

static void check_scaled_dim(
    int64_t inputSize, int64_t outputSize, double scale, const char *dimName)
{
    double scaledOutput = static_cast<double>(inputSize) * scale;
    TORCH_CHECK(scaledOutput >= 1.0 && scaledOutput < kMaxInt64AsDouble,
                "upsample_trilinear3d: floor(input_", dimName,
                " * scale_factor) must be in int64 range, got ", scaledOutput);
    int64_t expectedOutputSize = static_cast<int64_t>(scaledOutput);
    TORCH_CHECK(outputSize == expectedOutputSize,
                "upsample_trilinear3d: when scale_factor is provided, output_size[",
                dimName, "] must equal floor(input_", dimName,
                " * scale_factor); got output_size=", outputSize,
                ", expected=", expectedOutputSize, " for input_", dimName, "=",
                inputSize, " and scale_factor=", scale);
}

static void check_common(
    const torch::Tensor &input, at::IntArrayRef outputSizeRef,
    bool alignCorners, double scalesD, double scalesH, double scalesW)
{
    (void)alignCorners;
    TORCH_CHECK(input.dim() == 5,
                "upsample_trilinear3d: input must be 5-D [N, C, D, H, W], got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "upsample_trilinear3d: only float16 and float32 are supported, got ",
                input.scalar_type());

    auto out = parse_int3(outputSizeRef, "output_size");
    int64_t outD = out[0];
    int64_t outH = out[1];
    int64_t outW = out[2];
    TORCH_CHECK(input.size(0) > 0 && input.size(1) > 0 &&
                input.size(2) > 0 && input.size(3) > 0 && input.size(4) > 0,
                "upsample_trilinear3d: N, C, D, H, and W must be positive, got ",
                input.sizes());
    TORCH_CHECK(outD > 0 && outH > 0 && outW > 0,
                "upsample_trilinear3d: output_size entries must be positive, got [",
                outD, ", ", outH, ", ", outW, "]");
    TORCH_CHECK(valid_default_or_positive(scalesD) &&
                valid_default_or_positive(scalesH) &&
                valid_default_or_positive(scalesW),
                "upsample_trilinear3d: scales must be -1.0 or finite positive values, got [",
                scalesD, ", ", scalesH, ", ", scalesW, "]");

    bool sizePath = all_default_scales(scalesD, scalesH, scalesW);
    bool scalePath = all_positive_scales(scalesD, scalesH, scalesW);
    TORCH_CHECK(sizePath || scalePath,
                "upsample_trilinear3d: scales_d/scales_h/scales_w must be all -1.0 "
                "for size path or all finite positive values for scale_factor path, got [",
                scalesD, ", ", scalesH, ", ", scalesW, "]");
    if (scalePath) {
        check_scaled_dim(input.size(2), outD, scalesD, "D");
        check_scaled_dim(input.size(3), outH, scalesH, "H");
        check_scaled_dim(input.size(4), outW, scalesW, "W");
    }

    double totalOutput = static_cast<double>(input.size(0)) *
                         static_cast<double>(input.size(1)) *
                         static_cast<double>(outD) *
                         static_cast<double>(outH) *
                         static_cast<double>(outW);
    TORCH_CHECK(totalOutput <= static_cast<double>(0x7fffffff),
                "upsample_trilinear3d: output numel exceeds INT32_MAX");
}

torch::Tensor upsample_trilinear3d_meta(
    const torch::Tensor &input, at::IntArrayRef outputSize,
    bool alignCorners, double scalesD, double scalesH, double scalesW)
{
    check_common(input, outputSize, alignCorners, scalesD, scalesH, scalesW);
    auto out = parse_int3(outputSize, "output_size");
    return torch::empty({input.size(0), input.size(1), out[0], out[1], out[2]},
                        input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("upsample_trilinear3d", upsample_trilinear3d_meta);
}

static int64_t calc_block_count(int64_t totalOutputs)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "upsample_trilinear3d: coreNum must be positive");
    return std::max<int64_t>(1, std::min<int64_t>(totalOutputs, coreNum));
}

template <typename T>
__simd_vf__ inline void TrilinearInterpScalarVf(
    __ubuf__ T *outAddr, __ubuf__ T *sampleAddr,
    float lambdaD, float lambdaH, float lambdaW)
{
    static constexpr int64_t slotElems = kScalarSlotBytes / static_cast<int64_t>(sizeof(T));
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);

    AscendC::Reg::RegTensor<float> v000;
    AscendC::Reg::RegTensor<float> v001;
    AscendC::Reg::RegTensor<float> v010;
    AscendC::Reg::RegTensor<float> v011;
    AscendC::Reg::RegTensor<float> v100;
    AscendC::Reg::RegTensor<float> v101;
    AscendC::Reg::RegTensor<float> v110;
    AscendC::Reg::RegTensor<float> v111;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> d1Reg;
    AscendC::Reg::RegTensor<float> h1Reg;
    AscendC::Reg::RegTensor<float> w1Reg;
    AscendC::Reg::RegTensor<float> d0Reg;
    AscendC::Reg::RegTensor<float> h0Reg;
    AscendC::Reg::RegTensor<float> w0Reg;
    AscendC::Reg::RegTensor<float> t0;
    AscendC::Reg::RegTensor<float> t1;
    AscendC::Reg::RegTensor<float> c00;
    AscendC::Reg::RegTensor<float> c01;
    AscendC::Reg::RegTensor<float> c10;
    AscendC::Reg::RegTensor<float> c11;
    AscendC::Reg::RegTensor<float> c0;
    AscendC::Reg::RegTensor<float> c1;
    AscendC::Reg::RegTensor<float> outF;

    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    static constexpr AscendC::Reg::CastTrait castFromFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};

    if constexpr (sizeof(T) == 2) {
        AscendC::Reg::RegTensor<half> h000;
        AscendC::Reg::RegTensor<half> h001;
        AscendC::Reg::RegTensor<half> h010;
        AscendC::Reg::RegTensor<half> h011;
        AscendC::Reg::RegTensor<half> h100;
        AscendC::Reg::RegTensor<half> h101;
        AscendC::Reg::RegTensor<half> h110;
        AscendC::Reg::RegTensor<half> h111;
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h000, (__ubuf__ half *)(sampleAddr + 0 * slotElems));
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h001, (__ubuf__ half *)(sampleAddr + 1 * slotElems));
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h010, (__ubuf__ half *)(sampleAddr + 2 * slotElems));
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h011, (__ubuf__ half *)(sampleAddr + 3 * slotElems));
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h100, (__ubuf__ half *)(sampleAddr + 4 * slotElems));
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h101, (__ubuf__ half *)(sampleAddr + 5 * slotElems));
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h110, (__ubuf__ half *)(sampleAddr + 6 * slotElems));
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            h111, (__ubuf__ half *)(sampleAddr + 7 * slotElems));
        AscendC::Reg::Cast<float, half, castToFloat>(v000, h000, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(v001, h001, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(v010, h010, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(v011, h011, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(v100, h100, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(v101, h101, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(v110, h110, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(v111, h111, mask);
    } else {
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v000, (__ubuf__ float *)(sampleAddr + 0 * slotElems));
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v001, (__ubuf__ float *)(sampleAddr + 1 * slotElems));
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v010, (__ubuf__ float *)(sampleAddr + 2 * slotElems));
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v011, (__ubuf__ float *)(sampleAddr + 3 * slotElems));
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v100, (__ubuf__ float *)(sampleAddr + 4 * slotElems));
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v101, (__ubuf__ float *)(sampleAddr + 5 * slotElems));
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v110, (__ubuf__ float *)(sampleAddr + 6 * slotElems));
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            v111, (__ubuf__ float *)(sampleAddr + 7 * slotElems));
    }

    AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
    AscendC::Reg::Duplicate<float>(d1Reg, lambdaD, mask);
    AscendC::Reg::Duplicate<float>(h1Reg, lambdaH, mask);
    AscendC::Reg::Duplicate<float>(w1Reg, lambdaW, mask);
    AscendC::Reg::Sub(d0Reg, oneReg, d1Reg, mask);
    AscendC::Reg::Sub(h0Reg, oneReg, h1Reg, mask);
    AscendC::Reg::Sub(w0Reg, oneReg, w1Reg, mask);

    AscendC::Reg::Mul(t0, v000, w0Reg, mask);
    AscendC::Reg::Mul(t1, v001, w1Reg, mask);
    AscendC::Reg::Add(c00, t0, t1, mask);
    AscendC::Reg::Mul(t0, v010, w0Reg, mask);
    AscendC::Reg::Mul(t1, v011, w1Reg, mask);
    AscendC::Reg::Add(c01, t0, t1, mask);
    AscendC::Reg::Mul(t0, v100, w0Reg, mask);
    AscendC::Reg::Mul(t1, v101, w1Reg, mask);
    AscendC::Reg::Add(c10, t0, t1, mask);
    AscendC::Reg::Mul(t0, v110, w0Reg, mask);
    AscendC::Reg::Mul(t1, v111, w1Reg, mask);
    AscendC::Reg::Add(c11, t0, t1, mask);

    AscendC::Reg::Mul(t0, c00, h0Reg, mask);
    AscendC::Reg::Mul(t1, c01, h1Reg, mask);
    AscendC::Reg::Add(c0, t0, t1, mask);
    AscendC::Reg::Mul(t0, c10, h0Reg, mask);
    AscendC::Reg::Mul(t1, c11, h1Reg, mask);
    AscendC::Reg::Add(c1, t0, t1, mask);

    AscendC::Reg::Mul(t0, c0, d0Reg, mask);
    AscendC::Reg::Mul(t1, c1, d1Reg, mask);
    AscendC::Reg::Add(outF, t0, t1, mask);

    if constexpr (sizeof(T) == 2) {
        AscendC::Reg::RegTensor<half> outH;
        AscendC::Reg::Cast<half, float, castFromFloat>(outH, outF, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            (__ubuf__ half *)outAddr, outH, mask);
    } else {
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            (__ubuf__ float *)outAddr, outF, mask);
    }
}

template <typename T>
__aicore__ inline void TrilinearInterpScalar(
    AscendC::LocalTensor<T> outLocal, AscendC::LocalTensor<T> sampleLocal,
    float lambdaD, float lambdaH, float lambdaW)
{
    asc_vf_call<TrilinearInterpScalarVf<T>>(
        (__ubuf__ T *)outLocal.GetPhyAddr(),
        (__ubuf__ T *)sampleLocal.GetPhyAddr(),
        lambdaD, lambdaH, lambdaW);
}

template <typename T>
class KernelUpsampleTrilinear3d {
public:
    __aicore__ inline KernelUpsampleTrilinear3d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR output,
        int64_t totalOutputs, int64_t blockLength,
        int64_t inputD, int64_t inputH, int64_t inputW,
        int64_t outputD, int64_t outputH, int64_t outputW,
        bool alignCorners, float scaleD, float scaleH, float scaleW)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        totalOutputs_ = totalOutputs;
        blockLength_ = blockLength;
        inputD_ = inputD;
        inputH_ = inputH;
        inputW_ = inputW;
        outputD_ = outputD;
        outputH_ = outputH;
        outputW_ = outputW;
        alignCorners_ = alignCorners;
        scaleD_ = scaleD;
        scaleH_ = scaleH;
        scaleW_ = scaleW;
        inputPlaneSize_ = inputD_ * inputH_ * inputW_;
        outputPlaneSize_ = outputD_ * outputH_ * outputW_;

        pipe_.InitBuffer(tbufSamples_, static_cast<uint32_t>(kScalarSlotBytes * 8));
        pipe_.InitBuffer(tbufOutput_, static_cast<uint32_t>(kScalarSlotBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
        int64_t start = blockIdx * blockLength_;
        int64_t end = start + blockLength_;
        if (end > totalOutputs_) {
            end = totalOutputs_;
        }
        for (int64_t linear = start; linear < end; ++linear) {
            ComputeOne(linear);
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams()
    {
        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(sizeof(T));
        copy.srcStride = 0;
        copy.dstStride = 0;
        return copy;
    }

    __aicore__ inline int64_t SlotElems()
    {
        return kScalarSlotBytes / static_cast<int64_t>(sizeof(T));
    }

    __aicore__ inline void LoadSample(
        AscendC::LocalTensor<T> sampleLocal, int64_t sampleIdx, int64_t gmOffset)
    {
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(sampleLocal[sampleIdx * SlotElems()],
                             inputGm_[gmOffset], CopyParams(), pad);
    }

    __aicore__ inline void StoreScalar(
        AscendC::GlobalTensor<T> &gm, int64_t offset, AscendC::LocalTensor<T> local)
    {
        AscendC::DataCopyPad(gm[offset], local, CopyParams());
    }

    __aicore__ inline int64_t FloorNonNegative(float value, int64_t upper)
    {
        int64_t result = 0;
        while (result < upper && static_cast<float>(result + 1) <= value) {
            ++result;
        }
        return result;
    }

    __aicore__ inline float SourceCoord(int64_t outIndex, int64_t outSize, float scale)
    {
        if (alignCorners_) {
            if (outSize <= 1) {
                return 0.0f;
            }
            return static_cast<float>(outIndex) * scale;
        }
        float source = scale * (static_cast<float>(outIndex) + 0.5f) - 0.5f;
        return source < 0.0f ? 0.0f : source;
    }

    __aicore__ inline int64_t InputOffset(
        int64_t plane, int64_t d, int64_t h, int64_t w)
    {
        return plane * inputPlaneSize_ + (d * inputH_ + h) * inputW_ + w;
    }

    __aicore__ inline void ComputeOne(int64_t linear)
    {
        int64_t ow = linear - (linear / outputW_) * outputW_;
        int64_t tmp = linear / outputW_;
        int64_t oh = tmp - (tmp / outputH_) * outputH_;
        tmp = tmp / outputH_;
        int64_t od = tmp - (tmp / outputD_) * outputD_;
        int64_t plane = tmp / outputD_;

        float srcD = SourceCoord(od, outputD_, scaleD_);
        float srcH = SourceCoord(oh, outputH_, scaleH_);
        float srcW = SourceCoord(ow, outputW_, scaleW_);
        int64_t d0 = FloorNonNegative(srcD, inputD_ - 1);
        int64_t h0 = FloorNonNegative(srcH, inputH_ - 1);
        int64_t w0 = FloorNonNegative(srcW, inputW_ - 1);
        int64_t d1 = d0 + 1;
        int64_t h1 = h0 + 1;
        int64_t w1 = w0 + 1;
        if (d1 >= inputD_) {
            d1 = inputD_ - 1;
        }
        if (h1 >= inputH_) {
            h1 = inputH_ - 1;
        }
        if (w1 >= inputW_) {
            w1 = inputW_ - 1;
        }
        float lambdaD = srcD - static_cast<float>(d0);
        float lambdaH = srcH - static_cast<float>(h0);
        float lambdaW = srcW - static_cast<float>(w0);

        auto sampleLocal = tbufSamples_.template Get<T>();
        auto outputLocal = tbufOutput_.template Get<T>();
        LoadSample(sampleLocal, 0, InputOffset(plane, d0, h0, w0));
        LoadSample(sampleLocal, 1, InputOffset(plane, d0, h0, w1));
        LoadSample(sampleLocal, 2, InputOffset(plane, d0, h1, w0));
        LoadSample(sampleLocal, 3, InputOffset(plane, d0, h1, w1));
        LoadSample(sampleLocal, 4, InputOffset(plane, d1, h0, w0));
        LoadSample(sampleLocal, 5, InputOffset(plane, d1, h0, w1));
        LoadSample(sampleLocal, 6, InputOffset(plane, d1, h1, w0));
        LoadSample(sampleLocal, 7, InputOffset(plane, d1, h1, w1));
        AscendC::PipeBarrier<PIPE_ALL>();
        TrilinearInterpScalar<T>(outputLocal, sampleLocal, lambdaD, lambdaH, lambdaW);
        AscendC::PipeBarrier<PIPE_ALL>();
        StoreScalar(outputGm_, linear, outputLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSamples_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    int64_t totalOutputs_ = 0;
    int64_t blockLength_ = 0;
    int64_t inputD_ = 0;
    int64_t inputH_ = 0;
    int64_t inputW_ = 0;
    int64_t outputD_ = 0;
    int64_t outputH_ = 0;
    int64_t outputW_ = 0;
    int64_t inputPlaneSize_ = 0;
    int64_t outputPlaneSize_ = 0;
    bool alignCorners_ = false;
    float scaleD_ = 1.0f;
    float scaleH_ = 1.0f;
    float scaleW_ = 1.0f;
};

template <typename T>
__global__ __aicore__ __vector__ void upsample_trilinear3d_kernel(
    GM_ADDR input, GM_ADDR output,
    int64_t totalOutputs, int64_t blockLength,
    int64_t inputD, int64_t inputH, int64_t inputW,
    int64_t outputD, int64_t outputH, int64_t outputW,
    bool alignCorners, float scaleD, float scaleH, float scaleW)
{
    KernelUpsampleTrilinear3d<T> op;
    op.Init(input, output, totalOutputs, blockLength,
            inputD, inputH, inputW, outputD, outputH, outputW,
            alignCorners, scaleD, scaleH, scaleW);
    op.Process();
}

static float calc_source_scale(
    int64_t inputSize, int64_t outputSize, bool alignCorners, double scale)
{
    if (alignCorners) {
        return (outputSize > 1)
            ? static_cast<float>(inputSize - 1) / static_cast<float>(outputSize - 1)
            : 0.0f;
    }
    return (scale > 0.0)
        ? (1.0f / static_cast<float>(scale))
        : (static_cast<float>(inputSize) / static_cast<float>(outputSize));
}

torch::Tensor upsample_trilinear3d_npu(
    const torch::Tensor &input, at::IntArrayRef outputSize,
    bool alignCorners, double scalesD, double scalesH, double scalesW)
{
    check_common(input, outputSize, alignCorners, scalesD, scalesH, scalesW);
    const c10::OptionalDeviceGuard guard(input.device());

    auto out = parse_int3(outputSize, "output_size");
    int64_t outD = out[0];
    int64_t outH = out[1];
    int64_t outW = out[2];

    auto inputC = input.contiguous();
    auto output = torch::empty({inputC.size(0), inputC.size(1), outD, outH, outW},
                               inputC.options());

    int64_t totalOutputs = output.numel();
    int64_t numBlocks = calc_block_count(totalOutputs);
    int64_t blockLength = (totalOutputs + numBlocks - 1) / numBlocks;
    int64_t inputD = inputC.size(2);
    int64_t inputH = inputC.size(3);
    int64_t inputW = inputC.size(4);
    float scaleD = calc_source_scale(inputD, outD, alignCorners, scalesD);
    float scaleH = calc_source_scale(inputH, outH, alignCorners, scalesH);
    float scaleW = calc_source_scale(inputW, outW, alignCorners, scalesW);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            inputC.scalar_type(), "upsample_trilinear3d_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                upsample_trilinear3d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, outputPtr, totalOutputs, blockLength,
                    inputD, inputH, inputW, outD, outH, outW,
                    alignCorners, scaleD, scaleH, scaleW);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                upsample_trilinear3d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, outputPtr, totalOutputs, blockLength,
                    inputD, inputH, inputW, outD, outH, outW,
                    alignCorners, scaleD, scaleH, scaleW);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("UpsampleTrilinear3d", acl_call);

    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("upsample_trilinear3d", upsample_trilinear3d_npu);
}

} // namespace UpsampleTrilinear3d
} // namespace ops_multimodal_fusion
