/*!
 * \file c2_affine_channel.asc
 * \brief Caffe2 AffineChannel forward operator for Ascend NPU (dav-3510),
 *        RegBase implementation.
 *
 * Schema:  c2_affine_channel(Tensor X, Tensor scale, Tensor bias) -> Tensor
 *   X      N-D tensor (ndim >= 2), layout NCHW, channel dim = dim(1)
 *   scale  1-D (C,)
 *   bias   1-D (C,)
 *   returns Y of same shape and dtype as X
 *
 *   Y[n, c, *] = X[n, c, *] * scale[c] + bias[c]
 *
 * Scope (this version):
 *   - forward only (gradient op AffineChannelGradient deferred)
 *   - NCHW only (NHWC deferred; callers can permute upstream)
 *   - dtype scope: predictions / scale / bias = fp32 or fp16; bf16 and int
 *     types rejected at the host. dtype(X) == dtype(scale) == dtype(bias)
 *     is required.
 *
 * Reg shape - 3 layers:
 *   Layer 1 __simd_vf__  AffineChannelRowVf<T>     chunked LoadAlign + Muls +
 *                                                  Adds + StoreAlign across one
 *                                                  (n, c) pair's HxW elements
 *   Layer 2 __aicore__   AffineChannelRowCompute  LocalTensor -> __ubuf__ cast,
 *                                                  asc_vf_call
 *   Layer 3 kernel class KernelC2AffineChannel<T> scale / bias preload (whole
 *                                                  C vector once per core),
 *                                                  per (n, c) pair DMA in/out
 *                                                  + vf invocation.
 *
 * UB layout per core (fixed plus pipelined queues):
 *   tbufScale, tbufBias  : C * sizeof(T) each (channel vectors, preloaded once)
 *   inQueueX,  outQueueY : HxW * sizeof(T) * PIPELINE_DEPTH each
 * Host TORCH_CHECK rejects (n, c) configs that exceed UB; first version
 * requires the whole HxW row to fit in one tile.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace C2AffineChannel {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_affine_channel(Tensor X, Tensor scale, Tensor bias) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor c2_affine_channel_meta(
    const torch::Tensor &X,
    const torch::Tensor &scale,
    const torch::Tensor &bias)
{
    TORCH_CHECK(X.dim() >= 2,
                "c2_affine_channel: X must have at least 2 dims (got ndim=",
                X.dim(), ")");
    TORCH_CHECK(scale.dim() == 1,
                "c2_affine_channel: scale must be 1-D, got ndim=", scale.dim());
    TORCH_CHECK(bias.dim() == 1,
                "c2_affine_channel: bias must be 1-D, got ndim=", bias.dim());
    int64_t C = X.size(1);
    TORCH_CHECK(scale.size(0) == C,
                "c2_affine_channel: scale.size(0)=", scale.size(0),
                " must equal X.size(1)=", C);
    TORCH_CHECK(bias.size(0) == C,
                "c2_affine_channel: bias.size(0)=", bias.size(0),
                " must equal X.size(1)=", C);
    return torch::empty(X.sizes(), X.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_affine_channel", c2_affine_channel_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t>
calc_tiling_params(int64_t N, int64_t C, int64_t HxW, size_t bytesPerT)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t SAFETY_MARGIN = 1024;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_affine_channel: coreNum must be positive");

    int64_t totalPairs = N * C;
    int64_t numBlocks = std::min(coreNum, totalPairs);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t blockLength = (totalPairs + numBlocks - 1) / numBlocks;

    // Per-core UB inventory:
    //   tbufScale + tbufBias  : 2 * C * bytesPerT (preloaded channel vectors)
    //   inQueueX / outQueueY  : 2 * HxW * bytesPerT * PIPELINE_DEPTH
    int64_t fixedBytes = 2 * C * static_cast<int64_t>(bytesPerT);
    int64_t queueBytes = 2 * PIPELINE_DEPTH * HxW * static_cast<int64_t>(bytesPerT);
    TORCH_CHECK(fixedBytes + queueBytes + SAFETY_MARGIN <= static_cast<int64_t>(ubSize),
                "c2_affine_channel: C=", C, " HxW=", HxW,
                " too large for dav-3510 UB. fixedBytes=", fixedBytes,
                " queueBytes=", queueBytes, " ubSize=", ubSize,
                ". Whole HxW row and full channel vectors must fit (this first version constraint).");

    return std::make_tuple(numBlocks, blockLength);
}

// ===================== 4. Kernel - 3-layer Reg shape =====================

// Layer 1: __simd_vf__ chunked Muls + Adds.
//   Per chunk: LoadAlign(x) -> Muls(tmp, x, scaleScalar) -> Adds(y, tmp, biasScalar)
//              -> StoreAlign(y).
//   chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T) (fp32 64 / fp16 128).
template <typename T>
__simd_vf__ inline void AffineChannelRowVf(
    __ubuf__ T *xPtr, __ubuf__ T *yPtr,
    T scaleScalar, T biasScalar,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> xReg;
    AscendC::Reg::RegTensor<T> tmpReg;
    AscendC::Reg::RegTensor<T> yReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * chunkLanes;
        uint32_t remaining = (elementCount > offset) ? (elementCount - offset) : 0;
        if (remaining == 0) break;
        uint32_t lanesThisChunk = (remaining > chunkLanes) ? chunkLanes : remaining;
        AscendC::Reg::MaskReg laneMask = AscendC::Reg::UpdateMask<T>(lanesThisChunk);

        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xPtr + offset);
        AscendC::Reg::Muls(tmpReg, xReg,   scaleScalar, laneMask);
        AscendC::Reg::Adds(yReg,   tmpReg, biasScalar,  laneMask);
        if constexpr (sizeof(T) == 4) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                yPtr + offset, yReg, laneMask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
                yPtr + offset, yReg, laneMask);
        }
    }
}

// Layer 2: __aicore__ wrapper. LocalTensor -> __ubuf__ cast and asc_vf_call.
template <typename T>
__aicore__ inline void AffineChannelRowCompute(
    AscendC::LocalTensor<T> &xUbufLT,
    AscendC::LocalTensor<T> &yUbufLT,
    T scaleScalar, T biasScalar, int64_t HxW)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    __ubuf__ T *xPtr = (__ubuf__ T *)xUbufLT.GetPhyAddr();
    __ubuf__ T *yPtr = (__ubuf__ T *)yUbufLT.GetPhyAddr();
    uint32_t elementCount = static_cast<uint32_t>(HxW);
    uint32_t chunkCount   = (elementCount + chunkLanes - 1) / chunkLanes;
    asc_vf_call<AffineChannelRowVf<T>>(
        xPtr, yPtr, scaleScalar, biasScalar, elementCount, chunkCount);
}

// Layer 3: kernel class. scale/bias preload + per-pair DMA loop.
template <typename T>
class KernelC2AffineChannel {
public:
    __aicore__ inline KernelC2AffineChannel() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR scale, GM_ADDR bias, GM_ADDR y,
        int64_t N, int64_t C, int64_t HxW, int64_t blockLength)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        scaleGm_.SetGlobalBuffer((__gm__ T *)scale);
        biasGm_.SetGlobalBuffer((__gm__ T *)bias);
        yGm_.SetGlobalBuffer((__gm__ T *)y);

        N_ = N;
        C_ = C;
        HxW_ = HxW;

        int64_t totalPairs = N * C;
        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myBlockLength = totalPairs - blockStart;
        if (myBlockLength > blockLength) myBlockLength = blockLength;
        if (myBlockLength < 0) myBlockLength = 0;
        blockStart_ = blockStart;
        myBlockLength_ = myBlockLength;

        const uint32_t channelBytes = static_cast<uint32_t>(C * sizeof(T));
        const uint32_t rowBytes     = static_cast<uint32_t>(HxW * sizeof(T));
        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, rowBytes);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, rowBytes);
        pipe_.InitBuffer(tbufScale_, channelBytes);
        pipe_.InitBuffer(tbufBias_,  channelBytes);
    }

    __aicore__ inline void Process()
    {
        if (myBlockLength_ <= 0) return;

        // Preload whole-C scale + bias vectors (one DMA each per core).
        // scale[c] / bias[c] later read by scalar GetValue per (n, c) pair.
        AscendC::LocalTensor<T> scaleUbuf = tbufScale_.template Get<T>();
        AscendC::LocalTensor<T> biasUbuf  = tbufBias_.template Get<T>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(C_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(scaleUbuf, scaleGm_, params, padParams);
            AscendC::DataCopyPad(biasUbuf,  biasGm_,  params, padParams);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t p = 0; p < myBlockLength_; ++p) {
            int64_t globalPair = blockStart_ + p;
            int64_t n = globalPair / C_;
            int64_t c = globalPair - n * C_;
            ProcessPair(n, c, scaleUbuf, biasUbuf);
        }
    }

private:
    __aicore__ inline void ProcessPair(
        int64_t n, int64_t c,
        AscendC::LocalTensor<T> &scaleUbuf,
        AscendC::LocalTensor<T> &biasUbuf)
    {
        // Per-pair scalar broadcast values: scale[c] and bias[c].
        T scaleScalar = scaleUbuf.GetValue(static_cast<int32_t>(c));
        T biasScalar  = biasUbuf .GetValue(static_cast<int32_t>(c));

        // DMA in this (n, c) row.
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(HxW_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(xLocal, xGm_[(n * C_ + c) * HxW_], params, padParams);
        }
        inQueueX_.EnQue(xLocal);
        xLocal = inQueueX_.template DeQue<T>();

        // Compute Y = X * scaleScalar + biasScalar.
        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        AffineChannelRowCompute<T>(xLocal, yLocal, scaleScalar, biasScalar, HxW_);
        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.template DeQue<T>();

        // DMA out.
        {
            AscendC::DataCopyExtParams params;
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(HxW_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(yGm_[(n * C_ + c) * HxW_], yLocal, params);
        }
        inQueueX_.FreeTensor(xLocal);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> scaleGm_;
    AscendC::GlobalTensor<T> biasGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufScale_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufBias_;
    int64_t N_ = 0;
    int64_t C_ = 0;
    int64_t HxW_ = 0;
    int64_t blockStart_ = 0;
    int64_t myBlockLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_affine_channel_kernel(
    GM_ADDR x, GM_ADDR scale, GM_ADDR bias, GM_ADDR y,
    int64_t N, int64_t C, int64_t HxW, int64_t blockLength)
{
    KernelC2AffineChannel<T> op;
    op.Init(x, scale, bias, y, N, C, HxW, blockLength);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor c2_affine_channel_npu(
    const torch::Tensor &X,
    const torch::Tensor &scale,
    const torch::Tensor &bias)
{
    auto dtype = X.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 || dtype == torch::kFloat16,
                "c2_affine_channel: X dtype must be float32 or float16, got ",
                dtype, ". bf16 and int types are deferred on this platform.");
    TORCH_CHECK(scale.scalar_type() == dtype,
                "c2_affine_channel: scale dtype must match X, got scale=",
                scale.scalar_type(), " X=", dtype);
    TORCH_CHECK(bias.scalar_type() == dtype,
                "c2_affine_channel: bias dtype must match X, got bias=",
                bias.scalar_type(), " X=", dtype);

    TORCH_CHECK(X.dim() >= 2,
                "c2_affine_channel: X must have at least 2 dims (got ndim=",
                X.dim(), ")");
    TORCH_CHECK(scale.dim() == 1,
                "c2_affine_channel: scale must be 1-D, got ndim=", scale.dim());
    TORCH_CHECK(bias.dim() == 1,
                "c2_affine_channel: bias must be 1-D, got ndim=", bias.dim());

    const c10::OptionalDeviceGuard guard(X.device());
    auto X_contig = X.contiguous();
    auto scale_contig = scale.contiguous();
    auto bias_contig  = bias.contiguous();

    int64_t N = X_contig.size(0);
    int64_t C = X_contig.size(1);
    int64_t numel = X_contig.numel();
    int64_t NC = N * C;
    TORCH_CHECK(scale_contig.size(0) == C,
                "c2_affine_channel: scale.size(0)=", scale_contig.size(0),
                " must equal X.size(1)=", C);
    TORCH_CHECK(bias_contig.size(0) == C,
                "c2_affine_channel: bias.size(0)=", bias_contig.size(0),
                " must equal X.size(1)=", C);

    auto Y = torch::empty(X_contig.sizes(), X_contig.options());

    if (numel == 0) {
        return Y;
    }
    TORCH_CHECK(NC > 0,
                "c2_affine_channel: N * C must be > 0 when numel > 0");
    int64_t HxW = numel / NC;

    const size_t bytesPerT = (dtype == torch::kFloat16) ? 2u : 4u;
    int64_t numBlocks, blockLength;
    std::tie(numBlocks, blockLength) = calc_tiling_params(N, C, HxW, bytesPerT);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr     = (GM_ADDR)X_contig.data_ptr();
    auto scale_ptr = (GM_ADDR)scale_contig.data_ptr();
    auto bias_ptr  = (GM_ADDR)bias_contig.data_ptr();
    auto y_ptr     = (GM_ADDR)Y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            X_contig.scalar_type(), "c2_affine_channel_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_affine_channel_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, scale_ptr, bias_ptr, y_ptr,
                    N, C, HxW, blockLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_affine_channel_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, scale_ptr, bias_ptr, y_ptr,
                    N, C, HxW, blockLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2AffineChannel", acl_call);

    return Y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_affine_channel", c2_affine_channel_npu);
}

} // namespace C2AffineChannel
} // namespace ops_multimodal_fusion
