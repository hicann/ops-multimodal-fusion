/*!
 * \file cummax.asc
 * \brief Cummax scan operator for Ascend NPU (dav-3510), RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.cummax(x, dim) -> (values, indices)
 *   values[..., i, ...] = max(x[..., 0:i+1, ...])
 *   indices[..., i, ...] = latest index where that running max appears, matching torch.cummax.
 *
 * Scope: float16 and float32 values, int64 indices.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Cummax {

static constexpr int64_t kPipelineDepth = 2;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("cummax(Tensor x, int dim) -> (Tensor values, Tensor indices)");
}

static int64_t normalize_dim(int64_t dim, int64_t ndim)
{
    int64_t logicalRank = (ndim == 0) ? 1 : ndim;
    if (dim < 0) {
        dim += logicalRank;
    }
    TORCH_CHECK(dim >= 0 && dim < logicalRank,
                "cummax: dim ", dim, " out of range for tensor of ndim ", ndim);
    return dim;
}

std::tuple<torch::Tensor, torch::Tensor> cummax_meta(const torch::Tensor &x, int64_t dim)
{
    normalize_dim(dim, x.dim());
    TORCH_CHECK(x.scalar_type() == torch::kFloat16 ||
                x.scalar_type() == torch::kFloat32,
                "cummax: expected Half or Float inputs on dav-3510 Reg path, got ",
                x.scalar_type());
    auto values = torch::empty_like(x);
    auto indices = torch::empty(x.sizes(), x.options().dtype(torch::kInt64));
    return std::make_tuple(values, indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("cummax", cummax_meta);
}

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t outerSize, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "cummax: coreNum must be positive.");

    int64_t numBlocks = std::min(coreNum, outerSize);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t outerPerBlock = (outerSize + numBlocks - 1) / numBlocks;

    int64_t queueBytesPerElem = kPipelineDepth * (elemSize + elemSize + 2 * sizeof(int32_t));
    int64_t scratchBytesPerElem = elemSize + sizeof(int32_t);
    int64_t tileElems = static_cast<int64_t>(ubSize) /
        (queueBytesPerElem + scratchBytesPerElem);
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "cummax: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, outerPerBlock, tileElems);
}

template <typename T>
__simd_vf__ inline void CummaxInitVf(__ubuf__ T *outValAddr,
                                     __ubuf__ T *carryValAddr, __ubuf__ int32_t *carryIdxAddr,
                                     __ubuf__ T *xAddr, uint32_t count,
                                     uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> xReg;
    AscendC::Reg::RegTensor<int32_t> idxReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
                xReg, xAddr + offset);
        } else {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
                xReg, xAddr + offset);
        }
        AscendC::Reg::Duplicate<int32_t>(idxReg, 0, mask);
        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
                carryValAddr + offset, xReg, mask);
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
                outValAddr + offset, xReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                carryValAddr + offset, xReg, mask);
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                outValAddr + offset, xReg, mask);
        }
        AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            carryIdxAddr + offset, idxReg, mask);
    }
}

template <typename T>
__simd_vf__ inline void CummaxStepVf(__ubuf__ T *outValAddr,
                                     __ubuf__ T *carryValAddr, __ubuf__ int32_t *carryIdxAddr,
                                     __ubuf__ T *xAddr, int32_t dimIndex,
                                     uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> xReg;
    AscendC::Reg::RegTensor<T> carryReg;
    AscendC::Reg::RegTensor<int32_t> oldIdxReg;
    AscendC::Reg::RegTensor<int32_t> newIdxReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg updateMask;
        AscendC::Reg::MaskReg nanMask;

        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
                xReg, xAddr + offset);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
                carryReg, carryValAddr + offset);
        } else {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
                xReg, xAddr + offset);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
                carryReg, carryValAddr + offset);
        }
        AscendC::Reg::LoadAlign<int32_t, AscendC::Reg::LoadDist::DIST_NORM>(
            oldIdxReg, carryIdxAddr + offset);

        AscendC::Reg::Compare<T, AscendC::CMPMODE::GE>(
            updateMask, xReg, carryReg, mask);
        AscendC::Reg::Select<T>(carryReg, xReg, carryReg, updateMask);
        AscendC::Reg::Duplicate<int32_t>(newIdxReg, dimIndex, mask);
        AscendC::Reg::Select<int32_t>(oldIdxReg, newIdxReg, oldIdxReg, updateMask);

        AscendC::Reg::Compare<T, AscendC::CMPMODE::NE>(
            nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<T>(carryReg, xReg, carryReg, nanMask);
        AscendC::Reg::Select<int32_t>(oldIdxReg, newIdxReg, oldIdxReg, nanMask);

        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
                carryValAddr + offset, carryReg, mask);
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
                outValAddr + offset, carryReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                carryValAddr + offset, carryReg, mask);
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                outValAddr + offset, carryReg, mask);
        }
        AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            carryIdxAddr + offset, oldIdxReg, mask);
    }
}

template <typename T>
__aicore__ inline void CummaxInit(AscendC::LocalTensor<T> &outVal,
                                  AscendC::LocalTensor<T> &carryVal,
                                  AscendC::LocalTensor<int32_t> &carryIdx,
                                  AscendC::LocalTensor<T> &x,
                                  int64_t count)
{
    __ubuf__ T *outValAddr = (__ubuf__ T *)outVal.GetPhyAddr();
    __ubuf__ T *carryValAddr = (__ubuf__ T *)carryVal.GetPhyAddr();
    __ubuf__ int32_t *carryIdxAddr = (__ubuf__ int32_t *)carryIdx.GetPhyAddr();
    __ubuf__ T *xAddr = (__ubuf__ T *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CummaxInitVf<T>>(
        outValAddr, carryValAddr, carryIdxAddr, xAddr,
        elementCount, chunkCount);
}

template <typename T>
__aicore__ inline void CummaxStep(AscendC::LocalTensor<T> &outVal,
                                  AscendC::LocalTensor<T> &carryVal,
                                  AscendC::LocalTensor<int32_t> &carryIdx,
                                  AscendC::LocalTensor<T> &x,
                                  int32_t dimIndex, int64_t count)
{
    __ubuf__ T *outValAddr = (__ubuf__ T *)outVal.GetPhyAddr();
    __ubuf__ T *carryValAddr = (__ubuf__ T *)carryVal.GetPhyAddr();
    __ubuf__ int32_t *carryIdxAddr = (__ubuf__ int32_t *)carryIdx.GetPhyAddr();
    __ubuf__ T *xAddr = (__ubuf__ T *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CummaxStepVf<T>>(
        outValAddr, carryValAddr, carryIdxAddr, xAddr,
        dimIndex, elementCount, chunkCount);
}

template <typename T>
class KernelCummax {
public:
    __aicore__ inline KernelCummax() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR values, GM_ADDR indices,
        int64_t outerSize, int64_t dimSize, int64_t innerSize,
        int64_t outerPerBlock, uint32_t tileElems)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        valuesGm_.SetGlobalBuffer((__gm__ T *)values);
        indicesGm_.SetGlobalBuffer((__gm__ int32_t *)indices);
        outerSize_ = outerSize;
        dimSize_ = dimSize;
        innerSize_ = innerSize;
        outerStart_ = AscendC::GetBlockIdx() * outerPerBlock;
        outerCount_ = outerSize - outerStart_;
        if (outerCount_ > outerPerBlock) {
            outerCount_ = outerPerBlock;
        }
        if (outerCount_ < 0) {
            outerCount_ = 0;
        }
        tileElems_ = tileElems;
        pipe_.InitBuffer(inQueue_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outValQueue_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outIdxQueue_, kPipelineDepth, tileElems * sizeof(int64_t));
        pipe_.InitBuffer(tbufValueCarry_, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufIndexCarry_, tileElems * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (int64_t o = 0; o < outerCount_; ++o) {
            int64_t outer = outerStart_ + o;
            for (int64_t inner = 0; inner < innerSize_; inner += tileElems_) {
                int64_t count = innerSize_ - inner;
                if (count > tileElems_) {
                    count = tileElems_;
                }
                ProcessTile(outer, inner, count);
            }
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t outer, int64_t innerStart, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        AscendC::DataCopyExtParams inParams;
        inParams.blockCount = 1;
        inParams.blockLen = static_cast<uint32_t>(count * sizeof(T));
        inParams.srcStride = 0;
        inParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};

        for (int64_t d = 0; d < dimSize_; ++d) {
            int64_t offset = (outer * dimSize_ + d) * innerSize_ + innerStart;
            AscendC::LocalTensor<T> xLocal = inQueue_.template AllocTensor<T>();
            AscendC::DataCopyPad(xLocal, xGm_[offset], inParams, padParams);
            inQueue_.EnQue(xLocal);
            xLocal = inQueue_.template DeQue<T>();

            AscendC::LocalTensor<T> outVal = outValQueue_.template AllocTensor<T>();
            AscendC::LocalTensor<int32_t> outIdx =
                outIdxQueue_.template AllocTensor<int32_t>();
            auto valueCarry = tbufValueCarry_.template Get<T>();
            auto indexCarry = tbufIndexCarry_.template Get<int32_t>();

            if (d == 0) {
                CummaxInit<T>(outVal, valueCarry, indexCarry, xLocal, alignedCount);
            } else {
                CummaxStep<T>(outVal, valueCarry, indexCarry, xLocal,
                              static_cast<int32_t>(d), alignedCount);
            }
            AscendC::PipeBarrier<PIPE_V>();

            for (int64_t i = 0; i < count; ++i) {
                outIdx.SetValue(static_cast<int32_t>(2 * i),
                                indexCarry.GetValue(static_cast<int32_t>(i)));
                outIdx.SetValue(static_cast<int32_t>(2 * i + 1), 0);
            }
            AscendC::PipeBarrier<PIPE_ALL>();

            outValQueue_.EnQue(outVal);
            outIdxQueue_.EnQue(outIdx);
            inQueue_.FreeTensor(xLocal);
            outVal = outValQueue_.template DeQue<T>();
            outIdx = outIdxQueue_.template DeQue<int32_t>();

            AscendC::DataCopyExtParams valParams;
            valParams.blockCount = 1;
            valParams.blockLen = static_cast<uint32_t>(count * sizeof(T));
            valParams.srcStride = 0;
            valParams.dstStride = 0;
            AscendC::DataCopyPad(valuesGm_[offset], outVal, valParams);

            AscendC::DataCopyExtParams idxParams;
            idxParams.blockCount = 1;
            idxParams.blockLen = static_cast<uint32_t>(count * sizeof(int64_t));
            idxParams.srcStride = 0;
            idxParams.dstStride = 0;
            AscendC::DataCopyPad(indicesGm_[offset * 2], outIdx, idxParams);

            outValQueue_.FreeTensor(outVal);
            outIdxQueue_.FreeTensor(outIdx);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, valuesGm_;
    AscendC::GlobalTensor<int32_t> indicesGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outValQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outIdxQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufValueCarry_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIndexCarry_;
    int64_t outerSize_ = 0;
    int64_t dimSize_ = 0;
    int64_t innerSize_ = 0;
    int64_t outerStart_ = 0;
    int64_t outerCount_ = 0;
    uint32_t tileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void cummax_kernel(
    GM_ADDR x, GM_ADDR values, GM_ADDR indices,
    int64_t outerSize, int64_t dimSize, int64_t innerSize,
    int64_t outerPerBlock, uint32_t tileElems)
{
    KernelCummax<T> op;
    op.Init(x, values, indices, outerSize, dimSize, innerSize, outerPerBlock, tileElems);
    op.Process();
}

std::tuple<torch::Tensor, torch::Tensor> cummax_npu(const torch::Tensor &x_in, int64_t dim)
{
    TORCH_CHECK(x_in.scalar_type() == torch::kFloat16 ||
                x_in.scalar_type() == torch::kFloat32,
                "cummax: expected Half or Float inputs on dav-3510 Reg path, got ",
                x_in.scalar_type());
    const c10::OptionalDeviceGuard guard(x_in.device());
    auto x = x_in.contiguous();
    int64_t ndim = x.dim();
    int64_t dimNorm = normalize_dim(dim, ndim);
    auto values = torch::empty_like(x);
    auto indices = torch::empty(x.sizes(), x.options().dtype(torch::kInt64));
    if (x.numel() == 0) {
        return std::make_tuple(values, indices);
    }

    int64_t outerSize = 1;
    int64_t dimSize = 1;
    int64_t innerSize = 1;
    if (ndim == 0) {
        dimSize = 1;
    } else {
        dimSize = x.size(dimNorm);
        for (int64_t i = 0; i < dimNorm; ++i) {
            outerSize *= x.size(i);
        }
        for (int64_t i = dimNorm + 1; i < ndim; ++i) {
            innerSize *= x.size(i);
        }
    }
    if (dimSize == 0) {
        return std::make_tuple(values, indices);
    }
    TORCH_CHECK(dimSize <= static_cast<int64_t>(0x7fffffff),
                "cummax: dimSize exceeds INT32_MAX");

    int64_t numBlocks, outerPerBlock, tileElems;
    std::tie(numBlocks, outerPerBlock, tileElems) =
        calc_tiling_params(outerSize, x.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto values_ptr = (GM_ADDR)values.data_ptr();
    auto indices_ptr = (GM_ADDR)indices.data_ptr();
    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "cummax_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                cummax_kernel<half><<<numBlocks, nullptr, stream>>>(
                    x_ptr, values_ptr, indices_ptr, outerSize, dimSize, innerSize,
                    outerPerBlock, static_cast<uint32_t>(tileElems));
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                cummax_kernel<float><<<numBlocks, nullptr, stream>>>(
                    x_ptr, values_ptr, indices_ptr, outerSize, dimSize, innerSize,
                    outerPerBlock, static_cast<uint32_t>(tileElems));
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Cummax", acl_call);
    return std::make_tuple(values, indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("cummax", cummax_npu);
}

} // namespace Cummax
} // namespace ops_multimodal_fusion
