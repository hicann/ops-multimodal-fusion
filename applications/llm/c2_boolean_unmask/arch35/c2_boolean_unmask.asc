/*!
 * \file c2_boolean_unmask.asc
 * \brief Caffe2 BooleanUnmask operator for Ascend NPU (dav-3510), RegBase
 *        Reg::Gather implementation.
 *
 * Schema:  c2_boolean_unmask(Tensor[] inputs) -> Tensor
 *   inputs   flat alternating list [mask_0, values_0, mask_1, values_1, ...],
 *            even length >= 2; numMasks = inputs.size()/2;
 *            mask_j   = inputs[2j]   : 1-D bool / uint8, all of size maskSize
 *            values_j = inputs[2j+1] : 1-D, common dtype
 *   returns  y : 1-D tensor of length maskSize, dtype == values dtype, with
 *                y[i] = values_{j(i)}[r], where j(i) is the first mask true at
 *                position i (first-true-wins) and r is the per-mask prefix
 *                count of positions assigned to mask j(i). Inverse of
 *                c2_boolean_mask. The flat alternating input layout matches
 *                Caffe2 BooleanUnmask(mask0, values0, ...) 1:1.
 *
 * Scope (this version):
 *   - forward only
 *   - values dtype scope: {fp32, fp16, int32}; bf16 / int64 / fp64 / complex
 *     rejected on this platform
 *   - mask dtype scope: {bool, uint8}; host casts uint8 to bool
 *   - every output position must be covered by at least one mask; the count of
 *     positions assigned to mask j must equal values_j.numel() (mirrors the two
 *     CUDA_KERNEL_ASSERTs); violations are host TORCH_CHECK rejects
 *   - output length maskSize is NOT data-dependent (= mask_0 length), so Meta
 *     is exact
 *   - whole gather pool (concat_values, maskSize elems) must fit in UB
 *     (single-AIV first version; chunked pool deferred). For float16 the
 *     Reg::Gather index is uint16, so maskSize <= 65535 (b16 hardware cap);
 *     fp32 / int32 use a uint32 index.
 *
 * Algorithm:
 *   The net effect of the CUDA reference (ComputeIndicesKernel picks the first
 *   true mask per position; FillValuesKernel copies values[j][rank] -> dest[i])
 *   is exactly an indexed copy y[i] = concat_values[src_idx[i]]. The host
 *   pre-scans the masks on CPU to produce src_idx (the gather index into the
 *   concatenation of all values_j) and concatenates the values; the device then
 *   runs a single vectorized Reg::Gather (vgather2) -- structurally identical to
 *   the in-tree `take` operator (self=concat_values, index=src_idx). Choosing a
 *   device gather primitive (vs the CUDA kernels' raw indexed byte copies) is an
 *   NPU implementation detail; the schema and semantics are unchanged.
 *
 *   src_idx is in [0, maskSize); the host narrows it to the unsigned width
 *   Reg::Gather requires (uint16 for b16 values, int32 bits == uint32 for b32).
 *   All values are in range, so every conversion is lossless.
 *
 * 3-layer Reg shape:
 *   Layer 1 vf (UnmaskGatherVf): per chunk -- LoadAlign unsigned idx chunk ->
 *     Reg::Gather(dst, concatBaseAddr, idx, mask) -> StoreAlign result chunk
 *   Layer 2 __aicore__ wrapper:  GetPhyAddr cast + asc_vf_call
 *   Layer 3 kernel class:        DMA in concat_values(maskSize)/src_idx(maskSize)
 *     -> vf gather -> DMA out y(maskSize). Single AIV (AIV 0 only).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <cstdint>
#include <vector>

namespace ops_multimodal_fusion {
namespace C2BooleanUnmask {

// Index reg width required by dav-3510 Reg::Gather: b16 src -> uint16 index,
// b32 src -> uint32 index.
template <typename T>
using IdxU = std::conditional_t<sizeof(T) == 2, uint16_t, uint32_t>;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_boolean_unmask(Tensor[] inputs) -> Tensor");
}

// ===================== 2. Meta =====================
//
// Output length maskSize = mask_0 length is static (not data-dependent on mask
// contents), so Meta is exact. It validates structure / dtypes but cannot read
// mask values (that happens in the eager PrivateUse1 path).

static void validate_inputs(const at::TensorList &inputs)
{
    TORCH_CHECK(inputs.size() >= 2 && (inputs.size() % 2 == 0),
                "c2_boolean_unmask: inputs must be a non-empty even-length list "
                "[mask_0, values_0, ...], got size ", inputs.size());
    const int64_t numMasks = static_cast<int64_t>(inputs.size()) / 2;
    const int64_t maskSize = inputs[0].numel();
    const auto valuesDtype = inputs[1].scalar_type();
    TORCH_CHECK(valuesDtype == torch::kFloat32 ||
                valuesDtype == torch::kFloat16 ||
                valuesDtype == torch::kInt32,
                "c2_boolean_unmask: values dtype must be float32 / float16 / "
                "int32, got ", valuesDtype,
                ". bf16 / int64 / fp64 / complex are deferred on this platform.");
    for (int64_t j = 0; j < numMasks; ++j) {
        const auto &mask = inputs[2 * j];
        const auto &values = inputs[2 * j + 1];
        TORCH_CHECK(mask.dim() == 1,
                    "c2_boolean_unmask: mask ", j, " must be 1-D, got ndim=",
                    mask.dim());
        TORCH_CHECK(mask.numel() == maskSize,
                    "c2_boolean_unmask: mask ", j, " size=", mask.numel(),
                    " must equal mask 0 size=", maskSize);
        TORCH_CHECK(mask.scalar_type() == torch::kBool ||
                    mask.scalar_type() == torch::kUInt8,
                    "c2_boolean_unmask: mask ", j,
                    " dtype must be bool or uint8, got ", mask.scalar_type());
        TORCH_CHECK(values.dim() == 1,
                    "c2_boolean_unmask: values ", j, " must be 1-D, got ndim=",
                    values.dim());
        TORCH_CHECK(values.scalar_type() == valuesDtype,
                    "c2_boolean_unmask: values ", j, " dtype=",
                    values.scalar_type(), " must match values 0 dtype=",
                    valuesDtype);
    }
}

torch::Tensor c2_boolean_unmask_meta(at::TensorList inputs)
{
    validate_inputs(inputs);
    const int64_t maskSize = inputs[0].numel();
    return torch::empty({maskSize}, inputs[1].options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_boolean_unmask", c2_boolean_unmask_meta);
}

// ===================== 3. Kernel -- 3-layer Reg shape =====================

// Layer 1: chunked vectorized gather  result[i] = concatBaseAddr[ index[i] ].
// index is already in the unsigned width Reg::Gather requires for T
// (uint16 for b16 src, uint32 for b32 src) and lies in [0, maskSize).
template <typename T>
__simd_vf__ inline void UnmaskGatherVf(
    __ubuf__ T *concatBaseAddr, __ubuf__ IdxU<T> *indexAddr,
    __ubuf__ T *resultAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<IdxU<T>> idxReg;
    AscendC::Reg::RegTensor<T>       dstReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);

        AscendC::Reg::LoadAlign<IdxU<T>, AscendC::Reg::LoadDist::DIST_NORM>(
            idxReg, indexAddr + offset);

        AscendC::Reg::Gather(dstReg, concatBaseAddr, idxReg, mask);

        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            resultAddr + offset, dstReg, mask);
    }
}

// Layer 2: __aicore__ wrapper. LocalTensor -> __ubuf__ cast and asc_vf_call.
template <typename T>
__aicore__ inline void UnmaskGather(
    AscendC::LocalTensor<T> &concatPool, AscendC::LocalTensor<IdxU<T>> &index,
    AscendC::LocalTensor<T> &result, uint32_t maskSize)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t chunkCount = (maskSize + vectorLength - 1) / vectorLength;
    __ubuf__ T        *concatPtr = (__ubuf__ T *)concatPool.GetPhyAddr();
    __ubuf__ IdxU<T>  *indexPtr  = (__ubuf__ IdxU<T> *)index.GetPhyAddr();
    __ubuf__ T        *resultPtr = (__ubuf__ T *)result.GetPhyAddr();
    asc_vf_call<UnmaskGatherVf<T>>(concatPtr, indexPtr, resultPtr, maskSize, chunkCount);
}

// Layer 3: kernel class. Whole pool + index resident in UB; single AIV.
template <typename T>
class KernelC2BooleanUnmask {
public:
    __aicore__ inline KernelC2BooleanUnmask() {}

    __aicore__ inline void Init(
        GM_ADDR concat_values, GM_ADDR src_idx, GM_ADDR y, int64_t maskSize)
    {
        concatGm_.SetGlobalBuffer((__gm__ T *)concat_values);
        indexGm_.SetGlobalBuffer((__gm__ IdxU<T> *)src_idx);
        yGm_.SetGlobalBuffer((__gm__ T *)y);
        maskSize_ = maskSize;

        const uint32_t poolBytes   = static_cast<uint32_t>(maskSize * sizeof(T));
        const uint32_t indexBytes  = static_cast<uint32_t>(maskSize * sizeof(IdxU<T>));
        const uint32_t resultBytes = static_cast<uint32_t>(maskSize * sizeof(T));
        pipe_.InitBuffer(tbufConcat_, poolBytes);
        pipe_.InitBuffer(tbufIndex_,  indexBytes);
        pipe_.InitBuffer(tbufResult_, resultBytes);
    }

    __aicore__ inline void Process()
    {
        if (maskSize_ <= 0) return;
        // Single-AIV serial: only AIV 0 executes.
        if (AscendC::GetBlockIdx() != 0) return;

        AscendC::LocalTensor<T>        concatLocal = tbufConcat_.template Get<T>();
        AscendC::LocalTensor<IdxU<T>>  indexLocal  = tbufIndex_.template Get<IdxU<T>>();
        AscendC::LocalTensor<T>        resultLocal = tbufResult_.template Get<T>();

        AscendC::DataCopyExtParams cpPool;
        cpPool.blockCount = 1;
        cpPool.blockLen   = static_cast<uint32_t>(maskSize_ * sizeof(T));
        cpPool.srcStride  = 0;
        cpPool.dstStride  = 0;
        AscendC::DataCopyExtParams cpIndex;
        cpIndex.blockCount = 1;
        cpIndex.blockLen   = static_cast<uint32_t>(maskSize_ * sizeof(IdxU<T>));
        cpIndex.srcStride  = 0;
        cpIndex.dstStride  = 0;
        AscendC::DataCopyExtParams cpResult;
        cpResult.blockCount = 1;
        cpResult.blockLen   = static_cast<uint32_t>(maskSize_ * sizeof(T));
        cpResult.srcStride  = 0;
        cpResult.dstStride  = 0;

        AscendC::DataCopyPadExtParams<T>        padT{false, 0, 0, T{}};
        AscendC::DataCopyPadExtParams<IdxU<T>>  padI{false, 0, 0, static_cast<IdxU<T>>(0)};

        AscendC::DataCopyPad(concatLocal, concatGm_, cpPool,  padT);
        AscendC::DataCopyPad(indexLocal,  indexGm_,  cpIndex, padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        UnmaskGather<T>(concatLocal, indexLocal, resultLocal,
                        static_cast<uint32_t>(maskSize_));
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyPad(yGm_, resultLocal, cpResult);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>        concatGm_;
    AscendC::GlobalTensor<IdxU<T>>  indexGm_;
    AscendC::GlobalTensor<T>        yGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufConcat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIndex_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufResult_;
    int64_t maskSize_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_boolean_unmask_kernel(
    GM_ADDR concat_values, GM_ADDR src_idx, GM_ADDR y, int64_t maskSize)
{
    KernelC2BooleanUnmask<T> op;
    op.Init(concat_values, src_idx, y, maskSize);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

torch::Tensor c2_boolean_unmask_npu(at::TensorList inputs)
{
    validate_inputs(inputs);

    const int64_t numMasks = static_cast<int64_t>(inputs.size()) / 2;
    const int64_t maskSize = inputs[0].numel();
    const auto valuesDtype = inputs[1].scalar_type();
    const auto valuesOptions = inputs[1].options();

    const c10::OptionalDeviceGuard guard(inputs[1].device());
    auto y = torch::empty({maskSize}, valuesOptions);

    if (maskSize == 0) {
        return y;
    }

    TORCH_CHECK(maskSize <= static_cast<int64_t>(0x7fffffff),
                "c2_boolean_unmask: maskSize=", maskSize, " exceeds INT32_MAX");
    // float16 (b16) Reg::Gather uses a uint16 index reg -> pool capped at 65535.
    TORCH_CHECK(valuesDtype != torch::kFloat16 || maskSize <= 65535,
                "c2_boolean_unmask: float16 maskSize=", maskSize,
                " exceeds 65535 (dav-3510 b16 gather uses a uint16 index); "
                "use float32/int32 for larger sizes");
    // Whole gather pool + index + result must fit UB (single-AIV first version).
    {
        auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
        uint64_t ubSize;
        ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
        const int64_t bytesPerT  = (valuesDtype == torch::kFloat16) ? 2 : 4;
        const int64_t bytesPerIdx = (valuesDtype == torch::kFloat16) ? 2 : 4;
        const int64_t need = maskSize * (2 * bytesPerT + bytesPerIdx) + 1024;
        TORCH_CHECK(need <= static_cast<int64_t>(ubSize),
                    "c2_boolean_unmask: maskSize=", maskSize,
                    " too large for dav-3510 UB (need ", need, " bytes, have ",
                    ubSize, "); chunked-pool tiling is deferred.");
    }

    // Host pre-scan: bring each mask to CPU as bool, compute the per-position
    // gather index into the concatenation of all values_j (mirrors the CUDA
    // reference treating masks as control data).
    std::vector<at::Tensor> masks_cpu(numMasks);
    std::vector<const bool *> maskPtr(numMasks);
    std::vector<at::Tensor> values_vec(numMasks);
    std::vector<int64_t> offset(numMasks, 0);
    std::vector<int64_t> count(numMasks, 0);
    int64_t totalValues = 0;
    for (int64_t j = 0; j < numMasks; ++j) {
        masks_cpu[j] = inputs[2 * j].to(at::kCPU).to(torch::kBool).contiguous();
        maskPtr[j] = masks_cpu[j].data_ptr<bool>();
        values_vec[j] = inputs[2 * j + 1];
        offset[j] = totalValues;
        totalValues += values_vec[j].numel();
    }
    TORCH_CHECK(totalValues == maskSize,
                "c2_boolean_unmask: total values count=", totalValues,
                " must equal maskSize=", maskSize);

    auto src_idx_cpu = torch::empty({maskSize}, torch::kInt64);
    auto *srcIdxPtr = src_idx_cpu.data_ptr<int64_t>();
    for (int64_t i = 0; i < maskSize; ++i) {
        int64_t win = -1;
        for (int64_t j = 0; j < numMasks; ++j) {
            if (maskPtr[j][i]) { win = j; break; }
        }
        TORCH_CHECK(win >= 0,
                    "c2_boolean_unmask: output position ", i,
                    " is not covered by any mask");
        srcIdxPtr[i] = offset[win] + count[win];
        ++count[win];
    }
    for (int64_t j = 0; j < numMasks; ++j) {
        TORCH_CHECK(count[j] == values_vec[j].numel(),
                    "c2_boolean_unmask: mask ", j, " is assigned ", count[j],
                    " positions but values ", j, " has ",
                    values_vec[j].numel(), " elements");
    }

    auto concat_values = torch::cat(values_vec).contiguous();

    // Narrow src_idx (in [0, maskSize)) to the unsigned width Reg::Gather needs:
    // uint16 for fp16 (maskSize <= 65535), int32 bits == uint32 for fp32/int32.
    torch::Tensor src_idx_dev;
    if (valuesDtype == torch::kFloat16) {
        src_idx_dev = src_idx_cpu.to(torch::kUInt16).to(inputs[1].device());
    } else {
        src_idx_dev = src_idx_cpu.to(torch::kInt32).to(inputs[1].device());
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto concat_ptr  = (GM_ADDR)concat_values.data_ptr();
    auto src_idx_ptr = (GM_ADDR)src_idx_dev.data_ptr();
    auto y_ptr       = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            valuesDtype, "c2_boolean_unmask_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_boolean_unmask_kernel<scalar_t><<<1, nullptr, stream>>>(
                    concat_ptr, src_idx_ptr, y_ptr, maskSize);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_boolean_unmask_kernel<scalar_t><<<1, nullptr, stream>>>(
                    concat_ptr, src_idx_ptr, y_ptr, maskSize);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                c2_boolean_unmask_kernel<scalar_t><<<1, nullptr, stream>>>(
                    concat_ptr, src_idx_ptr, y_ptr, maskSize);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2BooleanUnmask", acl_call);

    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_boolean_unmask", c2_boolean_unmask_npu);
}

} // namespace C2BooleanUnmask
} // namespace ops_multimodal_fusion
