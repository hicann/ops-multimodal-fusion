/*!
 * \file multilabel_margin_loss.asc
 * \brief MultiLabelMarginLoss forward operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.multilabel_margin_loss(input, target, reduction=1) -> output
 *   input:  [C] or [N, C], fp16/fp32
 *   target: same shape, int64, valid labels first and padded by -1
 *   reduction: 0 none, 1 mean, 2 sum
 *
 * The kernel uses a correctness-first single-AIV schedule. Target parsing and
 * per-sample accumulation are scalar control, while each positive label's
 * margin/relu/reduce over the C classes is implemented as a Reg VF.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace MultiLabelMarginLoss {

static constexpr int64_t kReductionNone = 0;
static constexpr int64_t kReductionMean = 1;
static constexpr int64_t kReductionSum = 2;
static constexpr int64_t kScalarSlotBytes = 32;
static constexpr int64_t kFloatScalarSlotLanes = kScalarSlotBytes / static_cast<int64_t>(sizeof(float));
static constexpr int64_t kDav3510VectorRegBytes = 256;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("multilabel_margin_loss(Tensor input, Tensor target, int reduction=1) -> Tensor");
}

static void check_common(
    const torch::Tensor &input, const torch::Tensor &target, int64_t reduction)
{
    TORCH_CHECK(input.dim() == 1 || input.dim() == 2,
                "multilabel_margin_loss: expected 1-D or 2-D input, got ",
                input.dim(), "-D");
    TORCH_CHECK(target.sizes() == input.sizes(),
                "multilabel_margin_loss: target shape must match input shape");
    TORCH_CHECK(target.scalar_type() == torch::kInt64,
                "multilabel_margin_loss: target must have dtype int64");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "multilabel_margin_loss: expected Half or Float input on dav-3510 Reg path, got ",
                input.scalar_type());
    TORCH_CHECK(reduction == kReductionNone ||
                reduction == kReductionMean ||
                reduction == kReductionSum,
                "multilabel_margin_loss: reduction must be 0 (none), 1 (mean), or 2 (sum), got ",
                reduction);
    TORCH_CHECK(input.size(input.dim() - 1) > 0,
                "multilabel_margin_loss: class dimension C must be greater than 0");
}

torch::Tensor multilabel_margin_loss_meta(
    const torch::Tensor &input, const torch::Tensor &target, int64_t reduction)
{
    check_common(input, target, reduction);
    if (input.dim() == 2 && reduction == kReductionNone) {
        return torch::empty({input.size(0)}, input.options());
    }
    return torch::empty({}, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("multilabel_margin_loss", multilabel_margin_loss_meta);
}

static std::tuple<int64_t, int64_t, int64_t, int64_t>
calc_tiling_params(int64_t classCount, size_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);

    constexpr int64_t floatAlignElems = kFloatScalarSlotLanes;
    int64_t elemAlign = 32 / static_cast<int64_t>(elemSize);
    int64_t int64Align = 32 / static_cast<int64_t>(sizeof(int64_t));
    int64_t alignedInput = ((classCount + elemAlign - 1) / elemAlign) * elemAlign;
    int64_t alignedTarget = ((classCount + int64Align - 1) / int64Align) * int64Align;
    int64_t alignedFloat = ((classCount + floatAlignElems - 1) / floatAlignElems) * floatAlignElems;
    int64_t vectorLength = kDav3510VectorRegBytes / static_cast<int64_t>(sizeof(float));
    int64_t chunkCount = (classCount + vectorLength - 1) / vectorLength;

    int64_t bytes =
        alignedInput * static_cast<int64_t>(elemSize) +
        alignedTarget * static_cast<int64_t>(sizeof(int64_t)) +
        alignedFloat * static_cast<int64_t>(sizeof(float)) +
        chunkCount * kScalarSlotBytes +
        kScalarSlotBytes +
        1024;
    TORCH_CHECK(bytes <= static_cast<int64_t>(ubSize),
                "multilabel_margin_loss: class dimension C=", classCount,
                " exceeds dav-3510 UB capacity for this Reg implementation");
    return std::make_tuple(alignedInput, alignedTarget, alignedFloat, chunkCount);
}

__simd_vf__ inline void MultiLabelMarginLossFloatVf(
    __ubuf__ float *xAddr, __ubuf__ float *isTargetAddr, __ubuf__ float *sumAddr,
    float positiveValue, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> isTargetReg;
    AscendC::Reg::RegTensor<float> notTargetReg;
    AscendC::Reg::RegTensor<float> marginReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::MaskReg reluMask;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            isTargetReg, isTargetAddr + offset);

        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            notTargetReg, 1.0f, mask);
        AscendC::Reg::Sub(notTargetReg, notTargetReg, isTargetReg, mask);
        AscendC::Reg::Adds(marginReg, xReg, 1.0f - positiveValue, mask);
        AscendC::Reg::Mul(marginReg, marginReg, notTargetReg, mask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(
            reluMask, marginReg, zeroReg, mask);
        AscendC::Reg::Select<float>(marginReg, marginReg, zeroReg, reluMask);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumReg, marginReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + chunk * kFloatScalarSlotLanes, sumReg, scalarMask);
    }
}

__simd_vf__ inline void MultiLabelMarginLossHalfVf(
    __ubuf__ half *xAddr, __ubuf__ float *isTargetAddr, __ubuf__ float *sumAddr,
    float positiveValue, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};

    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> isTargetReg;
    AscendC::Reg::RegTensor<float> notTargetReg;
    AscendC::Reg::RegTensor<float> marginReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::MaskReg reluMask;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);

        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, xHalfReg, mask);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            isTargetReg, isTargetAddr + offset);

        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            notTargetReg, 1.0f, mask);
        AscendC::Reg::Sub(notTargetReg, notTargetReg, isTargetReg, mask);
        AscendC::Reg::Adds(marginReg, xReg, 1.0f - positiveValue, mask);
        AscendC::Reg::Mul(marginReg, marginReg, notTargetReg, mask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(
            reluMask, marginReg, zeroReg, mask);
        AscendC::Reg::Select<float>(marginReg, marginReg, zeroReg, reluMask);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumReg, marginReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + chunk * kFloatScalarSlotLanes, sumReg, scalarMask);
    }
}

__aicore__ inline void MultiLabelMarginLossFloat(
    AscendC::LocalTensor<float> xLocal, AscendC::LocalTensor<float> isTargetLocal,
    AscendC::LocalTensor<float> sumLocal, float positiveValue,
    uint32_t count, uint32_t chunkCount)
{
    asc_vf_call<MultiLabelMarginLossFloatVf>(
        (__ubuf__ float *)xLocal.GetPhyAddr(),
        (__ubuf__ float *)isTargetLocal.GetPhyAddr(),
        (__ubuf__ float *)sumLocal.GetPhyAddr(),
        positiveValue, count, chunkCount);
}

__aicore__ inline void MultiLabelMarginLossHalf(
    AscendC::LocalTensor<half> xLocal, AscendC::LocalTensor<float> isTargetLocal,
    AscendC::LocalTensor<float> sumLocal, float positiveValue,
    uint32_t count, uint32_t chunkCount)
{
    asc_vf_call<MultiLabelMarginLossHalfVf>(
        (__ubuf__ half *)xLocal.GetPhyAddr(),
        (__ubuf__ float *)isTargetLocal.GetPhyAddr(),
        (__ubuf__ float *)sumLocal.GetPhyAddr(),
        positiveValue, count, chunkCount);
}

template <typename T>
class KernelMultiLabelMarginLoss {
public:
    __aicore__ inline KernelMultiLabelMarginLoss() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR target, GM_ADDR output, int64_t sampleCount,
        int64_t classCount, int64_t reduction, int64_t inputStride0,
        int64_t inputStride1, int64_t targetStride0, int64_t targetStride1,
        int64_t inputAligned, int64_t targetAligned, int64_t floatAligned,
        int64_t chunkCount)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        targetGm_.SetGlobalBuffer((__gm__ int64_t *)target);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        sampleCount_ = sampleCount;
        classCount_ = classCount;
        reduction_ = reduction;
        inputStride0_ = inputStride0;
        inputStride1_ = inputStride1;
        targetStride0_ = targetStride0;
        targetStride1_ = targetStride1;
        inputAligned_ = inputAligned;
        targetAligned_ = targetAligned;
        floatAligned_ = floatAligned;
        chunkCount_ = chunkCount;

        pipe_.InitBuffer(tbufInput_, inputAligned * sizeof(T));
        pipe_.InitBuffer(tbufTarget_, targetAligned * sizeof(int64_t));
        pipe_.InitBuffer(tbufIsTarget_, floatAligned * sizeof(float));
        pipe_.InitBuffer(tbufSum_, chunkCount * kScalarSlotBytes);
        pipe_.InitBuffer(tbufOut_, kScalarSlotBytes);
    }

    __aicore__ inline void Process()
    {
        if (AscendC::GetBlockIdx() != 0) {
            return;
        }
        float reduced = 0.0f;
        for (int64_t n = 0; n < sampleCount_; ++n) {
            float sampleLoss = ProcessSample(n);
            if (reduction_ == kReductionNone) {
                StoreOutput(n, sampleLoss);
            } else {
                reduced += sampleLoss;
            }
        }
        if (reduction_ == kReductionMean) {
            reduced = (sampleCount_ > 0) ? (reduced / static_cast<float>(sampleCount_)) : 0.0f;
            StoreOutput(0, reduced);
        } else if (reduction_ == kReductionSum) {
            StoreOutput(0, reduced);
        }
    }

private:
    __aicore__ inline float ProcessSample(int64_t sample)
    {
        AscendC::LocalTensor<T> inputLocal = tbufInput_.template Get<T>();
        AscendC::LocalTensor<int64_t> targetLocal = tbufTarget_.template Get<int64_t>();
        AscendC::LocalTensor<float> isTargetLocal = tbufIsTarget_.template Get<float>();
        AscendC::LocalTensor<float> sumLocal = tbufSum_.template Get<float>();

        AscendC::DataCopyExtParams copyInput;
        copyInput.blockCount = 1;
        copyInput.blockLen = static_cast<uint32_t>(classCount_ * sizeof(T));
        copyInput.srcStride = 0;
        copyInput.dstStride = 0;
        AscendC::DataCopyExtParams copyTarget;
        copyTarget.blockCount = 1;
        copyTarget.blockLen = static_cast<uint32_t>(classCount_ * sizeof(int64_t));
        copyTarget.srcStride = 0;
        copyTarget.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padInput{
            true, 0, static_cast<uint8_t>(inputAligned_ - classCount_), static_cast<T>(0)};
        AscendC::DataCopyPadExtParams<int64_t> padTarget{
            true, 0, static_cast<uint8_t>(targetAligned_ - classCount_), static_cast<int64_t>(-1)};

        int64_t inputRowOffset = sample * inputStride0_;
        int64_t targetRowOffset = sample * targetStride0_;
        if (inputStride1_ == 1) {
            AscendC::DataCopyPad(inputLocal, inputGm_[inputRowOffset], copyInput, padInput);
        } else {
            AscendC::DataCopyExtParams copyOne;
            copyOne.blockCount = 1;
            copyOne.blockLen = static_cast<uint32_t>(sizeof(T));
            copyOne.srcStride = 0;
            copyOne.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padOne{false, 0, 0, static_cast<T>(0)};
            for (int64_t j = 0; j < classCount_; ++j) {
                AscendC::DataCopyPad(inputLocal[j], inputGm_[inputRowOffset + j * inputStride1_],
                                     copyOne, padOne);
            }
        }
        if (targetStride1_ == 1) {
            AscendC::DataCopyPad(targetLocal, targetGm_[targetRowOffset], copyTarget, padTarget);
        } else {
            AscendC::DataCopyExtParams copyOne;
            copyOne.blockCount = 1;
            copyOne.blockLen = static_cast<uint32_t>(sizeof(int64_t));
            copyOne.srcStride = 0;
            copyOne.dstStride = 0;
            AscendC::DataCopyPadExtParams<int64_t> padOne{
                false, 0, 0, static_cast<int64_t>(-1)};
            for (int64_t j = 0; j < classCount_; ++j) {
                AscendC::DataCopyPad(targetLocal[j], targetGm_[targetRowOffset + j * targetStride1_],
                                     copyOne, padOne);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t j = 0; j < floatAligned_; ++j) {
            isTargetLocal.SetValue(j, 0.0f);
        }
        for (int64_t i = 0; i < classCount_; ++i) {
            int64_t label = targetLocal.GetValue(i);
            if (label < 0) {
                break;
            }
            if (label < classCount_) {
                isTargetLocal.SetValue(label, 1.0f);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        float total = 0.0f;
        for (int64_t i = 0; i < classCount_; ++i) {
            int64_t label = targetLocal.GetValue(i);
            if (label < 0) {
                break;
            }
            if (label >= classCount_) {
                continue;
            }
            float positiveValue = ReadInputAsFloat(inputLocal, label);
            if constexpr (std::is_same<T, half>::value) {
                MultiLabelMarginLossHalf(inputLocal, isTargetLocal, sumLocal,
                                         positiveValue, static_cast<uint32_t>(classCount_),
                                         static_cast<uint32_t>(chunkCount_));
            } else {
                MultiLabelMarginLossFloat(inputLocal, isTargetLocal, sumLocal,
                                          positiveValue, static_cast<uint32_t>(classCount_),
                                          static_cast<uint32_t>(chunkCount_));
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            for (int64_t chunk = 0; chunk < chunkCount_; ++chunk) {
                total += sumLocal.GetValue(chunk * kFloatScalarSlotLanes);
            }
        }
        return total / static_cast<float>(classCount_);
    }

    __aicore__ inline float ReadInputAsFloat(AscendC::LocalTensor<T> inputLocal, int64_t index)
    {
        if constexpr (std::is_same<T, half>::value) {
            half v = inputLocal.GetValue(index);
            return static_cast<float>(v);
        } else {
            return inputLocal.GetValue(index);
        }
    }

    __aicore__ inline void StoreOutput(int64_t index, float value)
    {
        AscendC::LocalTensor<T> outLocal = tbufOut_.template Get<T>();
        if constexpr (std::is_same<T, half>::value) {
            outLocal.SetValue(0, T(value));
        } else {
            outLocal.SetValue(0, value);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(outputGm_[index], outLocal, copyOut);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<int64_t> targetGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufTarget_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIsTarget_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOut_;
    int64_t sampleCount_ = 0;
    int64_t classCount_ = 0;
    int64_t reduction_ = kReductionMean;
    int64_t inputStride0_ = 0;
    int64_t inputStride1_ = 1;
    int64_t targetStride0_ = 0;
    int64_t targetStride1_ = 1;
    int64_t inputAligned_ = 0;
    int64_t targetAligned_ = 0;
    int64_t floatAligned_ = 0;
    int64_t chunkCount_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void multilabel_margin_loss_kernel(
    GM_ADDR input, GM_ADDR target, GM_ADDR output, int64_t sampleCount,
    int64_t classCount, int64_t reduction, int64_t inputStride0,
    int64_t inputStride1, int64_t targetStride0, int64_t targetStride1,
    int64_t inputAligned, int64_t targetAligned, int64_t floatAligned,
    int64_t chunkCount)
{
    KernelMultiLabelMarginLoss<T> op;
    op.Init(input, target, output, sampleCount, classCount, reduction,
            inputStride0, inputStride1, targetStride0, targetStride1,
            inputAligned, targetAligned, floatAligned, chunkCount);
    op.Process();
}

torch::Tensor multilabel_margin_loss_npu(
    const torch::Tensor &input_in, const torch::Tensor &target_in, int64_t reduction)
{
    check_common(input_in, target_in, reduction);
    const c10::OptionalDeviceGuard guard(input_in.device());
    auto input = input_in.contiguous();
    auto target = target_in.contiguous();

    int64_t sampleCount = (input.dim() == 1) ? 1 : input.size(0);
    int64_t classCount = input.size(input.dim() - 1);
    int64_t inputStride0 = (input.dim() == 1) ? 0 : input.stride(0);
    int64_t inputStride1 = (input.dim() == 1) ? input.stride(0) : input.stride(1);
    int64_t targetStride0 = (target.dim() == 1) ? 0 : target.stride(0);
    int64_t targetStride1 = (target.dim() == 1) ? target.stride(0) : target.stride(1);
    torch::Tensor output = (input.dim() == 2 && reduction == kReductionNone)
        ? torch::empty({sampleCount}, input.options())
        : torch::empty({}, input.options());
    if (sampleCount == 0) {
        if (reduction == kReductionNone) {
            return output;
        }
    }

    int64_t inputAligned, targetAligned, floatAligned, chunkCount;
    std::tie(inputAligned, targetAligned, floatAligned, chunkCount) =
        calc_tiling_params(classCount, input.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)input.data_ptr();
    auto targetPtr = (GM_ADDR)target.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input.scalar_type(), "multilabel_margin_loss_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                multilabel_margin_loss_kernel<half><<<1, nullptr, stream>>>(
                    inputPtr, targetPtr, outputPtr, sampleCount, classCount,
                    reduction, inputStride0, inputStride1, targetStride0, targetStride1,
                    inputAligned, targetAligned, floatAligned, chunkCount);
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                multilabel_margin_loss_kernel<float><<<1, nullptr, stream>>>(
                    inputPtr, targetPtr, outputPtr, sampleCount, classCount,
                    reduction, inputStride0, inputStride1, targetStride0, targetStride1,
                    inputAligned, targetAligned, floatAligned, chunkCount);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("MultiLabelMarginLoss", acl_call);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("multilabel_margin_loss", multilabel_margin_loss_npu);
}

} // namespace MultiLabelMarginLoss
} // namespace ops_multimodal_fusion
