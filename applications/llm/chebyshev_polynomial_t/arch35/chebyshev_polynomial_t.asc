/*!
 * \file chebyshev_polynomial_t.asc
 * \brief RegBase-form chebyshev_polynomial_t for Ascend NPU (dav-3510)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <tuple>

namespace ops_multimodal_fusion {
namespace ChebyshevPolynomialT {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;
constexpr int64_t TOTAL_TILE_BUFFERS = 6;

#define CHEBYSHEV_ASIN_STEP(COEFF)                                \
    AscendC::Reg::Mul(polyReg, polyReg, zReg, mask);             \
    AscendC::Reg::Adds(polyReg, polyReg, COEFF, mask);

#define CHEBYSHEV_COS_STEP(COEFF)                                 \
    AscendC::Reg::Mul(cosPolyReg, cosPolyReg, trigArg2Reg, mask); \
    AscendC::Reg::Adds(cosPolyReg, cosPolyReg, COEFF, mask);

#define CHEBYSHEV_COSH_STEP(COEFF)                               \
    AscendC::Reg::Mul(coshPolyReg, coshPolyReg, trigArg2Reg, mask); \
    AscendC::Reg::Adds(coshPolyReg, coshPolyReg, COEFF, mask);

__simd_vf__ inline void ChebyshevPolynomialTRegVf(
    __ubuf__ float *dstAddr,
    __ubuf__ float *xAddr,
    __ubuf__ float *nAddr,
    uint32_t count,
    uint32_t chunkCount,
    int64_t maxDegree)
{
    static constexpr AscendC::Reg::CastTrait regCastInt32ToFloat = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_RINT};
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    constexpr float PI = 3.14159265358979323846f;
    constexpr float HALF_PI = 1.57079632679489661923f;
    constexpr float INV_PI = 0.31830988618379067154f;
    constexpr float ROUND_MAGIC = 12582912.0f;
    constexpr float oneValue = 1.0f;
    constexpr float zeroValue = 0.0f;
    AscendC::Reg::RegTensor<float> xReg, nRawReg, nIntReg, absXReg, outReg, tmpReg, tmp1Reg;
    AscendC::Reg::RegTensor<float> pReg, qReg, rReg, xTwiceReg, branchOutReg, recurOutReg, trigOutReg, hyperOutReg;
    AscendC::Reg::RegTensor<float> signReg, parityReg, thetaReg, zReg, polyReg, asinReg, trigArgReg, trigArg2Reg;
    AscendC::Reg::RegTensor<float> cosPolyReg, sqrtReg, logArgReg, acoshReg, expPosReg, expNegReg, coshPolyReg;
    AscendC::Reg::RegTensor<float> reduceKReg, quadrantSignReg, absSignReg;
    AscendC::Reg::RegTensor<float> kFloatReg, evenBaseReg, oneReg;
    AscendC::Reg::RegTensor<int32_t> kIntReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg negMask;
        AscendC::Reg::MaskReg absOneMask;
        AscendC::Reg::MaskReg gtZeroMask;
        AscendC::Reg::MaskReg posOneMask;
        AscendC::Reg::MaskReg nZeroMask;
        AscendC::Reg::MaskReg nOneMask;
        AscendC::Reg::MaskReg innerMask;
        AscendC::Reg::MaskReg outerMask;
        AscendC::Reg::MaskReg highDegreeMask;
        AscendC::Reg::MaskReg loopMask;
        AscendC::Reg::MaskReg nanMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(nRawReg, nAddr + offset);

        nIntReg = nRawReg;
        AscendC::Reg::Abs(absXReg, xReg, mask);
        AscendC::Reg::Duplicate<float>(outReg, zeroValue, mask);
        AscendC::Reg::Duplicate<float>(oneReg, oneValue, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(absOneMask, absXReg, oneValue, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(gtZeroMask, xReg, zeroValue, mask);
        AscendC::Reg::Muls(tmpReg, nIntReg, 0.5f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(evenBaseReg, tmpReg, 2.0f, mask);
        AscendC::Reg::Sub(parityReg, nIntReg, evenBaseReg, mask);
        AscendC::Reg::Abs(parityReg, parityReg, mask);
        AscendC::Reg::Muls(signReg, parityReg, -2.0f, mask);
        AscendC::Reg::Adds(signReg, signReg, 1.0f, mask);
        branchOutReg = signReg;
        AscendC::Reg::Select<float>(branchOutReg, oneReg, branchOutReg, gtZeroMask);
        AscendC::Reg::Select<float>(outReg, branchOutReg, outReg, absOneMask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(nZeroMask, nIntReg, zeroValue, mask);
        AscendC::Reg::Select<float>(outReg, oneReg, outReg, nZeroMask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(nOneMask, nIntReg, oneValue, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nOneMask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(innerMask, absXReg, oneValue, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(outerMask, absXReg, oneValue, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(highDegreeMask, nIntReg, 6.0f, mask);
        AscendC::Reg::Muls(tmpReg, absXReg, -1.0f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, 1.0f, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 0.5f, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, tmpReg, mask);
        AscendC::Reg::Mul(zReg, sqrtReg, sqrtReg, mask);
        AscendC::Reg::Duplicate<float>(polyReg, 0.022372159090909092f, mask);
        CHEBYSHEV_ASIN_STEP(0.030381944444444444f)
        CHEBYSHEV_ASIN_STEP(0.044642857142857144f)
        CHEBYSHEV_ASIN_STEP(0.075f)
        CHEBYSHEV_ASIN_STEP(0.166666666666666667f)
        AscendC::Reg::Mul(asinReg, polyReg, zReg, mask);
        AscendC::Reg::Mul(asinReg, asinReg, sqrtReg, mask);
        AscendC::Reg::Add(asinReg, asinReg, sqrtReg, mask);
        AscendC::Reg::Muls(thetaReg, asinReg, 2.0f, mask);
        AscendC::Reg::Muls(absSignReg, xReg, -1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(gtZeroMask, absSignReg, zeroValue, mask);
        AscendC::Reg::Muls(tmpReg, thetaReg, -1.0f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, PI, mask);
        AscendC::Reg::Select<float>(thetaReg, tmpReg, thetaReg, gtZeroMask);

        AscendC::Reg::Mul(trigArgReg, thetaReg, nIntReg, mask);
        AscendC::Reg::Muls(reduceKReg, trigArgReg, INV_PI, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmp1Reg, reduceKReg, PI, mask);
        AscendC::Reg::Sub(trigArgReg, trigArgReg, tmp1Reg, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, 0.5f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 2.0f, mask);
        AscendC::Reg::Sub(quadrantSignReg, reduceKReg, tmpReg, mask);
        AscendC::Reg::Abs(quadrantSignReg, quadrantSignReg, mask);
        AscendC::Reg::Muls(quadrantSignReg, quadrantSignReg, -2.0f, mask);
        AscendC::Reg::Adds(quadrantSignReg, quadrantSignReg, 1.0f, mask);
        AscendC::Reg::Mul(trigArg2Reg, trigArgReg, trigArgReg, mask);

        AscendC::Reg::Duplicate<float>(cosPolyReg, -1.0f / 3628800.0f, mask);
        CHEBYSHEV_COS_STEP(1.0f / 40320.0f)
        CHEBYSHEV_COS_STEP(-1.0f / 720.0f)
        CHEBYSHEV_COS_STEP(1.0f / 24.0f)
        CHEBYSHEV_COS_STEP(-1.0f / 2.0f)
        CHEBYSHEV_COS_STEP(1.0f)
        AscendC::Reg::Mul(trigOutReg, cosPolyReg, quadrantSignReg, mask);

        AscendC::Reg::Mul(tmpReg, absXReg, absXReg, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -1.0f, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, tmpReg, mask);
        AscendC::Reg::Add(logArgReg, absXReg, sqrtReg, mask);
        AscendC::Reg::Ln(acoshReg, logArgReg, mask);
        AscendC::Reg::Mul(trigArgReg, acoshReg, nIntReg, mask);
        AscendC::Reg::Exp(expPosReg, trigArgReg, mask);
        AscendC::Reg::Muls(tmpReg, trigArgReg, -1.0f, mask);
        AscendC::Reg::Exp(expNegReg, tmpReg, mask);
        AscendC::Reg::Add(hyperOutReg, expPosReg, expNegReg, mask);
        AscendC::Reg::Muls(hyperOutReg, hyperOutReg, 0.5f, mask);
        AscendC::Reg::Muls(tmpReg, xReg, -1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(gtZeroMask, tmpReg, zeroValue, mask);
        AscendC::Reg::Mul(tmpReg, hyperOutReg, signReg, mask);
        AscendC::Reg::Select<float>(hyperOutReg, tmpReg, hyperOutReg, gtZeroMask);

        AscendC::Reg::Duplicate<float>(pReg, oneValue, mask);
        qReg = xReg;
        AscendC::Reg::Duplicate<float>(rReg, zeroValue, mask);
        AscendC::Reg::Add(xTwiceReg, xReg, xReg, mask);
        recurOutReg = outReg;

        for (int64_t k = 2; k <= maxDegree; ++k) {
            AscendC::Reg::Duplicate<int32_t>(kIntReg, static_cast<int32_t>(k), mask);
            AscendC::Reg::Cast<float, int32_t, regCastInt32ToFloat>(kFloatReg, kIntReg, mask);
            AscendC::Reg::Compare<float, AscendC::CMPMODE::GE>(loopMask, nIntReg, kFloatReg, mask);

            AscendC::Reg::Mul(rReg, xTwiceReg, qReg, mask);
            AscendC::Reg::Sub(rReg, rReg, pReg, mask);
            AscendC::Reg::Select<float>(pReg, qReg, pReg, loopMask);
            AscendC::Reg::Select<float>(qReg, rReg, qReg, loopMask);
            AscendC::Reg::Select<float>(recurOutReg, rReg, recurOutReg, loopMask);
        }

        outReg = recurOutReg;
        branchOutReg = outReg;
        AscendC::Reg::Select<float>(outReg, branchOutReg, outReg, innerMask);
        branchOutReg = outReg;
        AscendC::Reg::Select<float>(branchOutReg, hyperOutReg, branchOutReg, highDegreeMask);
        AscendC::Reg::Select<float>(outReg, branchOutReg, outReg, outerMask);
        AscendC::Reg::Select<float>(outReg, oneReg, outReg, nZeroMask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nOneMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(posOneMask, xReg, zeroValue, mask);
        branchOutReg = signReg;
        AscendC::Reg::Select<float>(branchOutReg, oneReg, branchOutReg, posOneMask);
        AscendC::Reg::Select<float>(outReg, branchOutReg, outReg, absOneMask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(negMask, nIntReg, zeroValue, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, zeroValue, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, negMask);

        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, qReg, qReg, mask);
        AscendC::Reg::Select<float>(outReg, qReg, outReg, nanMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void ChebyshevPolynomialTReg(
    const AscendC::LocalTensor<float> &dst,
    const AscendC::LocalTensor<float> &x,
    const AscendC::LocalTensor<float> &n,
    int64_t count,
    int64_t maxDegree)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *xAddr = (__ubuf__ float *)x.GetPhyAddr();
    __ubuf__ float *nAddr = (__ubuf__ float *)n.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ChebyshevPolynomialTRegVf>(dstAddr, xAddr, nAddr, elementCount, chunkCount, maxDegree);
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("chebyshev_polynomial_t(Tensor x, Tensor n) -> Tensor");
}

torch::Tensor chebyshev_polynomial_t_meta(const torch::Tensor &x, const torch::Tensor &n)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "chebyshev_polynomial_t only supports float32 x");
    auto outShape = at::infer_size(x.sizes(), n.sizes());
    return torch::empty(outShape, x.options().dtype(torch::kFloat32));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("chebyshev_polynomial_t", chebyshev_polynomial_t_meta);
}

std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / TOTAL_TILE_BUFFERS / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) {
        tileBytes = BLOCK_BYTES;
    }
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) {
        tileElems = 8;
    }
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

class KernelChebyshevPolynomialT {
public:
    __aicore__ inline KernelChebyshevPolynomialT() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR n, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength, int64_t maxDegree)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        maxDegree_ = maxDegree;
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockIdx * blockLength);
        nGm_.SetGlobalBuffer((__gm__ float *)n + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockIdx * blockLength);

        int64_t tileBytes = ((tileLength_ * static_cast<int64_t>(sizeof(float)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(xQueue_, 2, tileBytes);
        pipe_.InitBuffer(nQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto xLocal = xQueue_.AllocTensor<float>();
        auto nLocal = nQueue_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(xLocal, xGm_[offset], p, pad);
        AscendC::DataCopyPad(nLocal, nGm_[offset], p, pad);
        xQueue_.EnQue(xLocal);
        nQueue_.EnQue(nLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto xLocal = xQueue_.DeQue<float>();
        auto nLocal = nQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        ChebyshevPolynomialTReg(outLocal, xLocal, nLocal, count, maxDegree_);
        AscendC::PipeBarrier<PIPE_V>();
        xQueue_.FreeTensor(xLocal);
        nQueue_.FreeTensor(nLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, nGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> xQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> nQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
    int64_t maxDegree_ = 0;
};

__global__ __aicore__ __vector__ void chebyshev_polynomial_t_kernel(
    GM_ADDR x, GM_ADDR n, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength, int64_t maxDegree)
{
    KernelChebyshevPolynomialT op;
    op.Init(x, n, y, totalLength, blockLength, tileLength, maxDegree);
    op.Process();
}

torch::Tensor chebyshev_polynomial_t_npu(const torch::Tensor &x, const torch::Tensor &n)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "chebyshev_polynomial_t only supports float32 x");
    TORCH_CHECK(x.device() == n.device(), "chebyshev_polynomial_t requires x and n on the same device");

    auto broadcasted = torch::broadcast_tensors({x, n});
    auto input = broadcasted[0].contiguous();
    auto degreeInt = broadcasted[1].to(torch::kInt32).contiguous();
    auto degree = degreeInt.to(torch::kFloat32).contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }
    int64_t maxDegree = degreeInt.max().item<int>();
    if (maxDegree < 0) {
        maxDegree = 0;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) = calc_tiling_params(totalLength, input.element_size());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto nPtr = (GM_ADDR)degree.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        chebyshev_polynomial_t_kernel<<<numBlocks, nullptr, stream>>>(
            xPtr, nPtr, yPtr, totalLength, blockLength, tileLength, maxDegree);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("ChebyshevPolynomialT", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("chebyshev_polynomial_t", chebyshev_polynomial_t_npu);
}

} // namespace ChebyshevPolynomialT
} // namespace ops_multimodal_fusion
