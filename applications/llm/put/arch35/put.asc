/*!
 * \file put.asc
 * \brief Put operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * torch.Tensor.put_(index, source, accumulate=False)
 *   result.view(-1)[index[i]]  = source[i]            (accumulate=False)
 *   result.view(-1)[index[i]] += source[i]            (accumulate=True)
 *   Self is treated as flat (any ndim >= 1); index addresses self.numel().
 *   Negative indices wrap: idx in [-K, K) maps to [0, K) via (raw < 0) ? raw+K : raw.
 *
 * Dispatch scope (first version):
 *   - self: N-D (N >= 1), treated as flat; K = self.numel() in [1, INT32_MAX]
 *   - index / source: 1-D; M = index.numel() = source.numel() in [0, INT32_MAX]
 *   - dtype(self) == dtype(source) in {fp32, fp16, int32}
 *   - index.dtype == int64 (read low-32 lane via static_cast)
 *   - accumulate in {False, True}
 *
 * 3-layer Reg shape:
 *   Layer 1 vf function:
 *     PutAxisCopyVf<T> : LoadAlign + StoreAlign (selfLocal -> resultLocal)
 *   Layer 2 __aicore__ wrapper: GetPhyAddr cast + asc_vf_call
 *   Layer 3 kernel class: DMA, vf integer K copy, serial M-loop scalar scatter
 *     with negative wrap + accumulate branch, DMA out
 *
 * Scalar scatter path:
 *   raw = (int32)indexLocal.GetValue(j);
 *   idx = (raw < 0) ? raw + K : raw;        // host guaranteed idx in [-K, K)
 *   if (accumulate) {
 *       old = resultLocal.GetValue(idx);
 *       nv  = old + sourceLocal.GetValue(j); // fp16 via fp32 promote
 *       resultLocal.SetValue(idx, nv);
 *   } else {
 *       resultLocal.SetValue(idx, sourceLocal.GetValue(j));
 *   }
 *
 *   Duplicate index semantics: accumulate=True is order-independent (sum); for
 *   accumulate=False, serial j loop -> last j wins (matches CPU; CUDA "undefined"
 *   compatible).
 *
 *   Empty M (M == 0): kernel runs vf integer K copy self -> result and skips
 *   the scatter loop. Equivalent to result = self.clone().
 *
 * UB layout (whole K resident; numBlocks=1, AIV=0 only):
 *   tbufSelf:    K * sizeof(T)
 *   tbufResult:  K * sizeof(T)
 *   tbufSource:  M * sizeof(T)         (only if M > 0)
 *   tbufIndex:   M * sizeof(int64_t)   (only if M > 0)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Put {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("put(Tensor self, Tensor index, Tensor source, bool accumulate=False) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor put_meta(
    const torch::Tensor &self, const torch::Tensor &index,
    const torch::Tensor &source, bool /*accumulate*/)
{
    TORCH_CHECK(self.dim() >= 1,
                "put: self must have at least 1 dimension, got 0-D");
    TORCH_CHECK(source.dim() == 1,
                "put: only 1-D source is supported, got ", source.dim(), "-D");
    TORCH_CHECK(index.dim() == 1,
                "put: only 1-D index is supported, got ", index.dim(), "-D");
    TORCH_CHECK(self.scalar_type() == source.scalar_type(),
                "put: self dtype (", self.scalar_type(),
                ") must match source dtype (", source.scalar_type(), ")");
    TORCH_CHECK(index.scalar_type() == torch::kInt64,
                "put: index dtype must be int64, got ", index.scalar_type());
    TORCH_CHECK(index.numel() == source.numel(),
                "put: index numel (", index.numel(),
                ") must equal source numel (", source.numel(), ")");
    return torch::empty_like(self);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("put", put_meta);
}

// ===================== 3. Kernel — 3-layer Reg shape =====================

// --------- Layer 1 vf function ---------

// Whole-tile copy: dst[0..count) = src[0..count)
template <typename T>
__simd_vf__ inline void PutAxisCopyVf(
    __ubuf__ T *srcAddr, __ubuf__ T *dstAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            reg, srcAddr + offset);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, reg, mask);
    }
}

// --------- Layer 2 wrapper ---------

template <typename T>
__aicore__ inline void PutAxisCopy(
    AscendC::LocalTensor<T> &src, AscendC::LocalTensor<T> &dst,
    uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ T *srcPtr = (__ubuf__ T *)src.GetPhyAddr();
    __ubuf__ T *dstPtr = (__ubuf__ T *)dst.GetPhyAddr();
    asc_vf_call<PutAxisCopyVf<T>>(srcPtr, dstPtr, elementCount, chunkCount);
}

// --------- Layer 3 kernel class ---------

template <typename T>
class KernelPut {
public:
    __aicore__ inline KernelPut() {}

    __aicore__ inline void Init(
        GM_ADDR self, GM_ADDR index, GM_ADDR source,
        GM_ADDR result,
        int64_t K, int64_t M, bool accumulate)
    {
        selfGm_.SetGlobalBuffer((__gm__ T *)self);
        indexGm_.SetGlobalBuffer((__gm__ int64_t *)index);
        sourceGm_.SetGlobalBuffer((__gm__ T *)source);
        resultGm_.SetGlobalBuffer((__gm__ T *)result);
        K_ = K;
        M_ = M;
        accumulate_ = accumulate;

        const uint32_t selfBytes   = static_cast<uint32_t>(K * sizeof(T));
        const uint32_t resultBytes = static_cast<uint32_t>(K * sizeof(T));
        pipe_.InitBuffer(tbufSelf_,   selfBytes);
        pipe_.InitBuffer(tbufResult_, resultBytes);
        if (M > 0) {
            const uint32_t sourceBytes = static_cast<uint32_t>(M * sizeof(T));
            const uint32_t indexBytes  = static_cast<uint32_t>(M * sizeof(int64_t));
            pipe_.InitBuffer(tbufSource_, sourceBytes);
            pipe_.InitBuffer(tbufIndex_,  indexBytes);
        }
    }

    __aicore__ inline void Process()
    {
        if (K_ <= 0) return;
        // Single-AIV serial: only AIV 0 executes.
        if (AscendC::GetBlockIdx() != 0) return;

        AscendC::LocalTensor<T> selfLocal   = tbufSelf_.template Get<T>();
        AscendC::LocalTensor<T> resultLocal = tbufResult_.template Get<T>();

        const uint32_t K_u32 = static_cast<uint32_t>(K_);
        const int32_t K_i32 = static_cast<int32_t>(K_);

        // DMA self in.
        AscendC::DataCopyExtParams cpSelf;
        cpSelf.blockCount = 1;
        cpSelf.blockLen   = static_cast<uint32_t>(K_ * sizeof(T));
        cpSelf.srcStride  = 0;
        cpSelf.dstStride  = 0;
        AscendC::DataCopyPadExtParams<T> padT{false, 0, 0, T{}};
        AscendC::DataCopyPad(selfLocal, selfGm_, cpSelf, padT);
        AscendC::PipeBarrier<PIPE_ALL>();

        if (M_ > 0) {
            AscendC::LocalTensor<T>       sourceLocal = tbufSource_.template Get<T>();
            AscendC::LocalTensor<int64_t> indexLocal  = tbufIndex_.template Get<int64_t>();

            AscendC::DataCopyExtParams cpSource;
            cpSource.blockCount = 1;
            cpSource.blockLen   = static_cast<uint32_t>(M_ * sizeof(T));
            cpSource.srcStride  = 0;
            cpSource.dstStride  = 0;
            AscendC::DataCopyExtParams cpIndex;
            cpIndex.blockCount = 1;
            cpIndex.blockLen   = static_cast<uint32_t>(M_ * sizeof(int64_t));
            cpIndex.srcStride  = 0;
            cpIndex.dstStride  = 0;
            AscendC::DataCopyPadExtParams<int64_t> padI{false, 0, 0, static_cast<int64_t>(0)};

            AscendC::DataCopyPad(sourceLocal, sourceGm_, cpSource, padT);
            AscendC::DataCopyPad(indexLocal,  indexGm_,  cpIndex,  padI);
            AscendC::PipeBarrier<PIPE_ALL>();

            // resultLocal = selfLocal (vectorized whole-K copy).
            PutAxisCopy<T>(selfLocal, resultLocal, K_u32);
            AscendC::PipeBarrier<PIPE_ALL>();

            // Serial scatter with negative-index wrap + accumulate branch.
            for (int64_t j = 0; j < M_; ++j) {
                int32_t raw = static_cast<int32_t>(indexLocal.GetValue(j));
                int32_t idx = (raw < 0) ? (raw + K_i32) : raw;
                T v = sourceLocal.GetValue(j);
                if (accumulate_) {
                    T old = resultLocal.GetValue(idx);
                    T nv;
                    if constexpr (std::is_same_v<T, half>) {
                        // fp16 scalar add via fp32 promote (mirror index_reduce mean).
                        nv = T(static_cast<float>(old) + static_cast<float>(v));
                    } else {
                        nv = static_cast<T>(old + v);
                    }
                    resultLocal.SetValue(idx, nv);
                } else {
                    resultLocal.SetValue(idx, v);
                }
            }
            // Flush scalar SetValue writes before DMA out.
            AscendC::PipeBarrier<PIPE_ALL>();
        } else {
            // M == 0: just vector-copy self -> result.
            PutAxisCopy<T>(selfLocal, resultLocal, K_u32);
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        AscendC::DataCopyPad(resultGm_, resultLocal, cpSelf);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       selfGm_;
    AscendC::GlobalTensor<int64_t> indexGm_;
    AscendC::GlobalTensor<T>       sourceGm_;
    AscendC::GlobalTensor<T>       resultGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSelf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufResult_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSource_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIndex_;
    int64_t K_ = 0;
    int64_t M_ = 0;
    bool accumulate_ = false;
};

template <typename T>
__global__ __aicore__ __vector__ void put_kernel(
    GM_ADDR self, GM_ADDR index, GM_ADDR source,
    GM_ADDR result,
    int64_t K, int64_t M, bool accumulate)
{
    KernelPut<T> op;
    op.Init(self, index, source, result, K, M, accumulate);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

torch::Tensor put_npu(
    const torch::Tensor &self, const torch::Tensor &index,
    const torch::Tensor &source, bool accumulate)
{
    auto dtype = self.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "put (RegBase): only float32 / float16 / int32 are supported, got ",
                dtype);
    TORCH_CHECK(self.dim() >= 1,
                "put: self must have at least 1 dimension, got 0-D");
    TORCH_CHECK(source.dim() == 1,
                "put: only 1-D source is supported, got ", source.dim(), "-D");
    TORCH_CHECK(index.dim() == 1,
                "put: only 1-D index is supported, got ", index.dim(), "-D");
    TORCH_CHECK(source.scalar_type() == dtype,
                "put: self dtype (", dtype,
                ") must match source dtype (", source.scalar_type(), ")");
    TORCH_CHECK(index.scalar_type() == torch::kInt64,
                "put: index dtype must be int64, got ", index.scalar_type());

    const int64_t K = self.numel();
    const int64_t M = source.numel();
    TORCH_CHECK(K >= 1, "put: self numel must be >= 1, got K=", K);
    TORCH_CHECK(K <= static_cast<int64_t>(0x7fffffff),
                "put: self numel K=", K, " exceeds INT32_MAX");
    TORCH_CHECK(index.numel() == M,
                "put: index numel (", index.numel(),
                ") must equal source numel (", M, ")");
    TORCH_CHECK(M >= 0 && M <= static_cast<int64_t>(0x7fffffff),
                "put: source numel M=", M, " out of range [0, INT32_MAX]");

    const c10::OptionalDeviceGuard guard(self.device());
    auto self_c   = self.contiguous();
    auto index_c  = index.contiguous();
    auto source_c = source.contiguous();

    // Index bounds check on host (allows negative indices in [-K, K)).
    // O(M) cost, dominated by DMA / kernel-launch.
    if (M > 0) {
        auto index_cpu = index_c.cpu();
        const int64_t idx_min = index_cpu.min().item<int64_t>();
        const int64_t idx_max = index_cpu.max().item<int64_t>();
        TORCH_CHECK(idx_min >= -K,
                    "put: index minimum (", idx_min, ") must be >= -K=", -K);
        TORCH_CHECK(idx_max < K,
                    "put: index maximum (", idx_max, ") must be < K=", K);
    }

    // UB-capacity guard. This single-tile dispatch keeps the whole self + result
    // (2*K elements) and the source + index operands (M each) resident in UB. An
    // input whose working set exceeds UB would otherwise overrun the buffer and
    // raise a hard device fault (error 507035) rather than a clean rejection, so
    // reject it on the host first. A future multi-tile version can lift this.
    {
        auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
        uint64_t ubSize = 0;
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
        const int64_t elem = static_cast<int64_t>(self_c.element_size());
        auto align32 = [](int64_t b) { return (b + 31) / 32 * 32; };
        const int64_t working = align32(K * elem) * 2
                              + align32(M * elem)
                              + align32(M * static_cast<int64_t>(sizeof(int64_t)));
        const int64_t margin = 8192;
        TORCH_CHECK(static_cast<uint64_t>(working + margin) <= ubSize,
                    "put: UB working set ", working, " bytes (2*K + M; K=", K,
                    ", M=", M, ") exceeds UB ", ubSize, " bytes; self and the "
                    "index/source operands must fit in UB for this single-tile dispatch");
    }

    auto result = torch::empty_like(self_c);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto selfPtr   = (GM_ADDR)self_c.data_ptr();
    auto indexPtr  = (GM_ADDR)index_c.data_ptr();
    auto sourcePtr = (GM_ADDR)source_c.data_ptr();
    auto resultPtr = (GM_ADDR)result.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            self_c.scalar_type(), "put_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                put_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, sourcePtr, resultPtr, K, M, accumulate);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                put_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, sourcePtr, resultPtr, K, M, accumulate);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                put_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, sourcePtr, resultPtr, K, M, accumulate);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Put", acl_call);

    return result;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("put", put_npu);
}

} // namespace Put
} // namespace ops_multimodal_fusion
