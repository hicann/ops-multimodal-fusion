/*!
 * \file nested_binary_op.asc
 * \brief NestedBinaryOp operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * Schema:
 *   nested_binary_op(Tensor values, Tensor offsets, Tensor dense, int op_mode) -> Tensor
 *
 *   For each batch i in [0, B):
 *     rs = offsets[i], re = offsets[i+1]   (row units; L_i = re - rs)
 *     result[rs:re, :] = values[rs:re, :] + dense[i, 0, :]    if op_mode == 0
 *     result[rs:re, :] = values[rs:re, :] * dense[i, 0, :]    if op_mode == 1
 *
 *   Equivalent to PyTorch CUDA op_dense_esuhm for the (nested [B, *, D],
 *   dense [B, 1, D]) elementwise add/mul broadcast.
 *
 * Dispatch scope (first version):
 *   - values: 2-D (sum_L, D)
 *   - offsets: 1-D (B+1,), int64, row units; offsets[0]=0, offsets[B]=sum_L,
 *              non-decreasing
 *   - dense: 3-D (B, 1, D)
 *   - dtype(values) == dtype(dense) in {fp32, fp16, int32}
 *   - op_mode in {0, 1}
 *
 * 3-layer Reg shape:
 *   Layer 1 vf functions:
 *     BroadcastAddRowsRegVf<T> / BroadcastMulRowsRegVf<T>
 *       Outer loop over D-axis chunks, inner loop over rows.
 *       Each chunk loads denseReg once and reuses it across rows.
 *   Layer 2 __aicore__ wrappers: GetPhyAddr cast + asc_vf_call
 *   Layer 3 kernel class: per-batch dense preload, chunked nested DMA,
 *           per-tile vf dispatch on opMode, DMA out.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace NestedBinaryOp {

constexpr static int64_t PIPELINE_DEPTH = 2;
constexpr static int64_t MIN_TILE_ROWS  = 1;
constexpr static int64_t MAX_TILE_ROWS  = 256;
constexpr static int64_t SAFETY_BYTES   = 1024;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def(
        "nested_binary_op(Tensor values, Tensor offsets, Tensor dense, int op_mode) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor nested_binary_op_meta(
    const torch::Tensor &values, const torch::Tensor &offsets,
    const torch::Tensor &dense, int64_t op_mode)
{
    TORCH_CHECK(values.dim() == 2,
                "nested_binary_op: values must be 2-D (sum_L, D), got ",
                values.dim(), "-D");
    TORCH_CHECK(offsets.dim() == 1,
                "nested_binary_op: offsets must be 1-D, got ", offsets.dim(), "-D");
    TORCH_CHECK(dense.dim() == 3,
                "nested_binary_op: dense must be 3-D (B, 1, D), got ", dense.dim(), "-D");
    TORCH_CHECK(dense.size(1) == 1,
                "nested_binary_op: dense.size(1) must be 1, got ", dense.size(1));
    TORCH_CHECK(dense.size(2) == values.size(1),
                "nested_binary_op: dense.size(2)=", dense.size(2),
                " must equal values.size(1)=", values.size(1));
    TORCH_CHECK(offsets.size(0) == dense.size(0) + 1,
                "nested_binary_op: offsets.size(0)=", offsets.size(0),
                " must equal dense.size(0)+1=", dense.size(0) + 1);
    TORCH_CHECK(offsets.scalar_type() == torch::kInt64,
                "nested_binary_op: offsets must be int64, got ", offsets.scalar_type());
    TORCH_CHECK(values.scalar_type() == dense.scalar_type(),
                "nested_binary_op: values dtype (", values.scalar_type(),
                ") must match dense dtype (", dense.scalar_type(), ")");
    TORCH_CHECK(op_mode == 0 || op_mode == 1,
                "nested_binary_op: op_mode must be 0 (add) or 1 (mul), got ", op_mode);
    return torch::empty_like(values);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("nested_binary_op", nested_binary_op_meta);
}

// ===================== 3. Kernel — 3-layer Reg shape =====================

// --------- Layer 1 vf functions ---------
//
// Outer loop over chunks of the D-axis; inner loop over rows. denseReg is
// loaded once per chunk and reused across rows, amortizing the constant
// broadcast operand. count == embeddingDim (not rowCount * embeddingDim);
// chunkCount == ceil(count / vectorLength).

template <typename T>
__simd_vf__ inline void BroadcastAddRowsRegVf(
    __ubuf__ T *dstAddr, __ubuf__ T *srcAddr, __ubuf__ T *denseAddr,
    uint32_t rowCount, uint32_t embeddingDim, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = embeddingDim - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::RegTensor<T> denseReg;
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            denseReg, denseAddr + offset);
        for (uint32_t row = 0; row < rowCount; ++row) {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
                srcReg, srcAddr + row * embeddingDim + offset);
            AscendC::Reg::Add(dstReg, srcReg, denseReg, mask);
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + row * embeddingDim + offset, dstReg, mask);
        }
    }
}

template <typename T>
__simd_vf__ inline void BroadcastMulRowsRegVf(
    __ubuf__ T *dstAddr, __ubuf__ T *srcAddr, __ubuf__ T *denseAddr,
    uint32_t rowCount, uint32_t embeddingDim, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = embeddingDim - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::RegTensor<T> denseReg;
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            denseReg, denseAddr + offset);
        for (uint32_t row = 0; row < rowCount; ++row) {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
                srcReg, srcAddr + row * embeddingDim + offset);
            AscendC::Reg::Mul(dstReg, srcReg, denseReg, mask);
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + row * embeddingDim + offset, dstReg, mask);
        }
    }
}

// --------- Layer 2 wrappers ---------

template <typename T>
__aicore__ inline void BroadcastAddRows(
    AscendC::LocalTensor<T> &dst, AscendC::LocalTensor<T> &src,
    AscendC::LocalTensor<T> &denseRow,
    int64_t rowCount, int64_t embeddingDim)
{
    __ubuf__ T *dstPtr   = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ T *srcPtr   = (__ubuf__ T *)src.GetPhyAddr();
    __ubuf__ T *densePtr = (__ubuf__ T *)denseRow.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t embDim     = static_cast<uint32_t>(embeddingDim);
    uint32_t chunkCount = (embDim + vectorLength - 1) / vectorLength;
    asc_vf_call<BroadcastAddRowsRegVf<T>>(
        dstPtr, srcPtr, densePtr,
        static_cast<uint32_t>(rowCount), embDim, chunkCount);
}

template <typename T>
__aicore__ inline void BroadcastMulRows(
    AscendC::LocalTensor<T> &dst, AscendC::LocalTensor<T> &src,
    AscendC::LocalTensor<T> &denseRow,
    int64_t rowCount, int64_t embeddingDim)
{
    __ubuf__ T *dstPtr   = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ T *srcPtr   = (__ubuf__ T *)src.GetPhyAddr();
    __ubuf__ T *densePtr = (__ubuf__ T *)denseRow.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t embDim     = static_cast<uint32_t>(embeddingDim);
    uint32_t chunkCount = (embDim + vectorLength - 1) / vectorLength;
    asc_vf_call<BroadcastMulRowsRegVf<T>>(
        dstPtr, srcPtr, densePtr,
        static_cast<uint32_t>(rowCount), embDim, chunkCount);
}

// --------- Layer 3 kernel class ---------

template <typename T>
class KernelNestedBinaryOp {
public:
    __aicore__ inline KernelNestedBinaryOp() {}

    __aicore__ inline void Init(
        GM_ADDR values, GM_ADDR offsets, GM_ADDR dense, GM_ADDR output,
        int64_t batchSize, int64_t embeddingDim, int32_t opMode,
        int64_t blockBatchLength, int64_t tileRowCount)
    {
        valuesGm_.SetGlobalBuffer((__gm__ T *)values);
        offsetsGm_.SetGlobalBuffer((__gm__ int64_t *)offsets);
        denseGm_.SetGlobalBuffer((__gm__ T *)dense);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        batchSize_    = batchSize;
        embeddingDim_ = embeddingDim;
        opMode_       = opMode;
        tileRowCount_ = tileRowCount;

        int64_t blockStart = blockBatchLength * AscendC::GetBlockIdx();
        int64_t myLength = batchSize - blockStart;
        if (myLength > blockBatchLength) myLength = blockBatchLength;
        if (myLength < 0) myLength = 0;
        blockStart_ = blockStart;
        myLength_   = myLength;

        const uint32_t denseBytes = static_cast<uint32_t>(embeddingDim * sizeof(T));
        const uint32_t chunkBytes =
            static_cast<uint32_t>(tileRowCount * embeddingDim * sizeof(T));

        pipe_.InitBuffer(inQueueDense_, PIPELINE_DEPTH, denseBytes);
        pipe_.InitBuffer(inQueueValues_, PIPELINE_DEPTH, chunkBytes);
        pipe_.InitBuffer(outQueueOutput_, PIPELINE_DEPTH, chunkBytes);
    }

    __aicore__ inline void Process()
    {
        if (myLength_ <= 0 || embeddingDim_ <= 0) return;

        AscendC::DataCopyExtParams cpDense;
        cpDense.blockCount = 1;
        cpDense.blockLen   = static_cast<uint32_t>(embeddingDim_ * sizeof(T));
        cpDense.srcStride  = 0;
        cpDense.dstStride  = 0;
        AscendC::DataCopyPadExtParams<T> padT{false, 0, 0, T{}};

        for (int64_t i = blockStart_; i < blockStart_ + myLength_; ++i) {
            int64_t offLo = offsetsGm_.GetValue(i);
            int64_t offHi = offsetsGm_.GetValue(i + 1);
            int64_t L_i = offHi - offLo;
            if (L_i <= 0) continue;

            // Per-batch dense via a double-buffered queue. EnQue/DeQue syncs the
            // load before compute, and FreeTensor + double-buffering syncs reuse
            // across batches (blockBatchLength > 1 when coreNum < B): the prior
            // batch's vf reads of the buffer complete before AllocTensor hands it
            // back. A persistent TBuf instead either races (rows of batch i pick
            // up batch i+1's dense) or, with a manual PipeBarrier, deadlocks the
            // value TQue pipeline.
            AscendC::LocalTensor<T> denseRow = inQueueDense_.template AllocTensor<T>();
            AscendC::DataCopyPad(
                denseRow, denseGm_[i * embeddingDim_], cpDense, padT);
            inQueueDense_.EnQue(denseRow);
            denseRow = inQueueDense_.template DeQue<T>();

            for (int64_t r0 = 0; r0 < L_i; r0 += tileRowCount_) {
                int64_t k = L_i - r0;
                if (k > tileRowCount_) k = tileRowCount_;
                int64_t elemCount = k * embeddingDim_;
                uint32_t tileBytes = static_cast<uint32_t>(elemCount * sizeof(T));

                // DMA in: k rows from values.
                AscendC::LocalTensor<T> inLocal = inQueueValues_.template AllocTensor<T>();
                AscendC::DataCopyExtParams cpIn;
                cpIn.blockCount = 1;
                cpIn.blockLen   = tileBytes;
                cpIn.srcStride  = 0;
                cpIn.dstStride  = 0;
                AscendC::DataCopyPad(
                    inLocal,
                    valuesGm_[(offLo + r0) * embeddingDim_],
                    cpIn, padT);
                inQueueValues_.EnQue(inLocal);
                inLocal = inQueueValues_.template DeQue<T>();

                // Compute: per-row broadcast add or mul.
                AscendC::LocalTensor<T> outLocal = outQueueOutput_.template AllocTensor<T>();
                if (opMode_ == 0) {
                    BroadcastAddRows<T>(outLocal, inLocal, denseRow, k, embeddingDim_);
                } else {
                    BroadcastMulRows<T>(outLocal, inLocal, denseRow, k, embeddingDim_);
                }
                outQueueOutput_.EnQue(outLocal);
                inQueueValues_.FreeTensor(inLocal);

                // DMA out.
                outLocal = outQueueOutput_.template DeQue<T>();
                AscendC::DataCopyPad(
                    outputGm_[(offLo + r0) * embeddingDim_],
                    outLocal, cpIn);
                outQueueOutput_.FreeTensor(outLocal);
            }
            inQueueDense_.FreeTensor(denseRow);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       valuesGm_;
    AscendC::GlobalTensor<int64_t> offsetsGm_;
    AscendC::GlobalTensor<T>       denseGm_;
    AscendC::GlobalTensor<T>       outputGm_;
    AscendC::TQue<AscendC::QuePosition::VECIN,  PIPELINE_DEPTH> inQueueDense_;
    AscendC::TQue<AscendC::QuePosition::VECIN,  PIPELINE_DEPTH> inQueueValues_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, PIPELINE_DEPTH> outQueueOutput_;
    int64_t batchSize_ = 0;
    int64_t embeddingDim_ = 0;
    int32_t opMode_ = 0;
    int64_t blockStart_ = 0;
    int64_t myLength_ = 0;
    int64_t tileRowCount_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void nested_binary_op_kernel(
    GM_ADDR values, GM_ADDR offsets, GM_ADDR dense, GM_ADDR output,
    int64_t batchSize, int64_t embeddingDim, int32_t opMode,
    int64_t blockBatchLength, int64_t tileRowCount)
{
    KernelNestedBinaryOp<T> op;
    op.Init(values, offsets, dense, output,
            batchSize, embeddingDim, opMode,
            blockBatchLength, tileRowCount);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t batchSize, int64_t embeddingDim, size_t bytesPerT)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "nested_binary_op: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, batchSize);
    if (numBlocks < 1) numBlocks = 1;
    int64_t blockBatchLength = (batchSize + numBlocks - 1) / numBlocks;

    int64_t rowBytes  = embeddingDim * static_cast<int64_t>(bytesPerT);
    // dense queue is double-buffered (InitBuffer ... PIPELINE_DEPTH), so it
    // occupies PIPELINE_DEPTH * rowBytes of UB; reserve that much from the budget.
    int64_t denseBytes = PIPELINE_DEPTH * rowBytes;
    int64_t budgetBytes = static_cast<int64_t>(ubSize) - denseBytes - SAFETY_BYTES;
    int64_t denomPerRow = 2 * PIPELINE_DEPTH * rowBytes;
    TORCH_CHECK(denomPerRow > 0 && budgetBytes >= denomPerRow,
                "nested_binary_op: embeddingDim=", embeddingDim,
                " (bytes_per_elem=", bytesPerT,
                ") exceeds UB budget after pipeline overhead; UB=", ubSize,
                ", denseBytes=", denseBytes, ", denomPerRow=", denomPerRow);

    // Row-batching only when D * sizeof(T) is 32B-aligned. Otherwise row[r>0]
    // would start at a non-32B-aligned UB offset, which Reg::LoadAlign /
    // StoreAlign reject (RV_VLDI/RV_VSTI 32B alignment requirement). Mirrors
    // the rms_norm_gated single/multi-row tiling decision.
    const bool canBatch = (rowBytes % 32 == 0);
    int64_t tileRowCount = canBatch ? (budgetBytes / denomPerRow) : 1;
    if (tileRowCount < MIN_TILE_ROWS) tileRowCount = MIN_TILE_ROWS;
    if (tileRowCount > MAX_TILE_ROWS) tileRowCount = MAX_TILE_ROWS;

    return std::make_tuple(numBlocks, blockBatchLength, tileRowCount);
}

torch::Tensor nested_binary_op_npu(
    const torch::Tensor &values, const torch::Tensor &offsets,
    const torch::Tensor &dense, int64_t op_mode)
{
    auto dtype = values.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "nested_binary_op (RegBase): only float32 / float16 / int32 are "
                "supported, got ", dtype);
    TORCH_CHECK(values.dim() == 2,
                "nested_binary_op: values must be 2-D (sum_L, D), got ",
                values.dim(), "-D");
    TORCH_CHECK(offsets.dim() == 1,
                "nested_binary_op: offsets must be 1-D, got ", offsets.dim(), "-D");
    TORCH_CHECK(dense.dim() == 3,
                "nested_binary_op: dense must be 3-D (B, 1, D), got ", dense.dim(), "-D");
    TORCH_CHECK(dense.size(1) == 1,
                "nested_binary_op: dense.size(1) must be 1, got ", dense.size(1));
    TORCH_CHECK(dense.size(2) == values.size(1),
                "nested_binary_op: dense.size(2)=", dense.size(2),
                " must equal values.size(1)=", values.size(1));
    TORCH_CHECK(offsets.scalar_type() == torch::kInt64,
                "nested_binary_op: offsets must be int64, got ",
                offsets.scalar_type());
    TORCH_CHECK(offsets.size(0) == dense.size(0) + 1,
                "nested_binary_op: offsets.size(0)=", offsets.size(0),
                " must equal dense.size(0)+1=", dense.size(0) + 1);
    TORCH_CHECK(dense.scalar_type() == dtype,
                "nested_binary_op: dense dtype (", dense.scalar_type(),
                ") must match values dtype (", dtype, ")");
    TORCH_CHECK(op_mode == 0 || op_mode == 1,
                "nested_binary_op: op_mode must be 0 (add) or 1 (mul), got ",
                op_mode);

    const int64_t batchSize    = dense.size(0);
    const int64_t embeddingDim = values.size(1);
    const int64_t sumL         = values.size(0);
    TORCH_CHECK(batchSize >= 1,
                "nested_binary_op: batch size B must be >= 1, got ", batchSize);
    TORCH_CHECK(embeddingDim >= 1,
                "nested_binary_op: embedding dim D must be >= 1, got ", embeddingDim);
    TORCH_CHECK(embeddingDim <= static_cast<int64_t>(0x7fffffff),
                "nested_binary_op: embedding dim D=", embeddingDim,
                " exceeds INT32_MAX");
    TORCH_CHECK(sumL >= 0 && sumL <= static_cast<int64_t>(0x7fffffff),
                "nested_binary_op: sum_L=", sumL, " out of range [0, INT32_MAX]");

    // Validate offsets monotonicity and total length on host (O(B+1), dwarfed
    // by kernel launch cost) to surface bugs as TORCH_CHECK instead of NPU
    // segfaults.
    {
        auto offsets_cpu = offsets.cpu();
        const int64_t *p = offsets_cpu.const_data_ptr<int64_t>();
        TORCH_CHECK(p[0] == 0,
                    "nested_binary_op: offsets[0] must be 0, got ", p[0]);
        for (int64_t i = 0; i < batchSize; ++i) {
            TORCH_CHECK(p[i + 1] >= p[i],
                        "nested_binary_op: offsets must be non-decreasing at i=", i,
                        " (offsets[i]=", p[i], ", offsets[i+1]=", p[i + 1], ")");
        }
        TORCH_CHECK(p[batchSize] == sumL,
                    "nested_binary_op: offsets[B]=", p[batchSize],
                    " must equal values.size(0)=", sumL);
    }

    auto result = torch::empty_like(values);
    // Fast path: nothing to compute.
    if (sumL == 0) return result;

    const c10::OptionalDeviceGuard guard(values.device());
    auto values_c  = values.contiguous();
    auto offsets_c = offsets.contiguous();
    auto dense_c   = dense.contiguous();

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto valuesPtr  = (GM_ADDR)values_c.data_ptr();
    auto offsetsPtr = (GM_ADDR)offsets_c.data_ptr();
    auto densePtr   = (GM_ADDR)dense_c.data_ptr();
    auto resultPtr  = (GM_ADDR)result.data_ptr();

    const size_t bytesPerT = (dtype == torch::kFloat16) ? 2u : 4u;
    int64_t numBlocks, blockBatchLength, tileRowCount;
    std::tie(numBlocks, blockBatchLength, tileRowCount) =
        calc_tiling_params(batchSize, embeddingDim, bytesPerT);

    const int32_t opModeI32 = static_cast<int32_t>(op_mode);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            values_c.scalar_type(), "nested_binary_op_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                nested_binary_op_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    valuesPtr, offsetsPtr, densePtr, resultPtr,
                    batchSize, embeddingDim, opModeI32,
                    blockBatchLength, tileRowCount);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                nested_binary_op_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    valuesPtr, offsetsPtr, densePtr, resultPtr,
                    batchSize, embeddingDim, opModeI32,
                    blockBatchLength, tileRowCount);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                nested_binary_op_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    valuesPtr, offsetsPtr, densePtr, resultPtr,
                    batchSize, embeddingDim, opModeI32,
                    blockBatchLength, tileRowCount);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("NestedBinaryOp", acl_call);

    return result;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("nested_binary_op", nested_binary_op_npu);
}

} // namespace NestedBinaryOp
} // namespace ops_multimodal_fusion
