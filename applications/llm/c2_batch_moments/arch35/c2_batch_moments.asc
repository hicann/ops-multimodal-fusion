/*!
 * \file c2_batch_moments.asc
 * \brief Caffe2 BatchMoments forward operator for Ascend NPU (dav-3510),
 *        RegBase implementation.
 *
 * Schema:  c2_batch_moments(Tensor X) -> (Tensor mu, Tensor var)
 *   X    N-D tensor (ndim >= 2), layout NCHW, channel = dim(1)
 *   mu   1-D (C,)  channel-wise first moment   E[X]
 *   var  1-D (C,)  channel-wise second moment  E[X^2]   (NOT centred Var[X])
 *
 *   mu[c]  = (1/(N*HxW)) * sum_{n, h, w}  X[n, c, h, w]
 *   var[c] = (1/(N*HxW)) * sum_{n, h, w}  X[n, c, h, w]^2
 *
 * Naming follows the original Caffe2 op even though "var" is the raw second
 * moment, not centred variance. Callers wanting Var[X] should compute
 * var[c] - mu[c]^2 themselves.
 *
 * Scope (this version):
 *   - forward only (BatchMomentsGradient deferred)
 *   - NCHW only (NHWC deferred)
 *   - dtype scope: X / mu / var in {fp32, fp16}; bf16 and int types rejected.
 *
 * Reg shape - 3 layers:
 *   Layer 1 __simd_vf__   BatchMomentsRowVf<T>          chunked LoadAlign + Mul
 *                                                       + dual Reduce<SUM> +
 *                                                       lane-0 Add accumulators
 *                                                       across HxW chunks; writes
 *                                                       (sum, sumSq) scalars to
 *                                                       two 32B scratch slots.
 *   Layer 2 __aicore__    BatchMomentsChunkReduce<T>    LocalTensor -> __ubuf__
 *                                                       cast, asc_vf_call.
 *   Layer 3 kernel class  KernelC2BatchMoments<T>       per-channel outer loop
 *                                                       over N, scalar GetValue
 *                                                       on scratch slots and
 *                                                       host-side accumulators;
 *                                                       per-core mu/var staging
 *                                                       then single DMA out.
 *
 * Two-level accumulation:
 *   inside vf  -> chunk-sum lane 0 += chunk reduce
 *   in Layer 3 -> total scalar (across N) += vf scratch.GetValue(0)
 *
 * Per-core mu/var output is staged into a UB scratch tile and DMA'd out in one
 * shot at the end of Process(); per-core blockLength is rounded up to a 32B
 * multiple at the host so the per-core write segment is aligned and never
 * overlaps an adjacent core's region (paddedC = numBlocks * blockLength; mu/var
 * GM is over-allocated to paddedC and zero-initialised so the trailing slots
 * sum to zero and do not contaminate the result).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace C2BatchMoments {

constexpr static int64_t INT32B_LANES_F32 = 8;   // 32B / sizeof(float)
constexpr static int64_t INT32B_LANES_F16 = 16;  // 32B / sizeof(half)

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_batch_moments(Tensor X) -> (Tensor mu, Tensor var)");
}

// ===================== 2. Meta =====================

std::tuple<torch::Tensor, torch::Tensor> c2_batch_moments_meta(
    const torch::Tensor &X)
{
    TORCH_CHECK(X.dim() >= 2,
                "c2_batch_moments: X must have at least 2 dims (got ndim=",
                X.dim(), ")");
    int64_t C = X.size(1);
    auto opts = X.options();
    return std::make_tuple(torch::empty({C}, opts), torch::empty({C}, opts));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_batch_moments", c2_batch_moments_meta);
}

// ===================== 3. Tiling =====================

// Returns (numBlocks, blockLength, paddedC) where:
//   blockLength is rounded up to a 32B multiple in T elements so per-core
//   mu/var write segments are naturally 32B-aligned.
//   paddedC = numBlocks * blockLength >= C; the dispatch wrapper allocates mu
//   and var of length paddedC (zero-initialised) and slices to [:C] on return.
static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t C, int64_t HxW, size_t bytesPerT)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t SCALAR_SLOT_BYTES = 32;
    constexpr static int64_t SAFETY_MARGIN = 1024;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_batch_moments: coreNum must be positive");

    const int64_t laneAlign = (bytesPerT == 4) ? INT32B_LANES_F32 : INT32B_LANES_F16;

    int64_t numBlocks = std::min(coreNum, (C + laneAlign - 1) / laneAlign);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t blockLength = (C + numBlocks - 1) / numBlocks;
    blockLength = ((blockLength + laneAlign - 1) / laneAlign) * laneAlign;
    int64_t paddedC = numBlocks * blockLength;

    // Per-core UB:
    //   inQueueX            : PIPELINE_DEPTH * HxW * bytesPerT
    //   tbufSum / tbufSumSq : 2 * SCALAR_SLOT_BYTES (32B each)
    //   outQueueMu / outQueueVar : 2 * blockLength * bytesPerT
    int64_t queueBytes = PIPELINE_DEPTH * HxW * static_cast<int64_t>(bytesPerT);
    int64_t scratchBytes = 2 * SCALAR_SLOT_BYTES;
    int64_t outBytes = 2 * blockLength * static_cast<int64_t>(bytesPerT);
    TORCH_CHECK(queueBytes + scratchBytes + outBytes + SAFETY_MARGIN <= static_cast<int64_t>(ubSize),
                "c2_batch_moments: C=", C, " HxW=", HxW,
                " too large for dav-3510 UB. queueBytes=", queueBytes,
                " outBytes=", outBytes, " ubSize=", ubSize,
                ". Whole HxW chunk + per-core C tile must fit (this first version constraint).");

    return std::make_tuple(numBlocks, blockLength, paddedC);
}

// ===================== 4. Kernel - 3-layer Reg shape =====================

// Layer 1: __simd_vf__ chunked dual-Reduce<SUM>.
//   chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T) (fp32 64 / fp16 128).
//   For each chunk: LoadAlign(x); Mul(xSq, x, x); Reduce<SUM>(s,  x);
//                   Reduce<SUM>(ss, xSq); Add(sumAcc, sumAcc, s);
//                   Add(sumSqAcc, sumSqAcc, ss).
//   After loop: StoreAlign sumAcc and sumSqAcc lane 0 to two 32B scratch slots.
template <typename T>
__simd_vf__ inline void BatchMomentsRowVf(
    __ubuf__ T *xPtr,
    __ubuf__ T *sumOutPtr,
    __ubuf__ T *sumSqOutPtr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> xReg, xSqReg, sumChunkReg, sumSqChunkReg;
    AscendC::Reg::RegTensor<T> sumAccReg, sumSqAccReg;

    uint32_t one = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<T>(one);
    AscendC::Reg::Duplicate<T, AscendC::Reg::MaskMergeMode::ZEROING>(
        sumAccReg, T(0), scalarMask);
    AscendC::Reg::Duplicate<T, AscendC::Reg::MaskMergeMode::ZEROING>(
        sumSqAccReg, T(0), scalarMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * chunkLanes;
        uint32_t remaining = (elementCount > offset) ? (elementCount - offset) : 0;
        if (remaining == 0) break;
        uint32_t lanesThisChunk = (remaining > chunkLanes) ? chunkLanes : remaining;
        AscendC::Reg::MaskReg laneMask = AscendC::Reg::UpdateMask<T>(lanesThisChunk);

        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xPtr + offset);
        AscendC::Reg::Mul<T, AscendC::Reg::MaskMergeMode::ZEROING>(
            xSqReg, xReg, xReg, laneMask);
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM, T, T,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumChunkReg, xReg, laneMask);
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM, T, T,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumSqChunkReg, xSqReg, laneMask);
        AscendC::Reg::Add<T, AscendC::Reg::MaskMergeMode::ZEROING>(
            sumAccReg, sumAccReg, sumChunkReg, scalarMask);
        AscendC::Reg::Add<T, AscendC::Reg::MaskMergeMode::ZEROING>(
            sumSqAccReg, sumSqAccReg, sumSqChunkReg, scalarMask);
    }

    if constexpr (sizeof(T) == 4) {
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumOutPtr,   sumAccReg,   scalarMask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumSqOutPtr, sumSqAccReg, scalarMask);
    } else {
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
            sumOutPtr,   sumAccReg,   scalarMask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
            sumSqOutPtr, sumSqAccReg, scalarMask);
    }
}

// Layer 2: __aicore__ wrapper.
template <typename T>
__aicore__ inline void BatchMomentsChunkReduce(
    AscendC::LocalTensor<T> &xUbufLT,
    AscendC::LocalTensor<T> &sumScratchLT,
    AscendC::LocalTensor<T> &sumSqScratchLT,
    int64_t HxW)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    __ubuf__ T *xPtr     = (__ubuf__ T *)xUbufLT.GetPhyAddr();
    __ubuf__ T *sumPtr   = (__ubuf__ T *)sumScratchLT.GetPhyAddr();
    __ubuf__ T *sumSqPtr = (__ubuf__ T *)sumSqScratchLT.GetPhyAddr();
    uint32_t elementCount = static_cast<uint32_t>(HxW);
    uint32_t chunkCount   = (elementCount + chunkLanes - 1) / chunkLanes;
    asc_vf_call<BatchMomentsRowVf<T>>(
        xPtr, sumPtr, sumSqPtr, elementCount, chunkCount);
}

// Layer 3: kernel class. Per-channel outer loop over N, scalar accumulator,
// per-core staging then single DMA out.
template <typename T>
class KernelC2BatchMoments {
public:
    __aicore__ inline KernelC2BatchMoments() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR mu, GM_ADDR var,
        int64_t N, int64_t C, int64_t HxW, int64_t blockLength)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        muGm_.SetGlobalBuffer((__gm__ T *)mu);
        varGm_.SetGlobalBuffer((__gm__ T *)var);

        N_ = N;
        C_ = C;
        HxW_ = HxW;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myValidLength = C - blockStart;
        if (myValidLength > blockLength) myValidLength = blockLength;
        if (myValidLength < 0) myValidLength = 0;
        blockStart_ = blockStart;
        blockLength_ = blockLength;
        myValidLength_ = myValidLength;

        const uint32_t rowBytes = static_cast<uint32_t>(HxW * sizeof(T));
        const uint32_t outBytes = static_cast<uint32_t>(blockLength * sizeof(T));
        constexpr uint32_t SCALAR_SLOT_BYTES = 32u;

        pipe_.InitBuffer(inQueueX_,    PIPELINE_DEPTH, rowBytes);
        pipe_.InitBuffer(outQueueMu_,  1u, outBytes);
        pipe_.InitBuffer(outQueueVar_, 1u, outBytes);
        pipe_.InitBuffer(tbufSum_,     SCALAR_SLOT_BYTES);
        pipe_.InitBuffer(tbufSumSq_,   SCALAR_SLOT_BYTES);
    }

    __aicore__ inline void Process()
    {
        // Allocate per-core mu/var staging buffers (size blockLength T each).
        AscendC::LocalTensor<T> muBuf  = outQueueMu_.template AllocTensor<T>();
        AscendC::LocalTensor<T> varBuf = outQueueVar_.template AllocTensor<T>();

        // Pre-zero the staging buffers so the trailing padding lanes
        // (blockLength - myValidLength_) write zero to GM (which is itself
        // zero-initialised over the padded region).
        for (int64_t i = 0; i < blockLength_; ++i) {
            muBuf .SetValue(static_cast<int32_t>(i), T(0));
            varBuf.SetValue(static_cast<int32_t>(i), T(0));
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        if (myValidLength_ > 0 && N_ > 0 && HxW_ > 0) {
            const float invNHxW = 1.0f / static_cast<float>(N_ * HxW_);

            for (int64_t cIdx = 0; cIdx < myValidLength_; ++cIdx) {
                int64_t c = blockStart_ + cIdx;
                float totalSum   = 0.0f;
                float totalSumSq = 0.0f;

                for (int64_t n = 0; n < N_; ++n) {
                    AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
                    {
                        AscendC::DataCopyExtParams params;
                        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
                        params.blockCount = 1;
                        params.blockLen = static_cast<uint32_t>(HxW_ * sizeof(T));
                        params.srcStride = 0;
                        params.dstStride = 0;
                        AscendC::DataCopyPad(xLocal,
                            xGm_[(n * C_ + c) * HxW_], params, padParams);
                    }
                    inQueueX_.EnQue(xLocal);
                    xLocal = inQueueX_.template DeQue<T>();

                    for (int64_t hw = 0; hw < HxW_; ++hw) {
                        float v = static_cast<float>(xLocal.GetValue(static_cast<int32_t>(hw)));
                        totalSum += v;
                        totalSumSq += v * v;
                    }

                    inQueueX_.FreeTensor(xLocal);
                }

                muBuf .SetValue(static_cast<int32_t>(cIdx), static_cast<T>(totalSum   * invNHxW));
                varBuf.SetValue(static_cast<int32_t>(cIdx), static_cast<T>(totalSumSq * invNHxW));
            }
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        // Single DMA out for the whole per-core segment.
        outQueueMu_ .EnQue(muBuf);  muBuf  = outQueueMu_ .template DeQue<T>();
        outQueueVar_.EnQue(varBuf); varBuf = outQueueVar_.template DeQue<T>();
        {
            AscendC::DataCopyExtParams params;
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(blockLength_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(muGm_[blockStart_],  muBuf,  params);
            AscendC::DataCopyPad(varGm_[blockStart_], varBuf, params);
        }
        outQueueMu_ .FreeTensor(muBuf);
        outQueueVar_.FreeTensor(varBuf);
    }

private:
    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> muGm_;
    AscendC::GlobalTensor<T> varGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueMu_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueVar_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSumSq_;
    int64_t N_ = 0;
    int64_t C_ = 0;
    int64_t HxW_ = 0;
    int64_t blockStart_ = 0;
    int64_t blockLength_ = 0;
    int64_t myValidLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_batch_moments_kernel(
    GM_ADDR x, GM_ADDR mu, GM_ADDR var,
    int64_t N, int64_t C, int64_t HxW, int64_t blockLength)
{
    KernelC2BatchMoments<T> op;
    op.Init(x, mu, var, N, C, HxW, blockLength);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

std::tuple<torch::Tensor, torch::Tensor> c2_batch_moments_npu(
    const torch::Tensor &X)
{
    auto dtype = X.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 || dtype == torch::kFloat16,
                "c2_batch_moments: X dtype must be float32 or float16, got ",
                dtype, ". bf16 and int types are deferred on this platform.");
    TORCH_CHECK(X.dim() >= 2,
                "c2_batch_moments: X must have at least 2 dims (got ndim=",
                X.dim(), ")");

    const c10::OptionalDeviceGuard guard(X.device());
    auto X_contig = X.contiguous();

    int64_t N = X_contig.size(0);
    int64_t C = X_contig.size(1);
    int64_t numel = X_contig.numel();

    auto mu  = torch::zeros({C}, X_contig.options());
    auto var = torch::zeros({C}, X_contig.options());

    if (numel == 0 || N == 0 || C == 0) {
        return std::make_tuple(mu, var);
    }
    int64_t NC = N * C;
    int64_t HxW = numel / NC;
    if (HxW == 0) {
        return std::make_tuple(mu, var);
    }

    const size_t bytesPerT = (dtype == torch::kFloat16) ? 2u : 4u;
    int64_t numBlocks, blockLength, paddedC;
    std::tie(numBlocks, blockLength, paddedC) = calc_tiling_params(C, HxW, bytesPerT);

    // mu / var GM is over-allocated to paddedC zero-initialised tensors so each
    // per-core DMA out (blockLength T) lands on aligned, non-overlapping slots.
    auto mu_padded  = (paddedC == C) ? mu  : torch::zeros({paddedC}, X_contig.options());
    auto var_padded = (paddedC == C) ? var : torch::zeros({paddedC}, X_contig.options());

    auto stream  = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr   = (GM_ADDR)X_contig.data_ptr();
    auto mu_ptr  = (GM_ADDR)mu_padded.data_ptr();
    auto var_ptr = (GM_ADDR)var_padded.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            X_contig.scalar_type(), "c2_batch_moments_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_batch_moments_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, mu_ptr, var_ptr, N, C, HxW, blockLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_batch_moments_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, mu_ptr, var_ptr, N, C, HxW, blockLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2BatchMoments", acl_call);

    if (paddedC != C) {
        // Slice off the padding lanes; the trailing blockLength * numBlocks - C
        // elements held zero scratch.
        mu  = mu_padded .index({torch::indexing::Slice(0, C)}).contiguous();
        var = var_padded.index({torch::indexing::Slice(0, C)}).contiguous();
    }
    return std::make_tuple(mu, var);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_batch_moments", c2_batch_moments_npu);
}

} // namespace C2BatchMoments
} // namespace ops_multimodal_fusion
