/*!
 * \file spherical_bessel_j0.asc
 * \brief RegBase-form spherical_bessel_j0 for Ascend NPU (dav-3510)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <tuple>

namespace ops_multimodal_fusion {
namespace SphericalBesselJ0 {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;
constexpr int64_t TOTAL_TILE_BUFFERS = 7;

__simd_vf__ inline void SphericalBesselJ0RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    constexpr float INV_PI = 0.31830988618379067154f;
    constexpr float PI = 3.14159265358979323846f;
    constexpr float ROUND_MAGIC = 12582912.0f;

    AscendC::Reg::RegTensor<float> xReg, absReg, outReg, tmpReg;
    AscendC::Reg::RegTensor<float> tReg, polyReg, kReg, rReg, signReg, halfKReg, safeXReg;
    const float infValue = INFINITY;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg branchMask;
        AscendC::Reg::MaskReg infMask;
        AscendC::Reg::MaskReg nanMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::Abs(absReg, xReg, mask);

        AscendC::Reg::Mul(tReg, xReg, xReg, mask);
        AscendC::Reg::Duplicate<float>(polyReg, 1.0f / 6227020800.0f, mask);
        AscendC::Reg::Mul(polyReg, polyReg, tReg, mask);
        AscendC::Reg::Adds(polyReg, polyReg, -1.0f / 39916800.0f, mask);
        AscendC::Reg::Mul(polyReg, polyReg, tReg, mask);
        AscendC::Reg::Adds(polyReg, polyReg, 1.0f / 362880.0f, mask);
        AscendC::Reg::Mul(polyReg, polyReg, tReg, mask);
        AscendC::Reg::Adds(polyReg, polyReg, -1.0f / 5040.0f, mask);
        AscendC::Reg::Mul(polyReg, polyReg, tReg, mask);
        AscendC::Reg::Adds(polyReg, polyReg, 1.0f / 120.0f, mask);
        AscendC::Reg::Mul(polyReg, polyReg, tReg, mask);
        AscendC::Reg::Adds(polyReg, polyReg, -1.0f / 6.0f, mask);
        AscendC::Reg::Mul(polyReg, polyReg, tReg, mask);
        AscendC::Reg::Adds(polyReg, polyReg, 1.0f, mask);

        safeXReg = xReg;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(branchMask, absReg, 0.5f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, 1.0f, mask);
        AscendC::Reg::Select<float>(safeXReg, tmpReg, safeXReg, branchMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(infMask, absReg, infValue, mask);
        AscendC::Reg::Select<float>(safeXReg, tmpReg, safeXReg, infMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(safeXReg, tmpReg, safeXReg, nanMask);

        AscendC::Reg::Muls(kReg, safeXReg, INV_PI, mask);
        AscendC::Reg::Adds(kReg, kReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(kReg, kReg, -ROUND_MAGIC, mask);

        AscendC::Reg::Muls(tmpReg, kReg, PI, mask);
        AscendC::Reg::Sub(rReg, safeXReg, tmpReg, mask);

        AscendC::Reg::Muls(halfKReg, kReg, 0.5f, mask);
        AscendC::Reg::Adds(halfKReg, halfKReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(halfKReg, halfKReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(halfKReg, halfKReg, 2.0f, mask);
        AscendC::Reg::Sub(signReg, kReg, halfKReg, mask);
        AscendC::Reg::Abs(signReg, signReg, mask);
        AscendC::Reg::Muls(signReg, signReg, -2.0f, mask);
        AscendC::Reg::Adds(signReg, signReg, 1.0f, mask);

        AscendC::Reg::Mul(tReg, rReg, rReg, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, 1.0f / 362880.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, tReg, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -1.0f / 5040.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, tReg, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, 1.0f / 120.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, tReg, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -1.0f / 6.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, tReg, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, 1.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, rReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, signReg, mask);
        AscendC::Reg::Div(outReg, tmpReg, safeXReg, mask);

        AscendC::Reg::Select<float>(outReg, polyReg, outReg, branchMask);

        AscendC::Reg::Duplicate<float>(tmpReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, infMask);

        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void SphericalBesselJ0Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<SphericalBesselJ0RegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("spherical_bessel_j0(Tensor x) -> Tensor");
}

torch::Tensor spherical_bessel_j0_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "spherical_bessel_j0 only supports float32");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("spherical_bessel_j0", spherical_bessel_j0_meta);
}

std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / TOTAL_TILE_BUFFERS / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) {
        tileBytes = BLOCK_BYTES;
    }
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) {
        tileElems = 8;
    }
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

class KernelSphericalBesselJ0 {
public:
    __aicore__ inline KernelSphericalBesselJ0() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockIdx * blockLength);

        int64_t tileBytes = ((tileLength_ * static_cast<int64_t>(sizeof(float)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(inQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
        pipe_.InitBuffer(tmp0_, tileBytes);
        pipe_.InitBuffer(tmp1_, tileBytes);
        pipe_.InitBuffer(tmp2_, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto inLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(inLocal, xGm_[offset], p, pad);
        inQueue_.EnQue(inLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto inLocal = inQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        SphericalBesselJ0Reg(outLocal, inLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp0_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp2_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

__global__ __aicore__ __vector__ void spherical_bessel_j0_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelSphericalBesselJ0 op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

torch::Tensor spherical_bessel_j0_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "spherical_bessel_j0 only supports float32");

    auto input = x.contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) = calc_tiling_params(totalLength, input.element_size());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        spherical_bessel_j0_kernel<<<numBlocks, nullptr, stream>>>(xPtr, yPtr, totalLength, blockLength, tileLength);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("SphericalBesselJ0", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("spherical_bessel_j0", spherical_bessel_j0_npu);
}

} // namespace SphericalBesselJ0
} // namespace ops_multimodal_fusion
