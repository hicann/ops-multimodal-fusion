/*!
 * \file bessel_y1.asc
 * \brief RegBase-form bessel_y1 for Ascend NPU (dav-3510)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <tuple>

namespace ops_multimodal_fusion {
namespace BesselY1 {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;
constexpr int64_t TOTAL_TILE_BUFFERS = 6;
constexpr float PI = 3.14159265358979323846f;
constexpr float INV_PI = 0.31830988618379067154f;
constexpr float ROUND_MAGIC = 12582912.0f;
constexpr float BESSEL_PHASE = 2.356194490192344928846982537459627163f;
constexpr float BESSEL_SCALE = 0.797884560802865355879892119868763737f;
constexpr float BESSEL_LOG_SCALE = 0.636619772367581343075535053490057448f;

#define BESSEL_J1_SMALL_RP_STEP(COEFF)                           \
    AscendC::Reg::Mul(rpReg, rpReg, x2Reg, mask);               \
    AscendC::Reg::Adds(rpReg, rpReg, COEFF, mask);

#define BESSEL_J1_SMALL_RQ_STEP(COEFF)                           \
    AscendC::Reg::Mul(rqReg, rqReg, x2Reg, mask);               \
    AscendC::Reg::Adds(rqReg, rqReg, COEFF, mask);

#define BESSEL_J1_LARGE_PP_STEP(COEFF)                           \
    AscendC::Reg::Mul(ppReg, ppReg, invX2Reg, mask);            \
    AscendC::Reg::Adds(ppReg, ppReg, COEFF, mask);

#define BESSEL_J1_LARGE_PQ_STEP(COEFF)                           \
    AscendC::Reg::Mul(pqReg, pqReg, invX2Reg, mask);            \
    AscendC::Reg::Adds(pqReg, pqReg, COEFF, mask);

#define BESSEL_J1_LARGE_QP_STEP(COEFF)                           \
    AscendC::Reg::Mul(qpReg, qpReg, invX2Reg, mask);            \
    AscendC::Reg::Adds(qpReg, qpReg, COEFF, mask);

#define BESSEL_J1_LARGE_QQ_STEP(COEFF)                           \
    AscendC::Reg::Mul(qqReg, qqReg, invX2Reg, mask);            \
    AscendC::Reg::Adds(qqReg, qqReg, COEFF, mask);

#define BESSEL_Y1_SMALL_YP_STEP(COEFF)                           \
    AscendC::Reg::Mul(ypReg, ypReg, x2Reg, mask);               \
    AscendC::Reg::Adds(ypReg, ypReg, COEFF, mask);

#define BESSEL_Y1_SMALL_YQ_STEP(COEFF)                           \
    AscendC::Reg::Mul(yqReg, yqReg, x2Reg, mask);               \
    AscendC::Reg::Adds(yqReg, yqReg, COEFF, mask);

#define BESSEL_Y1_LARGE_PP_STEP(COEFF) BESSEL_J1_LARGE_PP_STEP(COEFF)
#define BESSEL_Y1_LARGE_PQ_STEP(COEFF) BESSEL_J1_LARGE_PQ_STEP(COEFF)
#define BESSEL_Y1_LARGE_QP_STEP(COEFF) BESSEL_J1_LARGE_QP_STEP(COEFF)
#define BESSEL_Y1_LARGE_QQ_STEP(COEFF) BESSEL_J1_LARGE_QQ_STEP(COEFF)

#define BESSEL_TRIG_SIN_STEP(COEFF)                              \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, trigArg2Reg, mask); \
    AscendC::Reg::Adds(sinPolyReg, sinPolyReg, COEFF, mask);

#define BESSEL_TRIG_COS_STEP(COEFF)                              \
    AscendC::Reg::Mul(cosPolyReg, cosPolyReg, trigArg2Reg, mask); \
    AscendC::Reg::Adds(cosPolyReg, cosPolyReg, COEFF, mask);

__simd_vf__ inline void BesselJ1RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    const float infValue = INFINITY;

    AscendC::Reg::RegTensor<float> xReg, absXReg, x2Reg, outReg, tmpReg;
    AscendC::Reg::RegTensor<float> rpReg, rqReg, ppReg, pqReg, qpReg, qqReg;
    AscendC::Reg::RegTensor<float> ratioPReg, ratioQReg, sinReg, cosReg, phaseReg, invXReg, invX2Reg, sqrtReg;
    AscendC::Reg::RegTensor<float> smallReg, largeReg, termReg, signReg, reduceKReg, trigArg2Reg, quadrantSignReg;
    AscendC::Reg::RegTensor<float> sinPolyReg, cosPolyReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg negMask;
        AscendC::Reg::MaskReg smallMask;
        AscendC::Reg::MaskReg zeroMask;
        AscendC::Reg::MaskReg infMask;
        AscendC::Reg::MaskReg nanMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::Abs(absXReg, xReg, mask);
        AscendC::Reg::Mul(x2Reg, absXReg, absXReg, mask);

        AscendC::Reg::Duplicate<float>(rpReg, -8.99971225705559398224e+08f, mask);
        BESSEL_J1_SMALL_RP_STEP(+4.52228297998194034323e+11f)
        BESSEL_J1_SMALL_RP_STEP(-7.27494245221818276015e+13f)
        BESSEL_J1_SMALL_RP_STEP(+3.68295732863852883286e+15f)

        AscendC::Reg::Duplicate<float>(rqReg, +6.20836478118054335476e+02f, mask);
        BESSEL_J1_SMALL_RQ_STEP(+2.56987256757748830383e+05f)
        BESSEL_J1_SMALL_RQ_STEP(+8.35146791431949253037e+07f)
        BESSEL_J1_SMALL_RQ_STEP(+2.21511595479792499675e+10f)
        BESSEL_J1_SMALL_RQ_STEP(+4.74914122079991414898e+12f)
        BESSEL_J1_SMALL_RQ_STEP(+7.84369607876235854894e+14f)
        BESSEL_J1_SMALL_RQ_STEP(+8.95222336184627338078e+16f)
        BESSEL_J1_SMALL_RQ_STEP(+5.32278620332680085395e+18f)

        AscendC::Reg::Div(ratioPReg, rpReg, rqReg, mask);
        AscendC::Reg::Mul(smallReg, ratioPReg, absXReg, mask);
        AscendC::Reg::Adds(tmpReg, x2Reg, -1.46819706421238932572e+01f, mask);
        AscendC::Reg::Mul(smallReg, smallReg, tmpReg, mask);
        AscendC::Reg::Adds(tmpReg, x2Reg, -4.92184563216946036703e+01f, mask);
        AscendC::Reg::Mul(smallReg, smallReg, tmpReg, mask);

        AscendC::Reg::Duplicate<float>(tmpReg, 5.0f, mask);
        AscendC::Reg::Div(invXReg, tmpReg, absXReg, mask);
        AscendC::Reg::Mul(invX2Reg, invXReg, invXReg, mask);

        AscendC::Reg::Duplicate<float>(ppReg, +7.62125616208173112003e-04f, mask);
        BESSEL_J1_LARGE_PP_STEP(+7.31397056940917570436e-02f)
        BESSEL_J1_LARGE_PP_STEP(+1.12719608129684925192e+00f)
        BESSEL_J1_LARGE_PP_STEP(+5.11207951146807644818e+00f)
        BESSEL_J1_LARGE_PP_STEP(+8.42404590141772420927e+00f)
        BESSEL_J1_LARGE_PP_STEP(+5.21451598682361504063e+00f)
        BESSEL_J1_LARGE_PP_STEP(+1.00000000000000000254e+00f)

        AscendC::Reg::Duplicate<float>(pqReg, +5.71323128072548699714e-04f, mask);
        BESSEL_J1_LARGE_PQ_STEP(+6.88455908754495404082e-02f)
        BESSEL_J1_LARGE_PQ_STEP(+1.10514232634061696926e+00f)
        BESSEL_J1_LARGE_PQ_STEP(+5.07386386128601488557e+00f)
        BESSEL_J1_LARGE_PQ_STEP(+8.39985554327604159757e+00f)
        BESSEL_J1_LARGE_PQ_STEP(+5.20982848682361821619e+00f)
        BESSEL_J1_LARGE_PQ_STEP(+9.99999999999999997461e-01f)

        AscendC::Reg::Duplicate<float>(qpReg, +5.10862594750176621635e-02f, mask);
        BESSEL_J1_LARGE_QP_STEP(+4.98213872951233449420e+00f)
        BESSEL_J1_LARGE_QP_STEP(+7.58238284132545283818e+01f)
        BESSEL_J1_LARGE_QP_STEP(+3.66779609360150777800e+02f)
        BESSEL_J1_LARGE_QP_STEP(+7.10856304998926107277e+02f)
        BESSEL_J1_LARGE_QP_STEP(+5.97489612400613639965e+02f)
        BESSEL_J1_LARGE_QP_STEP(+2.11688757100572135698e+02f)
        BESSEL_J1_LARGE_QP_STEP(+2.52070205858023719784e+01f)

        AscendC::Reg::Duplicate<float>(qqReg, +7.42373277035675149943e+01f, mask);
        BESSEL_J1_LARGE_QQ_STEP(+1.05644886038262816351e+03f)
        BESSEL_J1_LARGE_QQ_STEP(+4.98641058337653607651e+03f)
        BESSEL_J1_LARGE_QQ_STEP(+9.56231892404756170795e+03f)
        BESSEL_J1_LARGE_QQ_STEP(+7.99704160447350683650e+03f)
        BESSEL_J1_LARGE_QQ_STEP(+2.82619278517639096600e+03f)
        BESSEL_J1_LARGE_QQ_STEP(+3.36093607810698293419e+02f)

        AscendC::Reg::Div(ratioPReg, ppReg, pqReg, mask);
        AscendC::Reg::Div(ratioQReg, qpReg, qqReg, mask);
        AscendC::Reg::Adds(phaseReg, absXReg, -BESSEL_PHASE, mask);
        AscendC::Reg::Muls(reduceKReg, phaseReg, INV_PI, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, PI, mask);
        AscendC::Reg::Sub(phaseReg, phaseReg, tmpReg, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, 0.5f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 2.0f, mask);
        AscendC::Reg::Sub(quadrantSignReg, reduceKReg, tmpReg, mask);
        AscendC::Reg::Abs(quadrantSignReg, quadrantSignReg, mask);
        AscendC::Reg::Muls(quadrantSignReg, quadrantSignReg, -2.0f, mask);
        AscendC::Reg::Adds(quadrantSignReg, quadrantSignReg, 1.0f, mask);
        AscendC::Reg::Mul(trigArg2Reg, phaseReg, phaseReg, mask);
        AscendC::Reg::Duplicate<float>(sinPolyReg, -1.0f / 39916800.0f, mask);
        BESSEL_TRIG_SIN_STEP(1.0f / 362880.0f)
        BESSEL_TRIG_SIN_STEP(-1.0f / 5040.0f)
        BESSEL_TRIG_SIN_STEP(1.0f / 120.0f)
        BESSEL_TRIG_SIN_STEP(-1.0f / 6.0f)
        BESSEL_TRIG_SIN_STEP(1.0f)
        AscendC::Reg::Mul(sinReg, sinPolyReg, phaseReg, mask);
        AscendC::Reg::Mul(sinReg, sinReg, quadrantSignReg, mask);
        AscendC::Reg::Duplicate<float>(cosPolyReg, -1.0f / 3628800.0f, mask);
        BESSEL_TRIG_COS_STEP(1.0f / 40320.0f)
        BESSEL_TRIG_COS_STEP(-1.0f / 720.0f)
        BESSEL_TRIG_COS_STEP(1.0f / 24.0f)
        BESSEL_TRIG_COS_STEP(-1.0f / 2.0f)
        BESSEL_TRIG_COS_STEP(1.0f)
        AscendC::Reg::Mul(cosReg, cosPolyReg, quadrantSignReg, mask);
        AscendC::Reg::Mul(largeReg, ratioPReg, cosReg, mask);
        AscendC::Reg::Mul(termReg, invXReg, ratioQReg, mask);
        AscendC::Reg::Mul(termReg, termReg, sinReg, mask);
        AscendC::Reg::Sub(largeReg, largeReg, termReg, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, BESSEL_SCALE, mask);
        AscendC::Reg::Mul(largeReg, largeReg, tmpReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, absXReg, mask);
        AscendC::Reg::Div(largeReg, largeReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(smallMask, absXReg, 5.0f, mask);
        AscendC::Reg::Select<float>(outReg, smallReg, largeReg, smallMask);

        AscendC::Reg::Duplicate<float>(signReg, 1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(negMask, xReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, -1.0f, mask);
        AscendC::Reg::Select<float>(signReg, tmpReg, signReg, negMask);
        AscendC::Reg::Mul(outReg, outReg, signReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(zeroMask, xReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, zeroMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(infMask, absXReg, infValue, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, infMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void BesselJ1Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BesselJ1RegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void BesselY1RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, __ubuf__ float *j1Addr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    const float infValue = INFINITY;
    const float negInfValue = -INFINITY;
    const float nanValue = NAN;

    AscendC::Reg::RegTensor<float> xReg, j1Reg, x2Reg, outReg, tmpReg;
    AscendC::Reg::RegTensor<float> ypReg, yqReg, ppReg, pqReg, qpReg, qqReg;
    AscendC::Reg::RegTensor<float> ratioPReg, ratioQReg, sinReg, cosReg, phaseReg, invXReg, invX2Reg, sqrtReg;
    AscendC::Reg::RegTensor<float> smallReg, largeReg, termReg, logReg, oneReg, negInfReg, nanReg;
    AscendC::Reg::RegTensor<float> reduceKReg, trigArg2Reg, quadrantSignReg, sinPolyReg, cosPolyReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg smallMask;
        AscendC::Reg::MaskReg zeroMask;
        AscendC::Reg::MaskReg leZeroMask;
        AscendC::Reg::MaskReg posInfMask;
        AscendC::Reg::MaskReg nanMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(j1Reg, j1Addr + offset);
        AscendC::Reg::Mul(x2Reg, xReg, xReg, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(negInfReg, negInfValue, mask);
        AscendC::Reg::Duplicate<float>(nanReg, nanValue, mask);

        AscendC::Reg::Duplicate<float>(ypReg, +1.26320474790178026440e+09f, mask);
        BESSEL_Y1_SMALL_YP_STEP(-6.47355876379160291031e+11f)
        BESSEL_Y1_SMALL_YP_STEP(+1.14509511541823727583e+14f)
        BESSEL_Y1_SMALL_YP_STEP(-8.12770255501325109621e+15f)
        BESSEL_Y1_SMALL_YP_STEP(+2.02439475713594898196e+17f)
        BESSEL_Y1_SMALL_YP_STEP(-7.78877196265950026825e+17f)

        AscendC::Reg::Duplicate<float>(yqReg, +5.94301592346128195359e+02f, mask);
        BESSEL_Y1_SMALL_YQ_STEP(+2.35564092943068577943e+05f)
        BESSEL_Y1_SMALL_YQ_STEP(+7.34811944459721705660e+07f)
        BESSEL_Y1_SMALL_YQ_STEP(+1.87601316108706159478e+10f)
        BESSEL_Y1_SMALL_YQ_STEP(+3.88231277496238566008e+12f)
        BESSEL_Y1_SMALL_YQ_STEP(+6.20557727146953693363e+14f)
        BESSEL_Y1_SMALL_YQ_STEP(+6.87141087355300489866e+16f)
        BESSEL_Y1_SMALL_YQ_STEP(+3.97270608116560655612e+18f)

        AscendC::Reg::Div(ratioPReg, ypReg, yqReg, mask);
        AscendC::Reg::Mul(smallReg, xReg, ratioPReg, mask);
        AscendC::Reg::Ln(logReg, xReg, mask);
        AscendC::Reg::Mul(tmpReg, j1Reg, logReg, mask);
        AscendC::Reg::Div(termReg, oneReg, xReg, mask);
        AscendC::Reg::Sub(tmpReg, tmpReg, termReg, mask);
        AscendC::Reg::Duplicate<float>(termReg, BESSEL_LOG_SCALE, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, termReg, mask);
        AscendC::Reg::Add(smallReg, smallReg, tmpReg, mask);

        AscendC::Reg::Duplicate<float>(tmpReg, 5.0f, mask);
        AscendC::Reg::Div(invXReg, tmpReg, xReg, mask);
        AscendC::Reg::Mul(invX2Reg, invXReg, invXReg, mask);

        AscendC::Reg::Duplicate<float>(ppReg, +7.62125616208173112003e-04f, mask);
        BESSEL_Y1_LARGE_PP_STEP(+7.31397056940917570436e-02f)
        BESSEL_Y1_LARGE_PP_STEP(+1.12719608129684925192e+00f)
        BESSEL_Y1_LARGE_PP_STEP(+5.11207951146807644818e+00f)
        BESSEL_Y1_LARGE_PP_STEP(+8.42404590141772420927e+00f)
        BESSEL_Y1_LARGE_PP_STEP(+5.21451598682361504063e+00f)
        BESSEL_Y1_LARGE_PP_STEP(+1.00000000000000000254e+00f)

        AscendC::Reg::Duplicate<float>(pqReg, +5.71323128072548699714e-04f, mask);
        BESSEL_Y1_LARGE_PQ_STEP(+6.88455908754495404082e-02f)
        BESSEL_Y1_LARGE_PQ_STEP(+1.10514232634061696926e+00f)
        BESSEL_Y1_LARGE_PQ_STEP(+5.07386386128601488557e+00f)
        BESSEL_Y1_LARGE_PQ_STEP(+8.39985554327604159757e+00f)
        BESSEL_Y1_LARGE_PQ_STEP(+5.20982848682361821619e+00f)
        BESSEL_Y1_LARGE_PQ_STEP(+9.99999999999999997461e-01f)

        AscendC::Reg::Duplicate<float>(qpReg, +5.10862594750176621635e-02f, mask);
        BESSEL_Y1_LARGE_QP_STEP(+4.98213872951233449420e+00f)
        BESSEL_Y1_LARGE_QP_STEP(+7.58238284132545283818e+01f)
        BESSEL_Y1_LARGE_QP_STEP(+3.66779609360150777800e+02f)
        BESSEL_Y1_LARGE_QP_STEP(+7.10856304998926107277e+02f)
        BESSEL_Y1_LARGE_QP_STEP(+5.97489612400613639965e+02f)
        BESSEL_Y1_LARGE_QP_STEP(+2.11688757100572135698e+02f)
        BESSEL_Y1_LARGE_QP_STEP(+2.52070205858023719784e+01f)

        AscendC::Reg::Duplicate<float>(qqReg, +7.42373277035675149943e+01f, mask);
        BESSEL_Y1_LARGE_QQ_STEP(+1.05644886038262816351e+03f)
        BESSEL_Y1_LARGE_QQ_STEP(+4.98641058337653607651e+03f)
        BESSEL_Y1_LARGE_QQ_STEP(+9.56231892404756170795e+03f)
        BESSEL_Y1_LARGE_QQ_STEP(+7.99704160447350683650e+03f)
        BESSEL_Y1_LARGE_QQ_STEP(+2.82619278517639096600e+03f)
        BESSEL_Y1_LARGE_QQ_STEP(+3.36093607810698293419e+02f)

        AscendC::Reg::Div(ratioPReg, ppReg, pqReg, mask);
        AscendC::Reg::Div(ratioQReg, qpReg, qqReg, mask);
        AscendC::Reg::Adds(phaseReg, xReg, -BESSEL_PHASE, mask);
        AscendC::Reg::Muls(reduceKReg, phaseReg, INV_PI, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, PI, mask);
        AscendC::Reg::Sub(phaseReg, phaseReg, tmpReg, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, 0.5f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 2.0f, mask);
        AscendC::Reg::Sub(quadrantSignReg, reduceKReg, tmpReg, mask);
        AscendC::Reg::Abs(quadrantSignReg, quadrantSignReg, mask);
        AscendC::Reg::Muls(quadrantSignReg, quadrantSignReg, -2.0f, mask);
        AscendC::Reg::Adds(quadrantSignReg, quadrantSignReg, 1.0f, mask);
        AscendC::Reg::Mul(trigArg2Reg, phaseReg, phaseReg, mask);
        AscendC::Reg::Duplicate<float>(sinPolyReg, -1.0f / 39916800.0f, mask);
        BESSEL_TRIG_SIN_STEP(1.0f / 362880.0f)
        BESSEL_TRIG_SIN_STEP(-1.0f / 5040.0f)
        BESSEL_TRIG_SIN_STEP(1.0f / 120.0f)
        BESSEL_TRIG_SIN_STEP(-1.0f / 6.0f)
        BESSEL_TRIG_SIN_STEP(1.0f)
        AscendC::Reg::Mul(sinReg, sinPolyReg, phaseReg, mask);
        AscendC::Reg::Mul(sinReg, sinReg, quadrantSignReg, mask);
        AscendC::Reg::Duplicate<float>(cosPolyReg, -1.0f / 3628800.0f, mask);
        BESSEL_TRIG_COS_STEP(1.0f / 40320.0f)
        BESSEL_TRIG_COS_STEP(-1.0f / 720.0f)
        BESSEL_TRIG_COS_STEP(1.0f / 24.0f)
        BESSEL_TRIG_COS_STEP(-1.0f / 2.0f)
        BESSEL_TRIG_COS_STEP(1.0f)
        AscendC::Reg::Mul(cosReg, cosPolyReg, quadrantSignReg, mask);
        AscendC::Reg::Mul(largeReg, ratioPReg, sinReg, mask);
        AscendC::Reg::Mul(termReg, invXReg, ratioQReg, mask);
        AscendC::Reg::Mul(termReg, termReg, cosReg, mask);
        AscendC::Reg::Add(largeReg, largeReg, termReg, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, BESSEL_SCALE, mask);
        AscendC::Reg::Mul(largeReg, largeReg, tmpReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, xReg, mask);
        AscendC::Reg::Div(largeReg, largeReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(smallMask, xReg, 5.0f, mask);
        AscendC::Reg::Select<float>(outReg, smallReg, largeReg, smallMask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(leZeroMask, xReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, nanReg, outReg, leZeroMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(zeroMask, xReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, negInfReg, outReg, zeroMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(posInfMask, xReg, infValue, mask);
        AscendC::Reg::Select<float>(outReg, nanReg, outReg, posInfMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void BesselY1Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src,
    const AscendC::LocalTensor<float> &j1, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    __ubuf__ float *j1Addr = (__ubuf__ float *)j1.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BesselY1RegVf>(dstAddr, srcAddr, j1Addr, elementCount, chunkCount);
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("bessel_y1(Tensor x) -> Tensor");
}

torch::Tensor bessel_y1_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "bessel_y1 only supports float32");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("bessel_y1", bessel_y1_meta);
}

std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / TOTAL_TILE_BUFFERS / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) {
        tileBytes = BLOCK_BYTES;
    }
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) {
        tileElems = 8;
    }
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

class KernelBesselY1 {
public:
    __aicore__ inline KernelBesselY1() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockIdx * blockLength);

        int64_t tileBytes =
            ((tileLength_ * static_cast<int64_t>(sizeof(float)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(inQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
        pipe_.InitBuffer(tmp0_, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto inLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(inLocal, xGm_[offset], p, pad);
        inQueue_.EnQue(inLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto inLocal = inQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        auto j1Local = tmp0_.Get<float>();
        BesselJ1Reg(j1Local, inLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        BesselY1Reg(outLocal, inLocal, j1Local, count);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp0_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

__global__ __aicore__ __vector__ void bessel_y1_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelBesselY1 op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

torch::Tensor bessel_y1_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "bessel_y1 only supports float32");

    auto input = x.contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) = calc_tiling_params(totalLength, input.element_size());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        bessel_y1_kernel<<<numBlocks, nullptr, stream>>>(xPtr, yPtr, totalLength, blockLength, tileLength);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("BesselY1", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("bessel_y1", bessel_y1_npu);
}

