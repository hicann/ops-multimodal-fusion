/*!
 * \file nested_add_pad.asc
 * \brief Nested-tensor add-padding operator for Ascend NPU (dav-3510),
 *        RegBase implementation (UB->UB whole-chunk copy for valid region,
 *        Reg::Duplicate fill for padding region).
 *
 * Schema:
 *   nested_add_pad(Tensor values, Tensor offsets, int max_L,
 *                  Scalar padding_value=0) -> Tensor
 *
 *   values        : 2-D (sum_L, D), contiguous, dtype in {fp32, fp16, int32}
 *   offsets       : 1-D (B+1,) int64; offsets[0]=0, offsets[B]=sum_L,
 *                   non-decreasing
 *   max_L         : int, must be >= max(L_i for i in [0, B))
 *   padding_value : scalar, converted to values dtype
 *   out           : 3-D (B, max_L, D), same dtype as values
 *
 *   For each batch i (L_i = offsets[i+1] - offsets[i]):
 *     out[i, 0:L_i, :]     = values[offsets[i] : offsets[i+1], :]
 *     out[i, L_i:max_L, :] = padding_value
 *
 *   Inverse of nested_remove_pad: compressed-format -> zero-padded dense.
 *   Equivalent to PyTorch _nested_tensor_to_padded_dense (2-D nested case).
 *
 * Constraint: D * sizeof(T) % 32 == 0  (DMA / Reg row 32B alignment;
 *   fp32 D%8, fp16 D%16, int32 D%8).
 *
 * 3-layer Reg shape:
 *   Layer 1 vf functions:
 *     NestedAddPadCopyVf<T>  : whole-chunk UB->UB copy (valid region)
 *                              modelled after csrc/nested_remove_pad/...
 *                              NestedRemovePadCopyVf
 *     NestedAddPadFillVf<T>  : Reg::Duplicate(padding_value) + StoreAlign
 *                              over padding region
 *   Layer 2 __aicore__ wrappers: GetPhyAddr cast + asc_vf_call
 *   Layer 3 kernel class:
 *     KernelNestedAddPad<T>  : per-batch
 *                                1. Reg vf fill outLocal padding region
 *                                2. DMA-in values[off_i : off_i+L_i, :]
 *                                3. Reg vf copy inLocal -> outLocal[0:L_i*D]
 *                                4. DMA-out outLocal -> padded[i, 0:max_L, :]
 *                              meta(B,2) driven per-batch [L_i, valuesOff_i]
 *                              via LocalTensor::GetValue.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace NestedAddPad {

constexpr static int64_t PIPELINE_DEPTH = 2;
constexpr static int64_t SAFETY_BYTES   = 1024;
constexpr static int64_t META_FIELDS    = 2;   // L_i, valuesOff_i (row offset)

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("nested_add_pad(Tensor values, Tensor offsets, int max_L, "
          "Scalar padding_value=0) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor nested_add_pad_meta(
    const torch::Tensor &values, const torch::Tensor &offsets,
    int64_t max_L, const c10::Scalar &padding_value)
{
    (void)padding_value;
    TORCH_CHECK(values.dim() == 2,
                "nested_add_pad: values must be 2-D (sum_L, D), got ",
                values.dim(), "-D");
    TORCH_CHECK(offsets.dim() == 1,
                "nested_add_pad: offsets must be 1-D, got ",
                offsets.dim(), "-D");
    TORCH_CHECK(offsets.size(0) >= 1,
                "nested_add_pad: offsets must have at least 1 element");
    TORCH_CHECK(offsets.scalar_type() == torch::kInt64,
                "nested_add_pad: offsets must be int64, got ",
                offsets.scalar_type());
    TORCH_CHECK(max_L >= 0,
                "nested_add_pad: max_L must be >= 0, got ", max_L);

    const int64_t B = offsets.size(0) - 1;
    const int64_t D = values.size(1);
    return torch::empty({B, max_L, D}, values.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("nested_add_pad", nested_add_pad_meta);
}

// ===================== 3. Kernel - 3-layer Reg shape =====================

// --------- Layer 1 vf functions ---------
//
// 1a. Whole-chunk UB->UB copy for valid region. Same pattern as
// csrc/nested_remove_pad/dav-3510 NestedRemovePadCopyVf<T>: LoadAlign source
// RegTensor, StoreAlign destination. Mask handles tail elements when
// elementCount is not a multiple of vectorLength.

template <typename T>
__simd_vf__ inline void NestedAddPadCopyVf(
    __ubuf__ T *srcAddr, __ubuf__ T *dstAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            reg, srcAddr + offset);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, reg, mask);
    }
}

// 1b. Whole-chunk Reg::Duplicate(padding_value) fill for padding region.
// scalar paddingValue is passed by value (runtime function parameter,
// host-context scalar -> register).

template <typename T>
__simd_vf__ inline void NestedAddPadFillVf(
    __ubuf__ T *dstAddr, T paddingValue,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> padReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::Duplicate<T>(padReg, paddingValue, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, padReg, mask);
    }
}

// --------- Layer 2 wrappers ---------

template <typename T>
__aicore__ inline void NestedAddPadCopy(
    AscendC::LocalTensor<T> &src, AscendC::LocalTensor<T> &dst,
    int64_t elementCount)
{
    __ubuf__ T *srcPtr = (__ubuf__ T *)src.GetPhyAddr();
    __ubuf__ T *dstPtr = (__ubuf__ T *)dst.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t elementCountU = static_cast<uint32_t>(elementCount);
    uint32_t chunkCount = (elementCountU + vectorLength - 1) / vectorLength;
    asc_vf_call<NestedAddPadCopyVf<T>>(srcPtr, dstPtr,
                                        elementCountU, chunkCount);
}

template <typename T>
__aicore__ inline void NestedAddPadFill(
    AscendC::LocalTensor<T> &dst, T paddingValue,
    int64_t elementOffset, int64_t elementCount)
{
    __ubuf__ T *dstPtr = (__ubuf__ T *)dst.GetPhyAddr() + elementOffset;
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t elementCountU = static_cast<uint32_t>(elementCount);
    uint32_t chunkCount = (elementCountU + vectorLength - 1) / vectorLength;
    asc_vf_call<NestedAddPadFillVf<T>>(dstPtr, paddingValue,
                                        elementCountU, chunkCount);
}

// --------- Layer 3 kernel class ---------

template <typename T>
class KernelNestedAddPad {
public:
    __aicore__ inline KernelNestedAddPad() {}

    __aicore__ inline void Init(
        GM_ADDR valuesPtr, GM_ADDR outputPtr, GM_ADDR metaPtr,
        int64_t batchSize, int64_t maxL, int64_t D,
        float paddingValueFp32,
        int64_t maxValidRows, int64_t blockBatchLength)
    {
        valuesGm_.SetGlobalBuffer((__gm__ T *)valuesPtr);
        outputGm_.SetGlobalBuffer((__gm__ T *)outputPtr);
        metaGm_.SetGlobalBuffer((__gm__ int64_t *)metaPtr);
        batchSize_       = batchSize;
        maxL_            = maxL;
        D_               = D;
        // Padding value carried as fp32 from host to avoid libgcc
        // __truncsfhf2 dependency in host context; device side bisheng
        // handles fp32 -> T cast natively.
        paddingValue_    = static_cast<T>(paddingValueFp32);

        int64_t blockStart = blockBatchLength * AscendC::GetBlockIdx();
        int64_t myLength = batchSize - blockStart;
        if (myLength > blockBatchLength) myLength = blockBatchLength;
        if (myLength < 0) myLength = 0;
        blockStart_ = blockStart;
        myLength_   = myLength;

        // inQueue chunk = max valid rows per batch (L_i * D);
        // outQueue chunk = max_L * D (always includes padding stage).
        const uint32_t inChunkBytes =
            static_cast<uint32_t>(maxValidRows * D * sizeof(T));
        const uint32_t outChunkBytes =
            static_cast<uint32_t>(maxL * D * sizeof(T));
        const uint32_t metaBytes =
            static_cast<uint32_t>(batchSize * META_FIELDS * sizeof(int64_t));

        pipe_.InitBuffer(tbufMeta_,      metaBytes);
        pipe_.InitBuffer(inQueueValues_, PIPELINE_DEPTH, inChunkBytes);
        pipe_.InitBuffer(outQueueOutput_, PIPELINE_DEPTH, outChunkBytes);
    }

    __aicore__ inline void Process()
    {
        if (myLength_ <= 0) return;
        if (maxL_ <= 0 || D_ <= 0) return;

        // 1. DMA meta into UB (small: B * 2 * 8 bytes).
        AscendC::LocalTensor<int64_t> metaLocal = tbufMeta_.template Get<int64_t>();
        AscendC::DataCopyExtParams cpMeta;
        cpMeta.blockCount = 1;
        cpMeta.blockLen   =
            static_cast<uint32_t>(batchSize_ * META_FIELDS * sizeof(int64_t));
        cpMeta.srcStride = 0; cpMeta.dstStride = 0;
        AscendC::DataCopyPadExtParams<int64_t> padI{false, 0, 0,
                                                    static_cast<int64_t>(0)};
        AscendC::DataCopyPad(metaLocal, metaGm_, cpMeta, padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyPadExtParams<T> padT{false, 0, 0, T{}};

        // 2. Per-batch: fill -> (optional copy) -> DMA-out.
        for (int64_t i = blockStart_; i < blockStart_ + myLength_; ++i) {
            const int64_t L_i      = metaLocal.GetValue(i * META_FIELDS + 0);
            const int64_t valOff_i = metaLocal.GetValue(i * META_FIELDS + 1);

            const int64_t validElems = L_i * D_;
            const int64_t fillElems  = (maxL_ - L_i) * D_;
            const int64_t totalElems = maxL_ * D_;
            const uint32_t totalBytes = static_cast<uint32_t>(totalElems * sizeof(T));

            // 2a. Allocate outLocal; fill padding region first (if any).
            AscendC::LocalTensor<T> outLocal =
                outQueueOutput_.template AllocTensor<T>();
            if (L_i < maxL_) {
                NestedAddPadFill<T>(outLocal, paddingValue_,
                                    validElems, fillElems);
                AscendC::PipeBarrier<PIPE_V>();
            }

            // 2b. DMA-in + Reg vf copy valid region (skip if L_i == 0).
            if (L_i > 0) {
                AscendC::LocalTensor<T> inLocal =
                    inQueueValues_.template AllocTensor<T>();
                AscendC::DataCopyExtParams cpIn;
                cpIn.blockCount = 1;
                cpIn.blockLen   = static_cast<uint32_t>(validElems * sizeof(T));
                cpIn.srcStride  = 0; cpIn.dstStride = 0;
                AscendC::DataCopyPad(inLocal,
                                     valuesGm_[valOff_i * D_],
                                     cpIn, padT);
                inQueueValues_.EnQue(inLocal);
                inLocal = inQueueValues_.template DeQue<T>();

                NestedAddPadCopy<T>(inLocal, outLocal, validElems);
                inQueueValues_.FreeTensor(inLocal);
                AscendC::PipeBarrier<PIPE_V>();
            }

            // 2c. DMA-out full slice (valid + padding).
            outQueueOutput_.EnQue(outLocal);
            outLocal = outQueueOutput_.template DeQue<T>();
            AscendC::DataCopyExtParams cpOut;
            cpOut.blockCount = 1;
            cpOut.blockLen   = totalBytes;
            cpOut.srcStride  = 0; cpOut.dstStride = 0;
            AscendC::DataCopyPad(outputGm_[i * maxL_ * D_], outLocal, cpOut);
            outQueueOutput_.FreeTensor(outLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       valuesGm_;
    AscendC::GlobalTensor<T>       outputGm_;
    AscendC::GlobalTensor<int64_t> metaGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>             tbufMeta_;
    AscendC::TQue<AscendC::QuePosition::VECIN,  PIPELINE_DEPTH> inQueueValues_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, PIPELINE_DEPTH> outQueueOutput_;
    int64_t batchSize_   = 0;
    int64_t maxL_        = 0;
    int64_t D_           = 0;
    T       paddingValue_{};
    int64_t blockStart_  = 0;
    int64_t myLength_    = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void nested_add_pad_kernel(
    GM_ADDR values, GM_ADDR output, GM_ADDR meta,
    int64_t batchSize, int64_t maxL, int64_t D,
    float paddingValueFp32,
    int64_t maxValidRows, int64_t blockBatchLength)
{
    KernelNestedAddPad<T> op;
    op.Init(values, output, meta,
            batchSize, maxL, D,
            paddingValueFp32,
            maxValidRows, blockBatchLength);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

torch::Tensor nested_add_pad_npu(
    const torch::Tensor &values, const torch::Tensor &offsets,
    int64_t max_L, const c10::Scalar &padding_value)
{
    auto dtype = values.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "nested_add_pad: only float32 / float16 / int32 supported, got ",
                dtype);
    TORCH_CHECK(values.dim() == 2,
                "nested_add_pad: values must be 2-D (sum_L, D), got ",
                values.dim(), "-D");
    TORCH_CHECK(offsets.dim() == 1,
                "nested_add_pad: offsets must be 1-D, got ",
                offsets.dim(), "-D");
    TORCH_CHECK(offsets.scalar_type() == torch::kInt64,
                "nested_add_pad: offsets must be int64, got ",
                offsets.scalar_type());
    TORCH_CHECK(offsets.size(0) >= 1,
                "nested_add_pad: offsets must have at least 1 element, got size ",
                offsets.size(0));

    const int64_t B    = offsets.size(0) - 1;
    const int64_t sumL = values.size(0);
    const int64_t D    = values.size(1);
    TORCH_CHECK(B >= 0, "nested_add_pad: batch B must be >= 0, got ", B);
    TORCH_CHECK(D >= 1, "nested_add_pad: D must be >= 1, got ", D);
    TORCH_CHECK(max_L >= 0,
                "nested_add_pad: max_L must be >= 0, got ", max_L);
    TORCH_CHECK(sumL >= 0 && sumL <= static_cast<int64_t>(0x7fffffff),
                "nested_add_pad: sum_L=", sumL, " out of range [0, INT32_MAX]");
    TORCH_CHECK(max_L <= static_cast<int64_t>(0x7fffffff),
                "nested_add_pad: max_L=", max_L, " exceeds INT32_MAX");

    const size_t bytesPerT = (dtype == torch::kFloat16) ? 2u : 4u;
    const int64_t alignElems = 32 / static_cast<int64_t>(bytesPerT);
    TORCH_CHECK(D % alignElems == 0,
                "nested_add_pad: D=", D,
                " must be a multiple of ", alignElems,
                " (32B / sizeof(", dtype, ")) for Reg row alignment");

    // Host-side scan: validate offsets monotonicity + boundary, build meta,
    // compute maxValidRows.
    auto offsets_cpu = offsets.cpu().contiguous();
    const int64_t *p = offsets_cpu.const_data_ptr<int64_t>();
    int64_t maxValidRows = 0;

    auto meta_cpu = torch::empty({B, META_FIELDS},
                                  offsets.options().device(torch::kCPU));
    int64_t *q = meta_cpu.data_ptr<int64_t>();

    if (B > 0) {
        TORCH_CHECK(p[0] == 0,
                    "nested_add_pad: offsets[0] must be 0, got ", p[0]);
        for (int64_t i = 0; i < B; ++i) {
            const int64_t off_lo = p[i];
            const int64_t off_hi = p[i + 1];
            TORCH_CHECK(off_hi >= off_lo,
                        "nested_add_pad: offsets must be non-decreasing at i=", i,
                        " (offsets[i]=", off_lo, ", offsets[i+1]=", off_hi, ")");
            const int64_t L_i = off_hi - off_lo;
            TORCH_CHECK(L_i <= max_L,
                        "nested_add_pad: L_i=", L_i, " at batch i=", i,
                        " exceeds max_L=", max_L);
            q[i * META_FIELDS + 0] = L_i;
            q[i * META_FIELDS + 1] = off_lo;
            if (L_i > maxValidRows) maxValidRows = L_i;
        }
        TORCH_CHECK(p[B] == sumL,
                    "nested_add_pad: offsets[B]=", p[B],
                    " must equal values.size(0)=", sumL);
    }

    // UB capacity check.
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "nested_add_pad: coreNum must be positive");

    const int64_t inChunkBytes  = maxValidRows * D * static_cast<int64_t>(bytesPerT);
    const int64_t outChunkBytes = max_L * D * static_cast<int64_t>(bytesPerT);
    const int64_t metaBytes     = B * META_FIELDS * static_cast<int64_t>(sizeof(int64_t));
    const int64_t needUb = PIPELINE_DEPTH * (inChunkBytes + outChunkBytes) +
                           metaBytes + SAFETY_BYTES;
    TORCH_CHECK(needUb <= static_cast<int64_t>(ubSize),
                "nested_add_pad: UB need ", needUb,
                " exceeds UB capacity ", ubSize,
                " (max(L_i)=", maxValidRows, ", max_L=", max_L, ", D=", D,
                ", bytes_per_elem=", bytesPerT, ")");

    auto values_c = values.contiguous();
    auto out      = torch::empty({B, max_L, D}, values_c.options());

    // Short-circuit: empty output.
    if (B == 0 || max_L == 0) return out;

    int64_t numBlocks = std::min(coreNum, B);
    if (numBlocks < 1) numBlocks = 1;
    int64_t blockBatchLength = (B + numBlocks - 1) / numBlocks;

    const c10::OptionalDeviceGuard guard(values.device());
    auto meta_npu = meta_cpu.to(values.device(), /*non_blocking=*/false);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto valuesPtr = (GM_ADDR)values_c.data_ptr();
    auto outPtr    = (GM_ADDR)out.data_ptr();
    auto metaPtr   = (GM_ADDR)meta_npu.data_ptr();

    // Pass padding_value as fp32 from host all the way into the device
    // kernel; the per-T cast happens inside KernelNestedAddPad<T>::Init
    // (device context, handled by bisheng). Avoids host-side libgcc
    // __truncsfhf2 dependency that breaks load on minimal runtime images.
    const float pvFp32 = padding_value.to<float>();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            values_c.scalar_type(), "nested_add_pad_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                nested_add_pad_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    valuesPtr, outPtr, metaPtr,
                    B, max_L, D,
                    pvFp32,
                    maxValidRows, blockBatchLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                nested_add_pad_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    valuesPtr, outPtr, metaPtr,
                    B, max_L, D,
                    pvFp32,
                    maxValidRows, blockBatchLength);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                nested_add_pad_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    valuesPtr, outPtr, metaPtr,
                    B, max_L, D,
                    pvFp32,
                    maxValidRows, blockBatchLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("NestedAddPad", acl_call);

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("nested_add_pad", nested_add_pad_npu);
}

} // namespace NestedAddPad
} // namespace ops_multimodal_fusion
