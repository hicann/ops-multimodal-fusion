#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <cstdint>
#include <type_traits>

namespace ops_multimodal_fusion { namespace SparseMaskIntersection {

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{ m.def("sparse_mask_intersection(Tensor source, Tensor mask_indices) -> Tensor"); }

torch::Tensor meta(const torch::Tensor &src, const torch::Tensor &mask)
{
    TORCH_CHECK(src.dim()==1 && mask.dim()==1);
    TORCH_CHECK(mask.scalar_type()==torch::kInt32);
    TORCH_CHECK(src.scalar_type()==torch::kFloat32||src.scalar_type()==torch::kFloat16);
    return torch::empty({mask.numel()}, src.options());
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m) { m.impl("sparse_mask_intersection", meta); }

/* ── Layer 1: __simd_vf__ — vectorized gather with range-select zero-fill ──── */

__simd_vf__ inline void SparseMaskGatherVf(__ubuf__ float *poolAddr,
                                            __ubuf__ uint32_t *idxAddr,
                                            __ubuf__ float *outAddr,
                                            uint32_t elementCount,
                                            uint32_t chunkCount,
                                            uint32_t srcLen)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<uint32_t> idxReg;
    AscendC::Reg::RegTensor<float> outReg, zeroReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);

        // Load indices for this chunk (uint32_t — dav-3510 vgather2 only takes
        // u32 idx; negative int32 indices cast to large uint32 values, which
        // fail the < srcLen check below and get zero-filled).
        AscendC::Reg::LoadAlign<uint32_t, AscendC::Reg::LoadDist::DIST_NORM>(
            idxReg, idxAddr + offset);

        // Range check: idx < srcLen (uint is always >= 0, so only need upper bound)
        AscendC::Reg::MaskReg ltSrcLen;
        AscendC::Reg::Compares<uint32_t, AscendC::CMPMODE::LT>(
            ltSrcLen, idxReg, srcLen, mask);
        AscendC::Reg::MaskReg inRange = ltSrcLen;

        // Gather from pool: inRange lanes get source[idx], others undefined
        AscendC::Reg::Gather(outReg, poolAddr, idxReg, inRange);

        // Zero out-of-range lanes: outReg = inRange ? outReg : 0
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f);
        AscendC::Reg::Select<float>(outReg, outReg, zeroReg, inRange);

        // Store result
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, outReg, mask);
    }
}

/* ── Layer 2: __aicore__ inline wrapper (asc_vf_call entry) ────────────────── */

__aicore__ inline void SparseMaskGather(AscendC::LocalTensor<float> &pool,
                                         AscendC::LocalTensor<int32_t> &index,
                                         AscendC::LocalTensor<float> &out,
                                         uint32_t elementCount,
                                         uint32_t srcLen)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ float *poolPtr = (__ubuf__ float *)pool.GetPhyAddr();
    // Reinterpret int32 UB buffer as uint32 for vgather2 (negative int32 →
    // large uint32, fails the < srcLen check, gets zero-filled).
    __ubuf__ uint32_t *indexPtr = reinterpret_cast<__ubuf__ uint32_t *>(
        (__ubuf__ int32_t *)index.GetPhyAddr());
    __ubuf__ float *outPtr = (__ubuf__ float *)out.GetPhyAddr();
    asc_vf_call<SparseMaskGatherVf>(
        poolPtr, indexPtr, outPtr, elementCount, chunkCount, srcLen);
}

/* ── Layer 3: Kernel — GM↔UB pipeline, vectorized DataCopyPad + Layer 2 call ── */

class Kernel {
public:
    __aicore__ inline Kernel() {}

    __aicore__ inline void Init(GM_ADDR src, GM_ADDR maskIdx, GM_ADDR out,
                                 int64_t srcLen, int64_t maskLen)
    {
        srcGm_.SetGlobalBuffer((__gm__ float*)src);
        idxGm_.SetGlobalBuffer((__gm__ int32_t*)maskIdx);
        outGm_.SetGlobalBuffer((__gm__ float*)out);
        srcLen_ = srcLen;
        maskLen_ = maskLen;
        // Three UB buffers: pool (source), index (mask_indices), out (gathered)
        pipe_.InitBuffer(tbufPool_, static_cast<uint32_t>(srcLen_ * sizeof(float)));
        pipe_.InitBuffer(tbufIndex_, static_cast<uint32_t>(maskLen_ * sizeof(int32_t)));
        pipe_.InitBuffer(tbufOut_, static_cast<uint32_t>(maskLen_ * sizeof(float)));
    }

    __aicore__ inline void Process()
    {
        if (AscendC::GetBlockIdx() != 0 || maskLen_ <= 0) return;

        AscendC::LocalTensor<float> poolLocal = tbufPool_.Get<float>();
        AscendC::LocalTensor<int32_t> indexLocal = tbufIndex_.Get<int32_t>();
        AscendC::LocalTensor<float> outLocal = tbufOut_.Get<float>();

        AscendC::DataCopyExtParams cpPool; cpPool.blockCount=1;
        cpPool.blockLen = static_cast<uint32_t>(srcLen_ * sizeof(float));
        cpPool.srcStride=0; cpPool.dstStride=0;
        AscendC::DataCopyExtParams cpIndex; cpIndex.blockCount=1;
        cpIndex.blockLen = static_cast<uint32_t>(maskLen_ * sizeof(int32_t));
        cpIndex.srcStride=0; cpIndex.dstStride=0;
        AscendC::DataCopyExtParams cpOut; cpOut.blockCount=1;
        cpOut.blockLen = static_cast<uint32_t>(maskLen_ * sizeof(float));
        cpOut.srcStride=0; cpOut.dstStride=0;

        AscendC::DataCopyPadExtParams<float> padF{false, 0, 0, 0.0f};
        AscendC::DataCopyPadExtParams<int32_t> padI{false, 0, 0, 0};

        // GM → UB (vectorized)
        if (srcLen_ > 0) {
            AscendC::DataCopyPad(poolLocal, srcGm_, cpPool, padF);
        }
        AscendC::DataCopyPad(indexLocal, idxGm_, cpIndex, padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        // Layer 2: vectorized Reg gather + range-select zero-fill
        SparseMaskGather(poolLocal, indexLocal, outLocal,
                          static_cast<uint32_t>(maskLen_),
                          static_cast<uint32_t>(srcLen_));
        AscendC::PipeBarrier<PIPE_ALL>();

        // UB → GM (vectorized)
        AscendC::DataCopyPad(outGm_, outLocal, cpOut);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> srcGm_, outGm_;
    AscendC::GlobalTensor<int32_t> idxGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufPool_, tbufIndex_, tbufOut_;
    int64_t srcLen_ = 0, maskLen_ = 0;
};

__global__ __aicore__ __vector__ void gather_kernel(GM_ADDR s, GM_ADDR m, GM_ADDR o,
                                                       int64_t sl, int64_t ml) {
    Kernel op; op.Init(s, m, o, sl, ml); op.Process();
}

/* ── Layer 4: host npu() — Meta + UB-capacity check + OpCommand + kernel<<<>>> ── */

static void check_ub_capacity(int64_t srcLen, int64_t maskLen)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    auto align32 = [](int64_t bytes) { return ((bytes + 31) / 32) * 32; };
    int64_t need = align32(srcLen * sizeof(float)) +
                   align32(maskLen * sizeof(int32_t)) +
                   align32(maskLen * sizeof(float)) +
                   8192;
    TORCH_CHECK(static_cast<uint64_t>(need) <= ubSize,
                "sparse_mask_intersection: UB working set ", need,
                " bytes exceeds UB ", ubSize,
                "; this first version requires pool/index/output to fit in UB");
}

torch::Tensor npu(const torch::Tensor &src, const torch::Tensor &mask)
{
    auto out = meta(src, mask);
    if (out.numel() == 0) return out;
    const c10::OptionalDeviceGuard g(src.device());
    auto mc = mask.contiguous().to(torch::kInt32);
    int64_t sl = src.numel(), ml = mc.numel();

    // fp16 path: cast source to fp32, gather, cast output back
    if (src.scalar_type() == torch::kFloat16) {
        auto src32 = src.to(torch::kFloat32);
        check_ub_capacity(sl, ml);
        auto out32 = torch::empty({ml}, torch::dtype(torch::kFloat32).device(src.device()));
        auto stream = c10_npu::getCurrentNPUStream().stream(false);
        auto sP=(GM_ADDR)src32.data_ptr(), mP=(GM_ADDR)mc.data_ptr(), oP=(GM_ADDR)out32.data_ptr();
        auto a=[=]()->int{ gather_kernel<<<1,nullptr,stream>>>(sP,mP,oP,sl,ml); return 0; };
        at_npu::native::OpCommand::RunOpApi("SparseMaskIntersection",a);
        return out32.to(torch::kFloat16);
    }

    // fp32: native
    check_ub_capacity(sl, ml);
    auto sc = src.contiguous();
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto sP=(GM_ADDR)sc.data_ptr(), mP=(GM_ADDR)mc.data_ptr(), oP=(GM_ADDR)out.data_ptr();
    auto a=[=]()->int{ gather_kernel<<<1,nullptr,stream>>>(sP,mP,oP,sl,ml); return 0; };
    at_npu::native::OpCommand::RunOpApi("SparseMaskIntersection",a);
    return out;
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m) { m.impl("sparse_mask_intersection", npu); }

} }
