#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <cstdint>
#include <vector>

namespace ops_multimodal_fusion { namespace SparseBinaryIntersect {

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m) { m.def("sparse_binary_intersect(Tensor indices_a, Tensor values_a, Tensor indices_b, Tensor values_b) -> Tensor[]"); }
std::vector<torch::Tensor> meta(const torch::Tensor &ia,const torch::Tensor &va,const torch::Tensor &ib,const torch::Tensor &vb) {
    TORCH_CHECK(ia.dim()==1&&va.dim()==1&&ib.dim()==1&&vb.dim()==1);
    TORCH_CHECK(ia.numel()==va.numel()&&ib.numel()==vb.numel());
    TORCH_CHECK(ia.scalar_type()==torch::kInt32&&ib.scalar_type()==torch::kInt32);
    TORCH_CHECK(va.scalar_type()==vb.scalar_type());
    TORCH_CHECK(va.scalar_type()==torch::kFloat32||va.scalar_type()==torch::kFloat16);
    return {torch::empty({0},ia.options()),torch::empty({0},va.options())};
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m) { m.impl("sparse_binary_intersect", meta); }

/* ── Layer 1: __simd_vf__ — vectorized zero-fill of outBuf ──────────────── */

__simd_vf__ inline void ZeroOutVf(__ubuf__ int32_t *outAddr,
                                    uint32_t elementCount,
                                    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    AscendC::Reg::RegTensor<int32_t> zeroReg;
    AscendC::Reg::Duplicate<int32_t>(zeroReg, 0);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<int32_t>(remaining);
        AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, zeroReg, mask);
    }
}

// float variant (for outVal buffer)
__simd_vf__ inline void ZeroOutFloatVf(__ubuf__ float *outAddr,
                                         uint32_t elementCount,
                                         uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::Duplicate<float>(zeroReg, 0.0f);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, zeroReg, mask);
    }
}

/* ── Layer 2: __aicore__ wrappers ──────────────────────────────────────── */

__aicore__ inline void ZeroOutInt(AscendC::LocalTensor<int32_t> &out, uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ int32_t *outPtr = (__ubuf__ int32_t *)out.GetPhyAddr();
    asc_vf_call<ZeroOutVf>(outPtr, elementCount, chunkCount);
}

__aicore__ inline void ZeroOutFloat(AscendC::LocalTensor<float> &out, uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ float *outPtr = (__ubuf__ float *)out.GetPhyAddr();
    asc_vf_call<ZeroOutFloatVf>(outPtr, elementCount, chunkCount);
}

/* ── Layer 3: Kernel — GM↔UB + Layer 2 zero-fill + scalar merge-join ────── */

class Kernel {
public:
    __aicore__ inline Kernel() {}

    __aicore__ inline void Init(GM_ADDR ia, GM_ADDR va, GM_ADDR ib, GM_ADDR vb,
                                 GM_ADDR oi, GM_ADDR ov, GM_ADDR cnt, int64_t aLen, int64_t bLen)
    {
        iaGm_.SetGlobalBuffer((__gm__ int32_t*)ia);
        vaGm_.SetGlobalBuffer((__gm__ float*)va);
        ibGm_.SetGlobalBuffer((__gm__ int32_t*)ib);
        vbGm_.SetGlobalBuffer((__gm__ float*)vb);
        oiGm_.SetGlobalBuffer((__gm__ int32_t*)oi);
        ovGm_.SetGlobalBuffer((__gm__ float*)ov);
        cntGm_.SetGlobalBuffer((__gm__ int32_t*)cnt);
        aLen_ = aLen; bLen_ = bLen;
        maxOut_ = (aLen < bLen) ? aLen : bLen;
        if (maxOut_ == 0) maxOut_ = 1;
        pipe_.InitBuffer(tbufIa_, static_cast<uint32_t>(aLen_ * sizeof(int32_t)));
        pipe_.InitBuffer(tbufVa_, static_cast<uint32_t>(aLen_ * sizeof(float)));
        pipe_.InitBuffer(tbufIb_, static_cast<uint32_t>(bLen_ * sizeof(int32_t)));
        pipe_.InitBuffer(tbufVb_, static_cast<uint32_t>(bLen_ * sizeof(float)));
        pipe_.InitBuffer(tbufOi_, static_cast<uint32_t>(maxOut_ * sizeof(int32_t)));
        pipe_.InitBuffer(tbufOv_, static_cast<uint32_t>(maxOut_ * sizeof(float)));
        pipe_.InitBuffer(scalarBuf_, 32);
    }

    __aicore__ inline void Process()
    {
        if (AscendC::GetBlockIdx() != 0) return;

        AscendC::LocalTensor<int32_t> iaLocal = tbufIa_.Get<int32_t>();
        AscendC::LocalTensor<float> vaLocal = tbufVa_.Get<float>();
        AscendC::LocalTensor<int32_t> ibLocal = tbufIb_.Get<int32_t>();
        AscendC::LocalTensor<float> vbLocal = tbufVb_.Get<float>();
        AscendC::LocalTensor<int32_t> oiLocal = tbufOi_.Get<int32_t>();
        AscendC::LocalTensor<float> ovLocal = tbufOv_.Get<float>();
        auto iSc = scalarBuf_.Get<int32_t>();

        AscendC::DataCopyExtParams cf; cf.blockCount=1; cf.srcStride=0; cf.dstStride=0;
        AscendC::DataCopyPadExtParams<int32_t> pi{false,0,0,0};
        AscendC::DataCopyPadExtParams<float> pf{false,0,0,0.0f};

        // GM → UB (vectorized DMA)
        if (aLen_ > 0) {
            cf.blockLen = static_cast<uint32_t>(aLen_ * sizeof(int32_t));
            AscendC::DataCopyPad(iaLocal, iaGm_, cf, pi);
            cf.blockLen = static_cast<uint32_t>(aLen_ * sizeof(float));
            AscendC::DataCopyPad(vaLocal, vaGm_, cf, pf);
        }
        if (bLen_ > 0) {
            cf.blockLen = static_cast<uint32_t>(bLen_ * sizeof(int32_t));
            AscendC::DataCopyPad(ibLocal, ibGm_, cf, pi);
            cf.blockLen = static_cast<uint32_t>(bLen_ * sizeof(float));
            AscendC::DataCopyPad(vbLocal, vbGm_, cf, pf);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        // Layer 2: vectorized zero-fill of outIdx/outVal (pre-allocated to maxOut)
        ZeroOutInt(oiLocal, static_cast<uint32_t>(maxOut_));
        ZeroOutFloat(ovLocal, static_cast<uint32_t>(maxOut_));
        AscendC::PipeBarrier<PIPE_ALL>();

        // Scalar merge-join walk (sequential: dual-pointer advance depends on
        // previous comparison result; cannot vectorize).
        int64_t ai = 0, bi = 0, oi_ = 0;
        while (ai < aLen_ && bi < bLen_) {
            int32_t aIdx = iaLocal.GetValue(ai);
            int32_t bIdx = ibLocal.GetValue(bi);
            if (aIdx == bIdx) {
                float aVal = vaLocal.GetValue(ai);
                float bVal = vbLocal.GetValue(bi);
                float prod = aVal * bVal;
                oiLocal.SetValue(oi_, aIdx);
                ovLocal.SetValue(oi_, prod);
                ++oi_; ++ai; ++bi;
            } else if (aIdx < bIdx) {
                ++ai;
            } else {
                ++bi;
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        // UB → GM (vectorized DMA, only the matched prefix up to maxOut_)
        if (maxOut_ > 0) {
            cf.blockLen = static_cast<uint32_t>(maxOut_ * sizeof(int32_t));
            AscendC::DataCopyPad(oiGm_, oiLocal, cf);
            cf.blockLen = static_cast<uint32_t>(maxOut_ * sizeof(float));
            AscendC::DataCopyPad(ovGm_, ovLocal, cf);
        }

        // Write match count
        iSc.SetValue(0, static_cast<int32_t>(oi_));
        AscendC::PipeBarrier<PIPE_ALL>();
        cf.blockLen = sizeof(int32_t);
        AscendC::DataCopyPad(cntGm_[0], iSc, cf);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<int32_t> iaGm_, ibGm_, oiGm_, cntGm_;
    AscendC::GlobalTensor<float> vaGm_, vbGm_, ovGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIa_, tbufVa_, tbufIb_, tbufVb_, tbufOi_, tbufOv_, scalarBuf_;
    int64_t aLen_ = 0, bLen_ = 0, maxOut_ = 0;
};

__global__ __aicore__ __vector__ void intersect_kernel(GM_ADDR ia, GM_ADDR va, GM_ADDR ib, GM_ADDR vb,
    GM_ADDR oi, GM_ADDR ov, GM_ADDR cnt, int64_t al, int64_t bl) {
    Kernel op; op.Init(ia, va, ib, vb, oi, ov, cnt, al, bl); op.Process();
}

/* ── Layer 4: host npu() ────────────────────────────────────────────────── */

static void check_ub_capacity(int64_t aLen, int64_t bLen)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    auto align32 = [](int64_t bytes) { return ((bytes + 31) / 32) * 32; };
    int64_t maxOut = (aLen < bLen) ? aLen : bLen;
    if (maxOut == 0) maxOut = 1;
    int64_t need = align32(aLen * sizeof(int32_t)) + align32(aLen * sizeof(float)) +
                   align32(bLen * sizeof(int32_t)) + align32(bLen * sizeof(float)) +
                   align32(maxOut * sizeof(int32_t)) + align32(maxOut * sizeof(float)) +
                   8192;
    TORCH_CHECK(static_cast<uint64_t>(need) <= ubSize,
                "sparse_binary_intersect: UB working set ", need,
                " bytes exceeds UB ", ubSize,
                "; this first version requires ia/va/ib/vb/out to fit in UB");
}

std::vector<torch::Tensor> npu(const torch::Tensor &ia, const torch::Tensor &va, const torch::Tensor &ib, const torch::Tensor &vb)
{
    meta(ia, va, ib, vb);
    const c10::OptionalDeviceGuard g(ia.device());
    auto iac = ia.contiguous().to(torch::kInt32);
    auto ibc = ib.contiguous().to(torch::kInt32);
    int64_t al = iac.numel(), bl = ibc.numel();
    int64_t maxOut = (al < bl) ? al : bl;
    if (maxOut == 0) maxOut = 1;
    auto outIdx = torch::empty({maxOut}, iac.options());
    auto cnt = torch::empty({1}, torch::dtype(torch::kInt32).device(ia.device()));

    // fp16: cast values to fp32, compute, cast back
    if (va.scalar_type() == torch::kFloat16) {
        auto va32 = va.to(torch::kFloat32);
        auto vb32 = vb.to(torch::kFloat32);
        check_ub_capacity(al, bl);
        auto outVal = torch::empty({maxOut}, torch::dtype(torch::kFloat32).device(ia.device()));
        auto stream = c10_npu::getCurrentNPUStream().stream(false);
        auto iaP=(GM_ADDR)iac.data_ptr(), vaP=(GM_ADDR)va32.data_ptr();
        auto ibP=(GM_ADDR)ibc.data_ptr(), vbP=(GM_ADDR)vb32.data_ptr();
        auto oiP=(GM_ADDR)outIdx.data_ptr(), ovP=(GM_ADDR)outVal.data_ptr();
        auto cP=(GM_ADDR)cnt.data_ptr();
        auto a=[=]()->int{ intersect_kernel<<<1,nullptr,stream>>>(iaP,vaP,ibP,vbP,oiP,ovP,cP,al,bl); return 0; };
        at_npu::native::OpCommand::RunOpApi("SparseBinaryIntersect", a);
        int32_t n = cnt.cpu().item<int32_t>();
        return {outIdx.narrow(0,0,n).clone(), outVal.narrow(0,0,n).to(torch::kFloat16).clone()};
    }

    // fp32: native
    check_ub_capacity(al, bl);
    auto vac = va.contiguous();
    auto vbc = vb.contiguous();
    auto outVal = torch::empty({maxOut}, vac.options());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto iaP=(GM_ADDR)iac.data_ptr(), vaP=(GM_ADDR)vac.data_ptr();
    auto ibP=(GM_ADDR)ibc.data_ptr(), vbP=(GM_ADDR)vbc.data_ptr();
    auto oiP=(GM_ADDR)outIdx.data_ptr(), ovP=(GM_ADDR)outVal.data_ptr();
    auto cP=(GM_ADDR)cnt.data_ptr();
    auto a=[=]()->int{ intersect_kernel<<<1,nullptr,stream>>>(iaP,vaP,ibP,vbP,oiP,ovP,cP,al,bl); return 0; };
    at_npu::native::OpCommand::RunOpApi("SparseBinaryIntersect", a);
    int32_t n = cnt.cpu().item<int32_t>();
    return {outIdx.narrow(0,0,n).clone(), outVal.narrow(0,0,n).clone()};
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m) { m.impl("sparse_binary_intersect", npu); }

} }
