/*!
 * \file weight_norm.asc
 * \brief WeightNorm forward operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * Schema:
 *   weight_norm(Tensor v, Tensor g, int dim) -> Tensor
 *
 * Semantics:
 *   View v as [outer, C, inner], where C = v.size(dim).
 *   norm[c] = sqrt(sum_{outer, inner} v[outer, c, inner]^2)
 *   out[outer, c, inner] = v[outer, c, inner] * g[c] / norm[c]
 *
 * Scope:
 *   - forward only
 *   - int dim only; dim=None is intentionally out of scope for the first version
 *   - dtype scope: fp16 / fp32
 *   - g shape: [C] or norm_except_dim-style shape with only dim sized C
 *
 * The implementation keeps value arithmetic in RegBase VF functions. Normal
 * AscendC queue/DMA plumbing is used for GM/UB movement.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <vector>

namespace ops_multimodal_fusion {
namespace WeightNorm {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t PIPELINE_DEPTH = 2;
constexpr int64_t MAX_TILE_ELEMS = 4096;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("weight_norm(Tensor v, Tensor g, int dim) -> Tensor");
}

static int64_t normalize_dim(int64_t dim, int64_t ndim)
{
    if (dim < 0) {
        dim += ndim;
    }
    TORCH_CHECK(dim >= 0 && dim < ndim,
                "weight_norm: dim out of range for ndim=", ndim, ", got ", dim);
    return dim;
}

static void check_g_shape(const torch::Tensor &v, const torch::Tensor &g, int64_t dim)
{
    const int64_t C = v.size(dim);
    bool oneDim = (g.dim() == 1 && g.size(0) == C);
    bool normShape = (g.dim() == v.dim());
    if (normShape) {
        for (int64_t i = 0; i < v.dim(); ++i) {
            int64_t expected = (i == dim) ? C : 1;
            if (g.size(i) != expected) {
                normShape = false;
                break;
            }
        }
    }
    TORCH_CHECK(oneDim || normShape,
                "weight_norm: g shape must be [C] or norm_except_dim(v, 2, dim) shape; got g=",
                g.sizes(), ", v=", v.sizes(), ", dim=", dim);
}

static int64_t check_common(const torch::Tensor &v, const torch::Tensor &g, int64_t dim)
{
    TORCH_CHECK(v.dim() >= 1, "weight_norm: v must have at least 1 dimension");
    TORCH_CHECK(v.numel() > 0, "weight_norm: empty v is not supported");
    TORCH_CHECK(v.scalar_type() == torch::kFloat32 ||
                v.scalar_type() == torch::kFloat16,
                "weight_norm: only float32 and float16 are supported, got ",
                v.scalar_type());
    TORCH_CHECK(g.scalar_type() == v.scalar_type(),
                "weight_norm: g dtype must match v dtype");
    int64_t normalizedDim = normalize_dim(dim, v.dim());
    check_g_shape(v, g, normalizedDim);
    return normalizedDim;
}

torch::Tensor weight_norm_meta(const torch::Tensor &v, const torch::Tensor &g, int64_t dim)
{
    (void)check_common(v, g, dim);
    return torch::empty(v.sizes(), v.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("weight_norm", weight_norm_meta);
}

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t C, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "weight_norm: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, C);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (C + numBlocks - 1) / numBlocks;

    // UB per tile:
    //   inQueue      : PIPELINE_DEPTH * tile * sizeof(T)
    //   outQueue     : PIPELINE_DEPTH * tile * sizeof(T)
    //   valueF       : tile * sizeof(float)
    //   accF         : tile * sizeof(float)   (column path accumulator)
    //   scaleVecF    : tile * sizeof(float)   (column path per-column scale)
    //   gTile        : tile * sizeof(T)       (column path g slice)
    //   sum/reduce/scale/gBuf scalar scratch: 4 * 32B
    int64_t fixedBytes = 4 * BLOCK_BYTES + 1024;
    int64_t bytesPerElem = 2 * PIPELINE_DEPTH * elemSize +
                           3 * static_cast<int64_t>(sizeof(float)) + elemSize;
    int64_t tileElems = (static_cast<int64_t>(ubSize) - fixedBytes) / bytesPerElem;
    int64_t alignElems = 16; // multiple of 32B for fp16 and fp32 buffers.
    tileElems = (tileElems / alignElems) * alignElems;
    if (tileElems > MAX_TILE_ELEMS) {
        tileElems = MAX_TILE_ELEMS;
    }
    TORCH_CHECK(tileElems >= alignElems,
                "weight_norm: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

template <typename T>
__simd_vf__ inline void CastToFloatRegVf(
    __ubuf__ float *dstAddr, __ubuf__ T *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        if constexpr (sizeof(T) == 2) {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
                srcReg, srcAddr + offset);
        } else {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
                srcReg, srcAddr + offset);
        }
        AscendC::Reg::Cast<float, T, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastToFloatReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<T> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
__simd_vf__ inline void CastFromFloatRegVf(
    __ubuf__ T *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<T, float, castTrait>(dstReg, srcReg, mask);
        if constexpr (sizeof(T) == 2) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
                dstAddr + offset, dstReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + offset, dstReg, mask);
        }
    }
}

template <typename T>
__aicore__ inline void CastFromFloatReg(
    const AscendC::LocalTensor<T> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFromFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void DuplicateZeroRegVf(__ubuf__ float *dstAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::Duplicate<float>(dstReg, 0.0f, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        dstAddr, dstReg, mask);
}

__aicore__ inline void DuplicateZeroReg(const AscendC::LocalTensor<float> &dst)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    asc_vf_call<DuplicateZeroRegVf>(dstAddr);
}

__simd_vf__ inline void ReduceSumSquaresRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> sqReg;
    AscendC::Reg::RegTensor<float> reduceReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::Duplicate<float>(sumReg, 0.0f, scalarMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Mul(sqReg, srcReg, srcReg, mask);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float, AscendC::Reg::MaskMergeMode::ZEROING>(
            reduceReg, sqReg, mask);
        AscendC::Reg::Add(sumReg, sumReg, reduceReg, scalarMask);
    }

    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        dstAddr, sumReg, scalarMask);
}

__aicore__ inline void ReduceSumSquaresReg(
    const AscendC::LocalTensor<float> &dst,
    const AscendC::LocalTensor<float> &src,
    int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ReduceSumSquaresRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void AccumulateScalarRegVf(__ubuf__ float *accumAddr, __ubuf__ float *addAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<float> addReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(accumReg, accumAddr);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(addReg, addAddr);
    AscendC::Reg::Add(accumReg, accumReg, addReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, mask);
}

__aicore__ inline void AccumulateScalarReg(
    const AscendC::LocalTensor<float> &accum, const AscendC::LocalTensor<float> &add)
{
    __ubuf__ float *accumAddr = (__ubuf__ float *)accum.GetPhyAddr();
    __ubuf__ float *addAddr = (__ubuf__ float *)add.GetPhyAddr();
    asc_vf_call<AccumulateScalarRegVf>(accumAddr, addAddr);
}

template <typename T>
__simd_vf__ inline void ComputeScaleRegVf(
    __ubuf__ float *scaleAddr, __ubuf__ T *gAddr, __ubuf__ float *sumAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> gFloatReg;
    AscendC::Reg::RegTensor<float> normReg;
    AscendC::Reg::RegTensor<float> scaleReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(normReg, sumAddr);
    AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
        normReg, normReg, mask);

    if constexpr (sizeof(T) == 4) {
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            gFloatReg, (__ubuf__ float *)gAddr);
    } else {
        static constexpr AscendC::Reg::CastTrait castTrait = {
            AscendC::Reg::RegLayout::ZERO,
            AscendC::Reg::SatMode::NO_SAT,
            AscendC::Reg::MaskMergeMode::ZEROING,
            AscendC::RoundMode::CAST_NONE};
        AscendC::Reg::RegTensor<T> gReg;
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(gReg, gAddr);
        AscendC::Reg::Cast<float, T, castTrait>(gFloatReg, gReg, mask);
    }
    AscendC::Reg::Div(scaleReg, gFloatReg, normReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        scaleAddr, scaleReg, mask);
}

template <typename T>
__aicore__ inline void ComputeScaleReg(
    const AscendC::LocalTensor<float> &scale,
    const AscendC::LocalTensor<T> &g,
    const AscendC::LocalTensor<float> &sum)
{
    __ubuf__ float *scaleAddr = (__ubuf__ float *)scale.GetPhyAddr();
    __ubuf__ T *gAddr = (__ubuf__ T *)g.GetPhyAddr();
    __ubuf__ float *sumAddr = (__ubuf__ float *)sum.GetPhyAddr();
    asc_vf_call<ComputeScaleRegVf<T>>(scaleAddr, gAddr, sumAddr);
}

__simd_vf__ inline void MultiplyScaleRegVf(
    __ubuf__ float *valueAddr, __ubuf__ float *scaleAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t fullCount = vectorLength;
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::UpdateMask<float>(fullCount);
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::RegTensor<float> scaleScalarReg;
    AscendC::Reg::RegTensor<float> scaleReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(scaleScalarReg, scaleAddr);
    AscendC::Reg::Duplicate<float>(scaleReg, scaleScalarReg, fullMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            valueReg, valueAddr + offset);
        AscendC::Reg::Mul(valueReg, valueReg, scaleReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            valueAddr + offset, valueReg, mask);
    }
}

__aicore__ inline void MultiplyScaleReg(
    const AscendC::LocalTensor<float> &value,
    const AscendC::LocalTensor<float> &scale,
    int64_t count)
{
    __ubuf__ float *valueAddr = (__ubuf__ float *)value.GetPhyAddr();
    __ubuf__ float *scaleAddr = (__ubuf__ float *)scale.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MultiplyScaleRegVf>(valueAddr, scaleAddr, elementCount, chunkCount);
}

// --- Column-wise VF helpers (innerSize == 1 path) ---------------------------
// All buffers are float (B32) and column-aligned: element i of every tile is
// channel chanBase + i. The reduction is across outer rows (vector lanes are
// channels), so we accumulate element-wise, never reduce across lanes.

// acc[i] += value[i]^2  (per-column running sum of squares)
__simd_vf__ inline void AccumulateSquaresRegVf(
    __ubuf__ float *accAddr, __ubuf__ float *valueAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg;
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::RegTensor<float> sqReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            valueReg, valueAddr + offset);
        AscendC::Reg::Mul(sqReg, valueReg, valueReg, mask);
        AscendC::Reg::Add(accReg, accReg, sqReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__aicore__ inline void AccumulateSquaresReg(
    const AscendC::LocalTensor<float> &acc,
    const AscendC::LocalTensor<float> &value,
    int64_t count)
{
    __ubuf__ float *accAddr = (__ubuf__ float *)acc.GetPhyAddr();
    __ubuf__ float *valueAddr = (__ubuf__ float *)value.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<AccumulateSquaresRegVf>(accAddr, valueAddr, elementCount, chunkCount);
}

// scale[i] = gFloat[i] / sqrt(acc[i])  (per-column scale; g cast to float)
template <typename T>
__simd_vf__ inline void ComputeScaleVectorRegVf(
    __ubuf__ float *scaleAddr, __ubuf__ T *gAddr, __ubuf__ float *accAddr,
    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> accReg;
    AscendC::Reg::RegTensor<float> normReg;
    AscendC::Reg::RegTensor<float> gFloatReg;
    AscendC::Reg::RegTensor<float> scaleReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(accReg, accAddr + offset);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING,
                           AscendC::Reg::RegTensor<float>>(normReg, accReg, mask);
        if constexpr (sizeof(T) == 4) {
            AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
                gFloatReg, ((__ubuf__ float *)gAddr) + offset);
        } else {
            AscendC::Reg::RegTensor<T> gReg;
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
                gReg, gAddr + offset);
            AscendC::Reg::Cast<float, T, castTrait>(gFloatReg, gReg, mask);
        }
        AscendC::Reg::Div(scaleReg, gFloatReg, normReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            scaleAddr + offset, scaleReg, mask);
    }
}

template <typename T>
__aicore__ inline void ComputeScaleVectorReg(
    const AscendC::LocalTensor<float> &scale,
    const AscendC::LocalTensor<T> &g,
    const AscendC::LocalTensor<float> &acc,
    int64_t count)
{
    __ubuf__ float *scaleAddr = (__ubuf__ float *)scale.GetPhyAddr();
    __ubuf__ T *gAddr = (__ubuf__ T *)g.GetPhyAddr();
    __ubuf__ float *accAddr = (__ubuf__ float *)acc.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ComputeScaleVectorRegVf<T>>(scaleAddr, gAddr, accAddr, elementCount, chunkCount);
}

// value[i] *= scale[i]  (per-column element-wise apply; column-aligned)
__simd_vf__ inline void MultiplyElemwiseRegVf(
    __ubuf__ float *valueAddr, __ubuf__ float *scaleAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::RegTensor<float> scaleReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            valueReg, valueAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            scaleReg, scaleAddr + offset);
        AscendC::Reg::Mul(valueReg, valueReg, scaleReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            valueAddr + offset, valueReg, mask);
    }
}

__aicore__ inline void MultiplyElemwiseReg(
    const AscendC::LocalTensor<float> &value,
    const AscendC::LocalTensor<float> &scale,
    int64_t count)
{
    __ubuf__ float *valueAddr = (__ubuf__ float *)value.GetPhyAddr();
    __ubuf__ float *scaleAddr = (__ubuf__ float *)scale.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MultiplyElemwiseRegVf>(valueAddr, scaleAddr, elementCount, chunkCount);
}

// acc[i] = 0  for i in [0, count)  (vector zero-fill of the column accumulator)
__simd_vf__ inline void DuplicateZeroVectorRegVf(
    __ubuf__ float *dstAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<float>(dstReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void DuplicateZeroVectorReg(
    const AscendC::LocalTensor<float> &dst, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<DuplicateZeroVectorRegVf>(dstAddr, elementCount, chunkCount);
}

// --- Global-norm VF helpers (literal dim == -1 path) ------------------------
// invNorm[0] = 1 / sqrt(sum[0]); a single scalar derived from the global sum of
// squares. Stored back so the second pass can broadcast it across all elements.
__simd_vf__ inline void ComputeInvNormScalarRegVf(__ubuf__ float *sumAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> normReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> invReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(normReg, sumAddr);
    AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
        normReg, normReg, mask);
    AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
    AscendC::Reg::Div(invReg, oneReg, normReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        sumAddr, invReg, mask);
}

__aicore__ inline void ComputeInvNormScalarReg(const AscendC::LocalTensor<float> &sum)
{
    __ubuf__ float *sumAddr = (__ubuf__ float *)sum.GetPhyAddr();
    asc_vf_call<ComputeInvNormScalarRegVf>(sumAddr);
}

// value[i] = value[i] * gFloat[i] * invNorm_scalar  (element-wise broadcast g,
// scalar invNorm). value and gFloat are column-aligned float tiles.
__simd_vf__ inline void ScaleByGInvNormRegVf(
    __ubuf__ float *valueAddr, __ubuf__ float *gAddr, __ubuf__ float *invNormAddr,
    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t fullCount = vectorLength;
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::UpdateMask<float>(fullCount);
    AscendC::Reg::RegTensor<float> invScalarReg;
    AscendC::Reg::RegTensor<float> invReg;
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::RegTensor<float> gReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(invScalarReg, invNormAddr);
    AscendC::Reg::Duplicate<float>(invReg, invScalarReg, fullMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            valueReg, valueAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(gReg, gAddr + offset);
        AscendC::Reg::Mul(valueReg, valueReg, gReg, mask);
        AscendC::Reg::Mul(valueReg, valueReg, invReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            valueAddr + offset, valueReg, mask);
    }
}

__aicore__ inline void ScaleByGInvNormReg(
    const AscendC::LocalTensor<float> &value,
    const AscendC::LocalTensor<float> &gFloat,
    const AscendC::LocalTensor<float> &invNorm,
    int64_t count)
{
    __ubuf__ float *valueAddr = (__ubuf__ float *)value.GetPhyAddr();
    __ubuf__ float *gAddr = (__ubuf__ float *)gFloat.GetPhyAddr();
    __ubuf__ float *invNormAddr = (__ubuf__ float *)invNorm.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ScaleByGInvNormRegVf>(valueAddr, gAddr, invNormAddr, elementCount, chunkCount);
}

// Global-norm kernel: literal dim == -1 collapses to a single full-tensor L2
// norm. out[i] = v[i] * gBcast[i] / sqrt(sum_j v[j]^2), element-wise, where
// gBcast is g broadcast to v's shape (materialized on host). Runs on a single
// AIV so the reduction is a plain running scalar sum (no cross-core combine).
template <typename T>
class KernelWeightNormGlobal {
    static constexpr bool kIsFloat = (sizeof(T) == sizeof(float));

public:
    __aicore__ inline KernelWeightNormGlobal() {}

    __aicore__ inline void Init(GM_ADDR v, GM_ADDR gBcast, GM_ADDR out,
                                int64_t numel, int64_t tileElems)
    {
        vGm_.SetGlobalBuffer((__gm__ T *)v);
        gGm_.SetGlobalBuffer((__gm__ T *)gBcast);
        outGm_.SetGlobalBuffer((__gm__ T *)out);
        numel_ = numel;
        tileElems_ = tileElems;

        pipe_.InitBuffer(inQueue_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(gQueue_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(valueBuf_, tileElems * sizeof(float));
        pipe_.InitBuffer(gFloatBuf_, tileElems * sizeof(float));
        pipe_.InitBuffer(sumBuf_, BLOCK_BYTES);
        pipe_.InitBuffer(reduceBuf_, BLOCK_BYTES);
    }

    __aicore__ inline void Process()
    {
        // Only block 0 does the work; the global reduction is sequential.
        if (AscendC::GetBlockIdx() != 0) {
            return;
        }

        auto sum = sumBuf_.template Get<float>();
        auto reduce = reduceBuf_.template Get<float>();

        DuplicateZeroReg(sum);
        AscendC::PipeBarrier<PIPE_V>();

        // Pass 1: global sum of squares.
        for (int64_t off = 0; off < numel_; off += tileElems_) {
            int64_t count = numel_ - off;
            if (count > tileElems_) count = tileElems_;
            int64_t alignedCount = AlignElems(count);
            LoadVTileAsFloat(off, count, alignedCount);
            auto value = valueBuf_.template Get<float>();
            ReduceSumSquaresReg(reduce, value, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            AccumulateScalarReg(sum, reduce);
            AscendC::PipeBarrier<PIPE_V>();
        }

        // invNorm = 1 / sqrt(sum) stored back into sumBuf_.
        ComputeInvNormScalarReg(sum);
        AscendC::PipeBarrier<PIPE_V>();

        // Pass 2: out[i] = v[i] * gBcast[i] * invNorm.
        for (int64_t off = 0; off < numel_; off += tileElems_) {
            int64_t count = numel_ - off;
            if (count > tileElems_) count = tileElems_;
            int64_t alignedCount = AlignElems(count);
            LoadVTileAsFloat(off, count, alignedCount);
            LoadGTileAsFloat(off, count, alignedCount);
            auto value = valueBuf_.template Get<float>();
            auto gFloat = gFloatBuf_.template Get<float>();
            ScaleByGInvNormReg(value, gFloat, sum, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            StoreFloatTile(off, count, alignedCount);
        }
    }

private:
    __aicore__ inline int64_t AlignElems(int64_t count)
    {
        int64_t alignElems = BLOCK_BYTES / static_cast<int64_t>(sizeof(T));
        return ((count + alignElems - 1) / alignElems) * alignElems;
    }

    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t bytes)
    {
        AscendC::DataCopyExtParams p;
        p.blockCount = 1;
        p.blockLen = static_cast<uint32_t>(bytes);
        p.srcStride = 0;
        p.dstStride = 0;
        return p;
    }

    __aicore__ inline void LoadVTileAsFloat(int64_t gmOffset, int64_t count, int64_t alignedCount)
    {
        AscendC::LocalTensor<T> inLocal = inQueue_.template AllocTensor<T>();
        int64_t rightPad = alignedCount - count;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(rightPad), static_cast<T>(0)};
        AscendC::DataCopyPad(
            inLocal, vGm_[gmOffset], CopyParams(count * sizeof(T)), padParams);
        inQueue_.EnQue(inLocal);
        inLocal = inQueue_.template DeQue<T>();

        auto value = valueBuf_.template Get<float>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(value, inLocal, alignedCount);
        } else {
            CastToFloatReg<T>(value, inLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
    }

    __aicore__ inline void LoadGTileAsFloat(int64_t gmOffset, int64_t count, int64_t alignedCount)
    {
        AscendC::LocalTensor<T> gLocal = gQueue_.template AllocTensor<T>();
        int64_t rightPad = alignedCount - count;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(rightPad), static_cast<T>(0)};
        AscendC::DataCopyPad(
            gLocal, gGm_[gmOffset], CopyParams(count * sizeof(T)), padParams);
        gQueue_.EnQue(gLocal);
        gLocal = gQueue_.template DeQue<T>();

        auto gFloat = gFloatBuf_.template Get<float>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(gFloat, gLocal, alignedCount);
        } else {
            CastToFloatReg<T>(gFloat, gLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();
        gQueue_.FreeTensor(gLocal);
    }

    __aicore__ inline void StoreFloatTile(int64_t gmOffset, int64_t count, int64_t alignedCount)
    {
        auto value = valueBuf_.template Get<float>();
        AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(outLocal, value, alignedCount);
        } else {
            CastFromFloatReg<T>(outLocal, value, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();
        outQueue_.EnQue(outLocal);
        outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyPad(outGm_[gmOffset], outLocal, CopyParams(count * sizeof(T)));
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> vGm_;
    AscendC::GlobalTensor<T> gGm_;
    AscendC::GlobalTensor<T> outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> gQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> valueBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gFloatBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceBuf_;
    int64_t numel_ = 0;
    int64_t tileElems_ = 0;
};

template <typename T>
class KernelWeightNorm {
    static constexpr bool kIsFloat = (sizeof(T) == sizeof(float));

public:
    __aicore__ inline KernelWeightNorm() {}

    __aicore__ inline void Init(
        GM_ADDR v, GM_ADDR g, GM_ADDR out,
        int64_t outerSize, int64_t C, int64_t innerSize,
        int64_t blockLength, int64_t tileElems)
    {
        vGm_.SetGlobalBuffer((__gm__ T *)v);
        gGm_.SetGlobalBuffer((__gm__ T *)g);
        outGm_.SetGlobalBuffer((__gm__ T *)out);
        outerSize_ = outerSize;
        C_ = C;
        innerSize_ = innerSize;
        tileElems_ = tileElems;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t valid = C - blockStart;
        if (valid > blockLength) valid = blockLength;
        if (valid < 0) valid = 0;
        blockStart_ = blockStart;
        myValidLength_ = valid;

        pipe_.InitBuffer(inQueue_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(valueBuf_, tileElems * sizeof(float));
        pipe_.InitBuffer(sumBuf_, BLOCK_BYTES);
        pipe_.InitBuffer(reduceBuf_, BLOCK_BYTES);
        pipe_.InitBuffer(scaleBuf_, BLOCK_BYTES);
        pipe_.InitBuffer(gBuf_, BLOCK_BYTES);
        // Column-wise (innerSize == 1) tile buffers: a per-column accumulator,
        // per-column scale, and a per-tile g slice. Sized to one channel tile.
        pipe_.InitBuffer(accBuf_, tileElems * sizeof(float));
        pipe_.InitBuffer(scaleVecBuf_, tileElems * sizeof(float));
        pipe_.InitBuffer(gTileBuf_, tileElems * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (innerSize_ == 1) {
            // Tile over the owned channel range in contiguous chunks. Each row
            // slice v[r, chanBase:chanBase+tileC] is contiguous (C is the last
            // axis), so no sub-32B strided DMA is ever issued.
            for (int64_t off = 0; off < myValidLength_; off += tileElems_) {
                int64_t tileC = myValidLength_ - off;
                if (tileC > tileElems_) tileC = tileElems_;
                ComputeColumnTile(blockStart_ + off, tileC);
            }
        } else {
            for (int64_t localC = 0; localC < myValidLength_; ++localC) {
                int64_t c = blockStart_ + localC;
                ComputeOneChannel(c);
            }
        }
    }

private:
    __aicore__ inline int64_t AlignElems(int64_t count)
    {
        int64_t alignElems = BLOCK_BYTES / static_cast<int64_t>(sizeof(T));
        return ((count + alignElems - 1) / alignElems) * alignElems;
    }

    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t bytes)
    {
        AscendC::DataCopyExtParams p;
        p.blockCount = 1;
        p.blockLen = static_cast<uint32_t>(bytes);
        p.srcStride = 0;
        p.dstStride = 0;
        return p;
    }

    __aicore__ inline void LoadTileAsFloat(int64_t gmOffset, int64_t count, int64_t alignedCount)
    {
        AscendC::LocalTensor<T> inLocal = inQueue_.template AllocTensor<T>();
        int64_t rightPad = alignedCount - count;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(rightPad), static_cast<T>(0)};
        AscendC::DataCopyPad(
            inLocal, vGm_[gmOffset], CopyParams(count * sizeof(T)), padParams);
        inQueue_.EnQue(inLocal);
        inLocal = inQueue_.template DeQue<T>();

        auto value = valueBuf_.template Get<float>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(value, inLocal, alignedCount);
        } else {
            CastToFloatReg<T>(value, inLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
    }

    __aicore__ inline void StoreFloatTile(int64_t gmOffset, int64_t count, int64_t alignedCount)
    {
        auto value = valueBuf_.template Get<float>();
        AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(outLocal, value, alignedCount);
        } else {
            CastFromFloatReg<T>(outLocal, value, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();
        outQueue_.EnQue(outLocal);
        outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyPad(outGm_[gmOffset], outLocal, CopyParams(count * sizeof(T)));
        outQueue_.FreeTensor(outLocal);
    }

    __aicore__ inline void LoadGScalar(int64_t c)
    {
        auto gLocal = gBuf_.template Get<T>();
        int64_t alignedCount = AlignElems(1);
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - 1), static_cast<T>(0)};
        AscendC::DataCopyPad(gLocal, gGm_[c], CopyParams(sizeof(T)), padParams);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void ComputeOneChannel(int64_t c)
    {
        auto sum = sumBuf_.template Get<float>();
        auto reduce = reduceBuf_.template Get<float>();
        auto scale = scaleBuf_.template Get<float>();
        auto gLocal = gBuf_.template Get<T>();

        DuplicateZeroReg(sum);
        AscendC::PipeBarrier<PIPE_V>();

        for (int64_t outer = 0; outer < outerSize_; ++outer) {
            int64_t base = (outer * C_ + c) * innerSize_;
            for (int64_t off = 0; off < innerSize_; off += tileElems_) {
                int64_t count = innerSize_ - off;
                if (count > tileElems_) count = tileElems_;
                int64_t alignedCount = AlignElems(count);
                LoadTileAsFloat(base + off, count, alignedCount);
                auto value = valueBuf_.template Get<float>();
                ReduceSumSquaresReg(reduce, value, alignedCount);
                AscendC::PipeBarrier<PIPE_V>();
                AccumulateScalarReg(sum, reduce);
                AscendC::PipeBarrier<PIPE_V>();
            }
        }

        LoadGScalar(c);
        ComputeScaleReg<T>(scale, gLocal, sum);
        AscendC::PipeBarrier<PIPE_V>();

        for (int64_t outer = 0; outer < outerSize_; ++outer) {
            int64_t base = (outer * C_ + c) * innerSize_;
            for (int64_t off = 0; off < innerSize_; off += tileElems_) {
                int64_t count = innerSize_ - off;
                if (count > tileElems_) count = tileElems_;
                int64_t alignedCount = AlignElems(count);
                LoadTileAsFloat(base + off, count, alignedCount);
                auto value = valueBuf_.template Get<float>();
                MultiplyScaleReg(value, scale, alignedCount);
                AscendC::PipeBarrier<PIPE_V>();
                StoreFloatTile(base + off, count, alignedCount);
            }
        }
    }

    // Load contiguous g slice g[chanBase : chanBase+count] into gTileBuf_,
    // tail-padded to alignedCount with zeros. Column-aligned with the value tile.
    __aicore__ inline void LoadGTile(int64_t chanBase, int64_t count, int64_t alignedCount)
    {
        auto gLocal = gTileBuf_.template Get<T>();
        int64_t rightPad = alignedCount - count;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(rightPad), static_cast<T>(0)};
        AscendC::DataCopyPad(
            gLocal, gGm_[chanBase], CopyParams(count * sizeof(T)), padParams);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    // innerSize == 1 column-wise path. Process channels [chanBase, chanBase+tileC):
    //   Pass 1: acc[i] += v[r, chanBase+i]^2 over all rows r  (vector lanes = columns)
    //   norm[i] = sqrt(acc[i]); scale[i] = g[chanBase+i] / norm[i]
    //   Pass 2: out[r, chanBase+i] = v[r, chanBase+i] * scale[i] over all rows r
    __aicore__ inline void ComputeColumnTile(int64_t chanBase, int64_t tileC)
    {
        int64_t count = tileC;
        int64_t alignedCount = AlignElems(count);

        auto acc = accBuf_.template Get<float>();
        auto scale = scaleVecBuf_.template Get<float>();
        auto gLocal = gTileBuf_.template Get<T>();

        DuplicateZeroVectorReg(acc, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();

        // Pass 1: accumulate per-column sum of squares across all outer rows.
        for (int64_t r = 0; r < outerSize_; ++r) {
            int64_t base = r * C_ + chanBase; // contiguous slice of `count` channels
            LoadTileAsFloat(base, count, alignedCount);
            auto value = valueBuf_.template Get<float>();
            AccumulateSquaresReg(acc, value, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
        }

        // scale[i] = g[chanBase+i] / sqrt(acc[i])
        LoadGTile(chanBase, count, alignedCount);
        ComputeScaleVectorReg<T>(scale, gLocal, acc, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();

        // Pass 2: apply per-column scale across all outer rows.
        for (int64_t r = 0; r < outerSize_; ++r) {
            int64_t base = r * C_ + chanBase;
            LoadTileAsFloat(base, count, alignedCount);
            auto value = valueBuf_.template Get<float>();
            MultiplyElemwiseReg(value, scale, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            StoreFloatTile(base, count, alignedCount);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> vGm_;
    AscendC::GlobalTensor<T> gGm_;
    AscendC::GlobalTensor<T> outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> valueBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scaleBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scaleVecBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gTileBuf_;
    int64_t outerSize_ = 0;
    int64_t C_ = 0;
    int64_t innerSize_ = 0;
    int64_t tileElems_ = 0;
    int64_t blockStart_ = 0;
    int64_t myValidLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void weight_norm_kernel(
    GM_ADDR v, GM_ADDR g, GM_ADDR out,
    int64_t outerSize, int64_t C, int64_t innerSize,
    int64_t blockLength, int64_t tileElems)
{
    KernelWeightNorm<T> op;
    op.Init(v, g, out, outerSize, C, innerSize, blockLength, tileElems);
    op.Process();
}

template <typename T>
__global__ __aicore__ __vector__ void weight_norm_global_kernel(
    GM_ADDR v, GM_ADDR gBcast, GM_ADDR out, int64_t numel, int64_t tileElems)
{
    KernelWeightNormGlobal<T> op;
    op.Init(v, gBcast, out, numel, tileElems);
    op.Process();
}

// Tile size for the single-AIV global path. Mirrors calc_tiling_params but uses
// the global buffer set: in/out/g queues (T) + value/gFloat scratch (float).
static int64_t calc_global_tile_elems(int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);

    int64_t fixedBytes = 4 * BLOCK_BYTES + 1024;
    //   in/out/g queues : 3 * PIPELINE_DEPTH * tile * sizeof(T)
    //   value, gFloat   : 2 * tile * sizeof(float)
    int64_t bytesPerElem = 3 * PIPELINE_DEPTH * elemSize +
                           2 * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = (static_cast<int64_t>(ubSize) - fixedBytes) / bytesPerElem;
    int64_t alignElems = 16; // multiple of 32B for fp16 and fp32 buffers.
    tileElems = (tileElems / alignElems) * alignElems;
    if (tileElems > MAX_TILE_ELEMS) {
        tileElems = MAX_TILE_ELEMS;
    }
    TORCH_CHECK(tileElems >= alignElems,
                "weight_norm: UB is too small for one aligned global tile");
    return tileElems;
}

// Literal dim == -1: torch's norm_except_dim(v, 2, -1) is the full-tensor L2
// norm (a single scalar over ALL elements), not a per-last-axis norm. g (shape
// [C], C = v.size(-1)) broadcasts element-wise over v's last axis, so in the
// contiguous flat layout gBcast[i] = g[i % C].
static torch::Tensor weight_norm_global_npu(const torch::Tensor &v, const torch::Tensor &g)
{
    const c10::OptionalDeviceGuard guard(v.device());
    auto vContig = v.contiguous();
    auto out = torch::empty(vContig.sizes(), vContig.options());

    // Broadcast g to v's full shape (g is [C] with C == v.size(-1)); flattening
    // the contiguous result yields gBcast[i] = g[i % C].
    const int64_t ndim = vContig.dim();
    std::vector<int64_t> gView(ndim, 1);
    gView[ndim - 1] = vContig.size(ndim - 1);
    auto gBcast = g.contiguous().view(gView).expand(vContig.sizes()).contiguous();

    int64_t numel = vContig.numel();
    int64_t tileElems = calc_global_tile_elems(vContig.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto vPtr = (GM_ADDR)vContig.data_ptr();
    auto gPtr = (GM_ADDR)gBcast.data_ptr();
    auto outPtr = (GM_ADDR)out.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            vContig.scalar_type(), "weight_norm_global_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                weight_norm_global_kernel<float><<<1, nullptr, stream>>>(
                    vPtr, gPtr, outPtr, numel, tileElems);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                weight_norm_global_kernel<half><<<1, nullptr, stream>>>(
                    vPtr, gPtr, outPtr, numel, tileElems);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("WeightNormGlobal", acl_call);
    return out;
}

torch::Tensor weight_norm_npu(const torch::Tensor &v, const torch::Tensor &g, int64_t dim)
{
    // Validate first (check_common normalizes -1 -> ndim-1 and verifies g[C]).
    int64_t normalizedDim = check_common(v, g, dim);

    // Literal dim == -1 is special in torch: norm_except_dim(v, 2, -1) is the
    // GLOBAL full-tensor L2 norm, not the per-last-axis norm. Route to the
    // global path BEFORE the per-channel tiling treats normalizedDim as an axis.
    if (dim == -1) {
        return weight_norm_global_npu(v, g);
    }

    const c10::OptionalDeviceGuard guard(v.device());
    auto vContig = v.contiguous();
    auto gContig = g.contiguous().view({-1});
    auto out = torch::empty(vContig.sizes(), vContig.options());

    int64_t outerSize = 1;
    for (int64_t i = 0; i < normalizedDim; ++i) {
        outerSize *= vContig.size(i);
    }
    int64_t C = vContig.size(normalizedDim);
    int64_t innerSize = 1;
    for (int64_t i = normalizedDim + 1; i < vContig.dim(); ++i) {
        innerSize *= vContig.size(i);
    }

    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(C, vContig.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto vPtr = (GM_ADDR)vContig.data_ptr();
    auto gPtr = (GM_ADDR)gContig.data_ptr();
    auto outPtr = (GM_ADDR)out.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            vContig.scalar_type(), "weight_norm_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                weight_norm_kernel<float><<<numBlocks, nullptr, stream>>>(
                    vPtr, gPtr, outPtr, outerSize, C, innerSize, blockLength, tileElems);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                weight_norm_kernel<half><<<numBlocks, nullptr, stream>>>(
                    vPtr, gPtr, outPtr, outerSize, C, innerSize, blockLength, tileElems);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("WeightNorm", acl_call);
    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("weight_norm", weight_norm_npu);
}

} // namespace WeightNorm
} // namespace ops_multimodal_fusion
