/*!
 * \file foreach_lgamma.asc
 * \brief RegBase ForeachLgamma operator for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.foreach_lgamma(tensors) -> Tensor[]
 *   tensors : non-empty Tensor[] of float32 tensors.
 *   returns : Tensor[] with out[i] = lgamma(tensors[i]).
 *
 * Semantics align with torch._foreach_lgamma / CUDA foreach_tensor_lgamma_cuda.
 * PyTorch lgamma is log(abs(Gamma(x))) for real inputs.
 *
 * Positive x uses the Lanczos g=7 approximation:
 *   lgamma(x) = lgamma(x + 1) - log(x)
 *
 * Non-positive x uses the reflection identity:
 *   lgamma(x) = log(pi) - log(abs(sin(pi*x))) - lgamma(1 - x)
 *
 * Compute follows the asc-from-scratch RegBase shape:
 * __simd_vf__ Reg functions, asc_vf_call wrappers, and AscendC only for
 * queue / GM movement and host launch plumbing.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <cmath>
#include <tuple>
#include <vector>

namespace ops_multimodal_fusion {
namespace ForeachLgamma {

static constexpr int64_t kBlockBytes = 32;
static constexpr int64_t kMinElemsPerCore = 1024;
static constexpr int64_t kPipelineDepth = 2;
static constexpr int64_t kMaxTileElems = 32768;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("foreach_lgamma(Tensor[] tensors) -> Tensor[]");
}

static void check_common(const at::TensorList &tensors, bool checkDevice)
{
    TORCH_CHECK(tensors.size() >= 1,
                "foreach_lgamma: input list must be non-empty");
    for (int64_t i = 0; i < static_cast<int64_t>(tensors.size()); ++i) {
        const auto &t = tensors[i];
        TORCH_CHECK(t.scalar_type() == torch::kFloat32,
                    "foreach_lgamma: only float32 is supported on dav-3510, got tensor[",
                    i, "] dtype=", t.scalar_type());
        if (checkDevice) {
            TORCH_CHECK(t.device().is_privateuseone(),
                        "foreach_lgamma: tensor[", i, "] must be on NPU device");
        }
    }
}

std::vector<torch::Tensor> foreach_lgamma_meta(at::TensorList tensors)
{
    check_common(tensors, /*checkDevice=*/false);
    std::vector<torch::Tensor> out;
    out.reserve(tensors.size());
    for (const auto &t : tensors) {
        out.push_back(torch::empty_like(t));
    }
    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("foreach_lgamma", foreach_lgamma_meta);
}

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t totalLength)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "foreach_lgamma: coreNum must be positive");

    int64_t numBlocks = std::min(
        coreNum, (totalLength + kMinElemsPerCore - 1) / kMinElemsPerCore);
    numBlocks = std::max<int64_t>(numBlocks, 1);
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;

    // Input and output queues are both double-buffered. The actual math uses
    // Reg registers inside asc_vf_call, so no tile-sized VECCALC TBuf is needed.
    int64_t bytesPerElem = kPipelineDepth * 2 * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = kBlockBytes / static_cast<int64_t>(sizeof(float));
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min(tileElems, kMaxTileElems);
    TORCH_CHECK(tileElems > 0,
                "foreach_lgamma: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

static constexpr float kLanczosC0 = 0.99999999999980993f;
static constexpr float kHalfLog2Pi = 0.9189385332046728f;
static constexpr float kPi = 3.14159265358979323846f;
static constexpr float kLogPi = 1.1447298858494002f;
static constexpr float kRoundMagic = 12582912.0f;

#define FOREACH_LGAMMA_LANCZOS_STEP(X_IN, COEF, OFFSET) \
    AscendC::Reg::Adds(denomReg, X_IN, static_cast<float>(OFFSET), mask); \
    AscendC::Reg::Duplicate<float>(coefReg, static_cast<float>(COEF), mask); \
    AscendC::Reg::Div(termReg, coefReg, denomReg, mask); \
    AscendC::Reg::Add(accReg, accReg, termReg, mask)

#define FOREACH_LGAMMA_POS(OUT_REG, X_REG) \
    AscendC::Reg::Duplicate<float>(accReg, kLanczosC0, mask); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, 676.5203681218851f, 1.0f); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, -1259.1392167224028f, 2.0f); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, 771.32342877765313f, 3.0f); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, -176.61502916214059f, 4.0f); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, 12.507343278686905f, 5.0f); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, -0.13857109526572012f, 6.0f); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, 9.9843695780195716e-6f, 7.0f); \
    FOREACH_LGAMMA_LANCZOS_STEP(X_REG, 1.5056327351493116e-7f, 8.0f); \
    AscendC::Reg::Ln(OUT_REG, accReg, mask); \
    AscendC::Reg::Adds(tReg, X_REG, 7.5f, mask); \
    AscendC::Reg::Ln(logReg, tReg, mask); \
    AscendC::Reg::Sub(OUT_REG, OUT_REG, tReg, mask); \
    AscendC::Reg::Adds(tmpReg, X_REG, 0.5f, mask); \
    AscendC::Reg::Mul(tmpReg, tmpReg, logReg, mask); \
    AscendC::Reg::Add(OUT_REG, OUT_REG, tmpReg, mask); \
    AscendC::Reg::Adds(OUT_REG, OUT_REG, kHalfLog2Pi, mask); \
    AscendC::Reg::Ln(tmpReg, X_REG, mask); \
    AscendC::Reg::Sub(OUT_REG, OUT_REG, tmpReg, mask)

#define FOREACH_LGAMMA_SIN_PI(OUT_REG, X_REG) \
    AscendC::Reg::Muls(zReg, X_REG, kPi, mask); \
    AscendC::Reg::Muls(kReg, X_REG, 1.0f, mask); \
    AscendC::Reg::Adds(kReg, kReg, kRoundMagic, mask); \
    AscendC::Reg::Adds(kReg, kReg, -kRoundMagic, mask); \
    AscendC::Reg::Muls(tmpReg, kReg, kPi, mask); \
    AscendC::Reg::Sub(rReg, zReg, tmpReg, mask); \
    AscendC::Reg::Muls(halfKReg, kReg, 0.5f, mask); \
    AscendC::Reg::Adds(halfKReg, halfKReg, kRoundMagic, mask); \
    AscendC::Reg::Adds(halfKReg, halfKReg, -kRoundMagic, mask); \
    AscendC::Reg::Muls(halfKReg, halfKReg, 2.0f, mask); \
    AscendC::Reg::Sub(signReg, kReg, halfKReg, mask); \
    AscendC::Reg::Abs(signReg, signReg, mask); \
    AscendC::Reg::Muls(signReg, signReg, -2.0f, mask); \
    AscendC::Reg::Adds(signReg, signReg, 1.0f, mask); \
    AscendC::Reg::Mul(tReg, rReg, rReg, mask); \
    AscendC::Reg::Duplicate<float>(sinReg, 1.0f / 362880.0f, mask); \
    AscendC::Reg::Mul(sinReg, sinReg, tReg, mask); \
    AscendC::Reg::Adds(sinReg, sinReg, -1.0f / 5040.0f, mask); \
    AscendC::Reg::Mul(sinReg, sinReg, tReg, mask); \
    AscendC::Reg::Adds(sinReg, sinReg, 1.0f / 120.0f, mask); \
    AscendC::Reg::Mul(sinReg, sinReg, tReg, mask); \
    AscendC::Reg::Adds(sinReg, sinReg, -1.0f / 6.0f, mask); \
    AscendC::Reg::Mul(sinReg, sinReg, tReg, mask); \
    AscendC::Reg::Adds(sinReg, sinReg, 1.0f, mask); \
    AscendC::Reg::Mul(OUT_REG, sinReg, rReg, mask); \
    AscendC::Reg::Mul(OUT_REG, OUT_REG, signReg, mask)

__simd_vf__ inline void LgammaFloatRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr,
    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    const float infValue = INFINITY;

    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> outReg;
    AscendC::Reg::RegTensor<float> posReg;
    AscendC::Reg::RegTensor<float> refReg;
    AscendC::Reg::RegTensor<float> oneMinusReg;
    AscendC::Reg::RegTensor<float> accReg;
    AscendC::Reg::RegTensor<float> denomReg;
    AscendC::Reg::RegTensor<float> coefReg;
    AscendC::Reg::RegTensor<float> termReg;
    AscendC::Reg::RegTensor<float> tReg;
    AscendC::Reg::RegTensor<float> logReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::RegTensor<float> zReg;
    AscendC::Reg::RegTensor<float> kReg;
    AscendC::Reg::RegTensor<float> rReg;
    AscendC::Reg::RegTensor<float> signReg;
    AscendC::Reg::RegTensor<float> halfKReg;
    AscendC::Reg::RegTensor<float> sinReg;
    AscendC::Reg::RegTensor<float> absXReg;
    AscendC::Reg::RegTensor<float> absSinReg;
    AscendC::Reg::RegTensor<float> infReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg leZeroMask;
        AscendC::Reg::MaskReg infMask;
        AscendC::Reg::MaskReg nanMask;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, srcAddr + offset);

        // Positive branch: lgamma(x).
        FOREACH_LGAMMA_POS(posReg, xReg);

        // Reflection branch for x <= 0:
        // log(pi) - log(abs(sin(pi*x))) - lgamma(1 - x).
        AscendC::Reg::Duplicate<float>(oneMinusReg, 1.0f, mask);
        AscendC::Reg::Sub(oneMinusReg, oneMinusReg, xReg, mask);
        FOREACH_LGAMMA_POS(refReg, oneMinusReg);
        FOREACH_LGAMMA_SIN_PI(sinReg, xReg);
        AscendC::Reg::Abs(absSinReg, sinReg, mask);
        AscendC::Reg::Ln(absSinReg, absSinReg, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, kLogPi, mask);
        AscendC::Reg::Sub(tmpReg, tmpReg, absSinReg, mask);
        AscendC::Reg::Sub(refReg, tmpReg, refReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(
            leZeroMask, xReg, 0.0f, mask);
        outReg = posReg;
        AscendC::Reg::Select<float>(outReg, refReg, outReg, leZeroMask);

        // Special values: +/-inf -> +inf, NaN -> NaN.
        AscendC::Reg::Abs(absXReg, xReg, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(
            infMask, absXReg, infValue, mask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            nanMask, xReg, xReg, mask);
        AscendC::Reg::Duplicate<float>(infReg, infValue, mask);
        AscendC::Reg::Select<float>(outReg, infReg, outReg, infMask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void LgammaReg(
    AscendC::LocalTensor<float> &dst, AscendC::LocalTensor<float> &src,
    int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LgammaFloatRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

#undef FOREACH_LGAMMA_SIN_PI
#undef FOREACH_LGAMMA_POS
#undef FOREACH_LGAMMA_LANCZOS_STEP

class KernelForeachLgamma {
public:
    __aicore__ inline KernelForeachLgamma() {}

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                int64_t totalLength, int64_t blockLength,
                                int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        inputGm_.SetGlobalBuffer((__gm__ float *)input + blockIdx * blockLength);
        outputGm_.SetGlobalBuffer((__gm__ float *)output + blockIdx * blockLength);

        int64_t tileBytes = ((tileLength_ * static_cast<int64_t>(sizeof(float)) +
                              kBlockBytes - 1) / kBlockBytes) * kBlockBytes;
        pipe_.InitBuffer(inQueue_, kPipelineDepth, tileBytes);
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ?
                (curLength_ - offset) : tileLength_;
            ProcessTile(offset, count);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignElems = kBlockBytes / static_cast<int64_t>(sizeof(float));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;

        AscendC::DataCopyExtParams inParams{
            1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), 1.0f};
        auto inLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopyPad(inLocal, inputGm_[offset], inParams, padParams);
        inQueue_.EnQue(inLocal);

        inLocal = inQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        LgammaReg(outLocal, inLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);

        outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams outParams{
            1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(outputGm_[offset], outLocal, outParams);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> inputGm_;
    AscendC::GlobalTensor<float> outputGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

__global__ __aicore__ __vector__ void foreach_lgamma_kernel(
    GM_ADDR input, GM_ADDR output,
    int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelForeachLgamma op;
    op.Init(input, output, totalLength, blockLength, tileLength);
    op.Process();
}

static void launch_single_tensor(const torch::Tensor &input,
                                 const torch::Tensor &output)
{
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks = 0;
    int64_t blockLength = 0;
    int64_t tileLength = 0;
    std::tie(numBlocks, blockLength, tileLength) =
        calc_tiling_params(totalLength);

    auto inputPtr = (GM_ADDR)input.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    foreach_lgamma_kernel<<<numBlocks, nullptr, stream>>>(
        inputPtr, outputPtr, totalLength, blockLength, tileLength);
}

std::vector<torch::Tensor> foreach_lgamma_npu(at::TensorList tensors)
{
    check_common(tensors, /*checkDevice=*/true);
    const c10::OptionalDeviceGuard guard(tensors[0].device());

    std::vector<torch::Tensor> out;
    out.reserve(tensors.size());

    for (const auto &t : tensors) {
        auto input = t.contiguous();
        auto output = torch::empty_like(input);
        auto aclCall = [input, output]() -> int {
            launch_single_tensor(input, output);
            return 0;
        };
        at_npu::native::OpCommand::RunOpApi("ForeachLgamma", aclCall);
        out.push_back(output);
    }

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("foreach_lgamma", foreach_lgamma_npu);
}

} // namespace ForeachLgamma
} // namespace ops_multimodal_fusion


