/*!
 * \file c2_bucketize.asc
 * \brief Caffe2 Bucketize operator for Ascend NPU (dav-3510), RegBase
 *        implementation (vectorized count, mirrors in-tree searchsorted).
 *
 * Schema:  c2_bucketize(Tensor self, float[] boundaries) -> Tensor
 *   self        input tensor, ndim >= 1, dtype fp32 / fp16
 *   boundaries  monotonically-increasing float list (Caffe2 `boundaries`
 *               attribute); host-side, converted to a self-dtype device buffer
 *   returns     int32 tensor, shape == self.shape, where
 *                   out[i] = #{ j : boundaries[j] < self[i] }
 *               (= torch.bucketize(self, boundaries, right=False)).
 *
 * Algorithm (count per element, same as searchsorted):
 *   boundaries are loaded once into UB at Init (each AIV its own copy).
 *   Per self element x:
 *     1. Reg::Compares<T, LT>(ltMask, boundsReg, x, validMask) -> lanes where boundaries[j] < x
 *     2. Reg::Reduce<SUM, T, T, ZEROING>(countReg, onesReg, ltMask)  -> count = bucket index
 *   Layer 3 reads the T-typed count from a 32B scratch slot, casts to int32 (scalar),
 *   and writes it directly to the int32 output (Caffe2 output dtype is int32, so no
 *   int64 lane-pack is needed).
 *
 * Dispatch scope (first version):
 *   - self ndim >= 1; dtype fp32 / fp16 (int32 / bf16 / int64 deferred; Caffe2 is
 *     float-only). Output always int32.
 *   - boundaries monotonically increasing (host TORCH_CHECK); count M <= vec_width
 *     per dtype (fp32=64 / fp16=128) so the whole boundaries array fits one reg
 *     (mirrors searchsorted's N<=vec_width; chunked path deferred).
 *   - right=False fixed (Caffe2 semantics); empty boundaries -> all-zero output.
 *
 * 3-layer Reg shape:
 *   Layer 1: __simd_vf__ BucketizeCountVf<T>  - LoadAlign + Compares<LT> + Reduce<SUM>
 *   Layer 2: __aicore__ BucketizeCount<T>     - LocalTensor -> (__ubuf__ T*) cast, asc_vf_call
 *   Layer 3: KernelC2Bucketize<T>             - boundaries-once load, per-tile self stream,
 *                                               per-elem vf, int32 idx write
 *
 * UB layout per core:
 *   tbufBounds:    M * sizeof(T)               // boundaries (persistent, loaded once)
 *   inQueueSelf:   PIPELINE_DEPTH * elemsPerTile * sizeof(T)
 *   tbufScratch:   elemsPerTile * 32B          // per-elem T-typed count slot
 *   outQueueIdx:   elemsPerTile * sizeof(int32)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <vector>

namespace ops_multimodal_fusion {
namespace C2Bucketize {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_bucketize(Tensor self, float[] boundaries) -> Tensor");
}

// ===================== 2. Meta =====================

static void validate_args(const torch::Tensor &self, at::ArrayRef<double> boundaries)
{
    TORCH_CHECK(self.dim() >= 1,
                "c2_bucketize: self must have at least 1 dimension, got 0-D");
    TORCH_CHECK(self.scalar_type() == torch::kFloat32 ||
                self.scalar_type() == torch::kFloat16,
                "c2_bucketize: self dtype must be float32 / float16, got ",
                self.scalar_type(),
                ". int32 / bf16 / int64 / fp64 are deferred on this platform.");
    for (size_t j = 1; j < boundaries.size(); ++j) {
        TORCH_CHECK(boundaries[j] >= boundaries[j - 1],
                    "c2_bucketize: boundaries must be monotonically increasing; "
                    "boundaries[", j, "]=", boundaries[j], " < boundaries[", j - 1,
                    "]=", boundaries[j - 1]);
    }
    const int64_t vecWidth = (self.scalar_type() == torch::kFloat16) ? 128 : 64;
    TORCH_CHECK(static_cast<int64_t>(boundaries.size()) <= vecWidth,
                "c2_bucketize: boundaries count M=", boundaries.size(),
                " exceeds vec_width=", vecWidth, " for dtype ", self.scalar_type(),
                "; chunked-boundaries path is deferred");
}

torch::Tensor c2_bucketize_meta(const torch::Tensor &self, at::ArrayRef<double> boundaries)
{
    validate_args(self, boundaries);
    return torch::empty(self.sizes(), self.options().dtype(torch::kInt32));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_bucketize", c2_bucketize_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t Nq, int64_t Mb, size_t bytesPerT)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t ELEMS_PER_TILE_PREFERRED = 32;
    constexpr static int64_t SCALAR_SLOT_BYTES = 32;
    constexpr static int64_t SAFETY_MARGIN = 1024;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_bucketize: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum,
        (Nq + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (Nq + numBlocks - 1) / numBlocks;

    int64_t boundsBytes = Mb * static_cast<int64_t>(bytesPerT);
    int64_t bytesPerStagedElem =
        static_cast<int64_t>(PIPELINE_DEPTH) * static_cast<int64_t>(bytesPerT)
      + SCALAR_SLOT_BYTES
      + static_cast<int64_t>(sizeof(int32_t));

    int64_t budgetForStaging =
        static_cast<int64_t>(ubSize) - boundsBytes - SAFETY_MARGIN;
    TORCH_CHECK(budgetForStaging >= bytesPerStagedElem,
                "c2_bucketize: M=", Mb, " too large for dav-3510 UB. boundsBytes=",
                boundsBytes, ", ubSize=", ubSize);

    int64_t elemsPerTile = budgetForStaging / bytesPerStagedElem;
    if (elemsPerTile > ELEMS_PER_TILE_PREFERRED) elemsPerTile = ELEMS_PER_TILE_PREFERRED;
    if (elemsPerTile < 1) elemsPerTile = 1;
    if (elemsPerTile > blockLength) elemsPerTile = blockLength;

    return std::make_tuple(numBlocks, blockLength, elemsPerTile);
}

// ===================== 4. Kernel -- 3-layer Reg shape =====================

// Layer 1: LoadAlign boundaries, Compares<LT> against the scalar query x, Reduce<SUM>
// the ones-vector under the LT mask. UpdateMask<T>(M) keeps trailing junk lanes out of
// both the ones-fill and the LT mask, so they never contribute to the count.
template <typename T>
__simd_vf__ inline void BucketizeCountVf(
    __ubuf__ T *boundsPtr, T value, __ubuf__ T *countOutPtr, uint32_t M)
{
    AscendC::Reg::RegTensor<T> boundsReg;
    AscendC::Reg::RegTensor<T> onesReg;
    AscendC::Reg::RegTensor<T> countReg;

    AscendC::Reg::MaskReg validMask = AscendC::Reg::UpdateMask<T>(M);
    uint32_t scalarOne = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<T>(scalarOne);

    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(boundsReg, boundsPtr);

    T oneValue;
    if constexpr (std::is_same_v<T, half>) {
        oneValue = T(1.0f);
    } else {
        oneValue = static_cast<T>(1);
    }
    AscendC::Reg::Duplicate<T, AscendC::Reg::MaskMergeMode::ZEROING>(
        onesReg, oneValue, validMask);

    AscendC::Reg::MaskReg ltMask;
    AscendC::Reg::Compares<T, AscendC::CMPMODE::LT>(
        ltMask, boundsReg, value, validMask);

    AscendC::Reg::Reduce<
        AscendC::Reg::ReduceType::SUM, T, T, AscendC::Reg::MaskMergeMode::ZEROING>(
            countReg, onesReg, ltMask);

    AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        countOutPtr, countReg, scalarMask);
}

// Layer 2: __aicore__ wrapper. LocalTensor -> __ubuf__ T* via GetPhyAddr.
template <typename T>
__aicore__ inline void BucketizeCount(
    AscendC::LocalTensor<T> &boundsUbufLT, T value,
    AscendC::LocalTensor<T> &scratchLT, uint32_t slotIdx, uint32_t M)
{
    constexpr uint32_t SCALAR_SLOT_LANES_T = 32 / sizeof(T);
    __ubuf__ T *boundsPtr = (__ubuf__ T *)boundsUbufLT.GetPhyAddr();
    __ubuf__ T *outPtr    = (__ubuf__ T *)scratchLT.GetPhyAddr()
                            + slotIdx * SCALAR_SLOT_LANES_T;
    asc_vf_call<BucketizeCountVf<T>>(boundsPtr, value, outPtr, M);
}

// Layer 3: kernel class -- boundaries-once load, per-tile self stream, per-elem vf.
template <typename T>
class KernelC2Bucketize {
public:
    __aicore__ inline KernelC2Bucketize() {}

    __aicore__ inline void Init(GM_ADDR boundaries, GM_ADDR self, GM_ADDR out,
        int64_t Mb, int64_t Nq, int64_t blockLength, uint32_t elemsPerTile)
    {
        boundsGm_.SetGlobalBuffer((__gm__ T *)boundaries);
        selfGm_.SetGlobalBuffer((__gm__ T *)self);
        outGm_.SetGlobalBuffer((__gm__ int32_t *)out);

        Mb_ = Mb;
        Nq_ = Nq;
        elemsPerTile_ = elemsPerTile;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myBlockLength = Nq - blockStart;
        if (myBlockLength > blockLength) myBlockLength = blockLength;
        if (myBlockLength < 0) myBlockLength = 0;
        blockStart_ = blockStart;
        myBlockLength_ = myBlockLength;

        const uint32_t boundsBytes  = static_cast<uint32_t>(Mb * sizeof(T));
        const uint32_t selfBytes    = elemsPerTile * static_cast<uint32_t>(sizeof(T));
        const uint32_t scratchBytes = elemsPerTile * 32u;
        const uint32_t outBytes     = elemsPerTile * static_cast<uint32_t>(sizeof(int32_t));

        pipe_.InitBuffer(tbufBounds_,                     boundsBytes);
        pipe_.InitBuffer(inQueueSelf_,  PIPELINE_DEPTH,   selfBytes);
        pipe_.InitBuffer(tbufScratch_,                    scratchBytes);
        pipe_.InitBuffer(outQueueIdx_,  1u,               outBytes);

        // One-time load of boundaries; persistent for every query on this AIV.
        AscendC::LocalTensor<T> boundsLocal = tbufBounds_.template Get<T>();
        AscendC::DataCopyExtParams boundsCp;
        AscendC::DataCopyPadExtParams<T> boundsPad{false, 0, 0, 0};
        boundsCp.blockCount = 1;
        boundsCp.blockLen   = boundsBytes;
        boundsCp.srcStride  = 0;
        boundsCp.dstStride  = 0;
        AscendC::DataCopyPad(boundsLocal, boundsGm_, boundsCp, boundsPad);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void Process()
    {
        if (myBlockLength_ <= 0) return;
        int64_t consumed = 0;
        while (consumed < myBlockLength_) {
            int64_t tileCount = myBlockLength_ - consumed;
            if (tileCount > static_cast<int64_t>(elemsPerTile_)) {
                tileCount = elemsPerTile_;
            }
            ProcessTile(blockStart_ + consumed, tileCount);
            consumed += tileCount;
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t elemStart, int64_t count)
    {
        AscendC::LocalTensor<T> boundsLocal = tbufBounds_.template Get<T>();
        AscendC::LocalTensor<T> scratch     = tbufScratch_.template Get<T>();

        AscendC::LocalTensor<T> selfLocal = inQueueSelf_.template AllocTensor<T>();
        AscendC::DataCopyExtParams selfCp;
        AscendC::DataCopyPadExtParams<T> selfPad{false, 0, 0, 0};
        selfCp.blockCount = 1;
        selfCp.blockLen   = static_cast<uint32_t>(count * sizeof(T));
        selfCp.srcStride  = 0;
        selfCp.dstStride  = 0;
        AscendC::DataCopyPad(selfLocal, selfGm_[elemStart], selfCp, selfPad);
        inQueueSelf_.EnQue(selfLocal);
        selfLocal = inQueueSelf_.template DeQue<T>();
        AscendC::PipeBarrier<PIPE_ALL>();

        constexpr uint32_t SCALAR_SLOT_LANES_T = 32 / sizeof(T);

        for (int64_t q = 0; q < count; ++q) {
            T value = selfLocal.GetValue(q);
            BucketizeCount<T>(boundsLocal, value, scratch,
                              static_cast<uint32_t>(q), static_cast<uint32_t>(Mb_));
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        inQueueSelf_.FreeTensor(selfLocal);

        // Read T-typed counts -> int32 output (direct; Caffe2 output is int32).
        AscendC::LocalTensor<int32_t> outIdx = outQueueIdx_.template AllocTensor<int32_t>();
        for (int64_t q = 0; q < count; ++q) {
            T tval = scratch.GetValue(q * SCALAR_SLOT_LANES_T);
            int32_t idx;
            if constexpr (std::is_same_v<T, half>) {
                idx = static_cast<int32_t>(static_cast<float>(tval));
            } else {
                idx = static_cast<int32_t>(tval);
            }
            outIdx.SetValue(static_cast<int32_t>(q), idx);
        }
        outQueueIdx_.EnQue(outIdx);
        outIdx = outQueueIdx_.template DeQue<int32_t>();

        AscendC::DataCopyExtParams outCp;
        outCp.blockCount = 1;
        outCp.blockLen   = static_cast<uint32_t>(count * sizeof(int32_t));
        outCp.srcStride  = 0;
        outCp.dstStride  = 0;
        AscendC::DataCopyPad(outGm_[elemStart], outIdx, outCp);
        outQueueIdx_.FreeTensor(outIdx);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       boundsGm_;
    AscendC::GlobalTensor<T>       selfGm_;
    AscendC::GlobalTensor<int32_t> outGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>                tbufBounds_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueSelf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>                tbufScratch_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1>              outQueueIdx_;
    int64_t Mb_ = 0;
    int64_t Nq_ = 0;
    int64_t blockStart_ = 0;
    int64_t myBlockLength_ = 0;
    uint32_t elemsPerTile_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_bucketize_kernel(
    GM_ADDR boundaries, GM_ADDR self, GM_ADDR out,
    int64_t Mb, int64_t Nq, int64_t blockLength, uint32_t elemsPerTile)
{
    KernelC2Bucketize<T> op;
    op.Init(boundaries, self, out, Mb, Nq, blockLength, elemsPerTile);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor c2_bucketize_npu(const torch::Tensor &self, at::ArrayRef<double> boundaries)
{
    validate_args(self, boundaries);

    const auto dtype = self.scalar_type();
    const c10::OptionalDeviceGuard guard(self.device());
    auto self_contig = self.contiguous();
    auto self_flat   = self_contig.view({-1});
    const int64_t Nq = self_flat.numel();
    const int64_t Mb = static_cast<int64_t>(boundaries.size());

    auto out_flat = torch::empty({Nq}, self_contig.options().dtype(torch::kInt32));
    auto out      = out_flat.view(self_contig.sizes());

    // Empty input -> empty output; empty boundaries -> all elements get bucket 0.
    if (Nq == 0) {
        return out;
    }
    if (Mb == 0) {
        out.zero_();
        return out;
    }

    // boundaries (double[]) -> self-dtype device buffer.
    auto bounds_cpu = torch::empty({Mb}, torch::TensorOptions().dtype(torch::kFloat32));
    auto *bp = bounds_cpu.data_ptr<float>();
    for (int64_t j = 0; j < Mb; ++j) {
        bp[j] = static_cast<float>(boundaries[j]);
    }
    auto bounds_dev = bounds_cpu.to(dtype).to(self.device());

    const size_t bytesPerT = (dtype == torch::kFloat16) ? 2u : 4u;
    int64_t numBlocks, blockLength, elemsPerTile;
    std::tie(numBlocks, blockLength, elemsPerTile) = calc_tiling_params(Nq, Mb, bytesPerT);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto bounds_ptr = (GM_ADDR)bounds_dev.data_ptr();
    auto self_ptr   = (GM_ADDR)self_flat.data_ptr();
    auto out_ptr    = (GM_ADDR)out_flat.data_ptr();
    const uint32_t elemsPerTileU = static_cast<uint32_t>(elemsPerTile);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            self_contig.scalar_type(), "c2_bucketize_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_bucketize_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    bounds_ptr, self_ptr, out_ptr, Mb, Nq, blockLength, elemsPerTileU);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_bucketize_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    bounds_ptr, self_ptr, out_ptr, Mb, Nq, blockLength, elemsPerTileU);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2Bucketize", acl_call);

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_bucketize", c2_bucketize_npu);
}

} // namespace C2Bucketize
} // namespace ops_multimodal_fusion
