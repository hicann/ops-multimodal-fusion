/*!
 * \file nested_bmm.asc
 * \brief Nested Batched Matrix Multiplication for Ascend NPU (dav-3510),
 *        RegBase vector-path outer-product implementation (grouped GEMM).
 *
 * Schema:
 *   nested_bmm(Tensor a_values, Tensor b_values, Tensor sizes) -> Tensor
 *
 *   a_values : 1-D flat (sum_i M_i*K_i,), contiguous, dtype in {fp32, fp16}
 *   b_values : 1-D flat (sum_i K_i*N_i,), same dtype
 *   sizes    : 2-D (B, 3) int64, per-row [M_i, K_i, N_i]
 *   out      : 1-D flat (sum_i M_i*N_i,), same dtype as inputs
 *
 *   For each batch i:  C_i = A_i @ B_i,
 *   where A_i is (M_i, K_i), B_i is (K_i, N_i), C_i is (M_i, N_i),
 *   stored row-major flat.
 *
 * Algorithm: vector-path outer product per (m, n_chunk):
 *   for k in [0, K_i): C[m, n_chunk] += A[m, k] * B[k, n_chunk]
 *
 * Constraint: N_i * sizeof(T) % 32 == 0  (Reg::LoadAlign / StoreAlign
 *   row-stride alignment); fp32 N_i%8, fp16 N_i%16.
 *
 * 3-layer Reg shape:
 *   Layer 1 vf functions:
 *     BmmStartStepRegVf<T>  : C[m, n_chunk] = A[m, 0] * B[0, n_chunk]
 *     BmmAccumStepRegVf<T>  : C[m, n_chunk] += A[m, k] * B[k, n_chunk]
 *   Layer 2 __aicore__ wrapper:
 *     BmmOuterProduct<T>    : (m, n_chunk) outer loop; K inner loop calls
 *                             vf once per k; scalar A[m, k] read via
 *                             LocalTensor::GetValue + passed as parameter
 *   Layer 3 kernel class:
 *     KernelNestedBmm<T>    : per-batch loop reading (M_i, K_i, N_i, offsets)
 *                             from sizesPacked UB; per-batch DMA-in A_i, B_i;
 *                             dispatch to BmmOuterProduct; DMA-out C_i.
 *
 * Host side packs sizes(B,3) + per-batch element-offsets into sizesPacked(B,6)
 * int64 GM tensor: [M_i, K_i, N_i, aOff_i, bOff_i, cOff_i].
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace NestedBmm {

constexpr static int64_t PIPELINE_DEPTH = 2;
constexpr static int64_t SAFETY_BYTES   = 1024;
constexpr static int64_t PACK_FIELDS    = 6;   // M, K, N, aOff, bOff, cOff

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("nested_bmm(Tensor a_values, Tensor b_values, Tensor sizes) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor nested_bmm_meta(
    const torch::Tensor &a_values, const torch::Tensor &b_values,
    const torch::Tensor &sizes)
{
    TORCH_CHECK(a_values.dim() == 1,
                "nested_bmm: a_values must be 1-D, got ", a_values.dim(), "-D");
    TORCH_CHECK(b_values.dim() == 1,
                "nested_bmm: b_values must be 1-D, got ", b_values.dim(), "-D");
    TORCH_CHECK(sizes.dim() == 2 && sizes.size(1) == 3,
                "nested_bmm: sizes must be 2-D (B, 3), got ",
                sizes.dim(), "-D shape=", sizes.sizes());
    TORCH_CHECK(sizes.scalar_type() == torch::kInt64,
                "nested_bmm: sizes dtype must be int64, got ", sizes.scalar_type());
    TORCH_CHECK(a_values.scalar_type() == b_values.scalar_type(),
                "nested_bmm: dtype mismatch a=", a_values.scalar_type(),
                " b=", b_values.scalar_type());

    // Compute total output element count from sizes on CPU.
    auto sizes_cpu = sizes.cpu().contiguous();
    const int64_t *p = sizes_cpu.const_data_ptr<int64_t>();
    int64_t totalOut = 0;
    const int64_t B = sizes.size(0);
    for (int64_t i = 0; i < B; ++i) {
        totalOut += p[i * 3 + 0] * p[i * 3 + 2];   // M_i * N_i
    }
    return torch::empty({totalOut}, a_values.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("nested_bmm", nested_bmm_meta);
}

// ===================== 3. Kernel - 3-layer Reg shape =====================

// --------- Layer 1 vf functions ---------
//
// Outer-product K-accumulation step. scalarA is passed as runtime function
// parameter (host-read from UB via LocalTensor::GetValue at wrapper level).
// `Reg::Muls(dst, src, scalar, mask)` does broadcast-mul without needing
// an explicit Duplicate, matching csrc/rms_norm_gated/dav-3510 MulsRegVf.

template <typename T>
__simd_vf__ inline void BmmStartStepRegVf(
    __ubuf__ T *cChunkPtr, __ubuf__ T *bRowChunkPtr,
    T scalarA, uint32_t nRemaining)
{
    AscendC::Reg::RegTensor<T> bRowReg;
    AscendC::Reg::RegTensor<T> cReg;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(nRemaining);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
        bRowReg, bRowChunkPtr);
    AscendC::Reg::Muls(cReg, bRowReg, scalarA, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        cChunkPtr, cReg, mask);
}

template <typename T>
__simd_vf__ inline void BmmAccumStepRegVf(
    __ubuf__ T *cChunkPtr, __ubuf__ T *bRowChunkPtr,
    T scalarA, uint32_t nRemaining)
{
    AscendC::Reg::RegTensor<T> bRowReg;
    AscendC::Reg::RegTensor<T> cAccReg;
    AscendC::Reg::RegTensor<T> tmpReg;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(nRemaining);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
        cAccReg, cChunkPtr);
    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
        bRowReg, bRowChunkPtr);
    AscendC::Reg::Muls(tmpReg, bRowReg, scalarA, mask);
    AscendC::Reg::Add(cAccReg, cAccReg, tmpReg, mask);
    AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        cChunkPtr, cAccReg, mask);
}

// --------- Layer 2 wrapper ---------

template <typename T>
__aicore__ inline void BmmOuterProduct(
    AscendC::LocalTensor<T> &c, AscendC::LocalTensor<T> &a, AscendC::LocalTensor<T> &b,
    int64_t M, int64_t K, int64_t N)
{
    __ubuf__ T *cPtr = (__ubuf__ T *)c.GetPhyAddr();
    __ubuf__ T *bPtr = (__ubuf__ T *)b.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t nU = static_cast<uint32_t>(N);
    uint32_t nChunkCount = (nU + vectorLength - 1) / vectorLength;

    for (int64_t m = 0; m < M; ++m) {
        for (uint32_t nChunk = 0; nChunk < nChunkCount; ++nChunk) {
            uint32_t nOffset = nChunk * vectorLength;
            uint32_t nRemaining = nU - nOffset;

            T scalarA0 = a.GetValue(m * K);
            asc_vf_call<BmmStartStepRegVf<T>>(
                cPtr + m * nU + nOffset,
                bPtr + 0 * nU + nOffset,
                scalarA0, nRemaining);

            for (int64_t k = 1; k < K; ++k) {
                T scalarA = a.GetValue(m * K + k);
                asc_vf_call<BmmAccumStepRegVf<T>>(
                    cPtr + m * nU + nOffset,
                    bPtr + k * nU + nOffset,
                    scalarA, nRemaining);
            }
        }
    }
}

// --------- Layer 3 kernel class ---------

template <typename T>
class KernelNestedBmm {
public:
    __aicore__ inline KernelNestedBmm() {}

    __aicore__ inline void Init(
        GM_ADDR aValues, GM_ADDR bValues, GM_ADDR cValues,
        GM_ADDR sizesPacked,
        int64_t batchSize,
        int64_t maxARows, int64_t maxBRows, int64_t maxCRows,
        int64_t blockBatchLength)
    {
        aGm_.SetGlobalBuffer((__gm__ T *)aValues);
        bGm_.SetGlobalBuffer((__gm__ T *)bValues);
        cGm_.SetGlobalBuffer((__gm__ T *)cValues);
        sizesGm_.SetGlobalBuffer((__gm__ int64_t *)sizesPacked);
        batchSize_ = batchSize;

        int64_t blockStart = blockBatchLength * AscendC::GetBlockIdx();
        int64_t myLength = batchSize - blockStart;
        if (myLength > blockBatchLength) myLength = blockBatchLength;
        if (myLength < 0) myLength = 0;
        blockStart_ = blockStart;
        myLength_   = myLength;

        const uint32_t aBytes = static_cast<uint32_t>(maxARows * sizeof(T));
        const uint32_t bBytes = static_cast<uint32_t>(maxBRows * sizeof(T));
        const uint32_t cBytes = static_cast<uint32_t>(maxCRows * sizeof(T));
        const uint32_t sizesBytes =
            static_cast<uint32_t>(batchSize * PACK_FIELDS * sizeof(int64_t));

        pipe_.InitBuffer(tbufSizes_, sizesBytes);
        pipe_.InitBuffer(inQueueA_,  PIPELINE_DEPTH, aBytes);
        pipe_.InitBuffer(inQueueB_,  PIPELINE_DEPTH, bBytes);
        pipe_.InitBuffer(outQueueC_, PIPELINE_DEPTH, cBytes);
    }

    __aicore__ inline void Process()
    {
        if (myLength_ <= 0) return;

        // DMA sizesPacked into UB once.
        AscendC::LocalTensor<int64_t> sizesLocal = tbufSizes_.template Get<int64_t>();
        AscendC::DataCopyExtParams cpSizes;
        cpSizes.blockCount = 1;
        cpSizes.blockLen   =
            static_cast<uint32_t>(batchSize_ * PACK_FIELDS * sizeof(int64_t));
        cpSizes.srcStride = 0; cpSizes.dstStride = 0;
        AscendC::DataCopyPadExtParams<int64_t> padI{false, 0, 0,
                                                    static_cast<int64_t>(0)};
        AscendC::DataCopyPad(sizesLocal, sizesGm_, cpSizes, padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyPadExtParams<T> padT{false, 0, 0, T{}};

        for (int64_t i = blockStart_; i < blockStart_ + myLength_; ++i) {
            const int64_t M_i    = sizesLocal.GetValue(i * PACK_FIELDS + 0);
            const int64_t K_i    = sizesLocal.GetValue(i * PACK_FIELDS + 1);
            const int64_t N_i    = sizesLocal.GetValue(i * PACK_FIELDS + 2);
            const int64_t aOff_i = sizesLocal.GetValue(i * PACK_FIELDS + 3);
            const int64_t bOff_i = sizesLocal.GetValue(i * PACK_FIELDS + 4);
            const int64_t cOff_i = sizesLocal.GetValue(i * PACK_FIELDS + 5);
            if (M_i <= 0 || K_i <= 0 || N_i <= 0) continue;

            // DMA in A_i (M_i * K_i elements).
            AscendC::DataCopyExtParams cpA;
            cpA.blockCount = 1;
            cpA.blockLen   = static_cast<uint32_t>(M_i * K_i * sizeof(T));
            cpA.srcStride  = 0; cpA.dstStride = 0;
            AscendC::LocalTensor<T> aLocal = inQueueA_.template AllocTensor<T>();
            AscendC::DataCopyPad(aLocal, aGm_[aOff_i], cpA, padT);
            inQueueA_.EnQue(aLocal);

            // DMA in B_i (K_i * N_i elements).
            AscendC::DataCopyExtParams cpB;
            cpB.blockCount = 1;
            cpB.blockLen   = static_cast<uint32_t>(K_i * N_i * sizeof(T));
            cpB.srcStride  = 0; cpB.dstStride = 0;
            AscendC::LocalTensor<T> bLocal = inQueueB_.template AllocTensor<T>();
            AscendC::DataCopyPad(bLocal, bGm_[bOff_i], cpB, padT);
            inQueueB_.EnQue(bLocal);

            aLocal = inQueueA_.template DeQue<T>();
            bLocal = inQueueB_.template DeQue<T>();

            // Compute: cLocal = aLocal @ bLocal  (outer-product over K).
            AscendC::LocalTensor<T> cLocal = outQueueC_.template AllocTensor<T>();
            BmmOuterProduct<T>(cLocal, aLocal, bLocal, M_i, K_i, N_i);
            outQueueC_.EnQue(cLocal);
            inQueueA_.FreeTensor(aLocal);
            inQueueB_.FreeTensor(bLocal);

            // DMA out C_i (M_i * N_i elements).
            AscendC::DataCopyExtParams cpC;
            cpC.blockCount = 1;
            cpC.blockLen   = static_cast<uint32_t>(M_i * N_i * sizeof(T));
            cpC.srcStride  = 0; cpC.dstStride = 0;
            cLocal = outQueueC_.template DeQue<T>();
            AscendC::DataCopyPad(cGm_[cOff_i], cLocal, cpC);
            outQueueC_.FreeTensor(cLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       aGm_;
    AscendC::GlobalTensor<T>       bGm_;
    AscendC::GlobalTensor<T>       cGm_;
    AscendC::GlobalTensor<int64_t> sizesGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>             tbufSizes_;
    AscendC::TQue<AscendC::QuePosition::VECIN,  PIPELINE_DEPTH> inQueueA_;
    AscendC::TQue<AscendC::QuePosition::VECIN,  PIPELINE_DEPTH> inQueueB_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, PIPELINE_DEPTH> outQueueC_;
    int64_t batchSize_ = 0;
    int64_t blockStart_ = 0;
    int64_t myLength_   = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void nested_bmm_kernel(
    GM_ADDR aValues, GM_ADDR bValues, GM_ADDR cValues,
    GM_ADDR sizesPacked,
    int64_t batchSize,
    int64_t maxARows, int64_t maxBRows, int64_t maxCRows,
    int64_t blockBatchLength)
{
    KernelNestedBmm<T> op;
    op.Init(aValues, bValues, cValues, sizesPacked,
            batchSize, maxARows, maxBRows, maxCRows,
            blockBatchLength);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

torch::Tensor nested_bmm_npu(
    const torch::Tensor &a_values, const torch::Tensor &b_values,
    const torch::Tensor &sizes)
{
    auto dtype = a_values.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 || dtype == torch::kFloat16,
                "nested_bmm: only float32 / float16 supported, got ", dtype);
    TORCH_CHECK(a_values.dim() == 1,
                "nested_bmm: a_values must be 1-D, got ", a_values.dim(), "-D");
    TORCH_CHECK(b_values.dim() == 1,
                "nested_bmm: b_values must be 1-D, got ", b_values.dim(), "-D");
    TORCH_CHECK(sizes.dim() == 2 && sizes.size(1) == 3,
                "nested_bmm: sizes must be 2-D (B, 3), got shape=", sizes.sizes());
    TORCH_CHECK(sizes.scalar_type() == torch::kInt64,
                "nested_bmm: sizes dtype must be int64, got ", sizes.scalar_type());
    TORCH_CHECK(b_values.scalar_type() == dtype,
                "nested_bmm: dtype mismatch a=", dtype,
                " b=", b_values.scalar_type());

    const int64_t B = sizes.size(0);
    TORCH_CHECK(B >= 1, "nested_bmm: batch B must be >= 1, got ", B);

    const size_t bytesPerT = (dtype == torch::kFloat16) ? 2u : 4u;
    const int64_t alignElems = 32 / static_cast<int64_t>(bytesPerT);

    // Host-side scan: validate per-batch dims, compute offsets, max sizes,
    // and total element counts.
    auto sizes_cpu = sizes.cpu().contiguous();
    const int64_t *p = sizes_cpu.const_data_ptr<int64_t>();

    int64_t expectedASize = 0;
    int64_t expectedBSize = 0;
    int64_t expectedCSize = 0;
    int64_t maxARows = 0, maxBRows = 0, maxCRows = 0;

    // sizesPacked: (B, 6) int64 = [M_i, K_i, N_i, aOff_i, bOff_i, cOff_i]
    auto sizesPacked_cpu = torch::empty({B, PACK_FIELDS}, sizes.options().device(torch::kCPU));
    int64_t *q = sizesPacked_cpu.data_ptr<int64_t>();

    for (int64_t i = 0; i < B; ++i) {
        int64_t M_i = p[i * 3 + 0];
        int64_t K_i = p[i * 3 + 1];
        int64_t N_i = p[i * 3 + 2];
        TORCH_CHECK(M_i >= 1 && K_i >= 1 && N_i >= 1,
                    "nested_bmm: per-batch M/K/N must be >= 1 at i=", i,
                    " (M=", M_i, " K=", K_i, " N=", N_i, ")");
        TORCH_CHECK(N_i % alignElems == 0,
                    "nested_bmm: N_i=", N_i, " at batch i=", i,
                    " must be a multiple of ", alignElems,
                    " (32B / sizeof(dtype)) for Reg::LoadAlign row alignment");

        q[i * PACK_FIELDS + 0] = M_i;
        q[i * PACK_FIELDS + 1] = K_i;
        q[i * PACK_FIELDS + 2] = N_i;
        q[i * PACK_FIELDS + 3] = expectedASize;
        q[i * PACK_FIELDS + 4] = expectedBSize;
        q[i * PACK_FIELDS + 5] = expectedCSize;

        expectedASize += M_i * K_i;
        expectedBSize += K_i * N_i;
        expectedCSize += M_i * N_i;
        maxARows = std::max(maxARows, M_i * K_i);
        maxBRows = std::max(maxBRows, K_i * N_i);
        maxCRows = std::max(maxCRows, M_i * N_i);
    }

    TORCH_CHECK(a_values.size(0) == expectedASize,
                "nested_bmm: a_values size=", a_values.size(0),
                " mismatches sum(M_i*K_i)=", expectedASize);
    TORCH_CHECK(b_values.size(0) == expectedBSize,
                "nested_bmm: b_values size=", b_values.size(0),
                " mismatches sum(K_i*N_i)=", expectedBSize);

    // UB capacity check.
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "nested_bmm: coreNum must be positive");

    int64_t perBatchUb =
        PIPELINE_DEPTH * (maxARows + maxBRows + maxCRows) *
        static_cast<int64_t>(bytesPerT) +
        B * PACK_FIELDS * static_cast<int64_t>(sizeof(int64_t)) + SAFETY_BYTES;
    TORCH_CHECK(perBatchUb <= static_cast<int64_t>(ubSize),
                "nested_bmm: max per-batch UB ", perBatchUb,
                " exceeds UB ", ubSize,
                " (maxM*K=", maxARows, ", maxK*N=", maxBRows,
                ", maxM*N=", maxCRows, ", bytes_per_elem=", bytesPerT, ")");

    int64_t numBlocks = std::min(coreNum, B);
    if (numBlocks < 1) numBlocks = 1;
    int64_t blockBatchLength = (B + numBlocks - 1) / numBlocks;

    auto a_c   = a_values.contiguous();
    auto b_c   = b_values.contiguous();
    auto out   = torch::empty({expectedCSize}, a_c.options());

    // Short-circuit: nothing to compute.
    if (expectedCSize == 0) return out;

    const c10::OptionalDeviceGuard guard(a_values.device());
    auto sizesPacked_npu = sizesPacked_cpu.to(a_values.device(), /*non_blocking=*/false);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto aPtr = (GM_ADDR)a_c.data_ptr();
    auto bPtr = (GM_ADDR)b_c.data_ptr();
    auto cPtr = (GM_ADDR)out.data_ptr();
    auto sPtr = (GM_ADDR)sizesPacked_npu.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            a_c.scalar_type(), "nested_bmm_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                nested_bmm_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    aPtr, bPtr, cPtr, sPtr,
                    B, maxARows, maxBRows, maxCRows,
                    blockBatchLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                nested_bmm_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    aPtr, bPtr, cPtr, sPtr,
                    B, maxARows, maxBRows, maxCRows,
                    blockBatchLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("NestedBmm", acl_call);

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("nested_bmm", nested_bmm_npu);
}

} // namespace NestedBmm
} // namespace ops_multimodal_fusion
