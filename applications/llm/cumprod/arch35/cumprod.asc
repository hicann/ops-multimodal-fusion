/*!
 * \file cumprod.asc
 * \brief Cumprod scan operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.cumprod(x, dim) -> y
 *   y[..., i, ...] = product(x[..., 0:i+1, ...]) along dim.
 *
 * Scope: float16 and float32. float16 accumulates in float Reg tensors and
 * stores back to half. bfloat16, float64 and integer inputs are rejected in
 * this first dav-3510 Reg implementation.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Cumprod {

static constexpr int64_t kPipelineDepth = 2;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("cumprod(Tensor x, int dim) -> Tensor");
}

static int64_t normalize_dim(int64_t dim, int64_t ndim)
{
    int64_t logicalRank = (ndim == 0) ? 1 : ndim;
    if (dim < 0) {
        dim += logicalRank;
    }
    TORCH_CHECK(dim >= 0 && dim < logicalRank,
                "cumprod: dim ", dim, " out of range for tensor of ndim ", ndim);
    return dim;
}

torch::Tensor cumprod_meta(const torch::Tensor &x, int64_t dim)
{
    normalize_dim(dim, x.dim());
    TORCH_CHECK(x.scalar_type() == torch::kFloat16 ||
                x.scalar_type() == torch::kFloat32,
                "cumprod: expected Half or Float inputs on dav-3510 Reg path, got ",
                x.scalar_type());
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("cumprod", cumprod_meta);
}

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t outerSize, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "cumprod: coreNum must be positive.");

    int64_t numBlocks = std::min(coreNum, outerSize);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t outerPerBlock = (outerSize + numBlocks - 1) / numBlocks;

    int64_t queueBytesPerElem = kPipelineDepth * 2 * elemSize;
    int64_t scratchBytesPerElem = (elemSize == static_cast<int64_t>(sizeof(half)))
        ? static_cast<int64_t>(sizeof(float)) * 2
        : elemSize;
    int64_t tileElems = static_cast<int64_t>(ubSize) /
        (queueBytesPerElem + scratchBytesPerElem);
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "cumprod: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, outerPerBlock, tileElems);
}

template <typename T>
__simd_vf__ inline void CumprodFloatInitVf(__ubuf__ T *outAddr, __ubuf__ T *carryAddr,
                                           __ubuf__ T *xAddr, uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> xReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            carryAddr + offset, xReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, xReg, mask);
    }
}

template <typename T>
__simd_vf__ inline void CumprodFloatStepVf(__ubuf__ T *outAddr, __ubuf__ T *carryAddr,
                                           __ubuf__ T *xAddr, uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> xReg;
    AscendC::Reg::RegTensor<T> carryReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            carryReg, carryAddr + offset);
        AscendC::Reg::Mul(carryReg, carryReg, xReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            carryAddr + offset, carryReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, carryReg, mask);
    }
}

__simd_vf__ inline void CumprodHalfInitVf(__ubuf__ half *outAddr, __ubuf__ float *carryAddr,
                                          __ubuf__ half *xAddr, uint32_t count,
                                          uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<half> outHalfReg;
    AscendC::Reg::RegTensor<float> carryReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(carryReg, xHalfReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            carryAddr + offset, carryReg, mask);
        AscendC::Reg::Cast<half, float, castToHalf>(outHalfReg, carryReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            outAddr + offset, outHalfReg, mask);
    }
}

__simd_vf__ inline void CumprodHalfStepVf(__ubuf__ half *outAddr, __ubuf__ float *carryAddr,
                                          __ubuf__ half *xAddr, uint32_t count,
                                          uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<half> outHalfReg;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> carryReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            carryReg, carryAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, xHalfReg, mask);
        AscendC::Reg::Mul(carryReg, carryReg, xReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            carryAddr + offset, carryReg, mask);
        AscendC::Reg::Cast<half, float, castToHalf>(outHalfReg, carryReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            outAddr + offset, outHalfReg, mask);
    }
}

template <typename T>
__aicore__ inline void CumprodFloatInit(AscendC::LocalTensor<T> &out,
                                        AscendC::LocalTensor<T> &carry,
                                        AscendC::LocalTensor<T> &x,
                                        int64_t count)
{
    __ubuf__ T *outAddr = (__ubuf__ T *)out.GetPhyAddr();
    __ubuf__ T *carryAddr = (__ubuf__ T *)carry.GetPhyAddr();
    __ubuf__ T *xAddr = (__ubuf__ T *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CumprodFloatInitVf<T>>(outAddr, carryAddr, xAddr, elementCount, chunkCount);
}

template <typename T>
__aicore__ inline void CumprodFloatStep(AscendC::LocalTensor<T> &out,
                                        AscendC::LocalTensor<T> &carry,
                                        AscendC::LocalTensor<T> &x,
                                        int64_t count)
{
    __ubuf__ T *outAddr = (__ubuf__ T *)out.GetPhyAddr();
    __ubuf__ T *carryAddr = (__ubuf__ T *)carry.GetPhyAddr();
    __ubuf__ T *xAddr = (__ubuf__ T *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CumprodFloatStepVf<T>>(outAddr, carryAddr, xAddr, elementCount, chunkCount);
}

__aicore__ inline void CumprodHalfInit(AscendC::LocalTensor<half> &out,
                                       AscendC::LocalTensor<float> &carry,
                                       AscendC::LocalTensor<half> &x,
                                       int64_t count)
{
    __ubuf__ half *outAddr = (__ubuf__ half *)out.GetPhyAddr();
    __ubuf__ float *carryAddr = (__ubuf__ float *)carry.GetPhyAddr();
    __ubuf__ half *xAddr = (__ubuf__ half *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CumprodHalfInitVf>(outAddr, carryAddr, xAddr, elementCount, chunkCount);
}

__aicore__ inline void CumprodHalfStep(AscendC::LocalTensor<half> &out,
                                       AscendC::LocalTensor<float> &carry,
                                       AscendC::LocalTensor<half> &x,
                                       int64_t count)
{
    __ubuf__ half *outAddr = (__ubuf__ half *)out.GetPhyAddr();
    __ubuf__ float *carryAddr = (__ubuf__ float *)carry.GetPhyAddr();
    __ubuf__ half *xAddr = (__ubuf__ half *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CumprodHalfStepVf>(outAddr, carryAddr, xAddr, elementCount, chunkCount);
}

template <typename T>
class KernelCumprod {
public:
    __aicore__ inline KernelCumprod() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t outerSize, int64_t dimSize, int64_t innerSize,
        int64_t outerPerBlock, uint32_t tileElems)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        yGm_.SetGlobalBuffer((__gm__ T *)y);
        outerSize_ = outerSize;
        dimSize_ = dimSize;
        innerSize_ = innerSize;
        outerStart_ = AscendC::GetBlockIdx() * outerPerBlock;
        outerCount_ = outerSize - outerStart_;
        if (outerCount_ > outerPerBlock) {
            outerCount_ = outerPerBlock;
        }
        if (outerCount_ < 0) {
            outerCount_ = 0;
        }
        tileElems_ = tileElems;
        pipe_.InitBuffer(inQueue_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileElems * sizeof(T));
        if constexpr (std::is_same<T, half>::value) {
            pipe_.InitBuffer(tbufCarryFloat_, tileElems * sizeof(float));
        } else {
            pipe_.InitBuffer(tbufCarry_, tileElems * sizeof(T));
        }
    }

    __aicore__ inline void Process()
    {
        for (int64_t o = 0; o < outerCount_; ++o) {
            int64_t outer = outerStart_ + o;
            for (int64_t inner = 0; inner < innerSize_; inner += tileElems_) {
                int64_t count = innerSize_ - inner;
                if (count > tileElems_) {
                    count = tileElems_;
                }
                ProcessTile(outer, inner, count);
            }
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t outer, int64_t innerStart, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = static_cast<uint32_t>(count * sizeof(T));
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(1)};

        for (int64_t d = 0; d < dimSize_; ++d) {
            int64_t offset = (outer * dimSize_ + d) * innerSize_ + innerStart;
            AscendC::LocalTensor<T> xLocal = inQueue_.template AllocTensor<T>();
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            inQueue_.EnQue(xLocal);
            xLocal = inQueue_.template DeQue<T>();

            AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
            if constexpr (std::is_same<T, half>::value) {
                auto carry = tbufCarryFloat_.template Get<float>();
                if (d == 0) {
                    CumprodHalfInit(outLocal, carry, xLocal, alignedCount);
                } else {
                    CumprodHalfStep(outLocal, carry, xLocal, alignedCount);
                }
            } else {
                auto carry = tbufCarry_.template Get<T>();
                if (d == 0) {
                    CumprodFloatInit<T>(outLocal, carry, xLocal, alignedCount);
                } else {
                    CumprodFloatStep<T>(outLocal, carry, xLocal, alignedCount);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();

            outQueue_.EnQue(outLocal);
            inQueue_.FreeTensor(xLocal);
            outLocal = outQueue_.template DeQue<T>();
            AscendC::DataCopyPad(yGm_[offset], outLocal, copyParams);
            outQueue_.FreeTensor(outLocal);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCarry_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCarryFloat_;
    int64_t outerSize_ = 0;
    int64_t dimSize_ = 0;
    int64_t innerSize_ = 0;
    int64_t outerStart_ = 0;
    int64_t outerCount_ = 0;
    uint32_t tileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void cumprod_kernel(
    GM_ADDR x, GM_ADDR y, int64_t outerSize, int64_t dimSize, int64_t innerSize,
    int64_t outerPerBlock, uint32_t tileElems)
{
    KernelCumprod<T> op;
    op.Init(x, y, outerSize, dimSize, innerSize, outerPerBlock, tileElems);
    op.Process();
}

torch::Tensor cumprod_npu(const torch::Tensor &x_in, int64_t dim)
{
    TORCH_CHECK(x_in.scalar_type() == torch::kFloat16 ||
                x_in.scalar_type() == torch::kFloat32,
                "cumprod: expected Half or Float inputs on dav-3510 Reg path, got ",
                x_in.scalar_type());
    const c10::OptionalDeviceGuard guard(x_in.device());
    auto x = x_in.contiguous();
    int64_t ndim = x.dim();
    int64_t dimNorm = normalize_dim(dim, ndim);
    auto y = torch::empty_like(x);
    if (x.numel() == 0) {
        return y;
    }

    int64_t outerSize = 1;
    int64_t dimSize = 1;
    int64_t innerSize = 1;
    if (ndim == 0) {
        dimSize = 1;
    } else {
        dimSize = x.size(dimNorm);
        for (int64_t i = 0; i < dimNorm; ++i) {
            outerSize *= x.size(i);
        }
        for (int64_t i = dimNorm + 1; i < ndim; ++i) {
            innerSize *= x.size(i);
        }
    }
    if (dimSize == 0) {
        return y;
    }

    int64_t numBlocks, outerPerBlock, tileElems;
    std::tie(numBlocks, outerPerBlock, tileElems) =
        calc_tiling_params(outerSize, x.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();
    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "cumprod_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                cumprod_kernel<half><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, outerSize, dimSize, innerSize,
                    outerPerBlock, static_cast<uint32_t>(tileElems));
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                cumprod_kernel<float><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, outerSize, dimSize, innerSize,
                    outerPerBlock, static_cast<uint32_t>(tileElems));
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Cumprod", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("cumprod", cumprod_npu);
}

} // namespace Cumprod
} // namespace ops_multimodal_fusion
