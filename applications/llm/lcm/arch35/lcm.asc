/*!
 * \file lcm.asc
 * \brief LCM (least common multiple) operator for Ascend NPU (dav-3510).
 *
 * torch.lcm(a, b) -> c
 *
 * Scope (per issue #100): int32 on dav-3510. PyTorch's `torch.lcm` is
 * defined only for integer dtypes; we ship int32, mirroring the integer
 * support already present in `csrc/add/dav-3510/add.asc`.
 *
 * Algorithm:
 *   gcd via the standard Euclidean recurrence, lcm built on top:
 *
 *     lcm(a, b) = 0                              if a == 0 or b == 0
 *     lcm(a, b) = (|a| / gcd(|a|, |b|)) * |b|    otherwise
 *
 *   torch.lcm's reference implementation is `std::abs(a / g * b)` -
 *   the multiplication is performed in the input dtype (int32) and
 *   wraps on overflow, then `std::abs` is applied to the wrapped int32
 *   result. We reproduce this two-step semantic exactly:
 *     1. compute `(|a|/g)*|b|` in int64 (no UB even for INT32_MIN),
 *     2. take the low 32 bits as a signed int32 (the wrap),
 *     3. apply abs to that int32 (`abs(INT32_MIN) == INT32_MIN` under
 *        two's complement, matching PyTorch).
 *   Intermediate absolute values and GCD are also int64 so INT32_MIN
 *   inputs do not trigger C++ signed-negation overflow.
 *
 * Implementation note: the AscendC vector engine on dav-3510 has no
 * integer-modulo primitive, and the Euclidean algorithm has a
 * data-dependent termination condition (variable iteration count per
 * element), which makes a pure-vector implementation impractical without
 * fp casting (which loses precision past 2^24). We therefore process
 * each element via the scalar pipeline (`LocalTensor::GetValue` /
 * `SetValue`) inside the per-tile compute step. Cross-tile parallelism
 * (via per-core block split + PIPELINE_DEPTH double buffering on the
 * MTE2/MTE3 sides) is preserved; only the inner GCD loop is scalar.
 *
 * Pipeline synchronization: `PipeBarrier<PIPE_ALL>` is used before the
 * scalar loop (to wait for MTE2 DataCopyPad on aLocal/bLocal) and after
 * the scalar loop (to ensure scalar writes to cLocal complete before the
 * subsequent MTE3 DataCopyPad reads).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace LCM {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("lcm(Tensor a, Tensor b) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor lcm_meta(const torch::Tensor &a, const torch::Tensor &b)
{
    TORCH_CHECK(a.sizes() == b.sizes(),
                "lcm: shapes must match, got ", a.sizes(), " vs ", b.sizes());
    TORCH_CHECK(a.scalar_type() == b.scalar_type(),
                "lcm: dtypes must match, got ", a.scalar_type(),
                " vs ", b.scalar_type());
    TORCH_CHECK(a.scalar_type() == torch::kInt32,
                "lcm: only int32 is supported on dav-3510, got ",
                a.scalar_type());
    return torch::empty_like(a);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("lcm", lcm_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 3; // 6 (a, b, c × 2)
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = static_cast<int64_t>(ubSize) / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // align to 32 bytes
    TORCH_CHECK(tileSize > 0, "lcm: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// ===================== 4. Kernel =====================

class KernelLCM {
public:
    __aicore__ inline KernelLCM() {}

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        aGm_.SetGlobalBuffer((__gm__ int32_t *)a + blockLength * AscendC::GetBlockIdx());
        bGm_.SetGlobalBuffer((__gm__ int32_t *)b + blockLength * AscendC::GetBlockIdx());
        cGm_.SetGlobalBuffer((__gm__ int32_t *)c + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueA_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(inQueueB_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueC_, PIPELINE_DEPTH, tileSize);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileSize / sizeof(int32_t);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(int32_t);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<int32_t> padParams{false, 0, 0, 0};

        AscendC::LocalTensor<int32_t> aLocal = inQueueA_.template AllocTensor<int32_t>();
        AscendC::LocalTensor<int32_t> bLocal = inQueueB_.template AllocTensor<int32_t>();
        AscendC::DataCopyPad(aLocal, aGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(bLocal, bGm_[offset], copyParams, padParams);
        inQueueA_.EnQue(aLocal);
        inQueueB_.EnQue(bLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<int32_t> aLocal = inQueueA_.template DeQue<int32_t>();
        AscendC::LocalTensor<int32_t> bLocal = inQueueB_.template DeQue<int32_t>();
        AscendC::LocalTensor<int32_t> cLocal = outQueueC_.template AllocTensor<int32_t>();

        // MTE2 -> S synchronization: ensure DataCopyPad completed before scalar reads.
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t i = 0; i < count; ++i) {
            int32_t x = aLocal.GetValue(i);
            int32_t y = bLocal.GetValue(i);
            cLocal.SetValue(i, LcmScalar(x, y));
        }

        // S -> MTE3 synchronization: ensure scalar writes complete before DMA reads.
        AscendC::PipeBarrier<PIPE_ALL>();

        inQueueA_.FreeTensor(aLocal);
        inQueueB_.FreeTensor(bLocal);
        outQueueC_.EnQue(cLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<int32_t> cLocal = outQueueC_.template DeQue<int32_t>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(int32_t);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(cGm_[offset], cLocal, copyParams);
        outQueueC_.FreeTensor(cLocal);
    }

    static __aicore__ inline int32_t LcmScalar(int32_t a, int32_t b)
    {
        if (a == 0 || b == 0) {
            return 0;
        }

        int64_t a64 = static_cast<int64_t>(a);
        int64_t b64 = static_cast<int64_t>(b);
        int64_t aabs = a64 < 0 ? -a64 : a64;
        int64_t babs = b64 < 0 ? -b64 : b64;

        // Euclidean GCD on absolute values (int64 throughout so INT32_MIN
        // does not trigger signed-negation overflow).
        int64_t x = aabs;
        int64_t y = babs;
        while (y != 0) {
            int64_t t = x % y;
            x = y;
            y = t;
        }

        // torch.lcm = std::abs(a / g * b). The product is computed in the
        // input dtype, so it wraps; std::abs is then applied to the
        // wrapped int32 result. Reproduce both steps:
        //   1. take the low 32 bits as a signed int32 (= int32 wrap),
        //   2. apply abs to that int32 (abs(INT32_MIN) stays INT32_MIN
        //      under two's complement, matching PyTorch).
        int64_t lcm_val = (aabs / x) * babs;
        int32_t signed_low = static_cast<int32_t>(static_cast<uint32_t>(lcm_val));
        if (signed_low == static_cast<int32_t>(0x80000000)) {
            return signed_low;  // abs(INT32_MIN) == INT32_MIN
        }
        return signed_low < 0 ? -signed_low : signed_low;
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<int32_t> aGm_, bGm_, cGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueA_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueB_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueC_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

__global__ __aicore__ __vector__ void lcm_kernel(
    GM_ADDR a, GM_ADDR b, GM_ADDR c,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelLCM op;
    op.Init(a, b, c, totalLength, blockLength, tileSize);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor lcm_npu(const torch::Tensor &a_in, const torch::Tensor &b_in)
{
    TORCH_CHECK(a_in.sizes() == b_in.sizes(),
                "lcm: shapes must match, got ", a_in.sizes(), " vs ", b_in.sizes());
    TORCH_CHECK(a_in.scalar_type() == b_in.scalar_type(),
                "lcm: dtypes must match, got ", a_in.scalar_type(),
                " vs ", b_in.scalar_type());
    TORCH_CHECK(a_in.scalar_type() == torch::kInt32,
                "lcm: only int32 is supported on dav-3510, got ",
                a_in.scalar_type());

    const c10::OptionalDeviceGuard guard(a_in.device());
    auto a = a_in.contiguous();
    auto b = b_in.contiguous();
    auto c = torch::empty_like(a);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = a.numel();
    if (totalLength == 0) {
        return c;
    }
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto a_ptr = (GM_ADDR)a.data_ptr();
    auto b_ptr = (GM_ADDR)b.data_ptr();
    auto c_ptr = (GM_ADDR)c.data_ptr();

    auto acl_call = [=]() -> int {
        lcm_kernel<<<numBlocks, nullptr, stream>>>(
            a_ptr, b_ptr, c_ptr, totalLength, blockLength, tileSize);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Lcm", acl_call);
    return c;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("lcm", lcm_npu);
}

} // namespace LCM
} // namespace ops_multimodal_fusion
