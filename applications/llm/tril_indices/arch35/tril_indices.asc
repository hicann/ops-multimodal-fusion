/*!
 * \file tril_indices.asc
 * \brief TrilIndices factory operator for Ascend NPU (dav-3510), RegBase.
 *
 * torch.tril_indices(row, col, offset=0, *, dtype=long) -> Tensor(2, N)
 *   Coordinates (row-major) of the lower-triangle of a row x col matrix:
 *   L = {(r,c) : 0<=r<row, 0<=c<col, c <= r+offset}.
 *   out[0,i] = row coord, out[1,i] = col coord, N = get_tril_size(row,col,offset).
 *
 * Equivalence to the CUDA analytical kernel
 *   The CUDA tril_indices_kernel inverts the row-major prefix-sum per element
 *   via a sqrt root resolve (top trapezoid) / div-mod (bottom rectangle).
 *   This port uses the mathematically identical *forward* per-row decomposition:
 *   row r contributes nnz(r) = clamp(r+offset+1, 0, col) consecutive columns
 *   [0, nnz(r)) starting at output offset row_start[r] (the same prefix sum the
 *   CUDA sqrt formula inverts). It produces byte-identical output, is exact for
 *   any size (no fp32 sqrt precision bound), and needs no integer div/mod.
 *
 * RegBase compute (3-layer shape):
 *   Layer 1: __simd_vf__ TrilIndicesGenRegVf - per chunk: Reg::Duplicate the
 *            int32 row constant; Reg::LoadAlign the column iota; StoreAlign both
 *            contiguous (DIST_NORM_B32).
 *   Layer 2: __aicore__ TrilIndicesGen - LocalTensor -> __ubuf__ cast.
 *   Layer 3: KernelTrilIndices - per (row, column-tile) DMA + dispatch. int32
 *            out: vf writes the VECOUT queue directly, single DataCopyPad. int64
 *            out: vf -> scratch, then a scalar stride-2 pack (out[2j]=v,
 *            out[2j+1]=0) -> int64 GM low/high. The scalar pack is the
 *            searchsorted-proven int64 path (avoids the int32->int64 Cast with
 *            no binary here); a vectorized DIST_INTLV_B32 reinterpret matched
 *            the simulator but produced a wrong layout on real hardware.
 *
 * Host supplies: m_first_row/tril_size (get_tril_size), per-core rowStart array,
 *   and an int32 iota[0..maxNnz). All exact int; no input tensor.
 *
 * Dispatch scope: dtype int32 / int64 (out_int32 selects), exactly matching
 *   OpInfo('tril_indices', dtypes=(int32,int64)); row,col >= 0; tril_size and
 *   max(row,col) <= INT32_MAX.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <tuple>

namespace ops_multimodal_fusion {
namespace TrilIndices {

static constexpr int64_t kPipelineDepth = 2;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("tril_indices(int row, int col, int offset, bool out_int32) -> Tensor");
}

// get_tril_size: faithful to aten/src/ATen/native/TensorFactories.h.
static int64_t get_tril_size(int64_t row, int64_t col, int64_t offset)
{
    if (row == 0 || col == 0) {
        return 0;
    }
    int64_t m_first_row = offset > 0
        ? std::min<int64_t>(col, 1 + offset)
        : static_cast<int64_t>(row + offset > 0);
    int64_t m_last_row = std::max<int64_t>(0, std::min<int64_t>(col, row + offset));
    int64_t n_row_all = std::max<int64_t>(0, std::min<int64_t>(row, row + offset));
    int64_t n_row_trapezoid = (m_last_row - m_first_row + 1);
    int64_t tril_size = (m_first_row + m_last_row) * n_row_trapezoid >> 1;
    int64_t diff_row = n_row_all - n_row_trapezoid;
    if (diff_row > 0) {
        tril_size += diff_row * col;
    }
    return tril_size;
}

// nnz(r) = number of lower-triangle columns in row r = clamp(r+offset+1, 0, col).
static inline int64_t row_nnz(int64_t r, int64_t col, int64_t offset)
{
    int64_t v = r + offset + 1;
    if (v < 0) v = 0;
    if (v > col) v = col;
    return v;
}

// ===================== 2. Meta =====================

torch::Tensor tril_indices_meta(int64_t row, int64_t col, int64_t offset, bool out_int32)
{
    TORCH_CHECK(row >= 0, "tril_indices: row must be non-negative, got ", row);
    TORCH_CHECK(col >= 0, "tril_indices: col must be non-negative, got ", col);
    int64_t tril_size = get_tril_size(row, col, offset);
    auto dtype = out_int32 ? torch::kInt32 : torch::kInt64;
    return torch::empty({2, tril_size}, torch::TensorOptions().dtype(dtype).device(torch::kMeta));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("tril_indices", tril_indices_meta);
}

// ===================== 3. Tiling =====================

// One AI core owns a contiguous range of rows. Within a row the column segment
// [0, nnz) is tiled by tileElems. UB budget per tile: iota(int32) + rowScratch +
// colScratch, each at the int64 stride-2 width (2x) so one tileElems serves both
// dtypes; PIPELINE_DEPTH double-buffers the iota input + packed output queues.
static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t row, int64_t maxNnz)
{
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = plat->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "tril_indices: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, row);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t rowsPerBlock = (row + numBlocks - 1) / numBlocks;

    // bytes/elem: iota in-queue (PIPELINE_DEPTH*4) + row&col out-queues
    // (PIPELINE_DEPTH*8 each, int64 stride-2 = 2 int32) + int64 row&col
    // scratch (4 each). Conservative (reserves scratch even for int32).
    constexpr int64_t bytesPerElem =
        kPipelineDepth * 4 + kPipelineDepth * 8 * 2 + 8;
    constexpr int64_t SAFETY_MARGIN = 2048;
    int64_t tileElems = (static_cast<int64_t>(ubSize) - SAFETY_MARGIN) / bytesPerElem;
    int64_t alignElems = 32 / 4;  // int32 lane alignment (8)
    tileElems = (tileElems / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "tril_indices: UB too small for one aligned tile");
    if (maxNnz > 0 && tileElems > maxNnz) {
        tileElems = ((maxNnz + alignElems - 1) / alignElems) * alignElems;
    }
    return std::make_tuple(numBlocks, rowsPerBlock, tileElems);
}

// ===================== 4. Kernel — 3-layer Reg shape =====================

// Layer 1. rowConst is broadcast (Reg::Duplicate); iota columns are loaded and
// re-stored. Always DIST_NORM_B32 contiguous int32; the int64 low/high stride-2
// layout is assembled by a scalar pack in Layer 3 (see file header).
__simd_vf__ inline void TrilIndicesGenRegVf(
    __ubuf__ int32_t *rowOutPtr, __ubuf__ int32_t *colOutPtr,
    __ubuf__ int32_t *iotaInPtr, int32_t rowConst,
    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    AscendC::Reg::RegTensor<int32_t> rowReg;
    AscendC::Reg::RegTensor<int32_t> colReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<int32_t>(remaining);
        AscendC::Reg::LoadAlign<int32_t, AscendC::Reg::LoadDist::DIST_NORM>(
            colReg, iotaInPtr + offset);
        AscendC::Reg::Duplicate<int32_t>(rowReg, rowConst, mask);
        AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            rowOutPtr + offset, rowReg, mask);
        AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            colOutPtr + offset, colReg, mask);
    }
}

// Layer 2.
__aicore__ inline void TrilIndicesGen(
    AscendC::LocalTensor<int32_t> &rowDst,
    AscendC::LocalTensor<int32_t> &colDst,
    AscendC::LocalTensor<int32_t> &iotaLocal,
    int32_t rowConst, int64_t count)
{
    __ubuf__ int32_t *rowPtr  = (__ubuf__ int32_t *)rowDst.GetPhyAddr();
    __ubuf__ int32_t *colPtr  = (__ubuf__ int32_t *)colDst.GetPhyAddr();
    __ubuf__ int32_t *iotaPtr = (__ubuf__ int32_t *)iotaLocal.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<TrilIndicesGenRegVf>(
        rowPtr, colPtr, iotaPtr, rowConst, elementCount, chunkCount);
}

// Layer 3.
template <bool I64>
class KernelTrilIndices {
public:
    __aicore__ inline KernelTrilIndices() {}

    __aicore__ inline void Init(GM_ADDR out, GM_ADDR iota, GM_ADDR rowStart,
        int64_t row, int64_t col, int64_t offset, int64_t trilSize,
        int64_t rowsPerBlock, uint32_t tileElems)
    {
        // out viewed as int32: int32 dtype -> element k at idx k;
        // int64 dtype -> element k at idx 2k (low) / 2k+1 (high=0).
        outGm_.SetGlobalBuffer((__gm__ int32_t *)out);
        iotaGm_.SetGlobalBuffer((__gm__ int32_t *)iota);
        rowStartGm_.SetGlobalBuffer((__gm__ int32_t *)rowStart);

        col_ = col;
        offset_ = offset;
        trilSize_ = trilSize;
        tileElems_ = tileElems;

        blockRowStart_ = AscendC::GetBlockIdx() * rowsPerBlock;
        int64_t remaining = row - blockRowStart_;
        blockRows_ = (remaining < rowsPerBlock) ? remaining : rowsPerBlock;
        if (blockRows_ < 0) blockRows_ = 0;

        const uint32_t iotaBytes = tileElems * static_cast<uint32_t>(sizeof(int32_t));
        const uint32_t outBytes =
            tileElems * static_cast<uint32_t>(sizeof(int32_t)) * (I64 ? 2u : 1u);
        const uint32_t rsBytes =
            static_cast<uint32_t>((blockRows_ > 0 ? blockRows_ : 1) * sizeof(int32_t));

        pipe_.InitBuffer(inQueueIota_,  kPipelineDepth, iotaBytes);
        pipe_.InitBuffer(outQueueRow_,  kPipelineDepth, outBytes);
        pipe_.InitBuffer(outQueueCol_,  kPipelineDepth, outBytes);
        pipe_.InitBuffer(tbufRowStart_, ((rsBytes + 31u) / 32u) * 32u);
        if constexpr (I64) {
            // int64 path: vf -> contiguous int32 scratch -> scalar stride-2 pack.
            pipe_.InitBuffer(tbufRow_, iotaBytes);
            pipe_.InitBuffer(tbufCol_, iotaBytes);
        }

        // Load this core's rowStart slice once.
        if (blockRows_ > 0) {
            AscendC::LocalTensor<int32_t> rsLocal = tbufRowStart_.Get<int32_t>();
            AscendC::DataCopyExtParams rsCp;
            AscendC::DataCopyPadExtParams<int32_t> rsPad{false, 0, 0, 0};
            rsCp.blockCount = 1;
            rsCp.blockLen = static_cast<uint32_t>(blockRows_ * sizeof(int32_t));
            rsCp.srcStride = 0;
            rsCp.dstStride = 0;
            AscendC::DataCopyPad(rsLocal, rowStartGm_[blockRowStart_], rsCp, rsPad);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

    __aicore__ inline void Process()
    {
        if (blockRows_ <= 0) return;
        AscendC::LocalTensor<int32_t> rsLocal = tbufRowStart_.Get<int32_t>();
        for (int64_t i = 0; i < blockRows_; ++i) {
            int64_t r = blockRowStart_ + i;
            int64_t nnz = RowNnz(r);
            if (nnz <= 0) continue;
            int64_t rowStart = static_cast<int64_t>(rsLocal.GetValue(i));
            for (int64_t c0 = 0; c0 < nnz; c0 += tileElems_) {
                int64_t cnt = nnz - c0;
                if (cnt > tileElems_) cnt = tileElems_;
                ProcessTile(r, rowStart, c0, cnt);
            }
        }
    }

private:
    __aicore__ inline int64_t RowNnz(int64_t r)
    {
        int64_t v = r + offset_ + 1;
        if (v < 0) v = 0;
        if (v > col_) v = col_;
        return v;
    }

    __aicore__ inline void ProcessTile(int64_t r, int64_t rowStart,
                                        int64_t c0, int64_t cnt)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(int32_t));
        int64_t alignedCnt = ((cnt + alignElems - 1) / alignElems) * alignElems;

        // Column iota [c0, c0+cnt) -> UB (contiguous, srcStride 0).
        AscendC::LocalTensor<int32_t> iotaLocal = inQueueIota_.AllocTensor<int32_t>();
        AscendC::DataCopyExtParams iotaCp;
        AscendC::DataCopyPadExtParams<int32_t> iotaPad{
            true, 0, static_cast<uint8_t>(alignedCnt - cnt), 0};
        iotaCp.blockCount = 1;
        iotaCp.blockLen = static_cast<uint32_t>(cnt * sizeof(int32_t));
        iotaCp.srcStride = 0;
        iotaCp.dstStride = 0;
        AscendC::DataCopyPad(iotaLocal, iotaGm_[c0], iotaCp, iotaPad);
        inQueueIota_.EnQue(iotaLocal);
        iotaLocal = inQueueIota_.DeQue<int32_t>();
        AscendC::PipeBarrier<PIPE_ALL>();

        // out[0, k] -> flat k; out[1, k] -> flat trilSize_ + k. int64 -> *2.
        int64_t base = rowStart + c0;
        AscendC::DataCopyExtParams oCp;
        oCp.blockCount = 1;
        oCp.srcStride = 0;
        oCp.dstStride = 0;

        if constexpr (I64) {
            // vf -> contiguous int32 scratch; scalar stride-2 pack into the
            // VECOUT queues (out[2j]=value, out[2j+1]=0) so the int64 GM reads
            // back as low=value/high=0. searchsorted-proven; the vectorized
            // DIST_INTLV_B32 reinterpret was simulator-only-correct (wrong on real hardware).
            AscendC::LocalTensor<int32_t> rowScratch = tbufRow_.Get<int32_t>();
            AscendC::LocalTensor<int32_t> colScratch = tbufCol_.Get<int32_t>();
            TrilIndicesGen(rowScratch, colScratch, iotaLocal,
                           static_cast<int32_t>(r), alignedCnt);
            AscendC::PipeBarrier<PIPE_ALL>();
            inQueueIota_.FreeTensor(iotaLocal);

            AscendC::LocalTensor<int32_t> rowOut = outQueueRow_.AllocTensor<int32_t>();
            AscendC::LocalTensor<int32_t> colOut = outQueueCol_.AllocTensor<int32_t>();
            for (int64_t j = 0; j < cnt; ++j) {
                rowOut.SetValue(2 * j,     rowScratch.GetValue(j));
                rowOut.SetValue(2 * j + 1, 0);
                colOut.SetValue(2 * j,     colScratch.GetValue(j));
                colOut.SetValue(2 * j + 1, 0);
            }
            outQueueRow_.EnQue(rowOut);
            outQueueCol_.EnQue(colOut);
            rowOut = outQueueRow_.DeQue<int32_t>();
            colOut = outQueueCol_.DeQue<int32_t>();

            oCp.blockLen = static_cast<uint32_t>(cnt) * 8u;
            AscendC::DataCopyPad(outGm_[base * 2], rowOut, oCp);
            AscendC::DataCopyPad(outGm_[(trilSize_ + base) * 2], colOut, oCp);
            outQueueRow_.FreeTensor(rowOut);
            outQueueCol_.FreeTensor(colOut);
        } else {
            // int32: vf writes the VECOUT queue directly (A5-verified); one
            // DataCopyPad moves the exact cnt-element segment (handles non-32B).
            AscendC::LocalTensor<int32_t> rowOut = outQueueRow_.AllocTensor<int32_t>();
            AscendC::LocalTensor<int32_t> colOut = outQueueCol_.AllocTensor<int32_t>();
            TrilIndicesGen(rowOut, colOut, iotaLocal,
                           static_cast<int32_t>(r), alignedCnt);
            AscendC::PipeBarrier<PIPE_V>();
            inQueueIota_.FreeTensor(iotaLocal);
            outQueueRow_.EnQue(rowOut);
            outQueueCol_.EnQue(colOut);
            rowOut = outQueueRow_.DeQue<int32_t>();
            colOut = outQueueCol_.DeQue<int32_t>();

            oCp.blockLen = static_cast<uint32_t>(cnt) * 4u;
            AscendC::DataCopyPad(outGm_[base], rowOut, oCp);
            AscendC::DataCopyPad(outGm_[trilSize_ + base], colOut, oCp);
            outQueueRow_.FreeTensor(rowOut);
            outQueueCol_.FreeTensor(colOut);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<int32_t> outGm_;
    AscendC::GlobalTensor<int32_t> iotaGm_;
    AscendC::GlobalTensor<int32_t> rowStartGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueIota_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueueRow_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueueCol_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRowStart_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRow_;   // I64 scratch only
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCol_;   // I64 scratch only
    int64_t col_ = 0;
    int64_t offset_ = 0;
    int64_t trilSize_ = 0;
    int64_t blockRowStart_ = 0;
    int64_t blockRows_ = 0;
    int64_t tileElems_ = 0;
};

template <bool I64>
__global__ __aicore__ __vector__ void tril_indices_kernel(
    GM_ADDR out, GM_ADDR iota, GM_ADDR rowStart,
    int64_t row, int64_t col, int64_t offset, int64_t trilSize,
    int64_t rowsPerBlock, uint32_t tileElems)
{
    KernelTrilIndices<I64> op;
    op.Init(out, iota, rowStart, row, col, offset, trilSize, rowsPerBlock, tileElems);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor tril_indices_npu(int64_t row, int64_t col, int64_t offset, bool out_int32)
{
    TORCH_CHECK(row >= 0, "tril_indices: row must be non-negative, got ", row);
    TORCH_CHECK(col >= 0, "tril_indices: col must be non-negative, got ", col);

    const int64_t trilSize = get_tril_size(row, col, offset);
    TORCH_CHECK(trilSize <= static_cast<int64_t>(0x7fffffff),
                "tril_indices: tril_size=", trilSize, " exceeds INT32_MAX");
    TORCH_CHECK(std::max<int64_t>(row, col) <= static_cast<int64_t>(0x7fffffff),
                "tril_indices: max(row,col) exceeds INT32_MAX");

    auto outDtype = out_int32 ? torch::kInt32 : torch::kInt64;
    const int64_t devIdx = c10_npu::getCurrentNPUStream().device_index();
    auto npuOpts = torch::TensorOptions()
                       .dtype(outDtype)
                       .device(c10::DeviceType::PrivateUse1, devIdx);
    auto out = torch::empty({2, trilSize}, npuOpts);
    if (trilSize == 0 || row == 0 || col == 0) {
        return out;
    }

    // maxNnz = max_r clamp(r+offset+1,0,col) = clamp(row+offset,0,col) = m_last_row.
    const int64_t maxNnz = std::max<int64_t>(1, std::min<int64_t>(col, row + offset));

    // Host-built exact int32 aux: iota[0..maxNnz) columns, rowStart prefix sum.
    auto i32cpu = torch::TensorOptions().dtype(torch::kInt32);
    auto iota_cpu = torch::arange(maxNnz, i32cpu);
    auto rowStart_cpu = torch::empty({row}, i32cpu);
    {
        auto rs = rowStart_cpu.accessor<int32_t, 1>();
        int64_t acc = 0;
        for (int64_t r = 0; r < row; ++r) {
            rs[r] = static_cast<int32_t>(acc);
            acc += row_nnz(r, col, offset);
        }
    }
    auto iota_dev = iota_cpu.to(out.device());
    auto rowStart_dev = rowStart_cpu.to(out.device());

    int64_t numBlocks, rowsPerBlock, tileElems;
    std::tie(numBlocks, rowsPerBlock, tileElems) = calc_tiling_params(row, maxNnz);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto out_ptr      = (GM_ADDR)out.data_ptr();
    auto iota_ptr     = (GM_ADDR)iota_dev.data_ptr();
    auto rowStart_ptr = (GM_ADDR)rowStart_dev.data_ptr();
    const uint32_t tileElemsU = static_cast<uint32_t>(tileElems);

    auto acl_call = [=]() -> int {
        if (out_int32) {
            tril_indices_kernel<false><<<numBlocks, nullptr, stream>>>(
                out_ptr, iota_ptr, rowStart_ptr,
                row, col, offset, trilSize, rowsPerBlock, tileElemsU);
        } else {
            tril_indices_kernel<true><<<numBlocks, nullptr, stream>>>(
                out_ptr, iota_ptr, rowStart_ptr,
                row, col, offset, trilSize, rowsPerBlock, tileElemsU);
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("TrilIndices", acl_call);

    return out;
}

// tril_indices has no tensor arguments, so the dispatcher cannot infer a
// backend key (PrivateUse1 is never reached and BackendSelect falls through ->
// NotImplementedError "no tensor arguments / no fallback registered"). Register
// the implementation under the backend-generic CompositeExplicitAutograd key:
// it serves as the catch-all for the no-tensor call and the function itself
// explicitly allocates the output on the NPU device and launches the kernel.
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, CompositeExplicitAutograd, m)
{
    m.impl("tril_indices", tril_indices_npu);
}

} // namespace TrilIndices
} // namespace ops_multimodal_fusion
