/*!
 * \file take.asc
 * \brief Take operator for Ascend NPU (dav-3510), RegBase Reg::Gather implementation.
 *
 * torch.take(input, index)
 *   result[i] = input.view(-1)[index[i]]
 *   input is treated as flat (any ndim >= 1); result shape = index shape.
 *   Negative indices wrap: idx in [-K, K) maps to [0, K).
 *
 * Dispatch scope (first version):
 *   - self: N-D (N >= 1), treated as flat gather pool
 *   - index: 1-D; M = index.numel() in [0, INT32_MAX]; result shape = (M,)
 *   - dtype(self) in {fp32, fp16, int32}; result dtype = self dtype
 *   - index.dtype == int64
 *   - K = self.numel():
 *       fp32 / int32 (b32 src): K in [1, INT32_MAX] (Reg::Gather index = uint32)
 *       fp16        (b16 src): K in [1, 65535]      (Reg::Gather index = uint16)
 *     The fp16 K<=65535 cap is a hardware constraint: dav-3510 Reg::Gather
 *     requires a uint16 index reg for b16 source data (b32 source uses uint32).
 *     Enforced by host TORCH_CHECK.
 *
 * Host-side index preparation (implementation choice):
 *   The issue sketched in-kernel int64->int32 narrowing + a vector negative
 *   wrap (Compares/Select/Adds). Two device facts make a host-side prep cleaner:
 *     (1) this platform lacks a Cast<int64,int32> binary and sub-32B strided DataCopyPad;
 *     (2) Reg::Gather requires an *unsigned* index reg (uint32 for b32 src,
 *         uint16 for b16 src), and the int32->uint16 Reg::Cast needs a non-default
 *         CastTrait that is brittle to get right.
 *   So the host does: bounds-check (int64, [-K,K)) -> negative wrap (torch::where)
 *   -> dtype-appropriate unsigned narrowing (uint16 for fp16, int32-bits=uint32
 *   for fp32/int32). All values are in [0,K) so every conversion is lossless.
 *   The kernel then only does LoadAlign + Reg::Gather + StoreAlign -- no in-kernel
 *   wrap, no Cast, no Compares/Select. The external schema is unchanged
 *   (take(Tensor self, Tensor index) with int64 index); Reg::Gather is still the
 *   genuine vectorized core.
 *
 * 3-layer Reg shape:
 *   Layer 1 vf (TakeGatherVf): per chunk of M --
 *     LoadAlign unsigned idx chunk -> Reg::Gather(dst, selfBaseAddr, idx, mask)
 *     -> StoreAlign result chunk
 *   Layer 2 __aicore__ wrapper: GetPhyAddr cast + asc_vf_call
 *   Layer 3 kernel class: DMA in self(K)/index(M) -> vf gather -> DMA out result(M)
 *
 *   Empty M (M == 0): host returns empty result; kernel not launched.
 *
 * UB layout (numBlocks=1, AIV=0 only):
 *   tbufSelf:    K * sizeof(T)         (gather pool, Reg::Gather baseAddr)
 *   tbufIndex:   M * sizeof(IdxU)      (IdxU = uint16 for fp16, uint32 for b32)
 *   tbufResult:  M * sizeof(T)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <cstdint>

namespace ops_multimodal_fusion {
namespace Take {

// Index reg width required by dav-3510 Reg::Gather: b16 src -> uint16 index,
// b32 src -> uint32 index.
template <typename T>
using IdxU = std::conditional_t<sizeof(T) == 2, uint16_t, uint32_t>;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("take(Tensor self, Tensor index) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor take_meta(const torch::Tensor &self, const torch::Tensor &index)
{
    TORCH_CHECK(self.dim() >= 1,
                "take: self must have at least 1 dimension, got 0-D");
    TORCH_CHECK(index.dim() == 1,
                "take: only 1-D index is supported, got ", index.dim(), "-D");
    TORCH_CHECK(index.scalar_type() == torch::kInt64,
                "take: index dtype must be int64, got ", index.scalar_type());
    // result shape = index shape, dtype = self dtype.
    return torch::empty(index.sizes(), self.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("take", take_meta);
}

// ===================== 3. Kernel — 3-layer Reg shape =====================

// --------- Layer 1 vf function ---------

// Chunked vectorized gather: result[i] = selfBaseAddr[ index[i] ]
// index is already wrapped to [0, K) and in the unsigned width Reg::Gather
// requires for T (uint16 for b16 src, uint32 for b32 src).
template <typename T>
__simd_vf__ inline void TakeGatherVf(
    __ubuf__ T *selfBaseAddr, __ubuf__ IdxU<T> *indexAddr,
    __ubuf__ T *resultAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<IdxU<T>> idxReg;
    AscendC::Reg::RegTensor<T>       dstReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);

        AscendC::Reg::LoadAlign<IdxU<T>, AscendC::Reg::LoadDist::DIST_NORM>(
            idxReg, indexAddr + offset);

        AscendC::Reg::Gather(dstReg, selfBaseAddr, idxReg, mask);

        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            resultAddr + offset, dstReg, mask);
    }
}

// --------- Layer 2 wrapper ---------

template <typename T>
__aicore__ inline void TakeGather(
    AscendC::LocalTensor<T> &selfPool, AscendC::LocalTensor<IdxU<T>> &index,
    AscendC::LocalTensor<T> &result, uint32_t M)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t chunkCount = (M + vectorLength - 1) / vectorLength;
    __ubuf__ T        *selfPtr   = (__ubuf__ T *)selfPool.GetPhyAddr();
    __ubuf__ IdxU<T>  *indexPtr  = (__ubuf__ IdxU<T> *)index.GetPhyAddr();
    __ubuf__ T        *resultPtr = (__ubuf__ T *)result.GetPhyAddr();
    asc_vf_call<TakeGatherVf<T>>(selfPtr, indexPtr, resultPtr, M, chunkCount);
}

// --------- Layer 3 kernel class ---------

template <typename T>
class KernelTake {
public:
    __aicore__ inline KernelTake() {}

    __aicore__ inline void Init(
        GM_ADDR self, GM_ADDR index, GM_ADDR result,
        int64_t K, int64_t M)
    {
        selfGm_.SetGlobalBuffer((__gm__ T *)self);
        indexGm_.SetGlobalBuffer((__gm__ IdxU<T> *)index);
        resultGm_.SetGlobalBuffer((__gm__ T *)result);
        K_ = K;
        M_ = M;

        const uint32_t selfBytes = static_cast<uint32_t>(K * sizeof(T));
        pipe_.InitBuffer(tbufSelf_, selfBytes);
        if (M > 0) {
            const uint32_t indexBytes  = static_cast<uint32_t>(M * sizeof(IdxU<T>));
            const uint32_t resultBytes = static_cast<uint32_t>(M * sizeof(T));
            pipe_.InitBuffer(tbufIndex_,  indexBytes);
            pipe_.InitBuffer(tbufResult_, resultBytes);
        }
    }

    __aicore__ inline void Process()
    {
        if (K_ <= 0 || M_ <= 0) return;
        // Single-AIV serial: only AIV 0 executes.
        if (AscendC::GetBlockIdx() != 0) return;

        AscendC::LocalTensor<T>        selfLocal   = tbufSelf_.template Get<T>();
        AscendC::LocalTensor<IdxU<T>>  indexLocal  = tbufIndex_.template Get<IdxU<T>>();
        AscendC::LocalTensor<T>        resultLocal = tbufResult_.template Get<T>();

        AscendC::DataCopyExtParams cpSelf;
        cpSelf.blockCount = 1;
        cpSelf.blockLen   = static_cast<uint32_t>(K_ * sizeof(T));
        cpSelf.srcStride  = 0;
        cpSelf.dstStride  = 0;
        AscendC::DataCopyExtParams cpIndex;
        cpIndex.blockCount = 1;
        cpIndex.blockLen   = static_cast<uint32_t>(M_ * sizeof(IdxU<T>));
        cpIndex.srcStride  = 0;
        cpIndex.dstStride  = 0;
        AscendC::DataCopyExtParams cpResult;
        cpResult.blockCount = 1;
        cpResult.blockLen   = static_cast<uint32_t>(M_ * sizeof(T));
        cpResult.srcStride  = 0;
        cpResult.dstStride  = 0;

        AscendC::DataCopyPadExtParams<T>        padT{false, 0, 0, T{}};
        AscendC::DataCopyPadExtParams<IdxU<T>>  padI{false, 0, 0, static_cast<IdxU<T>>(0)};

        AscendC::DataCopyPad(selfLocal,  selfGm_,  cpSelf,  padT);
        AscendC::DataCopyPad(indexLocal, indexGm_, cpIndex, padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        TakeGather<T>(selfLocal, indexLocal, resultLocal,
                      static_cast<uint32_t>(M_));
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyPad(resultGm_, resultLocal, cpResult);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>        selfGm_;
    AscendC::GlobalTensor<IdxU<T>>  indexGm_;
    AscendC::GlobalTensor<T>        resultGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSelf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIndex_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufResult_;
    int64_t K_ = 0;
    int64_t M_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void take_kernel(
    GM_ADDR self, GM_ADDR index, GM_ADDR result,
    int64_t K, int64_t M)
{
    KernelTake<T> op;
    op.Init(self, index, result, K, M);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

torch::Tensor take_npu(const torch::Tensor &self, const torch::Tensor &index)
{
    auto dtype = self.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "take (RegBase): only float32 / float16 / int32 are supported, got ",
                dtype);
    TORCH_CHECK(self.dim() >= 1,
                "take: self must have at least 1 dimension, got 0-D");
    TORCH_CHECK(index.dim() == 1,
                "take: only 1-D index is supported, got ", index.dim(), "-D");
    TORCH_CHECK(index.scalar_type() == torch::kInt64,
                "take: index dtype must be int64, got ", index.scalar_type());

    const int64_t K = self.numel();
    const int64_t M = index.numel();
    TORCH_CHECK(K >= 1, "take: self numel must be >= 1, got K=", K);
    TORCH_CHECK(K <= static_cast<int64_t>(0x7fffffff),
                "take: self numel K=", K, " exceeds INT32_MAX");
    // fp16 (b16) Reg::Gather requires a uint16 index reg on dav-3510, so the
    // gather pool is capped at 65535 elements for the float16 path. fp32/int32
    // (b32) use a uint32 index and keep the full INT32_MAX range.
    TORCH_CHECK(dtype != torch::kFloat16 || K <= 65535,
                "take: float16 self numel K=", K,
                " exceeds 65535 (dav-3510 b16 gather uses a uint16 index); "
                "use float32/int32 for larger pools");

    const c10::OptionalDeviceGuard guard(self.device());
    auto self_c  = self.contiguous();
    auto index_c = index.contiguous();

    // Empty index -> empty result (shape (0,), self dtype).
    if (M == 0) {
        return torch::empty({0}, self_c.options());
    }

    // UB-capacity guard. This single-tile dispatch keeps the whole gather pool
    // (K elements) plus the index (M) and result (M) resident in UB. An input
    // whose working set exceeds UB would otherwise overrun the buffer and raise a
    // hard device fault (error 507035) rather than a clean rejection, so reject
    // it on the host first. A future multi-tile version can lift this.
    {
        auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
        uint64_t ubSize = 0;
        plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
        const int64_t elem = static_cast<int64_t>(self_c.element_size());
        const int64_t idxElem = (dtype == torch::kFloat16) ? 2 : 4;
        auto align32 = [](int64_t b) { return (b + 31) / 32 * 32; };
        const int64_t working = align32(K * elem)
                              + align32(M * idxElem)
                              + align32(M * elem);
        const int64_t margin = 8192;
        TORCH_CHECK(static_cast<uint64_t>(working + margin) <= ubSize,
                    "take: UB working set ", working, " bytes (K + M; K=", K,
                    ", M=", M, ") exceeds UB ", ubSize, " bytes; the gather pool and "
                    "result must fit in UB for this single-tile dispatch");
    }

    // Host-side index prep: bounds-check (int64 [-K, K)) -> negative wrap ->
    // dtype-appropriate unsigned narrowing. All values land in [0, K) so every
    // conversion is exact (fp16: K<=65535 fits uint16; fp32/int32: K<=INT32_MAX
    // fits int32 whose non-negative bit pattern equals uint32).
    auto index_cpu = index_c.cpu();
    const int64_t idx_min = index_cpu.min().item<int64_t>();
    const int64_t idx_max = index_cpu.max().item<int64_t>();
    TORCH_CHECK(idx_min >= -K,
                "take: index minimum (", idx_min, ") must be >= -K=", -K);
    TORCH_CHECK(idx_max < K,
                "take: index maximum (", idx_max, ") must be < K=", K);
    auto idx_wrapped = torch::where(index_cpu < 0, index_cpu + K, index_cpu);

    torch::Tensor index_dev;
    if (dtype == torch::kFloat16) {
        index_dev = idx_wrapped.to(torch::kUInt16).to(self.device());
    } else {
        // int32 non-negative bits == uint32; kernel reinterprets the buffer.
        index_dev = idx_wrapped.to(torch::kInt32).to(self.device());
    }

    auto result = torch::empty({M}, self_c.options());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto selfPtr   = (GM_ADDR)self_c.data_ptr();
    auto indexPtr  = (GM_ADDR)index_dev.data_ptr();
    auto resultPtr = (GM_ADDR)result.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            self_c.scalar_type(), "take_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                take_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, resultPtr, K, M);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                take_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, resultPtr, K, M);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                take_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, resultPtr, K, M);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Take", acl_call);

    return result;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("take", take_npu);
}

} // namespace Take
} // namespace ops_multimodal_fusion
