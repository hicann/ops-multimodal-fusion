/*!
 * \file copysign.asc
 * \brief Copysign (binary, copy sign of b onto magnitude of a) operator for
 *        Ascend NPU (dav-3510).
 *
 * torch.copysign(a, b) -> c  with  c == |a|  and  signbit(c) == signbit(b)
 *
 * Scope (per issue #94): float32 and float16 on dav-3510, same shape & dtype.
 *
 * Algorithm:
 *   IEEE-754 copysign is a bit-level operation: clear the sign bit of `a`,
 *   take the sign bit of `b`, OR them. The result agrees with PyTorch on every
 *   well-defined case including signed zeros (`copysign(2, -0.0) == -2`) and
 *   propagates NaN payloads from `a` while still copying the sign bit of `b`.
 *
 *   Steps per tile (uniform across fp32 and fp16, same op on different
 *   bit-width integer views):
 *     aBits = a viewed as int32 (fp32) / int16 (fp16)
 *     bBits = b viewed similarly
 *     cBits = c viewed similarly
 *     1. aBits = aBits & MAG_MASK     (clear sign bit of `a`)
 *     2. bBits = bBits & SGN_MASK     (extract sign bit of `b`)
 *     3. cBits = aBits | bBits        (assemble result)
 *
 *   MAG_MASK / SGN_MASK are populated once into VECCALC TBufs by `Duplicate`
 *   during Init() and reused for every tile.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Copysign {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("copysign(Tensor a, Tensor b) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor copysign_meta(const torch::Tensor &a, const torch::Tensor &b)
{
    TORCH_CHECK(a.sizes() == b.sizes(),
                "copysign: shapes must match, got ", a.sizes(), " vs ", b.sizes());
    TORCH_CHECK(a.scalar_type() == b.scalar_type(),
                "copysign: dtypes must match, got ", a.scalar_type(),
                " vs ", b.scalar_type());
    TORCH_CHECK(a.scalar_type() == torch::kFloat32 ||
                a.scalar_type() == torch::kFloat16,
                "copysign: only float32 and float16 are supported on dav-3510, got ",
                a.scalar_type());
    return torch::empty_like(a);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("copysign", copysign_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 3 queues (a, b in + c out) double-buffered, plus 2 mask TBufs sized
    // like a single tile (no double buffering on the masks).
    //   queues: PIPELINE_DEPTH * 3 = 6
    //   masks : 2
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 3 + 2; // = 8
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // align to 32 bytes
    TORCH_CHECK(tileSize > 0, "copysign: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// ===================== 4. Kernel =====================

template <typename T>
class KernelCopysign {
    // Same-width integer view; copysign is a pure bit op so this is exact for
    // every value including ±0, ±inf, and NaN.
    using BitT = std::conditional_t<std::is_same<T, half>::value, int16_t, int32_t>;

public:
    __aicore__ inline KernelCopysign() {}

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        aGm_.SetGlobalBuffer((__gm__ T *)a + blockLength * AscendC::GetBlockIdx());
        bGm_.SetGlobalBuffer((__gm__ T *)b + blockLength * AscendC::GetBlockIdx());
        cGm_.SetGlobalBuffer((__gm__ T *)c + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueA_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(inQueueB_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueC_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(magMaskTBuf_,  tileSize);
        pipe_.InitBuffer(signMaskTBuf_, tileSize);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileSize / sizeof(T);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;

        // Populate the mask tensors once. Same memory used for every tile;
        // partial tail tiles read only the first `count` elements.
        AscendC::LocalTensor<BitT> magMask  = magMaskTBuf_.template Get<BitT>();
        AscendC::LocalTensor<BitT> signMask = signMaskTBuf_.template Get<BitT>();
        BitT magVal, sgnVal;
        if constexpr (std::is_same<T, half>::value) {
            magVal = static_cast<BitT>(0x7FFF);
            sgnVal = static_cast<BitT>(0x8000);
        } else {
            magVal = static_cast<BitT>(0x7FFFFFFF);
            sgnVal = static_cast<BitT>(0x80000000);
        }
        AscendC::Duplicate(magMask,  magVal, elementNumPerTile_);
        AscendC::Duplicate(signMask, sgnVal, elementNumPerTile_);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

        AscendC::LocalTensor<T> aLocal = inQueueA_.template AllocTensor<T>();
        AscendC::LocalTensor<T> bLocal = inQueueB_.template AllocTensor<T>();
        AscendC::DataCopyPad(aLocal, aGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(bLocal, bGm_[offset], copyParams, padParams);
        inQueueA_.EnQue(aLocal);
        inQueueB_.EnQue(bLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<T> aLocal = inQueueA_.template DeQue<T>();
        AscendC::LocalTensor<T> bLocal = inQueueB_.template DeQue<T>();
        AscendC::LocalTensor<T> cLocal = outQueueC_.template AllocTensor<T>();

        auto aBits = aLocal.template ReinterpretCast<BitT>();
        auto bBits = bLocal.template ReinterpretCast<BitT>();
        auto cBits = cLocal.template ReinterpretCast<BitT>();
        AscendC::LocalTensor<BitT> magMask  = magMaskTBuf_.template Get<BitT>();
        AscendC::LocalTensor<BitT> signMask = signMaskTBuf_.template Get<BitT>();

        // aBits &= MAG_MASK   (clear sign bit of a)
        AscendC::And(aBits, aBits, magMask, count);
        AscendC::PipeBarrier<PIPE_V>();
        // bBits &= SGN_MASK   (isolate sign bit of b)
        AscendC::And(bBits, bBits, signMask, count);
        AscendC::PipeBarrier<PIPE_V>();
        // cBits = aBits | bBits   (assemble copysign result)
        AscendC::Or(cBits, aBits, bBits, count);
        AscendC::PipeBarrier<PIPE_V>();

        inQueueA_.FreeTensor(aLocal);
        inQueueB_.FreeTensor(bLocal);
        outQueueC_.EnQue(cLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> cLocal = outQueueC_.template DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(cGm_[offset], cLocal, copyParams);
        outQueueC_.FreeTensor(cLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> aGm_, bGm_, cGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueA_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueB_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueC_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> magMaskTBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> signMaskTBuf_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void copysign_kernel(
    GM_ADDR a, GM_ADDR b, GM_ADDR c,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelCopysign<T> op;
    op.Init(a, b, c, totalLength, blockLength, tileSize);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor copysign_npu(const torch::Tensor &a_in, const torch::Tensor &b_in)
{
    TORCH_CHECK(a_in.sizes() == b_in.sizes(),
                "copysign: shapes must match, got ", a_in.sizes(), " vs ", b_in.sizes());
    TORCH_CHECK(a_in.scalar_type() == b_in.scalar_type(),
                "copysign: dtypes must match, got ", a_in.scalar_type(),
                " vs ", b_in.scalar_type());
    TORCH_CHECK(a_in.scalar_type() == torch::kFloat32 ||
                a_in.scalar_type() == torch::kFloat16,
                "copysign: only float32 and float16 are supported on dav-3510, got ",
                a_in.scalar_type());

    const c10::OptionalDeviceGuard guard(a_in.device());
    auto a = a_in.contiguous();
    auto b = b_in.contiguous();
    auto c = torch::empty_like(a);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = a.numel();
    if (totalLength == 0) {
        return c;
    }
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto a_ptr = (GM_ADDR)a.data_ptr();
    auto b_ptr = (GM_ADDR)b.data_ptr();
    auto c_ptr = (GM_ADDR)c.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            a.scalar_type(), "copysign_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                copysign_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    a_ptr, b_ptr, c_ptr, totalLength, blockLength, tileSize);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                copysign_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    a_ptr, b_ptr, c_ptr, totalLength, blockLength, tileSize);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Copysign", acl_call);
    return c;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("copysign", copysign_npu);
}

} // namespace Copysign
} // namespace ops_multimodal_fusion
