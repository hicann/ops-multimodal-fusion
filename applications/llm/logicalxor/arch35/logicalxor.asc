/*!
 * \file logicalxor.asc
 * \brief LogicalXor (elementwise logical XOR) operator for Ascend NPU
 *
 *   z = (x != 0) XOR (y != 0)
 *
 * Matches torch.logical_xor when both inputs are already bool tensors.
 * Non-bool inputs are NOT supported by this kernel; the caller should
 * convert via `.bool()` (cheap host-side reinterpret / .ne(0) op) first.
 * Restricting to bool keeps the implementation a single dispatch and
 * avoids dtype-specific mask-building logic.
 *
 * Compute path:
 *   1. Load bool (uint8) inputs into UB.
 *   2. Cast uint8 -> half so we can use vector arithmetic.
 *   3. XOR by arithmetic on {0, 1} values:
 *        a XOR b = a + b − 2·a·b
 *      All intermediate values are exactly representable in half
 *      (0, 1, 2 and their negations fit in half's integer range), so
 *      no precision is lost and the final cast back to uint8 is exact.
 *   4. Cast half -> uint8 and store.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace LogicalXor {

// 1. Schema registration
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("logicalxor(Tensor x, Tensor y) -> Tensor");
}

// 2. Meta function - output is bool regardless of input dtype
torch::Tensor logicalxor_meta(const torch::Tensor &x, const torch::Tensor &y)
{
    TORCH_CHECK(x.sizes() == y.sizes(), "logicalxor: x and y must have the same shape.");
    TORCH_CHECK(x.scalar_type() == y.scalar_type(),
        "logicalxor: x and y must have the same dtype.");
    TORCH_CHECK(x.scalar_type() == torch::kBool,
        "logicalxor: only bool inputs are supported; cast with .bool() first.");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("logicalxor", logicalxor_meta);
}

// 3. Tiling parameter calculation
//
// UB layout per tile (in bytes, in terms of element count N per tile):
//   queues (uint8): 3 queues × PIPELINE_DEPTH × N = 6N
//   tbufs  (half ): 3 scratch buffers × 2N (half is 2 bytes)  = 6N
//   total per element = 12 bytes.
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t BYTES_PER_ELEM_UB = 12;  // see block comment
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    // tileSize here is the uint8 queue buffer size in bytes (== element count).
    int64_t tileSize = ubSize / BYTES_PER_ELEM_UB;
    tileSize = (tileSize / 32) * 32;  // 32B aligned
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// 4. Kernel implementation
class KernelLogicalXor {
public:
    static constexpr int64_t PIPELINE_DEPTH = 2;

    __aicore__ inline KernelLogicalXor() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        pipe_.InitBuffer(inQueueX_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(inQueueY_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueZ_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tbufXh_, tileSize * static_cast<uint32_t>(sizeof(half)));
        pipe_.InitBuffer(tbufYh_, tileSize * static_cast<uint32_t>(sizeof(half)));
        pipe_.InitBuffer(tbufZh_, tileSize * static_cast<uint32_t>(sizeof(half)));

        xGm_.SetGlobalBuffer((__gm__ uint8_t *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ uint8_t *)y + blockLength * AscendC::GetBlockIdx());
        zGm_.SetGlobalBuffer((__gm__ uint8_t *)z + blockLength * AscendC::GetBlockIdx());

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        elementNumPerTile_ = tileSize / sizeof(uint8_t);   // = tileSize
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(uint8_t);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<uint8_t> padParams{false, 0, 0, 0};

        // CopyIn
        auto xLocal = inQueueX_.AllocTensor<uint8_t>();
        auto yLocal = inQueueY_.AllocTensor<uint8_t>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);

        // Compute: cast->arithmetic XOR->cast
        xLocal = inQueueX_.DeQue<uint8_t>();
        yLocal = inQueueY_.DeQue<uint8_t>();
        auto zLocal = outQueueZ_.AllocTensor<uint8_t>();
        auto xHalf = tbufXh_.Get<half>();
        auto yHalf = tbufYh_.Get<half>();
        auto zHalf = tbufZh_.Get<half>();

        AscendC::Cast(xHalf, xLocal, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(yHalf, yLocal, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();

        // zHalf = x * y
        AscendC::Mul(zHalf, xHalf, yHalf, count);
        AscendC::PipeBarrier<PIPE_V>();
        // zHalf = -2 * x * y
        AscendC::Muls(zHalf, zHalf, (half)(-2.0f), count);
        AscendC::PipeBarrier<PIPE_V>();
        // zHalf += x  ->  x - 2xy
        AscendC::Add(zHalf, zHalf, xHalf, count);
        AscendC::PipeBarrier<PIPE_V>();
        // zHalf += y  ->  x + y - 2xy  = XOR
        AscendC::Add(zHalf, zHalf, yHalf, count);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Cast(zLocal, zHalf, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);

        // CopyOut
        zLocal = outQueueZ_.DeQue<uint8_t>();
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<uint8_t> xGm_, yGm_, zGm_;
    AscendC::TQue<AscendC::QuePosition::VECIN, PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::QuePosition::VECIN, PIPELINE_DEPTH> inQueueY_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, PIPELINE_DEPTH> outQueueZ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXh_, tbufYh_, tbufZh_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

__global__ __aicore__ __vector__ void logicalxor_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR z,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelLogicalXor impl;
    impl.Init(x, y, z, totalLength, blockLength, tileSize);
    impl.Process();
}

// 5. NPU dispatch
torch::Tensor logicalxor_npu(const torch::Tensor &x, const torch::Tensor &y)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto z = logicalxor_meta(x, y);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t totalLength = x.numel();
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();
    auto z_ptr = (GM_ADDR)z.data_ptr();

    auto acl_call = [=]() -> int {
        logicalxor_kernel<<<numBlocks, nullptr, stream>>>(
            x_ptr, y_ptr, z_ptr, totalLength, blockLength, tileSize);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("LogicalXor", acl_call);
    return z;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("logicalxor", logicalxor_npu);
}

} // namespace LogicalXor
} // namespace ops_multimodal_fusion
