/*!
 * \file addmv.asc
 * \brief RegBase addmv (BLAS level-2 gemv) operator for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.addmv(self, mat, vec, beta=1, alpha=1) -> Tensor
 *   self : (M,) / (1,) / 0-dim / (M,) expand view, fp32/fp16/bf16/int32
 *   mat  : (M, K), same dtype
 *   vec  : (K,),   same dtype
 *   out  : (M,),   same dtype
 *
 *   out[i] = beta * self[i] + alpha * sum_j mat[i][j] * vec[j]
 *
 * Compute kernel is strict RegBase (__simd_vf__ + AscendC::Reg::*): mat row
 * tiles and the vec chunk are staged in UB, fp16/bf16 are unpacked into b32
 * lanes and cast to fp32 in-register, and the K reduction is a per-row
 * Reg::Reduce<SUM>. Row partial sums live at a 32B stride and are compacted
 * with AscendC::Gather in the epilogue.
 *
 * Semantics follow the BLAS/cuBLAS gemv specification: `alpha` exactly zero
 * means mat/vec are never referenced, `beta` exactly zero means self is never
 * referenced. Both flags are decided host-side from the raw Scalar value.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Addmv {

/* ── Shared constants ──────────────────────────────────────────────────── */

constexpr int64_t BLOCK_BYTES = 32;                              // one UB DataBlock
constexpr int64_t COMP_BYTES = 4;                                // sizeof(float) == sizeof(int32_t)
// Vector register width on dav-3510. AscendC::VECTOR_REG_WIDTH is guarded by __NPU_ARCH__ and is
// therefore only visible to the device compilation pass, so host tiling needs this mirror; the
// device-side static_assert in AddmvRowsDotVf keeps the two values in sync.
constexpr int64_t VEC_REG_BYTES = 256;
constexpr int64_t VL_COMP = VEC_REG_BYTES / COMP_BYTES;          // lanes per vector reg for CompT
constexpr int64_t REDUCE_ELEMS = BLOCK_BYTES / COMP_BYTES;       // 32B stride of the row partial sums
constexpr int64_t EPI_ROWS = 512;                                // epilogue row slice
constexpr int64_t ROWS_PER_PASS = 1216;                          // 19*64, >= ceil(65536/56); caps UB usage
constexpr int64_t SAFETY_BYTES = 2048;                           // budget slack, never allocated
constexpr int64_t SCRATCH_BYTES = VEC_REG_BYTES;                 // one full vector reg (Reg::LoadAlign granule)
constexpr int64_t MAX_BLOCK_COUNT = 4095;                        // DataCopyPad blockCount upper bound
constexpr double INT32_LOW = -2147483648.0;                      // exact in double
constexpr double INT32_HIGH = 2147483647.0;                      // exact in double

/* Compute (accumulation) type: fp16/bf16 accumulate in fp32, int32 stays int32. */
template <typename T> struct CompTypeTrait {
    using Type = float;
};
template <> struct CompTypeTrait<int32_t> {
    using Type = int32_t;
};
template <typename T> using CompType = typename CompTypeTrait<T>::Type;

/* The only compile-time fork in the compute kernel: b16 needs an unpack+cast. */
template <typename T> constexpr bool NeedCastV = !std::is_same<T, CompType<T>>::value;

/* ── 1. Schema ─────────────────────────────────────────────────────────── */

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("addmv(Tensor self, Tensor mat, Tensor vec, Scalar beta=1, Scalar alpha=1) -> Tensor");
}

/* ── Host helpers ──────────────────────────────────────────────────────── */

static inline int64_t AlignUpHost(int64_t value, int64_t granule)
{
    return ((value + granule - 1) / granule) * granule;
}

static inline int64_t AlignDownHost(int64_t value, int64_t granule)
{
    return (value / granule) * granule;
}

/*
 * Hard constraint C1: every argument check lives here, runs host-side and
 * synchronously, before any device work or kernel launch. AT_DISPATCH_SWITCH
 * therefore only ever maps an already validated dtype to a template instance
 * and can never reach its default error branch.
 */
static void addmv_check(const torch::Tensor &self, const torch::Tensor &mat, const torch::Tensor &vec,
                        const c10::Scalar &beta, const c10::Scalar &alpha, bool checkDevice)
{
    TORCH_CHECK(mat.dim() == 2, "addmv: mat must be 2-D, got ", mat.dim(), "-D");                       // K1
    TORCH_CHECK(vec.dim() == 1, "addmv: vec must be 1-D, got ", vec.dim(), "-D");                       // K2
    TORCH_CHECK(vec.size(0) == mat.size(1),
                "addmv: vec size (", vec.size(0), ") must match mat.size(1) (", mat.size(1), ")");       // K2
    TORCH_CHECK(self.dim() <= 1, "addmv: self must be 0-D or 1-D, got ", self.dim(), "-D");             // K3
    TORCH_CHECK(self.numel() == 1 || self.numel() == mat.size(0),
                "addmv: self must be broadcastable to (", mat.size(0), "), got ", self.numel(),
                " elements");                                                                            // K3
    TORCH_CHECK(self.scalar_type() == mat.scalar_type() && vec.scalar_type() == mat.scalar_type(),
                "addmv: self, mat and vec must share the same dtype, got ", self.scalar_type(), ", ",
                mat.scalar_type(), " and ", vec.scalar_type());                                          // K4
    // K5 dtype whitelist -- C1 core item, must reject here and not via AT_DISPATCH fallback.
    TORCH_CHECK(mat.scalar_type() == torch::kFloat32 || mat.scalar_type() == torch::kFloat16 ||
                mat.scalar_type() == torch::kBFloat16 || mat.scalar_type() == torch::kInt32,
                "addmv: only float32, float16, bfloat16 and int32 are supported, got ", mat.scalar_type());
    if (checkDevice) {                                                                                   // K6
        TORCH_CHECK(mat.device().is_privateuseone(), "addmv: mat must be on an NPU device, got ",
                    mat.device());
        TORCH_CHECK(self.device() == mat.device() && vec.device() == mat.device(),
                    "addmv: self, mat and vec must be on the same device, got ", self.device(), ", ",
                    mat.device(), " and ", vec.device());
    }
    // P12': int32 rejects out-of-range beta/alpha, matching torch's
    // "value cannot be converted to type int without overflow". The comparison is done in the
    // double domain BEFORE std::trunc (torch rejects 2147483647.5) and the interval is closed and
    // asymmetric (-2147483648.0 is accepted). NaN/Inf fail both comparisons and are rejected too.
    // This is NOT the P4 case: P4 forbids rejecting *in-range* non-integral scalars (alpha=0.5),
    // which torch silently truncates. Both rules share one criterion -- match torch.
    if (mat.scalar_type() == torch::kInt32) {
        const double betaRaw = beta.to<double>();
        const double alphaRaw = alpha.to<double>();
        TORCH_CHECK(betaRaw >= INT32_LOW && betaRaw <= INT32_HIGH,
                    "addmv: beta value cannot be converted to type int without overflow, got ", betaRaw);
        TORCH_CHECK(alphaRaw >= INT32_LOW && alphaRaw <= INT32_HIGH,
                    "addmv: alpha value cannot be converted to type int without overflow, got ", alphaRaw);
    }
}

/* ── 2. Meta ───────────────────────────────────────────────────────────── */

torch::Tensor addmv_meta(const torch::Tensor &self, const torch::Tensor &mat, const torch::Tensor &vec,
                         const c10::Scalar &beta, const c10::Scalar &alpha)
{
    addmv_check(self, mat, vec, beta, alpha, /*checkDevice=*/false);
    return torch::empty({mat.size(0)}, mat.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("addmv", addmv_meta);
}

/* ── 3. Tiling (host) ──────────────────────────────────────────────────── */

struct AddmvTiling {
    int64_t numBlocks = 1;
    int64_t rowBase = 0;
    int64_t rowRem = 0;
    int64_t rowsPerPass = 1;
    int64_t kt = 1;
    int64_t ktAlloc = VL_COMP;
    int64_t mt = 1;
    int64_t numKChunks = 0;
};

/*
 * Fixed (M/K-independent) UB reserved by the epilogue buffers plus the row partial-sum buffer.
 * partialBuf_ carries a read-ahead tail: Reg::LoadAlign pulls a full 256B register while the row
 * pitch is only 32B, so the last row over-reads VEC_REG_BYTES-BLOCK_BYTES past its own slot.
 * outCompBuf_ is counted unconditionally (design E1); on the non-cast path its bytes are slack.
 */
static int64_t reserved_ub_bytes(int64_t rowsPerPass, int64_t elemSize, bool needCast)
{
    const int64_t partialBytes =
        AlignUpHost(rowsPerPass * BLOCK_BYTES + (VEC_REG_BYTES - BLOCK_BYTES), VEC_REG_BYTES);
    const int64_t fixedBytes =
        EPI_ROWS * (COMP_BYTES + COMP_BYTES + COMP_BYTES + (needCast ? COMP_BYTES : 0)) +
        EPI_ROWS * elemSize +          // inQueSelf_, depth 1
        2 * EPI_ROWS * elemSize +      // outQueOut_, depth 2
        BLOCK_BYTES +                  // scratch line (real allocation is carved from SAFETY_BYTES)
        SAFETY_BYTES;
    return partialBytes + fixedBytes;
}

static AddmvTiling calc_tiling_params(int64_t m, int64_t k, int64_t elemSize, bool needCast, bool runMatMul)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    const int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "addmv: coreNum must be positive");

    AddmvTiling t;
    t.numBlocks = std::max<int64_t>(1, std::min<int64_t>(coreNum, m));
    t.rowBase = m / t.numBlocks;
    t.rowRem = m % t.numBlocks;
    const int64_t rowsMax = t.rowBase + ((t.rowRem > 0) ? 1 : 0);
    t.rowsPerPass = std::max<int64_t>(1, std::min<int64_t>(rowsMax, ROWS_PER_PASS));

    const int64_t reserved = reserved_ub_bytes(t.rowsPerPass, elemSize, needCast);
    const int64_t tileBudget = static_cast<int64_t>(ubSize) - reserved;

    // inQueMat_ (depth 2, Mt = 1 floor) + inQueVec_ + optional vecCompBuf_.
    const int64_t perElemBytes = 2 * elemSize + elemSize + (needCast ? COMP_BYTES : 0);
    TORCH_CHECK(tileBudget >= perElemBytes * VL_COMP,
                "addmv: UB is too small for one minimal K tile");

    if (k * perElemBytes <= tileBudget) {
        t.kt = k;
        t.numKChunks = 1;
    } else {
        t.kt = AlignDownHost(tileBudget / perElemBytes, VL_COMP);
        t.numKChunks = (k + t.kt - 1) / t.kt;
    }
    if (k == 0 || !runMatMul) {
        t.kt = VL_COMP;
        t.numKChunks = 0;
    }
    t.ktAlloc = AlignUpHost(std::max<int64_t>(t.kt, VL_COMP), VL_COMP);

    const int64_t vecBytes = t.ktAlloc * elemSize + (needCast ? t.ktAlloc * COMP_BYTES : 0);
    if (t.kt < k) {
        t.mt = 1;   // invariant I1: Mt > 1 implies Kt == K, hence GM-side srcStride == 0
    } else {
        const int64_t cap = (tileBudget - vecBytes) / (2 * t.ktAlloc * elemSize);
        t.mt = std::min<int64_t>(std::max<int64_t>(cap, 1),
                                 std::min<int64_t>(t.rowsPerPass, MAX_BLOCK_COUNT));
    }
    if (t.numKChunks == 0) {
        t.mt = 1;   // K == 0 or alpha == 0: the k loop never runs, do not reserve a fat mat tile
    }
    return t;
}

/* ── 4. Kernel ─────────────────────────────────────────────────────────── */

/* Layer 1: __simd_vf__ compute kernels ---------------------------------- */

/* Zero the whole row-partial-sum buffer (32B stride slots plus the read-ahead tail). */
template <typename CompT>
__simd_vf__ inline void ZeroVf(__ubuf__ CompT *dstAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(CompT);
    AscendC::Reg::RegTensor<CompT> zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<CompT>(remaining);
        AscendC::Reg::Duplicate<CompT>(zeroReg, static_cast<CompT>(0), mask);
        AscendC::Reg::StoreAlign<CompT, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, zeroReg,
                                                                                mask);
    }
}

template <typename CompT>
__aicore__ inline void ZeroReg(__ubuf__ CompT *dstAddr, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(CompT);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ZeroVf<CompT>>(dstAddr, elementCount, chunkCount);
}

/* b16 -> fp32 widening (identical shape to pdist::CastToFloatRegVf). */
template <typename T>
__simd_vf__ inline void CastToCompVf(__ubuf__ float *dstAddr, __ubuf__ T *srcAddr, uint32_t count,
                                     uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTraitIn = {AscendC::Reg::RegLayout::ZERO,
                                                            AscendC::Reg::SatMode::UNKNOWN,
                                                            AscendC::Reg::MaskMergeMode::ZEROING,
                                                            AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, castTraitIn>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg,
                                                                                mask);
    }
}

template <typename T>
__aicore__ inline void CastToComp(__ubuf__ float *dstAddr, __ubuf__ T *srcAddr, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToCompVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

/* fp32 -> b16 narrowing on the output path (P4 probes this Cast for FTZ). */
template <typename T, AscendC::RoundMode ROUND>
__simd_vf__ inline void CastFromCompVf(__ubuf__ T *dstAddr, __ubuf__ float *srcAddr, uint32_t count,
                                       uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTraitOut = {AscendC::Reg::RegLayout::ZERO,
                                                             AscendC::Reg::SatMode::NO_SAT,
                                                             AscendC::Reg::MaskMergeMode::ZEROING, ROUND};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<T, float, castTraitOut>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(dstAddr + offset, dstReg, mask);
    }
}

template <typename T, AscendC::RoundMode ROUND>
__aicore__ inline void CastFromComp(__ubuf__ T *dstAddr, __ubuf__ float *srcAddr, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFromCompVf<T, ROUND>>(dstAddr, srcAddr, elementCount, chunkCount);
}

/*
 * Build the Gather byte-offset table {0, 32, 64, ...} entirely inside the Reg domain.
 * Reg::Arange fills exactly one register (VL(int32) = 64 indices) per call, so EPI_ROWS = 512
 * needs 8 rounds with base = 0, 64, ..., 448.
 */
__simd_vf__ inline void BuildGatherOffsetVf(__ubuf__ int32_t *dstAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    AscendC::Reg::RegTensor<int32_t> idxReg;
    AscendC::Reg::RegTensor<int32_t> offReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<int32_t>(remaining);
        AscendC::Reg::Arange<int32_t>(idxReg, static_cast<int32_t>(offset));
        AscendC::Reg::Muls<int32_t>(offReg, idxReg, static_cast<int32_t>(BLOCK_BYTES), mask);
        AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, offReg,
                                                                                  mask);
    }
}

__aicore__ inline void BuildGatherOffset(__ubuf__ int32_t *dstAddr, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BuildGatherOffsetVf>(dstAddr, elementCount, chunkCount);
}

/*
 * Core: for each of `rows` mat rows, dot the row against the vec chunk and accumulate into the
 * 32B-strided partial sum. Tail lanes are handled purely through the mask: Reg::Mul defaults to
 * MaskMergeMode::ZEROING so lanes past kLen contribute an exact 0, while Reg::Add uses the full
 * mask so already-accumulated lanes survive. Nothing depends on UB padding content.
 */
template <typename T, typename CompT, bool NeedCast>
__simd_vf__ inline void AddmvRowsDotVf(__ubuf__ CompT *partialAddr, __ubuf__ T *matAddr,
                                       __ubuf__ CompT *vecAddr, uint32_t rows, uint32_t rowStrideElems,
                                       uint32_t kLen, uint32_t chunkCount)
{
    static_assert(AscendC::VECTOR_REG_WIDTH == VEC_REG_BYTES,
                  "host-side VEC_REG_BYTES mirror is out of sync with AscendC::VECTOR_REG_WIDTH");
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(CompT);
    constexpr uint32_t reduceElems = BLOCK_BYTES / sizeof(CompT);
    static constexpr AscendC::Reg::CastTrait castTraitIn = {AscendC::Reg::RegLayout::ZERO,
                                                            AscendC::Reg::SatMode::UNKNOWN,
                                                            AscendC::Reg::MaskMergeMode::ZEROING,
                                                            AscendC::RoundMode::UNKNOWN};
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<CompT>(scalarCount);
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::CreateMask<CompT, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::RegTensor<T> rawReg;
    AscendC::Reg::RegTensor<CompT> matReg;
    AscendC::Reg::RegTensor<CompT> vecReg;
    AscendC::Reg::RegTensor<CompT> prodReg;
    AscendC::Reg::RegTensor<CompT> sumReg;
    AscendC::Reg::RegTensor<CompT> redReg;
    AscendC::Reg::RegTensor<CompT> accReg;

    for (uint32_t row = 0; row < rows; ++row) {
        AscendC::Reg::Duplicate<CompT>(sumReg, static_cast<CompT>(0), fullMask);
        __ubuf__ T *rowAddr = matAddr + row * rowStrideElems;
        for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
            uint32_t offset = chunk * vectorLength;
            uint32_t remaining = kLen - offset;
            AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<CompT>(remaining);
            AscendC::Reg::LoadAlign<CompT, AscendC::Reg::LoadDist::DIST_NORM>(vecReg, vecAddr + offset);
            if constexpr (NeedCast) {
                AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(rawReg, rowAddr + offset);
                AscendC::Reg::Cast<CompT, T, castTraitIn>(matReg, rawReg, mask);
            } else {
                AscendC::Reg::LoadAlign<CompT, AscendC::Reg::LoadDist::DIST_NORM>(
                    matReg, (__ubuf__ CompT *)(rowAddr + offset));
            }
            AscendC::Reg::Mul<CompT>(prodReg, matReg, vecReg, mask);
            AscendC::Reg::Add<CompT>(sumReg, sumReg, prodReg, fullMask);
        }
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM, CompT, CompT,
                             AscendC::Reg::MaskMergeMode::ZEROING>(redReg, sumReg, fullMask);
        AscendC::Reg::LoadAlign<CompT, AscendC::Reg::LoadDist::DIST_NORM>(accReg,
                                                                          partialAddr + row * reduceElems);
        AscendC::Reg::Add<CompT>(accReg, accReg, redReg, scalarMask);
        AscendC::Reg::StoreAlign<CompT, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            partialAddr + row * reduceElems, accReg, scalarMask);
    }
}

template <typename T, typename CompT, bool NeedCast>
__aicore__ inline void AddmvRowsDot(__ubuf__ CompT *partialAddr, __ubuf__ T *matAddr,
                                    __ubuf__ CompT *vecAddr, int64_t rows, int64_t rowStrideElems,
                                    int64_t kLen)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(CompT);
    uint32_t elementCount = static_cast<uint32_t>(kLen);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<AddmvRowsDotVf<T, CompT, NeedCast>>(partialAddr, matAddr, vecAddr,
                                                    static_cast<uint32_t>(rows),
                                                    static_cast<uint32_t>(rowStrideElems), elementCount,
                                                    chunkCount);
}

/*
 * Epilogue: dst = alpha*acc [+ beta*self].
 * selfMode 0 = self not referenced (beta exactly 0), 1 = contiguous self slice,
 * 2 = stride-0 broadcast scalar. Mode 2 duplicates the scalar into a register first so both
 * self paths perform the exact same multiply and round identically.
 */
template <typename CompT>
__simd_vf__ inline void EpilogueVf(__ubuf__ CompT *dstAddr, __ubuf__ CompT *accAddr,
                                   __ubuf__ CompT *selfAddr, CompT alphaQ, CompT betaQ, CompT selfBcast,
                                   uint32_t selfMode, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(CompT);
    AscendC::Reg::RegTensor<CompT> accReg;
    AscendC::Reg::RegTensor<CompT> outReg;
    AscendC::Reg::RegTensor<CompT> selfReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<CompT>(remaining);
        AscendC::Reg::LoadAlign<CompT, AscendC::Reg::LoadDist::DIST_NORM>(accReg, accAddr + offset);
        AscendC::Reg::Muls<CompT>(outReg, accReg, alphaQ, mask);
        if (selfMode == 1) {
            AscendC::Reg::LoadAlign<CompT, AscendC::Reg::LoadDist::DIST_NORM>(selfReg, selfAddr + offset);
            AscendC::Reg::Muls<CompT>(selfReg, selfReg, betaQ, mask);
            AscendC::Reg::Add<CompT>(outReg, outReg, selfReg, mask);
        } else if (selfMode == 2) {
            AscendC::Reg::Duplicate<CompT>(selfReg, selfBcast, mask);
            AscendC::Reg::Muls<CompT>(selfReg, selfReg, betaQ, mask);
            AscendC::Reg::Add<CompT>(outReg, outReg, selfReg, mask);
        }
        AscendC::Reg::StoreAlign<CompT, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg,
                                                                                mask);
    }
}

template <typename CompT>
__aicore__ inline void EpilogueCompute(__ubuf__ CompT *dstAddr, __ubuf__ CompT *accAddr,
                                       __ubuf__ CompT *selfAddr, CompT alphaQ, CompT betaQ,
                                       CompT selfBcast, uint32_t selfMode, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(CompT);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<EpilogueVf<CompT>>(dstAddr, accAddr, selfAddr, alphaQ, betaQ, selfBcast, selfMode,
                                   elementCount, chunkCount);
}

/* Layer 3: kernel class -------------------------------------------------- */

template <typename T>
class KernelAddmv {
    using CompT = CompType<T>;
    static constexpr bool kNeedCast = NeedCastV<T>;
    static constexpr bool kIsBf16 = std::is_same<T, bfloat16_t>::value;
    static constexpr AscendC::RoundMode kCastOutRound =
        kIsBf16 ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;
    static constexpr int64_t kElemSize = static_cast<int64_t>(sizeof(T));

public:
    __aicore__ inline KernelAddmv() {}

    __aicore__ inline void Init(GM_ADDR selfPtr, GM_ADDR matPtr, GM_ADDR vecPtr, GM_ADDR outPtr, int64_t k,
                                int64_t rowBase, int64_t rowRem, int64_t rowsPerPass, int64_t kt,
                                int64_t ktAlloc, int64_t mt, int64_t numKChunks, int64_t selfStride,
                                int32_t useSelf, int32_t runMatMul, CompT beta, CompT alpha)
    {
        selfGm_.SetGlobalBuffer((__gm__ T *)selfPtr);
        matGm_.SetGlobalBuffer((__gm__ T *)matPtr);
        vecGm_.SetGlobalBuffer((__gm__ T *)vecPtr);
        outGm_.SetGlobalBuffer((__gm__ T *)outPtr);
        k_ = k;
        rowsPerPass_ = rowsPerPass;
        kt_ = kt;
        ktAlloc_ = ktAlloc;
        mt_ = mt;
        numKChunks_ = numKChunks;
        selfStride_ = selfStride;
        useSelf_ = (useSelf != 0);
        runMatMul_ = (runMatMul != 0);
        beta_ = beta;
        alpha_ = alpha;

        // Balanced row split: quotient + remainder, so at most one row of imbalance.
        const int64_t blockIdx = AscendC::GetBlockIdx();
        const int64_t extra = (blockIdx < rowRem) ? blockIdx : rowRem;
        rowStart_ = blockIdx * rowBase + extra;
        myRows_ = rowBase + ((blockIdx < rowRem) ? 1 : 0);

        partialElems_ =
            (AlignUpDev(rowsPerPass_ * BLOCK_BYTES + (VEC_REG_BYTES - BLOCK_BYTES), VEC_REG_BYTES)) /
            static_cast<int64_t>(sizeof(CompT));

        pipe_.InitBuffer(inQueMat_, 2, static_cast<uint32_t>(mt_ * ktAlloc_ * kElemSize));
        pipe_.InitBuffer(inQueVec_, 1, static_cast<uint32_t>(ktAlloc_ * kElemSize));
        pipe_.InitBuffer(inQueSelf_, 1, static_cast<uint32_t>(EPI_ROWS * kElemSize));
        pipe_.InitBuffer(outQueOut_, 2, static_cast<uint32_t>(EPI_ROWS * kElemSize));
        pipe_.InitBuffer(partialBuf_, static_cast<uint32_t>(partialElems_ * sizeof(CompT)));
        pipe_.InitBuffer(accBuf_, static_cast<uint32_t>(EPI_ROWS * sizeof(CompT)));
        pipe_.InitBuffer(offsetBuf_, static_cast<uint32_t>(EPI_ROWS * sizeof(uint32_t)));
        // outCompBuf_ is allocated unconditionally (design E1); on the non-cast path it stays unused
        // and its bytes are pure safety margin -- the UB budget already accounts for them.
        pipe_.InitBuffer(outCompBuf_, static_cast<uint32_t>(EPI_ROWS * sizeof(CompT)));
        if constexpr (kNeedCast) {
            pipe_.InitBuffer(vecCompBuf_, static_cast<uint32_t>(ktAlloc_ * sizeof(float)));
            pipe_.InitBuffer(selfCompBuf_, static_cast<uint32_t>(EPI_ROWS * sizeof(float)));
            pipe_.InitBuffer(scratchCompBuf_, static_cast<uint32_t>(SCRATCH_BYTES));
        }
        // Reg::LoadAlign touches a whole vector register, so the scratch slots are a full 256B even
        // though only one element is live. The extra bytes come out of SAFETY_BYTES.
        pipe_.InitBuffer(scratchRawBuf_, static_cast<uint32_t>(SCRATCH_BYTES));

        if (myRows_ <= 0) {
            return;
        }
        AscendC::LocalTensor<int32_t> offsetLocal = offsetBuf_.template Get<int32_t>();
        BuildGatherOffset((__ubuf__ int32_t *)offsetLocal.GetPhyAddr(), EPI_ROWS);
        AscendC::PipeBarrier<PIPE_V>();                                                        // S7
        LoadBroadcastSelf();
    }

    __aicore__ inline void Process()
    {
        if (myRows_ <= 0) {
            return;
        }
        for (int64_t passOff = 0; passOff < myRows_; passOff += rowsPerPass_) {
            const int64_t pRows = MinDev(rowsPerPass_, myRows_ - passOff);
            RunPass(rowStart_ + passOff, pRows);
        }
    }

private:
    static __aicore__ inline int64_t MinDev(int64_t a, int64_t b) { return (a < b) ? a : b; }

    static __aicore__ inline int64_t AlignUpDev(int64_t value, int64_t granule)
    {
        return ((value + granule - 1) / granule) * granule;
    }

    /* self is a stride-0 broadcast: read the single element once, in Init. */
    __aicore__ inline void LoadBroadcastSelf()
    {
        selfBcast_ = static_cast<CompT>(0);
        if (!useSelf_ || selfStride_ != 0) {
            return;
        }
        AscendC::LocalTensor<T> scratchRaw = scratchRawBuf_.template Get<T>();
        AscendC::DataCopyExtParams copyIn;
        copyIn.blockCount = 1;
        copyIn.blockLen = static_cast<uint32_t>(kElemSize);
        copyIn.srcStride = 0;
        copyIn.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams;
        AscendC::DataCopyPad(scratchRaw, selfGm_, copyIn, padParams);
        AscendC::PipeBarrier<PIPE_ALL>();                                                      // S13a
        if constexpr (kNeedCast) {
            AscendC::LocalTensor<float> scratchComp = scratchCompBuf_.template Get<float>();
            CastToComp<T>((__ubuf__ float *)scratchComp.GetPhyAddr(),
                          (__ubuf__ T *)scratchRaw.GetPhyAddr(), 1);
            AscendC::PipeBarrier<PIPE_ALL>();                                                  // S13b
            selfBcast_ = static_cast<CompT>(scratchComp.GetValue(0));
        } else {
            selfBcast_ = static_cast<CompT>(scratchRaw.GetValue(0));
        }
    }

    __aicore__ inline void RunPass(int64_t pStart, int64_t pRows)
    {
        AscendC::LocalTensor<CompT> partial = partialBuf_.template Get<CompT>();
        ZeroReg<CompT>((__ubuf__ CompT *)partial.GetPhyAddr(), partialElems_);
        AscendC::PipeBarrier<PIPE_V>();                                                        // S4
        if (runMatMul_) {
            for (int64_t kc = 0; kc < numKChunks_; ++kc) {
                RunKChunk(pStart, pRows, kc);
            }
        }
        AscendC::PipeBarrier<PIPE_V>();                                                        // S6
        RunEpilogue(pStart, pRows);
    }

    __aicore__ inline void RunKChunk(int64_t pStart, int64_t pRows, int64_t kc)
    {
        const int64_t kOff = kc * kt_;
        const int64_t kLen = MinDev(kt_, k_ - kOff);

        AscendC::LocalTensor<T> vecRaw = inQueVec_.template AllocTensor<T>();
        AscendC::DataCopyExtParams copyVec;
        copyVec.blockCount = 1;
        copyVec.blockLen = static_cast<uint32_t>(kLen * kElemSize);
        copyVec.srcStride = 0;
        copyVec.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams;
        AscendC::DataCopyPad(vecRaw, vecGm_[kOff], copyVec, padParams);
        inQueVec_.EnQue(vecRaw);
        vecRaw = inQueVec_.template DeQue<T>();                                                // S2

        __ubuf__ CompT *vecComp = (__ubuf__ CompT *)vecRaw.GetPhyAddr();
        if constexpr (kNeedCast) {
            AscendC::LocalTensor<float> vecCompLocal = vecCompBuf_.template Get<float>();
            vecComp = (__ubuf__ CompT *)vecCompLocal.GetPhyAddr();
            CastToComp<T>((__ubuf__ float *)vecCompLocal.GetPhyAddr(),
                          (__ubuf__ T *)vecRaw.GetPhyAddr(), kLen);
            AscendC::PipeBarrier<PIPE_V>();                                                    // S3
        }

        AscendC::LocalTensor<CompT> partial = partialBuf_.template Get<CompT>();
        __ubuf__ CompT *partialAddr = (__ubuf__ CompT *)partial.GetPhyAddr();
        for (int64_t rtOff = 0; rtOff < pRows; rtOff += mt_) {
            const int64_t rows = MinDev(mt_, pRows - rtOff);
            RunRowTile(partialAddr + rtOff * REDUCE_ELEMS, vecComp, pStart + rtOff, kOff, kLen, rows);
        }
        inQueVec_.FreeTensor(vecRaw);
        AscendC::PipeBarrier<PIPE_V>();                                                        // S5
    }

    __aicore__ inline void RunRowTile(__ubuf__ CompT *partialAddr, __ubuf__ CompT *vecComp, int64_t gRow,
                                      int64_t kOff, int64_t kLen, int64_t rows)
    {
        AscendC::LocalTensor<T> matTile = inQueMat_.template AllocTensor<T>();
        AscendC::DataCopyExtParams copyMat;
        copyMat.blockCount = static_cast<uint16_t>(rows);
        copyMat.blockLen = static_cast<uint32_t>(kLen * kElemSize);
        copyMat.srcStride = static_cast<int64_t>((k_ - kLen) * kElemSize);
        copyMat.dstStride =
            static_cast<int64_t>((ktAlloc_ * kElemSize - AlignUpDev(kLen * kElemSize, BLOCK_BYTES)) /
                                 BLOCK_BYTES);
        AscendC::DataCopyPadExtParams<T> padParams;
        AscendC::DataCopyPad(matTile, matGm_[gRow * k_ + kOff], copyMat, padParams);
        inQueMat_.EnQue(matTile);
        matTile = inQueMat_.template DeQue<T>();                                               // S1
        AddmvRowsDot<T, CompT, kNeedCast>(partialAddr, (__ubuf__ T *)matTile.GetPhyAddr(), vecComp, rows,
                                          ktAlloc_, kLen);
        inQueMat_.FreeTensor(matTile);
    }

    __aicore__ inline void RunEpilogue(int64_t pStart, int64_t pRows)
    {
        for (int64_t off = 0; off < pRows; off += EPI_ROWS) {
            const int64_t rows = MinDev(EPI_ROWS, pRows - off);
            RunEpilogueTile(pStart + off, off, rows);
        }
    }

    __aicore__ inline void RunEpilogueTile(int64_t gRow, int64_t partialOff, int64_t rows)
    {
        AscendC::LocalTensor<CompT> partial = partialBuf_.template Get<CompT>();
        AscendC::LocalTensor<CompT> acc = accBuf_.template Get<CompT>();
        AscendC::LocalTensor<uint32_t> offsetLocal = offsetBuf_.template Get<uint32_t>();
        AscendC::LocalTensor<T> outRaw = outQueOut_.template AllocTensor<T>();

        // Compact the 32B-strided row sums into a dense vector. AscendC::Gather is the only MemBase
        // vector API in this kernel; it is called outside any asc_vf_call and fenced on both sides.
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Gather(acc, partial, offsetLocal, static_cast<uint32_t>(partialOff * BLOCK_BYTES),
                        static_cast<uint32_t>(rows));
        AscendC::PipeBarrier<PIPE_V>();                                                        // S8

        // kNeedCast == false: CompT == T, compute straight into the output queue tensor so the
        // V->MTE3 hand-off and the cross-tile WAR stay covered by S12 (design B3).
        __ubuf__ CompT *dstAddr = (__ubuf__ CompT *)outRaw.GetPhyAddr();
        if constexpr (kNeedCast) {
            dstAddr = (__ubuf__ CompT *)outCompBuf_.template Get<CompT>().GetPhyAddr();
        }

        uint32_t selfMode = 0;
        __ubuf__ CompT *selfAddr = (__ubuf__ CompT *)acc.GetPhyAddr();   // unused unless selfMode == 1
        AscendC::LocalTensor<T> selfRaw;
        if (useSelf_) {
            if (selfStride_ == 0) {
                selfMode = 2;
            } else {
                selfRaw = LoadSelfSlice(gRow, rows);
                selfAddr = (__ubuf__ CompT *)selfRaw.GetPhyAddr();
                if constexpr (kNeedCast) {
                    AscendC::LocalTensor<float> selfComp = selfCompBuf_.template Get<float>();
                    CastToComp<T>((__ubuf__ float *)selfComp.GetPhyAddr(),
                                  (__ubuf__ T *)selfRaw.GetPhyAddr(), rows);
                    AscendC::PipeBarrier<PIPE_V>();                                            // S10
                    selfAddr = (__ubuf__ CompT *)selfComp.GetPhyAddr();
                }
                selfMode = 1;
            }
        }

        EpilogueCompute<CompT>(dstAddr, (__ubuf__ CompT *)acc.GetPhyAddr(), selfAddr, alpha_, beta_,
                               selfBcast_, selfMode, rows);
        if (selfMode == 1) {
            inQueSelf_.FreeTensor(selfRaw);
        }
        if constexpr (kNeedCast) {
            AscendC::PipeBarrier<PIPE_V>();                                                    // S11
            CastFromComp<T, kCastOutRound>((__ubuf__ T *)outRaw.GetPhyAddr(),
                                           (__ubuf__ float *)dstAddr, rows);
        }
        StoreOutTile(outRaw, gRow, rows);
    }

    /* V->MTE3 write-back of one epilogue tile; the queue hand-off is S12. */
    __aicore__ inline void StoreOutTile(AscendC::LocalTensor<T> &outRaw, int64_t gRow, int64_t rows)
    {
        outQueOut_.EnQue(outRaw);
        outRaw = outQueOut_.template DeQue<T>();                                               // S12
        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(rows * kElemSize);
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(outGm_[gRow], outRaw, copyOut);
        outQueOut_.FreeTensor(outRaw);
    }

    __aicore__ inline AscendC::LocalTensor<T> LoadSelfSlice(int64_t gRow, int64_t rows)
    {
        AscendC::LocalTensor<T> selfRaw = inQueSelf_.template AllocTensor<T>();
        AscendC::DataCopyExtParams copySelf;
        copySelf.blockCount = 1;
        copySelf.blockLen = static_cast<uint32_t>(rows * kElemSize);
        copySelf.srcStride = 0;
        copySelf.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams;
        AscendC::DataCopyPad(selfRaw, selfGm_[gRow], copySelf, padParams);
        inQueSelf_.EnQue(selfRaw);
        return inQueSelf_.template DeQue<T>();                                                 // S9
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> selfGm_;
    AscendC::GlobalTensor<T> matGm_;
    AscendC::GlobalTensor<T> vecGm_;
    AscendC::GlobalTensor<T> outGm_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 2> inQueMat_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueVec_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueSelf_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 2> outQueOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> vecCompBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> offsetBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> selfCompBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> outCompBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchRawBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchCompBuf_;
    int64_t k_ = 0;
    int64_t rowsPerPass_ = 1;
    int64_t kt_ = 1;
    int64_t ktAlloc_ = VL_COMP;
    int64_t mt_ = 1;
    int64_t numKChunks_ = 0;
    int64_t selfStride_ = 1;
    int64_t rowStart_ = 0;
    int64_t myRows_ = 0;
    int64_t partialElems_ = 0;
    bool useSelf_ = true;
    bool runMatMul_ = true;
    CompT beta_ = static_cast<CompT>(0);
    CompT alpha_ = static_cast<CompT>(0);
    CompT selfBcast_ = static_cast<CompT>(0);
};

template <typename T>
__global__ __aicore__ __vector__ void addmv_kernel(GM_ADDR selfPtr, GM_ADDR matPtr, GM_ADDR vecPtr,
                                                   GM_ADDR outPtr, int64_t k, int64_t rowBase,
                                                   int64_t rowRem, int64_t rowsPerPass, int64_t kt,
                                                   int64_t ktAlloc, int64_t mt, int64_t numKChunks,
                                                   int64_t selfStride, int32_t useSelf, int32_t runMatMul,
                                                   CompType<T> beta, CompType<T> alpha)
{
    if (AscendC::GetSubBlockIdx() != 0) {
        return;
    }
    KernelAddmv<T> op;
    op.Init(selfPtr, matPtr, vecPtr, outPtr, k, rowBase, rowRem, rowsPerPass, kt, ktAlloc, mt,
            numKChunks, selfStride, useSelf, runMatMul, beta, alpha);
    op.Process();
}

/* ── 5. NPU dispatch ───────────────────────────────────────────────────── */

/*
 * P10: beta/alpha are quantized straight to the compute precision (fp32 for fp16/bf16 outputs),
 * never through the output dtype. Scalar::to<int32_t>() stays banned -- its checked_convert throws
 * instead of producing a readable TORCH_CHECK; the int32 range was already validated in
 * addmv_check (P12'), so trunc + static_cast here is well defined.
 */
template <typename CompT>
static inline CompT QuantizeScalar(const c10::Scalar &s)
{
    const double v = s.to<double>();
    if constexpr (std::is_same<CompT, int32_t>::value) {
        return static_cast<int32_t>(std::trunc(v));
    } else {
        return static_cast<float>(v);
    }
}

template <typename T>
static void launch_kernel(GM_ADDR selfPtr, GM_ADDR matPtr, GM_ADDR vecPtr, GM_ADDR outPtr, int64_t m,
                          int64_t k, int64_t selfStride, const c10::Scalar &beta, const c10::Scalar &alpha,
                          aclrtStream stream)
{
    using CompT = CompType<T>;
    // Judging zero and taking the value are two independent rules (P9): the short circuits look at
    // the raw Scalar, the arithmetic uses the CompT-quantized value.
    const bool useSelf = (beta.to<double>() != 0.0);
    const bool runMatMul = (alpha.to<double>() != 0.0);
    const CompT betaQ = QuantizeScalar<CompT>(beta);
    const CompT alphaQ = QuantizeScalar<CompT>(alpha);

    const AddmvTiling t =
        calc_tiling_params(m, k, static_cast<int64_t>(sizeof(T)), NeedCastV<T>, runMatMul);
    addmv_kernel<T><<<t.numBlocks, nullptr, stream>>>(
        selfPtr, matPtr, vecPtr, outPtr, k, t.rowBase, t.rowRem, t.rowsPerPass, t.kt, t.ktAlloc, t.mt,
        t.numKChunks, selfStride, useSelf ? 1 : 0, runMatMul ? 1 : 0, betaQ, alphaQ);
}

torch::Tensor addmv_npu(const torch::Tensor &self, const torch::Tensor &mat, const torch::Tensor &vec,
                        const c10::Scalar &beta, const c10::Scalar &alpha)
{
    // C1: all validation first, synchronously, before any device operation or launch.
    addmv_check(self, mat, vec, beta, alpha, /*checkDevice=*/true);

    const c10::OptionalDeviceGuard guard(mat.device());
    const int64_t m = mat.size(0);
    const int64_t k = mat.size(1);
    auto out = torch::empty({m}, mat.options());
    if (m == 0) {
        return out;
    }

    // Rule 1 of the normalization table: the three stride-0 broadcast shapes go through untouched
    // (no expand materialization, no contiguous copy). || short-circuits so stride(0) is never
    // called on a 0-dim tensor.
    const bool selfIsBroadcast = (self.numel() == 1) || (self.dim() == 1 && self.stride(0) == 0);
    auto selfC = selfIsBroadcast ? self : self.contiguous();   // rule 2
    auto matC = mat.contiguous();
    auto vecC = vec.contiguous();
    const int64_t selfStride = selfIsBroadcast ? 0 : 1;

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto selfPtr = (GM_ADDR)selfC.data_ptr();
    auto matPtr = (GM_ADDR)matC.data_ptr();
    auto vecPtr = (GM_ADDR)vecC.data_ptr();
    auto outPtr = (GM_ADDR)out.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            matC.scalar_type(), "addmv_npu",
            AT_DISPATCH_CASE(torch::kFloat32,
                             [&] {
                                 launch_kernel<float>(selfPtr, matPtr, vecPtr, outPtr, m, k, selfStride,
                                                      beta, alpha, stream);
                             })
            AT_DISPATCH_CASE(torch::kFloat16,
                             [&] {
                                 launch_kernel<half>(selfPtr, matPtr, vecPtr, outPtr, m, k, selfStride,
                                                     beta, alpha, stream);
                             })
            AT_DISPATCH_CASE(torch::kBFloat16,
                             [&] {
                                 launch_kernel<bfloat16_t>(selfPtr, matPtr, vecPtr, outPtr, m, k,
                                                           selfStride, beta, alpha, stream);
                             })
            AT_DISPATCH_CASE(torch::kInt32,
                             [&] {
                                 launch_kernel<int32_t>(selfPtr, matPtr, vecPtr, outPtr, m, k, selfStride,
                                                        beta, alpha, stream);
                             }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Addmv", acl_call);
    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("addmv", addmv_npu);
}

} // namespace Addmv
} // namespace ops_multimodal_fusion
