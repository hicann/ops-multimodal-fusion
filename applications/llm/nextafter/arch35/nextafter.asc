/*!
 * \file nextafter.asc
 * \brief Nextafter (next representable float in `a` toward `b`) operator
 *        for Ascend NPU (dav-3510).
 *
 * torch.nextafter(a, b) -> c
 *
 * Scope (per issue #95): float32 on dav-3510. PyTorch's CPU/CUDA implementation
 * also restricts `nextafter` to fp32/fp64 - fp16 is intentionally not supported
 * because the granularity (one ulp at any magnitude) is part of the contract
 * and only meaningful for IEEE-754 binary32 / binary64.
 *
 * Algorithm (per-element, bit-level):
 *   General case (a != b, a != 0):
 *     delta = sign(a) * sign(b - a)         (= +1 to step away from zero,
 *                                              -1 to step toward zero)
 *     cBits = aBits + delta                 (bit increment in same-sign space)
 *
 *   Equality: when a == b, return b. This also keeps the IEEE convention
 *   for ±0 (nextafter(+0, -0) == -0, etc.).
 *
 *   Zero case: when a == 0 and b != 0, the result must be the smallest
 *   subnormal in the direction of b, which has bit pattern
 *     (bBits & 0x80000000) | 0x00000001     (sign of b OR 1).
 *   This is the only case the simple "bit ± 1" rule misses, because in
 *   sign-magnitude bit space +0 (0x00000000) and -0 (0x80000000) are
 *   adjacent to each other rather than to ±denorm_min.
 *
 *   NaN inputs are not handled - the test suite excludes NaN per scope.
 *
 * The kernel uses AscendC vector Compare + Select to build the masks and
 * splice the special cases on top of the general result.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Nextafter {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("nextafter(Tensor a, Tensor b) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor nextafter_meta(const torch::Tensor &a, const torch::Tensor &b)
{
    TORCH_CHECK(a.sizes() == b.sizes(),
                "nextafter: shapes must match, got ", a.sizes(), " vs ", b.sizes());
    TORCH_CHECK(a.scalar_type() == b.scalar_type(),
                "nextafter: dtypes must match, got ", a.scalar_type(),
                " vs ", b.scalar_type());
    TORCH_CHECK(a.scalar_type() == torch::kFloat32,
                "nextafter: only float32 is supported on dav-3510, got ",
                a.scalar_type());
    return torch::empty_like(a);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("nextafter", nextafter_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // Per-tile UB inventory:
    //   3 queues × PIPELINE_DEPTH = 6 buffers (a, b, c)
    //   6 full-tile TBufs (4 constants + 2 scratch)
    //   2 mask TBufs (uint8, 1 bit per elem; sized to 1/4 tileSize for safety)
    constexpr static int64_t FULL_TILE_BUFS = PIPELINE_DEPTH * 3 + 6; // = 12
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    // Approximate budget: full-tile bufs use FULL_TILE_BUFS * tileSize bytes,
    // mask bufs use 2 * tileSize/4 = tileSize/2 bytes. Total ~ 12.5 * tileSize.
    int64_t tileSize = static_cast<int64_t>(ubSize) / 13;
    tileSize = (tileSize / 32) * 32; // align to 32 bytes
    TORCH_CHECK(tileSize > 0, "nextafter: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// ===================== 4. Kernel =====================

class KernelNextafter {
public:
    __aicore__ inline KernelNextafter() {}

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        aGm_.SetGlobalBuffer((__gm__ float *)a + blockLength * AscendC::GetBlockIdx());
        bGm_.SetGlobalBuffer((__gm__ float *)b + blockLength * AscendC::GetBlockIdx());
        cGm_.SetGlobalBuffer((__gm__ float *)c + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueA_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(inQueueB_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueC_, PIPELINE_DEPTH, tileSize);

        pipe_.InitBuffer(constSignMaskTBuf_, tileSize); // int32 0x80000000 vector
        pipe_.InitBuffer(constOneIntTBuf_,   tileSize); // int32 1 vector
        pipe_.InitBuffer(constPlusOneTBuf_,  tileSize); // float +1.0 vector
        pipe_.InitBuffer(constMinusOneTBuf_, tileSize); // float -1.0 vector
        pipe_.InitBuffer(scratchFloatTBuf_,  tileSize); // float scratch
        pipe_.InitBuffer(scratchIntTBuf_,    tileSize); // int32 scratch
        // Mask buffers - uint8, 1 bit per element. tileSize/4 bytes is 8x what
        // is needed (= 1 byte per fp32 element); generous to keep alignment.
        pipe_.InitBuffer(maskTBuf1_, tileSize / 4);
        pipe_.InitBuffer(maskTBuf2_, tileSize / 4);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileSize / sizeof(float);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;

        // Populate constants once. PIPE_V barrier ensures these complete
        // before the first per-tile Compare/Select reads them.
        AscendC::Duplicate(constSignMaskTBuf_.Get<int32_t>(),
                           static_cast<int32_t>(0x80000000),
                           static_cast<int32_t>(elementNumPerTile_));
        AscendC::Duplicate(constOneIntTBuf_.Get<int32_t>(),
                           static_cast<int32_t>(1),
                           static_cast<int32_t>(elementNumPerTile_));
        AscendC::Duplicate(constPlusOneTBuf_.Get<float>(),
                           1.0f,
                           static_cast<int32_t>(elementNumPerTile_));
        AscendC::Duplicate(constMinusOneTBuf_.Get<float>(),
                           -1.0f,
                           static_cast<int32_t>(elementNumPerTile_));
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};

        AscendC::LocalTensor<float> aLocal = inQueueA_.template AllocTensor<float>();
        AscendC::LocalTensor<float> bLocal = inQueueB_.template AllocTensor<float>();
        AscendC::DataCopyPad(aLocal, aGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(bLocal, bGm_[offset], copyParams, padParams);
        inQueueA_.EnQue(aLocal);
        inQueueB_.EnQue(bLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<float> aLocal = inQueueA_.template DeQue<float>();
        AscendC::LocalTensor<float> bLocal = inQueueB_.template DeQue<float>();
        AscendC::LocalTensor<float> cLocal = outQueueC_.template AllocTensor<float>();

        AscendC::LocalTensor<int32_t> aBits = aLocal.template ReinterpretCast<int32_t>();
        AscendC::LocalTensor<int32_t> bBits = bLocal.template ReinterpretCast<int32_t>();
        AscendC::LocalTensor<int32_t> cBits = cLocal.template ReinterpretCast<int32_t>();

        AscendC::LocalTensor<float>   sf       = scratchFloatTBuf_.template Get<float>();
        AscendC::LocalTensor<int32_t> si       = scratchIntTBuf_.template Get<int32_t>();
        AscendC::LocalTensor<int32_t> cSignM   = constSignMaskTBuf_.template Get<int32_t>();
        AscendC::LocalTensor<int32_t> cOneI    = constOneIntTBuf_.template Get<int32_t>();
        AscendC::LocalTensor<float>   cPlus    = constPlusOneTBuf_.template Get<float>();
        AscendC::LocalTensor<float>   cMinus   = constMinusOneTBuf_.template Get<float>();
        AscendC::LocalTensor<uint8_t> m1       = maskTBuf1_.template Get<uint8_t>();
        AscendC::LocalTensor<uint8_t> m2       = maskTBuf2_.template Get<uint8_t>();

        // 1. eqMask (kept in m1): a == b
        AscendC::Compare(m1, aLocal, bLocal, AscendC::CMPMODE::EQ, count);
        AscendC::PipeBarrier<PIPE_V>();

        // 2. signA = (a >= 0) ? +1.0 : -1.0   (using m2)
        AscendC::CompareScalar(m2, aLocal, 0.0f, AscendC::CMPMODE::GE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Select(sf, m2, cPlus, cMinus,
                        AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        AscendC::PipeBarrier<PIPE_V>();

        // 3. signDiff = (b > a) ? +1.0 : -1.0   (write into cLocal as scratch
        //    - cBits will be overwritten by the Add at step 6)
        AscendC::Compare(m2, bLocal, aLocal, AscendC::CMPMODE::GT, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Select(cLocal, m2, cPlus, cMinus,
                        AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        AscendC::PipeBarrier<PIPE_V>();

        // 4. delta_float = signA * signDiff   (in sf)
        AscendC::Mul(sf, sf, cLocal, count);
        AscendC::PipeBarrier<PIPE_V>();

        // 5. delta_int = round(delta_float)   (= ±1 exactly)
        AscendC::Cast(si, sf, AscendC::RoundMode::CAST_RINT, count);
        AscendC::PipeBarrier<PIPE_V>();

        // 6. General case: cBits = aBits + delta_int
        AscendC::Add(cBits, aBits, si, count);
        AscendC::PipeBarrier<PIPE_V>();

        // 7. Zero case (a == 0): cBits = (bBits & 0x80000000) | 1
        AscendC::CompareScalar(m2, aLocal, 0.0f, AscendC::CMPMODE::EQ, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::And(si, bBits, cSignM, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Or(si, si, cOneI, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Select(cBits, m2, si, cBits,
                        AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        AscendC::PipeBarrier<PIPE_V>();

        // 8. Equality case (a == b): c = b   (m1 still holds eqMask)
        AscendC::Select(cBits, m1, bBits, cBits,
                        AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        AscendC::PipeBarrier<PIPE_V>();

        inQueueA_.FreeTensor(aLocal);
        inQueueB_.FreeTensor(bLocal);
        outQueueC_.EnQue(cLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<float> cLocal = outQueueC_.template DeQue<float>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(cGm_[offset], cLocal, copyParams);
        outQueueC_.FreeTensor(cLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> aGm_, bGm_, cGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueA_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueB_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueC_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> constSignMaskTBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> constOneIntTBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> constPlusOneTBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> constMinusOneTBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchFloatTBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchIntTBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maskTBuf1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maskTBuf2_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

__global__ __aicore__ __vector__ void nextafter_kernel(
    GM_ADDR a, GM_ADDR b, GM_ADDR c,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelNextafter op;
    op.Init(a, b, c, totalLength, blockLength, tileSize);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor nextafter_npu(const torch::Tensor &a_in, const torch::Tensor &b_in)
{
    TORCH_CHECK(a_in.sizes() == b_in.sizes(),
                "nextafter: shapes must match, got ", a_in.sizes(), " vs ", b_in.sizes());
    TORCH_CHECK(a_in.scalar_type() == b_in.scalar_type(),
                "nextafter: dtypes must match, got ", a_in.scalar_type(),
                " vs ", b_in.scalar_type());
    TORCH_CHECK(a_in.scalar_type() == torch::kFloat32,
                "nextafter: only float32 is supported on dav-3510, got ",
                a_in.scalar_type());

    const c10::OptionalDeviceGuard guard(a_in.device());
    auto a = a_in.contiguous();
    auto b = b_in.contiguous();
    auto c = torch::empty_like(a);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = a.numel();
    if (totalLength == 0) {
        return c;
    }
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto a_ptr = (GM_ADDR)a.data_ptr();
    auto b_ptr = (GM_ADDR)b.data_ptr();
    auto c_ptr = (GM_ADDR)c.data_ptr();

    auto acl_call = [=]() -> int {
        nextafter_kernel<<<numBlocks, nullptr, stream>>>(
            a_ptr, b_ptr, c_ptr, totalLength, blockLength, tileSize);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Nextafter", acl_call);
    return c;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("nextafter", nextafter_npu);
}

} // namespace Nextafter
} // namespace ops_multimodal_fusion
