/*!
 * \file c2_lars.asc
 * \brief RegBase Caffe2 LARS (Layer-wise Adaptive Rate Scaling) operator for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.c2_lars(X, dX, wd, trust, lr_max, offset=0.5, lr_min=0.02) -> Tensor
 *   X, dX               : same shape, same dtype, fp32 / fp16 / bf16
 *   wd, trust, lr_max   : 1-element fp32 scalar tensors on the same device
 *   offset, lr_min      : host float attributes, both >= 0
 *   returns             : 0-D fp32 scalar, independent of the input dtype
 *
 *   X_norm  = ||X||_2 ;  dX_norm = ||dX||_2
 *   val     = (X_norm > 0) ? trust / (dX_norm / X_norm + wd + offset) : 1.0
 *   out     = max(min(val, lr_max), lr_min)
 *
 * Two sequential launches on one stream (design 2.2 section 5):
 *   stage 1  c2_lars_partial_kernel<T> <<<numBlocks>>>  every core reduces its slice of X and dX
 *            into sum-of-squares partials and writes them to its own 32B workspace slot
 *   stage 2  c2_lars_finalize_kernel   <<<1>>>          merges the partials, then runs the 1-lane
 *            scalar epilogue (sqrt / div / branch / clamp) and stores the 0-D output
 * The cross-stage read-after-write on the workspace relies on ACL in-order execution within a
 * stream plus kernel-boundary GM visibility; that was validated on device before this
 * implementation was filled in (design 2.2 section 7 puncture check).
 *
 * Reg shape - 3 layers, LocalTensor and RegTensor never mix across layers:
 *   Layer 1 __simd_vf__  LarsZeroSlotVf / LarsSqSumPairVf<T, NeedCast> / LarsReduceWsVf /
 *                        LarsEpilogueVf   -- pure RegTensor + MaskReg over __ubuf__ pointers
 *   Layer 2 __aicore__   thin wrappers doing GetPhyAddr() -> __ubuf__ and asc_vf_call
 *   Layer 3 kernel class KernelC2LarsPartial<T> / KernelC2LarsFinalize -- TPipe / TQue / TBuf /
 *                        DataCopyPad / multi-core offsets / tile loop
 *
 * fp16 and bf16 are widened to fp32 by LoadAlign<T, DIST_UNPACK_B16> + Reg::Cast before any
 * arithmetic; squares and every accumulation level stay in fp32, and the output is always fp32 so
 * there is no narrowing cast on the way out.
 *
 * Reduction tails are closed purely with MaskReg: Reg::Mul and Reg::Reduce default to
 * MaskMergeMode::ZEROING, so lanes past the valid element count contribute an exact zero
 * regardless of what the UB happens to hold. The DataCopyPad right padding is defence in depth,
 * never a correctness dependency.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <cstdint>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace C2Lars {

/* ── Shared constants ──────────────────────────────────────────────────── */

constexpr int64_t BLOCK_BYTES = 32;                            // one UB DataBlock
constexpr int64_t FLOAT_BYTES = 4;                             // sizeof(float)
// Vector register width on dav-3510. AscendC::VECTOR_REG_WIDTH is guarded by __NPU_ARCH__ and is
// therefore only visible to the device compilation pass, so host tiling needs this mirror; the
// device-side static_assert in LarsZeroSlotVf keeps the two values in sync.
constexpr int64_t VEC_REG_BYTES = 256;
constexpr int64_t VL_F32 = VEC_REG_BYTES / FLOAT_BYTES;        // 64 fp32 lanes per vector register
constexpr int64_t WS_SLOT_FLOATS = BLOCK_BYTES / FLOAT_BYTES;  // 8 floats: one 32B slot per core
constexpr int64_t PIPELINE_DEPTH = 2;                          // double buffer
constexpr int64_t MIN_ELEMS_PER_CORE = 2048;                   // do not spread tiny shapes over all cores
constexpr int64_t MAX_TILE_ELEMS = 8192;                       // caps UB usage and DMA blockLen
constexpr int64_t SAFETY_BYTES = 2048;                         // budget slack, never allocated
constexpr int64_t SCALAR_RESERVE_BYTES = 4 * VEC_REG_BYTES;    // scalar slots kept out of the tile budget
constexpr int64_t NUMEL_MAX = 0x7fffffff;                      // C6

/* The only compile-time fork in the compute kernel: b16 needs an unpack + widening cast. */
template <typename T> constexpr bool NeedCastV = !std::is_same<T, float>::value;

/* ── 1. Schema ─────────────────────────────────────────────────────────── */

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_lars(Tensor X, Tensor dX, Tensor wd, Tensor trust, Tensor lr_max, float offset=0.5, "
          "float lr_min=0.02) -> Tensor");
}

/* ── Host helpers ──────────────────────────────────────────────────────── */

static inline int64_t AlignDownHost(int64_t value, int64_t granule)
{
    return (value / granule) * granule;
}

static void check_scalar_tensor(const torch::Tensor &t, const char *name)
{
    TORCH_CHECK(t.numel() == 1, "c2_lars: ", name, " must be a 1-element scalar tensor, got numel=",
                t.numel());                                                                        // C3
    TORCH_CHECK(t.scalar_type() == torch::kFloat32, "c2_lars: ", name, " dtype must be float32, got ",
                t.scalar_type());                                                                  // C3
}

/*
 * Hard constraint C1..C6: every argument check lives here, runs host-side and synchronously,
 * before any device work or kernel launch. AT_DISPATCH_SWITCH therefore only ever maps an already
 * validated dtype to a template instance and can never reach its default error branch.
 * Deliberate deviation from the repo template: an empty X is rejected instead of short-circuited,
 * because C1 declares numel == 0 to be invalid input rather than a degenerate case.
 */
static void c2_lars_check(const torch::Tensor &X, const torch::Tensor &dX, const torch::Tensor &wd,
                          const torch::Tensor &trust, const torch::Tensor &lr_max, double offset,
                          double lr_min, bool checkDevice)
{
    TORCH_CHECK(X.numel() >= 1, "c2_lars: X must be non-empty, got numel=", X.numel());             // C1
    TORCH_CHECK(X.scalar_type() == torch::kFloat32 || X.scalar_type() == torch::kFloat16 ||
                X.scalar_type() == torch::kBFloat16,
                "c2_lars: X dtype must be float32/float16/bfloat16, got ", X.scalar_type());        // C1
    TORCH_CHECK(dX.sizes() == X.sizes(), "c2_lars: dX shape ", dX.sizes(), " must equal X shape ",
                X.sizes());                                                                        // C2
    TORCH_CHECK(dX.scalar_type() == X.scalar_type(), "c2_lars: dX dtype must match X dtype, got ",
                dX.scalar_type(), " vs ", X.scalar_type());                                        // C2
    check_scalar_tensor(wd, "wd");                                                                 // C3
    check_scalar_tensor(trust, "trust");                                                           // C3
    check_scalar_tensor(lr_max, "lr_max");                                                         // C3
    // NaN fails both comparisons and is rejected here; +inf passes and propagates through the
    // epilogue, which is the natural result of the constraint rather than a special case.
    TORCH_CHECK(offset >= 0, "c2_lars: offset must be >= 0, got ", offset);                         // C4
    TORCH_CHECK(lr_min >= 0, "c2_lars: lr_min must be >= 0, got ", lr_min);                         // C5
    TORCH_CHECK(X.numel() <= NUMEL_MAX, "c2_lars: X.numel()=", X.numel(), " exceeds INT32_MAX");    // C6
    if (checkDevice) {
        TORCH_CHECK(X.device().is_privateuseone(), "c2_lars: X must be on an NPU device, got ",
                    X.device());                                                                   // C1
        TORCH_CHECK(dX.device() == X.device() && wd.device() == X.device() &&
                    trust.device() == X.device() && lr_max.device() == X.device(),
                    "c2_lars: dX/wd/trust/lr_max must be on the same device as X");                 // C3
    }
}

/* ── 2. Meta ───────────────────────────────────────────────────────────── */

torch::Tensor c2_lars_meta(const torch::Tensor &X, const torch::Tensor &dX, const torch::Tensor &wd,
                           const torch::Tensor &trust, const torch::Tensor &lr_max, double offset,
                           double lr_min)
{
    c2_lars_check(X, dX, wd, trust, lr_max, offset, lr_min, /*checkDevice=*/false);
    return torch::empty({}, X.options().dtype(torch::kFloat32));                                    // C7
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_lars", c2_lars_meta);
}

/* ── 3. Tiling (host) ──────────────────────────────────────────────────── */

/*
 * Returns (numBlocks, blockLength, tileElems).
 * blockLength is rounded up to a whole number of 32B units so every core's DMA segment starts
 * 32B-aligned and only the very last tile of the last core can be ragged. tileElems is a multiple
 * of the fp32 register lane count, which keeps Reg::LoadAlign's 256B granule inside the tile buffer.
 */
static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    const int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_lars: coreNum must be positive");

    const int64_t laneAlign = BLOCK_BYTES / elemSize;
    const int64_t units = (numel + laneAlign - 1) / laneAlign;
    int64_t numBlocks = (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE;
    numBlocks = std::max<int64_t>(std::min(coreNum, numBlocks), 1);
    const int64_t blockLength = ((units + numBlocks - 1) / numBlocks) * laneAlign;

    const int64_t usable = static_cast<int64_t>(ubSize) - SCALAR_RESERVE_BYTES - SAFETY_BYTES;
    TORCH_CHECK(usable > 0, "c2_lars: UB is too small for one aligned tile");
    int64_t tileElems = AlignDownHost(usable / (2 * PIPELINE_DEPTH * elemSize), VL_F32);
    tileElems = std::min(tileElems, MAX_TILE_ELEMS);
    TORCH_CHECK(tileElems >= VL_F32, "c2_lars: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

/* ── 4. Kernel ─────────────────────────────────────────────────────────── */

/* Layer 1: __simd_vf__ compute kernels ---------------------------------- */

/*
 * Zero two full 256B scalar slots. Lanes 1..7 of each slot must stay zero for the whole kernel:
 * the accumulator slot doubles as the 32B workspace write-out window and those lanes are summed
 * verbatim by stage 2.
 */
__simd_vf__ inline void LarsZeroSlotVf(__ubuf__ float *aAddr, __ubuf__ float *bAddr)
{
    static_assert(AscendC::VECTOR_REG_WIDTH == VEC_REG_BYTES,
                  "host-side VEC_REG_BYTES mirror is out of sync with AscendC::VECTOR_REG_WIDTH");
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, fullMask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(aAddr, zeroReg, fullMask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(bAddr, zeroReg, fullMask);
}

__aicore__ inline void LarsZeroSlot(__ubuf__ float *aAddr, __ubuf__ float *bAddr)
{
    asc_vf_call<LarsZeroSlotVf>(aAddr, bAddr);
}

/*
 * Stage-1 core: one tile of X and one tile of dX, both reduced to running sums of squares.
 * The two running accumulators are read back from their UB slots on entry and written out on exit,
 * so a tile costs one vf call and no extra scalar-accumulate pass. b16 inputs are unpacked into
 * b32 lanes and cast to fp32 before the multiply, so nothing ever accumulates in low precision.
 * Tail lanes are handled purely through the chunk mask; nothing depends on UB padding content.
 */
template <typename T, bool NeedCast>
__simd_vf__ inline void LarsSqSumPairVf(__ubuf__ float *sumXAddr, __ubuf__ float *sumDAddr,
                                        __ubuf__ T *xAddr, __ubuf__ T *dAddr, uint32_t count,
                                        uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTraitIn = {AscendC::Reg::RegLayout::ZERO,
                                                            AscendC::Reg::SatMode::UNKNOWN,
                                                            AscendC::Reg::MaskMergeMode::ZEROING,
                                                            AscendC::RoundMode::UNKNOWN};
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<T> rawXReg;
    AscendC::Reg::RegTensor<T> rawDReg;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> dReg;
    AscendC::Reg::RegTensor<float> sqXReg;
    AscendC::Reg::RegTensor<float> sqDReg;
    AscendC::Reg::RegTensor<float> redXReg;
    AscendC::Reg::RegTensor<float> redDReg;
    AscendC::Reg::RegTensor<float> accXReg;
    AscendC::Reg::RegTensor<float> accDReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(accXReg, sumXAddr);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(accDReg, sumDAddr);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        if constexpr (NeedCast) {
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(rawXReg, xAddr + offset);
            AscendC::Reg::Cast<float, T, castTraitIn>(xReg, rawXReg, mask);
            AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(rawDReg, dAddr + offset);
            AscendC::Reg::Cast<float, T, castTraitIn>(dReg, rawDReg, mask);
        } else {
            AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
                xReg, (__ubuf__ float *)(xAddr + offset));
            AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
                dReg, (__ubuf__ float *)(dAddr + offset));
        }
        AscendC::Reg::Mul(sqXReg, xReg, xReg, mask);
        AscendC::Reg::Mul(sqDReg, dReg, dReg, mask);
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM, float, float,
                             AscendC::Reg::MaskMergeMode::ZEROING>(redXReg, sqXReg, mask);
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM, float, float,
                             AscendC::Reg::MaskMergeMode::ZEROING>(redDReg, sqDReg, mask);
        AscendC::Reg::Add(accXReg, accXReg, redXReg, scalarMask);
        AscendC::Reg::Add(accDReg, accDReg, redDReg, scalarMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(sumXAddr, accXReg, scalarMask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(sumDAddr, accDReg, scalarMask);
}

template <typename T, bool NeedCast>
__aicore__ inline void LarsSqSumPair(__ubuf__ float *sumXAddr, __ubuf__ float *sumDAddr,
                                     __ubuf__ T *xAddr, __ubuf__ T *dAddr, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LarsSqSumPairVf<T, NeedCast>>(sumXAddr, sumDAddr, xAddr, dAddr, elementCount,
                                              chunkCount);
}

/*
 * Stage-2 workspace merge: chunked Reduce<SUM> plus a 1-lane running accumulator.
 * Each chunk carries its own tail mask. The zero padding inside the workspace covers only lanes
 * 1..7 of each core's slot; the lanes past wsLen inside the final UB chunk are uninitialised TBuf
 * content and would otherwise enter the sum whenever numBlocks is not a multiple of 8.
 */
__simd_vf__ inline void LarsReduceWsVf(__ubuf__ float *dstAddr, __ubuf__ float *wsAddr, uint32_t wsLen,
                                       uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> wsReg;
    AscendC::Reg::RegTensor<float> redReg;
    AscendC::Reg::RegTensor<float> accReg;
    AscendC::Reg::Duplicate<float>(accReg, 0.0f, scalarMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = wsLen - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(wsReg, wsAddr + offset);
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM, float, float,
                             AscendC::Reg::MaskMergeMode::ZEROING>(redReg, wsReg, mask);
        AscendC::Reg::Add(accReg, accReg, redReg, scalarMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr, accReg, scalarMask);
}

__aicore__ inline void LarsReduceWs(__ubuf__ float *dstAddr, __ubuf__ float *wsAddr, int64_t wsLen)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(wsLen);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LarsReduceWsVf>(dstAddr, wsAddr, elementCount, chunkCount);
}

/*
 * Stage-2 epilogue, entirely on lane 0.
 *   xNorm = sqrt(sumX) ; dNorm = sqrt(sumD)
 *   val   = trust / (dNorm / xNorm + wd + offset), replaced by 1.0 when xNorm <= 0
 *   out   = max(min(val, lr_max), lr_min)
 * min is written as Compare<GT> + Select to stay with the repo idiom and to share the compare /
 * select pair with the branch above it. Neither that pair nor Reg::Maxs propagates a NaN operand
 * (a NaN compares false and the other side wins), while torch.minimum / torch.clamp do, so the
 * final step restores val whenever val != val. Only val itself is covered: a NaN passed in as
 * lr_max or lr_min is outside the specified behaviour and is not handled here.
 */
__simd_vf__ inline void LarsEpilogueVf(__ubuf__ float *outAddr, __ubuf__ float *sumXAddr,
                                       __ubuf__ float *sumDAddr, __ubuf__ float *wdAddr,
                                       __ubuf__ float *trustAddr, __ubuf__ float *lrMaxAddr,
                                       float offset, float lrMin)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> xNormReg;
    AscendC::Reg::RegTensor<float> dNormReg;
    AscendC::Reg::RegTensor<float> denReg;
    AscendC::Reg::RegTensor<float> valReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::RegTensor<float> lrMaxReg;
    AscendC::Reg::RegTensor<float> outReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xNormReg, sumXAddr);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(dNormReg, sumDAddr);
    AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
        xNormReg, xNormReg, mask);
    AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
        dNormReg, dNormReg, mask);

    AscendC::Reg::Div(denReg, dNormReg, xNormReg, mask);            // dX_norm / X_norm
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(tmpReg, wdAddr);
    AscendC::Reg::Add(denReg, denReg, tmpReg, mask);                // + wd
    AscendC::Reg::Adds(denReg, denReg, offset, mask);               // + offset (host attribute)
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(tmpReg, trustAddr);
    AscendC::Reg::Div(valReg, tmpReg, denReg, mask);                // trust / den

    AscendC::Reg::MaskReg selMask;
    AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(selMask, xNormReg, 0.0f, mask);
    AscendC::Reg::Duplicate<float>(tmpReg, 1.0f, mask);
    AscendC::Reg::Select<float>(valReg, valReg, tmpReg, selMask);   // X_norm > 0 ? val : 1.0

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(lrMaxReg, lrMaxAddr);
    AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(selMask, valReg, lrMaxReg, mask);
    AscendC::Reg::Select<float>(outReg, lrMaxReg, valReg, selMask); // min(val, lr_max)
    AscendC::Reg::Maxs(outReg, outReg, lrMin, mask);                // max(., lr_min)

    AscendC::Reg::Compare<float, AscendC::CMPMODE::EQ>(selMask, valReg, valReg, mask);
    AscendC::Reg::Select<float>(outReg, outReg, valReg, selMask);   // val is NaN -> propagate it
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(outAddr, outReg, mask);
}

__aicore__ inline void LarsEpilogue(__ubuf__ float *outAddr, __ubuf__ float *sumXAddr,
                                    __ubuf__ float *sumDAddr, __ubuf__ float *wdAddr,
                                    __ubuf__ float *trustAddr, __ubuf__ float *lrMaxAddr, float offset,
                                    float lrMin)
{
    asc_vf_call<LarsEpilogueVf>(outAddr, sumXAddr, sumDAddr, wdAddr, trustAddr, lrMaxAddr, offset,
                                lrMin);
}

/* Layer 3: kernel classes ------------------------------------------------ */

/* Stage 1: per-core sum of squares of X and dX into this core's 32B workspace slot. */
template <typename T>
class KernelC2LarsPartial {
    static constexpr bool kNeedCast = NeedCastV<T>;
    static constexpr int64_t kElemSize = static_cast<int64_t>(sizeof(T));
    static constexpr int64_t kLaneAlign = BLOCK_BYTES / kElemSize;

public:
    __aicore__ inline KernelC2LarsPartial() {}

    __aicore__ inline void Init(GM_ADDR xPtr, GM_ADDR dPtr, GM_ADDR wsPtr, int64_t numel,
                                int64_t blockLength, int64_t tileElems, int64_t wsLen)
    {
        const int64_t blockIdx = AscendC::GetBlockIdx();
        const int64_t blockStart = blockLength * blockIdx;
        int64_t myLen = numel - blockStart;
        if (myLen > blockLength) {
            myLen = blockLength;
        }
        if (myLen < 0) {
            myLen = 0;
        }
        myLen_ = myLen;
        tileElems_ = tileElems;

        xGm_.SetGlobalBuffer((__gm__ T *)xPtr + blockStart);
        dGm_.SetGlobalBuffer((__gm__ T *)dPtr + blockStart);
        wsXGm_.SetGlobalBuffer((__gm__ float *)wsPtr + blockIdx * WS_SLOT_FLOATS);
        wsDGm_.SetGlobalBuffer((__gm__ float *)wsPtr + wsLen + blockIdx * WS_SLOT_FLOATS);

        pipe_.InitBuffer(inQueX_, PIPELINE_DEPTH, static_cast<uint32_t>(tileElems * kElemSize));
        pipe_.InitBuffer(inQueD_, PIPELINE_DEPTH, static_cast<uint32_t>(tileElems * kElemSize));
        pipe_.InitBuffer(sumXBuf_, static_cast<uint32_t>(VEC_REG_BYTES));
        pipe_.InitBuffer(sumDBuf_, static_cast<uint32_t>(VEC_REG_BYTES));
    }

    /*
     * Every core writes its own slot unconditionally, including a core whose myLen is 0 -- the
     * workspace comes from torch::empty, so an unwritten slot would feed uninitialised device
     * memory into the stage-2 sum. Do not add an early return here (design 2.2 section 5.3).
     */
    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> sumX = sumXBuf_.template Get<float>();
        AscendC::LocalTensor<float> sumD = sumDBuf_.template Get<float>();
        __ubuf__ float *sumXAddr = (__ubuf__ float *)sumX.GetPhyAddr();
        __ubuf__ float *sumDAddr = (__ubuf__ float *)sumD.GetPhyAddr();

        LarsZeroSlot(sumXAddr, sumDAddr);
        AscendC::PipeBarrier<PIPE_V>();                                          // S1 zero -> accumulate
        for (int64_t off = 0; off < myLen_; off += tileElems_) {
            const int64_t count = (myLen_ - off < tileElems_) ? (myLen_ - off) : tileElems_;
            RunTile(sumXAddr, sumDAddr, off, count);
            AscendC::PipeBarrier<PIPE_V>();                                      // S3 accumulator reuse
        }
        AscendC::PipeBarrier<PIPE_ALL>();                                        // S4 vf -> MTE3
        StoreSlot(wsXGm_, sumX);
        StoreSlot(wsDGm_, sumD);
    }

private:
    __aicore__ inline void RunTile(__ubuf__ float *sumXAddr, __ubuf__ float *sumDAddr, int64_t off,
                                   int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueX_.template AllocTensor<T>();
        AscendC::LocalTensor<T> dLocal = inQueD_.template AllocTensor<T>();
        CopyTile(xLocal, xGm_, off, count);
        CopyTile(dLocal, dGm_, off, count);
        inQueX_.EnQue(xLocal);
        inQueD_.EnQue(dLocal);
        xLocal = inQueX_.template DeQue<T>();                                    // S2 MTE2 -> vf
        dLocal = inQueD_.template DeQue<T>();                                    // S2 MTE2 -> vf
        LarsSqSumPair<T, kNeedCast>(sumXAddr, sumDAddr, (__ubuf__ T *)xLocal.GetPhyAddr(),
                                    (__ubuf__ T *)dLocal.GetPhyAddr(), count);
        inQueX_.FreeTensor(xLocal);
        inQueD_.FreeTensor(dLocal);
    }

    /* Right padding is defence in depth only; the vf closes the tail with its chunk mask. */
    __aicore__ inline void CopyTile(AscendC::LocalTensor<T> &dst, AscendC::GlobalTensor<T> &src,
                                    int64_t off, int64_t count)
    {
        const int64_t padded = ((count + kLaneAlign - 1) / kLaneAlign) * kLaneAlign;
        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(count * kElemSize);
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams;   // default: paddingValue == 0
        padParams.isPad = true;
        padParams.rightPadding = static_cast<uint8_t>(padded - count);
        AscendC::DataCopyPad(dst, src[off], params, padParams);
    }

    /* Writes the whole 32B slot: lane 0 carries the partial, lanes 1..7 are still zero. */
    __aicore__ inline void StoreSlot(AscendC::GlobalTensor<float> &dstGm,
                                     AscendC::LocalTensor<float> &src)
    {
        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(WS_SLOT_FLOATS * FLOAT_BYTES);
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPad(dstGm, src, params);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> dGm_;
    AscendC::GlobalTensor<float> wsXGm_;
    AscendC::GlobalTensor<float> wsDGm_;
    AscendC::TQue<AscendC::QuePosition::VECIN, PIPELINE_DEPTH> inQueX_;
    AscendC::TQue<AscendC::QuePosition::VECIN, PIPELINE_DEPTH> inQueD_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumXBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumDBuf_;
    int64_t myLen_ = 0;
    int64_t tileElems_ = 0;
};

/* Stage 2: merge the workspace partials and run the scalar epilogue on a single core. */
class KernelC2LarsFinalize {
public:
    __aicore__ inline KernelC2LarsFinalize() {}

    __aicore__ inline void Init(GM_ADDR wsPtr, GM_ADDR wdPtr, GM_ADDR trustPtr, GM_ADDR lrMaxPtr,
                                GM_ADDR outPtr, int64_t wsLen, float offset, float lrMin)
    {
        wsGm_.SetGlobalBuffer((__gm__ float *)wsPtr);
        wdGm_.SetGlobalBuffer((__gm__ float *)wdPtr);
        trustGm_.SetGlobalBuffer((__gm__ float *)trustPtr);
        lrMaxGm_.SetGlobalBuffer((__gm__ float *)lrMaxPtr);
        outGm_.SetGlobalBuffer((__gm__ float *)outPtr);
        wsLen_ = wsLen;
        offset_ = offset;
        lrMin_ = lrMin;

        // Rounded up to whole vector registers so Reg::LoadAlign's 256B granule stays in bounds.
        const int64_t wsAlloc = ((wsLen + VL_F32 - 1) / VL_F32) * VL_F32;
        pipe_.InitBuffer(wsXBuf_, static_cast<uint32_t>(wsAlloc * FLOAT_BYTES));
        pipe_.InitBuffer(wsDBuf_, static_cast<uint32_t>(wsAlloc * FLOAT_BYTES));
        // Scalar slots are a full vector register even though only lane 0 is live, because
        // Reg::LoadAlign always touches 256B; a 32B slot would over-read by 224B.
        pipe_.InitBuffer(wdBuf_, static_cast<uint32_t>(VEC_REG_BYTES));
        pipe_.InitBuffer(trustBuf_, static_cast<uint32_t>(VEC_REG_BYTES));
        pipe_.InitBuffer(lrMaxBuf_, static_cast<uint32_t>(VEC_REG_BYTES));
        pipe_.InitBuffer(sumXBuf_, static_cast<uint32_t>(VEC_REG_BYTES));
        pipe_.InitBuffer(sumDBuf_, static_cast<uint32_t>(VEC_REG_BYTES));
        pipe_.InitBuffer(outQue_, 1, static_cast<uint32_t>(VEC_REG_BYTES));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> wsX = wsXBuf_.template Get<float>();
        AscendC::LocalTensor<float> wsD = wsDBuf_.template Get<float>();
        AscendC::LocalTensor<float> wd = wdBuf_.template Get<float>();
        AscendC::LocalTensor<float> trust = trustBuf_.template Get<float>();
        AscendC::LocalTensor<float> lrMax = lrMaxBuf_.template Get<float>();
        CopyInRow(wsX, 0);
        CopyInRow(wsD, wsLen_);
        CopyInScalar(wd, wdGm_);
        CopyInScalar(trust, trustGm_);
        CopyInScalar(lrMax, lrMaxGm_);
        AscendC::PipeBarrier<PIPE_ALL>();                                        // S5 MTE2 -> vf (TBuf)

        AscendC::LocalTensor<float> sumX = sumXBuf_.template Get<float>();
        AscendC::LocalTensor<float> sumD = sumDBuf_.template Get<float>();
        LarsReduceWs((__ubuf__ float *)sumX.GetPhyAddr(), (__ubuf__ float *)wsX.GetPhyAddr(), wsLen_);
        LarsReduceWs((__ubuf__ float *)sumD.GetPhyAddr(), (__ubuf__ float *)wsD.GetPhyAddr(), wsLen_);
        AscendC::PipeBarrier<PIPE_V>();                                          // S6 reduce -> epilogue

        AscendC::LocalTensor<float> outLocal = outQue_.template AllocTensor<float>();
        LarsEpilogue((__ubuf__ float *)outLocal.GetPhyAddr(), (__ubuf__ float *)sumX.GetPhyAddr(),
                     (__ubuf__ float *)sumD.GetPhyAddr(), (__ubuf__ float *)wd.GetPhyAddr(),
                     (__ubuf__ float *)trust.GetPhyAddr(), (__ubuf__ float *)lrMax.GetPhyAddr(),
                     offset_, lrMin_);
        // The vf wrote through a raw __ubuf__ pointer rather than the LocalTensor, so the queue
        // hand-off below is backed up by an explicit fence instead of being relied on alone.
        AscendC::PipeBarrier<PIPE_ALL>();                                        // S7 epilogue -> MTE3
        StoreOut(outLocal);
    }

private:
    __aicore__ inline void CopyInRow(AscendC::LocalTensor<float> &dst, int64_t rowOffset)
    {
        AscendC::DataCopyExtParams params;
        AscendC::DataCopyPadExtParams<float> padParams;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(wsLen_ * FLOAT_BYTES);
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPad(dst, wsGm_[rowOffset], params, padParams);
    }

    /* One 4B fp32 element of a device scalar tensor into lane 0 of a 256B slot. */
    __aicore__ inline void CopyInScalar(AscendC::LocalTensor<float> &dst,
                                        AscendC::GlobalTensor<float> &srcGm)
    {
        AscendC::DataCopyExtParams params;
        AscendC::DataCopyPadExtParams<float> padParams;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(FLOAT_BYTES);
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPad(dst, srcGm, params, padParams);
    }

    __aicore__ inline void StoreOut(AscendC::LocalTensor<float> &outLocal)
    {
        outQue_.EnQue(outLocal);
        AscendC::LocalTensor<float> deq = outQue_.template DeQue<float>();
        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(FLOAT_BYTES);
        params.srcStride = 0;
        params.dstStride = 0;
        AscendC::DataCopyPad(outGm_, deq, params);
        outQue_.FreeTensor(deq);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> wsGm_;
    AscendC::GlobalTensor<float> wdGm_;
    AscendC::GlobalTensor<float> trustGm_;
    AscendC::GlobalTensor<float> lrMaxGm_;
    AscendC::GlobalTensor<float> outGm_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> wsXBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> wsDBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> wdBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> trustBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> lrMaxBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumXBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumDBuf_;
    int64_t wsLen_ = 0;
    float offset_ = 0.0f;
    float lrMin_ = 0.0f;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_lars_partial_kernel(GM_ADDR xPtr, GM_ADDR dPtr, GM_ADDR wsPtr,
                                                             int64_t numel, int64_t blockLength,
                                                             int64_t tileElems, int64_t wsLen)
{
    KernelC2LarsPartial<T> op;
    op.Init(xPtr, dPtr, wsPtr, numel, blockLength, tileElems, wsLen);
    op.Process();
}

__global__ __aicore__ __vector__ void c2_lars_finalize_kernel(GM_ADDR wsPtr, GM_ADDR wdPtr,
                                                              GM_ADDR trustPtr, GM_ADDR lrMaxPtr,
                                                              GM_ADDR outPtr, int64_t wsLen, float offset,
                                                              float lrMin)
{
    KernelC2LarsFinalize op;
    op.Init(wsPtr, wdPtr, trustPtr, lrMaxPtr, outPtr, wsLen, offset, lrMin);
    op.Process();
}

/* ── 5. NPU dispatch ───────────────────────────────────────────────────── */

/* Groups the stage-1 tiling parameters so the dtype dispatch below stays a one-liner per case. */
struct C2LarsLaunchArgs {
    GM_ADDR xPtr = nullptr;
    GM_ADDR dPtr = nullptr;
    GM_ADDR wsPtr = nullptr;
    int64_t numel = 0;
    int64_t numBlocks = 1;
    int64_t blockLength = 1;
    int64_t tileElems = VL_F32;
    int64_t wsLen = WS_SLOT_FLOATS;
};

template <typename T>
static void launch_partial(const C2LarsLaunchArgs &a, aclrtStream stream)
{
    c2_lars_partial_kernel<T><<<a.numBlocks, nullptr, stream>>>(a.xPtr, a.dPtr, a.wsPtr, a.numel,
                                                                a.blockLength, a.tileElems, a.wsLen);
}

torch::Tensor c2_lars_npu(const torch::Tensor &X, const torch::Tensor &dX, const torch::Tensor &wd,
                          const torch::Tensor &trust, const torch::Tensor &lr_max, double offset,
                          double lr_min)
{
    // C1..C6: all validation first, synchronously, before any device operation or launch.
    c2_lars_check(X, dX, wd, trust, lr_max, offset, lr_min, /*checkDevice=*/true);
    const c10::OptionalDeviceGuard guard(X.device());

    auto Xc = X.contiguous();
    auto dXc = dX.contiguous();
    // C7: constructed 0-D and fp32 regardless of the input dtype. The scalar tensors are only
    // ever used as GM pointers, so their 0-D / (1,) shape never reaches the output.
    auto out = torch::empty({}, Xc.options().dtype(torch::kFloat32));

    C2LarsLaunchArgs args;
    args.numel = Xc.numel();
    std::tie(args.numBlocks, args.blockLength, args.tileElems) =
        calc_tiling_params(args.numel, Xc.element_size());
    args.wsLen = args.numBlocks * WS_SLOT_FLOATS;

    // Row 0 holds the sum(X^2) partials, row 1 the sum(dX^2) partials, one 32B slot per core.
    // torch::empty is safe only because every core writes its own slot unconditionally.
    auto ws = torch::empty({2, args.wsLen}, Xc.options().dtype(torch::kFloat32));

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    args.xPtr = (GM_ADDR)Xc.data_ptr();
    args.dPtr = (GM_ADDR)dXc.data_ptr();
    args.wsPtr = (GM_ADDR)ws.data_ptr();
    auto wdPtr = (GM_ADDR)wd.data_ptr();
    auto trustPtr = (GM_ADDR)trust.data_ptr();
    auto lrMaxPtr = (GM_ADDR)lr_max.data_ptr();
    auto outPtr = (GM_ADDR)out.data_ptr();
    auto wsPtr = args.wsPtr;
    const int64_t wsLen = args.wsLen;
    const float offsetF = static_cast<float>(offset);
    const float lrMinF = static_cast<float>(lr_min);

    auto partial_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            Xc.scalar_type(), "c2_lars_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] { launch_partial<float>(args, stream); })
            AT_DISPATCH_CASE(torch::kFloat16, [&] { launch_partial<half>(args, stream); })
            AT_DISPATCH_CASE(torch::kBFloat16, [&] { launch_partial<bfloat16_t>(args, stream); }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2LarsPartial", partial_call);

    // Submitted after the partial pass on the same stream: stage 2 reads the workspace those
    // kernels just wrote. The two passes are named separately so msprof can attribute them.
    auto finalize_call = [=]() -> int {
        c2_lars_finalize_kernel<<<1, nullptr, stream>>>(wsPtr, wdPtr, trustPtr, lrMaxPtr, outPtr, wsLen,
                                                        offsetF, lrMinF);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2LarsFinalize", finalize_call);

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_lars", c2_lars_npu);
}

} // namespace C2Lars
} // namespace ops_multimodal_fusion
