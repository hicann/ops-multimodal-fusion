/*!
 * \file dequant_swiglu_quant.asc
 * \brief Fused Dequant + SwiGLU + Dynamic Quant operator for Ascend NPU
 *
 * Fuses three operations:
 *   1. Dequant: x_float = x * weight_scale (* act_scale)
 *   2. SwiGLU:  y = silu(right_half) * left_half
 *   3. Quant:   y_int8, scale = dynamic_quantize(y)
 *
 * Supported input types:
 *   - int32 (with weight_scale and act_scale)
 *   - float16 / bfloat16 (direct cast, no scale needed)
 * Output: int8 quantized + per-row float32 scale
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"

#include "dequant_swiglu_quant_apt.h"
#include "dequant_swiglu_quant_host_tiling.h"

namespace ops_multimodal_fusion {
namespace DequantSwigluQuant {

// 1. Schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("dequant_swiglu_quant(Tensor x, Tensor? weight_scale, Tensor? act_scale) -> (Tensor, Tensor)");
}

// 2. Meta function
std::tuple<torch::Tensor, torch::Tensor> dequant_swiglu_quant_meta(
    const torch::Tensor &x,
    const c10::optional<torch::Tensor> &weight_scale,
    const c10::optional<torch::Tensor> &act_scale)
{
    TORCH_CHECK(x.dim() >= 2, "dequant_swiglu_quant: input must have at least 2 dimensions");
    TORCH_CHECK(x.size(-1) % 2 == 0, "dequant_swiglu_quant: last dimension must be even");

    auto sizes = x.sizes().vec();
    sizes.back() /= 2;
    auto y = torch::empty(sizes, x.options().dtype(torch::kInt8));
    int64_t rowNum = x.numel() / x.size(-1);
    auto scale = torch::empty({rowNum}, x.options().dtype(torch::kFloat32));
    return std::make_tuple(y, scale);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("dequant_swiglu_quant", dequant_swiglu_quant_meta);
}

// 3. NPU dispatch
std::tuple<torch::Tensor, torch::Tensor> dequant_swiglu_quant_npu(
    const torch::Tensor &x,
    const c10::optional<torch::Tensor> &weight_scale,
    const c10::optional<torch::Tensor> &act_scale)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto x_contig = x.contiguous();

    int64_t inDimy = x_contig.size(-1);
    int64_t outDimy = inDimy / 2;
    int64_t inDimx = x_contig.numel() / inDimy;

    // Output tensors
    auto y = torch::empty({inDimx, outDimy}, x_contig.options().dtype(torch::kInt8));
    auto scale = torch::empty({inDimx}, x_contig.options().dtype(torch::kFloat32));

    // Build tiling input
    auto tilingIn = DsqHostTiling::BuildDefaultInput();
    tilingIn.inDimx = inDimx;
    tilingIn.inDimy = inDimy;
    tilingIn.outDimy = outDimy;
    tilingIn.quantMode = 1; // dynamic
    tilingIn.activateDim = 1;
    tilingIn.xDimNum = 2;
    tilingIn.dstType = 2; // int8
    tilingIn.roundMode = 0;
    tilingIn.swigluMode = 0;
    tilingIn.actRight = 1;
    tilingIn.speGroupType = 0;
    tilingIn.biasMode = 0;
    tilingIn.groupIndexMode = 0;
    tilingIn.quantIsOne = 0;
    tilingIn.groupNum = 1;
    tilingIn.hasQuantScale = false;
    tilingIn.hasQuantOffset = false;
    tilingIn.hasGroupIndex = false;
    tilingIn.biasDtype = DsqHostTiling::BiasDtype::NONE;

    bool hasWScale = weight_scale.has_value();
    bool hasAScale = act_scale.has_value();
    tilingIn.hasWeightScale = hasWScale;
    tilingIn.hasActScale = hasAScale;

    // Set input dtype
    switch (x_contig.scalar_type()) {
        case torch::kInt32:    tilingIn.xDtype = DsqHostTiling::XDtype::INT32; break;
        case torch::kFloat16:  tilingIn.xDtype = DsqHostTiling::XDtype::FP16;  break;
        case torch::kBFloat16: tilingIn.xDtype = DsqHostTiling::XDtype::BF16;  break;
        default: TORCH_CHECK(false, "dequant_swiglu_quant: unsupported input dtype");
    }
    tilingIn.yDtype = DsqHostTiling::YDtype::INT8;

    auto lc = DsqHostTiling::CalcTiling(tilingIn);

    // Workspace
    auto workspace = torch::empty({static_cast<int64_t>(lc.workspaceSize)},
                                  x_contig.options().dtype(torch::kUInt8));

    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    auto x_ptr  = (GM_ADDR)x_contig.data_ptr();
    auto ws_ptr = (GM_ADDR)weight_scale.has_value() ? (GM_ADDR)weight_scale->data_ptr() : nullptr;
    auto as_ptr = act_scale.has_value() ? (GM_ADDR)act_scale->data_ptr() : nullptr;
    auto y_ptr  = (GM_ADDR)y.data_ptr();
    auto sc_ptr = (GM_ADDR)scale.data_ptr();
    auto wk_ptr = (GM_ADDR)workspace.data_ptr();

    // Null pointers for unused optional parameters
    GM_ADDR bias_ptr   = nullptr;
    GM_ADDR qs_ptr     = nullptr;
    GM_ADDR qo_ptr     = nullptr;
    GM_ADDR gi_ptr     = nullptr;

    auto acl_call = [=]() -> int {
        switch (x_contig.scalar_type()) {
            case torch::kInt32:
                if (hasAScale) {
                    dsq_base_nb_act1_qs0_gi0_int32_int8<<<lc.blockDim, nullptr, stream>>>(
                        x_ptr, ws_ptr, as_ptr, bias_ptr, qs_ptr, qo_ptr,
                        gi_ptr, y_ptr, sc_ptr, wk_ptr, lc.tiling);
                } else {
                    dsq_base_nb_act0_qs0_gi0_int32_int8<<<lc.blockDim, nullptr, stream>>>(
                        x_ptr, ws_ptr, as_ptr, bias_ptr, qs_ptr, qo_ptr,
                        gi_ptr, y_ptr, sc_ptr, wk_ptr, lc.tiling);
                }
                break;
            case torch::kFloat16:
                if (hasAScale) {
                    dsq_base_nb_act1_qs0_gi0_fp16_int8<<<lc.blockDim, nullptr, stream>>>(
                        x_ptr, ws_ptr, as_ptr, bias_ptr, qs_ptr, qo_ptr,
                        gi_ptr, y_ptr, sc_ptr, wk_ptr, lc.tiling);
                } else {
                    dsq_base_nb_act0_qs0_gi0_fp16_int8<<<lc.blockDim, nullptr, stream>>>(
                        x_ptr, ws_ptr, as_ptr, bias_ptr, qs_ptr, qo_ptr,
                        gi_ptr, y_ptr, sc_ptr, wk_ptr, lc.tiling);
                }
                break;
            case torch::kBFloat16:
                if (hasAScale) {
                    dsq_base_nb_act1_qs0_gi0_bf16_int8<<<lc.blockDim, nullptr, stream>>>(
                        x_ptr, ws_ptr, as_ptr, bias_ptr, qs_ptr, qo_ptr,
                        gi_ptr, y_ptr, sc_ptr, wk_ptr, lc.tiling);
                } else {
                    dsq_base_nb_act0_qs0_gi0_bf16_int8<<<lc.blockDim, nullptr, stream>>>(
                        x_ptr, ws_ptr, as_ptr, bias_ptr, qs_ptr, qo_ptr,
                        gi_ptr, y_ptr, sc_ptr, wk_ptr, lc.tiling);
                }
                break;
            default:
                break;
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("DequantSwigluQuant", acl_call);

    return std::make_tuple(y, scale);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("dequant_swiglu_quant", dequant_swiglu_quant_npu);
}

} // namespace DequantSwigluQuant
} // namespace ops_multimodal_fusion
