/*!
 * \file digamma.asc
 * \brief Digamma (psi) operator for Ascend NPU (dav-3510)
 *
 * torch.special.digamma(x) -> y  with  y = d/dx [ ln Gamma(x) ]
 *
 * Scope: float32, x > 0.
 *
 * Algorithm (uniform shift-and-asymptotic, branchless):
 *   Let N = 8.
 *     psi(x) = psi(x + N) - sum_{k=0}^{N-1} 1/(x + k)          (exact recurrence)
 *   For x + N >= 8 the asymptotic expansion is accurate well below float32 eps:
 *     psi(x') ~ ln(x') - 1/(2 x') - 1/(12 x'^2) + 1/(120 x'^4)
 *                                  - 1/(252 x'^6) + 1/(240 x'^8)
 *   Letting u = 1/x'^2, we group the even-power tail and evaluate via Horner on -P(u):
 *     -P(u) = -1/12 + u/120 - u^2/252 + u^3/240
 *           = (((1/240) * u - 1/252) * u + 1/120) * u - 1/12   [Horner]
 *   Then the final result is
 *     psi(x) = ln(x') - 1/(2 x') + u * (-P(u)) - sum_{k=0}^{N-1} 1/(x + k).
 *
 * For x -> 0+ the 1/x term in the reciprocal sum drives psi -> -inf as expected.
 * For x <= 0 the formula is not the true analytic continuation of digamma
 * (no reflection is applied on dav-3510 since no sin/cos vector primitive exists).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Digamma {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("digamma(Tensor x) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor digamma_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32,
                "digamma: only float32 is supported on dav-3510, got ", x.scalar_type());
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("digamma", digamma_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 2 queues (VECIN x + VECOUT y) each double-buffered, plus 4 scratch TBufs.
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 2 + 4; // = 8
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // align to 32 bytes
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// ===================== 4. Kernel =====================

template <typename T>
class KernelDigamma {
public:
    __aicore__ inline KernelDigamma() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tbufXp_,    tileSize);  // x+k, then x+8, then Horner acc
        pipe_.InitBuffer(tbufInv_,   tileSize);  // 1/(x+k) and scratch
        pipe_.InitBuffer(tbufSum_,   tileSize);  // running reciprocal sum
        pipe_.InitBuffer(tbufOnes_,  tileSize);  // 1.0 constant, later holds u=1/xp^2

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileSize / sizeof(T);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        // Asymptotic-series coefficients (Bernoulli tail of digamma for x -> +inf):
        //   psi(x) ~ ln(x) - 1/(2x) - 1/(12 x^2) + 1/(120 x^4)
        //                                     - 1/(252 x^6) + 1/(240 x^8) - ...
        // We group the polynomial part in u = 1/x^2 and evaluate -P(u) by Horner:
        //   -P(u) = (((1/240) * u - 1/252) * u + 1/120) * u - 1/12
        const T C_INV_12  = (T)(1.0f / 12.0f);
        const T C_INV_120 = (T)(1.0f / 120.0f);
        const T C_INV_252 = (T)(1.0f / 252.0f);
        const T C_INV_240 = (T)(1.0f / 240.0f);

        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY_.AllocTensor<T>();
        auto bufXp   = tbufXp_.Get<T>();
        auto bufInv  = tbufInv_.Get<T>();
        auto bufSum  = tbufSum_.Get<T>();
        auto bufOnes = tbufOnes_.Get<T>();

        // ---- Init running accumulators ----
        AscendC::Duplicate(bufSum,  (T)0.0f, count);
        AscendC::Duplicate(bufOnes, (T)1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Recurrence back-substitution: sum_{k=0}^{N-1} 1/(x+k), N = 8 ----
        for (int k = 0; k < 8; ++k) {
            AscendC::Adds(bufXp, xLocal, (T)((float)k), count);         // x + k
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(bufInv, bufOnes, bufXp, count);                // 1/(x+k)
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(bufSum, bufSum, bufInv, count);                // sum += 1/(x+k)
            AscendC::PipeBarrier<PIPE_V>();
        }

        // ---- Asymptotic expansion at x' = x + 8 ----
        AscendC::Adds(bufXp, xLocal, (T)8.0f, count);                    // bufXp = x + 8
        AscendC::PipeBarrier<PIPE_V>();
        inQueueX_.FreeTensor(xLocal);

        // yLocal = ln(x')
        AscendC::Ln(yLocal, bufXp, count);
        AscendC::PipeBarrier<PIPE_V>();

        // bufInv = 1 / x'
        AscendC::Div(bufInv, bufOnes, bufXp, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal -= 0.5 / x'  (reuse bufXp as scratch for 0.5 * bufInv)
        AscendC::Muls(bufXp, bufInv, (T)0.5f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(yLocal, yLocal, bufXp, count);
        AscendC::PipeBarrier<PIPE_V>();

        // u = 1 / x'^2  -> store in bufOnes (1.0-constant no longer needed)
        AscendC::Mul(bufOnes, bufInv, bufInv, count);
        AscendC::PipeBarrier<PIPE_V>();

        // Horner for  acc = -P(u)  starting from highest coefficient:
        //   acc = 1/240
        //   acc = u * acc - 1/252
        //   acc = u * acc + 1/120
        //   acc = u * acc - 1/12
        AscendC::Duplicate(bufXp, C_INV_240, count);                     // acc <- 1/240
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Mul(bufInv, bufOnes, bufXp, count);                     // u * acc
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(bufXp, bufInv, (T)(-C_INV_252), count);            // acc = u*acc - 1/252
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Mul(bufInv, bufOnes, bufXp, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(bufXp, bufInv, C_INV_120, count);                  // acc = u*acc + 1/120
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Mul(bufInv, bufOnes, bufXp, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(bufXp, bufInv, (T)(-C_INV_12), count);             // acc = u*acc - 1/12
        AscendC::PipeBarrier<PIPE_V>();

        // correction = u * acc  (= -P(u) * u = tail of -psi series)
        AscendC::Mul(bufInv, bufOnes, bufXp, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal += correction   (yLocal now holds ln(x') - 1/(2 x') - P(u)*u)
        AscendC::Add(yLocal, yLocal, bufInv, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal -= bufSum   (subtract the 8 reciprocals from the recurrence)
        AscendC::Sub(yLocal, yLocal, bufSum, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInv_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOnes_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void digamma_kernel(
    GM_ADDR x, GM_ADDR y,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelDigamma<T> op;
    op.Init(x, y, totalLength, blockLength, tileSize);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor digamma_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto input = x.contiguous();
    auto y = torch::empty_like(input);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto x_ptr = (GM_ADDR)input.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input.scalar_type(), "digamma_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                digamma_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileSize);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Digamma", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("digamma", digamma_npu);
}

} // namespace Digamma
} // namespace ops_multimodal_fusion
