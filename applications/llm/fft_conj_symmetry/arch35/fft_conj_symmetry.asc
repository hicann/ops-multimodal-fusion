/*!
 * \file fft_conj_symmetry.asc
 * \brief RegBase FFTConjSymmetry operator for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.fft_conj_symmetry(input, dim, out_size) -> output
 *   input    : complex tensor: complex64 (c10::complex<float>) or
 *              complex32 (c10::complex<half>).
 *              Shape [..., H, ...] where H = out_size // 2 + 1 along `dim`.
 *   dim      : int, the dimension along which conjugate symmetry applies.
 *   out_size : int, the full output size along dimension `dim` (must be >= 2).
 *   output   : complex tensor, same dtype as input,
 *              shape [..., out_size, ...] along dimension `dim`.
 *
 * Semantics (onesided -> twosided via Hermitian symmetry):
 *   half_size = out_size // 2 + 1
 *   For each index k along dim:
 *     if k < half_size:  output[..., k, ...] = input[..., k, ...]
 *     else:              output[..., k, ...] = conj(input[..., N - k, ...])
 *                        where N = out_size.
 *
 * Complex data is stored interleaved: [R0, I0, R1, I1, ...].
 * Conjugation negates imaginary components: conj(R + iI) = R - iI.
 * A sign pattern [+1, -1, +1, -1, ...] is pre-built in UB and applied
 * via Reg vector multiply when conjugation is needed.
 *
 * Core math is strict RegBase: data tiles are loaded to UB, cast to fp32
 * when the input dtype is half, conjugated via sign-pattern multiply, cast
 * back, and stored.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace FftConjSymmetry {

static constexpr int64_t kSafetyBytes = 4096;
static constexpr int64_t kMaxTileElems = 2048;

/* ── Schema registration ───────────────────────────────────────────────── */

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("fft_conj_symmetry(Tensor input, int dim, int out_size) -> Tensor");
}

/* ── Shape descriptor ──────────────────────────────────────────────────── */

struct ConjSymShape {
    int64_t halfSize = 0;
    int64_t outSize = 0;
    int64_t innerSize = 0;       // product of dims > conjugate dim
    int64_t outerSize = 0;       // product of dims < conjugate dim
    int64_t inputPerOuter = 0;   // halfSize * innerSize (complex count)
    int64_t outputPerOuter = 0;  // outSize * innerSize (complex count)
};

static ConjSymShape compute_shape(const torch::Tensor &input,
                                   int64_t dim,
                                   int64_t outSize)
{
    int64_t ndim = input.dim();
    int64_t inDimSize = input.size(dim);
    int64_t halfSizeExpected = outSize / 2 + 1;
    TORCH_CHECK(inDimSize == halfSizeExpected,
                "fft_conj_symmetry: input size along dim ", dim,
                " must be out_size // 2 + 1 = ", halfSizeExpected,
                ", got ", inDimSize);

    ConjSymShape s;
    s.halfSize = halfSizeExpected;
    s.outSize = outSize;
    s.innerSize = 1;
    for (int64_t d = dim + 1; d < ndim; ++d) {
        s.innerSize *= input.size(d);
    }
    s.outerSize = 1;
    for (int64_t d = 0; d < dim; ++d) {
        s.outerSize *= input.size(d);
    }
    s.inputPerOuter = s.halfSize * s.innerSize;
    s.outputPerOuter = s.outSize * s.innerSize;
    return s;
}

/* ── Common checks ─────────────────────────────────────────────────────── */

static void check_common(const torch::Tensor &input, int64_t dim, int64_t outSize)
{
    TORCH_CHECK(input.is_complex(),
                "fft_conj_symmetry: input must be a complex tensor, got ",
                input.scalar_type());
    TORCH_CHECK(input.scalar_type() == torch::kComplexFloat ||
                input.scalar_type() == torch::kComplexHalf,
                "fft_conj_symmetry: only complex64 and complex32 are "
                "supported on dav-3510, got ", input.scalar_type());
    TORCH_CHECK(dim >= 0 && dim < input.dim(),
                "fft_conj_symmetry: dim ", dim,
                " out of range for ", input.dim(), "-D tensor");
    TORCH_CHECK(outSize >= 2,
                "fft_conj_symmetry: out_size must be at least 2, got ", outSize);
    int64_t halfSizeExpected = outSize / 2 + 1;
    TORCH_CHECK(input.size(dim) == halfSizeExpected,
                "fft_conj_symmetry: input size along dim ", dim,
                " must be out_size // 2 + 1 = ", halfSizeExpected,
                ", got ", input.size(dim));
}

/* ── Meta registration ─────────────────────────────────────────────────── */

torch::Tensor fft_conj_symmetry_meta(const torch::Tensor &input,
                                      int64_t dim,
                                      int64_t outSize)
{
    check_common(input, dim, outSize);
    std::vector<int64_t> outShape(input.sizes().begin(), input.sizes().end());
    outShape[dim] = outSize;
    return torch::empty(outShape, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("fft_conj_symmetry", fft_conj_symmetry_meta);
}

/* ── Tiling ────────────────────────────────────────────────────────────── */

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t outerSize, int64_t innerSize,
                   int64_t elemSize, int64_t outDimSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "fft_conj_symmetry: coreNum must be positive");

    // UB live buffers per tile (sized in T elements):
    //   input tile        : tileElems * elemSize
    //   output tile       : tileElems * elemSize
    //   float workspace A : tileElems * sizeof(float)
    //   float workspace B : tileElems * sizeof(float)
    //   sign pattern      : tileElems * sizeof(float)
    int64_t liveBytesPerElem =
        2 * elemSize +                                 // in, out
        3 * static_cast<int64_t>(sizeof(float));       // fp32 workspace A + B + sign

    int64_t tileElems = (static_cast<int64_t>(ubSize) - kSafetyBytes - 256) /
                        liveBytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min<int64_t>(tileElems, kMaxTileElems);
    TORCH_CHECK(tileElems > 0,
                "fft_conj_symmetry: UB is too small for one aligned tile");

    int64_t slicesPerOuter = (innerSize + tileElems / 2 - 1) / (tileElems / 2);
    if (slicesPerOuter < 1) slicesPerOuter = 1;
    int64_t totalTiles = outerSize * outDimSize * slicesPerOuter;
    int64_t numBlocks = std::min<int64_t>(coreNum, totalTiles);
    numBlocks = std::max<int64_t>(numBlocks, 1);
    int64_t jobsPerBlock = (totalTiles + numBlocks - 1) / numBlocks;

    return std::make_tuple(numBlocks, jobsPerBlock, tileElems);
}

/* ── Reg-based cast helpers ────────────────────────────────────────────── */

template <typename T>
__simd_vf__ inline void CastToFloatRegVf(__ubuf__ float *dstAddr,
                                          __ubuf__ T *srcAddr,
                                          uint32_t count,
                                          uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastToFloatReg(AscendC::LocalTensor<float> &dst,
                                       AscendC::LocalTensor<T> &src,
                                       int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T, AscendC::RoundMode ROUND>
__simd_vf__ inline void CastFromFloatRegVf(__ubuf__ T *dstAddr,
                                            __ubuf__ float *srcAddr,
                                            uint32_t count,
                                            uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        ROUND};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<T, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T, AscendC::RoundMode ROUND>
__aicore__ inline void CastFromFloatReg(AscendC::LocalTensor<T> &dst,
                                         AscendC::LocalTensor<float> &src,
                                         int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFromFloatRegVf<T, ROUND>>(
        dstAddr, srcAddr, elementCount, chunkCount);
}

/* ── Conjugate via Reg multiply with a [+1, -1, ...] pattern ─────────── */

/* Conjugate interleaved complex data using Reg multiply:
 * [R0,I0,R1,I1,...] * [+1,-1,+1,-1,...] -> [R0,-I0,R1,-I1,...].
 */
__simd_vf__ inline void ConjugateFloatRegVf(__ubuf__ float *dstAddr,
                                             __ubuf__ float *srcAddr,
                                             __ubuf__ float *signAddr,
                                             uint32_t count,
                                             uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> signReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            signReg, signAddr + offset);
        AscendC::Reg::Mul(dstReg, srcReg, signReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void ConjugateFloatReg(AscendC::LocalTensor<float> &dst,
                                          AscendC::LocalTensor<float> &src,
                                          AscendC::LocalTensor<float> &sign,
                                          int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    __ubuf__ float *signAddr = (__ubuf__ float *)sign.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ConjugateFloatRegVf>(
        dstAddr, srcAddr, signAddr, elementCount, chunkCount);
}

/* ── Kernel ────────────────────────────────────────────────────────────── */

template <typename T>
class KernelFftConjSymmetry {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;
    static constexpr AscendC::RoundMode kCastOutRound =
        std::is_same<T, half>::value
            ? AscendC::RoundMode::CAST_RINT
            : AscendC::RoundMode::CAST_NONE;

public:
    __aicore__ inline KernelFftConjSymmetry() {}

    __aicore__ inline void Init(GM_ADDR input,
                                 GM_ADDR output,
                                 ConjSymShape shape,
                                 int64_t tileElems,
                                 int64_t jobsPerBlock)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        shape_ = shape;
        tileElems_ = tileElems;
        int elemSz = static_cast<int>(sizeof(T));
        alignElems_ = 32 / elemSz;

        // tileElems is the UB capacity in T elements.
        // Half that for number of complex elements (tile per inner slice).
        complexPerTile_ = tileElems_ / 2;  // one complex = 2 T's

        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t slicesPerOuterDim =
            (shape_.innerSize + complexPerTile_ - 1) / complexPerTile_;
        int64_t totalTiles =
            shape_.outerSize * shape_.outSize * slicesPerOuterDim;
        int64_t jobStart = blockIdx * jobsPerBlock;
        jobCount_ = totalTiles - jobStart;
        if (jobCount_ > jobsPerBlock) {
            jobCount_ = jobsPerBlock;
        }
        if (jobCount_ < 0) {
            jobCount_ = 0;
        }
        jobStart_ = jobStart;

        pipe_.InitBuffer(tbufInput_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufOutput_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufFloatA_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufFloatB_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufSignPattern_, tileElems_ * sizeof(float));

        AscendC::LocalTensor<float> signLocal =
            tbufSignPattern_.template Get<float>();
        for (int64_t i = 0; i < tileElems_; ++i) {
            signLocal.SetValue(static_cast<int32_t>(i),
                               (i & 1) ? -1.0f : 1.0f);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void Process()
    {
        for (int64_t localJob = 0; localJob < jobCount_; ++localJob) {
            int64_t job = jobStart_ + localJob;
            ProcessJob(job);
        }
    }

private:
    /* Decode linear job -> (outer, dimPos, innerComplexStart, complexCount) */
    __aicore__ inline void DecodeJob(int64_t job,
                                      int64_t &outer,
                                      int64_t &dimPos,
                                      int64_t &innerStart,
                                      int64_t &complexCount) const
    {
        int64_t perOuter = shape_.outSize *
            ((shape_.innerSize + complexPerTile_ - 1) / complexPerTile_);
        outer = job / perOuter;
        int64_t rem = job % perOuter;
        int64_t perDim = (shape_.innerSize + complexPerTile_ - 1) / complexPerTile_;
        dimPos = rem / perDim;
        int64_t slice = rem % perDim;

        innerStart = slice * complexPerTile_;
        complexCount = shape_.innerSize - innerStart;
        if (complexCount > complexPerTile_) {
            complexCount = complexPerTile_;
        }
    }

    __aicore__ inline void ProcessJob(int64_t job)
    {
        int64_t outer, dimPos, innerStart, complexCount;
        DecodeJob(job, outer, dimPos, innerStart, complexCount);
        if (complexCount <= 0) return;

        // Map dimPos -> source dim position
        bool needConj = false;
        int64_t srcDimPos = dimPos;
        if (dimPos < shape_.halfSize) {
            needConj = false;
            srcDimPos = dimPos;
        } else {
            needConj = true;
            srcDimPos = shape_.outSize - dimPos;
            if (srcDimPos >= shape_.halfSize) srcDimPos = shape_.halfSize - 1;
            if (srcDimPos < 0) srcDimPos = 0;
        }

        // Element counts in T units
        int64_t elemCount = complexCount * 2;       // T elements for this tile
        int64_t alignT = alignElems_;
        int64_t alignedT =
            ((elemCount + alignT - 1) / alignT) * alignT;
        int64_t padT = alignedT - elemCount;

        // Global offsets (in T elements)
        int64_t inputOff =
            outer * shape_.inputPerOuter * 2 +
            srcDimPos * shape_.innerSize * 2 +
            innerStart * 2;
        int64_t outputOff =
            outer * shape_.outputPerOuter * 2 +
            dimPos * shape_.innerSize * 2 +
            innerStart * 2;

        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = static_cast<uint32_t>(elemCount * sizeof(T));
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;

        // Load input
        AscendC::LocalTensor<T> inLocal = tbufInput_.template Get<T>();
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(padT), static_cast<T>(0)};
        AscendC::DataCopyPad(inLocal, inputGm_[inputOff],
                             copyParams, padParams);
        AscendC::PipeBarrier<PIPE_ALL>();

        if (needConj) {
            AscendC::LocalTensor<float> floatA =
                tbufFloatA_.template Get<float>();
            AscendC::LocalTensor<float> signLocal =
                tbufSignPattern_.template Get<float>();

            if constexpr (kIsFloat) {
                // float path: inLocal IS LocalTensor<float>.
                ConjugateFloatReg(floatA, inLocal, signLocal, elemCount);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopyExtParams outParams;
                outParams.blockCount = 1;
                outParams.blockLen = static_cast<uint32_t>(elemCount * sizeof(float));
                outParams.srcStride = 0;
                outParams.dstStride = 0;
                AscendC::DataCopyPad(outputGm_[outputOff], floatA, outParams);
                AscendC::PipeBarrier<PIPE_ALL>();
            } else {
                // half path: cast -> conjugate -> cast back
                CastToFloatReg<T>(floatA, inLocal, elemCount);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::LocalTensor<float> floatB =
                    tbufFloatB_.template Get<float>();
                ConjugateFloatReg(floatB, floatA, signLocal, elemCount);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::LocalTensor<T> outLocal =
                    tbufOutput_.template Get<T>();
                CastFromFloatReg<T, kCastOutRound>(outLocal, floatB, elemCount);
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::DataCopyPad(outputGm_[outputOff], outLocal, copyParams);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
        } else {
            // No conjugation: direct store
            AscendC::DataCopyPad(outputGm_[outputOff], inLocal, copyParams);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufFloatA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufFloatB_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSignPattern_;
    ConjSymShape shape_;
    int64_t tileElems_ = 0;
    int64_t complexPerTile_ = 0;
    int64_t alignElems_ = 1;
    int64_t jobStart_ = 0;
    int64_t jobCount_ = 0;
};

/* ── Launch & dispatch ────────────────────────────────────────────────── */

template <typename T>
__global__ __aicore__ __vector__ void fft_conj_symmetry_kernel(
    GM_ADDR input, GM_ADDR output, ConjSymShape shape,
    int64_t tileElems, int64_t jobsPerBlock)
{
    KernelFftConjSymmetry<T> op;
    op.Init(input, output, shape, tileElems, jobsPerBlock);
    op.Process();
}

static void launch_kernel(const torch::Tensor &input,
                           const torch::Tensor &output,
                           const ConjSymShape &shape,
                           int64_t numBlocks,
                           int64_t jobsPerBlock,
                           int64_t tileElems)
{
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)input.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    AT_DISPATCH_SWITCH(
        input.scalar_type(), "fft_conj_symmetry_npu",
        AT_DISPATCH_CASE(torch::kComplexFloat, [&] {
            fft_conj_symmetry_kernel<float>
                <<<numBlocks, nullptr, stream>>>(
                inputPtr, outputPtr, shape, tileElems, jobsPerBlock);
        })
        AT_DISPATCH_CASE(torch::kComplexHalf, [&] {
            fft_conj_symmetry_kernel<half>
                <<<numBlocks, nullptr, stream>>>(
                inputPtr, outputPtr, shape, tileElems, jobsPerBlock);
        })
    );
}

torch::Tensor fft_conj_symmetry_npu(const torch::Tensor &input,
                                     int64_t dim,
                                     int64_t outSize)
{
    check_common(input, dim, outSize);
    const c10::OptionalDeviceGuard guard(input.device());

    auto inputC = input.contiguous();
    auto shape = compute_shape(inputC, dim, outSize);

    std::vector<int64_t> outShapeVec(inputC.sizes().begin(), inputC.sizes().end());
    outShapeVec[dim] = outSize;
    auto output = torch::empty(outShapeVec, inputC.options());

    if (output.numel() == 0) {
        return output;
    }

    int64_t numBlocks = 1;
    int64_t jobsPerBlock = 1;
    int64_t tileElems = 1;
    std::tie(numBlocks, jobsPerBlock, tileElems) =
        calc_tiling_params(shape.outerSize, shape.innerSize,
                           inputC.element_size(), shape.outSize);

    // Capture by value (not [&]): RunOpApi defers this lambda onto the task-queue
    // worker thread, which runs AFTER this function returns and its stack frame (the
    // local tensors inputC/output and tiling ints) unwinds. A [&] capture would leave
    // the queued lambda reading freed tensor storage -> async use-after-free / device
    // core dump. [=] copies the refcounted tensor handles so their storage stays alive
    // until the deferred launch consumes them. `mutable` lets the copies bind to the
    // kernel's non-const parameters.
    auto acl_call = [=]() mutable -> int {
        launch_kernel(inputC, output, shape, numBlocks, jobsPerBlock, tileElems);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("FftConjSymmetry", acl_call);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("fft_conj_symmetry", fft_conj_symmetry_npu);
}

} // namespace FftConjSymmetry
} // namespace ops_multimodal_fusion
