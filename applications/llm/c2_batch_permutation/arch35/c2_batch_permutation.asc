/*!
 * \file c2_batch_permutation.asc
 * \brief Caffe2 BatchPermutation forward operator for Ascend NPU (dav-3510),
 *        RegBase implementation.
 *
 * Schema:  c2_batch_permutation(Tensor X, Tensor indices) -> Tensor
 *   X        N-D tensor (ndim >= 1); dim 0 = batch axis (size N), the rest
 *            flatten to row size K = numel(X) / N
 *   indices  1-D int64 tensor (size N), values in [0, N)
 *   returns  Y of same shape and dtype as X with Y[n, *] = X[indices[n], *]
 *
 * Scope (this version):
 *   - forward only (gradient op BatchPermutationGradient deferred)
 *   - dim 0 only (Caffe2 BatchPermutation has no `dim` parameter)
 *   - dtype scope: {fp32, fp16, int32}; bf16 / int64 / fp64 / complex rejected
 *   - indices.dtype must be int64; values read with low-32 truncation, host
 *     ensures values in [0, N) <= INT32_MAX
 *   - whole row K must fit in UB (first-version constraint; large-K chunked
 *     tiling deferred)
 *
 * Reg shape -- 3 layers:
 *   Layer 1 __simd_vf__   BatchPermutationRowCopyVf<T>  chunked LoadAlign +
 *                                                      StoreAlign across one
 *                                                      output row's K elements
 *   Layer 2 __aicore__    BatchPermutationRowCopy<T>   LocalTensor -> __ubuf__
 *                                                      cast, asc_vf_call
 *   Layer 3 kernel class  KernelC2BatchPermutation<T>  per-core indices slice
 *                                                      preload, per output-row
 *                                                      scalar idx GetValue,
 *                                                      DMA in xGm[idx*K],
 *                                                      vf copy, DMA out
 *                                                      yGm[n*K].
 *
 * UB layout per core (fixed plus pipelined queues):
 *   tbufIdx              : blockLength * sizeof(int64_t)  (indices slice)
 *   inQueueX, outQueueY  : K * sizeof(T) * PIPELINE_DEPTH each (one row in
 *                          flight per pipe stage)
 * Host TORCH_CHECK rejects K configs that exceed UB.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace C2BatchPermutation {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_batch_permutation(Tensor X, Tensor indices) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor c2_batch_permutation_meta(
    const torch::Tensor &X,
    const torch::Tensor &indices)
{
    TORCH_CHECK(X.dim() >= 1,
                "c2_batch_permutation: X must have at least 1 dim (got ndim=",
                X.dim(), ")");
    TORCH_CHECK(indices.dim() == 1,
                "c2_batch_permutation: indices must be 1-D, got ndim=",
                indices.dim());
    TORCH_CHECK(indices.size(0) == X.size(0),
                "c2_batch_permutation: indices.size(0)=", indices.size(0),
                " must equal X.size(0)=", X.size(0));
    TORCH_CHECK(indices.scalar_type() == torch::kInt64,
                "c2_batch_permutation: indices dtype must be int64, got ",
                indices.scalar_type());
    return torch::empty(X.sizes(), X.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_batch_permutation", c2_batch_permutation_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t>
calc_tiling_params(int64_t N, int64_t K, size_t bytesPerT)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t SAFETY_MARGIN = 1024;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_batch_permutation: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, N);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t blockLength = (N + numBlocks - 1) / numBlocks;

    // Per-core UB inventory:
    //   tbufIdx              : blockLength * sizeof(int64_t)
    //   inQueueX + outQueueY : 2 * K * bytesPerT * PIPELINE_DEPTH
    int64_t idxBytes   = blockLength * static_cast<int64_t>(sizeof(int64_t));
    int64_t queueBytes = 2 * PIPELINE_DEPTH * K * static_cast<int64_t>(bytesPerT);
    TORCH_CHECK(idxBytes + queueBytes + SAFETY_MARGIN <= static_cast<int64_t>(ubSize),
                "c2_batch_permutation: N=", N, " K=", K,
                " too large for dav-3510 UB. idxBytes=", idxBytes,
                " queueBytes=", queueBytes, " ubSize=", ubSize,
                ". Whole row K must fit in UB (first-version constraint).");

    return std::make_tuple(numBlocks, blockLength);
}

// ===================== 4. Kernel -- 3-layer Reg shape =====================

// Layer 1: __simd_vf__ chunked row copy.
//   Per chunk: LoadAlign(src) -> StoreAlign(dst).
//   chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T) (fp32/int32 64 / fp16 128).
template <typename T>
__simd_vf__ inline void BatchPermutationRowCopyVf(
    __ubuf__ T *srcPtr, __ubuf__ T *dstPtr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> rowReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * chunkLanes;
        uint32_t remaining = (elementCount > offset) ? (elementCount - offset) : 0;
        if (remaining == 0) break;
        uint32_t lanesThisChunk = (remaining > chunkLanes) ? chunkLanes : remaining;
        AscendC::Reg::MaskReg laneMask = AscendC::Reg::UpdateMask<T>(lanesThisChunk);

        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            rowReg, srcPtr + offset);
        if constexpr (sizeof(T) == 4) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstPtr + offset, rowReg, laneMask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
                dstPtr + offset, rowReg, laneMask);
        }
    }
}

// Layer 2: __aicore__ wrapper. LocalTensor -> __ubuf__ cast and asc_vf_call.
template <typename T>
__aicore__ inline void BatchPermutationRowCopy(
    AscendC::LocalTensor<T> &srcUbufLT,
    AscendC::LocalTensor<T> &dstUbufLT,
    int64_t K)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    __ubuf__ T *srcPtr = (__ubuf__ T *)srcUbufLT.GetPhyAddr();
    __ubuf__ T *dstPtr = (__ubuf__ T *)dstUbufLT.GetPhyAddr();
    uint32_t elementCount = static_cast<uint32_t>(K);
    uint32_t chunkCount   = (elementCount + chunkLanes - 1) / chunkLanes;
    asc_vf_call<BatchPermutationRowCopyVf<T>>(
        srcPtr, dstPtr, elementCount, chunkCount);
}

// Layer 3: kernel class. indices slice preload + per-row DMA loop.
template <typename T>
class KernelC2BatchPermutation {
public:
    __aicore__ inline KernelC2BatchPermutation() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR indices, GM_ADDR y,
        int64_t N, int64_t K, int64_t blockLength)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        indicesGm_.SetGlobalBuffer((__gm__ int64_t *)indices);
        yGm_.SetGlobalBuffer((__gm__ T *)y);

        N_ = N;
        K_ = K;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myBlockLength = N - blockStart;
        if (myBlockLength > blockLength) myBlockLength = blockLength;
        if (myBlockLength < 0) myBlockLength = 0;
        blockStart_ = blockStart;
        myBlockLength_ = myBlockLength;

        const uint32_t rowBytes = static_cast<uint32_t>(K * sizeof(T));
        const uint32_t idxBufBytes =
            static_cast<uint32_t>(blockLength * sizeof(int64_t));
        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, rowBytes);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, rowBytes);
        pipe_.InitBuffer(tbufIdx_,   idxBufBytes);
    }

    __aicore__ inline void Process()
    {
        if (myBlockLength_ <= 0) return;

        // Preload per-core indices slice: blockStart_ .. blockStart_+myBlockLength_.
        AscendC::LocalTensor<int64_t> idxLocal = tbufIdx_.template Get<int64_t>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<int64_t> padParams{false, 0, 0,
                                                             static_cast<int64_t>(0)};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(myBlockLength_ * sizeof(int64_t));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(idxLocal, indicesGm_[blockStart_], params, padParams);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t r = 0; r < myBlockLength_; ++r) {
            int64_t outRow = blockStart_ + r;
            // Read source-row index from preloaded slice (int64 -> int32 low lane;
            // host guarantees indices[outRow] in [0, N) <= INT32_MAX).
            int32_t srcRow =
                static_cast<int32_t>(idxLocal.GetValue(static_cast<int32_t>(r)));
            ProcessRow(outRow, srcRow);
        }
    }

private:
    __aicore__ inline void ProcessRow(int64_t outRow, int32_t srcRow)
    {
        // DMA in source row X[srcRow, *].
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, T{}};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(K_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(
                xLocal,
                xGm_[static_cast<int64_t>(srcRow) * K_],
                params, padParams);
        }
        inQueueX_.EnQue(xLocal);
        xLocal = inQueueX_.template DeQue<T>();

        // Vectorized row copy: yLocal[0..K) = xLocal[0..K).
        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        BatchPermutationRowCopy<T>(xLocal, yLocal, K_);
        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.template DeQue<T>();

        // DMA out Y[outRow, *].
        {
            AscendC::DataCopyExtParams params;
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(K_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(yGm_[outRow * K_], yLocal, params);
        }
        inQueueX_.FreeTensor(xLocal);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       xGm_;
    AscendC::GlobalTensor<int64_t> indicesGm_;
    AscendC::GlobalTensor<T>       yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIdx_;
    int64_t N_ = 0;
    int64_t K_ = 0;
    int64_t blockStart_ = 0;
    int64_t myBlockLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_batch_permutation_kernel(
    GM_ADDR x, GM_ADDR indices, GM_ADDR y,
    int64_t N, int64_t K, int64_t blockLength)
{
    KernelC2BatchPermutation<T> op;
    op.Init(x, indices, y, N, K, blockLength);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor c2_batch_permutation_npu(
    const torch::Tensor &X,
    const torch::Tensor &indices)
{
    auto dtype = X.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "c2_batch_permutation: X dtype must be float32 / float16 / int32, got ",
                dtype, ". bf16 / int64 / fp64 / complex are deferred on this platform.");
    TORCH_CHECK(indices.scalar_type() == torch::kInt64,
                "c2_batch_permutation: indices dtype must be int64, got ",
                indices.scalar_type());

    TORCH_CHECK(X.dim() >= 1,
                "c2_batch_permutation: X must have at least 1 dim (got ndim=",
                X.dim(), ")");
    TORCH_CHECK(indices.dim() == 1,
                "c2_batch_permutation: indices must be 1-D, got ndim=", indices.dim());
    TORCH_CHECK(indices.size(0) == X.size(0),
                "c2_batch_permutation: indices.size(0)=", indices.size(0),
                " must equal X.size(0)=", X.size(0));

    const c10::OptionalDeviceGuard guard(X.device());
    auto X_contig = X.contiguous();
    auto indices_contig = indices.contiguous();

    const int64_t N = X_contig.size(0);
    const int64_t numel = X_contig.numel();
    auto Y = torch::empty(X_contig.sizes(), X_contig.options());

    // Empty X (numel == 0): empty result, no kernel launch. Covers N == 0 and
    // X with any zero-sized non-batch dim (e.g. shape (2, 0, 5)).
    if (numel == 0) {
        return Y;
    }
    TORCH_CHECK(N > 0,
                "c2_batch_permutation: N must be > 0 when numel > 0");
    const int64_t K = numel / N;
    TORCH_CHECK(N <= static_cast<int64_t>(0x7fffffff),
                "c2_batch_permutation: N=", N, " exceeds INT32_MAX");

    // Host indices bounds check: avoids per-row device-side assert.
    {
        auto idx_cpu = indices_contig.cpu();
        const int64_t idx_min = idx_cpu.min().item<int64_t>();
        const int64_t idx_max = idx_cpu.max().item<int64_t>();
        TORCH_CHECK(idx_min >= 0,
                    "c2_batch_permutation: indices minimum (", idx_min,
                    ") must be >= 0");
        TORCH_CHECK(idx_max < N,
                    "c2_batch_permutation: indices maximum (", idx_max,
                    ") must be < N=", N);
    }

    const size_t bytesPerT =
        (dtype == torch::kFloat16) ? 2u : 4u;  // fp32 / int32 both 4 bytes
    int64_t numBlocks, blockLength;
    std::tie(numBlocks, blockLength) = calc_tiling_params(N, K, bytesPerT);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr       = (GM_ADDR)X_contig.data_ptr();
    auto indices_ptr = (GM_ADDR)indices_contig.data_ptr();
    auto y_ptr       = (GM_ADDR)Y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            X_contig.scalar_type(), "c2_batch_permutation_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_batch_permutation_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, indices_ptr, y_ptr, N, K, blockLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_batch_permutation_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, indices_ptr, y_ptr, N, K, blockLength);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                c2_batch_permutation_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, indices_ptr, y_ptr, N, K, blockLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2BatchPermutation", acl_call);

    return Y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_batch_permutation", c2_batch_permutation_npu);
}

} // namespace C2BatchPermutation
} // namespace ops_multimodal_fusion
