/*!
 * \file bessel_y0.asc
 * \brief RegBase-form bessel_y0 (Bessel function of the second kind, order 0)
 *        for Ascend NPU (dav-3510).
 *
 * torch.special.bessel_y0(x) -> Tensor, elementwise, float32.
 *
 * Algorithm = PyTorch's shared bessel_y0_forward (ATen/native/cuda/Math.cuh),
 * Cephes rational approximation; defined for x > 0:
 *   0 < x <= 5:  YP(x^2)/YQ(x^2) + (2/pi) * ln(x) * J0(x)
 *                YP: 8 coeffs, YQ: 7 coeffs
 *   x >  5:      (PP(w)/PQ(w)*sin(xi) + 5/x*QP(w)/QQ(w)*cos(xi))
 *                   * 0.79788456 / sqrt(x),  w=(5/x)^2,  xi = x - pi/4
 *                PP/PQ: 7 coeffs, QP: 8, QQ: 7 -- identical to J0's
 *                asymptotic coeffs; only the sin/cos combination differs.
 *   x == 0 -> -inf ;  x < 0 -> NaN ;  +/-inf / NaN -> per torch reference.
 *
 * Structure mirrors the merged csrc/bessel_y1 one-to-one (Y1 = J1 helper +
 * small `yp/yq + log*j1` + asymptotic; Y0 = J0 helper + small
 * `yp/yq + (2/pi)*log*j0` + asymptotic). The J0 helper vf is byte-identical
 * to the merged csrc/bessel_j0 BesselJ0RegVf (exact for 0<x<=5, A5
 * validated). The trig range-reduction, boundary Selects, and the
 * compute-J0-into-a-scratch-then-Y0 harness are taken from bessel_y1
 * (validated on real A5 hardware). +/-inf flows through the asymptotic to
 * NaN, matching torch.special.bessel_y0 (no override). 3-layer Reg shape;
 * deterministic -> tests allclose vs an fp64-promoted torch golden.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <tuple>

namespace ops_multimodal_fusion {
namespace BesselY0 {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;
constexpr int64_t TOTAL_TILE_BUFFERS = 6;          // inQueue x2 + outQueue x2 + j0 scratch (+slack)
constexpr float PI = 3.14159265358979323846f;
constexpr float INV_PI = 0.31830988618379067154f;
constexpr float ROUND_MAGIC = 12582912.0f;          // 2^23+2^22, fp32 round-to-int
constexpr float BY0_PHASE = 0.785398163397448309615660845819875721f;  // pi/4
constexpr float BY0_SCALE = 0.797884560802865355879892119868763737f;  // sqrt(2/pi)
constexpr float BY0_LOG_SCALE = 0.636619772367581343075535053490057448f;  // 2/pi
constexpr float J0_DR1 = 5.78318596294678452118f;
constexpr float J0_DR2 = 30.4712623436620863991f;
constexpr float J0_TINY = 1.0e-5f;

#define BY0_HORNER(REG, ARG, COEFF)                  \
    AscendC::Reg::Mul(REG, REG, ARG, mask);          \
    AscendC::Reg::Adds(REG, REG, COEFF, mask);

#define BY0_TRIG_SIN_STEP(COEFF)                                  \
    AscendC::Reg::Mul(sinPolyReg, sinPolyReg, trigArg2Reg, mask); \
    AscendC::Reg::Adds(sinPolyReg, sinPolyReg, COEFF, mask);

#define BY0_TRIG_COS_STEP(COEFF)                                  \
    AscendC::Reg::Mul(cosPolyReg, cosPolyReg, trigArg2Reg, mask); \
    AscendC::Reg::Adds(cosPolyReg, cosPolyReg, COEFF, mask);

// ===================== Kernel — 3-layer Reg shape =====================

// J0 helper: byte-identical to the merged csrc/bessel_j0 BesselJ0RegVf
// (exact for the 0<x<=5 region the Y0 small-branch log term needs).
__simd_vf__ inline void BesselJ0RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg, absXReg, x2Reg, outReg, tmpReg;
    AscendC::Reg::RegTensor<float> rpReg, rqReg, ppReg, pqReg, qpReg, qqReg;
    AscendC::Reg::RegTensor<float> ratioPReg, ratioQReg, sinReg, cosReg, phaseReg;
    AscendC::Reg::RegTensor<float> invXReg, invX2Reg, sqrtReg, smallReg, largeReg, termReg;
    AscendC::Reg::RegTensor<float> reduceKReg, trigArg2Reg, quadrantSignReg, sinPolyReg, cosPolyReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg smallMask;
        AscendC::Reg::MaskReg tinyMask;
        AscendC::Reg::MaskReg nanMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::Abs(absXReg, xReg, mask);
        AscendC::Reg::Mul(x2Reg, absXReg, absXReg, mask);

        AscendC::Reg::Duplicate<float>(rpReg, -4.79443220978201773821e+09f, mask);
        BY0_HORNER(rpReg, x2Reg, +1.95617491946556577543e+12f)
        BY0_HORNER(rpReg, x2Reg, -2.49248344360967716204e+14f)
        BY0_HORNER(rpReg, x2Reg, +9.70862251047306323952e+15f)

        AscendC::Reg::Duplicate<float>(rqReg, +4.99563147152651017219e+02f, mask);
        BY0_HORNER(rqReg, x2Reg, +1.73785401676374683123e+05f)
        BY0_HORNER(rqReg, x2Reg, +4.84409658339962045305e+07f)
        BY0_HORNER(rqReg, x2Reg, +1.11855537045356834862e+10f)
        BY0_HORNER(rqReg, x2Reg, +2.11277520115489217587e+12f)
        BY0_HORNER(rqReg, x2Reg, +3.10518229857422583814e+14f)
        BY0_HORNER(rqReg, x2Reg, +3.18121955943204943306e+16f)
        BY0_HORNER(rqReg, x2Reg, +1.71086294081043136091e+18f)

        AscendC::Reg::Div(ratioPReg, rpReg, rqReg, mask);
        AscendC::Reg::Adds(tmpReg, x2Reg, -J0_DR1, mask);
        AscendC::Reg::Mul(smallReg, ratioPReg, tmpReg, mask);
        AscendC::Reg::Adds(tmpReg, x2Reg, -J0_DR2, mask);
        AscendC::Reg::Mul(smallReg, smallReg, tmpReg, mask);
        AscendC::Reg::Muls(tmpReg, x2Reg, -0.25f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, 1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(tinyMask, absXReg, J0_TINY, mask);
        AscendC::Reg::Select<float>(smallReg, tmpReg, smallReg, tinyMask);

        AscendC::Reg::Duplicate<float>(tmpReg, 5.0f, mask);
        AscendC::Reg::Div(invXReg, tmpReg, absXReg, mask);
        AscendC::Reg::Mul(invX2Reg, invXReg, invXReg, mask);

        AscendC::Reg::Duplicate<float>(ppReg, +7.96936729297347051624e-04f, mask);
        BY0_HORNER(ppReg, invX2Reg, +8.28352392107440799803e-02f)
        BY0_HORNER(ppReg, invX2Reg, +1.23953371646414299388e+00f)
        BY0_HORNER(ppReg, invX2Reg, +5.44725003058768775090e+00f)
        BY0_HORNER(ppReg, invX2Reg, +8.74716500199817011941e+00f)
        BY0_HORNER(ppReg, invX2Reg, +5.30324038235394892183e+00f)
        BY0_HORNER(ppReg, invX2Reg, +9.99999999999999997821e-01f)

        AscendC::Reg::Duplicate<float>(pqReg, +9.24408810558863637013e-04f, mask);
        BY0_HORNER(pqReg, invX2Reg, +8.56288474354474431428e-02f)
        BY0_HORNER(pqReg, invX2Reg, +1.25352743901058953537e+00f)
        BY0_HORNER(pqReg, invX2Reg, +5.47097740330417105182e+00f)
        BY0_HORNER(pqReg, invX2Reg, +8.76190883237069594232e+00f)
        BY0_HORNER(pqReg, invX2Reg, +5.30605288235394617618e+00f)
        BY0_HORNER(pqReg, invX2Reg, +1.00000000000000000218e+00f)

        AscendC::Reg::Duplicate<float>(qpReg, -1.13663838898469149931e-02f, mask);
        BY0_HORNER(qpReg, invX2Reg, -1.28252718670509318512e+00f)
        BY0_HORNER(qpReg, invX2Reg, -1.95539544257735972385e+01f)
        BY0_HORNER(qpReg, invX2Reg, -9.32060152123768231369e+01f)
        BY0_HORNER(qpReg, invX2Reg, -1.77681167980488050595e+02f)
        BY0_HORNER(qpReg, invX2Reg, -1.47077505154951170175e+02f)
        BY0_HORNER(qpReg, invX2Reg, -5.14105326766599330220e+01f)
        BY0_HORNER(qpReg, invX2Reg, -6.05014350600728481186e+00f)

        AscendC::Reg::Duplicate<float>(qqReg, +6.43178256118178023184e+01f, mask);
        BY0_HORNER(qqReg, invX2Reg, +8.56430025976980587198e+02f)
        BY0_HORNER(qqReg, invX2Reg, +3.88240183605401609683e+03f)
        BY0_HORNER(qqReg, invX2Reg, +7.24046774195652478189e+03f)
        BY0_HORNER(qqReg, invX2Reg, +5.93072701187316984827e+03f)
        BY0_HORNER(qqReg, invX2Reg, +2.06209331660327847417e+03f)
        BY0_HORNER(qqReg, invX2Reg, +2.42005740240291393179e+02f)

        AscendC::Reg::Div(ratioPReg, ppReg, pqReg, mask);
        AscendC::Reg::Div(ratioQReg, qpReg, qqReg, mask);
        AscendC::Reg::Adds(phaseReg, absXReg, -BY0_PHASE, mask);
        AscendC::Reg::Muls(reduceKReg, phaseReg, INV_PI, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, PI, mask);
        AscendC::Reg::Sub(phaseReg, phaseReg, tmpReg, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, 0.5f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 2.0f, mask);
        AscendC::Reg::Sub(quadrantSignReg, reduceKReg, tmpReg, mask);
        AscendC::Reg::Abs(quadrantSignReg, quadrantSignReg, mask);
        AscendC::Reg::Muls(quadrantSignReg, quadrantSignReg, -2.0f, mask);
        AscendC::Reg::Adds(quadrantSignReg, quadrantSignReg, 1.0f, mask);
        AscendC::Reg::Mul(trigArg2Reg, phaseReg, phaseReg, mask);

        AscendC::Reg::Duplicate<float>(sinPolyReg, -1.0f / 39916800.0f, mask);
        BY0_TRIG_SIN_STEP(1.0f / 362880.0f)
        BY0_TRIG_SIN_STEP(-1.0f / 5040.0f)
        BY0_TRIG_SIN_STEP(1.0f / 120.0f)
        BY0_TRIG_SIN_STEP(-1.0f / 6.0f)
        BY0_TRIG_SIN_STEP(1.0f)
        AscendC::Reg::Mul(sinReg, sinPolyReg, phaseReg, mask);
        AscendC::Reg::Mul(sinReg, sinReg, quadrantSignReg, mask);

        AscendC::Reg::Duplicate<float>(cosPolyReg, -1.0f / 3628800.0f, mask);
        BY0_TRIG_COS_STEP(1.0f / 40320.0f)
        BY0_TRIG_COS_STEP(-1.0f / 720.0f)
        BY0_TRIG_COS_STEP(1.0f / 24.0f)
        BY0_TRIG_COS_STEP(-1.0f / 2.0f)
        BY0_TRIG_COS_STEP(1.0f)
        AscendC::Reg::Mul(cosReg, cosPolyReg, quadrantSignReg, mask);

        AscendC::Reg::Mul(largeReg, ratioPReg, cosReg, mask);
        AscendC::Reg::Mul(termReg, invXReg, ratioQReg, mask);
        AscendC::Reg::Mul(termReg, termReg, sinReg, mask);
        AscendC::Reg::Sub(largeReg, largeReg, termReg, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, BY0_SCALE, mask);
        AscendC::Reg::Mul(largeReg, largeReg, tmpReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, absXReg, mask);
        AscendC::Reg::Div(largeReg, largeReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(smallMask, absXReg, 5.0f, mask);
        AscendC::Reg::Select<float>(outReg, smallReg, largeReg, smallMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void BesselJ0Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BesselJ0RegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

// Y0: small = YP/YQ + (2/pi)*ln(x)*J0(x) ; large = asymptotic (sin/cos
// combination, J0's PP/PQ/QP/QQ coeffs, xi = x - pi/4). Boundary block
// mirrors the merged bessel_y1 BesselY1RegVf: x<0 -> NaN, x==0 -> -inf,
// x==+inf -> NaN, NaN -> NaN.
__simd_vf__ inline void BesselY0RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, __ubuf__ float *j0Addr,
    uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    const float infValue = INFINITY;
    const float negInfValue = -INFINITY;
    const float nanValue = NAN;

    AscendC::Reg::RegTensor<float> xReg, j0Reg, x2Reg, outReg, tmpReg;
    AscendC::Reg::RegTensor<float> ypReg, yqReg, ppReg, pqReg, qpReg, qqReg;
    AscendC::Reg::RegTensor<float> ratioPReg, ratioQReg, sinReg, cosReg, phaseReg;
    AscendC::Reg::RegTensor<float> invXReg, invX2Reg, sqrtReg, smallReg, largeReg, termReg, logReg;
    AscendC::Reg::RegTensor<float> negInfReg, nanReg, reduceKReg, trigArg2Reg, quadrantSignReg, sinPolyReg, cosPolyReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg smallMask;
        AscendC::Reg::MaskReg zeroMask;
        AscendC::Reg::MaskReg leZeroMask;
        AscendC::Reg::MaskReg posInfMask;
        AscendC::Reg::MaskReg nanMask;
        uint32_t offset = chunk * vectorLength;

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(j0Reg, j0Addr + offset);
        AscendC::Reg::Mul(x2Reg, xReg, xReg, mask);
        AscendC::Reg::Duplicate<float>(negInfReg, negInfValue, mask);
        AscendC::Reg::Duplicate<float>(nanReg, nanValue, mask);

        // small: yp/yq + (2/pi)*ln(x)*j0
        AscendC::Reg::Duplicate<float>(ypReg, +1.55924367855235737965e+04f, mask);
        BY0_HORNER(ypReg, x2Reg, -1.46639295903971606143e+07f)
        BY0_HORNER(ypReg, x2Reg, +5.43526477051876500413e+09f)
        BY0_HORNER(ypReg, x2Reg, -9.82136065717911466409e+11f)
        BY0_HORNER(ypReg, x2Reg, +8.75906394395366999549e+13f)
        BY0_HORNER(ypReg, x2Reg, -3.46628303384729719441e+15f)
        BY0_HORNER(ypReg, x2Reg, +4.42733268572569800351e+16f)
        BY0_HORNER(ypReg, x2Reg, -1.84950800436986690637e+16f)

        AscendC::Reg::Duplicate<float>(yqReg, +1.04128353664259848412e+03f, mask);
        BY0_HORNER(yqReg, x2Reg, +6.26107330137134956842e+05f)
        BY0_HORNER(yqReg, x2Reg, +2.68919633393814121987e+08f)
        BY0_HORNER(yqReg, x2Reg, +8.64002487103935000337e+10f)
        BY0_HORNER(yqReg, x2Reg, +2.02979612750105546709e+13f)
        BY0_HORNER(yqReg, x2Reg, +3.17157752842975028269e+15f)
        BY0_HORNER(yqReg, x2Reg, +2.50596256172653059228e+17f)

        AscendC::Reg::Div(ratioPReg, ypReg, yqReg, mask);
        AscendC::Reg::Ln(logReg, xReg, mask);
        AscendC::Reg::Mul(tmpReg, logReg, j0Reg, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, BY0_LOG_SCALE, mask);
        AscendC::Reg::Add(smallReg, ratioPReg, tmpReg, mask);

        // large: w=(5/x)^2 ; (pp/pq*sin + 5/x*qp/qq*cos)*SCALE/sqrt(x)
        AscendC::Reg::Duplicate<float>(tmpReg, 5.0f, mask);
        AscendC::Reg::Div(invXReg, tmpReg, xReg, mask);
        AscendC::Reg::Mul(invX2Reg, invXReg, invXReg, mask);

        AscendC::Reg::Duplicate<float>(ppReg, +7.96936729297347051624e-04f, mask);
        BY0_HORNER(ppReg, invX2Reg, +8.28352392107440799803e-02f)
        BY0_HORNER(ppReg, invX2Reg, +1.23953371646414299388e+00f)
        BY0_HORNER(ppReg, invX2Reg, +5.44725003058768775090e+00f)
        BY0_HORNER(ppReg, invX2Reg, +8.74716500199817011941e+00f)
        BY0_HORNER(ppReg, invX2Reg, +5.30324038235394892183e+00f)
        BY0_HORNER(ppReg, invX2Reg, +9.99999999999999997821e-01f)

        AscendC::Reg::Duplicate<float>(pqReg, +9.24408810558863637013e-04f, mask);
        BY0_HORNER(pqReg, invX2Reg, +8.56288474354474431428e-02f)
        BY0_HORNER(pqReg, invX2Reg, +1.25352743901058953537e+00f)
        BY0_HORNER(pqReg, invX2Reg, +5.47097740330417105182e+00f)
        BY0_HORNER(pqReg, invX2Reg, +8.76190883237069594232e+00f)
        BY0_HORNER(pqReg, invX2Reg, +5.30605288235394617618e+00f)
        BY0_HORNER(pqReg, invX2Reg, +1.00000000000000000218e+00f)

        AscendC::Reg::Duplicate<float>(qpReg, -1.13663838898469149931e-02f, mask);
        BY0_HORNER(qpReg, invX2Reg, -1.28252718670509318512e+00f)
        BY0_HORNER(qpReg, invX2Reg, -1.95539544257735972385e+01f)
        BY0_HORNER(qpReg, invX2Reg, -9.32060152123768231369e+01f)
        BY0_HORNER(qpReg, invX2Reg, -1.77681167980488050595e+02f)
        BY0_HORNER(qpReg, invX2Reg, -1.47077505154951170175e+02f)
        BY0_HORNER(qpReg, invX2Reg, -5.14105326766599330220e+01f)
        BY0_HORNER(qpReg, invX2Reg, -6.05014350600728481186e+00f)

        AscendC::Reg::Duplicate<float>(qqReg, +6.43178256118178023184e+01f, mask);
        BY0_HORNER(qqReg, invX2Reg, +8.56430025976980587198e+02f)
        BY0_HORNER(qqReg, invX2Reg, +3.88240183605401609683e+03f)
        BY0_HORNER(qqReg, invX2Reg, +7.24046774195652478189e+03f)
        BY0_HORNER(qqReg, invX2Reg, +5.93072701187316984827e+03f)
        BY0_HORNER(qqReg, invX2Reg, +2.06209331660327847417e+03f)
        BY0_HORNER(qqReg, invX2Reg, +2.42005740240291393179e+02f)

        AscendC::Reg::Div(ratioPReg, ppReg, pqReg, mask);
        AscendC::Reg::Div(ratioQReg, qpReg, qqReg, mask);
        AscendC::Reg::Adds(phaseReg, xReg, -BY0_PHASE, mask);
        AscendC::Reg::Muls(reduceKReg, phaseReg, INV_PI, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(reduceKReg, reduceKReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, PI, mask);
        AscendC::Reg::Sub(phaseReg, phaseReg, tmpReg, mask);
        AscendC::Reg::Muls(tmpReg, reduceKReg, 0.5f, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, ROUND_MAGIC, mask);
        AscendC::Reg::Adds(tmpReg, tmpReg, -ROUND_MAGIC, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 2.0f, mask);
        AscendC::Reg::Sub(quadrantSignReg, reduceKReg, tmpReg, mask);
        AscendC::Reg::Abs(quadrantSignReg, quadrantSignReg, mask);
        AscendC::Reg::Muls(quadrantSignReg, quadrantSignReg, -2.0f, mask);
        AscendC::Reg::Adds(quadrantSignReg, quadrantSignReg, 1.0f, mask);
        AscendC::Reg::Mul(trigArg2Reg, phaseReg, phaseReg, mask);

        AscendC::Reg::Duplicate<float>(sinPolyReg, -1.0f / 39916800.0f, mask);
        BY0_TRIG_SIN_STEP(1.0f / 362880.0f)
        BY0_TRIG_SIN_STEP(-1.0f / 5040.0f)
        BY0_TRIG_SIN_STEP(1.0f / 120.0f)
        BY0_TRIG_SIN_STEP(-1.0f / 6.0f)
        BY0_TRIG_SIN_STEP(1.0f)
        AscendC::Reg::Mul(sinReg, sinPolyReg, phaseReg, mask);
        AscendC::Reg::Mul(sinReg, sinReg, quadrantSignReg, mask);

        AscendC::Reg::Duplicate<float>(cosPolyReg, -1.0f / 3628800.0f, mask);
        BY0_TRIG_COS_STEP(1.0f / 40320.0f)
        BY0_TRIG_COS_STEP(-1.0f / 720.0f)
        BY0_TRIG_COS_STEP(1.0f / 24.0f)
        BY0_TRIG_COS_STEP(-1.0f / 2.0f)
        BY0_TRIG_COS_STEP(1.0f)
        AscendC::Reg::Mul(cosReg, cosPolyReg, quadrantSignReg, mask);

        AscendC::Reg::Mul(largeReg, ratioPReg, sinReg, mask);
        AscendC::Reg::Mul(termReg, invXReg, ratioQReg, mask);
        AscendC::Reg::Mul(termReg, termReg, cosReg, mask);
        AscendC::Reg::Add(largeReg, largeReg, termReg, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, BY0_SCALE, mask);
        AscendC::Reg::Mul(largeReg, largeReg, tmpReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, xReg, mask);
        AscendC::Reg::Div(largeReg, largeReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(smallMask, xReg, 5.0f, mask);
        AscendC::Reg::Select<float>(outReg, smallReg, largeReg, smallMask);

        // domain/boundary (mirrors merged bessel_y1 BesselY1RegVf):
        //   x <= 0 -> NaN ; then x == 0 -> -inf ; x == +inf -> NaN ; NaN -> NaN
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(leZeroMask, xReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, nanReg, outReg, leZeroMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(zeroMask, xReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, negInfReg, outReg, zeroMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(posInfMask, xReg, infValue, mask);
        AscendC::Reg::Select<float>(outReg, nanReg, outReg, posInfMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, nanMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void BesselY0Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src,
    const AscendC::LocalTensor<float> &j0, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    __ubuf__ float *j0Addr = (__ubuf__ float *)j0.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BesselY0RegVf>(dstAddr, srcAddr, j0Addr, elementCount, chunkCount);
}

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("bessel_y0(Tensor x) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor bessel_y0_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "bessel_y0 only supports float32");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("bessel_y0", bessel_y0_meta);
}

// ===================== 3. Tiling =====================

std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / TOTAL_TILE_BUFFERS / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) {
        tileBytes = BLOCK_BYTES;
    }
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) {
        tileElems = 8;
    }
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel harness =====================

class KernelBesselY0 {
public:
    __aicore__ inline KernelBesselY0() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockIdx * blockLength);

        int64_t tileBytes =
            ((tileLength_ * static_cast<int64_t>(sizeof(float)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(inQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
        pipe_.InitBuffer(tmp0_, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto inLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(inLocal, xGm_[offset], p, pad);
        inQueue_.EnQue(inLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto inLocal = inQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        auto j0Local = tmp0_.Get<float>();
        BesselJ0Reg(j0Local, inLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        BesselY0Reg(outLocal, inLocal, j0Local, count);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp0_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

__global__ __aicore__ __vector__ void bessel_y0_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelBesselY0 op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor bessel_y0_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "bessel_y0 only supports float32");

    auto input = x.contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) = calc_tiling_params(totalLength, input.element_size());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        bessel_y0_kernel<<<numBlocks, nullptr, stream>>>(xPtr, yPtr, totalLength, blockLength, tileLength);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("BesselY0", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("bessel_y0", bessel_y0_npu);
}

} // namespace BesselY0
} // namespace ops_multimodal_fusion

#undef BY0_HORNER
#undef BY0_TRIG_SIN_STEP
#undef BY0_TRIG_COS_STEP
