/*!
 * \file dynamic_quant.asc
 * \brief Dynamic quantization operator for Ascend NPU
 *
 * Per-row dynamic quantization: x (float16/bfloat16) -> y (int8) + scale (float32)
 * Symmetric mode: scale = abs_max / 127, y = round(x / scale)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"

#include "dynamic_quant_apt.h"
#include "dynamic_quant_host_tiling.h"

namespace ops_multimodal_fusion {
namespace DynamicQuant {

// 1. Schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("dynamic_quant(Tensor x, bool symmetric=True) -> (Tensor, Tensor)");
}

// 2. Meta function
std::tuple<torch::Tensor, torch::Tensor> dynamic_quant_meta(
    const torch::Tensor &x, bool symmetric)
{
    TORCH_CHECK(x.dim() >= 2, "dynamic_quant: input must have at least 2 dimensions");
    TORCH_CHECK(x.scalar_type() == torch::kFloat16 || x.scalar_type() == torch::kBFloat16,
                "dynamic_quant: input must be float16 or bfloat16");

    auto y = torch::empty_like(x, x.options().dtype(torch::kInt8));
    int64_t rowNum = x.numel() / x.size(-1);
    auto scale = torch::empty({rowNum}, x.options().dtype(torch::kFloat32));
    return std::make_tuple(y, scale);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("dynamic_quant", dynamic_quant_meta);
}

// 3. NPU dispatch
std::tuple<torch::Tensor, torch::Tensor> dynamic_quant_npu(
    const torch::Tensor &x, bool symmetric)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto x_contig = x.contiguous();

    int64_t rowLen = x_contig.size(-1);
    int64_t rowNum = x_contig.numel() / rowLen;

    auto y = torch::empty_like(x_contig, x_contig.options().dtype(torch::kInt8));
    auto scale = torch::empty({rowNum}, x_contig.options().dtype(torch::kFloat32));
    auto offset = symmetric
        ? torch::Tensor()
        : torch::empty({rowNum}, x_contig.options().dtype(torch::kFloat32));

    // Workspace (minimal)
    auto workspace = torch::empty({1024}, x_contig.options().dtype(torch::kUInt8));

    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    auto config = DynamicQuantHost::CalcDynamicQuantTiling(
        static_cast<uint32_t>(rowNum), static_cast<uint32_t>(rowLen),
        /*hasSmooth=*/false, /*groupNum=*/0, /*isSymmetrical=*/symmetric);

    auto x_ptr  = (GM_ADDR)x_contig.data_ptr();
    auto y_ptr  = (GM_ADDR)y.data_ptr();
    auto s_ptr  = (GM_ADDR)scale.data_ptr();
    auto o_ptr  = symmetric ? (GM_ADDR) nullptr : (GM_ADDR)offset.data_ptr();
    auto ws_ptr = (GM_ADDR)workspace.data_ptr();

    uint32_t hasSmoothFlag = 0;
    uint32_t isSymFlag     = symmetric ? 1U : 0U;
    uint32_t useDbFlag     = config.useDb ? 1U : 0U;

    auto acl_call = [=]() -> int {
        if (config.quantMode == TPL_COMMON_FULL_LOAD) {
            AT_DISPATCH_SWITCH(
                x_contig.scalar_type(), "dynamic_quant_fullload",
                AT_DISPATCH_CASE(torch::kFloat16, [&] {
                    dq_fullload_half_int8<<<config.blockDim, nullptr, stream>>>(
                        x_ptr, nullptr, nullptr,
                        y_ptr, s_ptr, o_ptr, ws_ptr,
                        config.tiling, hasSmoothFlag, isSymFlag, useDbFlag);
                })
                AT_DISPATCH_CASE(torch::kBFloat16, [&] {
                    dq_fullload_bf16_int8<<<config.blockDim, nullptr, stream>>>(
                        x_ptr, nullptr, nullptr,
                        y_ptr, s_ptr, o_ptr, ws_ptr,
                        config.tiling, hasSmoothFlag, isSymFlag, useDbFlag);
                })
            );
        } else if (config.quantMode == TPL_COMMON_LARGE_SHAPE) {
            AT_DISPATCH_SWITCH(
                x_contig.scalar_type(), "dynamic_quant_largeshape",
                AT_DISPATCH_CASE(torch::kFloat16, [&] {
                    dq_largeshape_half_int8<<<config.blockDim, nullptr, stream>>>(
                        x_ptr, nullptr, nullptr,
                        y_ptr, s_ptr, o_ptr, ws_ptr,
                        config.tiling, hasSmoothFlag, isSymFlag, useDbFlag);
                })
                AT_DISPATCH_CASE(torch::kBFloat16, [&] {
                    dq_largeshape_bf16_int8<<<config.blockDim, nullptr, stream>>>(
                        x_ptr, nullptr, nullptr,
                        y_ptr, s_ptr, o_ptr, ws_ptr,
                        config.tiling, hasSmoothFlag, isSymFlag, useDbFlag);
                })
            );
        } else {
            TORCH_CHECK(false, "dynamic_quant: unsupported quantMode ", config.quantMode);
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("DynamicQuant", acl_call);
    return std::make_tuple(y, scale);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("dynamic_quant", dynamic_quant_npu);
}

} // namespace DynamicQuant
} // namespace ops_multimodal_fusion
