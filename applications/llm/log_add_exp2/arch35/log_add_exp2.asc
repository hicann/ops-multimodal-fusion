/*!
 * \file log_add_exp2.asc
 * \brief LogAddExp2 (binary log-sum-exp base 2) operator for Ascend NPU (dav-3510)
 *
 * torch.logaddexp2(a, b) -> c  with  c = log2(2^a + 2^b)
 *
 * Scope (per issue #91): float32 and float16 on dav-3510, same shape & dtype.
 *
 * Numerically stable algorithm:
 *   Direct evaluation of 2^a + 2^b overflows for moderately large inputs and
 *   underflows for small ones. Using the identity
 *
 *     log2(2^a + 2^b) = M + log2(1 + 2^(-|a - b|))    where M = max(a, b)
 *
 *   the interior exponent is <= 0, so 2^(-|a-b|) is in [0, 1]. The argument
 *   of the outer log2 is in [1, 2], which stays well inside fp16/fp32 range
 *   and preserves precision.  Equal inputs use a vector mask to force
 *   |a-b| = 0 before Abs, avoiding inf-inf for same-sign infinity pairs while
 *   preserving the finite equal case x + log2(2) = x + 1.
 *
 *   Steps (float32 inputs use input dtype; float16 inputs use float opmath):
 *     1. M  = Max(a, b)
 *     2. d  = min(|a - b|, 128)
 *     3. t  = Exp(-d * ln 2)                             (= 2^-d)
 *     4. c  = M + Ln(1 + t) * (1 / ln 2)                 (Ln scaled to log2)
 *
 * AscendC has no direct Log2 vector intrinsic, so step 5 uses Ln + Muls.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace LogAddExp2 {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("log_add_exp2(Tensor a, Tensor b) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor log_add_exp2_meta(const torch::Tensor &a, const torch::Tensor &b)
{
    TORCH_CHECK(a.sizes() == b.sizes(),
                "log_add_exp2: shapes must match, got ", a.sizes(), " vs ", b.sizes());
    TORCH_CHECK(a.scalar_type() == b.scalar_type(),
                "log_add_exp2: dtypes must match, got ", a.scalar_type(),
                " vs ", b.scalar_type());
    TORCH_CHECK(a.scalar_type() == torch::kFloat32 ||
                a.scalar_type() == torch::kFloat16,
                "log_add_exp2: only float32 and float16 are supported on dav-3510, got ",
                a.scalar_type());
    return torch::empty_like(a);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("log_add_exp2", log_add_exp2_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t totalLength, c10::ScalarType dtype)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;

    int64_t elemSize = (dtype == torch::kFloat16) ? 2 : 4;
    // Queue storage: a, b, c each double-buffered.  Compute also needs one
    // zero scratch vector and one byte-per-element mask.  fp16 additionally
    // uses three float32 TBufs for CUDA-like opmath before casting back to half.
    int64_t bytesPerElem = PIPELINE_DEPTH * 3 * elemSize;
    bytesPerElem += sizeof(float) + 1;
    if (dtype == torch::kFloat16) {
        bytesPerElem += 3 * static_cast<int64_t>(sizeof(float));
    }
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t tileSize = tileElems * elemSize;
    tileSize = (tileSize / 32) * 32; // align queue bytes to 32 bytes
    TORCH_CHECK(tileSize > 0, "log_add_exp2: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// ===================== 4. Kernel =====================

template <typename T>
class KernelLogAddExp2 {
public:
    __aicore__ inline KernelLogAddExp2() {}

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        aGm_.SetGlobalBuffer((__gm__ T *)a + blockLength * AscendC::GetBlockIdx());
        bGm_.SetGlobalBuffer((__gm__ T *)b + blockLength * AscendC::GetBlockIdx());
        cGm_.SetGlobalBuffer((__gm__ T *)c + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueA_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(inQueueB_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueC_, PIPELINE_DEPTH, tileSize);
        if constexpr (std::is_same<T, half>::value) {
            pipe_.InitBuffer(tbufAFloat_, tileSize * 2);
            pipe_.InitBuffer(tbufBFloat_, tileSize * 2);
            pipe_.InitBuffer(tbufCFloat_, tileSize * 2);
            pipe_.InitBuffer(tbufZeroFloat_, tileSize * 2);
        } else {
            pipe_.InitBuffer(tbufZeroFloat_, tileSize);
        }
        uint32_t maskSize = ((tileSize / sizeof(T) + 31) / 32) * 32;
        pipe_.InitBuffer(maskTBuf_, maskSize);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileSize / sizeof(T);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

        AscendC::LocalTensor<T> aLocal = inQueueA_.AllocTensor<T>();
        AscendC::LocalTensor<T> bLocal = inQueueB_.AllocTensor<T>();
        AscendC::DataCopyPad(aLocal, aGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(bLocal, bGm_[offset], copyParams, padParams);
        inQueueA_.EnQue(aLocal);
        inQueueB_.EnQue(bLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<T> aLocal = inQueueA_.DeQue<T>();
        AscendC::LocalTensor<T> bLocal = inQueueB_.DeQue<T>();
        AscendC::LocalTensor<T> cLocal = outQueueC_.AllocTensor<T>();

        if constexpr (std::is_same<T, half>::value) {
            auto aFloat = tbufAFloat_.Get<float>();
            auto bFloat = tbufBFloat_.Get<float>();
            auto cFloat = tbufCFloat_.Get<float>();

            AscendC::Cast(aFloat, aLocal, AscendC::RoundMode::CAST_NONE, count);
            AscendC::Cast(bFloat, bLocal, AscendC::RoundMode::CAST_NONE, count);
            AscendC::PipeBarrier<PIPE_V>();
            inQueueA_.FreeTensor(aLocal);
            inQueueB_.FreeTensor(bLocal);

            ComputeFloat32(aFloat, bFloat, cFloat, count);

            AscendC::Cast(cLocal, cFloat, AscendC::RoundMode::CAST_NONE, count);
            AscendC::PipeBarrier<PIPE_V>();
        } else {
            ComputeFloat32(aLocal, bLocal, cLocal, count);
            inQueueA_.FreeTensor(aLocal);
            inQueueB_.FreeTensor(bLocal);
        }

        outQueueC_.EnQue(cLocal);
    }

    __aicore__ inline void ComputeFloat32(
        AscendC::LocalTensor<float>& aLocal,
        AscendC::LocalTensor<float>& bLocal,
        AscendC::LocalTensor<float>& cLocal,
        int64_t count)
    {
        const float NEG_LN2 = -0.6931471805599453f; // -ln(2)
        const float INV_LN2 = 1.4426950408889634f;  // 1 / ln(2)
        const float MAX_GAP = 128.0f;
        auto zeroLocal = tbufZeroFloat_.Get<float>();
        auto eqMask = maskTBuf_.Get<uint8_t>();

        AscendC::Max(cLocal, aLocal, bLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Compare(eqMask, aLocal, bLocal, AscendC::CMPMODE::EQ, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(aLocal, aLocal, bLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Duplicate(zeroLocal, 0.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Select(aLocal, eqMask, zeroLocal, aLocal,
                        AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Abs(aLocal, aLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mins(aLocal, aLocal, MAX_GAP, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(aLocal, aLocal, NEG_LN2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(aLocal, aLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(aLocal, aLocal, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Ln(aLocal, aLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(aLocal, aLocal, INV_LN2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(cLocal, cLocal, aLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> cLocal = outQueueC_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(cGm_[offset], cLocal, copyParams);
        outQueueC_.FreeTensor(cLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> aGm_, bGm_, cGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueA_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueB_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueC_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufAFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufBFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufZeroFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maskTBuf_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void log_add_exp2_kernel(
    GM_ADDR a, GM_ADDR b, GM_ADDR c,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelLogAddExp2<T> op;
    op.Init(a, b, c, totalLength, blockLength, tileSize);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor log_add_exp2_npu(const torch::Tensor &a_in, const torch::Tensor &b_in)
{
    TORCH_CHECK(a_in.sizes() == b_in.sizes(),
                "log_add_exp2: shapes must match, got ", a_in.sizes(), " vs ", b_in.sizes());
    TORCH_CHECK(a_in.scalar_type() == b_in.scalar_type(),
                "log_add_exp2: dtypes must match, got ", a_in.scalar_type(),
                " vs ", b_in.scalar_type());
    TORCH_CHECK(a_in.scalar_type() == torch::kFloat32 ||
                a_in.scalar_type() == torch::kFloat16,
                "log_add_exp2: only float32 and float16 are supported on dav-3510, got ",
                a_in.scalar_type());

    const c10::OptionalDeviceGuard guard(a_in.device());
    auto a = a_in.contiguous();
    auto b = b_in.contiguous();
    auto c = torch::empty_like(a);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = a.numel();
    if (totalLength == 0) {
        return c;
    }
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) =
        calc_tiling_params(totalLength, a.scalar_type());

    auto a_ptr = (GM_ADDR)a.data_ptr();
    auto b_ptr = (GM_ADDR)b.data_ptr();
    auto c_ptr = (GM_ADDR)c.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            a.scalar_type(), "log_add_exp2_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                log_add_exp2_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    a_ptr, b_ptr, c_ptr, totalLength, blockLength, tileSize);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                log_add_exp2_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    a_ptr, b_ptr, c_ptr, totalLength, blockLength, tileSize);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("LogAddExp2", acl_call);
    return c;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("log_add_exp2", log_add_exp2_npu);
}

} // namespace LogAddExp2
} // namespace ops_multimodal_fusion
