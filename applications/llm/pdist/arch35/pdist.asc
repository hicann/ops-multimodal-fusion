/*!
 * \file pdist.asc
 * \brief RegBase Pdist forward operator for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.pdist(input, p=2.0) -> output
 *   input  : [N, D], fp16/bfloat16/fp32
 *   output : [N * (N - 1) / 2], same dtype as input
 *
 * Output order matches torch.nn.functional.pdist: upper-triangular row-major
 * pairs (0,1), (0,2), ..., (0,N-1), (1,2), ...
 *
 * Core distance math is strict RegBase: feature tiles are loaded to UB, cast to
 * fp32 when needed, and reduced with Reg::Reduce. Cross-tile accumulation and
 * final sqrt / exp(log(.)) transforms are also single-lane Reg operations.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <limits>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Pdist {

static constexpr int64_t kSafetyBytes = 4096;
static constexpr int64_t kMaxTileElems = 2048;
static constexpr int64_t kRegScratchBytes = 32;
static constexpr int64_t kModeZero = 0;
static constexpr int64_t kModeOne = 1;
static constexpr int64_t kModeTwo = 2;
static constexpr int64_t kModeGeneral = 3;
static constexpr int64_t kModeInf = 4;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("pdist(Tensor input, float p=2.0) -> Tensor");
}

static int64_t pair_count(int64_t n)
{
    return (n <= 1) ? 0 : (n * (n - 1)) / 2;
}

static void check_common(const torch::Tensor &input, double p)
{
    TORCH_CHECK(input.dim() == 2,
                "pdist: expected a 2-D input tensor, got ", input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat32 ||
                input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kBFloat16,
                "pdist: only float32, float16 and bfloat16 are supported on dav-3510, got ",
                input.scalar_type());
    TORCH_CHECK(p >= 0.0 && p == p,
                "pdist: p must be non-negative and not NaN");
}

torch::Tensor pdist_meta(const torch::Tensor &input, double p)
{
    check_common(input, p);
    return torch::empty({pair_count(input.size(0))}, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("pdist", pdist_meta);
}

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t pairCount, int64_t d, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "pdist: coreNum must be positive");

    // Contiguous pdist output is written in aligned 32B groups. Keep the first
    // version single-block so every group starts at an aligned global offset.
    int64_t numBlocks = 1;
    int64_t jobsPerBlock = pairCount;

    int64_t bytesPerElem =
        2 * elemSize +                      // input rows in original dtype
        2 * static_cast<int64_t>(sizeof(float)); // fp32 compute rows
    int64_t scalarBytes = 4 * kRegScratchBytes;
    int64_t tileElems = (static_cast<int64_t>(ubSize) - kSafetyBytes - scalarBytes) /
                        bytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min<int64_t>(tileElems, kMaxTileElems);
    if (d > 0) {
        TORCH_CHECK(tileElems > 0,
                    "pdist: UB is too small for one aligned feature tile");
    } else {
        tileElems = std::max<int64_t>(tileElems, alignElems);
    }
    return std::make_tuple(numBlocks, jobsPerBlock, tileElems);
}

template <typename T>
__simd_vf__ inline void CastToFloatRegVf(__ubuf__ float *dstAddr,
                                         __ubuf__ T *srcAddr,
                                         uint32_t count,
                                         uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastToFloatReg(AscendC::LocalTensor<float> &dst,
                                      AscendC::LocalTensor<T> &src,
                                      int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T, AscendC::RoundMode ROUND>
__simd_vf__ inline void CastFromFloatRegVf(__ubuf__ T *dstAddr,
                                           __ubuf__ float *srcAddr,
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        ROUND};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<T, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T, AscendC::RoundMode ROUND>
__aicore__ inline void CastFromFloatReg(AscendC::LocalTensor<T> &dst,
                                        AscendC::LocalTensor<float> &src,
                                        int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFromFloatRegVf<T, ROUND>>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void InitScalarRegVf(__ubuf__ float *dstAddr, float value)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::Duplicate<float>(valueReg, value, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        dstAddr, valueReg, mask);
}

__aicore__ inline void InitScalarReg(AscendC::LocalTensor<float> &dst, float value)
{
    asc_vf_call<InitScalarRegVf>((__ubuf__ float *)dst.GetPhyAddr(), value);
}

__simd_vf__ inline void CopyScalarRegVf(__ubuf__ float *dstAddr,
                                        __ubuf__ float *srcAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        valueReg, srcAddr);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        dstAddr, valueReg, mask);
}

__aicore__ inline void CopyScalarReg(AscendC::LocalTensor<float> &dst,
                                     AscendC::LocalTensor<float> &src)
{
    asc_vf_call<CopyScalarRegVf>(
        (__ubuf__ float *)dst.GetPhyAddr(),
        (__ubuf__ float *)src.GetPhyAddr());
}

template <int64_t Mode>
__simd_vf__ inline void AccumulateScalarRegVf(__ubuf__ float *accumAddr,
                                              __ubuf__ float *valueAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        valueReg, valueAddr);
    if constexpr (Mode == kModeInf) {
        AscendC::Reg::Max(accumReg, accumReg, valueReg, mask);
    } else {
        AscendC::Reg::Add(accumReg, accumReg, valueReg, mask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, mask);
}

template <int64_t Mode>
__aicore__ inline void AccumulateScalarReg(AscendC::LocalTensor<float> &accum,
                                           AscendC::LocalTensor<float> &value)
{
    asc_vf_call<AccumulateScalarRegVf<Mode>>(
        (__ubuf__ float *)accum.GetPhyAddr(),
        (__ubuf__ float *)value.GetPhyAddr());
}

template <int64_t Mode>
__simd_vf__ inline void FinalizeScalarRegVf(__ubuf__ float *valueAddr, float p)
{
    uint32_t scalarCount = 1;
    float invP = 1.0f / p;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> valueReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> safeReg;
    AscendC::Reg::MaskReg zeroMask;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        valueReg, valueAddr);
    if constexpr (Mode == kModeTwo) {
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING,
                            AscendC::Reg::RegTensor<float>>(valueReg, valueReg, mask);
    } else if constexpr (Mode == kModeGeneral) {
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        zeroMask = AscendC::Reg::CreateMask<float>();
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(
            zeroMask, valueReg, 0.0f, mask);
        safeReg = valueReg;
        AscendC::Reg::Select<float>(safeReg, oneReg, safeReg, zeroMask);
        AscendC::Reg::Ln(safeReg, safeReg, mask);
        AscendC::Reg::Muls(safeReg, safeReg, invP, mask);
        AscendC::Reg::Exp(safeReg, safeReg, mask);
        AscendC::Reg::Muls(valueReg, safeReg, 1.0f, mask);
        AscendC::Reg::Select<float>(valueReg, zeroReg, valueReg, zeroMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        valueAddr, valueReg, mask);
}

template <int64_t Mode>
__aicore__ inline void FinalizeScalarReg(AscendC::LocalTensor<float> &value, float p)
{
    asc_vf_call<FinalizeScalarRegVf<Mode>>(
        (__ubuf__ float *)value.GetPhyAddr(), p);
}

template <int64_t Mode>
__simd_vf__ inline void PdistTileRegVf(__ubuf__ float *reduceAddr,
                                       __ubuf__ float *lhsAddr,
                                       __ubuf__ float *rhsAddr,
                                       float p,
                                       uint32_t count,
                                       uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);

    AscendC::Reg::RegTensor<float> lhsReg;
    AscendC::Reg::RegTensor<float> rhsReg;
    AscendC::Reg::RegTensor<float> diffReg;
    AscendC::Reg::RegTensor<float> absReg;
    AscendC::Reg::RegTensor<float> termReg;
    AscendC::Reg::RegTensor<float> reduceReg;
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::RegTensor<float> safeReg;
    AscendC::Reg::MaskReg nzMask;
    AscendC::Reg::MaskReg zeroMask;

    AscendC::Reg::Duplicate<float>(accumReg, 0.0f, scalarMask);
    AscendC::Reg::Duplicate<float>(oneReg, 1.0f, scalarMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            lhsReg, lhsAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            rhsReg, rhsAddr + offset);
        AscendC::Reg::Sub(diffReg, lhsReg, rhsReg, mask);
        AscendC::Reg::Abs(absReg, diffReg, mask);

        if constexpr (Mode == kModeZero) {
            AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
            AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
            nzMask = AscendC::Reg::CreateMask<float>();
            AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
                nzMask, diffReg, zeroReg, mask);
            AscendC::Reg::Reduce<
                AscendC::Reg::ReduceType::SUM, float, float,
                AscendC::Reg::MaskMergeMode::ZEROING>(reduceReg, oneReg, nzMask);
        } else if constexpr (Mode == kModeOne) {
            AscendC::Reg::Reduce<
                AscendC::Reg::ReduceType::SUM, float, float,
                AscendC::Reg::MaskMergeMode::ZEROING>(reduceReg, absReg, mask);
        } else if constexpr (Mode == kModeTwo) {
            AscendC::Reg::Mul(termReg, absReg, absReg, mask);
            AscendC::Reg::Reduce<
                AscendC::Reg::ReduceType::SUM, float, float,
                AscendC::Reg::MaskMergeMode::ZEROING>(reduceReg, termReg, mask);
        } else if constexpr (Mode == kModeInf) {
            AscendC::Reg::Reduce<
                AscendC::Reg::ReduceType::MAX, float, float,
                AscendC::Reg::MaskMergeMode::ZEROING>(reduceReg, absReg, mask);
        } else {
            AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
            AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
            zeroMask = AscendC::Reg::CreateMask<float>();
            AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(
                zeroMask, absReg, 0.0f, mask);
            safeReg = absReg;
            AscendC::Reg::Select<float>(safeReg, oneReg, safeReg, zeroMask);
            AscendC::Reg::Ln(termReg, safeReg, mask);
            AscendC::Reg::Muls(termReg, termReg, p, mask);
            AscendC::Reg::Exp(termReg, termReg, mask);
            AscendC::Reg::Select<float>(termReg, zeroReg, termReg, zeroMask);
            AscendC::Reg::Reduce<
                AscendC::Reg::ReduceType::SUM, float, float,
                AscendC::Reg::MaskMergeMode::ZEROING>(reduceReg, termReg, mask);
        }

        if constexpr (Mode == kModeInf) {
            AscendC::Reg::Max(accumReg, accumReg, reduceReg, scalarMask);
        } else {
            AscendC::Reg::Add(accumReg, accumReg, reduceReg, scalarMask);
        }
    }

    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        reduceAddr, accumReg, scalarMask);
}

template <int64_t Mode>
__aicore__ inline void PdistTileReg(AscendC::LocalTensor<float> &reduce,
                                    AscendC::LocalTensor<float> &lhs,
                                    AscendC::LocalTensor<float> &rhs,
                                    float p,
                                    int64_t count)
{
    __ubuf__ float *reduceAddr = (__ubuf__ float *)reduce.GetPhyAddr();
    __ubuf__ float *lhsAddr = (__ubuf__ float *)lhs.GetPhyAddr();
    __ubuf__ float *rhsAddr = (__ubuf__ float *)rhs.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<PdistTileRegVf<Mode>>(
        reduceAddr, lhsAddr, rhsAddr, p, elementCount, chunkCount);
}

template <typename T, int64_t Mode>
class KernelPdist {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;
    static constexpr bool kIsBf16 = std::is_same<T, bfloat16_t>::value;
    static constexpr AscendC::RoundMode kCastOutRound =
        kIsBf16 ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;

public:
    __aicore__ inline KernelPdist() {}

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                int64_t n, int64_t d, int64_t pairCount,
                                float p, int64_t jobsPerBlock,
                                int64_t tileElems)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        n_ = n;
        d_ = d;
        pairCount_ = pairCount;
        p_ = p;
        jobsPerBlock_ = jobsPerBlock;
        tileElems_ = tileElems;

        int64_t blockStart = jobsPerBlock * AscendC::GetBlockIdx();
        int64_t blockJobs = pairCount - blockStart;
        if (blockJobs > jobsPerBlock) {
            blockJobs = jobsPerBlock;
        }
        if (blockJobs < 0) {
            blockJobs = 0;
        }
        blockStart_ = blockStart;
        blockJobs_ = blockJobs;

        pipe_.InitBuffer(tbufX1_, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufX2_, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufX1Float_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufX2Float_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufReduce_, static_cast<uint32_t>(kRegScratchBytes));
        pipe_.InitBuffer(tbufAccum_, static_cast<uint32_t>(kRegScratchBytes));
        pipe_.InitBuffer(tbufOutput_, static_cast<uint32_t>(kRegScratchBytes));
        pipe_.InitBuffer(tbufScalarOut_, static_cast<uint32_t>(kRegScratchBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t outputAlignElems = 32 / static_cast<int64_t>(sizeof(T));
        for (int64_t groupStart = 0; groupStart < blockJobs_;
             groupStart += outputAlignElems) {
            int64_t groupCount = blockJobs_ - groupStart;
            if (groupCount > outputAlignElems) {
                groupCount = outputAlignElems;
            }
            AscendC::LocalTensor<T> outputLocal = tbufOutput_.template Get<T>();
            for (int64_t slot = 0; slot < outputAlignElems; ++slot) {
                outputLocal.SetValue(static_cast<int32_t>(slot), static_cast<T>(0.0f));
            }
            for (int64_t slot = 0; slot < groupCount; ++slot) {
                ProcessPair(blockStart_ + groupStart + slot, outputLocal, slot);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams copyOut;
            copyOut.blockCount = 1;
            // The output tensor is allocated with a padded length. Copy the
            // whole 32B-aligned slot so DataCopyPad does not enter CANN's
            // tail-padding allocation path on the final partial group.
            copyOut.blockLen = static_cast<uint32_t>(outputAlignElems * sizeof(T));
            copyOut.srcStride = 0;
            copyOut.dstStride = 0;
            AscendC::DataCopyPad(outputGm_[blockStart_ + groupStart], outputLocal, copyOut);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

private:
    __aicore__ inline void LinearToPair(int64_t linear, int64_t &i, int64_t &j)
    {
        i = 0;
        int64_t rowPairs = n_ - 1;
        while (linear >= rowPairs && rowPairs > 0) {
            linear -= rowPairs;
            ++i;
            --rowPairs;
        }
        j = i + 1 + linear;
    }

    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t count)
    {
        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(count * sizeof(T));
        params.srcStride = 0;
        params.dstStride = 0;
        return params;
    }

    __aicore__ inline void StoreOutputSlot(AscendC::LocalTensor<T> &outputLocal,
                                           int64_t slot,
                                           AscendC::LocalTensor<float> &value)
    {
        if constexpr (kIsFloat) {
            outputLocal.SetValue(
                static_cast<int32_t>(slot),
                value.GetValue(0));
        } else {
            AscendC::LocalTensor<T> scalarLocal = tbufScalarOut_.template Get<T>();
            CastFromFloatReg<T, kCastOutRound>(scalarLocal, value, 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            outputLocal.SetValue(
                static_cast<int32_t>(slot),
                scalarLocal.GetValue(0));
        }
    }

    __aicore__ inline void ProcessPair(int64_t outputIndex,
                                       AscendC::LocalTensor<T> &outputLocal,
                                       int64_t outputSlot)
    {
        int64_t i = 0;
        int64_t j = 0;
        LinearToPair(outputIndex, i, j);

        AscendC::LocalTensor<float> accum = tbufAccum_.template Get<float>();
        InitScalarReg(accum, 0.0f);
        AscendC::PipeBarrier<PIPE_V>();

        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        for (int64_t featureStart = 0; featureStart < d_; featureStart += tileElems_) {
            int64_t count = d_ - featureStart;
            if (count > tileElems_) {
                count = tileElems_;
            }
            int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;

            AscendC::LocalTensor<T> x1Local = tbufX1_.template Get<T>();
            AscendC::LocalTensor<T> x2Local = tbufX2_.template Get<T>();
            AscendC::DataCopyPadExtParams<T> padParams{
                true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0.0f)};
            AscendC::DataCopyPad(
                x1Local, inputGm_[i * d_ + featureStart], CopyParams(count), padParams);
            AscendC::DataCopyPad(
                x2Local, inputGm_[j * d_ + featureStart], CopyParams(count), padParams);
            AscendC::PipeBarrier<PIPE_ALL>();

            AscendC::LocalTensor<float> x1Float;
            AscendC::LocalTensor<float> x2Float;
            if constexpr (kIsFloat) {
                x1Float = x1Local;
                x2Float = x2Local;
            } else {
                x1Float = tbufX1Float_.template Get<float>();
                x2Float = tbufX2Float_.template Get<float>();
                CastToFloatReg<T>(x1Float, x1Local, alignedCount);
                AscendC::PipeBarrier<PIPE_V>();
                CastToFloatReg<T>(x2Float, x2Local, alignedCount);
                AscendC::PipeBarrier<PIPE_V>();
            }

            AscendC::LocalTensor<float> reduce = tbufReduce_.template Get<float>();
            PdistTileReg<Mode>(reduce, x1Float, x2Float, p_, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            AccumulateScalarReg<Mode>(accum, reduce);
            AscendC::PipeBarrier<PIPE_V>();
        }

        FinalizeScalarReg<Mode>(accum, p_);
        AscendC::PipeBarrier<PIPE_ALL>();
        StoreOutputSlot(outputLocal, outputSlot, accum);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX1Float_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX2Float_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufReduce_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufAccum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufScalarOut_;
    int64_t n_ = 0;
    int64_t d_ = 0;
    int64_t pairCount_ = 0;
    float p_ = 0.0f;
    int64_t jobsPerBlock_ = 0;
    int64_t tileElems_ = 0;
    int64_t blockStart_ = 0;
    int64_t blockJobs_ = 0;
};

template <typename T, int64_t Mode>
__global__ __aicore__ __vector__ void pdist_kernel(
    GM_ADDR input, GM_ADDR output, int64_t n, int64_t d, int64_t pairCount,
    float p, int64_t jobsPerBlock, int64_t tileElems)
{
    if (AscendC::GetSubBlockIdx() != 0) {
        return;
    }
    KernelPdist<T, Mode> op;
    op.Init(input, output, n, d, pairCount, p, jobsPerBlock, tileElems);
    op.Process();
}

template <int64_t Mode>
static void launch_kernel(const torch::Tensor &input,
                          const torch::Tensor &output,
                          int64_t n,
                          int64_t d,
                          int64_t pairCount,
                          float p,
                          int64_t numBlocks,
                          int64_t jobsPerBlock,
                          int64_t tileElems)
{
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)input.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    AT_DISPATCH_SWITCH(
        input.scalar_type(), "pdist_npu",
        AT_DISPATCH_CASE(torch::kFloat32, [&] {
            pdist_kernel<float, Mode><<<numBlocks, nullptr, stream>>>(
                inputPtr, outputPtr, n, d, pairCount, p, jobsPerBlock, tileElems);
        })
        AT_DISPATCH_CASE(torch::kFloat16, [&] {
            pdist_kernel<half, Mode><<<numBlocks, nullptr, stream>>>(
                inputPtr, outputPtr, n, d, pairCount, p, jobsPerBlock, tileElems);
        })
        AT_DISPATCH_CASE(torch::kBFloat16, [&] {
            pdist_kernel<bfloat16_t, Mode><<<numBlocks, nullptr, stream>>>(
                inputPtr, outputPtr, n, d, pairCount, p, jobsPerBlock, tileElems);
        })
    );
}

torch::Tensor pdist_npu(const torch::Tensor &input, double p)
{
    check_common(input, p);
    const c10::OptionalDeviceGuard guard(input.device());

    auto inputC = input.contiguous();
    int64_t n = inputC.size(0);
    int64_t d = inputC.size(1);
    int64_t outCount = pair_count(n);
    if (outCount == 0) {
        return torch::empty({outCount}, input.options());
    }
    int64_t outputAlignElems = 32 / static_cast<int64_t>(inputC.element_size());
    int64_t paddedOutCount =
        ((outCount + outputAlignElems - 1) / outputAlignElems) * outputAlignElems;
    auto output = torch::empty({paddedOutCount}, input.options());

    int64_t numBlocks = 1;
    int64_t jobsPerBlock = 1;
    int64_t tileElems = 1;
    std::tie(numBlocks, jobsPerBlock, tileElems) =
        calc_tiling_params(outCount, d, inputC.element_size());

    float pFloat = static_cast<float>(p);
    auto acl_call = [=]() -> int {
        if (p == 0.0) {
            launch_kernel<kModeZero>(
                inputC, output, n, d, outCount, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == 1.0) {
            launch_kernel<kModeOne>(
                inputC, output, n, d, outCount, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == 2.0) {
            launch_kernel<kModeTwo>(
                inputC, output, n, d, outCount, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == std::numeric_limits<double>::infinity()) {
            launch_kernel<kModeInf>(
                inputC, output, n, d, outCount, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else {
            launch_kernel<kModeGeneral>(
                inputC, output, n, d, outCount, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Pdist", acl_call);
    return output.narrow(0, 0, outCount);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("pdist", pdist_npu);
}

} // namespace Pdist
} // namespace ops_multimodal_fusion
