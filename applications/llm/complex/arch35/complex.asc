/*!
 * \file complex.asc
 * \brief Complex construction operator for Ascend NPU (dav-3510)
 *
 * torch.complex(real, imag) -> out
 *   out = real + imag * 1j
 *
 * Scope: float16 -> complex32 and float32 -> complex64. bfloat16, float64
 * and integer inputs are rejected because the dav-3510 Reg path does not
 * provide a reliable complex128 interleaved store.
 *
 * The device path uses Ascend950 Reg wrappers for the interleaved complex
 * store. Normal AscendC code is used only for GM/UB movement and queueing.
 */

#include <ATen/ExpandUtils.h>
#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <array>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Complex {

static constexpr int64_t kPipelineDepth = 2;
static constexpr int64_t kMaxBroadcastDims = 8;

struct BroadcastShapeInfo {
    int64_t rank = 0;
    int64_t outShape[kMaxBroadcastDims] = {};
    int64_t realShape[kMaxBroadcastDims] = {};
    int64_t imagShape[kMaxBroadcastDims] = {};
    int64_t realStride[kMaxBroadcastDims] = {};
    int64_t imagStride[kMaxBroadcastDims] = {};
};

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("complex(Tensor real, Tensor imag) -> Tensor");
}

torch::Tensor complex_meta(const torch::Tensor &real, const torch::Tensor &imag)
{
    TORCH_CHECK(real.scalar_type() == imag.scalar_type(),
                "complex: real and imag must have the same dtype, got ",
                real.scalar_type(), " vs ", imag.scalar_type());
    TORCH_CHECK(real.scalar_type() == torch::kFloat16 ||
                real.scalar_type() == torch::kFloat32,
                "complex: expected Half or Float inputs on dav-3510 Reg path, got ",
                real.scalar_type());
    auto out_shape = at::infer_size(real.sizes(), imag.sizes());
    return torch::empty(out_shape, real.options().dtype(c10::toComplexType(real.scalar_type())));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("complex", complex_meta);
}

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t LIVE_ELEMS = 4; // real + imag + complex output(real,imag)
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "complex: coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileElems = static_cast<int64_t>(ubSize) / (kPipelineDepth * LIVE_ELEMS * elemSize);
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "complex: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

template <typename T>
__simd_vf__ inline void ComplexRegVf(__ubuf__ T *outAddr, __ubuf__ T *realAddr,
                                     __ubuf__ T *imagAddr, uint32_t count,
                                     uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> realReg;
    AscendC::Reg::RegTensor<T> imagReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            realReg, realAddr + offset);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            imagReg, imagAddr + offset);
        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_INTLV_B16>(
                outAddr + offset * 2, realReg, imagReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_INTLV_B32>(
                outAddr + offset * 2, realReg, imagReg, mask);
        }
    }
}

template <typename T>
__aicore__ inline void ComplexReg(AscendC::LocalTensor<T> &out,
                                  AscendC::LocalTensor<T> &real,
                                  AscendC::LocalTensor<T> &imag,
                                  int64_t count)
{
    __ubuf__ T *outAddr = (__ubuf__ T *)out.GetPhyAddr();
    __ubuf__ T *realAddr = (__ubuf__ T *)real.GetPhyAddr();
    __ubuf__ T *imagAddr = (__ubuf__ T *)imag.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ComplexRegVf<T>>(outAddr, realAddr, imagAddr, elementCount, chunkCount);
}

template <typename T>
__simd_vf__ inline void BroadcastScalarRegVf(__ubuf__ T *dstAddr, uint32_t count,
                                             uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> scalarReg;
    AscendC::Reg::RegTensor<T> dstReg;
    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(scalarReg, dstAddr);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<T>(dstReg, scalarReg, mask);
        if constexpr (std::is_same<T, half>::value) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
                dstAddr + offset, dstReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + offset, dstReg, mask);
        }
    }
}

template <typename T>
__aicore__ inline void BroadcastScalarReg(AscendC::LocalTensor<T> &dst, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BroadcastScalarRegVf<T>>(dstAddr, elementCount, chunkCount);
}

template <typename T>
class KernelComplex {
public:
    __aicore__ inline KernelComplex() {}

    __aicore__ inline void Init(GM_ADDR real, GM_ADDR imag, GM_ADDR out,
        int64_t totalLength, int64_t blockLength, uint32_t tileElems)
    {
        realGm_.SetGlobalBuffer((__gm__ T *)real + blockLength * AscendC::GetBlockIdx());
        imagGm_.SetGlobalBuffer((__gm__ T *)imag + blockLength * AscendC::GetBlockIdx());
        outGm_.SetGlobalBuffer((__gm__ T *)out + blockLength * AscendC::GetBlockIdx() * 2);

        pipe_.InitBuffer(inQueueReal_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(inQueueImag_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileElems * sizeof(T) * 2);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileElems;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        AscendC::DataCopyExtParams inParams;
        inParams.blockCount = 1;
        inParams.blockLen = count * sizeof(T);
        inParams.srcStride = 0;
        inParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};

        AscendC::LocalTensor<T> realLocal = inQueueReal_.template AllocTensor<T>();
        AscendC::LocalTensor<T> imagLocal = inQueueImag_.template AllocTensor<T>();
        AscendC::DataCopyPad(realLocal, realGm_[offset], inParams, padParams);
        AscendC::DataCopyPad(imagLocal, imagGm_[offset], inParams, padParams);
        inQueueReal_.EnQue(realLocal);
        inQueueImag_.EnQue(imagLocal);
        realLocal = inQueueReal_.template DeQue<T>();
        imagLocal = inQueueImag_.template DeQue<T>();

        AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
        ComplexReg<T>(outLocal, realLocal, imagLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();

        outQueue_.EnQue(outLocal);
        inQueueReal_.FreeTensor(realLocal);
        inQueueImag_.FreeTensor(imagLocal);

        outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyExtParams outParams;
        outParams.blockCount = 1;
        outParams.blockLen = count * sizeof(T) * 2;
        outParams.srcStride = 0;
        outParams.dstStride = 0;
        AscendC::DataCopyPad(outGm_[offset * 2], outLocal, outParams);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> realGm_, imagGm_, outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueReal_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueImag_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void complex_kernel(
    GM_ADDR real, GM_ADDR imag, GM_ADDR out,
    int64_t totalLength, int64_t blockLength, uint32_t tileElems)
{
    KernelComplex<T> op;
    op.Init(real, imag, out, totalLength, blockLength, tileElems);
    op.Process();
}

template <typename T>
class KernelComplexBroadcastNd {
public:
    __aicore__ inline KernelComplexBroadcastNd() {}

    __aicore__ inline void Init(GM_ADDR real, GM_ADDR imag, GM_ADDR out,
        BroadcastShapeInfo shapeInfo, int64_t rowsPerBlock, uint32_t tileElems)
    {
        shapeInfo_ = shapeInfo;
        innerDim_ = shapeInfo_.outShape[shapeInfo_.rank - 1];
        rows_ = 1;
        for (int64_t i = 0; i < shapeInfo_.rank - 1; ++i) {
            rows_ *= shapeInfo_.outShape[i];
        }
        rowsPerBlock_ = rowsPerBlock;
        blockRowStart_ = AscendC::GetBlockIdx() * rowsPerBlock;
        int64_t remaining = rows_ - blockRowStart_;
        blockRows_ = (remaining < rowsPerBlock) ? remaining : rowsPerBlock;
        if (blockRows_ < 0) {
            blockRows_ = 0;
        }
        tileElems_ = tileElems;

        realGm_.SetGlobalBuffer((__gm__ T *)real);
        imagGm_.SetGlobalBuffer((__gm__ T *)imag);
        outGm_.SetGlobalBuffer((__gm__ T *)out);
        pipe_.InitBuffer(inQueueReal_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(inQueueImag_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileElems * sizeof(T) * 2);
    }

    __aicore__ inline void Process()
    {
        for (int64_t r = 0; r < blockRows_; ++r) {
            int64_t row = blockRowStart_ + r;
            for (int64_t col = 0; col < innerDim_; col += tileElems_) {
                int64_t count = innerDim_ - col;
                if (count > tileElems_) {
                    count = tileElems_;
                }
                ProcessTile(row, col, count);
            }
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        return copyParams;
    }

    __aicore__ inline int64_t OffsetOuter(
        int64_t row, const int64_t *shape, const int64_t *stride)
    {
        int64_t offset = 0;
        int64_t tmp = row;
        for (int64_t d = shapeInfo_.rank - 2; d >= 0; --d) {
            int64_t coord = tmp % shapeInfo_.outShape[d];
            tmp /= shapeInfo_.outShape[d];
            if (shape[d] != 1) {
                offset += coord * stride[d];
            }
        }
        return offset;
    }

    __aicore__ inline void LoadBroadcasted(
        AscendC::LocalTensor<T> &local, AscendC::GlobalTensor<T> &gm,
        AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> &queue,
        int64_t baseOffset, int64_t col, int64_t count, int64_t alignedCount,
        int64_t lastDim)
    {
        if (lastDim == 1) {
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(local, gm[baseOffset], CopyParams(1), padParams);
            queue.EnQue(local);
            local = queue.template DeQue<T>();
            BroadcastScalarReg<T>(local, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
        } else {
            AscendC::DataCopyPadExtParams<T> padParams{
                true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};
            AscendC::DataCopyPad(local, gm[baseOffset + col], CopyParams(count), padParams);
            queue.EnQue(local);
            local = queue.template DeQue<T>();
        }
    }

    __aicore__ inline void ProcessTile(int64_t row, int64_t col, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        int64_t realBase = OffsetOuter(row, shapeInfo_.realShape, shapeInfo_.realStride);
        int64_t imagBase = OffsetOuter(row, shapeInfo_.imagShape, shapeInfo_.imagStride);

        AscendC::LocalTensor<T> realLocal = inQueueReal_.template AllocTensor<T>();
        AscendC::LocalTensor<T> imagLocal = inQueueImag_.template AllocTensor<T>();
        LoadBroadcasted(realLocal, realGm_, inQueueReal_, realBase, col, count, alignedCount,
                        shapeInfo_.realShape[shapeInfo_.rank - 1]);
        LoadBroadcasted(imagLocal, imagGm_, inQueueImag_, imagBase, col, count, alignedCount,
                        shapeInfo_.imagShape[shapeInfo_.rank - 1]);

        AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
        ComplexReg<T>(outLocal, realLocal, imagLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();

        outQueue_.EnQue(outLocal);
        inQueueReal_.FreeTensor(realLocal);
        inQueueImag_.FreeTensor(imagLocal);

        outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyExtParams outParams;
        outParams.blockCount = 1;
        outParams.blockLen = count * sizeof(T) * 2;
        outParams.srcStride = 0;
        outParams.dstStride = 0;
        AscendC::DataCopyPad(outGm_[(row * innerDim_ + col) * 2], outLocal, outParams);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> realGm_, imagGm_, outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueReal_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueueImag_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    BroadcastShapeInfo shapeInfo_;
    int64_t innerDim_ = 0;
    int64_t rows_ = 0;
    int64_t rowsPerBlock_ = 0;
    int64_t blockRowStart_ = 0;
    int64_t blockRows_ = 0;
    int64_t tileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void complex_broadcast_nd_kernel(
    GM_ADDR real, GM_ADDR imag, GM_ADDR out,
    BroadcastShapeInfo shapeInfo, int64_t rowsPerBlock, uint32_t tileElems)
{
    KernelComplexBroadcastNd<T> op;
    op.Init(real, imag, out, shapeInfo, rowsPerBlock, tileElems);
    op.Process();
}

static void fill_normalized_shape(
    c10::IntArrayRef shape, int64_t rank, int64_t *normalizedShape, int64_t *normalizedStride)
{
    int64_t pad = rank - static_cast<int64_t>(shape.size());
    for (int64_t i = 0; i < rank; ++i) {
        normalizedShape[i] = (i < pad) ? 1 : shape[i - pad];
    }
    int64_t stride = 1;
    for (int64_t i = rank - 1; i >= 0; --i) {
        normalizedStride[i] = stride;
        stride *= normalizedShape[i];
    }
}

static BroadcastShapeInfo make_broadcast_shape_info(
    c10::IntArrayRef outShape, c10::IntArrayRef realShape, c10::IntArrayRef imagShape)
{
    TORCH_CHECK(outShape.size() > 0, "complex: broadcast output rank must be positive");
    TORCH_CHECK(outShape.size() <= kMaxBroadcastDims,
                "complex: broadcast rank exceeds supported max rank ", kMaxBroadcastDims,
                ", got ", outShape.size());
    BroadcastShapeInfo info;
    info.rank = static_cast<int64_t>(outShape.size());
    for (int64_t i = 0; i < info.rank; ++i) {
        info.outShape[i] = outShape[i];
    }
    fill_normalized_shape(realShape, info.rank, info.realShape, info.realStride);
    fill_normalized_shape(imagShape, info.rank, info.imagShape, info.imagStride);
    for (int64_t i = 0; i < info.rank; ++i) {
        TORCH_CHECK(info.realShape[i] == 1 || info.realShape[i] == info.outShape[i],
                    "complex: invalid real broadcast shape");
        TORCH_CHECK(info.imagShape[i] == 1 || info.imagShape[i] == info.outShape[i],
                    "complex: invalid imag broadcast shape");
    }
    return info;
}

torch::Tensor complex_npu(const torch::Tensor &real_in, const torch::Tensor &imag_in)
{
    TORCH_CHECK(real_in.scalar_type() == imag_in.scalar_type(),
                "complex: real and imag must have the same dtype, got ",
                real_in.scalar_type(), " vs ", imag_in.scalar_type());
    TORCH_CHECK(real_in.scalar_type() == torch::kFloat16 ||
                real_in.scalar_type() == torch::kFloat32,
                "complex: expected Half or Float inputs on dav-3510 Reg path, got ",
                real_in.scalar_type());

    const c10::OptionalDeviceGuard guard(real_in.device());
    auto out_shape = at::infer_size(real_in.sizes(), imag_in.sizes());
    auto real = real_in.contiguous();
    auto imag = imag_in.contiguous();
    auto out = torch::empty(out_shape, real_in.options().dtype(c10::toComplexType(real_in.scalar_type())));

    int64_t totalLength = out.numel();
    if (totalLength == 0) {
        return out;
    }
    bool needsBroadcast = (real.sizes() != out_shape) || (imag.sizes() != out_shape);
    BroadcastShapeInfo shapeInfo;
    int64_t broadcastRows = 0;
    if (needsBroadcast) {
        shapeInfo = make_broadcast_shape_info(out.sizes(), real.sizes(), imag.sizes());
        int64_t innerDim = shapeInfo.outShape[shapeInfo.rank - 1];
        broadcastRows = totalLength / innerDim;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) = calc_tiling_params(totalLength, real.element_size());
    auto real_ptr = (GM_ADDR)real.data_ptr();
    auto imag_ptr = (GM_ADDR)imag.data_ptr();
    auto out_ptr = (GM_ADDR)out.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            real.scalar_type(), "complex_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                if (needsBroadcast) {
                    int64_t rowsPerBlock = (broadcastRows + numBlocks - 1) / numBlocks;
                    complex_broadcast_nd_kernel<half><<<numBlocks, nullptr, stream>>>(
                        real_ptr, imag_ptr, out_ptr, shapeInfo, rowsPerBlock, tileElems);
                } else {
                    complex_kernel<half><<<numBlocks, nullptr, stream>>>(
                        real_ptr, imag_ptr, out_ptr, totalLength, blockLength, tileElems);
                }
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                if (needsBroadcast) {
                    int64_t rowsPerBlock = (broadcastRows + numBlocks - 1) / numBlocks;
                    complex_broadcast_nd_kernel<float><<<numBlocks, nullptr, stream>>>(
                        real_ptr, imag_ptr, out_ptr, shapeInfo, rowsPerBlock, tileElems);
                } else {
                    complex_kernel<float><<<numBlocks, nullptr, stream>>>(
                        real_ptr, imag_ptr, out_ptr, totalLength, blockLength, tileElems);
                }
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Complex", acl_call);
    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("complex", complex_npu);
}

} // namespace Complex
} // namespace ops_multimodal_fusion
