/*!
 * \file exp2.asc
 * \brief Exp2 (base-2 exponential) operator for Ascend NPU (dav-3510)
 *
 * torch.special.exp2(x) -> y  with  y = 2^x
 *
 * Scope (per issue #32): float32 and float16 on dav-3510.
 *
 * Algorithm: range reduction with an EXACT integer power of two.
 *   Naively 2^x = exp(x * ln 2), but for fp16 the single Exp over the full
 *   range loses several ULP at large outputs.  Instead split
 *       x = n + f,   n = round(x) (integer),   f = x - n in [-0.5, 0.5]
 *       2^x = 2^n * 2^f,   2^f = exp(f * ln 2)   (small arg, accurate)
 *   and build 2^n EXACTLY from its IEEE-754 bit pattern (no Exp rounding):
 *       2^n = reinterpret_float( (n + 127) << 23 )
 *   The left-shift-by-23 is an int32 multiply by 2^23 (the same identity the
 *   leftshift kernel uses); (n + 127) lies in [0, 255] for n in [-127, 128], so
 *   (n + 127) * 2^23 stays a valid non-negative int32 exponent field and even
 *   maps the range ends to 0 / +inf correctly.  Primitives (ReinterpretCast,
 *   int Adds/Muls, Cast) are the ones copysign / nextafter / leftshift use.
 *
 * All math runs in fp32 internally: a float16 input is promoted to fp32 once at
 * the top and the result narrowed back to fp16 once at the bottom, so the fp16
 * path inherits the fp32 accuracy of the reduction.  Supported ranges:
 *   fp32: x in [-127, 128]  -> y in [~1e-38, ~3.4e38]   (within FLT range)
 *   fp16: x in [-24,  16]   -> y in [~6e-8,  ~6.5e4]    (within half range)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Exp2 {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("exp2(Tensor x) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor exp2_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "exp2: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("exp2", exp2_meta);
}

// ===================== 3. Tiling =====================

// Returns (numBlocks, blockLength, elementsPerTile).  Mirrors the frexp tiling:
// `elementsPerTile` counts *input elements*; each buffer is sized with its own
// element size so the fp32 scratch and the T-typed queues co-exist under fp16.
static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t totalLength, size_t bytesPerT)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // Per-input-element UB cost:
    //   inQueueX  (T)    * PIPELINE_DEPTH = 2 * bytesPerT
    //   outQueueY (T)    * PIPELINE_DEPTH = 2 * bytesPerT
    //   3 fp32 scratch TBufs (xf, pn, bf)               = 3 * 4 = 12
    const int64_t bytesPerElement =
        PIPELINE_DEPTH * static_cast<int64_t>(bytesPerT)
      + PIPELINE_DEPTH * static_cast<int64_t>(bytesPerT)
      + 3 * static_cast<int64_t>(sizeof(float));

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;

    int64_t elementsPerTile = static_cast<int64_t>(ubSize) / bytesPerElement;
    elementsPerTile = (elementsPerTile / 32) * 32; // 32-element align for DMA
    if (elementsPerTile < 32) {
        elementsPerTile = 32;
    }
    return std::make_tuple(numBlocks, blockLength, elementsPerTile);
}

// ===================== 4. Kernel =====================

template <typename T>
class KernelExp2 {
public:
    __aicore__ inline KernelExp2() {}

    static __aicore__ inline uint32_t f32Bytes(uint32_t elements)
    {
        return elements * static_cast<uint32_t>(sizeof(float));
    }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t elementsPerTile)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockLength * AscendC::GetBlockIdx());

        const uint32_t tBytes = elementsPerTile * sizeof(T);
        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tBytes);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tBytes);
        // All vector math runs in fp32 internally (even when T == half) so the
        // range reduction carries full fp32 accuracy; the result is narrowed to
        // fp16 only once, at the end.  Three fp32 scratch buffers.
        pipe_.InitBuffer(tbufXf_, f32Bytes(elementsPerTile));  // x promoted to fp32
        pipe_.InitBuffer(tbufPn_, f32Bytes(elementsPerTile));  // 2^n (bit-built)
        pipe_.InitBuffer(tbufBf_, f32Bytes(elementsPerTile));  // fractional scratch

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = elementsPerTile;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        static constexpr bool kIsFloat = std::is_same<T, float>::value;
        const float LN2          = 0.6931471805599453f;
        const float TWO_POW_23   = 8388608.0f;  // 2^23, int Muls == left shift 23

        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY_.AllocTensor<T>();
        auto xf = tbufXf_.Get<float>();   // x in fp32
        auto pn = tbufPn_.Get<float>();   // 2^n in fp32 (also int32-aliased)
        auto bf = tbufBf_.Get<float>();   // fractional / scratch

        // ---- promote input to fp32 (fp32: exact +0 copy; fp16: widening cast) ----
        if constexpr (kIsFloat) {
            AscendC::Adds(xf, xLocal, 0.0f, count);
        } else {
            AscendC::Cast(xf, xLocal, AscendC::RoundMode::CAST_NONE, count);
        }
        AscendC::PipeBarrier<PIPE_V>();
        inQueueX_.FreeTensor(xLocal);

        // ---- n = round(x)  (nearest integer), held in pn as int32 ----
        AscendC::LocalTensor<int32_t> nInt = pn.ReinterpretCast<int32_t>();
        AscendC::Cast(nInt, xf, AscendC::RoundMode::CAST_RINT, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- nf = float(n) into bf (read nInt before the bit-build clobbers it) ----
        AscendC::Cast(bf, nInt, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- 2^n exact: bits = (n + 127) << 23 = (n + 127) * 2^23 ----
        //   For n in [-127, 128] the field (n + 127) in [0, 255] is a valid fp32
        //   biased exponent; reinterpreting the int32 bit pattern gives 2^n with
        //   no Exp rounding (and maps the ends to 0 / +inf correctly).  Writes
        //   over nInt in place, leaving pn holding 2^n as fp32.
        AscendC::Adds(nInt, nInt, static_cast<int32_t>(127), count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(nInt, nInt, static_cast<int32_t>(TWO_POW_23), count);  // << 23
        AscendC::PipeBarrier<PIPE_V>();

        // ---- f = x - n,  then 2^f = exp(f * ln 2)  (|f| <= 0.5, accurate) ----
        AscendC::Sub(bf, xf, bf, count);                                // f = x - n
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(bf, bf, LN2, count);                             // f * ln2
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(bf, bf, count);                                    // 2^f
        AscendC::PipeBarrier<PIPE_V>();

        // ---- 2^x = 2^n * 2^f, then narrow to T ----
        AscendC::Mul(xf, pn, bf, count);
        AscendC::PipeBarrier<PIPE_V>();
        if constexpr (kIsFloat) {
            AscendC::Adds(yLocal, xf, 0.0f, count);
        } else {
            AscendC::Cast(yLocal, xf, AscendC::RoundMode::CAST_NONE, count);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufPn_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufBf_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void exp2_kernel(
    GM_ADDR x, GM_ADDR y,
    int64_t totalLength, int64_t blockLength, uint32_t elementsPerTile)
{
    KernelExp2<T> op;
    op.Init(x, y, totalLength, blockLength, elementsPerTile);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor exp2_npu(const torch::Tensor &input)
{
    TORCH_CHECK(input.scalar_type() == torch::kFloat32 ||
                input.scalar_type() == torch::kFloat16,
                "exp2: only float32 and float16 are supported on dav-3510, got ",
                input.scalar_type());

    const c10::OptionalDeviceGuard guard(input.device());
    auto x = input.contiguous();
    auto y = torch::empty_like(x);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = x.numel();
    if (totalLength == 0) {
        return y;
    }
    const size_t bytesPerT = (x.scalar_type() == torch::kFloat32) ? 4u : 2u;
    int64_t numBlocks, blockLength, elementsPerTile;
    std::tie(numBlocks, blockLength, elementsPerTile) =
        calc_tiling_params(totalLength, bytesPerT);

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "exp2_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                exp2_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength,
                    static_cast<uint32_t>(elementsPerTile));
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                exp2_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength,
                    static_cast<uint32_t>(elementsPerTile));
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Exp2", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("exp2", exp2_npu);
}

} // namespace Exp2
} // namespace ops_multimodal_fusion
