/*!
 * \file leftshift.asc
 * \brief LeftShift (bitwise left shift) operator for Ascend NPU
 *
 *   z = a << b
 *
 * Matches torch.bitwise_left_shift(a, b) when b is a Python int.
 * Tensor-valued shift amounts are out of scope for this implementation;
 * callers wanting per-element shifts should invoke the op per unique
 * shift value or build one on top of a gather.
 *
 * For signed int32, `a << b` has the standard two's-complement
 * wrap-around semantics. This is exactly what a 32-bit integer
 * multiply by `1 << b` produces, so the kernel reduces to a single
 * AscendC::Muls with the precomputed multiplier.
 *
 * Shift amounts outside [0, 31] are rejected at dispatch time to match
 * PyTorch's defined behaviour (PyTorch raises / is undefined for those
 * cases; we fail loudly rather than silently wrapping).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace LeftShift {

// 1. Schema registration
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("leftshift(Tensor a, int b) -> Tensor");
}

// 2. Meta function
torch::Tensor leftshift_meta(const torch::Tensor &a, int64_t b)
{
    TORCH_CHECK(a.scalar_type() == torch::kInt32,
        "leftshift: only int32 input is supported.");
    return torch::empty_like(a);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("leftshift", leftshift_meta);
}

// 3. Tiling
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t BUFFER_NUM = 2;   // 1 VECIN + 1 VECOUT
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / PIPELINE_DEPTH / BUFFER_NUM;
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// 4. Kernel implementation
class KernelLeftShift {
public:
    static constexpr int64_t PIPELINE_DEPTH = 2;

    __aicore__ inline KernelLeftShift() {}

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR z,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize,
        int32_t multiplier)
    {
        multiplier_ = multiplier;
        pipe_.InitBuffer(inQueueA_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueZ_, PIPELINE_DEPTH, tileSize);
        aGm_.SetGlobalBuffer((__gm__ int32_t *)a + blockLength * AscendC::GetBlockIdx());
        zGm_.SetGlobalBuffer((__gm__ int32_t *)z + blockLength * AscendC::GetBlockIdx());

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        elementNumPerTile_ = tileSize / sizeof(int32_t);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(int32_t);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<int32_t> padParams{false, 0, 0, 0};
        // CopyIn
        auto aLocal = inQueueA_.AllocTensor<int32_t>();
        AscendC::DataCopyPad(aLocal, aGm_[offset], copyParams, padParams);
        inQueueA_.EnQue(aLocal);
        // Compute:  z = a * multiplier  (= a << b, with int32 wrap-around)
        aLocal = inQueueA_.DeQue<int32_t>();
        auto zLocal = outQueueZ_.AllocTensor<int32_t>();
        AscendC::Muls(zLocal, aLocal, multiplier_, count);
        outQueueZ_.EnQue(zLocal);
        inQueueA_.FreeTensor(aLocal);
        // CopyOut
        zLocal = outQueueZ_.DeQue<int32_t>();
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<int32_t> aGm_, zGm_;
    AscendC::TQue<AscendC::QuePosition::VECIN, PIPELINE_DEPTH> inQueueA_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, PIPELINE_DEPTH> outQueueZ_;
    int32_t multiplier_ = 0;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

__global__ __aicore__ __vector__ void leftshift_kernel(
    GM_ADDR a, GM_ADDR z,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize,
    int32_t multiplier)
{
    KernelLeftShift impl;
    impl.Init(a, z, totalLength, blockLength, tileSize, multiplier);
    impl.Process();
}

// 5. NPU dispatch
torch::Tensor leftshift_npu(const torch::Tensor &a, int64_t b)
{
    const c10::OptionalDeviceGuard guard(a.device());
    auto z = leftshift_meta(a, b);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    TORCH_CHECK(b >= 0 && b < 32,
        "leftshift: shift amount must be in [0, 31] for int32 inputs; got ", b);

    // For b in [0, 31], (1 << b) is a valid non-negative int32 (2^0..2^30)
    // or INT_MIN (for b == 31, which sets the sign bit). int32 multiplication
    // with wrap-around then yields the same bit pattern as a << b.
    const int32_t multiplier = static_cast<int32_t>(1u << static_cast<unsigned>(b));

    int64_t totalLength = a.numel();
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto a_ptr = (GM_ADDR)a.data_ptr();
    auto z_ptr = (GM_ADDR)z.data_ptr();

    auto acl_call = [=]() -> int {
        leftshift_kernel<<<numBlocks, nullptr, stream>>>(
            a_ptr, z_ptr, totalLength, blockLength, tileSize, multiplier);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("LeftShift", acl_call);
    return z;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("leftshift", leftshift_npu);
}

} // namespace LeftShift
} // namespace ops_multimodal_fusion
