#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <cstdint>

namespace ops_multimodal_fusion { namespace SemiStructuredLinear {

static constexpr int64_t kVecFloats = 64;

static void mask_to_pos(uint8_t mask,int&p0,int&p1){
    int ps[2],n=0;
    for(int i=0;i<4;++i)if(mask&(1<<i))ps[n++]=i;
    TORCH_CHECK(n==2,"semi_structured_linear: invalid 2:4 mask 0x",std::hex,static_cast<int>(mask),
                " (expected exactly 2 bits set in [0x3,0x5,0x6,0x9,0xa,0xc])");
    p0=ps[0];p1=ps[1];
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME,m){m.def("semi_structured_linear(Tensor x, Tensor w_compressed, Tensor metadata, Tensor bias, int m, int k) -> Tensor");}
torch::Tensor meta(const torch::Tensor&x,const torch::Tensor&w,const torch::Tensor&md,const torch::Tensor&b,int64_t m,int64_t k){
    TORCH_CHECK(k%4==0,"K must be divisible by 4 (got k=",k,")");
    TORCH_CHECK(x.dim()==2&&x.size(1)==k);TORCH_CHECK(w.dim()==2&&w.size(0)==m&&w.size(1)==k/2);
    TORCH_CHECK(md.dim()==2&&md.size(0)==m&&md.size(1)==k/4);TORCH_CHECK(b.dim()==1&&b.size(0)==m);
    TORCH_CHECK(x.scalar_type()==torch::kFloat32);return torch::empty({x.size(0),m},x.options());}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME,Meta,m){m.impl("semi_structured_linear",meta);}

/* ── Layer 1: __simd_vf__ — vectorized K-chunk dot-product + Reg accumulate ─── */

// Computes sum(x[i] * w[i] for i in [0, elementCount)) and adds it to the
// 1-element accumulator at accAddr (lane 0). All compute in Reg; no per-K
// GetValue/SetValue traffic. Tail-safe: partial chunks handled via UpdateMask.
__simd_vf__ inline void DotProductVf(__ubuf__ float *xAddr,
                                        __ubuf__ float *wAddr,
                                        __ubuf__ float *accAddr,
                                        uint32_t elementCount,
                                        uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg, wReg, prodReg, chunkSumReg, accReg;
    uint32_t scalarOne = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarOne);

    // Load running accumulator (host pre-seeded with bias[m])
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accReg, accAddr);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            wReg, wAddr + offset);
        AscendC::Reg::Mul<float>(prodReg, xReg, wReg, mask);
        // Reduce VL products to lane 0 of chunkSumReg
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float,
            AscendC::Reg::MaskMergeMode::ZEROING>(chunkSumReg, prodReg, mask);
        // Accumulate chunk sum into running (lane 0)
        AscendC::Reg::Add<float>(accReg, accReg, chunkSumReg, scalarMask);
    }

    // Store updated accumulator back to accAddr (lane 0)
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accAddr, accReg, scalarMask);
}

/* ── Layer 2: __aicore__ wrapper ────────────────────────────────────────── */

__aicore__ inline void DotProduct(__ubuf__ float *xPtr,
                                     __ubuf__ float *wPtr,
                                     AscendC::LocalTensor<float> &acc,
                                     uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ float *accPtr = (__ubuf__ float *)acc.GetPhyAddr();
    asc_vf_call<DotProductVf>(xPtr, wPtr, accPtr, elementCount, chunkCount);
}

/* ── Layer 3: Kernel — GM↔UB pipeline + Layer 2 dot-product + scalar (b,m) loop ── */

class Kernel {
public:
    __aicore__ inline Kernel(){}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR w,GM_ADDR b,GM_ADDR y,int64_t B,int64_t M,int64_t K) {
        xGm_.SetGlobalBuffer((__gm__ float*)x);
        wGm_.SetGlobalBuffer((__gm__ float*)w);
        bGm_.SetGlobalBuffer((__gm__ float*)b);
        yGm_.SetGlobalBuffer((__gm__ float*)y);
        B_=B;M_=M;K_=K;
        // UB buffers: x (B rows × VL floats each), w (M rows × VL floats each),
        // bias (M), y (B*M), 1-elem accumulator.
        // Each row is allocated VL floats (pad K to VL=64 on dav-3510) so that
        // LoadAlign(xBase + b*VL) / LoadAlign(wBase + m*VL) reads a full VL
        // chunk inside the row's allocation regardless of K. Mask covers only
        // K lanes so garbage padding does not affect the dot-product sum.
        constexpr int64_t kVecFloats = 64;  // VECTOR_REG_WIDTH / sizeof(float)
        pipe_.InitBuffer(tbufX_, static_cast<uint32_t>(B * kVecFloats * sizeof(float)));
        pipe_.InitBuffer(tbufW_, static_cast<uint32_t>(M * kVecFloats * sizeof(float)));
        pipe_.InitBuffer(tbufB_, static_cast<uint32_t>(M * sizeof(float)));
        pipe_.InitBuffer(tbufY_, static_cast<uint32_t>(B*M*sizeof(float)));
        // accLocal must hold a full vector register (256B for fp32 on dav-3510)
        // because DotProductVf uses Reg::LoadAlign/StoreAlign on it (VL=64 floats).
        pipe_.InitBuffer(tbufAcc_, 256);
    }
    __aicore__ inline void Process() {
        if (AscendC::GetBlockIdx() != 0) return;
        if (B_ <= 0 || M_ <= 0 || K_ <= 0) return;

        AscendC::LocalTensor<float> xLocal = tbufX_.Get<float>();
        AscendC::LocalTensor<float> wLocal = tbufW_.Get<float>();
        AscendC::LocalTensor<float> bLocal = tbufB_.Get<float>();
        AscendC::LocalTensor<float> yLocal = tbufY_.Get<float>();
        AscendC::LocalTensor<float> accLocal = tbufAcc_.Get<float>();
        __ubuf__ float *xBase = (__ubuf__ float *)xLocal.GetPhyAddr();
        __ubuf__ float *wBase = (__ubuf__ float *)wLocal.GetPhyAddr();

        AscendC::DataCopyExtParams cf; cf.blockCount=1; cf.srcStride=0; cf.dstStride=0;
        AscendC::DataCopyPadExtParams<float> pf{false,0,0,0.0f};

        // GM → UB (one-shot vectorized DMA; host pre-padded x/w to VL-stride
        // layout so xLocal[b*VL .. b*VL+VL-1] holds row b with K real values
        // followed by VL-K zeros, and LoadAlign(xBase + b*VL) reads a full VL
        // chunk inside row b's allocation regardless of K).
        constexpr int64_t kVecFloats = 64;
        cf.blockLen = static_cast<uint32_t>(B_ * kVecFloats * sizeof(float));
        AscendC::DataCopyPad(xLocal, xGm_, cf, pf);
        cf.blockLen = static_cast<uint32_t>(M_ * kVecFloats * sizeof(float));
        AscendC::DataCopyPad(wLocal, wGm_, cf, pf);
        cf.blockLen = static_cast<uint32_t>(M_ * sizeof(float));
        AscendC::DataCopyPad(bLocal, bGm_, cf, pf);
        AscendC::PipeBarrier<PIPE_ALL>();

        // Scalar (b, m) outer loop; inner K axis goes through Layer 2 VF.
        for (int64_t b=0; b<B_; ++b) {
            for (int64_t m=0; m<M_; ++m) {
                // Seed accumulator with bias[m] (1 scalar UB write)
                accLocal.SetValue(0, bLocal.GetValue(m));
                AscendC::PipeBarrier<PIPE_ALL>();
                // Layer 2: vectorized dot-product over K, accumulates into accLocal.
                // x row b lives at xBase + b*VL; w row m lives at wBase + m*VL.
                DotProduct(xBase + b * kVecFloats, wBase + m * kVecFloats, accLocal,
                           static_cast<uint32_t>(K_));
                AscendC::PipeBarrier<PIPE_ALL>();
                // Store accLocal lane 0 -> yLocal[b, m]
                yLocal.SetValue(b*M_ + m, accLocal.GetValue(0));
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        // UB → GM (vectorized DMA)
        cf.blockLen = static_cast<uint32_t>(B_*M_*sizeof(float));
        AscendC::DataCopyPad(yGm_, yLocal, cf);
    }
private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_,wGm_,bGm_,yGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX_, tbufW_, tbufB_, tbufY_, tbufAcc_;
    int64_t B_=0,M_=0,K_=0;
};

__global__ __aicore__ __vector__ void linear_kernel(GM_ADDR x,GM_ADDR w,GM_ADDR b,GM_ADDR y,int64_t B,int64_t M,int64_t K) {
    Kernel op;op.Init(x,w,b,y,B,M,K);op.Process();
}

/* ── Layer 4: host npu() ────────────────────────────────────────────────── */

static void check_ub_capacity(int64_t B, int64_t M, int64_t K)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    auto align32 = [](int64_t bytes) { return ((bytes + 31) / 32) * 32; };
    // UB allocation uses VL-stride rows (B*VL and M*VL), NOT B*K and M*K.
    // Must use actual padded sizes to prevent silent UB overflow when K << VL.
    int64_t need = align32(B * kVecFloats * sizeof(float)) +
                   align32(M * kVecFloats * sizeof(float)) +
                   align32(M * sizeof(float)) + align32(B*M*sizeof(float)) +
                   8192;
    TORCH_CHECK(static_cast<uint64_t>(need) <= ubSize,
                "semi_structured_linear: UB working set ", need,
                " bytes exceeds UB ", ubSize,
                "; this first version requires x/w/bias/y to fit in UB "
                "(B=", B, " M=", M, " K=", K, " padded-to-VL=", kVecFloats, ")");
}

torch::Tensor npu(const torch::Tensor&x,const torch::Tensor&w_comp,const torch::Tensor&md,const torch::Tensor&bias,int64_t m,int64_t k)
{
    auto y=meta(x,w_comp,md,bias,m,k);
    const c10::OptionalDeviceGuard g(x.device());
    // Host: expand 2:4 compressed W to dense on CPU, pad each row to VL=64
    // floats (K real + zeros), then move to device. VL-stride layout lets the
    // kernel LoadAlign(row + b*VL) read a full VL chunk inside row b's UB
    // allocation regardless of K (mask covers only K lanes, garbage/zero
    // padding does not affect the dot-product sum).
    constexpr int64_t kVecFloats = 64;  // VECTOR_REG_WIDTH / sizeof(float) on dav-3510
    auto wc_cpu=w_comp.cpu(),md_cpu=md.cpu();
    auto w_dense=torch::zeros({m, kVecFloats}, torch::dtype(torch::kFloat32));
    auto wca=wc_cpu.accessor<float,2>();
    auto mda=md_cpu.accessor<uint8_t,2>();
    auto wda=w_dense.accessor<float,2>();
    for(int64_t mi=0;mi<m;++mi) for(int64_t gi=0;gi<k/4;++gi) {
        int p0,p1;mask_to_pos(mda[mi][gi],p0,p1);
        wda[mi][4*gi+p0]=wca[mi][2*gi];wda[mi][4*gi+p1]=wca[mi][2*gi+1];
    }
    // Pad x to [B, VL] (K real + zeros) on device (use torch.nn.functional pad
    // or zeros + copy; here we do a host-side pad for simplicity).
    auto x_cpu = x.cpu();
    auto x_pad = torch::zeros({x.size(0), kVecFloats}, torch::dtype(torch::kFloat32));
    auto xca = x_cpu.accessor<float,2>();
    auto xpa = x_pad.accessor<float,2>();
    for (int64_t b = 0; b < x.size(0); ++b) {
        for (int64_t kk = 0; kk < k; ++kk) xpa[b][kk] = xca[b][kk];
    }
    auto w_npu=w_dense.to(x.device());
    auto x_npu=x_pad.to(x.device());
    auto bc=bias.contiguous();
    check_ub_capacity(x.size(0), m, k);
    auto s=c10_npu::getCurrentNPUStream().stream(false);
    auto xP=(GM_ADDR)x_npu.data_ptr(),wP=(GM_ADDR)w_npu.data_ptr(),bP=(GM_ADDR)bc.data_ptr(),yP=(GM_ADDR)y.data_ptr();
    auto a=[=]()->int{linear_kernel<<<1,nullptr,s>>>(xP,wP,bP,yP,x.size(0),m,k);return 0;};
    at_npu::native::OpCommand::RunOpApi("SemiStructuredLinear",a);
    return y;
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME,PrivateUse1,m){m.impl("semi_structured_linear",npu);}
} }
