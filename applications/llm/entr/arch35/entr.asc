/*!
 * \file entr.asc
 * \brief Entr (information entropy) operator for Ascend NPU
 *
 *   y = entr(x) = -x * ln(x)      for x > 0
 *               =  0               for x = 0
 *               = -inf             for x < 0
 *               =  NaN             for NaN input
 *
 * Matches torch.special.entr.
 *
 * SIMD strategy: evaluate unconditionally on a clamped input so every
 * intermediate stays finite, then lift the negative-x branch to -inf
 * via a Ln-of-mask trick:
 *
 *   base  = -x * Ln(max(x, TINY))
 *     - x >  0: base = -x * ln(x)                 (correct)
 *     - x =  0: base = 0 * ln(TINY) = 0           (correct; IEEE 0·finite = 0)
 *     - x <  0: base = -x * ln(TINY) = finite     (placeholder, to be overridden)
 *
 *   pos_mask = clamp(1 + x · SHARPNESS, 0, 1)   (hard step via two Relus)
 *     - x ≥  0           : pos_mask = 1 exactly
 *     - x ≤ -1/SHARPNESS : pos_mask = 0 exactly
 *     - -1/SHARPNESS < x < 0: linear ramp (O(1/SHARPNESS) transition zone)
 *
 *   lift  = Ln(pos_mask)
 *     - pos_mask = 1: lift = 0
 *     - pos_mask = 0: lift = -inf  (IEEE: ln(0) = -inf)
 *
 *   y = base + lift
 *     - x ≥ 0: y = base
 *     - x < 0: y = finite + (-inf) = -inf  (correct)
 *
 * NaN inputs propagate through Mul/Ln/Relu naturally.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Entr {

// 1. Register the operator's schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("entr(Tensor x) -> Tensor");
}

// 2. Meta function
torch::Tensor entr_meta(const torch::Tensor &x)
{
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("entr", entr_meta);
}

// 3. Tiling parameter calculation
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 2 queues * PIPELINE_DEPTH + 2 TBuf scratch = 6 tile-sized buffers
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 2 + 2;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // 32B aligned
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// Per-dtype constants. fp16 cannot represent 1e-30, so pick a value that
// survives the (T)(...) cast while still being tiny enough that the
// max(x, TINY) clamp only perturbs sub-TINY positive inputs.
template <typename T>
struct EntrConsts;

template <>
struct EntrConsts<float> {
    static __aicore__ inline float tiny()      { return 1e-30f; }
    static __aicore__ inline float neg_tiny()  { return -1e-30f; }
    static __aicore__ inline float sharpness() { return 1e6f; }  // transition ~ 1e-6
};

template <>
struct EntrConsts<half> {
    // 1e-4 is a normal fp16 value (smallest normal is ~6.1e-5); picks above
    // the subnormal boundary so FTZ behaviour on dav-3510 cannot zero it out.
    static __aicore__ inline half tiny()      { return (half)1e-4f; }
    static __aicore__ inline half neg_tiny()  { return (half)-1e-4f; }
    // 1e4 keeps 1 + x * SHARPNESS representable in fp16 for |x| ≲ 6.5;
    // saturation for larger |x| is harmless since the clamp absorbs it.
    static __aicore__ inline half sharpness() { return (half)1e4f; }
};

// 4. Kernel implementation
template <typename T>
class KernelEntr {
public:
    __aicore__ inline KernelEntr() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueX_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tbuf1_, tileSize);
        pipe_.InitBuffer(tbuf2_, tileSize);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        elementNumPerTile_ = tileSize / sizeof(T);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        const T TINY      = EntrConsts<T>::tiny();
        const T NEG_TINY  = EntrConsts<T>::neg_tiny();
        const T SHARPNESS = EntrConsts<T>::sharpness();
        const T ONE       = (T)1.0f;
        const T NEG_ONE   = (T)(-1.0f);

        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY_.AllocTensor<T>();
        auto t1 = tbuf1_.Get<T>();
        auto t2 = tbuf2_.Get<T>();

        // -------- Base: -x * Ln(max(x, TINY)) --------
        // t1 = max(x, TINY) = TINY + Relu(x - TINY)
        AscendC::Adds(t1, xLocal, NEG_TINY, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t1, t1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t1, t1, TINY, count);
        AscendC::PipeBarrier<PIPE_V>();

        // t1 = Ln(max(x, TINY))
        AscendC::Ln(t1, t1, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal = x * Ln(max(x, TINY))
        AscendC::Mul(yLocal, xLocal, t1, count);
        AscendC::PipeBarrier<PIPE_V>();
        // yLocal = -x * Ln(max(x, TINY)) = base
        AscendC::Muls(yLocal, yLocal, NEG_ONE, count);
        AscendC::PipeBarrier<PIPE_V>();

        // -------- Negative-x lift: + Ln(pos_mask) --------
        // pos_mask = clamp(1 + x * SHARPNESS, 0, 1) via two Relus.
        //   x ≥ 0              → pos_mask = 1 exactly
        //   x ≤ -1/SHARPNESS   → pos_mask = 0 exactly
        // t2 = 1 + x * SHARPNESS
        AscendC::Muls(t2, xLocal, SHARPNESS, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t2, t2, ONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        // Lower clamp at 0
        AscendC::Relu(t2, t2, count);
        AscendC::PipeBarrier<PIPE_V>();
        // Upper clamp at 1: t2 = 1 - Relu(1 - t2)
        AscendC::Muls(t1, t2, NEG_ONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t1, t1, ONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t1, t1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t1, t1, NEG_ONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t2, t1, ONE, count);          // t2 = pos_mask
        AscendC::PipeBarrier<PIPE_V>();

        // t2 = Ln(pos_mask)  → 0 for x ≥ 0, -inf for x < 0
        AscendC::Ln(t2, t2, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal = base + lift
        AscendC::Add(yLocal, yLocal, t2, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf2_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void entr_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelEntr<T> op;
    op.Init(x, y, totalLength, blockLength, tileSize);
    op.Process();
}

// 5. NPU dispatch
torch::Tensor entr_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto y = entr_meta(x);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t totalLength = x.numel();
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "entr_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                entr_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileSize);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                entr_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileSize);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Entr", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("entr", entr_npu);
}

} // namespace Entr
} // namespace ops_multimodal_fusion
