/*!
 * \file kthvalue.asc
 * \brief KthValue (k-th smallest along a dim) operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * torch.kthvalue(x, k, dim, keepdim) -> (values, indices)
 *   values  = the k-th smallest value along `dim` per (outer, inner) reduction-pair
 *   indices = the first-occurrence position (along `dim`) of that k-th smallest value
 *
 * Algorithm — k passes of vector min-reduce + scalar index find:
 *
 *   Per (outer, inner) reduction-pair, repeat k times:
 *     1. asc_vf_call → Reg::Reduce<MIN> over xUbuf (chunked if dimSize > vec_width).
 *        One __simd_vf__ writes the global min scalar to a 32B UB slot.
 *     2. Layer 3 kernel reads minVal, linearly scans xUbuf for the first position
 *        equal to minVal → minPos.
 *     3. Layer 3 kernel writes plusInfSurrogate to xUbuf[minPos] to deactivate that
 *        lane for subsequent passes' min-reduce.
 *   The last pass's (minVal, minPos) is the k-th smallest value and its first-occurrence index.
 *
 *   Why a hybrid (vf for min-reduce, scalar for index find):
 *     An all-vector path would need Compare<T, EQ> + Reduce<MIN, idx, eqMask> inside the vf.
 *     Compare<half, EQ> currently returns an empty eqMask on this platform, so the indices
 *     Reduce returns INT32_MAX (the default for empty-mask reduction). Pulling the index
 *     find out of vf keeps it dtype-agnostic (vf only does Reduce<MIN, T>) and the Layer 3
 *     scalar `==` compare works uniformly for fp32 / fp16 / int32 / etc.
 *
 *   Chunked min-reduce (dimSize > vec_width): each chunk LoadAlign-loads vec_width lanes;
 *   the trailing chunk's unused lanes are filled with plusInfSurrogate before
 *   Reduce<MIN, ZEROING>. Cross-chunk min uses Compare<GT> + Select on a 1-slot scalar.
 *
 *   plusInfSurrogate = std::numeric_limits<T>::max() (finite; subsequent Reduce<MIN> skips
 *   deactivated lanes by value). For half, use literal 65504.0f because
 *   std::numeric_limits<half> is not specialised in the standard library.
 *
 *   Tie handling: scalar scan returns the first-occurrence index. Tests guarantee unique
 *   values on the reduction axis to keep the index unambiguous.
 *
 * Output index layout: int32 minPos is written to lane 0 of a 32B int32 scratch with lane 1 = 0,
 * then DMA'd out as int64 low/high. Avoids an int32→int64 cast that has no binary on this platform.
 *
 * 3-layer Reg shape:
 *   Layer 1: __simd_vf__ KthValueReduceMinVf<T>  — vec min reduce only
 *   Layer 2: __aicore__ KthValueReduceMin<T>     — LocalTensor → (__ubuf__ T*) cast
 *   Layer 3: KernelKthValueReg<T>                — DMA, k-pass loop, scalar idx find
 *
 * UB layout per core:
 *   tbufXPersistent: dimSize * sizeof(T)        // axis (page column transcribe + scalar edit target)
 *   tbufVScratch:    pairsPerTile * 32B         // per-pair vf output (min value)
 *   tbufIScratch:    pairsPerTile * 32B         // per-pair int32 idx (lane 0 = idx, lane 1 = 0)
 *   inQueueX:        PIPELINE_DEPTH * page      // page-load buffer (dimSize × innerSize × sizeof(T))
 *   outQueueV/I:     pairsPerTile staging
 *
 * Page-load + scalar transcribe for innerSize > 1: a strided DataCopyPad with blockLen<32B and
 * srcStride>0 is unreliable on the current platform binary; the kernel page-loads the entire
 * (outer)-page contiguously, then scalar-transcribes column innerIdx into xPersistent.
 * innerSize=1 degenerates to a direct contiguous load.
 *
 * Dispatch scope: fp32 / fp16 / int32. bf16 is deferred because the compiler cannot select
 * scalar `<` on __bf16; int64 input is deferred because the platform lacks a Cast<int64,…> binary.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <limits>

namespace ops_multimodal_fusion {
namespace KthValue {

// "+inf surrogate" per dtype: largest finite value the dtype can hold (so
// subsequent Reduce<MIN> ignores deactivated lanes by value, not by mask).
//
// `std::numeric_limits<half>` is NOT specialized in the C++ standard library
// (half is an Ascend-internal type), so numeric_limits<half>::max() returns 0
// — surrogate of 0 makes every deactivated lane the new min on the next pass,
// breaking all k>1 cases for fp16. We branch via `if constexpr` directly at
// each call site (2 sites: vf body + Layer 3 ProcessTile) because a helper
// function would need a qualifier compatible with both `__simd_vf__` and
// `__aicore__` callers — `__aicore__` alone fails ("simd_vf can only call
// simd_callee").
//
// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("kthvalue(Tensor x, int k, int dim, bool keepdim) -> (Tensor values, Tensor indices)");
}

// ===================== 2. Meta =====================

std::tuple<torch::Tensor, torch::Tensor> kthvalue_meta(
    const torch::Tensor &x, int64_t k, int64_t dim, bool keepdim)
{
    int64_t ndim = x.dim();
    TORCH_CHECK(ndim > 0, "kthvalue: input must have at least one dimension");
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim,
                "kthvalue: dim ", dim, " out of range for tensor of ndim ", ndim);
    int64_t dimSize = x.size(dim);
    TORCH_CHECK(dimSize > 0,
                "kthvalue: cannot reduce on a dimension of size 0");
    TORCH_CHECK(k >= 1 && k <= dimSize,
                "kthvalue: k=", k, " out of range [1, ", dimSize, "]");

    auto sizes = x.sizes().vec();
    if (keepdim) {
        sizes[dim] = 1;
    } else {
        sizes.erase(sizes.begin() + dim);
    }
    auto values = torch::empty(sizes, x.options());
    auto indices = torch::empty(sizes, x.options().dtype(torch::kInt64));
    return std::make_tuple(values, indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("kthvalue", kthvalue_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t totalPairs, int64_t dimSize, int64_t innerSize,
                   size_t bytesPerT)
{
    constexpr static int64_t MIN_PAIRS_PER_CORE = 1;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t PAIRS_PER_TILE_PREFERRED = 16;
    constexpr static int64_t SCALAR_SLOT_BYTES = 32;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "kthvalue: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum,
        (totalPairs + MIN_PAIRS_PER_CORE - 1) / MIN_PAIRS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalPairs + numBlocks - 1) / numBlocks;

    // Per-core fixed UB cost:
    //   inQueueX:        PIPELINE_DEPTH * dimSize * innerSize * sizeof(T)  (page-load buffer)
    //   tbufXPersistent: dimSize * sizeof(T)  (axis-column / scalar-edit target)
    int64_t fixedBytes =
        static_cast<int64_t>(PIPELINE_DEPTH) * dimSize * innerSize *
            static_cast<int64_t>(bytesPerT)
      + dimSize * static_cast<int64_t>(bytesPerT);

    // Per-pair output staging:
    //   vScratch slot: 32B (StoreAlign granularity)
    //   iScratch slot: 32B
    //   outQueueV one element: sizeof(T)
    //   outQueueI two int32 (one int64): 8 bytes
    int64_t bytesPerStagedPair =
        2 * SCALAR_SLOT_BYTES
      + static_cast<int64_t>(bytesPerT)
      + static_cast<int64_t>(sizeof(int64_t));

    constexpr static int64_t SAFETY_MARGIN = 1024;
    int64_t budgetForStaging =
        static_cast<int64_t>(ubSize) - fixedBytes - SAFETY_MARGIN;
    TORCH_CHECK(budgetForStaging >= bytesPerStagedPair,
                "kthvalue: dimSize=", dimSize, ", innerSize=", innerSize,
                " too large for dav-3510 UB. fixedBytes=", fixedBytes,
                ", ubSize=", ubSize,
                ". The full reduction page must fit in UB (this first version constraint).");

    int64_t pairsPerTile = budgetForStaging / bytesPerStagedPair;
    if (pairsPerTile > PAIRS_PER_TILE_PREFERRED) {
        pairsPerTile = PAIRS_PER_TILE_PREFERRED;
    }
    if (pairsPerTile < 1) {
        pairsPerTile = 1;
    }
    if (pairsPerTile > blockLength) {
        pairsPerTile = blockLength;
    }
    return std::make_tuple(numBlocks, blockLength, pairsPerTile);
}

// ===================== 4. Kernel — HYBRID 3-layer Reg shape =====================

// Layer 1: __simd_vf__ — chunked Reg::Reduce<MIN> across xUbuf, output scalar minVal.
// Does NOT compute index (that's the hybrid split — index is found by scalar scan in Layer 3).
template <typename T>
__simd_vf__ inline void KthValueReduceMinVf(
    __ubuf__ T *xPtr, __ubuf__ T *minValOutPtr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);

    AscendC::Reg::RegTensor<T> xChunkReg;
    AscendC::Reg::RegTensor<T> chunkMinReg;
    AscendC::Reg::RegTensor<T> globalMinReg;
    AscendC::Reg::RegTensor<T> infReg;

    uint32_t scalarOne = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<T>(scalarOne);
    AscendC::Reg::MaskReg allMask =
        AscendC::Reg::CreateMask<T, AscendC::Reg::MaskPattern::ALL>();

    T plusInfSurrogate;
    if constexpr (std::is_same_v<T, half>) {
        plusInfSurrogate = T(65504.0f);
    } else {
        plusInfSurrogate = std::numeric_limits<T>::max();
    }

    // Initialize globalMinReg = +inf surrogate (lane 0 holds the running global min).
    AscendC::Reg::Duplicate<T, AscendC::Reg::MaskMergeMode::ZEROING>(
        globalMinReg, plusInfSurrogate, scalarMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = (elementCount > offset) ? (elementCount - offset) : 0;
        if (remaining == 0) break;
        uint32_t lanesThisChunk = (remaining > vectorLength) ? vectorLength : remaining;
        AscendC::Reg::MaskReg chunkMask = AscendC::Reg::UpdateMask<T>(lanesThisChunk);

        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xChunkReg, xPtr + offset);

        // Trailing-fill if this chunk has fewer lanes than vec_width: lanes
        // [lanesThisChunk, vectorLength) get +inf surrogate so Reduce<MIN, ZEROING>
        // ignores them by value (ZEROING zeroes out-of-mask lanes which would
        // otherwise become min — incorrect for MIN).
        if (lanesThisChunk < vectorLength) {
            AscendC::Reg::MaskReg invMask;
            AscendC::Reg::Not(invMask, chunkMask, allMask);
            AscendC::Reg::Duplicate<T, AscendC::Reg::MaskMergeMode::ZEROING>(
                infReg, plusInfSurrogate, invMask);
            AscendC::Reg::Select<T>(xChunkReg, infReg, xChunkReg, invMask);
        }

        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::MIN, T, T, AscendC::Reg::MaskMergeMode::ZEROING>(
                chunkMinReg, xChunkReg, chunkMask);

        // Cross-chunk min: globalMinReg = min(globalMinReg, chunkMinReg) on 1-slot
        // scalars. Use Compare<GT> + Select since allowed_patterns has Reg::Max but
        // not Reg::Min binary; (a > b) ? b : a == min(a, b).
        AscendC::Reg::MaskReg gtMask;
        AscendC::Reg::Compare<T, AscendC::CMPMODE::GT>(
            gtMask, globalMinReg, chunkMinReg, scalarMask);
        AscendC::Reg::Select<T>(globalMinReg, chunkMinReg, globalMinReg, gtMask);
    }

    AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        minValOutPtr, globalMinReg, scalarMask);
}

// Layer 2: __aicore__ wrapper. LocalTensor → __ubuf__ T* via GetPhyAddr;
// never reinterpret_cast on GM addresses (would page-fault inside the vf).
template <typename T>
__aicore__ inline void KthValueReduceMin(
    AscendC::LocalTensor<T> &xUbufLT,
    AscendC::LocalTensor<T> &vScratchLT,
    uint32_t slotIdx, uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    constexpr uint32_t SCALAR_SLOT_LANES_T = 32 / sizeof(T);

    __ubuf__ T *xPtr    = (__ubuf__ T *)xUbufLT.GetPhyAddr();
    __ubuf__ T *vOutPtr = (__ubuf__ T *)vScratchLT.GetPhyAddr() + slotIdx * SCALAR_SLOT_LANES_T;

    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<KthValueReduceMinVf<T>>(xPtr, vOutPtr, elementCount, chunkCount);
}

// Layer 3: kernel class — DMA, page-load, k-pass loop, scalar idx find.
template <typename T>
class KernelKthValueReg {
public:
    __aicore__ inline KernelKthValueReg() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR values, GM_ADDR indices,
        int64_t totalPairs, int64_t blockLength, uint32_t pairsPerTile,
        int64_t dimSize, int64_t innerSize, int64_t k)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        valGm_.SetGlobalBuffer((__gm__ T *)values);
        idxGm_.SetGlobalBuffer((__gm__ int32_t *)indices);

        dimSize_ = dimSize;
        innerSize_ = innerSize;
        k_ = k;
        pairsPerTile_ = pairsPerTile;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myBlockLength = totalPairs - blockStart;
        if (myBlockLength > blockLength) myBlockLength = blockLength;
        if (myBlockLength < 0) myBlockLength = 0;
        blockStart_ = blockStart;
        myBlockLength_ = myBlockLength;

        const uint32_t pageBytes = static_cast<uint32_t>(dimSize * innerSize * sizeof(T));
        const uint32_t dimBytes  = static_cast<uint32_t>(dimSize * sizeof(T));
        const uint32_t scratchValBytes = pairsPerTile * 32u;
        const uint32_t scratchIdxBytes = pairsPerTile * 32u;
        const uint32_t outValBytes = pairsPerTile * sizeof(T);
        const uint32_t outIdxBytes = pairsPerTile * sizeof(int64_t);

        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, pageBytes);
        pipe_.InitBuffer(outQueueV_, 1u,             outValBytes);
        pipe_.InitBuffer(outQueueI_, 1u,             outIdxBytes);
        pipe_.InitBuffer(tbufXPersistent_,           dimBytes);
        pipe_.InitBuffer(tbufVScratch_,              scratchValBytes);
        pipe_.InitBuffer(tbufIScratch_,              scratchIdxBytes);
    }

    __aicore__ inline void Process()
    {
        if (myBlockLength_ <= 0) return;
        int64_t consumed = 0;
        while (consumed < myBlockLength_) {
            int64_t tileCount = myBlockLength_ - consumed;
            if (tileCount > static_cast<int64_t>(pairsPerTile_)) {
                tileCount = pairsPerTile_;
            }
            ProcessTile(blockStart_ + consumed, tileCount);
            consumed += tileCount;
        }
    }

private:
    __aicore__ inline void LoadPage(int64_t outerIdx,
        AscendC::LocalTensor<T> &xLocal)
    {
        AscendC::DataCopyExtParams copyParams;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        int64_t pageOffset = outerIdx * dimSize_ * innerSize_;
        copyParams.blockCount = 1;
        copyParams.blockLen = static_cast<uint32_t>(dimSize_ * innerSize_ * sizeof(T));
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(xLocal, xGm_[pageOffset], copyParams, padParams);
    }

    __aicore__ inline void ProcessTile(int64_t pairStart, int64_t count)
    {
        AscendC::LocalTensor<T> vScratch = tbufVScratch_.template Get<T>();
        AscendC::LocalTensor<int32_t> iScratch = tbufIScratch_.template Get<int32_t>();
        AscendC::LocalTensor<T> xPersistent = tbufXPersistent_.template Get<T>();

        // Zero-init iScratch (high int32 of each int64 stays 0 for stride-2 trick).
        constexpr uint32_t SCALAR_SLOT_LANES_T   = 32 / sizeof(T);
        constexpr uint32_t SCALAR_SLOT_LANES_I32 = 32 / sizeof(int32_t);
        for (uint32_t s = 0; s < pairsPerTile_ * SCALAR_SLOT_LANES_I32; ++s) {
            iScratch.SetValue(s, 0);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        T plusInfSurrogate;
        if constexpr (std::is_same_v<T, half>) {
            plusInfSurrogate = T(65504.0f);
        } else {
            plusInfSurrogate = std::numeric_limits<T>::max();
        }

        for (int64_t p = 0; p < count; ++p) {
            int64_t pairIdx = pairStart + p;
            int64_t outerIdx = pairIdx / innerSize_;
            int64_t innerIdx = pairIdx - outerIdx * innerSize_;

            // Page-load + scalar transcribe column to xPersistent.
            AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
            LoadPage(outerIdx, xLocal);
            inQueueX_.EnQue(xLocal);
            xLocal = inQueueX_.template DeQue<T>();
            AscendC::PipeBarrier<PIPE_ALL>();
            for (int64_t d = 0; d < dimSize_; ++d) {
                xPersistent.SetValue(d,
                    xLocal.GetValue(d * innerSize_ + innerIdx));
            }
            inQueueX_.FreeTensor(xLocal);
            AscendC::PipeBarrier<PIPE_ALL>();

            // k-pass min reduce + scalar idx find:
            //   each pass calls vf to reduce min over xPersistent (which gets
            //   modified between passes by writing +inf to the just-selected lane)
            T finalMinVal = plusInfSurrogate;
            int32_t finalMinPos = 0;
            for (int64_t pass = 0; pass < k_; ++pass) {
                // Layer 2 wrapper writes minVal to vScratch[p * SCALAR_SLOT_LANES_T].
                KthValueReduceMin<T>(
                    xPersistent, vScratch,
                    static_cast<uint32_t>(p),
                    static_cast<uint32_t>(dimSize_));
                AscendC::PipeBarrier<PIPE_ALL>();

                T minVal = vScratch.GetValue(p * SCALAR_SLOT_LANES_T);
                int32_t minPos = 0;
                for (int64_t d = 0; d < dimSize_; ++d) {
                    if (xPersistent.GetValue(d) == minVal) {
                        minPos = static_cast<int32_t>(d);
                        break;
                    }
                }
                xPersistent.SetValue(static_cast<int32_t>(minPos), plusInfSurrogate);
                AscendC::PipeBarrier<PIPE_ALL>();

                finalMinVal = minVal;
                finalMinPos = minPos;
            }

            // Stage final result into vScratch[p] / iScratch[2*p] (lane 0 of slots).
            vScratch.SetValue(p * SCALAR_SLOT_LANES_T, finalMinVal);
            iScratch.SetValue(p * SCALAR_SLOT_LANES_I32, finalMinPos);
            // iScratch[p * SCALAR_SLOT_LANES_I32 + 1] already 0 from zero-init.
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        // Pack scratch into out queues, gathering lane-0 of each 32B slot.
        AscendC::LocalTensor<T> outVal = outQueueV_.template AllocTensor<T>();
        AscendC::LocalTensor<int32_t> outIdx = outQueueI_.template AllocTensor<int32_t>();
        for (int64_t p = 0; p < count; ++p) {
            outVal.SetValue(static_cast<int32_t>(p),
                            vScratch.GetValue(p * SCALAR_SLOT_LANES_T));
            outIdx.SetValue(static_cast<int32_t>(2 * p),
                            iScratch.GetValue(p * SCALAR_SLOT_LANES_I32));
            outIdx.SetValue(static_cast<int32_t>(2 * p + 1), 0);
        }
        outQueueV_.EnQue(outVal);
        outQueueI_.EnQue(outIdx);
        outVal = outQueueV_.template DeQue<T>();
        outIdx = outQueueI_.template DeQue<int32_t>();

        AscendC::DataCopyExtParams valOutParams;
        valOutParams.blockCount = 1;
        valOutParams.blockLen = static_cast<uint32_t>(count * sizeof(T));
        valOutParams.srcStride = 0;
        valOutParams.dstStride = 0;
        AscendC::DataCopyPad(valGm_[pairStart], outVal, valOutParams);

        AscendC::DataCopyExtParams idxOutParams;
        idxOutParams.blockCount = 1;
        idxOutParams.blockLen = static_cast<uint32_t>(count * sizeof(int64_t));
        idxOutParams.srcStride = 0;
        idxOutParams.dstStride = 0;
        AscendC::DataCopyPad(idxGm_[pairStart * 2], outIdx, idxOutParams);

        outQueueV_.FreeTensor(outVal);
        outQueueI_.FreeTensor(outIdx);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> valGm_;
    AscendC::GlobalTensor<int32_t> idxGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1>              outQueueV_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1>              outQueueI_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>                tbufXPersistent_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>                tbufVScratch_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>                tbufIScratch_;
    int64_t dimSize_ = 0;
    int64_t innerSize_ = 0;
    int64_t k_ = 0;
    int64_t blockStart_ = 0;
    int64_t myBlockLength_ = 0;
    uint32_t pairsPerTile_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void kthvalue_kernel(
    GM_ADDR x, GM_ADDR values, GM_ADDR indices,
    int64_t totalPairs, int64_t blockLength, uint32_t pairsPerTile,
    int64_t dimSize, int64_t innerSize, int64_t k)
{
    KernelKthValueReg<T> op;
    op.Init(x, values, indices, totalPairs, blockLength, pairsPerTile,
            dimSize, innerSize, k);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

std::tuple<torch::Tensor, torch::Tensor> kthvalue_npu(
    const torch::Tensor &x, int64_t k, int64_t dim, bool keepdim)
{
    auto dtype = x.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "kthvalue (RegBase): only float32 / float16 / int32 are supported, "
                "got ", dtype, ". bf16 and int64 are deferred on this platform "
                "(no scalar `<` for __bf16; no Cast<int64,...> binary).");

    const c10::OptionalDeviceGuard guard(x.device());
    auto x_contig = x.contiguous();
    int64_t ndim = x_contig.dim();
    TORCH_CHECK(ndim > 0, "kthvalue: input must have at least one dimension");
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim,
                "kthvalue: dim ", dim, " out of range for tensor of ndim ", ndim);
    int64_t dimSize = x_contig.size(dim);
    TORCH_CHECK(dimSize > 0, "kthvalue: cannot reduce on a dimension of size 0");
    TORCH_CHECK(k >= 1 && k <= dimSize,
                "kthvalue: k=", k, " out of range [1, ", dimSize, "]");

    int64_t outerSize = 1;
    for (int64_t i = 0; i < dim; ++i) outerSize *= x_contig.size(i);
    int64_t innerSize = 1;
    for (int64_t i = dim + 1; i < ndim; ++i) innerSize *= x_contig.size(i);
    int64_t totalPairs = outerSize * innerSize;

    TORCH_CHECK(dimSize <= static_cast<int64_t>(0x7fffffff),
                "kthvalue: dimSize=", dimSize, " exceeds INT32_MAX");

    auto out_sizes = x_contig.sizes().vec();
    if (keepdim) {
        out_sizes[dim] = 1;
    } else {
        out_sizes.erase(out_sizes.begin() + dim);
    }

    auto values = torch::empty(out_sizes, x_contig.options());
    auto indices = torch::empty(out_sizes,
        x_contig.options().dtype(torch::kInt64));

    if (totalPairs == 0) {
        return std::make_tuple(values, indices);
    }

    const size_t bytesPerT =
        (dtype == torch::kFloat16 || dtype == torch::kBFloat16) ? 2u : 4u;

    int64_t numBlocks, blockLength, pairsPerTile;
    std::tie(numBlocks, blockLength, pairsPerTile) =
        calc_tiling_params(totalPairs, dimSize, innerSize, bytesPerT);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr = (GM_ADDR)x_contig.data_ptr();
    auto v_ptr = (GM_ADDR)values.data_ptr();
    auto i_ptr = (GM_ADDR)indices.data_ptr();
    const uint32_t pairsPerTileU = static_cast<uint32_t>(pairsPerTile);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x_contig.scalar_type(), "kthvalue_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                kthvalue_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, v_ptr, i_ptr,
                    totalPairs, blockLength, pairsPerTileU,
                    dimSize, innerSize, k);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                kthvalue_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, v_ptr, i_ptr,
                    totalPairs, blockLength, pairsPerTileU,
                    dimSize, innerSize, k);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                kthvalue_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, v_ptr, i_ptr,
                    totalPairs, blockLength, pairsPerTileU,
                    dimSize, innerSize, k);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("KthValue", acl_call);

    return std::make_tuple(values, indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("kthvalue", kthvalue_npu);
}

} // namespace KthValue
} // namespace ops_multimodal_fusion
