/*!
 * \file max_unpool2d.asc
 * \brief MaxUnpool2d forward operator for Ascend NPU (arch35), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.max_unpool2d(input, indices, kernel_size, stride, padding, output_size)
 *     -> output
 *
 * input       : [C, H, W] or [N, C, H, W], fp16/fp32 pooled values
 * indices     : same shape as input, int64 flattened spatial indices
 * kernel_size : [kH, kW]
 * stride      : [sH, sW] (caller passes kernel_size for torch stride=None)
 * padding     : [pH, pW]
 * output_size : [outH, outW]
 *
 * output      : same dtype as input, [C, outH, outW] or [N, C, outH, outW]
 *
 * The output plane is zero-filled first. Then each pooled value is scattered to
 * its channel-local flattened spatial index: out[plane, indices[j]] = input[j].
 * Tests avoid duplicate indices because PyTorch documents max-unpool duplicate
 * behavior as nondeterministic.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <tuple>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace MaxUnpool2d {

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("max_unpool2d(Tensor input, Tensor indices, int[2] kernel_size, "
          "int[2] stride, int[2] padding, int[2] output_size) -> Tensor");
}

static std::pair<int64_t, int64_t> parse_int2(at::IntArrayRef ref, const char *name)
{
    TORCH_CHECK(ref.size() == 2,
                "max_unpool2d: ", name, " must contain exactly two integers");
    return std::make_pair(ref[0], ref[1]);
}

static void check_common(
    const torch::Tensor &input, const torch::Tensor &indices,
    at::IntArrayRef kernelSize, at::IntArrayRef stride,
    at::IntArrayRef padding, at::IntArrayRef outputSize)
{
    TORCH_CHECK(input.dim() == 3 || input.dim() == 4,
                "max_unpool2d: expected 3-D or 4-D input, got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "max_unpool2d: expected Half or Float input on arch35 Reg path, got ",
                input.scalar_type());
    TORCH_CHECK(indices.scalar_type() == torch::kInt64,
                "max_unpool2d: indices dtype must be int64, got ",
                indices.scalar_type());
    TORCH_CHECK(indices.sizes() == input.sizes(),
                "max_unpool2d: indices shape ", indices.sizes(),
                " must match input shape ", input.sizes());

    auto k = parse_int2(kernelSize, "kernel_size");
    auto s = parse_int2(stride, "stride");
    auto p = parse_int2(padding, "padding");
    auto o = parse_int2(outputSize, "output_size");
    int64_t kH = k.first;
    int64_t kW = k.second;
    int64_t sH = s.first;
    int64_t sW = s.second;
    int64_t pH = p.first;
    int64_t pW = p.second;
    int64_t outH = o.first;
    int64_t outW = o.second;

    TORCH_CHECK(kH > 0 && kW > 0,
                "max_unpool2d: kernel_size entries must be positive, got [",
                kH, ", ", kW, "]");
    TORCH_CHECK(sH > 0 && sW > 0,
                "max_unpool2d: stride entries must be positive, got [",
                sH, ", ", sW, "]");
    TORCH_CHECK(pH >= 0 && pW >= 0,
                "max_unpool2d: padding entries must be non-negative, got [",
                pH, ", ", pW, "]");
    TORCH_CHECK(outH > 0 && outW > 0,
                "max_unpool2d: output_size entries must be positive, got [",
                outH, ", ", outW, "]");

    int64_t inH = input.size(input.dim() - 2);
    int64_t inW = input.size(input.dim() - 1);
    int64_t N = (input.dim() == 4) ? input.size(0) : 1;
    int64_t C = (input.dim() == 4) ? input.size(1) : input.size(0);
    if (N == 0 || C == 0) {
        return;
    }
    TORCH_CHECK(inH > 0 && inW > 0,
                "max_unpool2d: input spatial dimensions must be non-empty");

    int64_t defaultH = (inH - 1) * sH - 2 * pH + kH;
    int64_t defaultW = (inW - 1) * sW - 2 * pW + kW;
    TORCH_CHECK(outH > defaultH - sH && outH < defaultH + sH,
                "max_unpool2d: invalid output height ", outH,
                " for default height ", defaultH, " and stride ", sH);
    TORCH_CHECK(outW > defaultW - sW && outW < defaultW + sW,
                "max_unpool2d: invalid output width ", outW,
                " for default width ", defaultW, " and stride ", sW);

    int64_t outSpatial = outH * outW;
    TORCH_CHECK(outSpatial <= static_cast<int64_t>(0x7fffffff),
                "max_unpool2d: output spatial size exceeds INT32_MAX");
    TORCH_CHECK(input.numel() <= static_cast<int64_t>(0x7fffffff),
                "max_unpool2d: input numel exceeds INT32_MAX");
    TORCH_CHECK(N * C * outSpatial <= static_cast<int64_t>(0x7fffffff),
                "max_unpool2d: output numel exceeds INT32_MAX");
}

torch::Tensor max_unpool2d_meta(
    const torch::Tensor &input, const torch::Tensor &indices,
    at::IntArrayRef kernelSize, at::IntArrayRef stride,
    at::IntArrayRef padding, at::IntArrayRef outputSize)
{
    check_common(input, indices, kernelSize, stride, padding, outputSize);
    auto o = parse_int2(outputSize, "output_size");
    if (input.dim() == 3) {
        return torch::empty({input.size(0), o.first, o.second}, input.options());
    }
    return torch::empty({input.size(0), input.size(1), o.first, o.second}, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("max_unpool2d", max_unpool2d_meta);
}

template <typename T>
__simd_vf__ inline void MaxUnpoolZeroVf(
    __ubuf__ T *outputAddr, uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::Duplicate<T>(zeroReg, static_cast<T>(0), mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outputAddr + offset, zeroReg, mask);
    }
}

template <typename T>
__aicore__ inline void MaxUnpoolZero(
    AscendC::LocalTensor<T> &output, uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ T *outputPtr = (__ubuf__ T *)output.GetPhyAddr();
    asc_vf_call<MaxUnpoolZeroVf<T>>(outputPtr, elementCount, chunkCount);
}

static std::tuple<int64_t, int64_t> calc_tiling_params(
    int64_t inputNumel, int64_t outputNumel, size_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "max_unpool2d: coreNum must be positive");

    int64_t bytes =
        inputNumel * static_cast<int64_t>(elemSize) +
        inputNumel * static_cast<int64_t>(sizeof(int64_t)) +
        outputNumel * static_cast<int64_t>(elemSize) +
        2048;
    TORCH_CHECK(bytes <= static_cast<int64_t>(ubSize),
                "max_unpool2d: tensor is too large for this arch35 Reg implementation, required UB bytes=",
                bytes, ", ubSize=", ubSize);
    return std::make_tuple(static_cast<int64_t>(1), coreNum);
}

template <typename T>
class KernelMaxUnpool2d {
public:
    __aicore__ inline KernelMaxUnpool2d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR indices, GM_ADDR output,
        int64_t inputNumel, int64_t outputNumel,
        int64_t pooledSpatial, int64_t outSpatial)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        indicesGm_.SetGlobalBuffer((__gm__ int64_t *)indices);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        inputNumel_ = inputNumel;
        outputNumel_ = outputNumel;
        pooledSpatial_ = pooledSpatial;
        outSpatial_ = outSpatial;

        pipe_.InitBuffer(tbufInput_, static_cast<uint32_t>(inputNumel * sizeof(T)));
        pipe_.InitBuffer(tbufIndices_, static_cast<uint32_t>(inputNumel * sizeof(int64_t)));
        pipe_.InitBuffer(tbufOutput_, static_cast<uint32_t>(outputNumel * sizeof(T)));
    }

    __aicore__ inline void Process()
    {
        if (inputNumel_ <= 0 || outputNumel_ <= 0) {
            return;
        }
        if (AscendC::GetBlockIdx() != 0) {
            return;
        }

        AscendC::LocalTensor<T> inputLocal = tbufInput_.template Get<T>();
        AscendC::LocalTensor<int64_t> indicesLocal = tbufIndices_.template Get<int64_t>();
        AscendC::LocalTensor<T> outputLocal = tbufOutput_.template Get<T>();

        AscendC::DataCopyExtParams cpInput;
        cpInput.blockCount = 1;
        cpInput.blockLen = static_cast<uint32_t>(inputNumel_ * sizeof(T));
        cpInput.srcStride = 0;
        cpInput.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padT{false, 0, 0, T{}};
        AscendC::DataCopyPad(inputLocal, inputGm_, cpInput, padT);

        AscendC::DataCopyExtParams cpIndices;
        cpIndices.blockCount = 1;
        cpIndices.blockLen = static_cast<uint32_t>(inputNumel_ * sizeof(int64_t));
        cpIndices.srcStride = 0;
        cpIndices.dstStride = 0;
        AscendC::DataCopyPadExtParams<int64_t> padI{false, 0, 0, static_cast<int64_t>(0)};
        AscendC::DataCopyPad(indicesLocal, indicesGm_, cpIndices, padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        MaxUnpoolZero<T>(outputLocal, static_cast<uint32_t>(outputNumel_));
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t j = 0; j < inputNumel_; ++j) {
            int64_t plane = j / pooledSpatial_;
            int64_t idx = indicesLocal.GetValue(j);
            int64_t outOffset = plane * outSpatial_ + idx;
            T value = inputLocal.GetValue(j);
            outputLocal.SetValue(outOffset, value);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams cpOutput;
        cpOutput.blockCount = 1;
        cpOutput.blockLen = static_cast<uint32_t>(outputNumel_ * sizeof(T));
        cpOutput.srcStride = 0;
        cpOutput.dstStride = 0;
        AscendC::DataCopyPad(outputGm_, outputLocal, cpOutput);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<int64_t> indicesGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIndices_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    int64_t inputNumel_ = 0;
    int64_t outputNumel_ = 0;
    int64_t pooledSpatial_ = 0;
    int64_t outSpatial_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void max_unpool2d_kernel(
    GM_ADDR input, GM_ADDR indices, GM_ADDR output,
    int64_t inputNumel, int64_t outputNumel,
    int64_t pooledSpatial, int64_t outSpatial)
{
    KernelMaxUnpool2d<T> op;
    op.Init(input, indices, output, inputNumel, outputNumel, pooledSpatial, outSpatial);
    op.Process();
}

torch::Tensor max_unpool2d_npu(
    const torch::Tensor &input, const torch::Tensor &indices,
    at::IntArrayRef kernelSize, at::IntArrayRef stride,
    at::IntArrayRef padding, at::IntArrayRef outputSize)
{
    check_common(input, indices, kernelSize, stride, padding, outputSize);
    const c10::OptionalDeviceGuard guard(input.device());

    auto o = parse_int2(outputSize, "output_size");
    int64_t outH = o.first;
    int64_t outW = o.second;
    int64_t pooledH = input.size(input.dim() - 2);
    int64_t pooledW = input.size(input.dim() - 1);
    int64_t pooledSpatial = pooledH * pooledW;
    int64_t outSpatial = outH * outW;

    torch::Tensor output = (input.dim() == 3)
        ? torch::empty({input.size(0), outH, outW}, input.options())
        : torch::empty({input.size(0), input.size(1), outH, outW}, input.options());
    if (input.numel() == 0 || output.numel() == 0) {
        return output;
    }

    auto input_c = input.contiguous();
    auto indices_c = indices.contiguous();

    auto indices_cpu = indices_c.cpu();
    int64_t idxMin = indices_cpu.min().item<int64_t>();
    int64_t idxMax = indices_cpu.max().item<int64_t>();
    TORCH_CHECK(idxMin >= 0,
                "max_unpool2d: indices minimum (", idxMin, ") must be >= 0");
    TORCH_CHECK(idxMax < outSpatial,
                "max_unpool2d: indices maximum (", idxMax,
                ") must be < output spatial size ", outSpatial);

    auto tiling = calc_tiling_params(input_c.numel(), output.numel(), input_c.element_size());
    int64_t numBlocks = std::get<0>(tiling);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)input_c.data_ptr();
    auto indicesPtr = (GM_ADDR)indices_c.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input_c.scalar_type(), "max_unpool2d_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                max_unpool2d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, indicesPtr, outputPtr,
                    input_c.numel(), output.numel(), pooledSpatial, outSpatial);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                max_unpool2d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, indicesPtr, outputPtr,
                    input_c.numel(), output.numel(), pooledSpatial, outSpatial);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("MaxUnpool2d", acl_call);

    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("max_unpool2d", max_unpool2d_npu);
}

} // namespace MaxUnpool2d
} // namespace ops_multimodal_fusion
