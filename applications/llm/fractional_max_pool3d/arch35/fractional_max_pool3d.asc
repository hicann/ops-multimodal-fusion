/*!
 * \file fractional_max_pool3d.asc
 * \brief FractionalMaxPool3d forward operator for Ascend NPU (arch35), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.fractional_max_pool3d(input, kernel_size, output_size, random_samples)
 *     -> (values, indices)
 *
 * input           : [C, D_in, H_in, W_in] or [N, C, D_in, H_in, W_in], fp16/fp32
 * kernel_size     : [kD, kH, kW]
 * output_size     : [outD, outH, outW]
 * random_samples  : [N, C, 3] (5-D input) or [1, C, 3] / [C, 3] (4-D input), float32
 *
 * values          : same dtype as input, same N/C prefix, spatial = [outD, outH, outW]
 * indices         : int64, same shape as values; encoding is d * H_in * W_in + h * W_in + w
 *
 * The window starts are produced by Ben Graham's get_intervals sequence, matching
 * aten/src/ATen/native/cuda/FractionalMaxPool3d.cu (fractional_max_pool3d_out_frame).
 * random_samples[..., 0] controls D intervals, random_samples[..., 1] controls H
 * intervals, and random_samples[..., 2] controls W intervals, matching PyTorch.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <array>
#include <tuple>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace FractionalMaxPool3d {

static constexpr int64_t kBlockBytes = 32;
static constexpr int64_t kScalarSlotBytes = 32;
static constexpr int64_t kDav3510VectorRegBytes = 256;
static constexpr int64_t kVectorLanes =
    kDav3510VectorRegBytes / static_cast<int64_t>(sizeof(float));
static constexpr float kNegInf = -INFINITY;

static int64_t align_up(int64_t value, int64_t align)
{
    return ((value + align - 1) / align) * align;
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("fractional_max_pool3d(Tensor input, int[3] kernel_size, "
          "int[3] output_size, Tensor random_samples) "
          "-> (Tensor values, Tensor indices)");
}

static std::array<int64_t, 3> parse_int3(at::IntArrayRef ref, const char *name)
{
    TORCH_CHECK(ref.size() == 3,
                "fractional_max_pool3d: ", name,
                " must contain exactly three integers");
    return {ref[0], ref[1], ref[2]};
}

static void check_common(
    const torch::Tensor &input, at::IntArrayRef kernelSize,
    at::IntArrayRef outputSize, const torch::Tensor &randomSamples)
{
    TORCH_CHECK(input.dim() == 4 || input.dim() == 5,
                "fractional_max_pool3d: expected 4-D or 5-D input, got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "fractional_max_pool3d: expected Half or Float input on arch35 Reg path, got ",
                input.scalar_type());

    auto kSize = parse_int3(kernelSize, "kernel_size");
    auto oSize = parse_int3(outputSize, "output_size");
    int64_t kD = kSize[0];
    int64_t kH = kSize[1];
    int64_t kW = kSize[2];
    int64_t outD = oSize[0];
    int64_t outH = oSize[1];
    int64_t outW = oSize[2];
    TORCH_CHECK(kD > 0 && kH > 0 && kW > 0,
                "fractional_max_pool3d: kernel_size entries must be positive, got [",
                kD, ", ", kH, ", ", kW, "]");
    TORCH_CHECK(outD > 0 && outH > 0 && outW > 0,
                "fractional_max_pool3d: output_size entries must be positive, got [",
                outD, ", ", outH, ", ", outW, "]");
    TORCH_CHECK(kW <= kVectorLanes,
                "fractional_max_pool3d: this arch35 Reg implementation requires kW <= ",
                kVectorLanes, ", got kW=", kW);

    int64_t N = (input.dim() == 5) ? input.size(0) : 1;
    int64_t C = (input.dim() == 5) ? input.size(1) : input.size(0);
    int64_t inD = input.size(input.dim() - 3);
    int64_t inH = input.size(input.dim() - 2);
    int64_t inW = input.size(input.dim() - 1);

    TORCH_CHECK(randomSamples.scalar_type() == torch::kFloat32,
                "fractional_max_pool3d: random_samples must be float32");
    if (input.dim() == 5) {
        TORCH_CHECK(randomSamples.dim() == 3 &&
                    randomSamples.size(0) == N &&
                    randomSamples.size(1) == C &&
                    randomSamples.size(2) == 3,
                    "fractional_max_pool3d: random_samples must have shape [N, C, 3] for 5-D input");
    } else {
        bool ok = (randomSamples.dim() == 3 &&
                   randomSamples.size(0) == 1 &&
                   randomSamples.size(1) == C &&
                   randomSamples.size(2) == 3) ||
                  (randomSamples.dim() == 2 &&
                   randomSamples.size(0) == C &&
                   randomSamples.size(1) == 3);
        TORCH_CHECK(ok,
                    "fractional_max_pool3d: random_samples must have shape [1, C, 3] or [C, 3] for 4-D input");
    }

    if (N == 0 || C == 0) {
        return;
    }
    TORCH_CHECK(inD > 0 && inH > 0 && inW > 0,
                "fractional_max_pool3d: input spatial dimensions must be non-empty");
    TORCH_CHECK(kD <= inD && kH <= inH && kW <= inW,
                "fractional_max_pool3d: kernel ([", kD, ", ", kH, ", ", kW,
                "]) must not exceed input spatial size ([",
                inD, ", ", inH, ", ", inW, "])");
    int64_t maxOutD = inD - kD;
    int64_t maxOutH = inH - kH;
    int64_t maxOutW = inW - kW;
    TORCH_CHECK(outD <= maxOutD && outH <= maxOutH && outW <= maxOutW,
                "fractional_max_pool3d: output_size ([", outD, ", ", outH, ", ", outW,
                "]) cannot exceed input_size - kernel_size ([",
                maxOutD, ", ", maxOutH, ", ", maxOutW, "])");
}

std::tuple<torch::Tensor, torch::Tensor> fractional_max_pool3d_meta(
    const torch::Tensor &input, at::IntArrayRef kernelSize,
    at::IntArrayRef outputSize, const torch::Tensor &randomSamples)
{
    check_common(input, kernelSize, outputSize, randomSamples);
    auto oSize = parse_int3(outputSize, "output_size");
    int64_t outD = oSize[0];
    int64_t outH = oSize[1];
    int64_t outW = oSize[2];
    if (input.dim() == 4) {
        return std::make_tuple(
            torch::empty({input.size(0), outD, outH, outW}, input.options()),
            torch::empty({input.size(0), outD, outH, outW},
                         input.options().dtype(torch::kInt64)));
    }
    return std::make_tuple(
        torch::empty({input.size(0), input.size(1), outD, outH, outW}, input.options()),
        torch::empty({input.size(0), input.size(1), outD, outH, outW},
                     input.options().dtype(torch::kInt64)));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("fractional_max_pool3d", fractional_max_pool3d_meta);
}

static std::tuple<int64_t, int64_t> calc_tiling_params(
    int64_t kW, size_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "fractional_max_pool3d: coreNum must be positive");

    int64_t rowAligned = std::max<int64_t>(kVectorLanes, kW);
    int64_t rowBytes = align_up(rowAligned * static_cast<int64_t>(elemSize), kBlockBytes);
    int64_t bytes =
        rowBytes +
        kScalarSlotBytes +              // row max float slot
        kScalarSlotBytes +              // random samples slot
        kScalarSlotBytes +              // value output slot
        kScalarSlotBytes +              // index output slot
        2048;
    TORCH_CHECK(bytes <= static_cast<int64_t>(ubSize),
                "fractional_max_pool3d: kernel width ", kW,
                " exceeds arch35 UB capacity for this Reg implementation");
    return std::make_tuple(rowAligned, rowBytes);
}

static int64_t calc_block_count(int64_t totalOutputs)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "fractional_max_pool3d: coreNum must be positive");
    return std::max<int64_t>(1, std::min<int64_t>(totalOutputs, coreNum));
}

__simd_vf__ inline void RowMaxFloatVf(
    __ubuf__ float *rowAddr, __ubuf__ float *resultAddr)
{
    uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::RegTensor<float> rowReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::UpdateMask<float>(vectorLength);
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        rowReg, rowAddr);
    AscendC::Reg::Reduce<
        AscendC::Reg::ReduceType::MAX, float, float,
        AscendC::Reg::MaskMergeMode::ZEROING>(maxReg, rowReg, fullMask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        resultAddr, maxReg, scalarMask);
}

__simd_vf__ inline void RowMaxHalfVf(
    __ubuf__ half *rowAddr, __ubuf__ float *resultAddr)
{
    uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};

    AscendC::Reg::RegTensor<half> rowHalfReg;
    AscendC::Reg::RegTensor<float> rowReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::UpdateMask<float>(vectorLength);
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);

    AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
        rowHalfReg, rowAddr);
    AscendC::Reg::Cast<float, half, castToFloat>(rowReg, rowHalfReg, fullMask);
    AscendC::Reg::Reduce<
        AscendC::Reg::ReduceType::MAX, float, float,
        AscendC::Reg::MaskMergeMode::ZEROING>(maxReg, rowReg, fullMask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        resultAddr, maxReg, scalarMask);
}

__aicore__ inline void RowMaxFloat(
    AscendC::LocalTensor<float> rowLocal, AscendC::LocalTensor<float> resultLocal)
{
    asc_vf_call<RowMaxFloatVf>(
        (__ubuf__ float *)rowLocal.GetPhyAddr(),
        (__ubuf__ float *)resultLocal.GetPhyAddr());
}

__aicore__ inline void RowMaxHalf(
    AscendC::LocalTensor<half> rowLocal, AscendC::LocalTensor<float> resultLocal)
{
    asc_vf_call<RowMaxHalfVf>(
        (__ubuf__ half *)rowLocal.GetPhyAddr(),
        (__ubuf__ float *)resultLocal.GetPhyAddr());
}

__aicore__ inline int64_t floor_non_negative(float value, int64_t upper)
{
    int64_t result = 0;
    while (result < upper && static_cast<float>(result + 1) <= value) {
        ++result;
    }
    return result;
}

__aicore__ inline int64_t get_interval(
    float sample, int64_t index, int64_t inSize, int64_t outSize, int64_t kSize)
{
    if (index == outSize - 1) {
        return inSize - kSize;
    }
    int64_t spanNumerator = inSize - kSize;
    float span = static_cast<float>(inSize - kSize) /
                 static_cast<float>(outSize - 1);
    float scaledA = (static_cast<float>(index) + sample) * span;
    float scaledB = sample * span;
    int64_t a = floor_non_negative(scaledA, spanNumerator);
    int64_t b = floor_non_negative(scaledB, spanNumerator);
    return a - b;
}

template <typename T>
class KernelFractionalMaxPool3d {
public:
    __aicore__ inline KernelFractionalMaxPool3d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR randomSamples, GM_ADDR values, GM_ADDR indices,
        int64_t N, int64_t C, int64_t inD, int64_t inH, int64_t inW,
        int64_t outD, int64_t outH, int64_t outW,
        int64_t kD, int64_t kH, int64_t kW,
        int64_t inputStride0, int64_t inputStride1,
        int64_t inputStride2, int64_t inputStride3, int64_t inputStride4,
        int64_t randomStride0, int64_t randomStride1, int64_t randomStride2,
        int64_t rowAligned, int64_t rowBytes, int64_t totalOutputs,
        int64_t blockLength)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        randomGm_.SetGlobalBuffer((__gm__ float *)randomSamples);
        valuesGm_.SetGlobalBuffer((__gm__ T *)values);
        indicesGm_.SetGlobalBuffer((__gm__ int32_t *)indices);
        N_ = N;
        C_ = C;
        inD_ = inD;
        inH_ = inH;
        inW_ = inW;
        outD_ = outD;
        outH_ = outH;
        outW_ = outW;
        kD_ = kD;
        kH_ = kH;
        kW_ = kW;
        inputStride0_ = inputStride0;
        inputStride1_ = inputStride1;
        inputStride2_ = inputStride2;
        inputStride3_ = inputStride3;
        inputStride4_ = inputStride4;
        randomStride0_ = randomStride0;
        randomStride1_ = randomStride1;
        randomStride2_ = randomStride2;
        rowAligned_ = rowAligned;
        rowBytes_ = rowBytes;
        totalOutputs_ = totalOutputs;
        blockLength_ = blockLength;

        pipe_.InitBuffer(tbufRow_, static_cast<uint32_t>(rowBytes_));
        pipe_.InitBuffer(tbufRowMax_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufRandom_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufOutVal_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufOutIdx_, static_cast<uint32_t>(kScalarSlotBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
        int64_t start = blockIdx * blockLength_;
        int64_t end = start + blockLength_;
        if (end > totalOutputs_) {
            end = totalOutputs_;
        }
        for (int64_t linear = start; linear < end; ++linear) {
            ProcessOne(linear);
        }
    }

private:
    __aicore__ inline void ProcessOne(int64_t linear)
    {
        int64_t ow = linear % outW_;
        int64_t tmp = linear / outW_;
        int64_t oh = tmp % outH_;
        tmp /= outH_;
        int64_t od = tmp % outD_;
        tmp /= outD_;
        int64_t c = tmp % C_;
        int64_t n = tmp / C_;

        float alphaD = 0.0f;
        float alphaH = 0.0f;
        float alphaW = 0.0f;
        LoadRandomSample(n, c, alphaD, alphaH, alphaW);
        int64_t dStart = get_interval(alphaD, od, inD_, outD_, kD_);
        int64_t hStart = get_interval(alphaH, oh, inH_, outH_, kH_);
        int64_t wStart = get_interval(alphaW, ow, inW_, outW_, kW_);
        ProcessWindow(n, c, od, oh, ow, dStart, hStart, wStart);
    }

    __aicore__ inline void LoadRandomSample(
        int64_t n, int64_t c, float &alphaD, float &alphaH, float &alphaW)
    {
        AscendC::LocalTensor<float> randomLocal = tbufRandom_.template Get<float>();
        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(3 * sizeof(float));
        copy.srcStride = 0;
        copy.dstStride = 0;
        AscendC::DataCopyPadExtParams<float> pad{
            true, 0, static_cast<uint8_t>(5), 0.0f};
        int64_t baseElems = n * randomStride0_ + c * randomStride1_;
        if (randomStride2_ == 1) {
            AscendC::DataCopyPad(randomLocal, randomGm_[baseElems], copy, pad);
        } else {
            AscendC::DataCopyExtParams copyOne;
            copyOne.blockCount = 1;
            copyOne.blockLen = static_cast<uint32_t>(sizeof(float));
            copyOne.srcStride = 0;
            copyOne.dstStride = 0;
            AscendC::DataCopyPadExtParams<float> padOne{
                true, 0, static_cast<uint8_t>(7), 0.0f};
            AscendC::DataCopyPad(randomLocal, randomGm_[baseElems], copyOne, padOne);
            AscendC::DataCopyPad(randomLocal[1], randomGm_[baseElems + randomStride2_],
                                 copyOne, padOne);
            AscendC::DataCopyPad(randomLocal[2],
                                 randomGm_[baseElems + 2 * randomStride2_],
                                 copyOne, padOne);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        alphaD = randomLocal.GetValue(0);
        alphaH = randomLocal.GetValue(1);
        alphaW = randomLocal.GetValue(2);
    }

    __aicore__ inline void ProcessChannel(
        int64_t n, int64_t c, float alphaD, float alphaH, float alphaW)
    {
        for (int64_t od = 0; od < outD_; ++od) {
            int64_t dStart = get_interval(alphaD, od, inD_, outD_, kD_);
            for (int64_t oh = 0; oh < outH_; ++oh) {
                int64_t hStart = get_interval(alphaH, oh, inH_, outH_, kH_);
                for (int64_t ow = 0; ow < outW_; ++ow) {
                    int64_t wStart = get_interval(alphaW, ow, inW_, outW_, kW_);
                    ProcessWindow(n, c, od, oh, ow, dStart, hStart, wStart);
                }
            }
        }
    }

    __aicore__ inline void ProcessWindow(
        int64_t n, int64_t c, int64_t od, int64_t oh, int64_t ow,
        int64_t dStart, int64_t hStart, int64_t wStart)
    {
        bool seeded = false;
        float bestVal = kNegInf;
        int64_t bestIdxD = dStart;
        int64_t bestIdxH = hStart;
        int64_t bestIdxW = wStart;

        AscendC::LocalTensor<T> rowLocal = tbufRow_.template Get<T>();
        AscendC::LocalTensor<float> rowMaxLocal = tbufRowMax_.template Get<float>();

        for (int64_t kd = 0; kd < kD_; ++kd) {
            int64_t d = dStart + kd;
            for (int64_t kh = 0; kh < kH_; ++kh) {
                int64_t h = hStart + kh;
                LoadWindowRow(rowLocal, n, c, d, h, wStart);
                AscendC::PipeBarrier<PIPE_ALL>();
                float rowMax = ReadAsFloat(rowLocal, 0);
                for (int64_t kw = 1; kw < kW_; ++kw) {
                    float v = ReadAsFloat(rowLocal, kw);
                    if (v > rowMax) {
                        rowMax = v;
                    }
                }

                int64_t rowArgW = wStart;
                for (int64_t kw = 0; kw < kW_; ++kw) {
                    float v = ReadAsFloat(rowLocal, kw);
                    if (v == rowMax) {
                        rowArgW = wStart + kw;
                        break;
                    }
                }

                if (!seeded || rowMax > bestVal) {
                    seeded = true;
                    bestVal = rowMax;
                    bestIdxD = d;
                    bestIdxH = h;
                    bestIdxW = rowArgW;
                }
            }
        }

        int64_t outOffset = (((n * C_ + c) * outD_ + od) * outH_ + oh) * outW_ + ow;
        StoreValue(outOffset, bestVal);
        StoreIndex(outOffset, (bestIdxD * inH_ + bestIdxH) * inW_ + bestIdxW);
    }

    __aicore__ inline void LoadWindowRow(
        AscendC::LocalTensor<T> rowLocal,
        int64_t n, int64_t c, int64_t d, int64_t h, int64_t wStart)
    {
        T padValue = static_cast<T>(kNegInf);
        for (int64_t i = 0; i < rowAligned_; ++i) {
            rowLocal.SetValue(i, padValue);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(kW_ * sizeof(T));
        copy.srcStride = 0;
        copy.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, padValue};

        int64_t baseElems = n * inputStride0_ + c * inputStride1_ +
                            d * inputStride2_ + h * inputStride3_ +
                            wStart * inputStride4_;
        if (inputStride4_ == 1) {
            AscendC::DataCopyPad(rowLocal, inputGm_[baseElems], copy, pad);
        } else {
            AscendC::DataCopyExtParams copyOne;
            copyOne.blockCount = 1;
            copyOne.blockLen = static_cast<uint32_t>(sizeof(T));
            copyOne.srcStride = 0;
            copyOne.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padOne{false, 0, 0, padValue};
            for (int64_t kw = 0; kw < kW_; ++kw) {
                AscendC::DataCopyPad(rowLocal[kw],
                                     inputGm_[baseElems + kw * inputStride4_],
                                     copyOne, padOne);
            }
        }
    }

    __aicore__ inline float ReadAsFloat(AscendC::LocalTensor<T> rowLocal, int64_t index)
    {
        if constexpr (std::is_same<T, half>::value) {
            half v = rowLocal.GetValue(index);
            return static_cast<float>(v);
        } else {
            return rowLocal.GetValue(index);
        }
    }

    __aicore__ inline void StoreValue(int64_t outputIndex, float value)
    {
        AscendC::LocalTensor<T> outLocal = tbufOutVal_.template Get<T>();
        if constexpr (std::is_same<T, half>::value) {
            outLocal.SetValue(0, T(value));
        } else {
            outLocal.SetValue(0, value);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(valuesGm_[outputIndex], outLocal, copyOut);
    }

    __aicore__ inline void StoreIndex(int64_t outputIndex, int64_t value)
    {
        AscendC::LocalTensor<int32_t> idxLocal = tbufOutIdx_.template Get<int32_t>();
        idxLocal.SetValue(0, static_cast<int32_t>(value));
        idxLocal.SetValue(1, static_cast<int32_t>(value >> 32));
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(sizeof(int64_t));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(indicesGm_[outputIndex * 2], idxLocal, copyOut);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<float> randomGm_;
    AscendC::GlobalTensor<T> valuesGm_;
    AscendC::GlobalTensor<int32_t> indicesGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRow_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRowMax_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRandom_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutVal_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutIdx_;
    int64_t N_ = 0;
    int64_t C_ = 0;
    int64_t inD_ = 0;
    int64_t inH_ = 0;
    int64_t inW_ = 0;
    int64_t outD_ = 0;
    int64_t outH_ = 0;
    int64_t outW_ = 0;
    int64_t kD_ = 0;
    int64_t kH_ = 0;
    int64_t kW_ = 0;
    int64_t inputStride0_ = 0;
    int64_t inputStride1_ = 0;
    int64_t inputStride2_ = 0;
    int64_t inputStride3_ = 0;
    int64_t inputStride4_ = 1;
    int64_t randomStride0_ = 0;
    int64_t randomStride1_ = 3;
    int64_t randomStride2_ = 1;
    int64_t rowAligned_ = 0;
    int64_t rowBytes_ = 0;
    int64_t totalOutputs_ = 0;
    int64_t blockLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void fractional_max_pool3d_kernel(
    GM_ADDR input, GM_ADDR randomSamples, GM_ADDR values, GM_ADDR indices,
    int64_t N, int64_t C, int64_t inD, int64_t inH, int64_t inW,
    int64_t outD, int64_t outH, int64_t outW,
    int64_t kD, int64_t kH, int64_t kW,
    int64_t inputStride0, int64_t inputStride1,
    int64_t inputStride2, int64_t inputStride3, int64_t inputStride4,
    int64_t randomStride0, int64_t randomStride1, int64_t randomStride2,
    int64_t rowAligned, int64_t rowBytes, int64_t totalOutputs,
    int64_t blockLength)
{
    KernelFractionalMaxPool3d<T> op;
    op.Init(input, randomSamples, values, indices,
            N, C, inD, inH, inW, outD, outH, outW, kD, kH, kW,
            inputStride0, inputStride1, inputStride2, inputStride3, inputStride4,
            randomStride0, randomStride1, randomStride2, rowAligned, rowBytes,
            totalOutputs, blockLength);
    op.Process();
}

std::tuple<torch::Tensor, torch::Tensor> fractional_max_pool3d_npu(
    const torch::Tensor &input, at::IntArrayRef kernelSize,
    at::IntArrayRef outputSize, const torch::Tensor &randomSamples)
{
    check_common(input, kernelSize, outputSize, randomSamples);
    const c10::OptionalDeviceGuard guard(input.device());

    auto kSize = parse_int3(kernelSize, "kernel_size");
    auto oSize = parse_int3(outputSize, "output_size");
    int64_t kD = kSize[0];
    int64_t kH = kSize[1];
    int64_t kW = kSize[2];
    int64_t outD = oSize[0];
    int64_t outH = oSize[1];
    int64_t outW = oSize[2];

    bool is5D = (input.dim() == 5);
    int64_t N = is5D ? input.size(0) : 1;
    int64_t C = is5D ? input.size(1) : input.size(0);
    int64_t inD = input.size(input.dim() - 3);
    int64_t inH = input.size(input.dim() - 2);
    int64_t inW = input.size(input.dim() - 1);

    torch::Tensor values = is5D
        ? torch::empty({N, C, outD, outH, outW}, input.options())
        : torch::empty({C, outD, outH, outW}, input.options());
    torch::Tensor indices = is5D
        ? torch::empty({N, C, outD, outH, outW}, input.options().dtype(torch::kInt64))
        : torch::empty({C, outD, outH, outW}, input.options().dtype(torch::kInt64));

    if (N == 0 || C == 0) {
        return std::make_tuple(values, indices);
    }

    int64_t inputStride0 = is5D ? input.stride(0) : 0;
    int64_t inputStride1 = is5D ? input.stride(1) : input.stride(0);
    int64_t inputStride2 = input.stride(input.dim() - 3);
    int64_t inputStride3 = input.stride(input.dim() - 2);
    int64_t inputStride4 = input.stride(input.dim() - 1);

    int64_t randomStride0 = 0;
    int64_t randomStride1 = 0;
    int64_t randomStride2 = 1;
    if (randomSamples.dim() == 3) {
        randomStride0 = randomSamples.stride(0);
        randomStride1 = randomSamples.stride(1);
        randomStride2 = randomSamples.stride(2);
    } else {
        randomStride0 = 0;
        randomStride1 = randomSamples.stride(0);
        randomStride2 = randomSamples.stride(1);
    }

    int64_t rowAligned, rowBytes;
    std::tie(rowAligned, rowBytes) = calc_tiling_params(kW, input.element_size());
    int64_t totalOutputs = N * C * outD * outH * outW;
    int64_t numBlocks = calc_block_count(totalOutputs);
    int64_t blockLength = (totalOutputs + numBlocks - 1) / numBlocks;

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)input.data_ptr();
    auto randomPtr = (GM_ADDR)randomSamples.data_ptr();
    auto valuesPtr = (GM_ADDR)values.data_ptr();
    auto indicesPtr = (GM_ADDR)indices.data_ptr();
    auto aclCall = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input.scalar_type(), "fractional_max_pool3d_npu",
            AT_DISPATCH_CASE(at::ScalarType::Half, [&] {
                fractional_max_pool3d_kernel<half><<<numBlocks, nullptr, stream>>>(
                    inputPtr, randomPtr, valuesPtr, indicesPtr,
                    N, C, inD, inH, inW, outD, outH, outW, kD, kH, kW,
                    inputStride0, inputStride1, inputStride2, inputStride3, inputStride4,
                    randomStride0, randomStride1, randomStride2,
                    rowAligned, rowBytes, totalOutputs, blockLength);
            })
            AT_DISPATCH_CASE(at::ScalarType::Float, [&] {
                fractional_max_pool3d_kernel<float><<<numBlocks, nullptr, stream>>>(
                    inputPtr, randomPtr, valuesPtr, indicesPtr,
                    N, C, inD, inH, inW, outD, outH, outW, kD, kH, kW,
                    inputStride0, inputStride1, inputStride2, inputStride3, inputStride4,
                    randomStride0, randomStride1, randomStride2,
                    rowAligned, rowBytes, totalOutputs, blockLength);
            }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("FractionalMaxPool3dReg", aclCall);
    return std::make_tuple(values, indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("fractional_max_pool3d", fractional_max_pool3d_npu);
}

} // namespace FractionalMaxPool3d
} // namespace ops_multimodal_fusion
