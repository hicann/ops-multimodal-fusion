/*!
 * \file upsample_linear1d.asc
 * \brief UpsampleLinear1d forward operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.upsample_linear1d(input, output_size, align_corners=False, scale=-1.0)
 *     -> output
 *
 * input       : [N, C, W], fp16/fp32
 * output_size : output width OW
 * align_corners : PyTorch linear interpolation align_corners flag
 * scale       : default -1.0 means derive scale from sizes; positive values follow
 *               PyTorch scale_factor semantics
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace UpsampleLinear1d {

static constexpr int64_t kScalarSlotBytes = 32;
static constexpr double kMaxInt64AsDouble = 9.2233720368547758e18;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("upsample_linear1d(Tensor input, int output_size, bool align_corners=False, "
          "float scale=-1.) -> Tensor");
}

static void check_common(
    const torch::Tensor &input, int64_t outputSize, bool alignCorners, double scale)
{
    (void)alignCorners;
    TORCH_CHECK(input.dim() == 3,
                "upsample_linear1d: input must be 3-D [N, C, W], got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "upsample_linear1d: only float16 and float32 are supported, got ",
                input.scalar_type());
    TORCH_CHECK(input.size(0) > 0 && input.size(1) > 0 && input.size(2) > 0,
                "upsample_linear1d: N, C, and W must be positive, got ",
                input.sizes());
    TORCH_CHECK(outputSize > 0,
                "upsample_linear1d: output_size must be positive, got ",
                outputSize);
    TORCH_CHECK(scale == -1.0 || (scale == scale && scale > 0.0 && scale < kMaxInt64AsDouble),
                "upsample_linear1d: scale must be -1.0 (derive from output_size) "
                "or a finite positive scale_factor, got ", scale);
    if (scale > 0.0) {
        double scaledOutput = static_cast<double>(input.size(2)) * scale;
        TORCH_CHECK(scaledOutput >= 1.0 && scaledOutput < kMaxInt64AsDouble,
                    "upsample_linear1d: floor(input_width * scale) must be in int64 range, got ",
                    scaledOutput);
        int64_t expectedOutputSize = static_cast<int64_t>(scaledOutput);
        TORCH_CHECK(outputSize == expectedOutputSize,
                    "upsample_linear1d: when scale_factor is provided, output_size must equal "
                    "floor(input_width * scale_factor); got output_size=", outputSize,
                    ", expected=", expectedOutputSize, " for input_width=", input.size(2),
                    " and scale_factor=", scale);
    }

    const int64_t totalOutput = input.size(0) * input.size(1) * outputSize;
    TORCH_CHECK(totalOutput <= static_cast<int64_t>(0x7fffffff),
                "upsample_linear1d: output numel exceeds INT32_MAX");
}

torch::Tensor upsample_linear1d_meta(
    const torch::Tensor &input, int64_t outputSize, bool alignCorners, double scale)
{
    check_common(input, outputSize, alignCorners, scale);
    return torch::empty({input.size(0), input.size(1), outputSize}, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("upsample_linear1d", upsample_linear1d_meta);
}

static int64_t calc_block_count(int64_t totalOutputs)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "upsample_linear1d: coreNum must be positive");
    return std::max<int64_t>(1, std::min<int64_t>(totalOutputs, coreNum));
}

template <typename T>
__simd_vf__ inline void LinearInterpScalarVf(
    __ubuf__ T *outAddr, __ubuf__ T *leftAddr, __ubuf__ T *rightAddr, float lambda1)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> leftF;
    AscendC::Reg::RegTensor<float> rightF;
    AscendC::Reg::RegTensor<float> lambda1Reg;
    AscendC::Reg::RegTensor<float> lambda0Reg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> leftWeighted;
    AscendC::Reg::RegTensor<float> rightWeighted;
    AscendC::Reg::RegTensor<float> outF;

    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    static constexpr AscendC::Reg::CastTrait castFromFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};

    if constexpr (sizeof(T) == 2) {
        AscendC::Reg::RegTensor<half> leftH;
        AscendC::Reg::RegTensor<half> rightH;
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            leftH, (__ubuf__ half *)leftAddr);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            rightH, (__ubuf__ half *)rightAddr);
        AscendC::Reg::Cast<float, half, castToFloat>(leftF, leftH, mask);
        AscendC::Reg::Cast<float, half, castToFloat>(rightF, rightH, mask);
    } else {
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            leftF, (__ubuf__ float *)leftAddr);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            rightF, (__ubuf__ float *)rightAddr);
    }

    AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
    AscendC::Reg::Duplicate<float>(lambda1Reg, lambda1, mask);
    AscendC::Reg::Sub(lambda0Reg, oneReg, lambda1Reg, mask);
    AscendC::Reg::Mul(leftWeighted, leftF, lambda0Reg, mask);
    AscendC::Reg::Mul(rightWeighted, rightF, lambda1Reg, mask);
    AscendC::Reg::Add(outF, leftWeighted, rightWeighted, mask);

    if constexpr (sizeof(T) == 2) {
        AscendC::Reg::RegTensor<half> outH;
        AscendC::Reg::Cast<half, float, castFromFloat>(outH, outF, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            (__ubuf__ half *)outAddr, outH, mask);
    } else {
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            (__ubuf__ float *)outAddr, outF, mask);
    }
}

template <typename T>
__aicore__ inline void LinearInterpScalar(
    AscendC::LocalTensor<T> outLocal,
    AscendC::LocalTensor<T> leftLocal,
    AscendC::LocalTensor<T> rightLocal,
    float lambda1)
{
    asc_vf_call<LinearInterpScalarVf<T>>(
        (__ubuf__ T *)outLocal.GetPhyAddr(),
        (__ubuf__ T *)leftLocal.GetPhyAddr(),
        (__ubuf__ T *)rightLocal.GetPhyAddr(),
        lambda1);
}

template <typename T>
class KernelUpsampleLinear1d {
public:
    __aicore__ inline KernelUpsampleLinear1d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR output,
        int64_t totalOutputs, int64_t blockLength,
        int64_t inputWidth, int64_t outputWidth,
        bool alignCorners, float sourceScale)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        totalOutputs_ = totalOutputs;
        blockLength_ = blockLength;
        inputWidth_ = inputWidth;
        outputWidth_ = outputWidth;
        alignCorners_ = alignCorners;
        sourceScale_ = sourceScale;

        pipe_.InitBuffer(tbufLeft_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufRight_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufOutput_, static_cast<uint32_t>(kScalarSlotBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
        int64_t start = blockIdx * blockLength_;
        int64_t end = start + blockLength_;
        if (end > totalOutputs_) {
            end = totalOutputs_;
        }
        for (int64_t linear = start; linear < end; ++linear) {
            ComputeOne(linear);
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams()
    {
        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(sizeof(T));
        copy.srcStride = 0;
        copy.dstStride = 0;
        return copy;
    }

    __aicore__ inline void LoadScalar(
        AscendC::LocalTensor<T> local, AscendC::GlobalTensor<T> &gm, int64_t offset)
    {
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(local, gm[offset], CopyParams(), pad);
    }

    __aicore__ inline void StoreScalar(
        AscendC::GlobalTensor<T> &gm, int64_t offset, AscendC::LocalTensor<T> local)
    {
        AscendC::DataCopyPad(gm[offset], local, CopyParams());
    }

    __aicore__ inline int64_t FloorNonNegative(float value, int64_t upper)
    {
        int64_t result = 0;
        while (result < upper && static_cast<float>(result + 1) <= value) {
            ++result;
        }
        return result;
    }

    __aicore__ inline float SourceCoord(int64_t ow)
    {
        if (alignCorners_) {
            if (outputWidth_ <= 1) {
                return 0.0f;
            }
            return static_cast<float>(ow) * sourceScale_;
        }
        float source = sourceScale_ * (static_cast<float>(ow) + 0.5f) - 0.5f;
        return source < 0.0f ? 0.0f : source;
    }

    __aicore__ inline void ComputeOne(int64_t linear)
    {
        int64_t ow = linear - (linear / outputWidth_) * outputWidth_;
        int64_t plane = linear / outputWidth_;
        float source = SourceCoord(ow);
        int64_t left = FloorNonNegative(source, inputWidth_ - 1);
        int64_t right = left + 1;
        if (right >= inputWidth_) {
            right = inputWidth_ - 1;
        }
        float lambda1 = source - static_cast<float>(left);

        auto leftLocal = tbufLeft_.template Get<T>();
        auto rightLocal = tbufRight_.template Get<T>();
        auto outputLocal = tbufOutput_.template Get<T>();
        LoadScalar(leftLocal, inputGm_, plane * inputWidth_ + left);
        LoadScalar(rightLocal, inputGm_, plane * inputWidth_ + right);
        AscendC::PipeBarrier<PIPE_ALL>();
        LinearInterpScalar<T>(outputLocal, leftLocal, rightLocal, lambda1);
        AscendC::PipeBarrier<PIPE_ALL>();
        StoreScalar(outputGm_, linear, outputLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufLeft_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRight_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    int64_t totalOutputs_ = 0;
    int64_t blockLength_ = 0;
    int64_t inputWidth_ = 0;
    int64_t outputWidth_ = 0;
    bool alignCorners_ = false;
    float sourceScale_ = 1.0f;
};

template <typename T>
__global__ __aicore__ __vector__ void upsample_linear1d_kernel(
    GM_ADDR input, GM_ADDR output,
    int64_t totalOutputs, int64_t blockLength,
    int64_t inputWidth, int64_t outputWidth,
    bool alignCorners, float sourceScale)
{
    KernelUpsampleLinear1d<T> op;
    op.Init(input, output, totalOutputs, blockLength, inputWidth, outputWidth,
            alignCorners, sourceScale);
    op.Process();
}

torch::Tensor upsample_linear1d_npu(
    const torch::Tensor &input, int64_t outputSize, bool alignCorners, double scale)
{
    check_common(input, outputSize, alignCorners, scale);
    const c10::OptionalDeviceGuard guard(input.device());

    auto inputC = input.contiguous();
    auto output = torch::empty({inputC.size(0), inputC.size(1), outputSize}, inputC.options());

    int64_t totalOutputs = output.numel();
    int64_t numBlocks = calc_block_count(totalOutputs);
    int64_t blockLength = (totalOutputs + numBlocks - 1) / numBlocks;
    int64_t inputWidth = inputC.size(2);
    float sourceScale = 0.0f;
    if (alignCorners) {
        sourceScale = (outputSize > 1)
            ? static_cast<float>(inputWidth - 1) / static_cast<float>(outputSize - 1)
            : 0.0f;
    } else {
        sourceScale = (scale > 0.0)
            ? (1.0f / static_cast<float>(scale))
            : (static_cast<float>(inputWidth) / static_cast<float>(outputSize));
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            inputC.scalar_type(), "upsample_linear1d_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                upsample_linear1d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, outputPtr, totalOutputs, blockLength, inputWidth, outputSize,
                    alignCorners, sourceScale);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                upsample_linear1d_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    inputPtr, outputPtr, totalOutputs, blockLength, inputWidth, outputSize,
                    alignCorners, sourceScale);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("UpsampleLinear1d", acl_call);

    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("upsample_linear1d", upsample_linear1d_npu);
}

} // namespace UpsampleLinear1d
} // namespace ops_multimodal_fusion
