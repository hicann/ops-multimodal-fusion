#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <cstdint>

namespace ops_multimodal_fusion { namespace SparseMaskProjection {

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m) { m.def("sparse_mask_projection(Tensor sparse_indices, Tensor sparse_values, Tensor mask_indices) -> Tensor"); }

torch::Tensor meta(const torch::Tensor &si, const torch::Tensor &sv, const torch::Tensor &mi) {
    TORCH_CHECK(si.dim()==1&&sv.dim()==1&&mi.dim()==1);
    TORCH_CHECK(si.scalar_type()==torch::kInt32&&mi.scalar_type()==torch::kInt32);
    TORCH_CHECK(si.numel()==sv.numel());
    TORCH_CHECK(sv.scalar_type()==torch::kFloat32||sv.scalar_type()==torch::kFloat16);
    return torch::zeros({mi.numel()}, sv.options());
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m) { m.impl("sparse_mask_projection", meta); }

/* ── Layer 1: __simd_vf__ — vectorized zero-fill of outBuf ──────────────── */

__simd_vf__ inline void ZeroOutVf(__ubuf__ float *outAddr,
                                    uint32_t elementCount,
                                    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::Duplicate<float>(zeroReg, 0.0f);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, zeroReg, mask);
    }
}

/* ── Layer 2: __aicore__ wrapper ────────────────────────────────────────── */

__aicore__ inline void ZeroOut(AscendC::LocalTensor<float> &out, uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ float *outPtr = (__ubuf__ float *)out.GetPhyAddr();
    asc_vf_call<ZeroOutVf>(outPtr, elementCount, chunkCount);
}

/* ── Layer 3: Kernel — GM↔UB pipeline + Layer 2 zero-fill + scalar merge-join ── */

class Kernel {
public:
    __aicore__ inline Kernel() {}

    __aicore__ inline void Init(GM_ADDR si, GM_ADDR sv, GM_ADDR mi, GM_ADDR o,
                                 int64_t spLen, int64_t maskLen)
    {
        siGm_.SetGlobalBuffer((__gm__ int32_t*)si);
        svGm_.SetGlobalBuffer((__gm__ float*)sv);
        miGm_.SetGlobalBuffer((__gm__ int32_t*)mi);
        outGm_.SetGlobalBuffer((__gm__ float*)o);
        spLen_ = spLen; maskLen_ = maskLen;
        pipe_.InitBuffer(tbufSi_, static_cast<uint32_t>(spLen * sizeof(int32_t)));
        pipe_.InitBuffer(tbufSv_, static_cast<uint32_t>(spLen * sizeof(float)));
        pipe_.InitBuffer(tbufMi_, static_cast<uint32_t>(maskLen * sizeof(int32_t)));
        pipe_.InitBuffer(tbufOut_, static_cast<uint32_t>(maskLen * sizeof(float)));
    }

    __aicore__ inline void Process()
    {
        if (AscendC::GetBlockIdx() != 0 || maskLen_ <= 0) return;

        AscendC::LocalTensor<int32_t> siLocal = tbufSi_.Get<int32_t>();
        AscendC::LocalTensor<float> svLocal = tbufSv_.Get<float>();
        AscendC::LocalTensor<int32_t> miLocal = tbufMi_.Get<int32_t>();
        AscendC::LocalTensor<float> outLocal = tbufOut_.Get<float>();

        AscendC::DataCopyExtParams cf; cf.blockCount=1; cf.srcStride=0; cf.dstStride=0;
        AscendC::DataCopyPadExtParams<int32_t> pi{false,0,0,0};
        AscendC::DataCopyPadExtParams<float> pf{false,0,0,0.0f};

        // GM → UB (vectorized DMA)
        if (spLen_ > 0) {
            cf.blockLen = static_cast<uint32_t>(spLen_ * sizeof(int32_t));
            AscendC::DataCopyPad(siLocal, siGm_, cf, pi);
            cf.blockLen = static_cast<uint32_t>(spLen_ * sizeof(float));
            AscendC::DataCopyPad(svLocal, svGm_, cf, pf);
        }
        cf.blockLen = static_cast<uint32_t>(maskLen_ * sizeof(int32_t));
        AscendC::DataCopyPad(miLocal, miGm_, cf, pi);
        AscendC::PipeBarrier<PIPE_ALL>();

        // Layer 2: vectorized zero-fill of outBuf (unmatched lanes stay 0)
        ZeroOut(outLocal, static_cast<uint32_t>(maskLen_));
        AscendC::PipeBarrier<PIPE_ALL>();

        // Scalar merge-join walk (sequential: dual-pointer advance depends on
        // previous comparison result; cannot vectorize).
        int64_t sp = 0;
        for (int64_t k = 0; k < maskLen_; ++k) {
            int32_t mIdx = miLocal.GetValue(k);
            float val = 0.0f;
            while (sp < spLen_) {
                int32_t sIdx = siLocal.GetValue(sp);
                if (sIdx == mIdx) {
                    val = svLocal.GetValue(sp);
                    ++sp;
                    break;
                } else if (sIdx > mIdx) {
                    break;
                }
                ++sp;
            }
            // Write matched value into outLocal[k]; unmatched lanes stay 0
            // from the Layer 2 zero-fill.
            if (val != 0.0f) {
                outLocal.SetValue(k, val);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        // UB → GM (vectorized DMA)
        cf.blockLen = static_cast<uint32_t>(maskLen_ * sizeof(float));
        AscendC::DataCopyPad(outGm_, outLocal, cf);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<int32_t> siGm_, miGm_;
    AscendC::GlobalTensor<float> svGm_, outGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSi_, tbufSv_, tbufMi_, tbufOut_;
    int64_t spLen_ = 0, maskLen_ = 0;
};

__global__ __aicore__ __vector__ void proj_kernel(GM_ADDR si, GM_ADDR sv, GM_ADDR mi, GM_ADDR o, int64_t sl, int64_t ml) {
    Kernel op; op.Init(si, sv, mi, o, sl, ml); op.Process();
}

/* ── Layer 4: host npu() ────────────────────────────────────────────────── */

static void check_ub_capacity(int64_t spLen, int64_t maskLen)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    auto align32 = [](int64_t bytes) { return ((bytes + 31) / 32) * 32; };
    int64_t need = align32(spLen * sizeof(int32_t)) +
                   align32(spLen * sizeof(float)) +
                   align32(maskLen * sizeof(int32_t)) +
                   align32(maskLen * sizeof(float)) +
                   8192;
    TORCH_CHECK(static_cast<uint64_t>(need) <= ubSize,
                "sparse_mask_projection: UB working set ", need,
                " bytes exceeds UB ", ubSize,
                "; this first version requires sparse_indices/sparse_values/"
                "mask_indices/output to fit in UB");
}

torch::Tensor npu(const torch::Tensor &si, const torch::Tensor &sv, const torch::Tensor &mi)
{
    auto out = meta(si, sv, mi);
    if (out.numel() == 0) return out;
    const c10::OptionalDeviceGuard g(si.device());
    auto sic = si.contiguous().to(torch::kInt32);
    auto mic = mi.contiguous().to(torch::kInt32);
    int64_t sl = sic.numel(), ml = mic.numel();

    // fp16: cast values to fp32, project, cast back
    if (sv.scalar_type() == torch::kFloat16) {
        auto sv32 = sv.to(torch::kFloat32);
        check_ub_capacity(sl, ml);
        auto out32 = torch::zeros({ml}, torch::dtype(torch::kFloat32).device(si.device()));
        auto stream = c10_npu::getCurrentNPUStream().stream(false);
        auto siP=(GM_ADDR)sic.data_ptr(), svP=(GM_ADDR)sv32.data_ptr();
        auto miP=(GM_ADDR)mic.data_ptr(), oP=(GM_ADDR)out32.data_ptr();
        auto a=[=]()->int{ proj_kernel<<<1,nullptr,stream>>>(siP,svP,miP,oP,sl,ml); return 0; };
        at_npu::native::OpCommand::RunOpApi("SparseMaskProjection", a);
        return out32.to(torch::kFloat16);
    }

    // fp32: native
    check_ub_capacity(sl, ml);
    auto svc = sv.contiguous();
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto siP=(GM_ADDR)sic.data_ptr(), svP=(GM_ADDR)svc.data_ptr();
    auto miP=(GM_ADDR)mic.data_ptr(), oP=(GM_ADDR)out.data_ptr();
    auto a=[=]()->int{ proj_kernel<<<1,nullptr,stream>>>(siP,svP,miP,oP,sl,ml); return 0; };
    at_npu::native::OpCommand::RunOpApi("SparseMaskProjection", a);
    return out;
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m) { m.impl("sparse_mask_projection", npu); }

} }
