/*!
 * \file logndtr.asc
 * \brief LogNdtr (log of standard normal CDF) operator for Ascend NPU
 *
 * y = ln Φ(x), where Φ is the standard normal CDF.
 *
 * Piecewise strategy (matches torch.special.log_ndtr):
 *   x > -5:   y = ln(0.5 * erfc(-x/√2))
 *             erfc approximation via Abramowitz & Stegun 7.1.26
 *             (max absolute error ~1.5e-7 — well within float32 precision)
 *   x ≤ -5:   asymptotic expansion
 *             y = -x²/2 - 0.5*ln(2π) - ln(-x) + ln(1 - 1/x² + 3/x⁴ - 15/x⁶)
 *
 * The branch select uses a hard step (Relu-based, 1e-6 wide transition).
 * Both formulas agree to float32 precision in the transition window,
 * so the blend is numerically clean.
 *
 * The sign of x is also handled via a Relu-based mask, since for x > 0
 * we need 0.5 * erfc(-x/√2) = 1 - 0.5 * erfc(x/√2).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace LogNdtr {

// 1. Register the operator's schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("logndtr(Tensor x) -> Tensor");
}

// 2. Meta function
torch::Tensor logndtr_meta(const torch::Tensor &x)
{
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("logndtr", logndtr_meta);
}

// 3. Tiling parameter calculation
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 2 queues * PIPELINE_DEPTH + 5 TBuf scratch = 9 tile-sized buffers
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 2 + 5;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // 32B aligned
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// 4. Kernel implementation
class KernelLogNdtr {
public:
    __aicore__ inline KernelLogNdtr() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueX_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tbuf1_, tileSize);
        pipe_.InitBuffer(tbuf2_, tileSize);
        pipe_.InitBuffer(tbuf3_, tileSize);
        pipe_.InitBuffer(tbuf4_, tileSize);
        pipe_.InitBuffer(tbuf5_, tileSize);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        elementNumPerTile_ = tileSize / sizeof(float);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        // Abramowitz & Stegun 7.1.26 coefficients for erfc(z), z ≥ 0.
        const float P_COEF = 0.3275911f;
        const float A1 = 0.254829592f;
        const float A2 = -0.284496736f;
        const float A3 = 1.421413741f;
        const float A4 = -1.453152027f;
        const float A5 = 1.061405429f;
        const float INV_SQRT2 = 0.70710678118654752f;
        const float HALF_LN_2PI = 0.91893853320467274f;
        const float THRESHOLD = -5.0f;
        const float STEP_SHARPNESS = 1.0e6f;
        const float SIGN_EPS = 1.0e-30f;
        const float P_FLOOR = 1.0e-30f; // floors log input in main branch

        AscendC::LocalTensor<float> xLocal = inQueueX_.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQueueY_.AllocTensor<float>();
        auto s1 = tbuf1_.Get<float>();
        auto s2 = tbuf2_.Get<float>();
        auto s3 = tbuf3_.Get<float>();
        auto s4 = tbuf4_.Get<float>();
        auto s5 = tbuf5_.Get<float>();

        // ---- Common: s1 = |x|,  s2 = x² ----
        AscendC::Abs(s1, xLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s2, xLocal, xLocal, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Main branch: A&S erfc(|x|/√2) ----
        // s3 = w = |x|/√2
        AscendC::Muls(s3, s1, INV_SQRT2, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s4 = 1 + P_COEF * w  (denominator of t)
        AscendC::Muls(s4, s3, P_COEF, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s4, s4, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s4 = t = 1 / (1 + p*w)    (via Div with a Duplicated ones tensor in s5)
        AscendC::Duplicate(s5, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(s4, s5, s4, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s3 = poly = t*(a1 + t*(a2 + t*(a3 + t*(a4 + t*a5))))  (Horner, outer factor of t)
        AscendC::Muls(s3, s4, A5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s3, s3, A4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s3, s3, s4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s3, s3, A3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s3, s3, s4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s3, s3, A2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s3, s3, s4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s3, s3, A1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s3, s3, s4, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s4 = exp(-x²/2)
        AscendC::Muls(s4, s2, -0.5f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(s4, s4, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s3 = E = 0.5 * erfc(|x|/√2) = 0.5 * poly * exp(-x²/2)
        AscendC::Mul(s3, s3, s4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(s3, s3, 0.5f, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Lift E to P = 0.5 * erfc(-x/√2) via sign-of-x mask ----
        // pos_mask = Relu( x / (|x| + eps) ) ∈ {0, 1}
        AscendC::Adds(s4, s1, SIGN_EPS, count);        // |x| + eps
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(s4, xLocal, s4, count);           // x / (|x|+eps) ∈ [-1, 1]
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(s4, s4, count);                  // pos_mask
        AscendC::PipeBarrier<PIPE_V>();

        // P = E + pos_mask - 2*E*pos_mask (equivalent to x≤0: E, x>0: 1-E)
        AscendC::Mul(s5, s3, s4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(s5, s5, -2.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(s3, s3, s5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(s3, s3, s4, count);               // s3 = P
        AscendC::PipeBarrier<PIPE_V>();

        // P_safe = max(P, P_FLOOR) = P + Relu(P_FLOOR - P)
        AscendC::Muls(s5, s3, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s5, s5, P_FLOOR, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(s5, s5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(s3, s3, s5, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s3 = y_main = log(P_safe)
        AscendC::Ln(s3, s3, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Asymptotic branch: x ≤ -5 ----
        // ax = max(|x|, 5) = 5 + Relu(|x| - 5)
        AscendC::Adds(s4, s1, -5.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(s4, s4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s1, s4, 5.0f, count);            // s1 = ax  (|x| no longer needed)
        AscendC::PipeBarrier<PIPE_V>();

        // s4 = ax²
        AscendC::Mul(s4, s1, s1, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s5 = u = 1 / ax²  (via Div with a Duplicated ones tensor in s2; x² no longer needed)
        AscendC::Duplicate(s2, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(s5, s2, s4, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s2 = series = 1 + u*(-1 + u*(3 + u*(-15)))
        AscendC::Muls(s2, s5, -15.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s2, s2, 3.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s2, s2, s5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s2, s2, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s2, s2, s5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s2, s2, 1.0f, count);            // s2 = series
        AscendC::PipeBarrier<PIPE_V>();

        // s2 = log(series);  s1 = log(ax)
        AscendC::Ln(s2, s2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Ln(s1, s1, count);
        AscendC::PipeBarrier<PIPE_V>();

        // s4 = y_asymp = -ax²/2 - HALF_LN_2PI - log(ax) + log(series)
        AscendC::Muls(s4, s4, -0.5f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s4, s4, -HALF_LN_2PI, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(s4, s4, s1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(s4, s4, s2, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Hard step: step = 1 iff x > THRESHOLD ----
        // step = clamp((x - THRESHOLD) * SHARPNESS, 0, 1) via two Relus.
        AscendC::Adds(s1, xLocal, -THRESHOLD, count);   // delta = x + 5
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(s1, s1, STEP_SHARPNESS, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(s1, s1, count);                   // ≥ 0
        AscendC::PipeBarrier<PIPE_V>();
        // s2 = 1 - Relu(1 - s1)  (upper clamp at 1)
        AscendC::Muls(s2, s1, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s2, s2, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(s2, s2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(s2, s2, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(s2, s2, 1.0f, count);             // s2 = step
        AscendC::PipeBarrier<PIPE_V>();

        // y = y_asymp + step * (y_main - y_asymp)
        AscendC::Sub(s3, s3, s4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(s3, s3, s2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(yLocal, s4, s3, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<float> yLocal = outQueueY_.DeQue<float>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf3_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf4_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf5_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

__global__ __aicore__ __vector__ void logndtr_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelLogNdtr op;
    op.Init(x, y, totalLength, blockLength, tileSize);
    op.Process();
}

// 5. NPU dispatch
torch::Tensor logndtr_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto y = logndtr_meta(x);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t totalLength = x.numel();
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "logndtr_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                logndtr_kernel<<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileSize);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("LogNdtr", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("logndtr", logndtr_npu);
}

} // namespace LogNdtr
} // namespace ops_multimodal_fusion
