/*!
 * \file frexp.asc
 * \brief Frexp (IEEE-754 mantissa / exponent split) operator for Ascend NPU (dav-3510)
 *
 * torch.frexp(x) -> (mantissa, exponent)  such that
 *     x = mantissa * 2^exponent
 *     mantissa in (-1, -0.5] U {0} U [0.5, 1)
 *     exponent is int32 (PyTorch convention)
 *
 * Scope (per issue #11): float32 and float16 inputs on dav-3510. The schema
 * declares named return fields so `r = ops_multimodal_fusion.frexp(x); r.mantissa, r.exponent`
 * work the same way as upstream `torch.frexp` does.
 *
 * Algorithm. The exponent is read EXACTLY from the IEEE-754 bit pattern (no
 * Ln, so no rounding error at exact powers of two); the mantissa is rebuilt in
 * fp32 from that exact exponent using an EXACT bit-built 2^(-e) (no Exp, so no
 * rounding error at exact powers of two either). All vector math runs in fp32
 * internally (the scratch buffers are fp32 regardless of dtype): a float16 input
 * is promoted to fp32 once at the top and the mantissa rounded back to fp16
 * exactly once at the bottom. A genuine fp16 significand is itself an exact fp16
 * value, so the single final cast recovers it exactly instead of drifting.
 *
 * Exponent (exact, bit-based):
 *   For a finite normal fp32 value, the biased exponent field is bits 23..30.
 *   We isolate it WITHOUT a right-shift primitive (dav-3510's classic vector API
 *   exposes ReinterpretCast / And / Or / int-Muls but no vector right shift):
 *     expoBits = ReinterpretCast<int32>(x) & 0x7F800000   (== biased * 2^23)
 *   expoBits is always a multiple of 2^23 with biased in [0, 255], so it is an
 *   exact-castable int32 (biased fits 8 bits times a power of two). Then
 *     biased = float(expoBits) * 2^-23   (exact),   e = biased - 126.
 *   This equals torch.frexp's exponent at every finite normal input, including
 *   exact powers of two where the old Ln/floor path landed one bucket off.
 *
 * Mantissa:
 *   m_try = x * 2^(-e), in fp32, where 2^(-e) is built EXACTLY from the integer
 *   exponent via the same IEEE-754 bit construction exp2 uses for 2^n:
 *        2^(-e) = reinterpret_float( (-e + 127) << 23 )
 *   (the << 23 is an int32 Muls by 2^23, no native shift on dav-3510). Because
 *   both e and 2^(-e) are now EXACT, at an exact power of two x = 2^k the
 *   mantissa is PRECISELY 0.5 (not 0.5 +/- a few Exp ULP), so the off-by-one
 *   boundary correction no longer misfires. The branchless stepUp clamp remains
 *   as a strict guard for the canonical [0.5, 1) form; no stepDown / deadband
 *   is needed because the exact scale never produces |m_try| < 0.5:
 *        up = 1 iff |m_try| >= 1.0     -> e += 1, m *= 0.5
 *   Zero mask: x == 0 -> (mantissa=0, exponent=0).
 *
 * Step functions are branchless via Relu + Mins so the kernel stays fully
 * vectorised (no scalar GetValue / SetValue). Bit ops (ReinterpretCast / And)
 * and int-Muls are the same primitives copysign / nextafter / leftshift use.
 *
 * Non-finite inputs (+/-inf, NaN) are outside the declared scope; the
 * ln/exp path produces undefined values for them and tests exclude them.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Frexp {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    // Named return fields match upstream torch.frexp's named-tuple interface.
    m.def("frexp(Tensor x) -> (Tensor mantissa, Tensor exponent)");
}

// ===================== 2. Meta =====================

std::tuple<torch::Tensor, torch::Tensor> frexp_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "frexp: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());
    auto mantissa = torch::empty_like(x);
    auto exponent = torch::empty_like(x, x.options().dtype(torch::kInt32));
    return std::make_tuple(mantissa, exponent);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("frexp", frexp_meta);
}

// ===================== 3. Tiling =====================

// Returns (numBlocks, blockLength, elementsPerTile).
// `elementsPerTile` is the number of *input elements* per tile (not bytes);
// each buffer is sized from it with its own sizeof(type), which lets the
// int32 exponent queue differ from the T mantissa queue under fp16.
static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t totalLength, size_t bytesPerT)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;

    // Per-element UB cost across all live allocations.  All vector math runs in
    // fp32 internally, so the six scratch TBufs are fp32 (4 bytes) regardless of T:
    //   inQueueX  (T)     * PIPELINE_DEPTH  = 2 * bytesPerT
    //   outQueueM (T)     * PIPELINE_DEPTH  = 2 * bytesPerT
    //   outQueueE (int32) * PIPELINE_DEPTH  = 2 * sizeof(int32_t) = 8
    //   7 scratch TBufs (fp32: xf, mf, ef, nz, A, B, expoMask) = 7 * sizeof(float) = 28
    // Total bytes per input element:
    const int64_t bytesPerElement =
        PIPELINE_DEPTH * static_cast<int64_t>(bytesPerT)
      + PIPELINE_DEPTH * static_cast<int64_t>(bytesPerT)
      + PIPELINE_DEPTH * static_cast<int64_t>(sizeof(int32_t))
      + 7 * static_cast<int64_t>(sizeof(float));

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;

    int64_t elementsPerTile = static_cast<int64_t>(ubSize) / bytesPerElement;
    // Align to 32 elements so that every per-buffer byte size (bytesPerT * N
    // or 4 * N, both divisible by 32) stays 32-byte aligned for DMA.
    elementsPerTile = (elementsPerTile / 32) * 32;
    if (elementsPerTile < 32) {
        elementsPerTile = 32;
    }
    return std::make_tuple(numBlocks, blockLength, elementsPerTile);
}

// ===================== 4. Kernel =====================

template <typename T>
class KernelFrexp {
public:
    __aicore__ inline KernelFrexp() {}

    static constexpr bool kIsFloat = std::is_same<T, float>::value;

    static __aicore__ inline uint32_t f32Bytes(uint32_t elements)
    {
        return elements * static_cast<uint32_t>(sizeof(float));
    }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR m, GM_ADDR e,
        int64_t totalLength, int64_t blockLength, uint32_t elementsPerTile)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockLength * AscendC::GetBlockIdx());
        mGm_.SetGlobalBuffer((__gm__ T *)m + blockLength * AscendC::GetBlockIdx());
        eGm_.SetGlobalBuffer((__gm__ int32_t *)e + blockLength * AscendC::GetBlockIdx());

        const uint32_t tBytes   = elementsPerTile * sizeof(T);
        const uint32_t i32Bytes = elementsPerTile * sizeof(int32_t);
        // All vector arithmetic runs in fp32 internally (even when T == half) so
        // the mantissa scale `x * 2^(-e)` carries full fp32 precision and is only
        // rounded to fp16 once, at the very end. The scratch buffers (xf, mf,
        // ef, nz, A, B, expoMask) are all 4-byte (fp32 work / int32 mask).
        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tBytes);     // T (raw input tile)
        pipe_.InitBuffer(outQueueM_, PIPELINE_DEPTH, tBytes);     // T (mantissa out)
        pipe_.InitBuffer(outQueueE_, PIPELINE_DEPTH, i32Bytes);   // int32 (exponent out)
        pipe_.InitBuffer(tbufXf_,    f32Bytes(elementsPerTile));  // x promoted to fp32
        pipe_.InitBuffer(tbufMf_,    f32Bytes(elementsPerTile));  // mantissa in fp32
        pipe_.InitBuffer(tbufEf_,    f32Bytes(elementsPerTile));  // e held as fp32
        pipe_.InitBuffer(tbufNz_,    f32Bytes(elementsPerTile));  // non-zero flag (fp32)
        pipe_.InitBuffer(tbufA_,     f32Bytes(elementsPerTile));  // scratch A (fp32)
        pipe_.InitBuffer(tbufB_,     f32Bytes(elementsPerTile));  // scratch B (fp32)
        pipe_.InitBuffer(tbufExpoMask_, f32Bytes(elementsPerTile)); // const int32 0x7F800000

        // Populate the IEEE-754 exponent-field mask once; reused for every tile.
        AscendC::LocalTensor<int32_t> expoMask = tbufExpoMask_.Get<int32_t>();
        AscendC::Duplicate(expoMask, static_cast<int32_t>(0x7F800000), elementsPerTile);
        AscendC::PipeBarrier<PIPE_V>();

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = elementsPerTile;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        // Every vector op below is fp32 (the scratch buffers are all fp32),
        // regardless of T.  For T == half the input is promoted to fp32 once
        // at the top and the mantissa is rounded back to fp16 exactly once at
        // the bottom, so the [0.5, 1) mantissa carries full fp32 precision
        // instead of accumulating fp16 rounding.
        //   TWO_POW_NEG23: 2^-23, scales the isolated exponent field to the
        //                  integer biased exponent (exact).
        //   TWO_POW_23:    2^23, an int32 Muls by it == a left-shift by 23, used
        //                  to pack the biased field for the EXACT 2^(-e) build.
        //   BIG_SCALE/TINY_SCALE: saturation multipliers for {0,1} flags (fp32).
        const float TWO_POW_NEG23 = 1.1920928955078125e-7f;    // 2^-23
        const float TWO_POW_23    = 8388608.0f;                // 2^23, int Muls == << 23
        const float BIG_SCALE     = 1.0e10f;
        const float TINY_SCALE    = 1.0e18f;

        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> mLocal = outQueueM_.AllocTensor<T>();
        AscendC::LocalTensor<int32_t> eLocal = outQueueE_.AllocTensor<int32_t>();
        auto xFloat  = tbufXf_.Get<float>();   // x promoted to fp32
        auto mFloat  = tbufMf_.Get<float>();   // mantissa accumulated in fp32
        auto eFloat  = tbufEf_.Get<float>();   // exponent held as fp32
        auto nzFlag  = tbufNz_.Get<float>();   // non-zero flag
        auto bufA    = tbufA_.Get<float>();
        auto bufB    = tbufB_.Get<float>();

        // ---- Step 0: bring the input tile into the fp32 work buffer ----
        //   fp32: element-wise `+0` copy (exact for finite x, arbitrary count,
        //   no DMA alignment constraint); fp16: widening Cast.
        if constexpr (kIsFloat) {
            AscendC::Adds(xFloat, xLocal, 0.0f, count);
        } else {
            AscendC::Cast(xFloat, xLocal, AscendC::RoundMode::CAST_NONE, count);
        }
        AscendC::PipeBarrier<PIPE_V>();
        inQueueX_.FreeTensor(xLocal);

        // ---- Step 1: abs_x -> bufA ----
        AscendC::Abs(bufA, xFloat, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Step 2: non-zero flag (staged saturation) ----
        //   nzFlag = 1 if |x| > 0 else 0.  Repeated `* TINY_SCALE` with a
        //   `Mins(., 1)` between rounds saturates any positive value to 1
        //   while pinning exact 0 to 0.
        AscendC::Muls(nzFlag, bufA, TINY_SCALE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mins(nzFlag, nzFlag, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(nzFlag, nzFlag, TINY_SCALE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mins(nzFlag, nzFlag, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(nzFlag, nzFlag, TINY_SCALE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mins(nzFlag, nzFlag, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Steps 3-5: EXACT exponent from IEEE-754 bits (no Ln) ----
        //   expoBits = bits(x) & 0x7F800000 = biased * 2^23, biased in [0, 255].
        //   biased   = float(expoBits) * 2^-23   (exact: biased fits 8 bits).
        //   e        = biased - 126              (== torch.frexp exponent).
        // No right-shift primitive needed: the AND isolates the field and a
        // float multiply by 2^-23 reads off the integer biased exponent.  This
        // is exact at every finite normal input — in particular at exact powers
        // of two, where the old Ln/floor path could land one bucket off.
        // Subnormals (|x| < 2^-126, biased == 0) map to e = -126, matching the
        // previous TINY_POSITIVE-floored behaviour; they are outside scope.
        AscendC::LocalTensor<int32_t> xBits    = xFloat.ReinterpretCast<int32_t>();
        AscendC::LocalTensor<int32_t> expoMask = tbufExpoMask_.Get<int32_t>();
        AscendC::LocalTensor<int32_t> eBits    = eLocal;  // int32 scratch (= expoBits)
        AscendC::And(eBits, xBits, expoMask, count);       // eBits = biased * 2^23
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(eFloat, eBits, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(eFloat, eFloat, TWO_POW_NEG23, count);  // -> biased (exact)
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(eFloat, eFloat, -126.0f, count);        // -> exponent
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Step 6: scale = 2^(-e), built EXACTLY from the integer exponent ----
        //   Mirrors exp2's 2^n bit construction (no Exp, so no rounding):
        //     2^(-e) = reinterpret_float( (-e + 127) << 23 ),  << 23 == int Muls 2^23.
        //   e is an exact integer in fp32 here, so casting it to int32 is exact.
        //   For the test range e in [-126, 128] => (-e + 127) in [-1, 253], a valid
        //   biased exponent field (the ends map to 0 / +inf, matching IEEE). This
        //   makes m_try = x * 2^(-e) PRECISELY 0.5 at x = 2^k (no Exp ULP noise).
        //   scaleBits
        //   aliases bufA's memory, so after the int32 packing bufA (read as fp32)
        //   already holds 2^(-e) — no extra reinterpret copy needed.
        AscendC::LocalTensor<int32_t> scaleBits = bufA.ReinterpretCast<int32_t>();
        AscendC::Cast(scaleBits, eFloat, AscendC::RoundMode::CAST_RINT, count);   // e (int32)
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(scaleBits, scaleBits, static_cast<int32_t>(-1), count);     // -e
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(scaleBits, scaleBits, static_cast<int32_t>(127), count);    // -e + 127
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(scaleBits, scaleBits, static_cast<int32_t>(TWO_POW_23), count); // << 23
        AscendC::PipeBarrier<PIPE_V>();
        // bufA (read as fp32) now holds 2^(-e), exact.

        // ---- Step 7: m_try = x * scale -> mFloat (fp32) ----
        AscendC::Mul(mFloat, xFloat, bufA, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Step 8: stepUp = 1 iff |m_try| >= 1.0 -> bufB ----
        //   With the EXACT bit-built 2^(-e), m_try = 1.f * 0.5 lands strictly in
        //   [0.5, 1) for every finite normal input, so this is a pure guard that
        //   never fires in practice (it would only act on a hypothetical |m_try|
        //   rounding up to exactly 1.0). Kept branchless to preserve the canonical
        //   [0.5, 1) invariant without a scalar branch.
        //   d = |m_try| - 1.0;  stepUp = min(relu(d * BIG_SCALE), 1)
        AscendC::Abs(bufA, mFloat, count);                 // |m_try|
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(bufB, bufA, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(bufB, bufB, BIG_SCALE, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(bufB, bufB, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mins(bufB, bufB, 1.0f, count);             // stepUp in {0, 1}
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Step 9: apply stepUp:  m *= (1 - 0.5*stepUp);  e += stepUp ----
        AscendC::Muls(bufA, bufB, -0.5f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(bufA, bufA, 1.0f, count);             // factor
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(mFloat, mFloat, bufA, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(eFloat, eFloat, bufB, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Step 10: zero mask — force e = 0 where x == 0 (m is already 0) ----
        AscendC::Mul(eFloat, eFloat, nzFlag, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Step 11: bring the fp32 mantissa into the T output buffer ----
        //   fp32: element-wise `+0` copy; fp16: a single narrowing Cast (round-
        //   to-nearest). For a genuine fp16 input the canonical significand is
        //   already an exact fp16 value, so this final cast is exact and cannot
        //   round up to 1.0 — the [0.5, 1) invariant is preserved.
        if constexpr (kIsFloat) {
            AscendC::Adds(mLocal, mFloat, 0.0f, count);
        } else {
            AscendC::Cast(mLocal, mFloat, AscendC::RoundMode::CAST_NONE, count);
        }
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Step 12: cast exponent back to int32 ----
        AscendC::Cast(eLocal, eFloat, AscendC::RoundMode::CAST_ROUND, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueM_.EnQue(mLocal);
        outQueueE_.EnQue(eLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> mLocal = outQueueM_.DeQue<T>();
        AscendC::LocalTensor<int32_t> eLocal = outQueueE_.DeQue<int32_t>();

        AscendC::DataCopyExtParams mParams;
        mParams.blockCount = 1;
        mParams.blockLen = count * sizeof(T);
        mParams.srcStride = 0;
        mParams.dstStride = 0;
        AscendC::DataCopyPad(mGm_[offset], mLocal, mParams);

        AscendC::DataCopyExtParams eParams;
        eParams.blockCount = 1;
        eParams.blockLen = count * sizeof(int32_t);
        eParams.srcStride = 0;
        eParams.dstStride = 0;
        AscendC::DataCopyPad(eGm_[offset], eLocal, eParams);

        outQueueM_.FreeTensor(mLocal);
        outQueueE_.FreeTensor(eLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, mGm_;
    AscendC::GlobalTensor<int32_t> eGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueM_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueE_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufMf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufEf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufNz_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufB_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufExpoMask_;  // const int32 0x7F800000
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void frexp_kernel(
    GM_ADDR x, GM_ADDR m, GM_ADDR e,
    int64_t totalLength, int64_t blockLength, uint32_t elementsPerTile)
{
    KernelFrexp<T> op;
    op.Init(x, m, e, totalLength, blockLength, elementsPerTile);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

std::tuple<torch::Tensor, torch::Tensor> frexp_npu(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "frexp: only float32 and float16 are supported on dav-3510, got ",
                x.scalar_type());

    const c10::OptionalDeviceGuard guard(x.device());
    auto input = x.contiguous();
    auto mantissa = torch::empty_like(input);
    auto exponent = torch::empty_like(input, input.options().dtype(torch::kInt32));

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return std::make_tuple(mantissa, exponent);
    }

    const size_t bytesPerT = (input.scalar_type() == torch::kFloat32) ? 4u : 2u;
    int64_t numBlocks, blockLength, elementsPerTile;
    std::tie(numBlocks, blockLength, elementsPerTile) =
        calc_tiling_params(totalLength, bytesPerT);

    auto x_ptr = (GM_ADDR)input.data_ptr();
    auto m_ptr = (GM_ADDR)mantissa.data_ptr();
    auto e_ptr = (GM_ADDR)exponent.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input.scalar_type(), "frexp_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                frexp_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, m_ptr, e_ptr,
                    totalLength, blockLength,
                    static_cast<uint32_t>(elementsPerTile));
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                frexp_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, m_ptr, e_ptr,
                    totalLength, blockLength,
                    static_cast<uint32_t>(elementsPerTile));
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Frexp", acl_call);
    return std::make_tuple(mantissa, exponent);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("frexp", frexp_npu);
}

} // namespace Frexp
} // namespace ops_multimodal_fusion
