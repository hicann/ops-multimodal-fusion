/*!
 * \file logcumsumexp.asc
 * \brief Logcumsumexp scan operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.logcumsumexp(x, dim) -> y
 *   y[..., i, ...] = log(sum(exp(x[..., 0:i+1, ...]))) along dim.
 *
 * Scope: float16 and float32. float16 uses float Reg accumulation and stores
 * back to half.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Logcumsumexp {

static constexpr int64_t kPipelineDepth = 2;
// Carry state per scan lane: M (running max), S (running scaled sum of
// exp(x - M)), and c (Neumaier/Kahan compensation for S). All in float.
static constexpr int64_t kCarryBuffers = 3;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("logcumsumexp(Tensor x, int dim) -> Tensor");
}

static int64_t normalize_dim(int64_t dim, int64_t ndim)
{
    int64_t logicalRank = (ndim == 0) ? 1 : ndim;
    if (dim < 0) {
        dim += logicalRank;
    }
    TORCH_CHECK(dim >= 0 && dim < logicalRank,
                "logcumsumexp: dim ", dim, " out of range for tensor of ndim ", ndim);
    return dim;
}

torch::Tensor logcumsumexp_meta(const torch::Tensor &x, int64_t dim)
{
    normalize_dim(dim, x.dim());
    TORCH_CHECK(x.scalar_type() == torch::kFloat16 ||
                x.scalar_type() == torch::kFloat32,
                "logcumsumexp: expected Half or Float inputs on dav-3510 Reg path, got ",
                x.scalar_type());
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("logcumsumexp", logcumsumexp_meta);
}

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t outerSize, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "logcumsumexp: coreNum must be positive.");

    int64_t numBlocks = std::min(coreNum, outerSize);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t outerPerBlock = (outerSize + numBlocks - 1) / numBlocks;

    int64_t queueBytesPerElem = kPipelineDepth * 2 * elemSize;
    // Carry state is a (M, S, c) triple held in float: running max, running
    // scaled-sum, and the Neumaier compensation term. Three float buffers per
    // lane regardless of input dtype (half accumulates in float as well).
    int64_t carryBytesPerElem = kCarryBuffers * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) /
        (queueBytesPerElem + carryBytesPerElem);
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "logcumsumexp: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, outerPerBlock, tileElems);
}

// Init (scan index d == 0): state becomes M = x, S = 1, c = 0, out = x.
// LSE of a single element is just x, so the scaled sum is exactly 1.
template <typename T>
__simd_vf__ inline void LogcumsumexpFloatInitVf(__ubuf__ T *outAddr,
                                                __ubuf__ float *maxAddr,
                                                __ubuf__ float *sumAddr,
                                                __ubuf__ float *compAddr,
                                                __ubuf__ T *xAddr,
                                                uint32_t count,
                                                uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> xReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            maxAddr + offset, xReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + offset, oneReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            compAddr + offset, zeroReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, xReg, mask);
    }
}

// Step (scan index d > 0): merge incoming x into the running state.
//
//   Mn = max(M, x)                              new running max
//   r  = exp(M  - Mn)   (rescale factor)        in [0, 1]
//   t  = exp(x  - Mn)   (incoming term)         in (0, 1]
//   S' = S * r          (rescaled running sum)
//   c' = c * r          (rescaled compensation)
//   then Neumaier-add t into S' carrying c':
//       y  = t - c'
//       u  = S' + y
//       c'' = (u - S') - y
//       S = u,  c = c''
//   out = Mn + log(S)
//
// The compensation register c recovers the low-order bits lost on each
// S' + y, which is where the long-scan fp32 drift was accumulating. The
// rescale of c by r keeps the compensation consistent when the max grows.
template <typename T>
__simd_vf__ inline void LogcumsumexpFloatStepVf(__ubuf__ T *outAddr,
                                                __ubuf__ float *maxAddr,
                                                __ubuf__ float *sumAddr,
                                                __ubuf__ float *compAddr,
                                                __ubuf__ T *xAddr,
                                                uint32_t count,
                                                uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    const float posInf = INFINITY;
    const float negInf = -INFINITY;
    const float infThreshold = 3.3e38f;
    AscendC::Reg::RegTensor<T> xReg;
    AscendC::Reg::RegTensor<float> oldMaxReg;
    AscendC::Reg::RegTensor<float> oldSumReg;
    AscendC::Reg::RegTensor<float> oldCompReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> rReg;
    AscendC::Reg::RegTensor<float> tReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> compReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> uReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::RegTensor<float> outReg;
    AscendC::Reg::RegTensor<float> specialReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg selectMask;
        AscendC::Reg::MaskReg specialMask;

        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            oldMaxReg, maxAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            oldSumReg, sumAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            oldCompReg, compAddr + offset);

        // Mn = max(M, x)
        AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(selectMask, xReg, oldMaxReg, mask);
        AscendC::Reg::Select<float>(maxReg, xReg, oldMaxReg, selectMask);

        // r = exp(M - Mn), t = exp(x - Mn)
        AscendC::Reg::Sub(rReg, oldMaxReg, maxReg, mask);
        AscendC::Reg::Exp(rReg, rReg, mask);
        AscendC::Reg::Sub(tReg, xReg, maxReg, mask);
        AscendC::Reg::Exp(tReg, tReg, mask);
        // Guard coinciding maxima (incl. +/-inf): exp(M-Mn) and exp(x-Mn) degenerate to
        // exp(inf-inf)=NaN when M==Mn or x==Mn at +/-inf; the correct factor is exp(0)=1.
        // Keeps the running sum finite through an all-(+/-inf) prefix so a later finite
        // element rescales correctly. Finite equal values already give exp(0)=1, and NaN
        // never compares equal, so the finite and NaN paths are unchanged.
        AscendC::Reg::Duplicate<float>(specialReg, 1.0f, mask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::EQ>(selectMask, oldMaxReg, maxReg, mask);
        AscendC::Reg::Select<float>(rReg, specialReg, rReg, selectMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::EQ>(selectMask, xReg, maxReg, mask);
        AscendC::Reg::Select<float>(tReg, specialReg, tReg, selectMask);

        // Rescale running sum and compensation by r.
        AscendC::Reg::Mul(sumReg, oldSumReg, rReg, mask);
        AscendC::Reg::Mul(compReg, oldCompReg, rReg, mask);

        // Neumaier-compensated add of t into sumReg with running comp.
        // y = t - c
        AscendC::Reg::Sub(yReg, tReg, compReg, mask);
        // u = S + y
        AscendC::Reg::Add(uReg, sumReg, yReg, mask);
        // c = (u - S) - y
        AscendC::Reg::Sub(tmpReg, uReg, sumReg, mask);
        AscendC::Reg::Sub(compReg, tmpReg, yReg, mask);
        // S = u
        sumReg = uReg;

        // out = Mn + log(S)
        AscendC::Reg::Ln(tmpReg, sumReg, mask);
        AscendC::Reg::Add(outReg, maxReg, tmpReg, mask);

        // Saturate very large / very small running max to +/-inf, matching the
        // original special-value handling.
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(
            specialMask, maxReg, infThreshold, mask);
        AscendC::Reg::Duplicate<float>(specialReg, posInf, mask);
        AscendC::Reg::Select<float>(outReg, specialReg, outReg, specialMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(
            specialMask, maxReg, -infThreshold, mask);
        AscendC::Reg::Duplicate<float>(specialReg, negInf, mask);
        AscendC::Reg::Select<float>(outReg, specialReg, outReg, specialMask);
        // Propagate NaN from either operand.
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, oldMaxReg, oldMaxReg, mask);
        AscendC::Reg::Select<float>(outReg, oldMaxReg, outReg, specialMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, specialMask);

        // Propagate NaN into the CARRY max as well, not just the output: otherwise a
        // NaN element (whose running max stays the prior +inf) is lost from the carry
        // and the next step emits inf instead of NaN. Storing NaN into the carry max
        // makes every subsequent step hit the oldMax-is-NaN branch above. Finite
        // inputs leave the NE masks empty, so the finite path is unchanged.
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, oldMaxReg, oldMaxReg, mask);
        AscendC::Reg::Select<float>(maxReg, oldMaxReg, maxReg, specialMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(maxReg, xReg, maxReg, specialMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            maxAddr + offset, maxReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + offset, sumReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            compAddr + offset, compReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, outReg, mask);
    }
}

__simd_vf__ inline void LogcumsumexpHalfInitVf(__ubuf__ half *outAddr,
                                               __ubuf__ float *maxAddr,
                                               __ubuf__ float *sumAddr,
                                               __ubuf__ float *compAddr,
                                               __ubuf__ half *xAddr,
                                               uint32_t count,
                                               uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<half> outHalfReg;
    AscendC::Reg::RegTensor<float> maxFloatReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(maxFloatReg, xHalfReg, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            maxAddr + offset, maxFloatReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + offset, oneReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            compAddr + offset, zeroReg, mask);
        AscendC::Reg::Cast<half, float, castToHalf>(outHalfReg, maxFloatReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            outAddr + offset, outHalfReg, mask);
    }
}

__simd_vf__ inline void LogcumsumexpHalfStepVf(__ubuf__ half *outAddr,
                                               __ubuf__ float *maxAddr,
                                               __ubuf__ float *sumAddr,
                                               __ubuf__ float *compAddr,
                                               __ubuf__ half *xAddr,
                                               uint32_t count,
                                               uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    const float posInf = INFINITY;
    const float negInf = -INFINITY;
    const float infThreshold = 3.3e38f;
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<half> outHalfReg;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> oldMaxReg;
    AscendC::Reg::RegTensor<float> oldSumReg;
    AscendC::Reg::RegTensor<float> oldCompReg;
    AscendC::Reg::RegTensor<float> maxReg;
    AscendC::Reg::RegTensor<float> rReg;
    AscendC::Reg::RegTensor<float> tReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> compReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> uReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::RegTensor<float> outReg;
    AscendC::Reg::RegTensor<float> specialReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg selectMask;
        AscendC::Reg::MaskReg specialMask;

        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            oldMaxReg, maxAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            oldSumReg, sumAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            oldCompReg, compAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, xHalfReg, mask);

        // Mn = max(M, x)
        AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(selectMask, xReg, oldMaxReg, mask);
        AscendC::Reg::Select<float>(maxReg, xReg, oldMaxReg, selectMask);

        // r = exp(M - Mn), t = exp(x - Mn)
        AscendC::Reg::Sub(rReg, oldMaxReg, maxReg, mask);
        AscendC::Reg::Exp(rReg, rReg, mask);
        AscendC::Reg::Sub(tReg, xReg, maxReg, mask);
        AscendC::Reg::Exp(tReg, tReg, mask);
        // Guard coinciding maxima (incl. +/-inf): exp(M-Mn) and exp(x-Mn) degenerate to
        // exp(inf-inf)=NaN when M==Mn or x==Mn at +/-inf; the correct factor is exp(0)=1.
        // Keeps the running sum finite through an all-(+/-inf) prefix so a later finite
        // element rescales correctly. Finite equal values already give exp(0)=1, and NaN
        // never compares equal, so the finite and NaN paths are unchanged.
        AscendC::Reg::Duplicate<float>(specialReg, 1.0f, mask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::EQ>(selectMask, oldMaxReg, maxReg, mask);
        AscendC::Reg::Select<float>(rReg, specialReg, rReg, selectMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::EQ>(selectMask, xReg, maxReg, mask);
        AscendC::Reg::Select<float>(tReg, specialReg, tReg, selectMask);

        // Rescale running sum and compensation by r.
        AscendC::Reg::Mul(sumReg, oldSumReg, rReg, mask);
        AscendC::Reg::Mul(compReg, oldCompReg, rReg, mask);

        // Neumaier-compensated add of t into sumReg.
        AscendC::Reg::Sub(yReg, tReg, compReg, mask);
        AscendC::Reg::Add(uReg, sumReg, yReg, mask);
        AscendC::Reg::Sub(tmpReg, uReg, sumReg, mask);
        AscendC::Reg::Sub(compReg, tmpReg, yReg, mask);
        sumReg = uReg;

        // out = Mn + log(S)
        AscendC::Reg::Ln(tmpReg, sumReg, mask);
        AscendC::Reg::Add(outReg, maxReg, tmpReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(
            specialMask, maxReg, infThreshold, mask);
        AscendC::Reg::Duplicate<float>(specialReg, posInf, mask);
        AscendC::Reg::Select<float>(outReg, specialReg, outReg, specialMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(
            specialMask, maxReg, -infThreshold, mask);
        AscendC::Reg::Duplicate<float>(specialReg, negInf, mask);
        AscendC::Reg::Select<float>(outReg, specialReg, outReg, specialMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, oldMaxReg, oldMaxReg, mask);
        AscendC::Reg::Select<float>(outReg, oldMaxReg, outReg, specialMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, specialMask);

        // Propagate NaN into the CARRY max as well, not just the output: otherwise a
        // NaN element (whose running max stays the prior +inf) is lost from the carry
        // and the next step emits inf instead of NaN. Storing NaN into the carry max
        // makes every subsequent step hit the oldMax-is-NaN branch above. Finite
        // inputs leave the NE masks empty, so the finite path is unchanged.
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, oldMaxReg, oldMaxReg, mask);
        AscendC::Reg::Select<float>(maxReg, oldMaxReg, maxReg, specialMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            specialMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(maxReg, xReg, maxReg, specialMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            maxAddr + offset, maxReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + offset, sumReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            compAddr + offset, compReg, mask);
        AscendC::Reg::Cast<half, float, castToHalf>(outHalfReg, outReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            outAddr + offset, outHalfReg, mask);
    }
}

// carry holds the (M, S, c) state as three contiguous float regions of
// alignedCount each: [0, n) = M, [n, 2n) = S, [2n, 3n) = c.
template <typename T>
__aicore__ inline void LogcumsumexpFloatInit(AscendC::LocalTensor<T> &out,
                                             AscendC::LocalTensor<float> &carry,
                                             AscendC::LocalTensor<T> &x,
                                             int64_t count)
{
    __ubuf__ T *outAddr = (__ubuf__ T *)out.GetPhyAddr();
    __ubuf__ float *maxAddr = (__ubuf__ float *)carry.GetPhyAddr();
    __ubuf__ float *sumAddr = maxAddr + count;
    __ubuf__ float *compAddr = maxAddr + 2 * count;
    __ubuf__ T *xAddr = (__ubuf__ T *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LogcumsumexpFloatInitVf<T>>(
        outAddr, maxAddr, sumAddr, compAddr, xAddr, elementCount, chunkCount);
}

template <typename T>
__aicore__ inline void LogcumsumexpFloatStep(AscendC::LocalTensor<T> &out,
                                             AscendC::LocalTensor<float> &carry,
                                             AscendC::LocalTensor<T> &x,
                                             int64_t count)
{
    __ubuf__ T *outAddr = (__ubuf__ T *)out.GetPhyAddr();
    __ubuf__ float *maxAddr = (__ubuf__ float *)carry.GetPhyAddr();
    __ubuf__ float *sumAddr = maxAddr + count;
    __ubuf__ float *compAddr = maxAddr + 2 * count;
    __ubuf__ T *xAddr = (__ubuf__ T *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LogcumsumexpFloatStepVf<T>>(
        outAddr, maxAddr, sumAddr, compAddr, xAddr, elementCount, chunkCount);
}

__aicore__ inline void LogcumsumexpHalfInit(AscendC::LocalTensor<half> &out,
                                            AscendC::LocalTensor<float> &carry,
                                            AscendC::LocalTensor<half> &x,
                                            int64_t count)
{
    __ubuf__ half *outAddr = (__ubuf__ half *)out.GetPhyAddr();
    __ubuf__ float *maxAddr = (__ubuf__ float *)carry.GetPhyAddr();
    __ubuf__ float *sumAddr = maxAddr + count;
    __ubuf__ float *compAddr = maxAddr + 2 * count;
    __ubuf__ half *xAddr = (__ubuf__ half *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LogcumsumexpHalfInitVf>(
        outAddr, maxAddr, sumAddr, compAddr, xAddr, elementCount, chunkCount);
}

__aicore__ inline void LogcumsumexpHalfStep(AscendC::LocalTensor<half> &out,
                                            AscendC::LocalTensor<float> &carry,
                                            AscendC::LocalTensor<half> &x,
                                            int64_t count)
{
    __ubuf__ half *outAddr = (__ubuf__ half *)out.GetPhyAddr();
    __ubuf__ float *maxAddr = (__ubuf__ float *)carry.GetPhyAddr();
    __ubuf__ float *sumAddr = maxAddr + count;
    __ubuf__ float *compAddr = maxAddr + 2 * count;
    __ubuf__ half *xAddr = (__ubuf__ half *)x.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<LogcumsumexpHalfStepVf>(
        outAddr, maxAddr, sumAddr, compAddr, xAddr, elementCount, chunkCount);
}

template <typename T>
class KernelLogcumsumexp {
public:
    __aicore__ inline KernelLogcumsumexp() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t outerSize, int64_t dimSize, int64_t innerSize,
        int64_t outerPerBlock, uint32_t tileElems)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        yGm_.SetGlobalBuffer((__gm__ T *)y);
        outerSize_ = outerSize;
        dimSize_ = dimSize;
        innerSize_ = innerSize;
        outerStart_ = AscendC::GetBlockIdx() * outerPerBlock;
        outerCount_ = outerSize - outerStart_;
        if (outerCount_ > outerPerBlock) {
            outerCount_ = outerPerBlock;
        }
        if (outerCount_ < 0) {
            outerCount_ = 0;
        }
        tileElems_ = tileElems;
        pipe_.InitBuffer(inQueue_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueue_, kPipelineDepth, tileElems * sizeof(T));
        // Carry holds the (M, S, c) triple as three contiguous float regions of
        // tileElems each (aligned to 32B for both float and half input).
        pipe_.InitBuffer(tbufCarryFloat_, kCarryBuffers * tileElems * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int64_t o = 0; o < outerCount_; ++o) {
            int64_t outer = outerStart_ + o;
            for (int64_t inner = 0; inner < innerSize_; inner += tileElems_) {
                int64_t count = innerSize_ - inner;
                if (count > tileElems_) {
                    count = tileElems_;
                }
                ProcessTile(outer, inner, count);
            }
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t outer, int64_t innerStart, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = static_cast<uint32_t>(count * sizeof(T));
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};

        for (int64_t d = 0; d < dimSize_; ++d) {
            int64_t offset = (outer * dimSize_ + d) * innerSize_ + innerStart;
            AscendC::LocalTensor<T> xLocal = inQueue_.template AllocTensor<T>();
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            inQueue_.EnQue(xLocal);
            xLocal = inQueue_.template DeQue<T>();

            AscendC::LocalTensor<T> outLocal = outQueue_.template AllocTensor<T>();
            auto carry = tbufCarryFloat_.template Get<float>();
            if constexpr (std::is_same<T, half>::value) {
                if (d == 0) {
                    LogcumsumexpHalfInit(outLocal, carry, xLocal, alignedCount);
                } else {
                    LogcumsumexpHalfStep(outLocal, carry, xLocal, alignedCount);
                }
            } else {
                if (d == 0) {
                    LogcumsumexpFloatInit<T>(outLocal, carry, xLocal, alignedCount);
                } else {
                    LogcumsumexpFloatStep<T>(outLocal, carry, xLocal, alignedCount);
                }
            }
            AscendC::PipeBarrier<PIPE_V>();

            outQueue_.EnQue(outLocal);
            inQueue_.FreeTensor(xLocal);
            outLocal = outQueue_.template DeQue<T>();
            AscendC::DataCopyPad(yGm_[offset], outLocal, copyParams);
            outQueue_.FreeTensor(outLocal);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCarryFloat_;
    int64_t outerSize_ = 0;
    int64_t dimSize_ = 0;
    int64_t innerSize_ = 0;
    int64_t outerStart_ = 0;
    int64_t outerCount_ = 0;
    uint32_t tileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void logcumsumexp_kernel(
    GM_ADDR x, GM_ADDR y, int64_t outerSize, int64_t dimSize, int64_t innerSize,
    int64_t outerPerBlock, uint32_t tileElems)
{
    KernelLogcumsumexp<T> op;
    op.Init(x, y, outerSize, dimSize, innerSize, outerPerBlock, tileElems);
    op.Process();
}

torch::Tensor logcumsumexp_npu(const torch::Tensor &x_in, int64_t dim)
{
    TORCH_CHECK(x_in.scalar_type() == torch::kFloat16 ||
                x_in.scalar_type() == torch::kFloat32,
                "logcumsumexp: expected Half or Float inputs on dav-3510 Reg path, got ",
                x_in.scalar_type());
    const c10::OptionalDeviceGuard guard(x_in.device());
    auto x = x_in.contiguous();
    int64_t ndim = x.dim();
    int64_t dimNorm = normalize_dim(dim, ndim);
    auto y = torch::empty_like(x);
    if (x.numel() == 0) {
        return y;
    }

    int64_t outerSize = 1;
    int64_t dimSize = 1;
    int64_t innerSize = 1;
    if (ndim == 0) {
        dimSize = 1;
    } else {
        dimSize = x.size(dimNorm);
        for (int64_t i = 0; i < dimNorm; ++i) {
            outerSize *= x.size(i);
        }
        for (int64_t i = dimNorm + 1; i < ndim; ++i) {
            innerSize *= x.size(i);
        }
    }
    if (dimSize == 0) {
        return y;
    }

    int64_t numBlocks, outerPerBlock, tileElems;
    std::tie(numBlocks, outerPerBlock, tileElems) =
        calc_tiling_params(outerSize, x.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();
    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "logcumsumexp_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                logcumsumexp_kernel<half><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, outerSize, dimSize, innerSize,
                    outerPerBlock, static_cast<uint32_t>(tileElems));
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                logcumsumexp_kernel<float><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, outerSize, dimSize, innerSize,
                    outerPerBlock, static_cast<uint32_t>(tileElems));
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Logcumsumexp", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("logcumsumexp", logcumsumexp_npu);
}

} // namespace Logcumsumexp
} // namespace ops_multimodal_fusion
