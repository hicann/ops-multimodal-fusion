/*!
 * \file depthwise_conv3d.asc
 * \brief DepthwiseConv3d forward operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.depthwise_conv3d(input, weight, bias,
 *                                       stride, padding, dilation) -> output
 *
 * input  : [N, C_in, D_in, H_in, W_in], fp16/fp32
 * weight : [C_out, 1, kD, kH, kW], fp16/fp32, C_out % C_in == 0
 * bias   : optional [C_out], same dtype as input
 * output : [N, C_out, D_out, H_out, W_out]
 *
 * Semantics match torch.nn.functional.conv3d(..., groups=C_in).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <array>
#include <tuple>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace DepthwiseConv3d {

static constexpr int64_t kBlockBytes = 32;
static constexpr int64_t kScalarSlotBytes = 32;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("depthwise_conv3d(Tensor input, Tensor weight, Tensor? bias, "
          "int[3] stride, int[3] padding, int[3] dilation) -> Tensor");
}

static std::array<int64_t, 3> parse_int3(at::IntArrayRef ref, const char *name)
{
    TORCH_CHECK(ref.size() == 3,
                "depthwise_conv3d: ", name,
                " must contain exactly three integers, got ",
                ref.size(), " values");
    return {ref[0], ref[1], ref[2]};
}

static int64_t conv_out_size(
    int64_t inSize, int64_t kernel, int64_t stride, int64_t padding, int64_t dilation)
{
    return (inSize + 2 * padding - dilation * (kernel - 1) - 1) / stride + 1;
}

static std::array<int64_t, 3> compute_output_spatial(
    const torch::Tensor &input, const torch::Tensor &weight,
    const std::array<int64_t, 3> &stride, const std::array<int64_t, 3> &padding,
    const std::array<int64_t, 3> &dilation)
{
    std::array<int64_t, 3> out = {
        conv_out_size(input.size(2), weight.size(2), stride[0], padding[0], dilation[0]),
        conv_out_size(input.size(3), weight.size(3), stride[1], padding[1], dilation[1]),
        conv_out_size(input.size(4), weight.size(4), stride[2], padding[2], dilation[2])};
    TORCH_CHECK(out[0] > 0 && out[1] > 0 && out[2] > 0,
                "depthwise_conv3d: calculated output size is too small, got [",
                out[0], ", ", out[1], ", ", out[2], "]");
    return out;
}

static void check_common(
    const torch::Tensor &input, const torch::Tensor &weight,
    const c10::optional<torch::Tensor> &biasOpt,
    at::IntArrayRef strideRef, at::IntArrayRef paddingRef, at::IntArrayRef dilationRef)
{
    auto stride = parse_int3(strideRef, "stride");
    auto padding = parse_int3(paddingRef, "padding");
    auto dilation = parse_int3(dilationRef, "dilation");

    TORCH_CHECK(input.dim() == 5,
                "depthwise_conv3d: expected 5-D input [N, C, D, H, W], got ",
                input.dim(), "-D");
    TORCH_CHECK(weight.dim() == 5,
                "depthwise_conv3d: expected 5-D weight [C_out, 1, kD, kH, kW], got ",
                weight.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "depthwise_conv3d: expected Half or Float input on dav-3510 Reg path, got ",
                input.scalar_type());
    TORCH_CHECK(weight.scalar_type() == input.scalar_type(),
                "depthwise_conv3d: weight dtype must match input dtype");
    TORCH_CHECK(input.size(1) > 0,
                "depthwise_conv3d: input channel dimension must be positive");
    TORCH_CHECK(weight.size(0) > 0,
                "depthwise_conv3d: output channel dimension must be positive");
    TORCH_CHECK(weight.size(1) == 1,
                "depthwise_conv3d: weight.size(1) must be 1 for depthwise convolution");
    TORCH_CHECK(weight.size(0) % input.size(1) == 0,
                "depthwise_conv3d: C_out must be an integer multiple of C_in");
    TORCH_CHECK(input.size(2) > 0 && input.size(3) > 0 && input.size(4) > 0,
                "depthwise_conv3d: input spatial dimensions must be positive");
    TORCH_CHECK(weight.size(2) > 0 && weight.size(3) > 0 && weight.size(4) > 0,
                "depthwise_conv3d: kernel spatial dimensions must be positive");

    for (int i = 0; i < 3; ++i) {
        TORCH_CHECK(stride[i] > 0,
                    "depthwise_conv3d: stride entries must be positive");
        TORCH_CHECK(padding[i] >= 0,
                    "depthwise_conv3d: padding entries must be non-negative");
        TORCH_CHECK(dilation[i] > 0,
                    "depthwise_conv3d: dilation entries must be positive");
    }

    if (biasOpt.has_value()) {
        const auto &bias = biasOpt.value();
        TORCH_CHECK(bias.defined(), "depthwise_conv3d: bias is undefined");
        TORCH_CHECK(bias.dim() == 1 && bias.size(0) == weight.size(0),
                    "depthwise_conv3d: bias must have shape [C_out]");
        TORCH_CHECK(bias.scalar_type() == input.scalar_type(),
                    "depthwise_conv3d: bias dtype must match input dtype");
    }

    (void)compute_output_spatial(input, weight, stride, padding, dilation);
}

torch::Tensor depthwise_conv3d_meta(
    const torch::Tensor &input, const torch::Tensor &weight,
    const c10::optional<torch::Tensor> &biasOpt,
    at::IntArrayRef strideRef, at::IntArrayRef paddingRef, at::IntArrayRef dilationRef)
{
    check_common(input, weight, biasOpt, strideRef, paddingRef, dilationRef);
    auto stride = parse_int3(strideRef, "stride");
    auto padding = parse_int3(paddingRef, "padding");
    auto dilation = parse_int3(dilationRef, "dilation");
    auto out = compute_output_spatial(input, weight, stride, padding, dilation);
    return torch::empty({input.size(0), weight.size(0), out[0], out[1], out[2]},
                        input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("depthwise_conv3d", depthwise_conv3d_meta);
}

static int64_t calc_block_count(int64_t totalOutputs)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "depthwise_conv3d: coreNum must be positive");
    return std::max<int64_t>(1, std::min<int64_t>(totalOutputs, coreNum));
}

__simd_vf__ inline void InitAccumZeroVf(__ubuf__ float *accumAddr)
{
    AscendC::Reg::RegTensor<float> zeroReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
        zeroReg, 0.0f, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, zeroReg, mask);
}

__simd_vf__ inline void InitAccumFloatBiasVf(
    __ubuf__ float *accumAddr, __ubuf__ float *biasAddr)
{
    AscendC::Reg::RegTensor<float> biasReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(biasReg, biasAddr);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, biasReg, mask);
}

__simd_vf__ inline void InitAccumHalfBiasVf(
    __ubuf__ float *accumAddr, __ubuf__ half *biasAddr)
{
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<half> biasHalfReg;
    AscendC::Reg::RegTensor<float> biasReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
        biasHalfReg, biasAddr);
    AscendC::Reg::Cast<float, half, castToFloat>(biasReg, biasHalfReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, biasReg, mask);
}

__simd_vf__ inline void AccumulateProductFloatVf(
    __ubuf__ float *accumAddr, __ubuf__ float *inputAddr, __ubuf__ float *weightAddr)
{
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<float> inputReg;
    AscendC::Reg::RegTensor<float> weightReg;
    AscendC::Reg::RegTensor<float> prodReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        inputReg, inputAddr);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        weightReg, weightAddr);
    AscendC::Reg::Mul(prodReg, inputReg, weightReg, mask);
    AscendC::Reg::Add(accumReg, accumReg, prodReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, mask);
}

__simd_vf__ inline void AccumulateProductHalfVf(
    __ubuf__ float *accumAddr, __ubuf__ half *inputAddr, __ubuf__ half *weightAddr)
{
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<half> inputHalfReg;
    AscendC::Reg::RegTensor<half> weightHalfReg;
    AscendC::Reg::RegTensor<float> inputReg;
    AscendC::Reg::RegTensor<float> weightReg;
    AscendC::Reg::RegTensor<float> prodReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
        inputHalfReg, inputAddr);
    AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
        weightHalfReg, weightAddr);
    AscendC::Reg::Cast<float, half, castToFloat>(inputReg, inputHalfReg, mask);
    AscendC::Reg::Cast<float, half, castToFloat>(weightReg, weightHalfReg, mask);
    AscendC::Reg::Mul(prodReg, inputReg, weightReg, mask);
    AscendC::Reg::Add(accumReg, accumReg, prodReg, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, mask);
}

__simd_vf__ inline void StoreOutputFloatVf(
    __ubuf__ float *outAddr, __ubuf__ float *accumAddr)
{
    AscendC::Reg::RegTensor<float> accumReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        outAddr, accumReg, mask);
}

__simd_vf__ inline void StoreOutputHalfVf(
    __ubuf__ half *outAddr, __ubuf__ float *accumAddr)
{
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<half> outReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::Cast<half, float, castToHalf>(outReg, accumReg, mask);
    AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
        outAddr, outReg, mask);
}

__aicore__ inline void InitAccumZero(AscendC::LocalTensor<float> accumLocal)
{
    asc_vf_call<InitAccumZeroVf>((__ubuf__ float *)accumLocal.GetPhyAddr());
}

template <typename T>
__aicore__ inline void InitAccumBias(
    AscendC::LocalTensor<float> accumLocal, AscendC::LocalTensor<T> biasLocal)
{
    if constexpr (std::is_same<T, half>::value) {
        asc_vf_call<InitAccumHalfBiasVf>(
            (__ubuf__ float *)accumLocal.GetPhyAddr(),
            (__ubuf__ half *)biasLocal.GetPhyAddr());
    } else {
        asc_vf_call<InitAccumFloatBiasVf>(
            (__ubuf__ float *)accumLocal.GetPhyAddr(),
            (__ubuf__ float *)biasLocal.GetPhyAddr());
    }
}

template <typename T>
__aicore__ inline void AccumulateProduct(
    AscendC::LocalTensor<float> accumLocal,
    AscendC::LocalTensor<T> inputLocal, AscendC::LocalTensor<T> weightLocal)
{
    if constexpr (std::is_same<T, half>::value) {
        asc_vf_call<AccumulateProductHalfVf>(
            (__ubuf__ float *)accumLocal.GetPhyAddr(),
            (__ubuf__ half *)inputLocal.GetPhyAddr(),
            (__ubuf__ half *)weightLocal.GetPhyAddr());
    } else {
        asc_vf_call<AccumulateProductFloatVf>(
            (__ubuf__ float *)accumLocal.GetPhyAddr(),
            (__ubuf__ float *)inputLocal.GetPhyAddr(),
            (__ubuf__ float *)weightLocal.GetPhyAddr());
    }
}

template <typename T>
__aicore__ inline void StoreOutputScalar(
    AscendC::LocalTensor<T> outLocal, AscendC::LocalTensor<float> accumLocal)
{
    if constexpr (std::is_same<T, half>::value) {
        asc_vf_call<StoreOutputHalfVf>(
            (__ubuf__ half *)outLocal.GetPhyAddr(),
            (__ubuf__ float *)accumLocal.GetPhyAddr());
    } else {
        asc_vf_call<StoreOutputFloatVf>(
            (__ubuf__ float *)outLocal.GetPhyAddr(),
            (__ubuf__ float *)accumLocal.GetPhyAddr());
    }
}

template <typename T>
class KernelDepthwiseConv3d {
public:
    __aicore__ inline KernelDepthwiseConv3d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR weight, GM_ADDR bias, GM_ADDR output,
        int64_t totalOutputs, int64_t blockLength,
        int64_t N, int64_t CIn, int64_t COut,
        int64_t inD, int64_t inH, int64_t inW,
        int64_t outD, int64_t outH, int64_t outW,
        int64_t kD, int64_t kH, int64_t kW,
        int64_t strideD, int64_t strideH, int64_t strideW,
        int64_t padD, int64_t padH, int64_t padW,
        int64_t dilD, int64_t dilH, int64_t dilW,
        bool hasBias)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        weightGm_.SetGlobalBuffer((__gm__ T *)weight);
        biasGm_.SetGlobalBuffer((__gm__ T *)bias);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        totalOutputs_ = totalOutputs;
        blockLength_ = blockLength;
        N_ = N;
        CIn_ = CIn;
        COut_ = COut;
        channelMultiplier_ = COut / CIn;
        inD_ = inD;
        inH_ = inH;
        inW_ = inW;
        outD_ = outD;
        outH_ = outH;
        outW_ = outW;
        kD_ = kD;
        kH_ = kH;
        kW_ = kW;
        strideD_ = strideD;
        strideH_ = strideH;
        strideW_ = strideW;
        padD_ = padD;
        padH_ = padH;
        padW_ = padW;
        dilD_ = dilD;
        dilH_ = dilH;
        dilW_ = dilW;
        hasBias_ = hasBias;

        pipe_.InitBuffer(tbufInput_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufWeight_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufBias_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufAccum_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufOut_, static_cast<uint32_t>(kScalarSlotBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t start = blockIdx * blockLength_;
        int64_t end = start + blockLength_;
        if (end > totalOutputs_) {
            end = totalOutputs_;
        }
        for (int64_t linear = start; linear < end; ++linear) {
            ComputeOne(linear);
        }
    }

private:
    __aicore__ inline void ComputeOne(int64_t linear)
    {
        int64_t ow = linear % outW_;
        int64_t tmp = linear / outW_;
        int64_t oh = tmp % outH_;
        tmp /= outH_;
        int64_t od = tmp % outD_;
        tmp /= outD_;
        int64_t co = tmp % COut_;
        int64_t n = tmp / COut_;
        int64_t ci = co / channelMultiplier_;

        if (kD_ == 1 && kH_ == 1 && kW_ == 1) {
            ComputeOneByScalar(linear, n, ci, co, od, oh, ow);
            return;
        }

        AscendC::LocalTensor<float> accumLocal = tbufAccum_.template Get<float>();
        if (hasBias_) {
            LoadBias(co);
            AscendC::PipeBarrier<PIPE_ALL>();
            InitAccumBias<T>(accumLocal, tbufBias_.template Get<T>());
        } else {
            InitAccumZero(accumLocal);
        }
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<T> inputLocal = tbufInput_.template Get<T>();
        AscendC::LocalTensor<T> weightLocal = tbufWeight_.template Get<T>();
        for (int64_t kd = 0; kd < kD_; ++kd) {
            int64_t id = od * strideD_ - padD_ + kd * dilD_;
            if (id < 0 || id >= inD_) {
                continue;
            }
            for (int64_t kh = 0; kh < kH_; ++kh) {
                int64_t ih = oh * strideH_ - padH_ + kh * dilH_;
                if (ih < 0 || ih >= inH_) {
                    continue;
                }
                for (int64_t kw = 0; kw < kW_; ++kw) {
                    int64_t iw = ow * strideW_ - padW_ + kw * dilW_;
                    if (iw < 0 || iw >= inW_) {
                        continue;
                    }
                    int64_t inputOffset =
                        (((n * CIn_ + ci) * inD_ + id) * inH_ + ih) * inW_ + iw;
                    int64_t weightOffset =
                        (((co * kD_ + kd) * kH_ + kh) * kW_ + kw);
                    LoadInputWeight(inputLocal, weightLocal, inputOffset, weightOffset);
                    AscendC::PipeBarrier<PIPE_ALL>();
                    AccumulateProduct<T>(accumLocal, inputLocal, weightLocal);
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
            }
        }
        Store(linear, accumLocal);
    }

    __aicore__ inline float ReadLocalAsFloat(AscendC::LocalTensor<T> local)
    {
        if constexpr (std::is_same<T, half>::value) {
            half v = local.GetValue(0);
            return static_cast<float>(v);
        } else {
            return local.GetValue(0);
        }
    }

    __aicore__ inline void ComputeOneByScalar(
        int64_t outputOffset, int64_t n, int64_t ci, int64_t co,
        int64_t od, int64_t oh, int64_t ow)
    {
        float value = 0.0f;
        if (hasBias_) {
            LoadBias(co);
            AscendC::PipeBarrier<PIPE_ALL>();
            value = ReadLocalAsFloat(tbufBias_.template Get<T>());
        }

        int64_t id = od * strideD_ - padD_;
        int64_t ih = oh * strideH_ - padH_;
        int64_t iw = ow * strideW_ - padW_;
        if (id >= 0 && id < inD_ && ih >= 0 && ih < inH_ && iw >= 0 && iw < inW_) {
            AscendC::LocalTensor<T> inputLocal = tbufInput_.template Get<T>();
            AscendC::LocalTensor<T> weightLocal = tbufWeight_.template Get<T>();
            int64_t inputOffset =
                (((n * CIn_ + ci) * inD_ + id) * inH_ + ih) * inW_ + iw;
            int64_t weightOffset = co;
            LoadInputWeight(inputLocal, weightLocal, inputOffset, weightOffset);
            AscendC::PipeBarrier<PIPE_ALL>();
            value += ReadLocalAsFloat(inputLocal) * ReadLocalAsFloat(weightLocal);
        }
        StoreDirect(outputOffset, value);
    }

    __aicore__ inline void LoadBias(int64_t co)
    {
        AscendC::LocalTensor<T> biasLocal = tbufBias_.template Get<T>();
        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(sizeof(T));
        copy.srcStride = 0;
        copy.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(biasLocal, biasGm_[co], copy, pad);
    }

    __aicore__ inline void LoadInputWeight(
        AscendC::LocalTensor<T> inputLocal, AscendC::LocalTensor<T> weightLocal,
        int64_t inputOffset, int64_t weightOffset)
    {
        AscendC::DataCopyExtParams copy;
        copy.blockCount = 1;
        copy.blockLen = static_cast<uint32_t>(sizeof(T));
        copy.srcStride = 0;
        copy.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(inputLocal, inputGm_[inputOffset], copy, pad);
        AscendC::DataCopyPad(weightLocal, weightGm_[weightOffset], copy, pad);
    }

    __aicore__ inline void Store(
        int64_t outputOffset, AscendC::LocalTensor<float> accumLocal)
    {
        AscendC::LocalTensor<T> outLocal = tbufOut_.template Get<T>();
        StoreOutputScalar<T>(outLocal, accumLocal);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(outputGm_[outputOffset], outLocal, copyOut);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void StoreDirect(int64_t outputOffset, float value)
    {
        AscendC::LocalTensor<T> outLocal = tbufOut_.template Get<T>();
        if constexpr (std::is_same<T, half>::value) {
            outLocal.SetValue(0, T(value));
        } else {
            outLocal.SetValue(0, value);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(outputGm_[outputOffset], outLocal, copyOut);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> weightGm_;
    AscendC::GlobalTensor<T> biasGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufWeight_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufBias_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufAccum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOut_;
    int64_t totalOutputs_ = 0;
    int64_t blockLength_ = 1;
    int64_t N_ = 0;
    int64_t CIn_ = 0;
    int64_t COut_ = 0;
    int64_t channelMultiplier_ = 1;
    int64_t inD_ = 0;
    int64_t inH_ = 0;
    int64_t inW_ = 0;
    int64_t outD_ = 0;
    int64_t outH_ = 0;
    int64_t outW_ = 0;
    int64_t kD_ = 0;
    int64_t kH_ = 0;
    int64_t kW_ = 0;
    int64_t strideD_ = 1;
    int64_t strideH_ = 1;
    int64_t strideW_ = 1;
    int64_t padD_ = 0;
    int64_t padH_ = 0;
    int64_t padW_ = 0;
    int64_t dilD_ = 1;
    int64_t dilH_ = 1;
    int64_t dilW_ = 1;
    bool hasBias_ = false;
};

template <typename T>
__global__ __aicore__ __vector__ void depthwise_conv3d_kernel(
    GM_ADDR input, GM_ADDR weight, GM_ADDR bias, GM_ADDR output,
    int64_t totalOutputs, int64_t blockLength,
    int64_t N, int64_t CIn, int64_t COut,
    int64_t inD, int64_t inH, int64_t inW,
    int64_t outD, int64_t outH, int64_t outW,
    int64_t kD, int64_t kH, int64_t kW,
    int64_t strideD, int64_t strideH, int64_t strideW,
    int64_t padD, int64_t padH, int64_t padW,
    int64_t dilD, int64_t dilH, int64_t dilW,
    bool hasBias)
{
    KernelDepthwiseConv3d<T> op;
    op.Init(input, weight, bias, output, totalOutputs, blockLength,
            N, CIn, COut, inD, inH, inW, outD, outH, outW, kD, kH, kW,
            strideD, strideH, strideW, padD, padH, padW, dilD, dilH, dilW,
            hasBias);
    op.Process();
}

torch::Tensor depthwise_conv3d_npu(
    const torch::Tensor &input, const torch::Tensor &weight,
    const c10::optional<torch::Tensor> &biasOpt,
    at::IntArrayRef strideRef, at::IntArrayRef paddingRef, at::IntArrayRef dilationRef)
{
    check_common(input, weight, biasOpt, strideRef, paddingRef, dilationRef);
    const c10::OptionalDeviceGuard guard(input.device());

    auto stride = parse_int3(strideRef, "stride");
    auto padding = parse_int3(paddingRef, "padding");
    auto dilation = parse_int3(dilationRef, "dilation");
    auto out = compute_output_spatial(input, weight, stride, padding, dilation);

    torch::Tensor inputC = input.contiguous();
    torch::Tensor weightC = weight.contiguous();
    bool hasBias = biasOpt.has_value();
    torch::Tensor biasC;
    if (hasBias) {
        biasC = biasOpt.value().contiguous();
    } else {
        biasC = torch::empty({1}, input.options());
    }

    int64_t N = inputC.size(0);
    int64_t CIn = inputC.size(1);
    int64_t COut = weightC.size(0);
    int64_t inD = inputC.size(2);
    int64_t inH = inputC.size(3);
    int64_t inW = inputC.size(4);
    int64_t kD = weightC.size(2);
    int64_t kH = weightC.size(3);
    int64_t kW = weightC.size(4);
    int64_t outD = out[0];
    int64_t outH = out[1];
    int64_t outW = out[2];

    torch::Tensor output =
        torch::empty({N, COut, outD, outH, outW}, inputC.options());
    int64_t totalOutputs = output.numel();
    if (totalOutputs == 0) {
        return output;
    }

    int64_t numBlocks = calc_block_count(totalOutputs);
    int64_t blockLength = (totalOutputs + numBlocks - 1) / numBlocks;

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto weightPtr = (GM_ADDR)weightC.data_ptr();
    auto biasPtr = (GM_ADDR)biasC.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    auto aclCall = [=]() -> int {
        AT_DISPATCH_SWITCH(
            inputC.scalar_type(), "depthwise_conv3d_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                depthwise_conv3d_kernel<float><<<numBlocks, nullptr, stream>>>(
                    inputPtr, weightPtr, biasPtr, outputPtr, totalOutputs, blockLength,
                    N, CIn, COut, inD, inH, inW, outD, outH, outW, kD, kH, kW,
                    stride[0], stride[1], stride[2],
                    padding[0], padding[1], padding[2],
                    dilation[0], dilation[1], dilation[2], hasBias);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                depthwise_conv3d_kernel<half><<<numBlocks, nullptr, stream>>>(
                    inputPtr, weightPtr, biasPtr, outputPtr, totalOutputs, blockLength,
                    N, CIn, COut, inD, inH, inW, outD, outH, outW, kD, kH, kW,
                    stride[0], stride[1], stride[2],
                    padding[0], padding[1], padding[2],
                    dilation[0], dilation[1], dilation[2], hasBias);
            }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("DepthwiseConv3dReg", aclCall);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("depthwise_conv3d", depthwise_conv3d_npu);
}

} // namespace DepthwiseConv3d
} // namespace ops_multimodal_fusion
