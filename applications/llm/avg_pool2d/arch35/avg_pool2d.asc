/*!
 * \file avg_pool2d.asc
 * \brief AvgPool2d (2D average pooling) operator implementation for Ascend NPU
 *
 * avg_pool2d(self, kernel_size, stride, padding, ceil_mode, count_include_pad, divisor_override)
 * y_{n,c,oh,ow} = (1/|R|) * sum_{(i,j) in R} x_{n,c,i,j}
 *
 * Two kernel paths (selected by host, both fully vectorized -- no GetValue/SetValue):
 *
 * strideW == 1 ("S1" path):
 *   Host pre-pads input with zeros. Kernel distributes output rows (N*C*oH)
 *   across cores. For each (kh,kw), the tile's input values are contiguous --
 *   single DMA + vector Add.
 *
 * strideW > 1 ("Reduce" path):
 *   Host unfolds the padded input into (N*C, kH*kW, oH*oW), making the
 *   reduction dimension contiguous. Kernel distributes (N*C) across cores
 *   and reduces kH*kW slices with DMA + vector Add (same pattern as mean).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace AvgPool2d {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("avg_pool2d(Tensor self, int[2] kernel_size, int[2] stride=[], "
          "int[2] padding=0, bool ceil_mode=False, "
          "bool count_include_pad=True, int? divisor_override=None) -> Tensor");
}

// ===================== Helpers =====================

inline int64_t pooling_output_size(
    int64_t inputSize, int64_t kernelSize,
    int64_t pad, int64_t stride, bool ceil_mode)
{
    int64_t sz = (inputSize + 2 * pad - kernelSize +
                  (ceil_mode ? stride - 1 : 0)) / stride + 1;
    if (ceil_mode && (sz - 1) * stride >= inputSize + pad) --sz;
    return sz;
}

// ===================== 2. Meta =====================

torch::Tensor avg_pool2d_meta(
    const torch::Tensor &self,
    at::IntArrayRef kernel_size, at::IntArrayRef stride,
    at::IntArrayRef padding, bool ceil_mode,
    bool count_include_pad, std::optional<int64_t> divisor_override)
{
    TORCH_CHECK(self.dim() == 3 || self.dim() == 4,
        "avg_pool2d: expected 3D or 4D input, got ", self.dim(), "D");
    int64_t kH = kernel_size[0];
    int64_t kW = kernel_size.size() == 1 ? kH : kernel_size[1];
    int64_t sH = stride.empty() ? kH : stride[0];
    int64_t sW = stride.empty() ? kW : (stride.size() == 1 ? sH : stride[1]);
    int64_t pH = padding.size() == 0 ? 0 : padding[0];
    int64_t pW = padding.size() <= 1 ? pH : padding[1];
    bool is4D = (self.dim() == 4);
    int64_t H = is4D ? self.size(2) : self.size(1);
    int64_t W = is4D ? self.size(3) : self.size(2);
    int64_t oH = pooling_output_size(H, kH, pH, sH, ceil_mode);
    int64_t oW = pooling_output_size(W, kW, pW, sW, ceil_mode);
    TORCH_CHECK(oH > 0 && oW > 0, "avg_pool2d: output size too small");
    TORCH_CHECK(pH <= kH / 2 && pW <= kW / 2,
        "pad should be at most half of effective kernel size, but got pad=[", pH,
        ", ", pW, "], kernel_size=[", kH, ", ", kW, "] and dilation=[1, 1]");
    if (is4D) return torch::empty({self.size(0), self.size(1), oH, oW}, self.options());
    return torch::empty({self.size(0), oH, oW}, self.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m) { m.impl("avg_pool2d", avg_pool2d_meta); }

// ===================== 3. Tiling helpers =====================

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling(int64_t outerSize)
{
    constexpr int64_t PD = 2, BN = 2;
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ub; plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    int64_t cores = plat->GetCoreNumAiv();
    TORCH_CHECK(cores > 0);
    int64_t nblk = std::min(cores, outerSize);
    if (nblk <= 0) nblk = 1;
    int64_t blkLen = (outerSize + nblk - 1) / nblk;
    int64_t tile = ((int64_t)ub / PD / BN / 32) * 32;
    return std::make_tuple(nblk, blkLen, tile);
}

// ===================== 4a. S1 kernel (strideW==1) =====================
// Distributes output rows (N*C*oH). For each row, tiles output columns.
// For each (kh,kw), reads contiguous input slice via DMA, vector Add.

template <typename T>
class KernelS1 {
public:
    __aicore__ inline KernelS1() {}
    __aicore__ inline void Init(
        GM_ADDR in, GM_ADDR out, GM_ADDR inv,
        int64_t nRows, int64_t blkRows, uint32_t tile,
        int64_t C, int64_t pH_, int64_t pW_,
        int64_t oH, int64_t oW,
        int64_t kH, int64_t kW, int64_t sH,
        int64_t cDiv, bool useInv)
    {
        inGm_.SetGlobalBuffer((__gm__ T*)in);
        outGm_.SetGlobalBuffer((__gm__ T*)out);
        useInv_ = useInv;
        if (useInv) ivGm_.SetGlobalBuffer((__gm__ T*)inv);
        int64_t s = blkRows * AscendC::GetBlockIdx();
        bLen_ = nRows - s; if (bLen_ > blkRows) bLen_ = blkRows;
        rStart_ = s;
        C_=C; pH__=pH_; pW__=pW_; oH_=oH; oW_=oW;
        kH_=kH; kW_=kW; sH_=sH;
        if (cDiv > 0) inv_ = (T)(1.0f/(float)cDiv);
        ept_ = tile / sizeof(T);
        pipe_.InitBuffer(iq_, 2, tile);
        pipe_.InitBuffer(oq_, 2, tile);
    }
    __aicore__ inline void Process() {
        for (int64_t r = 0; r < bLen_; ++r) {
            int64_t ri = rStart_ + r;
            int64_t oh = ri % oH_, t = ri / oH_;
            int64_t c = t % C_, n = t / C_;
            int64_t ib = (n*C_+c)*pH__*pW__;
            int64_t ob = ri * oW_;
            int64_t rem = oW_, o0 = 0;
            while (rem > 0) {
                int64_t cnt = rem < ept_ ? rem : ept_;
                Tile(ib, ob, oh, o0, cnt);
                o0 += cnt; rem -= cnt;
            }
        }
    }
private:
    __aicore__ inline void Tile(
        int64_t ib, int64_t ob, int64_t oh, int64_t o0, int64_t cnt)
    {
        auto acc = oq_.AllocTensor<T>();
        AscendC::Duplicate(acc, (T)0, cnt);
        AscendC::PipeBarrier<PIPE_V>();
        for (int64_t kh = 0; kh < kH_; ++kh) {
            int64_t ih = oh * sH_ + kh;
            int64_t ro = ib + ih * pW__;
            for (int64_t kw = 0; kw < kW_; ++kw) {
                auto tmp = iq_.AllocTensor<T>();
                AscendC::DataCopyExtParams cp;
                cp.blockCount = 1;
                cp.blockLen = cnt * sizeof(T);
                cp.srcStride = 0;
                cp.dstStride = 0;
                AscendC::DataCopyPadExtParams<T> pp{false,0,0,0};
                AscendC::DataCopyPad(tmp, inGm_[ro+o0+kw], cp, pp);
                iq_.EnQue(tmp); tmp = iq_.DeQue<T>();
                AscendC::Add(acc, acc, tmp, cnt);
                AscendC::PipeBarrier<PIPE_V>();
                iq_.FreeTensor(tmp);
            }
        }
        // divide
        if (!useInv_) {
            AscendC::Muls(acc, acc, inv_, cnt);
        } else {
            auto iv = iq_.AllocTensor<T>();
            AscendC::DataCopyExtParams cp; cp.blockCount=1; cp.blockLen=cnt*sizeof(T); cp.srcStride=0; cp.dstStride=0;
            AscendC::DataCopyPadExtParams<T> pp{false,0,0,0};
            AscendC::DataCopyPad(iv, ivGm_[oh*oW_+o0], cp, pp);
            iq_.EnQue(iv); iv = iq_.DeQue<T>();
            AscendC::Mul(acc, acc, iv, cnt);
            AscendC::PipeBarrier<PIPE_V>();
            iq_.FreeTensor(iv);
        }
        AscendC::PipeBarrier<PIPE_V>();
        oq_.EnQue(acc); acc = oq_.DeQue<T>();
        AscendC::DataCopyExtParams wp; wp.blockCount=1; wp.blockLen=cnt*sizeof(T); wp.srcStride=0; wp.dstStride=0;
        AscendC::DataCopyPad(outGm_[ob+o0], acc, wp);
        oq_.FreeTensor(acc);
    }
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inGm_, outGm_, ivGm_;
    AscendC::TQue<AscendC::QuePosition::VECIN,2> iq_;
    AscendC::TQue<AscendC::QuePosition::VECOUT,2> oq_;
    int64_t rStart_=0,bLen_=0,C_=0,pH__=0,pW__=0;
    int64_t oH_=0,oW_=0,kH_=0,kW_=0,sH_=0;
    bool useInv_=false; T inv_=(T)0; int64_t ept_=0;
};

template <typename T>
__global__ __aicore__ __vector__ void avg_pool2d_s1_kernel(
    GM_ADDR in, GM_ADDR out, GM_ADDR inv,
    int64_t nRows, int64_t blkRows, uint32_t tile,
    int64_t C, int64_t pH, int64_t pW,
    int64_t oH, int64_t oW,
    int64_t kH, int64_t kW, int64_t sH,
    int64_t cDiv, bool useInv)
{
    KernelS1<T> op;
    op.Init(in,out,inv,nRows,blkRows,tile,C,pH,pW,oH,oW,kH,kW,sH,cDiv,useInv);
    op.Process();
}

// ===================== 4b. Reduce kernel (strideW>1) =====================
// Host unfolds input to (N*C, kH*kW, oH*oW) so reduction dim is contiguous.
// Kernel distributes (N*C) outer elements across cores, reduces kH*kW slices
// with DMA + vector Add -- same pattern as the mean operator.

template <typename T>
class KernelReduce {
public:
    __aicore__ inline KernelReduce() {}
    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR inv,
        int64_t outerSize, int64_t blkOuter, uint32_t tile,
        int64_t dimSize, int64_t innerSize,
        int64_t cDiv, bool useInv)
    {
        xGm_.SetGlobalBuffer((__gm__ T*)x);
        yGm_.SetGlobalBuffer((__gm__ T*)y);
        useInv_ = useInv;
        if (useInv) ivGm_.SetGlobalBuffer((__gm__ T*)inv);
        int64_t s = blkOuter * AscendC::GetBlockIdx();
        bLen_ = outerSize - s; if (bLen_ > blkOuter) bLen_ = blkOuter;
        oStart_ = s;
        dim_ = dimSize; inner_ = innerSize;
        if (cDiv > 0) inv_ = (T)(1.0f/(float)cDiv);
        ept_ = tile / sizeof(T);
        pipe_.InitBuffer(iq_, 2, tile);
        pipe_.InitBuffer(oq_, 2, tile);
    }
    __aicore__ inline void Process() {
        for (int64_t o = 0; o < bLen_; ++o)
            ProcessOuter(oStart_ + o);
    }
private:
    __aicore__ inline void ProcessOuter(int64_t oi) {
        int64_t rem = inner_, off = 0;
        while (rem > 0) {
            int64_t cnt = rem < ept_ ? rem : ept_;
            ReduceTile(oi, off, cnt);
            off += cnt; rem -= cnt;
        }
    }
    __aicore__ inline void ReduceTile(int64_t oi, int64_t ioff, int64_t cnt) {
        auto acc = oq_.AllocTensor<T>();
        AscendC::Duplicate(acc, (T)0, cnt);
        AscendC::PipeBarrier<PIPE_V>();
        for (int64_t d = 0; d < dim_; ++d) {
            int64_t src = oi * dim_ * inner_ + d * inner_ + ioff;
            auto tmp = iq_.AllocTensor<T>();
            AscendC::DataCopyExtParams cp; cp.blockCount=1; cp.blockLen=cnt*sizeof(T); cp.srcStride=0; cp.dstStride=0;
            AscendC::DataCopyPadExtParams<T> pp{false,0,0,0};
            AscendC::DataCopyPad(tmp, xGm_[src], cp, pp);
            iq_.EnQue(tmp); tmp = iq_.DeQue<T>();
            AscendC::Add(acc, acc, tmp, cnt);
            AscendC::PipeBarrier<PIPE_V>();
            iq_.FreeTensor(tmp);
        }
        // divide
        if (!useInv_) {
            AscendC::Muls(acc, acc, inv_, cnt);
        } else {
            // inv_counts is (oH*oW,) -- tiled at offset ioff
            auto iv = iq_.AllocTensor<T>();
            AscendC::DataCopyExtParams cp; cp.blockCount=1; cp.blockLen=cnt*sizeof(T); cp.srcStride=0; cp.dstStride=0;
            AscendC::DataCopyPadExtParams<T> pp{false,0,0,0};
            AscendC::DataCopyPad(iv, ivGm_[ioff], cp, pp);
            iq_.EnQue(iv); iv = iq_.DeQue<T>();
            AscendC::Mul(acc, acc, iv, cnt);
            AscendC::PipeBarrier<PIPE_V>();
            iq_.FreeTensor(iv);
        }
        AscendC::PipeBarrier<PIPE_V>();
        int64_t dst = oi * inner_ + ioff;
        oq_.EnQue(acc); acc = oq_.DeQue<T>();
        AscendC::DataCopyExtParams wp; wp.blockCount=1; wp.blockLen=cnt*sizeof(T); wp.srcStride=0; wp.dstStride=0;
        AscendC::DataCopyPad(yGm_[dst], acc, wp);
        oq_.FreeTensor(acc);
    }
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_, ivGm_;
    AscendC::TQue<AscendC::QuePosition::VECIN,2> iq_;
    AscendC::TQue<AscendC::QuePosition::VECOUT,2> oq_;
    int64_t oStart_=0,bLen_=0,dim_=0,inner_=0;
    bool useInv_=false; T inv_=(T)0; int64_t ept_=0;
};

template <typename T>
__global__ __aicore__ __vector__ void avg_pool2d_reduce_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR inv,
    int64_t outerSize, int64_t blkOuter, uint32_t tile,
    int64_t dimSize, int64_t innerSize,
    int64_t cDiv, bool useInv)
{
    KernelReduce<T> op;
    op.Init(x,y,inv,outerSize,blkOuter,tile,dimSize,innerSize,cDiv,useInv);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor avg_pool2d_npu(
    const torch::Tensor &self,
    at::IntArrayRef kernel_size, at::IntArrayRef stride,
    at::IntArrayRef padding, bool ceil_mode,
    bool count_include_pad, std::optional<int64_t> divisor_override)
{
    const c10::OptionalDeviceGuard guard(self.device());
    auto input = self.contiguous();

    int64_t kH = kernel_size[0];
    int64_t kW = kernel_size.size() == 1 ? kH : kernel_size[1];
    int64_t sH = stride.empty() ? kH : stride[0];
    int64_t sW = stride.empty() ? kW : (stride.size() == 1 ? sH : stride[1]);
    int64_t pH = padding.size() == 0 ? 0 : padding[0];
    int64_t pW = padding.size() <= 1 ? pH : padding[1];

    auto output = avg_pool2d_meta(input, kernel_size, stride, padding,
                                  ceil_mode, count_include_pad, divisor_override);

    bool is4D = (input.dim() == 4);
    int64_t N = is4D ? input.size(0) : 1;
    int64_t C = is4D ? input.size(1) : input.size(0);
    int64_t H = is4D ? input.size(2) : input.size(1);
    int64_t W = is4D ? input.size(3) : input.size(2);
    int64_t oH = pooling_output_size(H, kH, pH, sH, ceil_mode);
    int64_t oW = pooling_output_size(W, kW, pW, sW, ceil_mode);

    // Pre-pad input so kernel never accesses out-of-bounds.
    // ceil_mode may require extra bottom/right padding beyond 2*pad when the
    // ceil-rounded output size extends past the normally-padded region.
    int64_t needH = (oH - 1) * sH + kH;
    int64_t needW = (oW - 1) * sW + kW;
    int64_t extraH = needH > H + 2 * pH ? needH - (H + 2 * pH) : 0;
    int64_t extraW = needW > W + 2 * pW ? needW - (W + 2 * pW) : 0;
    auto inPad = input;
    if (pH > 0 || pW > 0 || extraH > 0 || extraW > 0)
        inPad = at::constant_pad_nd(input, {pW, pW + extraW, pH, pH + extraH}, 0);
    inPad = inPad.contiguous();
    int64_t padH = H + 2 * pH + extraH, padW = W + 2 * pW + extraW;

    // Divisor mode
    int64_t cDiv = 0;
    bool useInv = false;
    torch::Tensor invNpu;
    GM_ADDR inv_ptr = nullptr;

    if (divisor_override.has_value()) {
        cDiv = divisor_override.value();
    } else if (count_include_pad && !ceil_mode) {
        // Fixed kH*kW divisor; explicit zero-padding counts (no ceil extension).
        cDiv = kH * kW;
    } else {
        useInv = true;
        auto invCpu = torch::empty({oH * oW}, torch::dtype(torch::kFloat32));
        auto *d = invCpu.data_ptr<float>();
        for (int64_t oh = 0; oh < oH; ++oh) {
            int64_t hstart = oh * sH - pH;
            for (int64_t ow = 0; ow < oW; ++ow) {
                int64_t wstart = ow * sW - pW;
                int64_t cnt = 0;
                if (count_include_pad && ceil_mode) {
                    // ceil implicit padding: divisor counts only explicit-pad region.
                    for (int64_t ih = hstart; ih < hstart + kH; ++ih)
                        for (int64_t iw = wstart; iw < wstart + kW; ++iw)
                            if (ih >= -pH && ih < H + pH && iw >= -pW && iw < W + pW)
                                ++cnt;
                } else {
                    int64_t h0 = hstart, h1 = hstart + kH;
                    int64_t w0 = wstart, w1 = wstart + kW;
                    if (h0 < 0) h0 = 0;
                    if (h1 > H) h1 = H;
                    if (w0 < 0) w0 = 0;
                    if (w1 > W) w1 = W;
                    cnt = (h1 - h0) * (w1 - w0);
                }
                d[oh * oW + ow] = 1.0f / (float)cnt;
            }
        }
        invNpu = invCpu.to(input.device());
        inv_ptr = (GM_ADDR)invNpu.data_ptr();
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    if (sW == 1) {
        // ---- S1 path: per-row vectorized ----
        int64_t nRows = N * C * oH;
        int64_t nblk, blkR, tileS;
        std::tie(nblk, blkR, tileS) = calc_tiling(nRows);
        auto in_ptr = (GM_ADDR)inPad.data_ptr();
        auto out_ptr = (GM_ADDR)output.data_ptr();
        auto acl = [=]() -> int {
            AT_DISPATCH_SWITCH(input.scalar_type(), "avg_pool2d_s1",
                AT_DISPATCH_CASE(torch::kFloat32, [&]{
                    avg_pool2d_s1_kernel<float><<<nblk,nullptr,stream>>>(
                        in_ptr, out_ptr, inv_ptr,
                        nRows, blkR, tileS, C, padH, padW,
                        oH, oW, kH, kW, sH, cDiv, useInv);
                })
            ); return 0;
        };
        at_npu::native::OpCommand::RunOpApi("AvgPool2dS1", acl);
    } else {
        // ---- Reduce path: unfold on device, reduce with DMA+Add ----
        // unfold -- (N, C, oH, oW, kH, kW)
        auto uf = inPad.unfold(is4D ? 2 : 1, kH, sH)
                       .unfold(is4D ? 3 : 2, kW, sW);
        // permute to (N, C, kH, kW, oH, oW) and make contiguous
        if (is4D) {
            uf = uf.permute({0, 1, 4, 5, 2, 3}).contiguous();
        } else {
            uf = uf.permute({0, 3, 4, 1, 2}).contiguous();
        }
        // reshape to (N*C, kH*kW, oH*oW)
        uf = uf.reshape({N * C, kH * kW, oH * oW});

        int64_t outerSize = N * C;
        int64_t dimSize = kH * kW;
        int64_t innerSize = oH * oW;
        int64_t nblk2, blkO, tileR;
        std::tie(nblk2, blkO, tileR) = calc_tiling(outerSize);
        auto x_ptr = (GM_ADDR)uf.data_ptr();
        auto y_ptr = (GM_ADDR)output.data_ptr();
        auto acl = [=]() -> int {
            AT_DISPATCH_SWITCH(input.scalar_type(), "avg_pool2d_reduce",
                AT_DISPATCH_CASE(torch::kFloat32, [&]{
                    avg_pool2d_reduce_kernel<float><<<nblk2,nullptr,stream>>>(
                        x_ptr, y_ptr, inv_ptr,
                        outerSize, blkO, tileR,
                        dimSize, innerSize, cDiv, useInv);
                })
            ); return 0;
        };
        at_npu::native::OpCommand::RunOpApi("AvgPool2dReduce", acl);
    }
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("avg_pool2d", avg_pool2d_npu);
}

} // namespace AvgPool2d
} // namespace ops_multimodal_fusion
