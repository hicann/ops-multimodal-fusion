/*!
 * \file binomial.asc
 * \brief Binomial-distribution sampling operator for Ascend NPU (dav-3510)
 *
 * torch.binomial(count, prob) equivalent, exposed functionally:
 *   ops_multimodal_fusion.binomial(count, prob, seed) -> Tensor (shape/dtype of count)
 *
 * Like Poisson (and unlike cauchy/exponential/geometric/log_normal), the
 * inputs carry the per-element parameters and ARE read: count = n (trials),
 * prob = p (success probability). y[i] ~ Binomial(n[i], p[i]),
 * P(X=k) = C(n,k) p^k (1-p)^(n-k).
 *
 * PyTorch CUDA calls the shared sample_binomial (Distributions.h):
 * inversion for count*prob < 10, BTRS transformed-rejection (Hoermann,
 * stirling_approx_tail) otherwise, with real-valued count support. None of
 * that is portable/SIMD-friendly. This kernel implements the elementary
 * sum-of-Bernoulli identity instead:
 *
 *   X = sum_{j=0}^{n-1} 1[ U_j < p ],   U_j ~ Uniform[0,1) i.i.d.
 *
 * which is exactly Binomial(n, p) for non-negative integer n and p in
 * [0,1], with no lgamma and no rejection loop. As in Poisson's Knuth loop,
 * PhiloxRandom is a harness call (cannot run inside __simd_vf__), so the
 * trial loop lives in ProcessTile: a fixed N_MAX steps; on step j a fresh
 * independent uniform is drawn (Philox counter word2 = j) and the per-
 * element predicate (j < n) AND (u < p) increments k. Host TORCH_CHECK
 * enforces max(count) <= N_MAX so there is no truncation. Large n / real
 * count / the np>=10 BTRS speedup are deferred (BTRS rejection is data-
 * dependent control flow + log; real count needs lgamma, no Reg primitive).
 *
 * Edges fall out of the predicates (host already rejected invalid n/p):
 * p==0 -> u<0 never (u>=0) -> k=0;  p==1 -> u<1 always (u in [0,1)) ->
 * counts all j<n -> k=n;  n==0 -> j<n never -> k=0. PyTorch is lenient on
 * out-of-range (NaN prob -> NaN, prob>1 -> count, real count); this op
 * rejects those on host per the repo's conservative convention -- identical
 * distribution for valid inputs.
 *
 * RegBase 3-layer shape; cmpsel forms reuse the validated Poisson
 * pattern (CMPMODE lives in AscendC::, Reg::Select(dst,src0,src1,mask) with
 * mask 4th). Reproducibility / statistical acceptance match Poisson (see
 * tests/binomial/test_binomial.py).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "adv_api/math/philox.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Binomial {

// Bernoulli-trial cap. Host enforces max(count) <= N_MAX => no truncation.
constexpr int64_t N_MAX = 128;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("binomial(Tensor count, Tensor prob, int seed=0) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor binomial_meta(const torch::Tensor &count, const torch::Tensor &prob, int64_t seed)
{
    (void)seed;
    TORCH_CHECK(count.scalar_type() == torch::kFloat32 ||
                count.scalar_type() == torch::kFloat16,
                "binomial: only float32 and float16 are supported on dav-3510, got ",
                count.scalar_type());
    TORCH_CHECK(count.scalar_type() == prob.scalar_type(),
                "binomial: count and prob must have the same dtype");
    TORCH_CHECK(count.sizes() == prob.sizes(),
                "binomial: count and prob must have the same shape");
    return torch::empty_like(count);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("binomial", binomial_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // UB per element: 2 input queues (count, prob) + 1 output queue, all
    // double-buffered, + 4 float scratch (n, p, k, u).
    constexpr static int64_t SCRATCH_FLOATS = 4;
    constexpr static int64_t MAX_TILE_ELEMS = 32768;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "binomial: coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t bytesPerElem = PIPELINE_DEPTH * 3 * elemSize +
        SCRATCH_FLOATS * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / static_cast<int64_t>(sizeof(float));
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min(tileElems, MAX_TILE_ELEMS);
    TORCH_CHECK(tileElems > 0, "binomial: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel =====================

// half -> float cast for fp16 inputs.
__simd_vf__ inline void CastHalfToFloatRegVf(__ubuf__ float *dstAddr, __ubuf__ half *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, half, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastHalfToFloatReg(AscendC::LocalTensor<float> &dst,
                                          AscendC::LocalTensor<half> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ half *srcAddr = (__ubuf__ half *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastHalfToFloatRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

// k = 0 (Bernoulli accumulator init).
__simd_vf__ inline void InitKRegVf(__ubuf__ float *kAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> kReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<float>(kReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            kAddr + offset, kReg, mask);
    }
}

__aicore__ inline void InitKReg(AscendC::LocalTensor<float> &k, int64_t count)
{
    __ubuf__ float *kAddr = (__ubuf__ float *)k.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<InitKRegVf>(kAddr, elementCount, chunkCount);
}

// One Bernoulli trial j: k += ((j < n) && (u < p)) ? 1 : 0.
// CMPMODE lives in AscendC:: ; Select(dst,src0,src1,mask): mask-true->src0.
__simd_vf__ inline void BernoulliStepRegVf(__ubuf__ float *kAddr, __ubuf__ float *nAddr,
                                           __ubuf__ float *pAddr, __ubuf__ float *uAddr,
                                           float jf, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> kReg;
    AscendC::Reg::RegTensor<float> nReg;
    AscendC::Reg::RegTensor<float> pReg;
    AscendC::Reg::RegTensor<float> uReg;
    AscendC::Reg::RegTensor<float> kp1Reg;
    AscendC::Reg::RegTensor<float> selReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(kReg, kAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(nReg, nAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(pReg, pAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(uReg, uAddr + offset);
        // jOK = (j < n)  ==  (n > j)   (j is a scalar broadcast)
        AscendC::Reg::MaskReg jOK;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(jOK, nReg, jf, mask);
        // succ = (u < p)
        AscendC::Reg::MaskReg succ;
        AscendC::Reg::Compare<float, AscendC::CMPMODE::LT>(succ, uReg, pReg, mask);
        // both = jOK && succ
        AscendC::Reg::MaskReg both;
        AscendC::Reg::And(both, jOK, succ, mask);
        // k = both ? k+1 : k
        AscendC::Reg::Adds(kp1Reg, kReg, 1.0f, mask);
        AscendC::Reg::Select(selReg, kp1Reg, kReg, both);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            kAddr + offset, selReg, mask);
    }
}

__aicore__ inline void BernoulliStepReg(AscendC::LocalTensor<float> &k,
                                        AscendC::LocalTensor<float> &n,
                                        AscendC::LocalTensor<float> &p,
                                        AscendC::LocalTensor<float> &u,
                                        float jf, int64_t count)
{
    __ubuf__ float *kAddr = (__ubuf__ float *)k.GetPhyAddr();
    __ubuf__ float *nAddr = (__ubuf__ float *)n.GetPhyAddr();
    __ubuf__ float *pAddr = (__ubuf__ float *)p.GetPhyAddr();
    __ubuf__ float *uAddr = (__ubuf__ float *)u.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BernoulliStepRegVf>(kAddr, nAddr, pAddr, uAddr, jf, elementCount, chunkCount);
}

// float -> half cast for fp16 output (mirrors poisson/cauchy path).
__simd_vf__ inline void CastFloatToHalfRegVf(__ubuf__ half *dstAddr, __ubuf__ float *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<half> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<half, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastFloatToHalfReg(AscendC::LocalTensor<half> &dst,
                                          AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ half *dstAddr = (__ubuf__ half *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFloatToHalfRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
class KernelBinomial {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;

public:
    __aicore__ inline KernelBinomial() {}

    __aicore__ inline void Init(GM_ADDR countGm, GM_ADDR probGm, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, int64_t tileElems,
        uint32_t key0, uint32_t key1)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        blockBase_ = blockLength * blockIdx;
        countGm_.SetGlobalBuffer((__gm__ T *)countGm + blockBase_);
        probGm_.SetGlobalBuffer((__gm__ T *)probGm + blockBase_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockBase_);

        pipe_.InitBuffer(inQueueCount_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(inQueueProb_,  PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueueY_,    PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufN_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufP_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufK_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufU_, tileElems * sizeof(float));

        key0_ = key0;
        key1_ = key1;

        int64_t currentBlockLength = totalLength - blockBase_;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileElems;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
        alignElems_ = 32 / static_cast<int64_t>(sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignedCount = ((count + alignElems_ - 1) / alignElems_) * alignElems_;

        AscendC::DataCopyExtParams inParams;
        inParams.blockCount = 1;
        inParams.blockLen = count * sizeof(T);
        inParams.srcStride = 0;
        inParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

        AscendC::LocalTensor<T> cLocal = inQueueCount_.template AllocTensor<T>();
        AscendC::DataCopyPad(cLocal, countGm_[offset], inParams, padParams);
        inQueueCount_.EnQue(cLocal);
        cLocal = inQueueCount_.template DeQue<T>();

        AscendC::LocalTensor<T> prLocal = inQueueProb_.template AllocTensor<T>();
        AscendC::DataCopyPad(prLocal, probGm_[offset], inParams, padParams);
        inQueueProb_.EnQue(prLocal);
        prLocal = inQueueProb_.template DeQue<T>();

        AscendC::LocalTensor<float> nLocal = tbufN_.Get<float>();
        AscendC::LocalTensor<float> pLocal = tbufP_.Get<float>();
        AscendC::LocalTensor<float> kLocal = tbufK_.Get<float>();
        AscendC::LocalTensor<float> uLocal = tbufU_.Get<float>();

        if constexpr (kIsFloat) {
            AscendC::DataCopy(nLocal, cLocal, alignedCount);
            AscendC::DataCopy(pLocal, prLocal, alignedCount);
        } else {
            CastHalfToFloatReg(nLocal, cLocal, alignedCount);
            CastHalfToFloatReg(pLocal, prLocal, alignedCount);
        }
        inQueueCount_.FreeTensor(cLocal);
        inQueueProb_.FreeTensor(prLocal);
        AscendC::PipeBarrier<PIPE_V>();

        InitKReg(kLocal, alignedCount);                   // k = 0
        AscendC::PipeBarrier<PIPE_V>();

        int64_t globalElem = blockBase_ + offset;
        uint32_t ctrLo = static_cast<uint32_t>(static_cast<uint64_t>(globalElem) & 0xFFFFFFFFu);
        uint32_t ctrHi = static_cast<uint32_t>((static_cast<uint64_t>(globalElem) >> 32) & 0xFFFFFFFFu);
        AscendC::PhiloxKey key{key0_, key1_};

        for (int64_t j = 0; j < N_MAX; ++j) {
            AscendC::PhiloxCounter ctr{ctrLo, ctrHi, static_cast<uint32_t>(j), 0u};
            AscendC::PhiloxRandom<7, float>(uLocal, key, ctr,
                static_cast<uint16_t>(alignedCount));
            AscendC::PipeBarrier<PIPE_V>();
            BernoulliStepReg(kLocal, nLocal, pLocal, uLocal,
                static_cast<float>(j), alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
        }

        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(yLocal, kLocal, alignedCount);  // k is the result
        } else {
            CastFloatToHalfReg(yLocal, kLocal, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.template DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> countGm_;
    AscendC::GlobalTensor<T> probGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueCount_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueProb_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufN_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufP_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufK_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufU_;
    int64_t blockBase_ = 0;
    uint32_t key0_ = 0;
    uint32_t key1_ = 0;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
    int64_t alignElems_ = 8;
};

template <typename T>
__global__ __aicore__ __vector__ void binomial_kernel(
    GM_ADDR countGm, GM_ADDR probGm, GM_ADDR y, int64_t totalLength,
    int64_t blockLength, int64_t tileElems, uint32_t key0, uint32_t key1)
{
    KernelBinomial<T> op;
    op.Init(countGm, probGm, y, totalLength, blockLength, tileElems, key0, key1);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor binomial_npu(const torch::Tensor &count, const torch::Tensor &prob, int64_t seed)
{
    TORCH_CHECK(count.scalar_type() == torch::kFloat32 ||
                count.scalar_type() == torch::kFloat16,
                "binomial: only float32 and float16 are supported on dav-3510, got ",
                count.scalar_type());
    TORCH_CHECK(count.scalar_type() == prob.scalar_type(),
                "binomial: count and prob must have the same dtype");
    TORCH_CHECK(count.sizes() == prob.sizes(),
                "binomial: count and prob must have the same shape");

    if (count.numel() > 0) {
        // Validate parameters on host copies (robust; avoids relying on a
        // PrivateUse1 reduction). PyTorch is lenient on out-of-range; this
        // op rejects per the repo's conservative convention.
        auto cc = count.detach().to(torch::kCPU).to(torch::kFloat32);
        auto pc = prob.detach().to(torch::kCPU).to(torch::kFloat32);
        TORCH_CHECK(cc.min().item<double>() >= 0.0 &&
                    torch::equal(cc, cc.floor()),
                    "binomial expects count to be a non-negative integer tensor");
        TORCH_CHECK(cc.max().item<double>() <= static_cast<double>(N_MAX),
                    "binomial: count exceeds the supported maximum (", N_MAX,
                    "); larger n is deferred to the BTRS path");
        TORCH_CHECK(!pc.isnan().any().item<bool>() &&
                    pc.min().item<double>() >= 0.0 &&
                    pc.max().item<double>() <= 1.0,
                    "binomial expects prob to be in [0, 1]");
    }

    const c10::OptionalDeviceGuard guard(count.device());
    auto y = torch::empty_like(count);

    int64_t totalLength = y.numel();
    if (totalLength == 0) {
        return y;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(totalLength, y.element_size());

    auto count_ptr = (GM_ADDR)count.data_ptr();
    auto prob_ptr = (GM_ADDR)prob.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();
    uint32_t key0 = static_cast<uint32_t>(static_cast<uint64_t>(seed) & 0xFFFFFFFFu);
    uint32_t key1 = static_cast<uint32_t>((static_cast<uint64_t>(seed) >> 32) & 0xFFFFFFFFu);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            count.scalar_type(), "binomial_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                binomial_kernel<float><<<numBlocks, nullptr, stream>>>(
                    count_ptr, prob_ptr, y_ptr, totalLength, blockLength,
                    tileElems, key0, key1);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                binomial_kernel<half><<<numBlocks, nullptr, stream>>>(
                    count_ptr, prob_ptr, y_ptr, totalLength, blockLength,
                    tileElems, key0, key1);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Binomial", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("binomial", binomial_npu);
}

} // namespace Binomial
} // namespace ops_multimodal_fusion
