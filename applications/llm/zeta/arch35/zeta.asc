/*!
 * \file zeta.asc
 * \brief Hurwitz Zeta operator for Ascend NPU (dav-3510)
 *
 * torch.special.zeta(x, q) -> y
 *   y = zeta(x, q) = sum_{k=0}^{inf} (q + k)^(-x)
 *
 * Scope: float32 compute with float32 / float16 / bfloat16 operator dtypes,
 * valid-domain x > 1 and q > 0. Non-float32 inputs are cast on NPU to the
 * float32 Reg compute path and cast back to the original dtype.
 *
 * Algorithm:
 *   Fixed direct sum over k = 0..N-1 (N = 16), followed by an Euler-Maclaurin
 *   tail with three Bernoulli correction terms:
 *
 *     zeta(x, q) ~= sum_{k=0}^{N-1} (q+k)^(-x)
 *       + t^(1-x)/(x-1) + 0.5*t^(-x)
 *       + x/12*t^(-x-1)
 *       - x*(x+1)*(x+2)/720*t^(-x-3)
 *       + x*(x+1)*(x+2)*(x+3)*(x+4)/30240*t^(-x-5),  t = q + N, N = 16.
 *
 *   (q+k)^(-x) is evaluated as exp(-x*ln(q+k)) using the hardware Reg::Ln /
 *   Reg::Exp primitives, which are accurate across the full positive base range.
 *   An earlier revision used an atanh-style log series centered at base 4; that
 *   series lost accuracy for large bases (q+N up to ~74 for q up to 50),
 *   producing ~1-3% relative error at large q. Reg::Ln removes that error source.
 *
 * The compute path follows the asc-from-scratch Ascend950 Reg shape:
 * __simd_vf__ Reg functions, __aicore__ asc_vf_call wrappers, and normal
 * AscendC code only for GM/UB movement, queues, and synchronization.
 * Host dispatch does shape checks and launch only; it does not fall back to CPU
 * or call helper NPU ops for casts/broadcasts.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <ATen/ExpandUtils.h>
#include <algorithm>
#include <cmath>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Zeta {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("zeta(Tensor x, Tensor q) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor zeta_meta(const torch::Tensor &x, const torch::Tensor &q)
{
    TORCH_CHECK(x.scalar_type() == q.scalar_type(),
                "zeta: x and q must have the same dtype, got ",
                x.scalar_type(), " vs ", q.scalar_type());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16 ||
                x.scalar_type() == torch::kBFloat16,
                "zeta: only float32, float16 and bfloat16 are supported on dav-3510, got ",
                x.scalar_type());
    auto out_shape = at::infer_size(x.sizes(), q.sizes());
    return torch::empty(out_shape, x.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("zeta", zeta_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t SCRATCH_BUFS = 9;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "zeta: coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t bytesPerElem = PIPELINE_DEPTH * 3 * elemSize +
        SCRATCH_BUFS * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    TORCH_CHECK(tileElems > 0, "zeta: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel =====================

static constexpr int64_t kDirectTerms = 16;

// (BASE)^(-x) = exp(-x * ln(BASE)), using the hardware Reg::Ln / Reg::Exp
// primitives (accurate over the full positive base range). DST holds the result;
// logReg is used as scratch for ln(BASE).
#define ZETA_POW_NEG_X(DST, BASE) \
    AscendC::Reg::Ln(logReg, BASE, mask); \
    AscendC::Reg::Mul(tmpReg, xReg, logReg, mask); \
    AscendC::Reg::Muls(tmpReg, tmpReg, -1.0f, mask); \
    AscendC::Reg::Exp(DST, tmpReg, mask)

#define ZETA_DIRECT_STEP(K) \
    AscendC::Reg::Adds(qReg, qBaseReg, static_cast<float>(K), mask); \
    ZETA_POW_NEG_X(termReg, qReg); \
    AscendC::Reg::Add(sumReg, sumReg, termReg, mask)

__simd_vf__ inline void ZetaRegVf(__ubuf__ float *yAddr, __ubuf__ float *xAddr,
                                  __ubuf__ float *qAddr, uint32_t count,
                                  uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> qBaseReg;
    AscendC::Reg::RegTensor<float> qReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> tmpReg;
    AscendC::Reg::RegTensor<float> termReg;
    AscendC::Reg::RegTensor<float> invReg;
    AscendC::Reg::RegTensor<float> logReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            qBaseReg, qAddr + offset);
        AscendC::Reg::Duplicate<float>(sumReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);

        ZETA_DIRECT_STEP(0);
        ZETA_DIRECT_STEP(1);
        ZETA_DIRECT_STEP(2);
        ZETA_DIRECT_STEP(3);
        ZETA_DIRECT_STEP(4);
        ZETA_DIRECT_STEP(5);
        ZETA_DIRECT_STEP(6);
        ZETA_DIRECT_STEP(7);
        ZETA_DIRECT_STEP(8);
        ZETA_DIRECT_STEP(9);
        ZETA_DIRECT_STEP(10);
        ZETA_DIRECT_STEP(11);
        ZETA_DIRECT_STEP(12);
        ZETA_DIRECT_STEP(13);
        ZETA_DIRECT_STEP(14);
        ZETA_DIRECT_STEP(15);

        // Euler-Maclaurin tail at t = q + N.
        AscendC::Reg::Adds(qReg, qBaseReg, static_cast<float>(kDirectTerms), mask);
        AscendC::Reg::Div(invReg, oneReg, qReg, mask);
        ZETA_POW_NEG_X(termReg, qReg);                 // termReg = t^(-x)

        // t^(1-x)/(x-1) = (t * t^(-x)) / (x-1)
        AscendC::Reg::Mul(tmpReg, termReg, qReg, mask);
        AscendC::Reg::Sub(logReg, xReg, oneReg, mask);
        AscendC::Reg::Div(tmpReg, tmpReg, logReg, mask);
        AscendC::Reg::Add(sumReg, sumReg, tmpReg, mask);

        // 0.5 * t^(-x)
        AscendC::Reg::Muls(tmpReg, termReg, 0.5f, mask);
        AscendC::Reg::Add(sumReg, sumReg, tmpReg, mask);

        // x/12 * t^(-x-1)
        AscendC::Reg::Mul(tmpReg, termReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, xReg, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 1.0f / 12.0f, mask);
        AscendC::Reg::Add(sumReg, sumReg, tmpReg, mask);

        // -x*(x+1)*(x+2)/720 * t^(-x-3)
        AscendC::Reg::Mul(tmpReg, termReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, xReg, mask);
        AscendC::Reg::Add(logReg, xReg, oneReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, logReg, mask);
        AscendC::Reg::Adds(logReg, xReg, 2.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, logReg, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, -1.0f / 720.0f, mask);
        AscendC::Reg::Add(sumReg, sumReg, tmpReg, mask);

        // +x*(x+1)*(x+2)*(x+3)*(x+4)/30240 * t^(-x-5)
        AscendC::Reg::Mul(tmpReg, termReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, invReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, xReg, mask);
        AscendC::Reg::Add(logReg, xReg, oneReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, logReg, mask);
        AscendC::Reg::Adds(logReg, xReg, 2.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, logReg, mask);
        AscendC::Reg::Adds(logReg, xReg, 3.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, logReg, mask);
        AscendC::Reg::Adds(logReg, xReg, 4.0f, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, logReg, mask);
        AscendC::Reg::Muls(tmpReg, tmpReg, 1.0f / 30240.0f, mask);
        AscendC::Reg::Add(sumReg, sumReg, tmpReg, mask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            yAddr + offset, sumReg, mask);
    }
}

__aicore__ inline void ZetaReg(AscendC::LocalTensor<float> &y,
                               AscendC::LocalTensor<float> &x,
                               AscendC::LocalTensor<float> &q,
                               int64_t count)
{
    __ubuf__ float *yAddr = (__ubuf__ float *)y.GetPhyAddr();
    __ubuf__ float *xAddr = (__ubuf__ float *)x.GetPhyAddr();
    __ubuf__ float *qAddr = (__ubuf__ float *)q.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ZetaRegVf>(yAddr, xAddr, qAddr, elementCount, chunkCount);
}

template <typename T>
__simd_vf__ inline void CastToFloatRegVf(__ubuf__ float *dstAddr, __ubuf__ T *srcAddr,
                                         uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastToFloatReg(AscendC::LocalTensor<float> &dst,
                                      AscendC::LocalTensor<T> &src,
                                      int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T, AscendC::RoundMode ROUND>
__simd_vf__ inline void CastFromFloatRegVf(__ubuf__ T *dstAddr, __ubuf__ float *srcAddr,
                                           uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        ROUND};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<T, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T, AscendC::RoundMode ROUND>
__aicore__ inline void CastFromFloatReg(AscendC::LocalTensor<T> &dst,
                                        AscendC::LocalTensor<float> &src,
                                        int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFromFloatRegVf<T, ROUND>>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
__simd_vf__ inline void BroadcastScalarRegVf(__ubuf__ T *dstAddr, uint32_t count,
                                             uint32_t chunkCount)
{
    // Chunk by the ELEMENT width of T, not float: a B16 register holds 128 bf16
    // lanes, so float-width (64-lane) chunking + UpdateMask<float> only covers half
    // the lanes per chunk -> the odd 2-byte lanes keep stale values (wrong, finite).
    // sizeof(T)==sizeof(float) for fp32 so that path is unchanged.
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> scalarReg;
    AscendC::Reg::RegTensor<T> dstReg;
    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(scalarReg, dstAddr);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::Duplicate<T>(dstReg, scalarReg, mask);
        // The store distribution must match the element width. A B16 RegTensor
        // (half / bfloat16_t) stored with DIST_NORM_B32 lays values out on a
        // 4-byte stride, so only every other 2-byte slot receives the scalar and
        // the rest is garbage (the source of inf at exactly half the positions in
        // the bf16 column-broadcast path). Use DIST_NORM_B16 for 2-byte types.
        if constexpr (sizeof(T) == sizeof(float)) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + offset, dstReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
                dstAddr + offset, dstReg, mask);
        }
    }
}

template <typename T>
__aicore__ inline void BroadcastScalarReg(AscendC::LocalTensor<T> &dst, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    // Match the vf's T-width lane chunking (B16 register = 128 bf16 lanes).
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<BroadcastScalarRegVf<T>>(dstAddr, elementCount, chunkCount);
}

template <typename T>
class KernelZeta {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;
    static constexpr bool kIsBf16 = std::is_same<T, bfloat16_t>::value;
    static constexpr AscendC::RoundMode kCastOutRound =
        kIsBf16 ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;

public:
    __aicore__ inline KernelZeta() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR q, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileElems)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockLength * AscendC::GetBlockIdx());
        qGm_.SetGlobalBuffer((__gm__ T *)q + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(inQueueQ_,  PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufX_,     tileElems * sizeof(float));
        pipe_.InitBuffer(tbufOut_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufQ_,     tileElems * sizeof(float));
        pipe_.InitBuffer(tbufQWork_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufTerm_,  tileElems * sizeof(float));
        pipe_.InitBuffer(tbufLog_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufTmp_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufOne_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufDenom_, tileElems * sizeof(float));

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileElems;
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padXParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(2.0f)};
        AscendC::DataCopyPadExtParams<T> padQParams{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(1.0f)};

        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        AscendC::LocalTensor<T> qLocal = inQueueQ_.template AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padXParams);
        AscendC::DataCopyPad(qLocal, qGm_[offset], copyParams, padQParams);
        inQueueX_.EnQue(xLocal);
        inQueueQ_.EnQue(qLocal);
        xLocal = inQueueX_.template DeQue<T>();
        qLocal = inQueueQ_.template DeQue<T>();

        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            ZetaReg(yLocal, xLocal, qLocal, alignedCount);
        } else {
            auto xFloat = tbufX_.Get<float>();
            auto qFloat = tbufQ_.Get<float>();
            CastToFloatReg<T>(xFloat, xLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastToFloatReg<T>(qFloat, qLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            auto yFloat = tbufOut_.Get<float>();
            ZetaReg(yFloat, xFloat, qFloat, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastFromFloatReg<T, kCastOutRound>(yLocal, yFloat, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueQ_.FreeTensor(qLocal);
        yLocal = outQueueY_.template DeQue<T>();
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, qGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufQWork_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufTerm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufLog_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufTmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOne_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufDenom_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void zeta_kernel(
    GM_ADDR x, GM_ADDR q, GM_ADDR y,
    int64_t totalLength, int64_t blockLength, uint32_t tileElems)
{
    KernelZeta<T> op;
    op.Init(x, q, y, totalLength, blockLength, tileElems);
    op.Process();
}

template <typename T>
class KernelZetaBroadcast2d {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;
    static constexpr bool kIsBf16 = std::is_same<T, bfloat16_t>::value;
    static constexpr AscendC::RoundMode kCastOutRound =
        kIsBf16 ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;

public:
    __aicore__ inline KernelZetaBroadcast2d() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR q, GM_ADDR y,
        int64_t rows, int64_t cols, int64_t xRows, int64_t xCols,
        int64_t qRows, int64_t qCols, int64_t rowsPerBlock, uint32_t tileElems)
    {
        rows_ = rows;
        cols_ = cols;
        xRows_ = xRows;
        xCols_ = xCols;
        qRows_ = qRows;
        qCols_ = qCols;
        rowsPerBlock_ = rowsPerBlock;
        blockRowStart_ = AscendC::GetBlockIdx() * rowsPerBlock;
        int64_t remaining = rows - blockRowStart_;
        blockRows_ = (remaining < rowsPerBlock) ? remaining : rowsPerBlock;
        if (blockRows_ < 0) {
            blockRows_ = 0;
        }
        tileElems_ = tileElems;

        xGm_.SetGlobalBuffer((__gm__ T *)x);
        qGm_.SetGlobalBuffer((__gm__ T *)q);
        yGm_.SetGlobalBuffer((__gm__ T *)y);

        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(inQueueQ_,  PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufX_,     tileElems * sizeof(float));
        pipe_.InitBuffer(tbufOut_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufQ_,     tileElems * sizeof(float));
        pipe_.InitBuffer(tbufQWork_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufTerm_,  tileElems * sizeof(float));
        pipe_.InitBuffer(tbufLog_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufTmp_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufOne_,   tileElems * sizeof(float));
        pipe_.InitBuffer(tbufDenom_, tileElems * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int64_t r = 0; r < blockRows_; ++r) {
            int64_t row = blockRowStart_ + r;
            for (int64_t col = 0; col < cols_; col += tileElems_) {
                int64_t count = cols_ - col;
                if (count > tileElems_) {
                    count = tileElems_;
                }
                ProcessTile(row, col, count);
            }
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        return copyParams;
    }

    __aicore__ inline void LoadBroadcasted(
        AscendC::LocalTensor<T> &local, AscendC::GlobalTensor<T> &gm,
        int64_t row, int64_t col, int64_t count, int64_t alignedCount,
        int64_t inRows, int64_t inCols, T padValue)
    {
        int64_t srcRow = (inRows == 1) ? 0 : row;
        if (inCols == 1) {
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(local, gm[srcRow], CopyParams(1), padParams);
            inQueueX_.EnQue(local);
            local = inQueueX_.template DeQue<T>();
            BroadcastScalarReg<T>(local, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
        } else {
            int64_t srcOffset = srcRow * inCols + col;
            AscendC::DataCopyPadExtParams<T> padParams{
                true, 0, static_cast<uint8_t>(alignedCount - count), padValue};
            AscendC::DataCopyPad(local, gm[srcOffset], CopyParams(count), padParams);
            inQueueX_.EnQue(local);
            local = inQueueX_.template DeQue<T>();
        }
    }

    __aicore__ inline void LoadBroadcastedQ(
        AscendC::LocalTensor<T> &local, AscendC::GlobalTensor<T> &gm,
        int64_t row, int64_t col, int64_t count, int64_t alignedCount,
        int64_t inRows, int64_t inCols, T padValue)
    {
        int64_t srcRow = (inRows == 1) ? 0 : row;
        if (inCols == 1) {
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(local, gm[srcRow], CopyParams(1), padParams);
            inQueueQ_.EnQue(local);
            local = inQueueQ_.template DeQue<T>();
            BroadcastScalarReg<T>(local, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
        } else {
            int64_t srcOffset = srcRow * inCols + col;
            AscendC::DataCopyPadExtParams<T> padParams{
                true, 0, static_cast<uint8_t>(alignedCount - count), padValue};
            AscendC::DataCopyPad(local, gm[srcOffset], CopyParams(count), padParams);
            inQueueQ_.EnQue(local);
            local = inQueueQ_.template DeQue<T>();
        }
    }

    __aicore__ inline void ProcessTile(int64_t row, int64_t col, int64_t count)
    {
        int64_t alignElems = 32 / static_cast<int64_t>(sizeof(T));
        int64_t alignedCount = ((count + alignElems - 1) / alignElems) * alignElems;
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        AscendC::LocalTensor<T> qLocal = inQueueQ_.template AllocTensor<T>();
        LoadBroadcasted(xLocal, xGm_, row, col, count, alignedCount,
                        xRows_, xCols_, static_cast<T>(2.0f));
        LoadBroadcastedQ(qLocal, qGm_, row, col, count, alignedCount,
                         qRows_, qCols_, static_cast<T>(1.0f));

        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            ZetaReg(yLocal, xLocal, qLocal, alignedCount);
        } else {
            auto xFloat = tbufX_.Get<float>();
            auto qFloat = tbufQ_.Get<float>();
            CastToFloatReg<T>(xFloat, xLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastToFloatReg<T>(qFloat, qLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            auto yFloat = tbufOut_.Get<float>();
            ZetaReg(yFloat, xFloat, qFloat, alignedCount);
            AscendC::PipeBarrier<PIPE_V>();
            CastFromFloatReg<T, kCastOutRound>(yLocal, yFloat, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueQ_.FreeTensor(qLocal);

        yLocal = outQueueY_.template DeQue<T>();
        AscendC::DataCopyPad(yGm_[row * cols_ + col], yLocal, CopyParams(count));
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, qGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufQWork_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufTerm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufLog_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufTmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOne_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufDenom_;
    int64_t rows_ = 0;
    int64_t cols_ = 0;
    int64_t xRows_ = 0;
    int64_t xCols_ = 0;
    int64_t qRows_ = 0;
    int64_t qCols_ = 0;
    int64_t rowsPerBlock_ = 0;
    int64_t blockRowStart_ = 0;
    int64_t blockRows_ = 0;
    int64_t tileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void zeta_broadcast2d_kernel(
    GM_ADDR x, GM_ADDR q, GM_ADDR y,
    int64_t rows, int64_t cols, int64_t xRows, int64_t xCols,
    int64_t qRows, int64_t qCols, int64_t rowsPerBlock, uint32_t tileElems)
{
    KernelZetaBroadcast2d<T> op;
    op.Init(x, q, y, rows, cols, xRows, xCols, qRows, qCols, rowsPerBlock, tileElems);
    op.Process();
}

// ===================== 6. NPU dispatch =====================

torch::Tensor zeta_npu(const torch::Tensor &x_in, const torch::Tensor &q_in)
{
    TORCH_CHECK(x_in.scalar_type() == q_in.scalar_type(),
                "zeta: x and q must have the same dtype, got ",
                x_in.scalar_type(), " vs ", q_in.scalar_type());
    TORCH_CHECK(x_in.scalar_type() == torch::kFloat32 ||
                x_in.scalar_type() == torch::kFloat16 ||
                x_in.scalar_type() == torch::kBFloat16,
                "zeta: only float32, float16 and bfloat16 are supported on dav-3510, got ",
                x_in.scalar_type());

    const c10::OptionalDeviceGuard guard(x_in.device());

    auto out_shape = at::infer_size(x_in.sizes(), q_in.sizes());

    auto x = x_in.contiguous();
    auto q = q_in.contiguous();
    auto y = torch::empty(out_shape, x_in.options());

    int64_t totalLength = y.numel();
    if (totalLength == 0) {
        return y;
    }
    bool needsBroadcast = (x_in.sizes() != out_shape) || (q_in.sizes() != out_shape);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) = calc_tiling_params(totalLength, x.element_size());

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto q_ptr = (GM_ADDR)q.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "zeta_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                if (needsBroadcast) {
                    TORCH_CHECK(out_shape.size() == 2 && x.sizes().size() == 2 && q.sizes().size() == 2,
                                "zeta: broadcast kernel currently supports non-empty 2D inputs, got ",
                                x.sizes(), " and ", q.sizes());
                    int64_t rows = out_shape[0];
                    int64_t cols = out_shape[1];
                    int64_t rowsPerBlock = (rows + numBlocks - 1) / numBlocks;
                    zeta_broadcast2d_kernel<float><<<numBlocks, nullptr, stream>>>(
                        x_ptr, q_ptr, y_ptr, rows, cols, x.size(0), x.size(1),
                        q.size(0), q.size(1), rowsPerBlock, tileElems);
                } else {
                    zeta_kernel<float><<<numBlocks, nullptr, stream>>>(
                        x_ptr, q_ptr, y_ptr, totalLength, blockLength, tileElems);
                }
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                if (needsBroadcast) {
                    TORCH_CHECK(out_shape.size() == 2 && x.sizes().size() == 2 && q.sizes().size() == 2,
                                "zeta: broadcast kernel currently supports non-empty 2D inputs, got ",
                                x.sizes(), " and ", q.sizes());
                    int64_t rows = out_shape[0];
                    int64_t cols = out_shape[1];
                    int64_t rowsPerBlock = (rows + numBlocks - 1) / numBlocks;
                    zeta_broadcast2d_kernel<half><<<numBlocks, nullptr, stream>>>(
                        x_ptr, q_ptr, y_ptr, rows, cols, x.size(0), x.size(1),
                        q.size(0), q.size(1), rowsPerBlock, tileElems);
                } else {
                    zeta_kernel<half><<<numBlocks, nullptr, stream>>>(
                        x_ptr, q_ptr, y_ptr, totalLength, blockLength, tileElems);
                }
            })
            AT_DISPATCH_CASE(torch::kBFloat16, [&] {
                if (needsBroadcast) {
                    TORCH_CHECK(out_shape.size() == 2 && x.sizes().size() == 2 && q.sizes().size() == 2,
                                "zeta: broadcast kernel currently supports non-empty 2D inputs, got ",
                                x.sizes(), " and ", q.sizes());
                    int64_t rows = out_shape[0];
                    int64_t cols = out_shape[1];
                    int64_t rowsPerBlock = (rows + numBlocks - 1) / numBlocks;
                    zeta_broadcast2d_kernel<bfloat16_t><<<numBlocks, nullptr, stream>>>(
                        x_ptr, q_ptr, y_ptr, rows, cols, x.size(0), x.size(1),
                        q.size(0), q.size(1), rowsPerBlock, tileElems);
                } else {
                    zeta_kernel<bfloat16_t><<<numBlocks, nullptr, stream>>>(
                        x_ptr, q_ptr, y_ptr, totalLength, blockLength, tileElems);
                }
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Zeta", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("zeta", zeta_npu);
}

} // namespace Zeta
} // namespace ops_multimodal_fusion
