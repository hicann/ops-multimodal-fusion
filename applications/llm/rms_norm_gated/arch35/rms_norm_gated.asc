    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<AddsRegVf>(dstAddr, srcAddr, value, elementCount, chunkCount);
}

__simd_vf__ inline void SqrtRegVf(__ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::RegTensor<float> srcReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void SqrtReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<SqrtRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void FinalizeRmsRegVf(
    __ubuf__ float *dstAddr,
    __ubuf__ float *srcAddr,
    float invHiddenSize,
    float epsilon,
    uint32_t count,
    uint32_t chunkCount)
{
    constexpr uint32_t reduceElems = BLOCK_BYTES / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> invReg;
    AscendC::Reg::RegTensor<float> meanReg;
    AscendC::Reg::RegTensor<float> epsReg;
    AscendC::Reg::RegTensor<float> rmsReg;

    (void)chunkCount;
    uint32_t rowCount = (count + reduceElems - 1) / reduceElems;
    AscendC::Reg::Duplicate<float>(invReg, invHiddenSize, scalarMask);

    for (uint32_t row = 0; row < rowCount; ++row) {
        uint32_t offset = row * reduceElems;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Mul(meanReg, srcReg, invReg, scalarMask);
        AscendC::Reg::Adds(epsReg, meanReg, epsilon, scalarMask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            rmsReg, epsReg, scalarMask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, rmsReg, scalarMask);
    }
}

__aicore__ inline void FinalizeRmsReg(
    const AscendC::LocalTensor<float> &dst,
    const AscendC::LocalTensor<float> &src,
    float invHiddenSize,
    float epsilon,
    int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<FinalizeRmsRegVf>(dstAddr, srcAddr, invHiddenSize, epsilon, elementCount, chunkCount);
}

__simd_vf__ inline void SigmoidRegVf(__ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> denomReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Muls(denomReg, srcReg, -1.0f, mask);
        AscendC::Reg::Exp(denomReg, denomReg, mask);
        AscendC::Reg::Adds(denomReg, denomReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Div(dstReg, oneReg, denomReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void SigmoidReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<SigmoidRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
__simd_vf__ inline void CastToFloatRegVf(
    __ubuf__ float *dstAddr, __ubuf__ T *srcAddr, uint32_t count, uint32_t chunkCount)
{
    static constexpr AscendC::Reg::CastTrait regCastToFloat = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::UNKNOWN};
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::RegTensor<T> srcReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, regCastToFloat>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastToFloatReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<T> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T>
__simd_vf__ inline void CastFromFloatRegVf(
    __ubuf__ T *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    static constexpr AscendC::Reg::CastTrait regCastFromFloat = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_RINT};
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<T> dstReg;
    AscendC::Reg::RegTensor<float> srcReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<T, float, regCastFromFloat>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastFromFloatReg(
    const AscendC::LocalTensor<T> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFromFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

// 1. Register the operator's schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("rms_norm_gated(Tensor hidden_states, Tensor gate, Tensor gamma, float epsilon=1e-6) -> Tensor");
}

// 2. Meta function: shape/dtype inference without computation
torch::Tensor rms_norm_gated_meta(const torch::Tensor &hidden_states,
                                   const torch::Tensor &gate,
                                   const torch::Tensor &gamma,
                                   double epsilon)
{
    TORCH_CHECK(hidden_states.dim() >= 1,
        "hidden_states must have at least 1 dimension");
    TORCH_CHECK(gate.sizes() == hidden_states.sizes(),
        "gate shape must match hidden_states shape");
    TORCH_CHECK(gamma.dim() == 1 && gamma.size(0) == hidden_states.size(-1),
        "gamma must be 1D with size equal to last dim of hidden_states");
    return torch::empty_like(hidden_states);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("rms_norm_gated", rms_norm_gated_meta);
}

// 3. Tiling parameter calculation
// Returns (numBlocks, rowsPerBlock, tileHidden, batchSize)
std::tuple<int64_t, int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t totalRows, int64_t hiddenSize, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");

    int64_t numBlocks = std::min(coreNum, totalRows);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t rowsPerBlock = (totalRows + numBlocks - 1) / numBlocks;

    auto alignBytes = [](int64_t b) {
        return (b + BLOCK_BYTES - 1) / BLOCK_BYTES * BLOCK_BYTES;
    };
    int64_t hTAlignedElems = alignBytes(hiddenSize * elemSize) / elemSize;
    int64_t persistHBytes = hTAlignedElems * static_cast<int64_t>(sizeof(float));
    int64_t fixedMeta = BLOCK_BYTES + 1024;  // sumBuf + TBuf/TPipe slack

    // Single-pass with K-row batching:
    //   per-K bytes = K * alignedH * (inQueueDB 2*elemSize + outQueueDB 2*elemSize
    //                                + xBatch 4 + 3 scratch 3*4) + K * 32 (sumBuf per row)
    //               = K * alignedH * (4*elemSize + 16) + K * 32
    //   gamma buf (shared) = alignedH * 4
    int64_t perKBytes = hTAlignedElems * (4 * elemSize + 16) + BLOCK_BYTES;
    int64_t singlePassFixed = fixedMeta + persistHBytes;  // gamma + meta
    int64_t availForBatch = static_cast<int64_t>(ubSize) - singlePassFixed;

    int64_t tileHidden;
    int64_t batchSize = 1;
    bool alignedH = (hiddenSize * elemSize) % BLOCK_BYTES == 0;

    if (availForBatch >= perKBytes) {
        // At least K=1 row fits -> single-pass path
        tileHidden = hiddenSize;
        if (alignedH) {
            // Only batch when per-row DMA stride matches contiguous K*H layout
            batchSize = availForBatch / perKBytes;
            if (batchSize > rowsPerBlock) batchSize = rowsPerBlock;
            if (batchSize > BATCH_MAX) batchSize = BATCH_MAX;
            if (batchSize < 1) batchSize = 1;
        }
    } else {
        // Two-pass: only gammaBuf reserved, batch=1 implicit.
        // tileHidden MUST be aligned so tileHidden*elemSize is multiple of BLOCK_BYTES,
        // otherwise per-tile GM offsets/PreloadGamma last-tile writes can overflow gammaBuf.
        // tileHidden MUST be strictly < hiddenSize so kernel takes two-pass path
        // (singlePass_ = tileHidden >= hiddenSize allocates extra xFloatBuf_ + DB queues
        // that the two-pass budget did not account for).
        int64_t bytesPerElem = 4 * elemSize + 3 * static_cast<int64_t>(sizeof(float));
        int64_t twoPassFixed = fixedMeta + persistHBytes;
        int64_t ubAvail = static_cast<int64_t>(ubSize) - twoPassFixed;
        TORCH_CHECK(ubAvail > 0, "UB too small for gamma preload");
        int64_t alignElems = BLOCK_BYTES / elemSize;  // 16 for fp16/bf16, 8 for fp32
        tileHidden = (ubAvail / bytesPerElem / alignElems) * alignElems;
        if (tileHidden >= hiddenSize) {
            tileHidden = ((hiddenSize - 1) / alignElems) * alignElems;
        }
        if (tileHidden < alignElems) tileHidden = alignElems;
    }

    return std::make_tuple(numBlocks, rowsPerBlock, tileHidden, batchSize);
}

// 4. Kernel implementation
template <typename T>
class KernelRmsNormGated {
    static_assert(sizeof(T) == 2 || sizeof(T) == 4, "Only float, half and bfloat16 supported");
    static constexpr bool kIsFloat = (sizeof(T) == sizeof(float));

public:
    __aicore__ inline KernelRmsNormGated() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR gate, GM_ADDR gamma, GM_ADDR y,
        int64_t totalRows, int64_t hiddenSize, int64_t rowsPerBlock,
        int64_t tileHidden, int64_t batchSize, float epsilon)
    {
        hiddenSize_ = hiddenSize;
        tileHidden_ = tileHidden;
        batchSize_ = batchSize;
        epsilon_ = epsilon;
        invHiddenSize_ = 1.0f / static_cast<float>(hiddenSize);
        singlePass_ = (tileHidden >= hiddenSize);

        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalRows - blockIdx * rowsPerBlock;
        curRows_ = (remaining < rowsPerBlock) ? remaining : rowsPerBlock;
        if (curRows_ < 0) curRows_ = 0;

        xGm_.SetGlobalBuffer((__gm__ T*)x + blockIdx * rowsPerBlock * hiddenSize);
        gateGm_.SetGlobalBuffer((__gm__ T*)gate + blockIdx * rowsPerBlock * hiddenSize);
        gammaGm_.SetGlobalBuffer((__gm__ T*)gamma);
        yGm_.SetGlobalBuffer((__gm__ T*)y + blockIdx * rowsPerBlock * hiddenSize);

        int64_t hTAlignedElems = AlignedElemCount(hiddenSize);
        int64_t persistBytes = hTAlignedElems * static_cast<int64_t>(sizeof(float));

        if (singlePass_) {
            // Batch-sized buffers. For batchSize_==1 this degenerates to per-row.
            int64_t batchBytesT = batchSize_ * hTAlignedElems * static_cast<int64_t>(sizeof(T));
            int64_t batchBytesF = batchSize_ * hTAlignedElems * static_cast<int64_t>(sizeof(float));
            pipe_.InitBuffer(inQueue_, 2, batchBytesT);
            pipe_.InitBuffer(outQueue_, 2, batchBytesT);
            pipe_.InitBuffer(scratchBuf1_, batchBytesF);
            pipe_.InitBuffer(scratchBuf2_, batchBytesF);
            pipe_.InitBuffer(gammaScaledBuf_, batchBytesF);
            pipe_.InitBuffer(xFloatBuf_, batchBytesF);
            pipe_.InitBuffer(gammaBuf_, persistBytes);
            pipe_.InitBuffer(sumBuf_, batchSize_ * BLOCK_BYTES);
        } else {
            // Two-pass: per-tile sizing, batch=1 implicit
            int64_t tileTAlignedElems = AlignedElemCount(tileHidden);
            int64_t tileBytesT = tileTAlignedElems * static_cast<int64_t>(sizeof(T));
            int64_t tileBytesF = tileTAlignedElems * static_cast<int64_t>(sizeof(float));
            pipe_.InitBuffer(inQueue_, 2, tileBytesT);
            pipe_.InitBuffer(outQueue_, 2, tileBytesT);
            pipe_.InitBuffer(scratchBuf1_, tileBytesF);
            pipe_.InitBuffer(scratchBuf2_, tileBytesF);
            pipe_.InitBuffer(gammaScaledBuf_, tileBytesF);
            pipe_.InitBuffer(gammaBuf_, persistBytes);
            pipe_.InitBuffer(sumBuf_, BLOCK_BYTES);
        }

        if (curRows_ > 0) PreloadGamma();
    }

    __aicore__ inline void Process()
    {
        if (singlePass_) {
            for (int64_t row = 0; row < curRows_; row += batchSize_) {
                int64_t b = (curRows_ - row < batchSize_) ? (curRows_ - row) : batchSize_;
                ProcessBatch(row, b);
            }
        } else {
            for (int64_t row = 0; row < curRows_; ++row) {
                ProcessRowTwoPass(row);
            }
        }
    }

private:
    __aicore__ inline int64_t AlignUp(int64_t bytes)
    {
        return (bytes + BLOCK_BYTES - 1) / BLOCK_BYTES * BLOCK_BYTES;
    }

    __aicore__ inline int64_t AlignedElemCount(int64_t elems)
    {
        return AlignUp(elems * sizeof(T)) / static_cast<int64_t>(sizeof(T));
    }

    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t bytes)
    {
        AscendC::DataCopyExtParams p;
        p.blockCount = 1;
        p.blockLen = bytes;
        p.srcStride = 0;
        p.dstStride = 0;
        return p;
    }

    __aicore__ inline void LoadTileAsFloat(
        AscendC::GlobalTensor<T>& gm, int64_t offset, int64_t count,
        AscendC::LocalTensor<float> dst, int64_t alignedCount)
    {
        auto tile = inQueue_.template AllocTensor<T>();
        int64_t rightPad = alignedCount - count;
        auto p = CopyParams(count * sizeof(T));
        AscendC::DataCopyPadExtParams<T> pad{true, 0, static_cast<uint8_t>(rightPad), static_cast<T>(0)};
        AscendC::DataCopyPad(tile, gm[offset], p, pad);
        inQueue_.EnQue(tile);
        tile = inQueue_.template DeQue<T>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(dst, tile, alignedCount);
        } else {
            CastToFloatReg(dst, tile, alignedCount);
        }
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(tile);
    }

    __aicore__ inline void PreloadGamma()
    {
        auto gammaFloat = gammaBuf_.template Get<float>();
        int64_t tileH = singlePass_ ? hiddenSize_ : tileHidden_;
        for (int64_t off = 0; off < hiddenSize_; off += tileH) {
            int64_t len = (hiddenSize_ - off < tileH) ? (hiddenSize_ - off) : tileH;
            int64_t n = AlignedElemCount(len);
            LoadTileAsFloat(gammaGm_, off, len, gammaFloat[off], n);
        }
    }

    __aicore__ inline void ProcessBatch(int64_t rowStart, int64_t batch)
    {
        int64_t H = hiddenSize_;
        int64_t n = AlignedElemCount(H);  // per-row T-aligned float count (== H when H*sizeof(T) is 32B-aligned)
        int64_t rowOff = rowStart * H;
        int64_t total = batch * n;   // total float elements in batch
        int64_t totalDmaBytes = batch * H * sizeof(T);
        constexpr int64_t REDUCE_ELEMS = BLOCK_BYTES / static_cast<int64_t>(sizeof(float));

        // When batch>1, host has ensured H*sizeof(T) is 32B-aligned -> n == H -> rightPad == 0 and
        // (batch*n == batch*H) is one contiguous DMA with no intra-row padding.
        // When batch==1, rightPad = n-H pads the single row's tail. Both cases share LoadTileAsFloat.

        // === Load K rows of x (one DMA) ===
        auto xBatch = xFloatBuf_.template Get<float>();
        LoadTileAsFloat(xGm_, rowOff, batch * H, xBatch, total);

        // === Pass 1: sum of squares per row ===
        auto sqBuf = scratchBuf1_.template Get<float>();
        MulReg(sqBuf, xBatch, xBatch, total);
        AscendC::PipeBarrier<PIPE_V>();

        auto sumAccum = sumBuf_.template Get<float>();
        DuplicateReg(sumAccum, 0.0f, batch * REDUCE_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        ReduceSumSquaresRowsReg(sumAccum, sqBuf, batch, n, REDUCE_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        FinalizeRmsReg(sumAccum, sumAccum, invHiddenSize_, epsilon_, batch * REDUCE_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        // === Pass 2: gamma×invRms fused, silu(gate), multiply, cast out ===
        auto gammaFloat = gammaBuf_.template Get<float>();
        auto gammaScaled = gammaScaledBuf_.template Get<float>();
        ScaleGammaByRmsReg(gammaScaled, gammaFloat, sumAccum, batch, n, REDUCE_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        // Load K rows of gate (one DMA); sigmoid/silu/normalize batched over K*H.
        auto gateBatch = scratchBuf2_.template Get<float>();
        LoadTileAsFloat(gateGm_, rowOff, batch * H, gateBatch, total);

        auto sigBuf = scratchBuf1_.template Get<float>();  // reuse sqBuf (consumed)
        SigmoidReg(sigBuf, gateBatch, total);
        AscendC::PipeBarrier<PIPE_V>();
        MulReg(gateBatch, gateBatch, sigBuf, total);
        AscendC::PipeBarrier<PIPE_V>();

        MulReg(sigBuf, xBatch, gammaScaled, total);
        AscendC::PipeBarrier<PIPE_V>();
        MulReg(sigBuf, sigBuf, gateBatch, total);
        AscendC::PipeBarrier<PIPE_V>();

        auto outTile = outQueue_.template AllocTensor<T>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(outTile, sigBuf, total);
        } else {
            CastFromFloatReg(outTile, sigBuf, total);
        }
        outQueue_.EnQue(outTile);
        outTile = outQueue_.template DeQue<T>();
        auto cp = CopyParams(totalDmaBytes);
        AscendC::DataCopyPad(yGm_[rowOff], outTile, cp);
        outQueue_.FreeTensor(outTile);
    }

    __aicore__ inline void ProcessRowTwoPass(int64_t row)
    {
        int64_t H = hiddenSize_;
        int64_t tileH = tileHidden_;
        int64_t rowOff = row * H;
        constexpr int64_t REDUCE_ELEMS = BLOCK_BYTES / static_cast<int64_t>(sizeof(float));

        auto sumAccum = sumBuf_.template Get<float>();
        DuplicateReg(sumAccum, 0.0f, REDUCE_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        for (int64_t off = 0; off < H; off += tileH) {
            int64_t len = (H - off < tileH) ? (H - off) : tileH;
            int64_t n = AlignedElemCount(len);

            auto xFloat = scratchBuf1_.template Get<float>();
            LoadTileAsFloat(xGm_, rowOff + off, len, xFloat, n);
            MulReg(xFloat, xFloat, xFloat, n);
            AscendC::PipeBarrier<PIPE_V>();

            auto reduce = gammaScaledBuf_.template Get<float>();
            DuplicateReg(reduce, 0.0f, REDUCE_ELEMS);
            AscendC::PipeBarrier<PIPE_V>();
            ReduceSumReg(reduce, xFloat, n);
            AscendC::PipeBarrier<PIPE_V>();
            AccumulateReduceSumReg(sumAccum, reduce);
            AscendC::PipeBarrier<PIPE_V>();
        }

        FinalizeRmsReg(sumAccum, sumAccum, invHiddenSize_, epsilon_, REDUCE_ELEMS);
        AscendC::PipeBarrier<PIPE_V>();

        auto gammaFull = gammaBuf_.template Get<float>();
        for (int64_t off = 0; off < H; off += tileH) {
            int64_t len = (H - off < tileH) ? (H - off) : tileH;
            int64_t n = AlignedElemCount(len);

            auto gammaScaled = gammaScaledBuf_.template Get<float>();
            ScaleGammaByRmsReg(gammaScaled, gammaFull[off], sumAccum, 1, n, REDUCE_ELEMS);
            AscendC::PipeBarrier<PIPE_V>();

            auto xFloat = scratchBuf1_.template Get<float>();
            LoadTileAsFloat(xGm_, rowOff + off, len, xFloat, n);

            MulReg(xFloat, xFloat, gammaScaled, n);
            AscendC::PipeBarrier<PIPE_V>();

            auto gateFloat = scratchBuf2_.template Get<float>();
            LoadTileAsFloat(gateGm_, rowOff + off, len, gateFloat, n);

            SigmoidReg(gammaScaled, gateFloat, n);
            AscendC::PipeBarrier<PIPE_V>();
            MulReg(gateFloat, gateFloat, gammaScaled, n);
            AscendC::PipeBarrier<PIPE_V>();

            MulReg(xFloat, xFloat, gateFloat, n);
            AscendC::PipeBarrier<PIPE_V>();

            auto outTile = outQueue_.template AllocTensor<T>();
            if constexpr (kIsFloat) {
                AscendC::DataCopy(outTile, xFloat, n);
            } else {
                CastFromFloatReg(outTile, xFloat, n);
            }
            outQueue_.EnQue(outTile);
            outTile = outQueue_.template DeQue<T>();
            auto cp = CopyParams(len * sizeof(T));
            AscendC::DataCopyPad(yGm_[rowOff + off], outTile, cp);
            outQueue_.FreeTensor(outTile);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, gateGm_, gammaGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchBuf1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchBuf2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaScaledBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> gammaBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xFloatBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumBuf_;
    int64_t hiddenSize_ = 0;
    int64_t tileHidden_ = 0;
    int64_t batchSize_ = 1;
    int64_t curRows_ = 0;
    float epsilon_ = 0.0f;
    float invHiddenSize_ = 0.0f;
    bool singlePass_ = false;
};

template <typename T>
__global__ __aicore__ __vector__ void rms_norm_gated_kernel(
    GM_ADDR x, GM_ADDR gate, GM_ADDR gamma, GM_ADDR y,
    int64_t totalRows, int64_t hiddenSize, int64_t rowsPerBlock,
    int64_t tileHidden, int64_t batchSize, float epsilon)
{
    KernelRmsNormGated<T> op;
    op.Init(x, gate, gamma, y, totalRows, hiddenSize, rowsPerBlock, tileHidden, batchSize, epsilon);
    op.Process();
}

// 5. NPU dispatch function
torch::Tensor rms_norm_gated_npu(const torch::Tensor &hidden_states,
                                  const torch::Tensor &gate,
                                  const torch::Tensor &gamma,
                                  double epsilon)
{
    const c10::OptionalDeviceGuard guard(hidden_states.device());

    auto x = hidden_states.contiguous();
    auto g = gate.contiguous();
    auto gm = gamma.contiguous();

    int64_t hiddenSize = x.size(-1);
    int64_t totalRows = x.numel() / hiddenSize;

    auto y = torch::empty_like(x);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    float eps = static_cast<float>(epsilon);

    int64_t numBlocks, rowsPerBlock, tileHidden, batchSize;
    std::tie(numBlocks, rowsPerBlock, tileHidden, batchSize) = calc_tiling_params(
        totalRows, hiddenSize, x.element_size());

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto gate_ptr = (GM_ADDR)g.data_ptr();
    auto gamma_ptr = (GM_ADDR)gm.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "rms_norm_gated_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                rms_norm_gated_kernel<float><<<numBlocks, nullptr, stream>>>(
                    x_ptr, gate_ptr, gamma_ptr, y_ptr,
                    totalRows, hiddenSize, rowsPerBlock, tileHidden, batchSize, eps);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                rms_norm_gated_kernel<half><<<numBlocks, nullptr, stream>>>(
                    x_ptr, gate_ptr, gamma_ptr, y_ptr,
                    totalRows, hiddenSize, rowsPerBlock, tileHidden, batchSize, eps);
            })
            AT_DISPATCH_CASE(torch::kBFloat16, [&] {
                rms_norm_gated_kernel<bfloat16_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, gate_ptr, gamma_ptr, y_ptr,
                    totalRows, hiddenSize, rowsPerBlock, tileHidden, batchSize, eps);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("RmsNormGated", acl_call);

    return y;
}

// Register the NPU implementation
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("rms_norm_gated", rms_norm_gated_npu);
}

} // namespace RmsNormGated
} // namespace ops_multimodal_fusion
