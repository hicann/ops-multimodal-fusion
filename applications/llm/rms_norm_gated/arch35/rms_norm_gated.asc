/*!
 * \file rms_norm_gated.asc
 * \brief Fused RMSNorm + SiLU gate operator for Ascend NPU (dav-2201)
 *
 * rms_norm_gated(x, gate, gamma, eps) = rms_norm(x, gamma, eps) * silu(gate)
 *
 * where:
 *   rms_norm(x) = x / sqrt(mean(x^2, dim=-1, keepdim=True) + eps) * gamma
 *   silu(gate)  = gate * sigmoid(gate)
 *
 * Fast path (single-pass, row fits in UB): load x once into a persistent
 * float buffer, reduce-sum squares, then consume x for the normalize/gate
 * chain without a second GM round-trip. Gamma is preloaded once per block.
 * When H*sizeof(T) is 32B-aligned, K rows are fused into one iteration
 * (batch-row UB utilization) to amortize DMA setup + PipeBarrier fixed cost.
 * Slow path (multi-tile): two-pass over tiles, with gamma still preloaded.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <cmath>

namespace ops_multimodal_fusion {
namespace RmsNormGated {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t BATCH_MAX = 32;

__simd_vf__ inline void AccumulateReduceSumRegVf(__ubuf__ float *sumAccumAddr, __ubuf__ float *reduceAddr)
{
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> sumAccumReg;
    AscendC::Reg::RegTensor<float> reduceReg;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(sumAccumReg, sumAccumAddr);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(reduceReg, reduceAddr);
    AscendC::Reg::Add(sumAccumReg, sumAccumReg, reduceReg, scalarMask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        sumAccumAddr, sumAccumReg, scalarMask);
}

__aicore__ inline void AccumulateReduceSumReg(
    const AscendC::LocalTensor<float> &sumAccum, const AscendC::LocalTensor<float> &reduce)
{
    __ubuf__ float *sumAccumAddr = (__ubuf__ float *)sumAccum.GetPhyAddr();
    __ubuf__ float *reduceAddr = (__ubuf__ float *)reduce.GetPhyAddr();
    asc_vf_call<AccumulateReduceSumRegVf>(sumAccumAddr, reduceAddr);
}

__simd_vf__ inline void ReduceSumRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> reduceReg;

    AscendC::Reg::Duplicate<float>(sumReg, 0.0f, scalarMask);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float, AscendC::Reg::MaskMergeMode::ZEROING>(
            reduceReg, srcReg, mask);
        AscendC::Reg::Add(sumReg, sumReg, reduceReg, scalarMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr, sumReg, scalarMask);
}

__aicore__ inline void ReduceSumReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ReduceSumRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void ReduceSumSquaresRowsRegVf(
    __ubuf__ float *dstAddr,
    __ubuf__ float *srcAddr,
    uint32_t batch,
    uint32_t n,
    uint32_t reduceElems,
    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<float> reduceReg;

    for (uint32_t row = 0; row < batch; ++row) {
        AscendC::Reg::Duplicate<float>(sumReg, 0.0f, scalarMask);
        for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
            uint32_t remaining = n - chunk * vectorLength;
            AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
            uint32_t offset = chunk * vectorLength;
            AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
                srcReg, srcAddr + row * n + offset);
            AscendC::Reg::Reduce<
                AscendC::Reg::ReduceType::SUM, float, float, AscendC::Reg::MaskMergeMode::ZEROING>(
                reduceReg, srcReg, mask);
            AscendC::Reg::Add(sumReg, sumReg, reduceReg, scalarMask);
        }
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + row * reduceElems, sumReg, scalarMask);
    }
}

__aicore__ inline void ReduceSumSquaresRowsReg(
    const AscendC::LocalTensor<float> &dst,
    const AscendC::LocalTensor<float> &src,
    int64_t batch,
    int64_t n,
    int64_t reduceElems)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(n);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ReduceSumSquaresRowsRegVf>(
        dstAddr,
        srcAddr,
        static_cast<uint32_t>(batch),
        elementCount,
        static_cast<uint32_t>(reduceElems),
        chunkCount);
}

__simd_vf__ inline void MulRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *lhsAddr, __ubuf__ float *rhsAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::RegTensor<float> lhsReg;
    AscendC::Reg::RegTensor<float> rhsReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(lhsReg, lhsAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(rhsReg, rhsAddr + offset);
        AscendC::Reg::Mul(dstReg, lhsReg, rhsReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void MulReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &lhs,
    const AscendC::LocalTensor<float> &rhs, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *lhsAddr = (__ubuf__ float *)lhs.GetPhyAddr();
    __ubuf__ float *rhsAddr = (__ubuf__ float *)rhs.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MulRegVf>(dstAddr, lhsAddr, rhsAddr, elementCount, chunkCount);
}

__simd_vf__ inline void DuplicateRegVf(__ubuf__ float *dstAddr, float value, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::Duplicate<float>(dstReg, value);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void DuplicateReg(const AscendC::LocalTensor<float> &dst, float value, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<DuplicateRegVf>(dstAddr, value, elementCount, chunkCount);
}

__simd_vf__ inline void MulsRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, float value, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::RegTensor<float> srcReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Muls(dstReg, srcReg, value, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void MulsReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, float value, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<MulsRegVf>(dstAddr, srcAddr, value, elementCount, chunkCount);
}

__simd_vf__ inline void ScaleGammaByRmsRegVf(
    __ubuf__ float *dstAddr,
    __ubuf__ float *gammaAddr,
    __ubuf__ float *rmsAddr,
    uint32_t batch,
    uint32_t n,
    uint32_t reduceElems,
    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t scalarCount = 1;
    uint32_t fullCount = vectorLength;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::MaskReg fullMask = AscendC::Reg::UpdateMask<float>(fullCount);
    AscendC::Reg::RegTensor<float> rmsReg;
    AscendC::Reg::RegTensor<float> oneReg;
    AscendC::Reg::RegTensor<float> invRmsReg;
    AscendC::Reg::RegTensor<float> scaleReg;
    AscendC::Reg::RegTensor<float> gammaReg;
    AscendC::Reg::RegTensor<float> dstReg;

    AscendC::Reg::Duplicate<float>(oneReg, 1.0f, scalarMask);

    for (uint32_t row = 0; row < batch; ++row) {
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            rmsReg, rmsAddr + row * reduceElems);
        AscendC::Reg::Div(invRmsReg, oneReg, rmsReg, scalarMask);
        AscendC::Reg::Duplicate<float>(scaleReg, invRmsReg, fullMask);

        for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
            uint32_t offset = chunk * vectorLength;
            uint32_t remaining = n - offset;
            AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
            AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(gammaReg, gammaAddr + offset);
            AscendC::Reg::Mul(dstReg, gammaReg, scaleReg, mask);
            AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + row * n + offset, dstReg, mask);
        }
    }
}

__aicore__ inline void ScaleGammaByRmsReg(
    const AscendC::LocalTensor<float> &dst,
    const AscendC::LocalTensor<float> &gamma,
    const AscendC::LocalTensor<float> &rms,
    int64_t batch,
    int64_t n,
    int64_t reduceElems)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *gammaAddr = (__ubuf__ float *)gamma.GetPhyAddr();
    __ubuf__ float *rmsAddr = (__ubuf__ float *)rms.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(n);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ScaleGammaByRmsRegVf>(
        dstAddr,
        gammaAddr,
        rmsAddr,
        static_cast<uint32_t>(batch),
        elementCount,
        static_cast<uint32_t>(reduceElems),
        chunkCount);
}

__simd_vf__ inline void AddsRegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, float value, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> dstReg;
    AscendC::Reg::RegTensor<float> srcReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(srcReg, srcAddr + offset);
        AscendC::Reg::Adds(dstReg, srcReg, value, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void AddsReg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, float value, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
