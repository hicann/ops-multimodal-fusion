/*!
 * \file c2_boolean_mask.asc
 * \brief Caffe2 BooleanMask forward operator for Ascend NPU (dav-3510),
 *        RegBase implementation.
 *
 * Schema:  c2_boolean_mask(Tensor data, Tensor mask)
 *              -> (Tensor masked_data, Tensor masked_indices)
 *   data     N-D tensor (ndim >= 1); dim 0 = batch axis (size N),
 *            the rest flatten to row size K = numel(data) / N
 *   mask     1-D bool / uint8 tensor (size N)
 *   returns  masked_data of shape (M, *data.shape[1:]) and dtype == data.dtype,
 *            masked_indices of shape (M,) and dtype == int64,
 *            where M = number of true entries in mask and
 *                masked_data[j, *]    = data[masked_indices[j], *]
 *                masked_indices[j]    = j-th true position in mask
 *
 * Scope (this version):
 *   - forward only; lengths-input variant and SequenceMask are out of scope
 *   - dim 0 only (Caffe2 BooleanMask has no `dim` parameter)
 *   - data dtype scope: {fp32, fp16, int32}; bf16 / int64 / fp64 / complex
 *     rejected on this platform
 *   - mask dtype scope: {bool, uint8}; host casts uint8 to bool
 *   - whole row K must fit in UB (first-version constraint; large-K chunked
 *     tiling deferred)
 *   - output shape is data-dependent on mask values; Meta returns a
 *     dim-0-zero placeholder and eager dispatch fills in the real M.
 *     Symbolic / dynamo tracing of this op is not supported in this version.
 *
 * Algorithm:
 *   Host scans the mask on CPU to obtain the dense `indices` array (positions
 *   where mask is true) and M = indices.size(0). The on-device gather kernel
 *   is then structurally identical to c2_batch_permutation: per output row j,
 *   read the source row index from a preloaded indices slice, DMA in
 *   data[indices[j], *], copy through a Reg-shape vf, DMA out to
 *   masked_data[j, *]. The CUDA reference uses cub::DeviceSelect::Flagged on
 *   the mask plus a Device->Host sync on the count; we mirror that with
 *   torch::nonzero + a single .cpu() sync. Removing the host sync via a
 *   device-side prefix scan is deferred.
 *
 * Reg shape -- 3 layers:
 *   Layer 1 __simd_vf__   BooleanMaskRowCopyVf<T>     chunked LoadAlign +
 *                                                    StoreAlign across one
 *                                                    output row's K elements
 *   Layer 2 __aicore__    BooleanMaskRowCopy<T>      LocalTensor -> __ubuf__
 *                                                    cast, asc_vf_call
 *   Layer 3 kernel class  KernelC2BooleanMask<T>     per-core indices slice
 *                                                    preload, per output-row
 *                                                    scalar idx GetValue, DMA
 *                                                    in dataGm[idx*K], vf
 *                                                    copy, DMA out
 *                                                    maskedDataGm[j*K].
 *
 * UB layout per core (fixed plus pipelined queues):
 *   tbufIdx              : blockLength * sizeof(int64_t)  (indices slice)
 *   inQueueX, outQueueY  : K * sizeof(T) * PIPELINE_DEPTH each (one row in
 *                          flight per pipe stage)
 * Host TORCH_CHECK rejects K configs that exceed UB.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace C2BooleanMask {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_boolean_mask(Tensor data, Tensor mask) "
          "-> (Tensor masked_data, Tensor masked_indices)");
}

// ===================== 2. Meta =====================
//
// Output shape is data-dependent on mask values. Meta returns a placeholder
// with dim 0 = 0; the real M is filled in by the eager PrivateUse1
// implementation. Symbolic / dynamo tracing is not supported in this version.

std::tuple<torch::Tensor, torch::Tensor> c2_boolean_mask_meta(
    const torch::Tensor &data,
    const torch::Tensor &mask)
{
    TORCH_CHECK(data.dim() >= 1,
                "c2_boolean_mask: data must have at least 1 dim (got ndim=",
                data.dim(), ")");
    TORCH_CHECK(mask.dim() == 1,
                "c2_boolean_mask: mask must be 1-D, got ndim=", mask.dim());
    TORCH_CHECK(mask.size(0) == data.size(0),
                "c2_boolean_mask: mask.size(0)=", mask.size(0),
                " must equal data.size(0)=", data.size(0));
    TORCH_CHECK(mask.scalar_type() == torch::kBool ||
                mask.scalar_type() == torch::kUInt8,
                "c2_boolean_mask: mask dtype must be bool or uint8, got ",
                mask.scalar_type());

    std::vector<int64_t> out_shape = data.sizes().vec();
    out_shape[0] = 0;
    auto masked_data    = torch::empty(out_shape, data.options());
    auto masked_indices = torch::empty({0}, data.options().dtype(torch::kInt64));
    return std::make_tuple(masked_data, masked_indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_boolean_mask", c2_boolean_mask_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t>
calc_tiling_params(int64_t M, int64_t K, size_t bytesPerT)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t SAFETY_MARGIN = 1024;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_boolean_mask: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, M);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t blockLength = (M + numBlocks - 1) / numBlocks;

    // Per-core UB inventory:
    //   tbufIdx              : blockLength * sizeof(int64_t)
    //   inQueueX + outQueueY : 2 * K * bytesPerT * PIPELINE_DEPTH
    int64_t idxBytes   = blockLength * static_cast<int64_t>(sizeof(int64_t));
    int64_t queueBytes = 2 * PIPELINE_DEPTH * K * static_cast<int64_t>(bytesPerT);
    TORCH_CHECK(idxBytes + queueBytes + SAFETY_MARGIN <= static_cast<int64_t>(ubSize),
                "c2_boolean_mask: M=", M, " K=", K,
                " too large for dav-3510 UB. idxBytes=", idxBytes,
                " queueBytes=", queueBytes, " ubSize=", ubSize,
                ". Whole row K must fit in UB (first-version constraint).");

    return std::make_tuple(numBlocks, blockLength);
}

// ===================== 4. Kernel -- 3-layer Reg shape =====================

// Layer 1: __simd_vf__ chunked row copy.
//   Per chunk: LoadAlign(src) -> StoreAlign(dst).
//   chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T) (fp32/int32 64 / fp16 128).
template <typename T>
__simd_vf__ inline void BooleanMaskRowCopyVf(
    __ubuf__ T *srcPtr, __ubuf__ T *dstPtr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> rowReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * chunkLanes;
        uint32_t remaining = (elementCount > offset) ? (elementCount - offset) : 0;
        if (remaining == 0) break;
        uint32_t lanesThisChunk = (remaining > chunkLanes) ? chunkLanes : remaining;
        AscendC::Reg::MaskReg laneMask = AscendC::Reg::UpdateMask<T>(lanesThisChunk);

        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            rowReg, srcPtr + offset);
        if constexpr (sizeof(T) == 4) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstPtr + offset, rowReg, laneMask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
                dstPtr + offset, rowReg, laneMask);
        }
    }
}

// Layer 2: __aicore__ wrapper. LocalTensor -> __ubuf__ cast and asc_vf_call.
template <typename T>
__aicore__ inline void BooleanMaskRowCopy(
    AscendC::LocalTensor<T> &srcUbufLT,
    AscendC::LocalTensor<T> &dstUbufLT,
    int64_t K)
{
    constexpr uint32_t chunkLanes = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    __ubuf__ T *srcPtr = (__ubuf__ T *)srcUbufLT.GetPhyAddr();
    __ubuf__ T *dstPtr = (__ubuf__ T *)dstUbufLT.GetPhyAddr();
    uint32_t elementCount = static_cast<uint32_t>(K);
    uint32_t chunkCount   = (elementCount + chunkLanes - 1) / chunkLanes;
    asc_vf_call<BooleanMaskRowCopyVf<T>>(
        srcPtr, dstPtr, elementCount, chunkCount);
}

// Layer 3: kernel class. indices slice preload + per-row DMA loop.
template <typename T>
class KernelC2BooleanMask {
public:
    __aicore__ inline KernelC2BooleanMask() {}

    __aicore__ inline void Init(
        GM_ADDR data, GM_ADDR indices, GM_ADDR masked_data,
        int64_t M, int64_t K, int64_t blockLength)
    {
        dataGm_.SetGlobalBuffer((__gm__ T *)data);
        indicesGm_.SetGlobalBuffer((__gm__ int64_t *)indices);
        maskedDataGm_.SetGlobalBuffer((__gm__ T *)masked_data);

        M_ = M;
        K_ = K;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myBlockLength = M - blockStart;
        if (myBlockLength > blockLength) myBlockLength = blockLength;
        if (myBlockLength < 0) myBlockLength = 0;
        blockStart_ = blockStart;
        myBlockLength_ = myBlockLength;

        const uint32_t rowBytes = static_cast<uint32_t>(K * sizeof(T));
        const uint32_t idxBufBytes =
            static_cast<uint32_t>(blockLength * sizeof(int64_t));
        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, rowBytes);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, rowBytes);
        pipe_.InitBuffer(tbufIdx_,   idxBufBytes);
    }

    __aicore__ inline void Process()
    {
        if (myBlockLength_ <= 0) return;

        // Preload per-core indices slice: blockStart_ .. blockStart_+myBlockLength_.
        AscendC::LocalTensor<int64_t> idxLocal = tbufIdx_.template Get<int64_t>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<int64_t> padParams{false, 0, 0,
                                                             static_cast<int64_t>(0)};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(myBlockLength_ * sizeof(int64_t));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(idxLocal, indicesGm_[blockStart_], params, padParams);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t r = 0; r < myBlockLength_; ++r) {
            int64_t outRow = blockStart_ + r;
            // Read source-row index from preloaded slice (int64 -> int32 low lane;
            // host guarantees indices[outRow] in [0, N) <= INT32_MAX).
            int32_t srcRow =
                static_cast<int32_t>(idxLocal.GetValue(static_cast<int32_t>(r)));
            ProcessRow(outRow, srcRow);
        }
    }

private:
    __aicore__ inline void ProcessRow(int64_t outRow, int32_t srcRow)
    {
        // DMA in source row data[srcRow, *].
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, T{}};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(K_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(
                xLocal,
                dataGm_[static_cast<int64_t>(srcRow) * K_],
                params, padParams);
        }
        inQueueX_.EnQue(xLocal);
        xLocal = inQueueX_.template DeQue<T>();

        // Vectorized row copy: yLocal[0..K) = xLocal[0..K).
        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        BooleanMaskRowCopy<T>(xLocal, yLocal, K_);
        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.template DeQue<T>();

        // DMA out masked_data[outRow, *].
        {
            AscendC::DataCopyExtParams params;
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(K_ * sizeof(T));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(maskedDataGm_[outRow * K_], yLocal, params);
        }
        inQueueX_.FreeTensor(xLocal);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       dataGm_;
    AscendC::GlobalTensor<int64_t> indicesGm_;
    AscendC::GlobalTensor<T>       maskedDataGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIdx_;
    int64_t M_ = 0;
    int64_t K_ = 0;
    int64_t blockStart_ = 0;
    int64_t myBlockLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_boolean_mask_kernel(
    GM_ADDR data, GM_ADDR indices, GM_ADDR masked_data,
    int64_t M, int64_t K, int64_t blockLength)
{
    KernelC2BooleanMask<T> op;
    op.Init(data, indices, masked_data, M, K, blockLength);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

std::tuple<torch::Tensor, torch::Tensor> c2_boolean_mask_npu(
    const torch::Tensor &data,
    const torch::Tensor &mask)
{
    auto dtype = data.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "c2_boolean_mask: data dtype must be float32 / float16 / int32, got ",
                dtype, ". bf16 / int64 / fp64 / complex are deferred on this platform.");
    TORCH_CHECK(mask.scalar_type() == torch::kBool ||
                mask.scalar_type() == torch::kUInt8,
                "c2_boolean_mask: mask dtype must be bool or uint8, got ",
                mask.scalar_type());

    TORCH_CHECK(data.dim() >= 1,
                "c2_boolean_mask: data must have at least 1 dim (got ndim=",
                data.dim(), ")");
    TORCH_CHECK(mask.dim() == 1,
                "c2_boolean_mask: mask must be 1-D, got ndim=", mask.dim());
    TORCH_CHECK(mask.size(0) == data.size(0),
                "c2_boolean_mask: mask.size(0)=", mask.size(0),
                " must equal data.size(0)=", data.size(0));

    const c10::OptionalDeviceGuard guard(data.device());
    auto data_contig = data.contiguous();

    // Host-side mask scan: bring mask to CPU, normalise to bool, and use
    // torch::nonzero to produce the dense index list. This mirrors the
    // Device->Host sync on numOfOutput in the Caffe2 CUDA reference; removing
    // the sync with a device-side prefix scan is deferred to a follow-up.
    auto mask_cpu_bool = mask.to(at::kCPU).to(torch::kBool).contiguous();
    auto indices_cpu = at::nonzero(mask_cpu_bool).squeeze(-1).to(torch::kInt64);
    const int64_t M = indices_cpu.size(0);

    std::vector<int64_t> out_shape = data_contig.sizes().vec();
    out_shape[0] = M;
    auto masked_data    = torch::empty(out_shape, data_contig.options());
    auto masked_indices = indices_cpu.to(data_contig.device(), torch::kInt64);

    const int64_t N = data_contig.size(0);
    const int64_t numel_data = data_contig.numel();
    const int64_t K = (N > 0) ? (numel_data / N) : 0;

    // Early returns: nothing to gather. Covers all-false mask (M == 0),
    // empty data tensor (numel == 0), and zero-sized non-batch dim (K == 0).
    if (M == 0 || numel_data == 0 || K == 0) {
        return std::make_tuple(masked_data, masked_indices);
    }

    TORCH_CHECK(N <= static_cast<int64_t>(0x7fffffff),
                "c2_boolean_mask: N=", N, " exceeds INT32_MAX");

    const size_t bytesPerT =
        (dtype == torch::kFloat16) ? 2u : 4u;  // fp32 / int32 both 4 bytes
    int64_t numBlocks, blockLength;
    std::tie(numBlocks, blockLength) = calc_tiling_params(M, K, bytesPerT);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto data_ptr        = (GM_ADDR)data_contig.data_ptr();
    auto indices_ptr     = (GM_ADDR)masked_indices.data_ptr();
    auto masked_data_ptr = (GM_ADDR)masked_data.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            data_contig.scalar_type(), "c2_boolean_mask_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_boolean_mask_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    data_ptr, indices_ptr, masked_data_ptr, M, K, blockLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_boolean_mask_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    data_ptr, indices_ptr, masked_data_ptr, M, K, blockLength);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                c2_boolean_mask_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    data_ptr, indices_ptr, masked_data_ptr, M, K, blockLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2BooleanMask", acl_call);

    return std::make_tuple(masked_data, masked_indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_boolean_mask", c2_boolean_mask_npu);
}

} // namespace C2BooleanMask
} // namespace ops_multimodal_fusion
