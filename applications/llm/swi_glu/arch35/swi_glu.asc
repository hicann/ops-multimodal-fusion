/*!
 * \file swi_glu.asc
 * \brief SwiGLU operator implementation for Ascend NPU
 *
 * Computes SwiGLU(x) = silu(x_left) * x_right,
 * where x is split in half along the last dimension.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"

#include "swi_glu_apt.h"
#include "swi_glu_host_tiling.h"

namespace ops_multimodal_fusion {
namespace SwiGlu {

// 1. Schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("swi_glu(Tensor x) -> Tensor");
}

// 2. Meta function
torch::Tensor swi_glu_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.dim() >= 1, "swi_glu: input must have at least 1 dimension");
    TORCH_CHECK(x.size(-1) % 2 == 0, "swi_glu: last dimension must be even");
    auto sizes = x.sizes().vec();
    sizes.back() /= 2;
    return torch::empty(sizes, x.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("swi_glu", swi_glu_meta);
}

// 3. NPU dispatch
torch::Tensor swi_glu_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto x_contig = x.contiguous();
    auto z = swi_glu_meta(x_contig);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t lastDim = x_contig.size(-1);
    int64_t colLen = lastDim / 2;
    int64_t rowLen = x_contig.numel() / lastDim;

    int32_t dtype;
    switch (x_contig.scalar_type()) {
        case torch::kFloat32:  dtype = SwiGluHost::DT_FLOAT; break;
        case torch::kFloat16:  dtype = SwiGluHost::DT_FLOAT16; break;
        case torch::kBFloat16: dtype = SwiGluHost::DT_BF16; break;
        default: TORCH_CHECK(false, "swi_glu: unsupported dtype ", x_contig.scalar_type());
    }

    auto config = SwiGluHost::CalcSwiGluTiling(
        static_cast<uint64_t>(rowLen), static_cast<uint64_t>(colLen), dtype);

    auto x_ptr = (GM_ADDR)x_contig.data_ptr();
    auto z_ptr = (GM_ADDR)z.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x_contig.scalar_type(), "swi_glu_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                swi_glu_fp32<<<config.blockDim, nullptr, stream>>>(
                    x_ptr, z_ptr, nullptr, config.tiling);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                swi_glu_fp16<<<config.blockDim, nullptr, stream>>>(
                    x_ptr, z_ptr, nullptr, config.tiling);
            })
            AT_DISPATCH_CASE(torch::kBFloat16, [&] {
                swi_glu_bf16<<<config.blockDim, nullptr, stream>>>(
                    x_ptr, z_ptr, nullptr, config.tiling);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("SwiGlu", acl_call);
    return z;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("swi_glu", swi_glu_npu);
}

} // namespace SwiGlu
} // namespace ops_multimodal_fusion
