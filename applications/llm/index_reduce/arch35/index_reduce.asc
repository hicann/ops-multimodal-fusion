/*!
 * \file index_reduce.asc
 * \brief IndexReduce operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * torch.index_reduce(self, dim, index, source, reduce, include_self=True) -> Tensor
 *   For each j in [0, M): result[index[j]] = reduce(result[index[j]], source[j])
 *   reduce in {prod, amax, amin, mean}
 *
 * Dispatch scope (first version):
 *   - 1-D self / source / index only
 *   - dim must be 0
 *   - K = self.size(0) in [1, INT32_MAX]; whole K stays resident in UB
 *   - M = source.size(0) in [1, vec_width(dtype)]; vec_width = 64 for fp32/int32, 128 for fp16
 *   - dtype(self) = dtype(source) in {fp32, fp16, int32}
 *   - index.dtype == int64 (read low-32 lane via stride-2)
 *   - include_self in {True, False}
 *
 * 3-layer Reg shape:
 *   Layer 1 vf functions (vectorized whole-K helpers):
 *     IndexReduceCopyVf<T>       : LoadAlign + StoreAlign  (selfLocal -> resultLocal)
 *     IndexReduceDuplicateVf<T>  : Duplicate const + StoreAlign  (init result / init count)
 *     IndexReduceMeanDivVf<T>    : result = result / count  (fp mean only)
 *   Layer 2 __aicore__ wrappers: GetPhyAddr cast + asc_vf_call
 *   Layer 3 kernel class: DMA, serial M-loop scalar scatter update of resultLocal,
 *     mean count book-keeping + in-kernel division, DMA out
 *
 * Scalar scatter update path:
 *   The reduce target index is data-dependent (read at runtime), so per-i update reads
 *   indexLocal[i] as int64 then truncates to int32 (values guaranteed in [0, K) < INT32_MAX),
 *   reads sourceLocal.GetValue(i) + resultLocal.GetValue(idx), computes the C++ scalar reduce
 *   op (no classic AscendC compute APIs), writes back via resultLocal.SetValue(idx).
 *   Vector partition-by-target parallelization deferred to v2.
 *
 * Mean path (in-kernel division):
 *   countLocal is T-typed (same lane domain as result; fp16=128 lanes, fp32/int32=64).
 *   Init: T(1) everywhere (passthrough divisor for untouched positions).
 *   !include_self: scalar reset countLocal[idx] = T(0) at each j in the index list,
 *     mirroring the resultLocal zero pass so the subsequent count[idx]+=1 yields
 *     exactly #hits (instead of 1+#hits). For untouched positions count stays T(1).
 *   Accumulate via scalar count[idx] += T(1) for each j.
 *   Divide: fp via Reg::Div vf; int32 via scalar floor-div (Reg::Div on int32 truncates
 *   toward zero, which disagrees with PyTorch's floor semantics for negative quotients).
 *   The whole mean finalisation stays in UB so the host needs neither a stock Div op nor
 *   an int32->fp Cast on the count tensor.
 *
 *   The earlier vf-based count fixup (Compares<T,EQ>+masked StoreAlign rewriting 0->1)
 *   was dropped: `Reg::Compares<half, EQ>` is known-buggy on this platform,
 *   and the scalar reset path above keeps countLocal >= 1 everywhere by construction,
 *   so no fixup is needed.
 *
 * UB layout (whole K + whole M resident; numBlocks=1, AIV=0 only):
 *   tbufSelf:    K * sizeof(T)
 *   tbufResult:  K * sizeof(T)
 *   tbufSource:  M * sizeof(T)
 *   tbufIndex:   M * sizeof(int64_t)
 *   tbufCount:   K * sizeof(T)               (mean only)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <limits>

namespace ops_multimodal_fusion {
namespace IndexReduce {

// Reduce mode encoding (passed from host as int).
constexpr int REDUCE_PROD = 0;
constexpr int REDUCE_AMAX = 1;
constexpr int REDUCE_AMIN = 2;
constexpr int REDUCE_MEAN = 3;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("index_reduce(Tensor self, int dim, Tensor index, Tensor source, "
          "str reduce, bool include_self=True) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor index_reduce_meta(
    const torch::Tensor &self, int64_t dim, const torch::Tensor &index,
    const torch::Tensor &source, c10::string_view reduce, bool include_self)
{
    TORCH_CHECK(self.dim() == 1,
                "index_reduce: only 1-D self is supported in this version, got ",
                self.dim(), "-D");
    TORCH_CHECK(source.dim() == 1,
                "index_reduce: only 1-D source is supported, got ",
                source.dim(), "-D");
    TORCH_CHECK(index.dim() == 1,
                "index_reduce: only 1-D index is supported, got ",
                index.dim(), "-D");
    TORCH_CHECK(dim == 0,
                "index_reduce: only dim=0 is supported, got dim=", dim);
    TORCH_CHECK(self.scalar_type() == source.scalar_type(),
                "index_reduce: self dtype (", self.scalar_type(),
                ") must match source dtype (", source.scalar_type(), ")");
    TORCH_CHECK(index.scalar_type() == torch::kInt64,
                "index_reduce: index dtype must be int64, got ", index.scalar_type());
    TORCH_CHECK(reduce == "prod" || reduce == "amax" ||
                reduce == "amin" || reduce == "mean",
                "index_reduce: reduce must be one of {prod, amax, amin, mean}, got ", reduce);
    return torch::empty_like(self);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("index_reduce", index_reduce_meta);
}

// ===================== 3. Kernel — 3-layer Reg shape =====================

// --------- Layer 1 vf functions ---------

// Whole-tile copy: dst[0..count) = src[0..count)
template <typename T>
__simd_vf__ inline void IndexReduceCopyVf(
    __ubuf__ T *srcAddr, __ubuf__ T *dstAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            reg, srcAddr + offset);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, reg, mask);
    }
}

// Whole-tile fill with constant value.
template <typename T>
__simd_vf__ inline void IndexReduceDuplicateVf(
    __ubuf__ T *dstAddr, T value,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::Duplicate<T, AscendC::Reg::MaskMergeMode::ZEROING>(
            reg, value, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, reg, mask);
    }
}

// Mean div for fp: result = result / count (both same T type, single lane domain).
// int32 mean uses a scalar floor-div path in Layer 3 instead.
template <typename T>
__simd_vf__ inline void IndexReduceMeanDivVf(
    __ubuf__ T *resultAddr, __ubuf__ T *countAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> resReg;
    AscendC::Reg::RegTensor<T> cntReg;
    AscendC::Reg::RegTensor<T> outReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            resReg, resultAddr + offset);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            cntReg, countAddr + offset);
        AscendC::Reg::Div(outReg, resReg, cntReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            resultAddr + offset, outReg, mask);
    }
}

// --------- Layer 2 wrappers ---------

template <typename T>
__aicore__ inline void IndexReduceCopy(
    AscendC::LocalTensor<T> &src, AscendC::LocalTensor<T> &dst,
    uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ T *srcPtr = (__ubuf__ T *)src.GetPhyAddr();
    __ubuf__ T *dstPtr = (__ubuf__ T *)dst.GetPhyAddr();
    asc_vf_call<IndexReduceCopyVf<T>>(srcPtr, dstPtr, elementCount, chunkCount);
}

template <typename T>
__aicore__ inline void IndexReduceDuplicate(
    AscendC::LocalTensor<T> &dst, T value, uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ T *dstPtr = (__ubuf__ T *)dst.GetPhyAddr();
    asc_vf_call<IndexReduceDuplicateVf<T>>(dstPtr, value, elementCount, chunkCount);
}

template <typename T>
__aicore__ inline void IndexReduceMeanDiv(
    AscendC::LocalTensor<T> &result, AscendC::LocalTensor<T> &count,
    uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ T *resPtr = (__ubuf__ T *)result.GetPhyAddr();
    __ubuf__ T *cntPtr = (__ubuf__ T *)count.GetPhyAddr();
    asc_vf_call<IndexReduceMeanDivVf<T>>(resPtr, cntPtr, elementCount, chunkCount);
}

// --------- Layer 3 kernel class ---------

template <typename T>
class KernelIndexReduce {
public:
    __aicore__ inline KernelIndexReduce() {}

    __aicore__ inline void Init(
        GM_ADDR self, GM_ADDR index, GM_ADDR source,
        GM_ADDR result,
        int64_t K, int64_t M, int reduceOp, bool includeSelf)
    {
        selfGm_.SetGlobalBuffer((__gm__ T *)self);
        indexGm_.SetGlobalBuffer((__gm__ int64_t *)index);
        sourceGm_.SetGlobalBuffer((__gm__ T *)source);
        resultGm_.SetGlobalBuffer((__gm__ T *)result);
        K_ = K;
        M_ = M;
        reduceOp_ = reduceOp;
        includeSelf_ = includeSelf;

        const uint32_t selfBytes   = static_cast<uint32_t>(K * sizeof(T));
        const uint32_t resultBytes = static_cast<uint32_t>(K * sizeof(T));
        const uint32_t sourceBytes = static_cast<uint32_t>(M * sizeof(T));
        const uint32_t indexBytes  = static_cast<uint32_t>(M * sizeof(int64_t));

        pipe_.InitBuffer(tbufSelf_,   selfBytes);
        pipe_.InitBuffer(tbufResult_, resultBytes);
        pipe_.InitBuffer(tbufSource_, sourceBytes);
        pipe_.InitBuffer(tbufIndex_,  indexBytes);
        if (reduceOp == REDUCE_MEAN) {
            const uint32_t countBytes = static_cast<uint32_t>(K * sizeof(T));
            pipe_.InitBuffer(tbufCount_, countBytes);
        }
    }

    __aicore__ inline void Process()
    {
        if (K_ <= 0 || M_ <= 0) return;
        // Single-AIV serial: only AIV 0 executes.
        if (AscendC::GetBlockIdx() != 0) return;

        AscendC::LocalTensor<T>       selfLocal   = tbufSelf_.template Get<T>();
        AscendC::LocalTensor<T>       resultLocal = tbufResult_.template Get<T>();
        AscendC::LocalTensor<T>       sourceLocal = tbufSource_.template Get<T>();
        AscendC::LocalTensor<int64_t> indexLocal  = tbufIndex_.template Get<int64_t>();

        // DMA in.
        AscendC::DataCopyExtParams cpSelf;
        cpSelf.blockCount = 1;
        cpSelf.blockLen   = static_cast<uint32_t>(K_ * sizeof(T));
        cpSelf.srcStride  = 0;
        cpSelf.dstStride  = 0;
        AscendC::DataCopyExtParams cpSource;
        cpSource.blockCount = 1;
        cpSource.blockLen   = static_cast<uint32_t>(M_ * sizeof(T));
        cpSource.srcStride  = 0;
        cpSource.dstStride  = 0;
        AscendC::DataCopyExtParams cpIndex;
        cpIndex.blockCount = 1;
        cpIndex.blockLen   = static_cast<uint32_t>(M_ * sizeof(int64_t));
        cpIndex.srcStride  = 0;
        cpIndex.dstStride  = 0;

        AscendC::DataCopyPadExtParams<T>       padT{false, 0, 0, T{}};
        AscendC::DataCopyPadExtParams<int64_t> padI{false, 0, 0, static_cast<int64_t>(0)};

        AscendC::DataCopyPad(selfLocal,   selfGm_,   cpSelf,   padT);
        AscendC::DataCopyPad(sourceLocal, sourceGm_, cpSource, padT);
        AscendC::DataCopyPad(indexLocal,  indexGm_,  cpIndex,  padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        const uint32_t K_u32 = static_cast<uint32_t>(K_);

        // resultLocal = selfLocal (vectorized whole-K copy).
        IndexReduceCopy<T>(selfLocal, resultLocal, K_u32);
        AscendC::PipeBarrier<PIPE_ALL>();

        // include_self=False: overwrite the positions named by index with identity value.
        // (Positions not in index keep the original self value, matching CUDA index_fill_.)
        if (!includeSelf_) {
            T initVal = GetInitVal();
            for (int64_t j = 0; j < M_; ++j) {
                int32_t idx = static_cast<int32_t>(indexLocal.GetValue(j));
                resultLocal.SetValue(idx, initVal);
            }
        }

        // Serial scatter reduce: per j, update resultLocal at indexLocal[j].
        for (int64_t j = 0; j < M_; ++j) {
            int32_t idx = static_cast<int32_t>(indexLocal.GetValue(j));
            T v   = sourceLocal.GetValue(j);
            T old = resultLocal.GetValue(idx);
            T nv  = ApplyReduce(old, v);
            resultLocal.SetValue(idx, nv);
        }

        // Mean: maintain T-typed count[K] and finalise division in kernel.
        // (Keeping everything in UB avoids host-side int32 -> fp32/fp16 cast and stock
        // Div op on the count tensor.)
        if (reduceOp_ == REDUCE_MEAN) {
            AscendC::LocalTensor<T> countLocal = tbufCount_.template Get<T>();
            T oneT;
            T zeroT;
            if constexpr (std::is_same_v<T, half>) {
                oneT  = T(1.0f);
                zeroT = T(0.0f);
            } else {
                oneT  = static_cast<T>(1);
                zeroT = static_cast<T>(0);
            }
            // Init count = 1 everywhere; untouched positions later divide by 1 (passthrough).
            IndexReduceDuplicate<T>(countLocal, oneT, K_u32);
            AscendC::PipeBarrier<PIPE_ALL>();

            // !include_self: scalar reset count[idx] = 0 at each indexed position,
            // mirroring the result zero pass above so the upcoming increment yields
            // exactly #hits (instead of 1 + #hits). Idempotent across duplicate idx.
            if (!includeSelf_) {
                for (int64_t j = 0; j < M_; ++j) {
                    int32_t idx = static_cast<int32_t>(indexLocal.GetValue(j));
                    countLocal.SetValue(idx, zeroT);
                }
            }

            for (int64_t j = 0; j < M_; ++j) {
                int32_t idx = static_cast<int32_t>(indexLocal.GetValue(j));
                T c = countLocal.GetValue(idx);
                if constexpr (std::is_same_v<T, half>) {
                    countLocal.SetValue(idx, T(static_cast<float>(c) + 1.0f));
                } else {
                    countLocal.SetValue(idx, static_cast<T>(c + static_cast<T>(1)));
                }
            }
            // Flush scalar SetValue writes before the upcoming vf LoadAlign of countLocal.
            AscendC::PipeBarrier<PIPE_ALL>();

            // Finalise: fp goes through Reg::Div vector path; int32 floor-divs per element
            // (Reg::Div on int32 is truncation, not floor, so use scalar for sign correctness).
            if constexpr (std::is_same_v<T, int32_t>) {
                for (int64_t i = 0; i < K_; ++i) {
                    int32_t r = resultLocal.GetValue(i);
                    int32_t c = countLocal.GetValue(i);
                    int32_t q = r / c;
                    int32_t rem = r - q * c;
                    if (rem != 0 && ((r ^ c) < 0)) {
                        q -= 1;
                    }
                    resultLocal.SetValue(i, q);
                }
            } else {
                IndexReduceMeanDiv<T>(resultLocal, countLocal, K_u32);
                AscendC::PipeBarrier<PIPE_ALL>();
            }
        }

        AscendC::DataCopyPad(resultGm_, resultLocal, cpSelf);
    }

private:
    __aicore__ inline T GetInitVal() const
    {
        if (reduceOp_ == REDUCE_PROD) {
            if constexpr (std::is_same_v<T, half>) {
                return T(1.0f);
            } else {
                return static_cast<T>(1);
            }
        } else if (reduceOp_ == REDUCE_AMAX) {
            if constexpr (std::is_same_v<T, half>) {
                return T(-65504.0f);
            } else if constexpr (std::is_same_v<T, float>) {
                return -std::numeric_limits<float>::infinity();
            } else {
                return std::numeric_limits<int32_t>::min();
            }
        } else if (reduceOp_ == REDUCE_AMIN) {
            if constexpr (std::is_same_v<T, half>) {
                return T(65504.0f);
            } else if constexpr (std::is_same_v<T, float>) {
                return std::numeric_limits<float>::infinity();
            } else {
                return std::numeric_limits<int32_t>::max();
            }
        }
        // MEAN: identity is 0 (sum accumulator; division finalised in-kernel after count).
        if constexpr (std::is_same_v<T, half>) {
            return T(0.0f);
        }
        return static_cast<T>(0);
    }

    __aicore__ inline T ApplyReduce(T oldVal, T newVal) const
    {
        if (reduceOp_ == REDUCE_PROD) {
            if constexpr (std::is_same_v<T, half>) {
                return T(static_cast<float>(oldVal) * static_cast<float>(newVal));
            }
            return static_cast<T>(oldVal * newVal);
        }
        if (reduceOp_ == REDUCE_AMAX) {
            if constexpr (std::is_same_v<T, half>) {
                return (static_cast<float>(oldVal) > static_cast<float>(newVal))
                       ? oldVal : newVal;
            }
            return (oldVal > newVal) ? oldVal : newVal;
        }
        if (reduceOp_ == REDUCE_AMIN) {
            if constexpr (std::is_same_v<T, half>) {
                return (static_cast<float>(oldVal) < static_cast<float>(newVal))
                       ? oldVal : newVal;
            }
            return (oldVal < newVal) ? oldVal : newVal;
        }
        // MEAN: sum accumulation; division finalised host-side.
        if constexpr (std::is_same_v<T, half>) {
            return T(static_cast<float>(oldVal) + static_cast<float>(newVal));
        }
        return static_cast<T>(oldVal + newVal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       selfGm_;
    AscendC::GlobalTensor<int64_t> indexGm_;
    AscendC::GlobalTensor<T>       sourceGm_;
    AscendC::GlobalTensor<T>       resultGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSelf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufResult_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSource_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIndex_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCount_;
    int64_t K_ = 0;
    int64_t M_ = 0;
    int reduceOp_ = 0;
    bool includeSelf_ = true;
};

template <typename T>
__global__ __aicore__ __vector__ void index_reduce_kernel(
    GM_ADDR self, GM_ADDR index, GM_ADDR source,
    GM_ADDR result,
    int64_t K, int64_t M, int reduceOp, bool includeSelf)
{
    KernelIndexReduce<T> op;
    op.Init(self, index, source, result, K, M, reduceOp, includeSelf);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

torch::Tensor index_reduce_npu(
    const torch::Tensor &self, int64_t dim, const torch::Tensor &index,
    const torch::Tensor &source, c10::string_view reduce, bool include_self)
{
    auto dtype = self.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "index_reduce (RegBase): only float32 / float16 / int32 are supported, got ",
                dtype);
    TORCH_CHECK(self.dim() == 1,
                "index_reduce: only 1-D self is supported, got ", self.dim(), "-D");
    TORCH_CHECK(source.dim() == 1,
                "index_reduce: only 1-D source is supported, got ", source.dim(), "-D");
    TORCH_CHECK(index.dim() == 1,
                "index_reduce: only 1-D index is supported, got ", index.dim(), "-D");
    TORCH_CHECK(dim == 0,
                "index_reduce: only dim=0 is supported, got dim=", dim);
    TORCH_CHECK(source.scalar_type() == dtype,
                "index_reduce: self dtype (", dtype,
                ") must match source dtype (", source.scalar_type(), ")");
    TORCH_CHECK(index.scalar_type() == torch::kInt64,
                "index_reduce: index dtype must be int64, got ", index.scalar_type());

    int reduceOp;
    if (reduce == "prod")      reduceOp = REDUCE_PROD;
    else if (reduce == "amax") reduceOp = REDUCE_AMAX;
    else if (reduce == "amin") reduceOp = REDUCE_AMIN;
    else if (reduce == "mean") reduceOp = REDUCE_MEAN;
    else {
        TORCH_CHECK(false, "index_reduce: reduce must be one of "
                           "{prod, amax, amin, mean}, got ", reduce);
        reduceOp = REDUCE_PROD;  // unreachable, silence compiler
    }

    const int64_t K = self.size(0);
    const int64_t M = source.size(0);
    TORCH_CHECK(K >= 1, "index_reduce: self size must be >= 1, got K=", K);
    TORCH_CHECK(K <= static_cast<int64_t>(0x7fffffff),
                "index_reduce: self size K=", K, " exceeds INT32_MAX");
    TORCH_CHECK(index.size(0) == M,
                "index_reduce: index size (", index.size(0),
                ") must equal source size (", M, ")");

    const int64_t vecWidth = (dtype == torch::kFloat16) ? 128 : 64;
    TORCH_CHECK(M >= 1, "index_reduce: source size must be >= 1, got M=", M);
    TORCH_CHECK(M <= vecWidth,
                "index_reduce: source size M=", M, " exceeds vec_width=", vecWidth,
                " for dtype ", dtype, "; chunked path is deferred");

    const c10::OptionalDeviceGuard guard(self.device());
    auto self_c   = self.contiguous();
    auto index_c  = index.contiguous();
    auto source_c = source.contiguous();

    auto result = torch::empty_like(self_c);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto selfPtr   = (GM_ADDR)self_c.data_ptr();
    auto indexPtr  = (GM_ADDR)index_c.data_ptr();
    auto sourcePtr = (GM_ADDR)source_c.data_ptr();
    auto resultPtr = (GM_ADDR)result.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            self_c.scalar_type(), "index_reduce_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                index_reduce_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, sourcePtr, resultPtr,
                    K, M, reduceOp, include_self);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                index_reduce_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, sourcePtr, resultPtr,
                    K, M, reduceOp, include_self);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                index_reduce_kernel<scalar_t><<<1, nullptr, stream>>>(
                    selfPtr, indexPtr, sourcePtr, resultPtr,
                    K, M, reduceOp, include_self);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("IndexReduce", acl_call);

    return result;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("index_reduce", index_reduce_npu);
}

} // namespace IndexReduce
} // namespace ops_multimodal_fusion
