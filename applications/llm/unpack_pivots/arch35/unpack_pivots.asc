/*!
 * \file unpack_pivots.asc
 * \brief UnpackPivots operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.unpack_pivots(pivots, perm_size) -> perm
 *
 * pivots    : [..., K], int32/int64, LU 1-indexed pivot sequence
 * perm_size : M, full permutation length, M >= K
 * perm      : [..., M], int64, 0-based permutation vector
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <tuple>
#include <vector>

namespace ops_multimodal_fusion {
namespace UnpackPivots {

static constexpr int64_t kSafetyBytes = 2048;

static int64_t align_up(int64_t value, int64_t align)
{
    return ((value + align - 1) / align) * align;
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("unpack_pivots(Tensor pivots, int perm_size) -> Tensor");
}

static std::vector<int64_t> output_shape(const torch::Tensor &pivots, int64_t permSize)
{
    std::vector<int64_t> shape = pivots.sizes().vec();
    TORCH_CHECK(!shape.empty(),
                "unpack_pivots: pivots must be at least 1-D");
    shape.back() = permSize;
    return shape;
}

static void check_common(const torch::Tensor &pivots, int64_t permSize)
{
    TORCH_CHECK(pivots.dim() >= 1,
                "unpack_pivots: pivots must be at least 1-D, got ",
                pivots.dim(), "-D");
    TORCH_CHECK(pivots.scalar_type() == torch::kInt32 ||
                pivots.scalar_type() == torch::kInt64,
                "unpack_pivots: pivots dtype must be int32 or int64, got ",
                pivots.scalar_type());
    TORCH_CHECK(permSize > 0,
                "unpack_pivots: perm_size must be positive, got ", permSize);

    int64_t k = pivots.size(pivots.dim() - 1);
    TORCH_CHECK(k >= 0 && k <= permSize,
                "unpack_pivots: pivot length K must satisfy 0 <= K <= perm_size; got K=",
                k, ", perm_size=", permSize);
    TORCH_CHECK(permSize <= static_cast<int64_t>(0x7fffffff),
                "unpack_pivots: perm_size exceeds INT32_MAX");

    int64_t batchCount = 1;
    for (int64_t i = 0; i < pivots.dim() - 1; ++i) {
        TORCH_CHECK(pivots.size(i) >= 0,
                    "unpack_pivots: invalid negative batch dimension");
        batchCount *= pivots.size(i);
    }
    double totalOutput = static_cast<double>(batchCount) * static_cast<double>(permSize);
    TORCH_CHECK(totalOutput <= static_cast<double>(0x7fffffff),
                "unpack_pivots: output numel exceeds INT32_MAX");
}

static void check_pivot_range(const torch::Tensor &pivots, int64_t permSize)
{
    if (pivots.numel() == 0) {
        return;
    }
    auto pivotsCpu = pivots.contiguous().cpu();
    int64_t minPivot = pivotsCpu.min().item<int64_t>();
    int64_t maxPivot = pivotsCpu.max().item<int64_t>();
    TORCH_CHECK(minPivot >= 1 && maxPivot <= permSize,
                "unpack_pivots: pivot values must be in [1, perm_size], got min=",
                minPivot, ", max=", maxPivot, ", perm_size=", permSize);
}

torch::Tensor unpack_pivots_meta(const torch::Tensor &pivots, int64_t permSize)
{
    check_common(pivots, permSize);
    return torch::empty(output_shape(pivots, permSize),
                        pivots.options().dtype(torch::kInt64));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("unpack_pivots", unpack_pivots_meta);
}

static std::tuple<int64_t, int64_t> calc_tiling_params(int64_t batchCount)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "unpack_pivots: coreNum must be positive");
    int64_t numBlocks = std::max<int64_t>(1, std::min<int64_t>(batchCount, coreNum));
    int64_t blockLength = (batchCount + numBlocks - 1) / numBlocks;
    return std::make_tuple(numBlocks, blockLength);
}

template <typename T>
static void check_ub_capacity(int64_t k, int64_t permSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t permPackedBytes = align_up(permSize * static_cast<int64_t>(sizeof(int64_t)), 32);
    int64_t required = permPackedBytes * 2 +
                       align_up(std::max<int64_t>(1, k) * static_cast<int64_t>(sizeof(T)), 32) +
                       kSafetyBytes;
    TORCH_CHECK(required <= static_cast<int64_t>(ubSize),
                "unpack_pivots: this dav-3510 Reg implementation requires pivots and "
                "permutation for one batch to fit UB; required=", required,
                ", ub=", ubSize, ", K=", k, ", perm_size=", permSize);
}

__simd_vf__ inline void CopyInt32Vf(
    __ubuf__ int32_t *srcAddr, __ubuf__ int32_t *dstAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    AscendC::Reg::RegTensor<int32_t> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<int32_t>(remaining);
        AscendC::Reg::LoadAlign<int32_t, AscendC::Reg::LoadDist::DIST_NORM>(
            reg, srcAddr + offset);
        AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, reg, mask);
    }
}

__aicore__ inline void CopyInt32(
    AscendC::LocalTensor<int32_t> &src, AscendC::LocalTensor<int32_t> &dst,
    uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(int32_t);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ int32_t *srcPtr = (__ubuf__ int32_t *)src.GetPhyAddr();
    __ubuf__ int32_t *dstPtr = (__ubuf__ int32_t *)dst.GetPhyAddr();
    asc_vf_call<CopyInt32Vf>(srcPtr, dstPtr, elementCount, chunkCount);
}

template <typename PivotT>
class KernelUnpackPivots {
public:
    __aicore__ inline KernelUnpackPivots() {}

    __aicore__ inline void Init(
        GM_ADDR pivots, GM_ADDR perm,
        int64_t batchCount, int64_t blockLength,
        int64_t k, int64_t permSize)
    {
        pivotsGm_.SetGlobalBuffer((__gm__ PivotT *)pivots);
        permGm_.SetGlobalBuffer((__gm__ int64_t *)perm);
        batchCount_ = batchCount;
        blockLength_ = blockLength;
        k_ = k;
        permSize_ = permSize;

        int64_t permRawBytes = permSize_ * static_cast<int64_t>(sizeof(int64_t));
        int64_t pivotCount = k_ > 0 ? k_ : 1;
        int64_t pivotRawBytes = pivotCount * static_cast<int64_t>(sizeof(PivotT));
        uint32_t permBytes = static_cast<uint32_t>(((permRawBytes + 31) / 32) * 32);
        uint32_t pivotBytes = static_cast<uint32_t>(((pivotRawBytes + 31) / 32) * 32);
        pipe_.InitBuffer(tbufPermWork_, permBytes);
        pipe_.InitBuffer(tbufPermOut_, permBytes);
        pipe_.InitBuffer(tbufPivots_, pivotBytes);
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
        int64_t start = blockIdx * blockLength_;
        int64_t end = start + blockLength_;
        if (end > batchCount_) {
            end = batchCount_;
        }
        for (int64_t batch = start; batch < end; ++batch) {
            ProcessOne(batch);
        }
    }

private:
    __aicore__ inline void ProcessOne(int64_t batch)
    {
        AscendC::LocalTensor<int32_t> permWork = tbufPermWork_.template Get<int32_t>();
        AscendC::LocalTensor<int32_t> permOut = tbufPermOut_.template Get<int32_t>();
        AscendC::LocalTensor<int64_t> permOutI64 = tbufPermOut_.template Get<int64_t>();

        for (int64_t i = 0; i < permSize_; ++i) {
            permWork.SetValue(static_cast<int32_t>(2 * i), static_cast<int32_t>(i));
            permWork.SetValue(static_cast<int32_t>(2 * i + 1), 0);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        if (k_ > 0) {
            AscendC::LocalTensor<PivotT> pivLocal = tbufPivots_.template Get<PivotT>();
            AscendC::DataCopyExtParams copyPivot;
            copyPivot.blockCount = 1;
            copyPivot.blockLen = static_cast<uint32_t>(k_ * sizeof(PivotT));
            copyPivot.srcStride = 0;
            copyPivot.dstStride = 0;
            AscendC::DataCopyPadExtParams<PivotT> padPivot{
                false, 0, 0, static_cast<PivotT>(0)};
            AscendC::DataCopyPad(pivLocal, pivotsGm_[batch * k_], copyPivot, padPivot);
            AscendC::PipeBarrier<PIPE_ALL>();

            for (int64_t i = 0; i < k_; ++i) {
                int64_t pivot = static_cast<int64_t>(pivLocal.GetValue(i));
                int64_t j = pivot - 1;
                int32_t a = permWork.GetValue(static_cast<int32_t>(2 * i));
                int32_t b = permWork.GetValue(static_cast<int32_t>(2 * j));
                permWork.SetValue(static_cast<int32_t>(2 * i), b);
                permWork.SetValue(static_cast<int32_t>(2 * j), a);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        CopyInt32(permWork, permOut, static_cast<uint32_t>(permSize_ * 2));
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(permSize_ * sizeof(int64_t));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(permGm_[batch * permSize_], permOutI64, copyOut);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<PivotT> pivotsGm_;
    AscendC::GlobalTensor<int64_t> permGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufPermWork_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufPermOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufPivots_;
    int64_t batchCount_ = 0;
    int64_t blockLength_ = 0;
    int64_t k_ = 0;
    int64_t permSize_ = 0;
};

template <typename PivotT>
__global__ __aicore__ __vector__ void unpack_pivots_kernel(
    GM_ADDR pivots, GM_ADDR perm,
    int64_t batchCount, int64_t blockLength,
    int64_t k, int64_t permSize)
{
    KernelUnpackPivots<PivotT> op;
    op.Init(pivots, perm, batchCount, blockLength, k, permSize);
    op.Process();
}

torch::Tensor unpack_pivots_npu(const torch::Tensor &pivots, int64_t permSize)
{
    check_common(pivots, permSize);
    check_pivot_range(pivots, permSize);
    const c10::OptionalDeviceGuard guard(pivots.device());

    auto pivotsC = pivots.contiguous();
    auto out = torch::empty(output_shape(pivotsC, permSize),
                            pivotsC.options().dtype(torch::kInt64));
    int64_t k = pivotsC.size(pivotsC.dim() - 1);
    int64_t batchCount = 1;
    for (int64_t i = 0; i < pivotsC.dim() - 1; ++i) {
        batchCount *= pivotsC.size(i);
    }
    if (batchCount == 0) {
        return out;
    }

    int64_t numBlocks = 1;
    int64_t blockLength = 1;
    std::tie(numBlocks, blockLength) = calc_tiling_params(batchCount);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto pivotsPtr = (GM_ADDR)pivotsC.data_ptr();
    auto outPtr = (GM_ADDR)out.data_ptr();

    if (pivotsC.scalar_type() == torch::kInt32) {
        check_ub_capacity<int32_t>(k, permSize);
        auto acl_call = [=]() -> int {
            unpack_pivots_kernel<int32_t><<<numBlocks, nullptr, stream>>>(
                pivotsPtr, outPtr, batchCount, blockLength, k, permSize);
            return 0;
        };
        at_npu::native::OpCommand::RunOpApi("UnpackPivots", acl_call);
    } else {
        check_ub_capacity<int64_t>(k, permSize);
        auto acl_call = [=]() -> int {
            unpack_pivots_kernel<int64_t><<<numBlocks, nullptr, stream>>>(
                pivotsPtr, outPtr, batchCount, blockLength, k, permSize);
            return 0;
        };
        at_npu::native::OpCommand::RunOpApi("UnpackPivots", acl_call);
    }

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("unpack_pivots", unpack_pivots_npu);
}

} // namespace UnpackPivots
} // namespace ops_multimodal_fusion
