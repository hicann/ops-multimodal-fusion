/*!
 * \file foreach_frac.asc
 * \brief RegBase ForeachFrac operator for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.foreach_frac(tensors) -> Tensor[]
 *   tensors : Tensor[] - non-empty list of float32 / float16 tensors.
 *   returns : Tensor[] - same length; out[i] = frac(tensors[i]).
 *
 * Semantics match torch._foreach_frac:
 *   frac(x) = x - trunc(x), stored in the original floating dtype.
 *   Special: NaN -> NaN; +/-Inf -> NaN (inf - inf); zero results are +0.0
 *   (torch.frac never returns -0.0: frac(-0.0)=+0.0, frac(integer)=+0.0).
 *
 * Implementation follows the asc-from-scratch Ascend950 Reg shape:
 * __simd_vf__ Reg functions, __aicore__ asc_vf_call wrappers, and normal
 * AscendC code only for GM/UB movement, queues, and synchronization.
 * Host dispatch does shape checks and launch only; it does not fall back to
 * CPU or call helper NPU ops for casts/broadcasts.
 *
 * Compute path (mirrors foreach_ceil.asc):
 *   1. trunc(x): float -> int32 (CAST_TRUNC) -> float (CAST_NONE).
 *   2. frac = orig - trunc(x) via Reg::Sub.
 *   3. Special-value restore (Reg::Select) for NaN / +/-Inf / |x|>=2^31,
 *      plus zero-normalization to +0.0 (torch.frac never returns -0.0).
 *   For fp16: cast to fp32, compute, cast back.
 *
 * Host side: iterate tensor list, launch one kernel per tensor.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>
#include <vector>

namespace ops_multimodal_fusion {
namespace ForeachFrac {

static constexpr int64_t kMaxTileElems = 32768;
static constexpr int64_t kPipelineDepth = 2;

/* ── Schema registration ───────────────────────────────────────────────── */

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("foreach_frac(Tensor[] tensors) -> Tensor[]");
}

/* ── Common checks ─────────────────────────────────────────────────────── */

static void check_common(const at::TensorList &tensors, bool checkDevice)
{
    TORCH_CHECK(tensors.size() >= 1,
                "foreach_frac: input list must be non-empty");
    for (int64_t i = 0; i < static_cast<int64_t>(tensors.size()); ++i) {
        const auto &t = tensors[i];
        TORCH_CHECK(t.scalar_type() == torch::kFloat32 ||
                    t.scalar_type() == torch::kFloat16,
                    "foreach_frac: only float32 and float16 are supported "
                    "on dav-3510, got tensor[", i, "] dtype=",
                    t.scalar_type());
        if (checkDevice) {
            TORCH_CHECK(t.device().is_privateuseone(),
                        "foreach_frac: tensor[", i, "] must be on NPU device");
        }
    }
}

/* ── Meta registration ─────────────────────────────────────────────────── */

std::vector<torch::Tensor> foreach_frac_meta(at::TensorList tensors)
{
    check_common(tensors, /*checkDevice=*/false);
    std::vector<torch::Tensor> out;
    out.reserve(tensors.size());
    for (const auto &t : tensors) {
        out.push_back(torch::empty_like(t));
    }
    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("foreach_frac", foreach_frac_meta);
}

/* ── Tiling (single-tensor, geometric block-length pattern) ───────────── */

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t totalLength, int64_t elemSize)
{
    constexpr int64_t kMinElemsPerCore = 1024;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "foreach_frac: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum,
        (totalLength + kMinElemsPerCore - 1) / kMinElemsPerCore);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;

    // UB: double-buffered output queue (T) + fp32 scratch + fp32 spec buffer
    int64_t bytesPerElem =
        static_cast<int64_t>(kPipelineDepth) * elemSize +
        2 * static_cast<int64_t>(sizeof(float));
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / static_cast<int64_t>(sizeof(float));
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min(tileElems, kMaxTileElems);
    TORCH_CHECK(tileElems > 0,
                "foreach_frac: UB is too small for one aligned tile");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

/* ── Reg-based trunc: float -> int32(CAST_TRUNC) -> float(CAST_NONE) ────── */

__simd_vf__ inline void TruncRegVf(__ubuf__ float *dstAddr,
                                    __ubuf__ float *srcAddr,
                                    uint32_t count,
                                    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait truncTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_TRUNC};
    static constexpr AscendC::Reg::CastTrait backTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<int32_t> iReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<int32_t, float, truncTrait>(iReg, srcReg, mask);
        AscendC::Reg::Cast<float, int32_t, backTrait>(srcReg, iReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, srcReg, mask);
    }
}

__aicore__ inline void TruncReg(AscendC::LocalTensor<float> &dst,
                                 AscendC::LocalTensor<float> &src,
                                 int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<TruncRegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

/* ── Reg-based frac = x - trunc(x) with special-value restore ─────────── */

// After TruncReg, the float buffer holds trunc(x).  Compute frac = orig -
// trunc and restore torch-visible special cases.  All special decisions are
// derived from the ORIGINAL input (origBuf), not from the post-cast trunc,
// so correctness does not depend on how CAST_TRUNC behaves on out-of-range /
// Inf inputs under SatMode::NO_SAT:
//   - NaN (x != x)                 -> pass original through (NaN).
//   - |x| >= 2^31                  -> orig - orig: +0.0 for finite values
//                                     (every finite float32 of this magnitude
//                                     is already an integer, frac == 0), NaN
//                                     for +/-Inf (inf - inf).  This also
//                                     covers the int32-cast overflow region.
//   - otherwise (|x| < 2^31)       -> use the computed x - trunc(x).
//
// torch.frac never returns -0.0: frac(-0.0)=+0.0, frac(integer)=+0.0.  A
// final zero-normalization Select forces +0.0 on every result==0.0 lane so
// the kernel matches torch regardless of the hardware Sub sign-of-zero.
__simd_vf__ inline void FracRegVf(__ubuf__ float *outAddr,
                                   __ubuf__ float *origAddr,
                                   uint32_t count,
                                   uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    // 2^31: smallest magnitude at which the float32 -> int32 cast overflows.
    constexpr float kInt31Threshold = 2147483648.0f;
    AscendC::Reg::RegTensor<float> origReg, truncReg, resultReg, selfSubReg, zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);

        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            origReg, origAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            truncReg, outAddr + offset);

        // frac = orig - trunc(x).
        AscendC::Reg::Sub(resultReg, origReg, truncReg, mask);

        // selfSub = orig - orig: +0.0 for finite, NaN for Inf/NaN.
        AscendC::Reg::Sub(selfSubReg, origReg, origReg, mask);

        // NaN: x != x.
        AscendC::Reg::MaskReg nanMask;
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(
            nanMask, origReg, origReg, mask);

        // |x| >= 2^31 (finite-large where the int32 cast overflows, +/-Inf).
        AscendC::Reg::MaskReg geHiMask;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GE>(
            geHiMask, origReg, kInt31Threshold, mask);
        AscendC::Reg::MaskReg leLoMask;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(
            leLoMask, origReg, -kInt31Threshold, mask);
        AscendC::Reg::MaskReg bigMagMask;
        AscendC::Reg::Or(bigMagMask, geHiMask, leLoMask, mask);

        // +0.0 register for zero normalization (torch.frac never returns -0.0).
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);

        // Select priority (masks are mutually disjoint): computed frac, then
        // selfSub for big-magnitude (+0.0 finite / NaN Inf), then original
        // pass-through for NaN lanes.
        AscendC::Reg::Select<float>(
            resultReg, selfSubReg, resultReg, bigMagMask);
        AscendC::Reg::Select<float>(
            resultReg, origReg, resultReg, nanMask);

        // Zero normalization: force +0.0 on every zero-valued result lane
        // (covers -0.0 from Sub(x,x) for negative integers, -0.0 from -0.0
        // input via the Sub path, and -0.0 from selfSub for negative
        // finite-large).  NaN and Inf->NaN lanes are unaffected (NaN != 0.0).
        AscendC::Reg::MaskReg zeroMask;
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(
            zeroMask, resultReg, 0.0f, mask);
        AscendC::Reg::Select<float>(
            resultReg, zeroReg, resultReg, zeroMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            outAddr + offset, resultReg, mask);
    }
}

__aicore__ inline void FracReg(AscendC::LocalTensor<float> &fracBuf,
                                AscendC::LocalTensor<float> &origBuf,
                                int64_t count)
{
    __ubuf__ float *outAddr = (__ubuf__ float *)fracBuf.GetPhyAddr();
    __ubuf__ float *origAddr = (__ubuf__ float *)origBuf.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<FracRegVf>(outAddr, origAddr, elementCount, chunkCount);
}

/* ── Cast float -> half ────────────────────────────────────────────────── */

__simd_vf__ inline void CastFloatToHalfRegVf(__ubuf__ half *dstAddr,
                                               __ubuf__ float *srcAddr,
                                               uint32_t count,
                                               uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_RINT};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<half> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<half, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastFloatToHalfReg(AscendC::LocalTensor<half> &dst,
                                            AscendC::LocalTensor<float> &src,
                                            int64_t count)
{
    __ubuf__ half *dstAddr = (__ubuf__ half *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFloatToHalfRegVf>(dstAddr, srcAddr,
                                        elementCount, chunkCount);
}

/* ── Cast half -> float (for fp16 path) ────────────────────────────────── */

template <typename T>
__simd_vf__ inline void CastToFloatRegVf(__ubuf__ float *dstAddr,
                                           __ubuf__ T *srcAddr,
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait trait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, trait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastToFloatReg(AscendC::LocalTensor<float> &dst,
                                        AscendC::LocalTensor<T> &src,
                                        int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

/* ── Kernel ────────────────────────────────────────────────────────────── */

template <typename T>
class KernelForeachFrac {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;

public:
    __aicore__ inline KernelForeachFrac() {}

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                 int64_t totalLength,
                                 int64_t blockLength, int64_t tileElems)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        blockBase_ = blockLength * blockIdx;
        inputGm_.SetGlobalBuffer((__gm__ T *)input + blockBase_);
        outputGm_.SetGlobalBuffer((__gm__ T *)output + blockBase_);

        pipe_.InitBuffer(outQueueY_, kPipelineDepth, tileElems * sizeof(T));
        pipe_.InitBuffer(tbufFloat_, tileElems * sizeof(float));
        pipe_.InitBuffer(tbufSpec_, tileElems * sizeof(float));

        int64_t currentBlockLength = totalLength - blockBase_;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        tileElems_ = tileElems;
        tileCount_ = currentBlockLength / tileElems_;
        tailCount_ = currentBlockLength - tileCount_ * tileElems_;
        alignElems_ = 32 / static_cast<int64_t>(sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileCount_; ++i) {
            ProcessTile(i * static_cast<int64_t>(tileElems_),
                        static_cast<int64_t>(tileElems_));
        }
        if (tailCount_ > 0) {
            ProcessTile(tileCount_ * static_cast<int64_t>(tileElems_),
                        tailCount_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        int64_t alignedCount =
            ((count + alignElems_ - 1) / alignElems_) * alignElems_;

        AscendC::LocalTensor<float> floatBuf = tbufFloat_.Get<float>();

        if constexpr (kIsFloat) {
            // Float path: load directly into floatBuf.
            AscendC::DataCopyExtParams cp;
            cp.blockCount = 1;
            cp.blockLen = static_cast<uint32_t>(count * sizeof(float));
            cp.srcStride = 0;
            cp.dstStride = 0;
            AscendC::DataCopyPadExtParams<float> padParams{
                true, 0,
                static_cast<uint8_t>(alignedCount - count),
                static_cast<float>(0.0f)};
            AscendC::DataCopyPad(floatBuf, inputGm_[offset], cp, padParams);
            AscendC::PipeBarrier<PIPE_ALL>();
        } else {
            // Half path: load half into output queue, cast to float.
            AscendC::LocalTensor<T> yLocal =
                outQueueY_.template AllocTensor<T>();
            AscendC::DataCopyExtParams cp;
            cp.blockCount = 1;
            cp.blockLen = static_cast<uint32_t>(count * sizeof(T));
            cp.srcStride = 0;
            cp.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padParams{
                true, 0,
                static_cast<uint8_t>(alignedCount - count),
                static_cast<T>(0)};
            AscendC::DataCopyPad(yLocal, inputGm_[offset], cp, padParams);
            AscendC::PipeBarrier<PIPE_ALL>();
            CastToFloatReg(floatBuf, yLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_ALL>();
            outQueueY_.FreeTensor(yLocal);
        }

        // Save original values into specBuf: load a second copy from GM.
        // (UB-to-UB DataCopyPad is not available; two GM reads are used
        // instead.  Both read the same input data.)
        AscendC::LocalTensor<float> specBuf = tbufSpec_.Get<float>();
        AscendC::DataCopyExtParams cpSpec;
        cpSpec.blockCount = 1;
        cpSpec.blockLen = static_cast<uint32_t>(count * sizeof(T));
        cpSpec.srcStride = 0;
        cpSpec.dstStride = 0;
        if constexpr (kIsFloat) {
            AscendC::DataCopyPadExtParams<float> padF2{
                true, 0,
                static_cast<uint8_t>(alignedCount - count),
                static_cast<float>(0.0f)};
            AscendC::DataCopyPad(specBuf, inputGm_[offset], cpSpec, padF2);
        } else {
            // Half path: reload from GM + cast to float for original copy.
            AscendC::LocalTensor<T> yLocal2 =
                outQueueY_.template AllocTensor<T>();
            AscendC::DataCopyPadExtParams<T> padH2{
                true, 0,
                static_cast<uint8_t>(alignedCount - count),
                static_cast<T>(0)};
            AscendC::DataCopyPad(yLocal2, inputGm_[offset], cpSpec, padH2);
            AscendC::PipeBarrier<PIPE_ALL>();
            CastToFloatReg(specBuf, yLocal2, alignedCount);
            AscendC::PipeBarrier<PIPE_ALL>();
            outQueueY_.FreeTensor(yLocal2);
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        // trunc(x): float -> int32 (CAST_TRUNC) -> float (CAST_NONE).
        TruncReg(floatBuf, floatBuf, alignedCount);
        AscendC::PipeBarrier<PIPE_V>();

        // frac = orig - trunc(x), with special-value restore.
        FracReg(floatBuf, specBuf, count);
        AscendC::PipeBarrier<PIPE_ALL>();

        if constexpr (kIsFloat) {
            // Write float result back to GM.
            AscendC::DataCopyExtParams cp;
            cp.blockCount = 1;
            cp.blockLen = static_cast<uint32_t>(count * sizeof(float));
            cp.srcStride = 0;
            cp.dstStride = 0;
            AscendC::DataCopyPad(outputGm_[offset], floatBuf, cp);
            AscendC::PipeBarrier<PIPE_ALL>();
        } else {
            // Cast back to half and store.
            AscendC::LocalTensor<T> yLocal =
                outQueueY_.template AllocTensor<T>();
            CastFloatToHalfReg(yLocal, floatBuf, alignedCount);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams cp;
            cp.blockCount = 1;
            cp.blockLen = static_cast<uint32_t>(count * sizeof(T));
            cp.srcStride = 0;
            cp.dstStride = 0;
            AscendC::DataCopyPad(outputGm_[offset], yLocal, cp);
            AscendC::PipeBarrier<PIPE_ALL>();
            outQueueY_.FreeTensor(yLocal);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSpec_;
    int64_t blockBase_ = 0;
    int64_t tileElems_ = 0;
    int64_t tileCount_ = 0;
    int64_t tailCount_ = 0;
    int64_t alignElems_ = 8;
};

/* ── Launch ────────────────────────────────────────────────────────────── */

template <typename T>
__global__ __aicore__ __vector__ void foreach_frac_kernel(
    GM_ADDR input, GM_ADDR output,
    int64_t totalLength, int64_t blockLength, int64_t tileElems)
{
    KernelForeachFrac<T> op;
    op.Init(input, output, totalLength, blockLength, tileElems);
    op.Process();
}

/* ── Per-tensor kernel launch ──────────────────────────────────────────── */

static void launch_single_tensor(const torch::Tensor &input,
                                   const torch::Tensor &output)
{
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = input.numel();
    if (totalLength == 0) return;

    auto inputC = input.contiguous();
    (void)output;  // output must be pre-allocated by caller

    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(totalLength, inputC.element_size());

    auto inPtr = (GM_ADDR)inputC.data_ptr();
    auto outPtr = (GM_ADDR)output.data_ptr();

    AT_DISPATCH_SWITCH(
        inputC.scalar_type(), "foreach_frac_npu",
        AT_DISPATCH_CASE(torch::kFloat32, [&] {
            foreach_frac_kernel<float>
                <<<numBlocks, nullptr, stream>>>(
                inPtr, outPtr, totalLength, blockLength, tileElems);
        })
        AT_DISPATCH_CASE(torch::kFloat16, [&] {
            foreach_frac_kernel<half>
                <<<numBlocks, nullptr, stream>>>(
                inPtr, outPtr, totalLength, blockLength, tileElems);
        })
    );
}

/* ── NPU entry point (host-side tensor list iteration) ────────────────── */

std::vector<torch::Tensor> foreach_frac_npu(at::TensorList tensors)
{
    check_common(tensors, /*checkDevice=*/true);
    const c10::OptionalDeviceGuard guard(tensors[0].device());

    std::vector<torch::Tensor> out;
    out.reserve(tensors.size());

    for (const auto &t : tensors) {
        auto t_contig = t.contiguous();
        auto o = torch::empty_like(t_contig);
        auto acl_call = [t_contig, o]() -> int {
            launch_single_tensor(t_contig, o);
            return 0;
        };
        at_npu::native::OpCommand::RunOpApi("ForeachFrac", acl_call);
        out.push_back(o);
    }

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("foreach_frac", foreach_frac_npu);
}

} // namespace ForeachFrac
} // namespace ops_multimodal_fusion
