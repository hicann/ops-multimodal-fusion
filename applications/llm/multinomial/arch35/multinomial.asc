/*!
 * \file multinomial.asc
 * \brief Multinomial (categorical) sampling operator for Ascend NPU (dav-3510)
 *
 * torch.multinomial(x, num_samples, replacement=False) equivalent, exposed:
 *   ops_multimodal_fusion.multinomial(x, num_samples, replacement=False, seed=0) -> Tensor(int64)
 *
 * x = per-row non-negative weights, 1-D (K,) or 2-D (numDist, K); the last
 * dim K is the category axis. Output int64 indices, shape (num_samples,) for
 * 1-D x or (numDist, num_samples) for 2-D x.
 *
 * Algorithm (PyTorch MultinomialKernel.cu, with-replacement path):
 *   renorm + cumsum + per-sample uniform + binarySearchForMultinomial.
 *   The chosen index for a uniform u is the smallest i with cumdist[i] >= t
 *   (t = u * rowSum), which equals #{ i : cumdist[i] < t }. Because the
 *   weights are >= 0 the prefix sum cumdist is monotone non-decreasing
 *   (a sorted sequence), so this is EXACTLY the count form already used by
 *   the merged searchsorted op: Reg::Compares<LT> + Reduce<SUM>(ones). The
 *   L1 renorm is folded into t = u * rowSum (no explicit normDist needed).
 *
 * Per-row layout: rowSum and the prefix sum cumdist are accumulated in a
 * one-time scalar pass over K (K is small, <= vec_width; this mirrors
 * searchsorted's per-query scalar read -- it is NOT the vector-result
 * GetValue anti-pattern). All compute is in float to match PyTorch's
 * accscalar_t (an fp16-domain sum would lose CDF precision); hence K is
 * bounded by the float vector register width (64) for both fp32 and fp16
 * input -- slightly tighter than a per-dtype vec_width, but numerically
 * correct. The expensive per-sample step stays vectorized in the Reg vf.
 *
 * int64 output via the searchsorted/kthvalue trick: int32 idx in lane 0,
 * 0 in lane 1, DMA'd out as int64 low/high -- avoids an int32->int64 Cast
 * that has no binary on this platform.
 *
 * Dispatch scope (v1, conservative -- mirrors searchsorted's deferral
 * discipline):
 *   - x.dim() in {1,2}, x in {fp32,fp16}, output int64
 *   - num_samples > 0 ; K <= 2^24 ; K <= 64 (chunked path deferred)
 *   - per element >= 0 and finite, per row sum > 0 (host TORCH_CHECK on a
 *     CPU copy, like gamma/poisson)
 *   - replacement=True, or num_samples==1 (any replacement: a single draw
 *     is distributionally Categorical(p), same as PyTorch's Gumbel-argmax;
 *     RNG layout differs anyway -> statistical acceptance)
 *   - replacement=False && num_samples>1 (without-replacement Gumbel-topk)
 *     -> host reject, deferred to a follow-up
 *
 * PhiloxRandom counter = the flat output index (row*num_samples + sample),
 * so every sample of every row draws an independent uniform; deterministic
 * given (seed, shape, input). Not bit-compatible with PyTorch curand ->
 * statistical (frequency) acceptance; see tests/multinomial/test_multinomial.py.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "adv_api/math/philox.h"
#include <algorithm>
#include <tuple>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Multinomial {

// Float vector register width on dav-3510 (256B / 4). All CDF compute is
// float (accscalar parity), so this bounds K for both input dtypes.
constexpr int64_t VEC_WIDTH_F = 64;
// PhiloxRandom count is uint16_t; keep one sample tile well under 65535.
constexpr int64_t MAX_SAMPLES_PER_TILE = 32768;

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("multinomial(Tensor x, int num_samples, bool replacement=False, int seed=0) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor multinomial_meta(const torch::Tensor &x, int64_t num_samples,
                               bool replacement, int64_t seed)
{
    (void)seed;
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "multinomial: only float32 and float16 input are supported on dav-3510, got ",
                x.scalar_type());
    TORCH_CHECK(x.dim() == 1 || x.dim() == 2,
                "multinomial: x must be 1 or 2 dimensional, got ", x.dim(), "-D");
    TORCH_CHECK(num_samples > 0, "multinomial: cannot sample num_samples <= 0");
    if (x.dim() == 1) {
        return torch::empty({num_samples}, x.options().dtype(torch::kInt64));
    }
    return torch::empty({x.size(0), num_samples}, x.options().dtype(torch::kInt64));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("multinomial", multinomial_meta);
}

// ===================== 3. Tiling =====================

// numDist split across cores. Per row: probs + cumdist (K float), one sample
// tile of uniforms + 32B count slots + int64 out. K <= VEC_WIDTH_F.
static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t numDist, int64_t K, int64_t numSamples)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "multinomial: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, numDist);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockDist = (numDist + numBlocks - 1) / numBlocks;

    // Fixed per-row buffers: probs(K f) + cumdist(K f) + a vec-width pad so
    // the count vf LoadAlign stays in-bounds.
    int64_t kBufBytes = 2 * VEC_WIDTH_F * static_cast<int64_t>(sizeof(float));
    // Per sample in a tile: uniform(f) + 32B count slot + int64 out, x2 (DB).
    int64_t bytesPerSample = PIPELINE_DEPTH *
        (static_cast<int64_t>(sizeof(float)) + 32 + static_cast<int64_t>(sizeof(int64_t)));
    constexpr static int64_t SAFETY = 2048;
    int64_t budget = static_cast<int64_t>(ubSize) - kBufBytes - SAFETY;
    TORCH_CHECK(budget >= bytesPerSample,
                "multinomial: UB too small (K=", K, ")");
    int64_t samplesPerTile = budget / bytesPerSample;
    if (samplesPerTile > MAX_SAMPLES_PER_TILE) samplesPerTile = MAX_SAMPLES_PER_TILE;
    if (samplesPerTile > numSamples) samplesPerTile = numSamples;
    if (samplesPerTile < 1) samplesPerTile = 1;
    return std::make_tuple(numBlocks, blockDist, samplesPerTile);
}

// ===================== 4. Kernel - 3-layer Reg shape =====================

// half -> float (fp16 input). Reused gamma/searchsorted form.
__simd_vf__ inline void CastHalfToFloatRegVf(__ubuf__ float *dstAddr, __ubuf__ half *srcAddr,
                                             uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<half> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, half, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, dstReg, mask);
    }
}

__aicore__ inline void CastHalfToFloatReg(AscendC::LocalTensor<float> &dst,
                                          AscendC::LocalTensor<half> &src, int64_t count)
{
    __ubuf__ float *d = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ half *s = (__ubuf__ half *)src.GetPhyAddr();
    constexpr uint32_t vl = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t ec = static_cast<uint32_t>(count);
    asc_vf_call<CastHalfToFloatRegVf>(d, s, ec, (ec + vl - 1) / vl);
}

// Inverse-CDF index for one sample: count of cumdist lanes < target.
// cumdist is monotone non-decreasing (sorted), so this equals the smallest
// i with cumdist[i] >= target = PyTorch binarySearchForMultinomial. Verbatim
// adaptation of the merged searchsorted SearchsortedCountVf (float domain).
// K <= VEC_WIDTH_F so one register covers the row (single chunk).
__simd_vf__ inline void CdfCountVf(
    __ubuf__ float *cumPtr, float target, __ubuf__ float *countOutPtr,
    uint32_t elementCount)
{
    AscendC::Reg::RegTensor<float> cumReg;
    AscendC::Reg::RegTensor<float> onesReg;
    AscendC::Reg::RegTensor<float> countReg;

    AscendC::Reg::MaskReg validMask = AscendC::Reg::UpdateMask<float>(elementCount);
    uint32_t scalarOne = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarOne);

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(cumReg, cumPtr);
    AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
        onesReg, 1.0f, validMask);

    AscendC::Reg::MaskReg ltMask;
    AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(
        ltMask, cumReg, target, validMask);

    AscendC::Reg::Reduce<
        AscendC::Reg::ReduceType::SUM, float, float, AscendC::Reg::MaskMergeMode::ZEROING>(
            countReg, onesReg, ltMask);

    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        countOutPtr, countReg, scalarMask);
}

__aicore__ inline void CdfCount(
    AscendC::LocalTensor<float> &cumLT, float target,
    AscendC::LocalTensor<float> &scratchLT, uint32_t slotIdx,
    uint32_t elementCount)
{
    constexpr uint32_t SLOT_LANES_F = 32 / sizeof(float);  // 8
    __ubuf__ float *cumPtr = (__ubuf__ float *)cumLT.GetPhyAddr();
    __ubuf__ float *outPtr = (__ubuf__ float *)scratchLT.GetPhyAddr()
                             + slotIdx * SLOT_LANES_F;
    asc_vf_call<CdfCountVf>(cumPtr, target, outPtr, elementCount);
}

template <typename T>
class KernelMultinomial {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;

public:
    __aicore__ inline KernelMultinomial() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR out, int64_t numDist,
        int64_t K, int64_t numSamples, int64_t blockDist,
        int64_t samplesPerTile, uint32_t key0, uint32_t key1)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        K_ = K;
        numSamples_ = numSamples;
        samplesPerTile_ = samplesPerTile;
        rowBase_ = blockDist * blockIdx;
        int64_t rows = numDist - rowBase_;
        if (rows > blockDist) rows = blockDist;
        if (rows < 0) rows = 0;
        rowsThisBlock_ = rows;

        // Global GM bases (block offset applied per access, searchsorted-style).
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        // out int64 viewed as int32 stride-2 (low=idx, high=0).
        outGm_.SetGlobalBuffer((__gm__ int32_t *)out);

        key0_ = key0;
        key1_ = key1;

        pipe_.InitBuffer(inQueueX_, PIPELINE_DEPTH, VEC_WIDTH_F * sizeof(T));
        pipe_.InitBuffer(tbufProbF_,                VEC_WIDTH_F * sizeof(float));
        pipe_.InitBuffer(tbufCumF_,                 VEC_WIDTH_F * sizeof(float));
        pipe_.InitBuffer(tbufU_,                    samplesPerTile * sizeof(float));
        pipe_.InitBuffer(tbufCount_,                samplesPerTile * 32);
        pipe_.InitBuffer(outQueueIdx_, PIPELINE_DEPTH, samplesPerTile * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        for (int64_t r = 0; r < rowsThisBlock_; ++r) {
            ProcessRow(r);
        }
    }

private:
    __aicore__ inline void ProcessRow(int64_t rLocal)
    {
        int64_t K = K_;
        int64_t globalRow = rowBase_ + rLocal;
        int64_t rowOffElem = globalRow * K;

        // CopyIn K weights for this row (last dim contiguous -> no stride).
        AscendC::LocalTensor<T> xIn = inQueueX_.template AllocTensor<T>();
        AscendC::DataCopyExtParams inP;
        inP.blockCount = 1; inP.blockLen = K * sizeof(T); inP.srcStride = 0; inP.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padP{false, 0, 0, 0};
        AscendC::DataCopyPad(xIn, xGm_[rowOffElem], inP, padP);
        inQueueX_.EnQue(xIn);
        xIn = inQueueX_.template DeQue<T>();

        AscendC::LocalTensor<float> probF = tbufProbF_.Get<float>();
        AscendC::LocalTensor<float> cumF  = tbufCumF_.Get<float>();
        if constexpr (kIsFloat) {
            AscendC::DataCopy(probF, xIn, ((K + 7) / 8) * 8);
        } else {
            CastHalfToFloatReg(probF, xIn, ((K + 7) / 8) * 8);
        }
        inQueueX_.FreeTensor(xIn);
        AscendC::PipeBarrier<PIPE_ALL>();

        // One-time scalar prefix sum -> cumdist; rowSum = cumF[K-1]. Scalar
        // over K (<= 64) once per row (searchsorted-style scalar read, not
        // the vector-result anti-pattern). t = u*rowSum folds the L1 renorm.
        float acc = 0.0f;
        for (int64_t k = 0; k < K; ++k) {
            acc += probF.GetValue(k);
            cumF.SetValue(k, acc);
        }
        float rowSum = acc;  // host guarantees rowSum > 0
        AscendC::PipeBarrier<PIPE_ALL>();

        int64_t consumed = 0;
        while (consumed < numSamples_) {
            int64_t tileN = numSamples_ - consumed;
            if (tileN > samplesPerTile_) tileN = samplesPerTile_;
            ProcessSampleTile(rLocal, consumed, tileN, cumF, probF, rowSum);
            consumed += tileN;
        }
    }

    __aicore__ inline void ProcessSampleTile(int64_t rLocal, int64_t sampleBase,
        int64_t tileN, AscendC::LocalTensor<float> &cumF,
        AscendC::LocalTensor<float> &probF, float rowSum)
    {
        AscendC::LocalTensor<float> uBuf  = tbufU_.Get<float>();
        AscendC::LocalTensor<float> cntS  = tbufCount_.Get<float>();

        // Independent uniform per (row, sample): counter = flat output index
        // (globalRow*numSamples + sampleBase); consecutive samples -> distinct
        // Philox stream. Deterministic given seed+shape+input.
        int64_t globalRow = rowBase_ + rLocal;
        int64_t flatBase  = globalRow * numSamples_ + sampleBase;
        uint32_t ctrLo = static_cast<uint32_t>(static_cast<uint64_t>(flatBase) & 0xFFFFFFFFu);
        uint32_t ctrHi = static_cast<uint32_t>((static_cast<uint64_t>(flatBase) >> 32) & 0xFFFFFFFFu);
        AscendC::PhiloxKey key{key0_, key1_};
        AscendC::PhiloxCounter ctr{ctrLo, ctrHi, 0u, 0u};
        AscendC::PhiloxRandom<7, float>(uBuf, key, ctr, static_cast<uint16_t>(tileN));
        AscendC::PipeBarrier<PIPE_ALL>();

        constexpr uint32_t SLOT_LANES_F = 32 / sizeof(float);  // 8

        for (int64_t s = 0; s < tileN; ++s) {
            float u = uBuf.GetValue(s);            // [0,1)
            float target = u * rowSum;             // in [0, cumF[K-1])
            CdfCount(cumF, target, cntS, static_cast<uint32_t>(s),
                     static_cast<uint32_t>(K_));
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        AscendC::LocalTensor<int32_t> outIdx = outQueueIdx_.template AllocTensor<int32_t>();
        for (int64_t s = 0; s < tileN; ++s) {
            int64_t idx = static_cast<int64_t>(cntS.GetValue(s * SLOT_LANES_F));
            // u in [0,1) and rowSum=cumF[K-1] => target < rowSum => idx<=K-1;
            // guard anyway, then back off trailing zero-prob categories
            // (PyTorch binarySearchForMultinomial tail behaviour).
            if (idx >= K_) idx = K_ - 1;
            if (idx < 0) idx = 0;
            while (idx >= 1 && probF.GetValue(idx) == 0.0f) idx--;
            outIdx.SetValue(static_cast<int32_t>(2 * s),     static_cast<int32_t>(idx));
            outIdx.SetValue(static_cast<int32_t>(2 * s + 1), 0);
        }
        outQueueIdx_.EnQue(outIdx);
        outIdx = outQueueIdx_.template DeQue<int32_t>();

        // int64 element index of (globalRow, sampleBase) -> int32 stride-2
        // (globalRow / flatBase already computed above for the Philox counter).
        int64_t outInt32Base = (globalRow * numSamples_ + sampleBase) * 2;
        AscendC::DataCopyExtParams oP;
        oP.blockCount = 1; oP.blockLen = tileN * sizeof(int64_t);
        oP.srcStride = 0; oP.dstStride = 0;
        AscendC::DataCopyPad(outGm_[outInt32Base], outIdx, oP);
        outQueueIdx_.FreeTensor(outIdx);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<int32_t> outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueX_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufProbF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCumF_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufU_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufCount_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueIdx_;
    int64_t K_ = 0;
    int64_t numSamples_ = 0;
    int64_t samplesPerTile_ = 0;
    int64_t rowBase_ = 0;
    int64_t rowsThisBlock_ = 0;
    uint32_t key0_ = 0;
    uint32_t key1_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void multinomial_kernel(
    GM_ADDR x, GM_ADDR out, int64_t numDist, int64_t K, int64_t numSamples,
    int64_t blockDist, int64_t samplesPerTile, uint32_t key0, uint32_t key1)
{
    KernelMultinomial<T> op;
    op.Init(x, out, numDist, K, numSamples, blockDist, samplesPerTile, key0, key1);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor multinomial_npu(const torch::Tensor &x, int64_t num_samples,
                              bool replacement, int64_t seed)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32 ||
                x.scalar_type() == torch::kFloat16,
                "multinomial: only float32 and float16 input are supported on dav-3510, got ",
                x.scalar_type());
    TORCH_CHECK(x.dim() == 1 || x.dim() == 2,
                "multinomial: x must be 1 or 2 dimensional, got ", x.dim(), "-D");
    TORCH_CHECK(num_samples > 0, "multinomial: cannot sample num_samples <= 0");

    int64_t K = x.size(-1);
    int64_t numDist = (x.dim() == 1) ? 1 : x.size(0);

    TORCH_CHECK(K <= (int64_t{1} << 24),
                "multinomial: number of categories cannot exceed 2^24, got ", K);
    TORCH_CHECK(K <= VEC_WIDTH_F,
                "multinomial: K=", K, " exceeds the v1 limit ", VEC_WIDTH_F,
                " (the chunked-category path is deferred)");
    TORCH_CHECK(replacement || num_samples == 1,
                "multinomial: replacement=False with num_samples>1 "
                "(sampling without replacement) is deferred; pass replacement=True "
                "or num_samples=1");

    if (x.numel() > 0) {
        // Per PyTorch: weights must be finite, non-negative, and each row's
        // sum must be > 0. Validate on a host copy (robust, no device
        // reduction), like gamma/poisson's host non-negativity check.
        auto xc = x.detach().to(torch::kCPU).to(torch::kFloat32);
        TORCH_CHECK(xc.isfinite().all().item<bool>(),
                    "multinomial: probability tensor contains inf or nan");
        TORCH_CHECK(xc.min().item<double>() >= 0.0,
                    "multinomial: probability tensor must be non-negative");
        auto rowsum = (x.dim() == 1) ? xc.sum().reshape({1}) : xc.sum(1);
        TORCH_CHECK(rowsum.min().item<double>() > 0.0,
                    "multinomial: invalid distribution (a row sum of probabilities is <= 0)");
    }

    const c10::OptionalDeviceGuard guard(x.device());
    auto x_contig = x.contiguous();
    torch::Tensor out = (x.dim() == 1)
        ? torch::empty({num_samples}, x.options().dtype(torch::kInt64))
        : torch::empty({numDist, num_samples}, x.options().dtype(torch::kInt64));
    if (out.numel() == 0) {
        return out;
    }

    int64_t numBlocks, blockDist, samplesPerTile;
    std::tie(numBlocks, blockDist, samplesPerTile) =
        calc_tiling_params(numDist, K, num_samples);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr = (GM_ADDR)x_contig.data_ptr();
    auto out_ptr = (GM_ADDR)out.data_ptr();
    uint32_t key0 = static_cast<uint32_t>(static_cast<uint64_t>(seed) & 0xFFFFFFFFu);
    uint32_t key1 = static_cast<uint32_t>((static_cast<uint64_t>(seed) >> 32) & 0xFFFFFFFFu);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x_contig.scalar_type(), "multinomial_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                multinomial_kernel<float><<<numBlocks, nullptr, stream>>>(
                    x_ptr, out_ptr, numDist, K, num_samples, blockDist,
                    samplesPerTile, key0, key1);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                multinomial_kernel<half><<<numBlocks, nullptr, stream>>>(
                    x_ptr, out_ptr, numDist, K, num_samples, blockDist,
                    samplesPerTile, key0, key1);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Multinomial", acl_call);
    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("multinomial", multinomial_npu);
}

} // namespace Multinomial
} // namespace ops_multimodal_fusion
