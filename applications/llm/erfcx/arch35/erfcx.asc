/*!
 * \file erfcx.asc
 * \brief Erfcx (scaled complementary error function) operator for Ascend NPU
 *
 *   y = erfcx(x) = e^{x²} · erfc(x)
 *
 * Naive exp(x²)·erfc(x) overflows float32 for |x| > ~9.4; and for x ≥ 4
 * catastrophic cancellation in (1 − erf(x)) destroys all precision. We
 * therefore evaluate a piecewise rational approximation following W. J.
 * Cody, "Rational Chebyshev Approximations for the Error Function"
 * (Math. Comp. 23, 1969) — the same coefficients used by SLATEC, netlib,
 * and scipy.special.erfcx.
 *
 * For z = |x|:
 *   Region 1 (0 ≤ z ≤ 0.46875):
 *       erfcx(z) = (1 − z·P₁(z²)/Q₁(z²)) · exp(z²)
 *       (P₁/Q₁ approximates erf; we form 1 − erf then lift by exp(z²).)
 *
 *   Region 2 (0.46875 < z ≤ 4):
 *       erfcx(z) = P₂(z) / Q₂(z)
 *       (Rational approximation directly for erfcx — no exp needed.)
 *
 *   Region 3 (z > 4):
 *       erfcx(z) = (1/√π − (1/z²)·P₃(1/z²)/Q₃(1/z²)) / z
 *       (Asymptotic rational series.)
 *
 * For x < 0:
 *       erfcx(x) = 2·e^{x²} − erfcx(−x)
 *   When x² > ~88.7 this overflows float32 → +∞, which is the correct
 *   saturation behaviour and matches torch.special.erfcx.
 *
 * SIMD strategy: all three regions are evaluated unconditionally on
 * per-region-clamped inputs (so every intermediate stays finite), then
 * blended by Relu-based hard-step masks at z = 0.46875 and z = 4. The
 * negative-x lift uses exp(min(x,0)²) rather than exp(x²) so that for
 * x ≥ 0 the lift term is finite and multiplying by the zero mask cannot
 * produce inf·0 = NaN.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Erfcx {

// 1. Register the operator's schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("erfcx(Tensor x) -> Tensor");
}

// 2. Meta function
torch::Tensor erfcx_meta(const torch::Tensor &x)
{
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("erfcx", erfcx_meta);
}

// 3. Tiling parameter calculation
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 2 queues * PIPELINE_DEPTH + 5 TBuf scratch = 9 tile-sized buffers
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 2 + 5;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // 32B aligned
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// 4. Kernel implementation
class KernelErfcx {
public:
    __aicore__ inline KernelErfcx() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize)
    {
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueX_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tbuf1_, tileSize);
        pipe_.InitBuffer(tbuf2_, tileSize);
        pipe_.InitBuffer(tbuf3_, tileSize);
        pipe_.InitBuffer(tbuf4_, tileSize);
        pipe_.InitBuffer(tbuf5_, tileSize);

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        elementNumPerTile_ = tileSize / sizeof(float);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        // ---- Cody 1969 coefficients (scipy.special.erfcx / netlib calerf) ----
        // Region 1: erf(z) ≈ z · xnum(z²) / xden(z²)
        const float R1_A0 = 3.16112374387056560e00f;
        const float R1_A1 = 1.13864154151050156e02f;
        const float R1_A2 = 3.77485237685302021e02f;
        const float R1_A3 = 3.20937758913846947e03f;
        const float R1_A4 = 1.85777706184603153e-1f;
        const float R1_B0 = 2.36012909523441209e01f;
        const float R1_B1 = 2.44024637934444173e02f;
        const float R1_B2 = 1.28261652607737228e03f;
        const float R1_B3 = 2.84423683343917062e03f;

        // Region 2: erfcx(z) ≈ xnum(z) / xden(z)
        const float R2_C0 = 5.64188496988670089e-1f;
        const float R2_C1 = 8.88314979438837594e00f;
        const float R2_C2 = 6.61191906371416295e01f;
        const float R2_C3 = 2.98635138197400131e02f;
        const float R2_C4 = 8.81952221241769090e02f;
        const float R2_C5 = 1.71204761263407058e03f;
        const float R2_C6 = 2.05107837782607147e03f;
        const float R2_C7 = 1.23033935479799725e03f;
        const float R2_C8 = 2.15311535474403846e-8f;
        const float R2_D0 = 1.57449261107098347e01f;
        const float R2_D1 = 1.17693950891312499e02f;
        const float R2_D2 = 5.37181101862009858e02f;
        const float R2_D3 = 1.62138957456669019e03f;
        const float R2_D4 = 3.29079923573345963e03f;
        const float R2_D5 = 4.36261909014324716e03f;
        const float R2_D6 = 3.43936767414372164e03f;
        const float R2_D7 = 1.23033935480374942e03f;

        // Region 3: erfcx(z) ≈ (1/√π − ysq · xnum(ysq)/xden(ysq)) / z,  ysq = 1/z²
        const float R3_P0 = 3.05326634961232344e-1f;
        const float R3_P1 = 3.60344899949804439e-1f;
        const float R3_P2 = 1.25781726111229246e-1f;
        const float R3_P3 = 1.60837851487422766e-2f;
        const float R3_P4 = 6.58749161529837803e-4f;
        const float R3_P5 = 1.63153871373020978e-2f;
        const float R3_Q0 = 2.56852019228982242e00f;
        const float R3_Q1 = 1.87295284992346047e00f;
        const float R3_Q2 = 5.27905102951428413e-1f;
        const float R3_Q3 = 6.05183413124413191e-2f;
        const float R3_Q4 = 2.33520497626869185e-3f;

        const float SQRPI      = 5.64189583547756287e-1f;   // 1/√π
        const float THRESH1    = 0.46875f;                  // 15/32 — exact in fp32
        const float THRESH1_SQ = 0.2197265625f;             // (15/32)² — exact in fp32
        const float THRESH2    = 4.0f;
        const float STEP_SHARPNESS = 1.0e6f;
        const float SIGN_EPS       = 1.0e-30f;

        AscendC::LocalTensor<float> xLocal = inQueueX_.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQueueY_.AllocTensor<float>();
        auto t1 = tbuf1_.Get<float>();  // z = |x|;  transiently repurposed as xden in Region 3
        auto t2 = tbuf2_.Get<float>();  // r_acc (accumulated result; scratch until end of Region 1)
        auto t3 = tbuf3_.Get<float>();  // region scratch
        auto t4 = tbuf4_.Get<float>();  // region scratch
        auto t5 = tbuf5_.Get<float>();  // region scratch

        // ---- Setup: t1 = |x| ----
        AscendC::Abs(t1, xLocal, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ==========================================================
        // Region 1: z ∈ [0, 0.46875]
        //   r1 = (1 − z_c1 · R1(z_c1²)) · exp(z_c1²),  z_c1 = min(z, 0.46875)
        //   Uses all 5 TBufs; t2 serves as xden scratch and is
        //   overwritten to hold r_acc = r1 at the end.
        // ==========================================================
        // t3 = z_c1 = min(z, 0.46875) = z − Relu(z − 0.46875)
        AscendC::Adds(t3, t1, -THRESH1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(t3, t1, t3, count);            // t3 = z_c1
        AscendC::PipeBarrier<PIPE_V>();

        // t4 = z_c1²  (poly variable; also fed to Exp at the end)
        AscendC::Mul(t4, t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();

        // Horner on t4 (= z_c1²):
        //   xnum = A4·t4; xden = t4 (+ first-iter fuse with A0, B0)
        //   then iters i=1..2 add Ai/Bi and multiply by t4
        //   final: + A3 / + B3;  R1 = xnum / xden
        AscendC::Muls(t5, t4, R1_A4, count);        // xnum
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t5, t5, R1_A0, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t5, t5, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t2, t4, R1_B0, count);        // xden init (fused first iter)
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t2, t2, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        // iter 1
        AscendC::Adds(t5, t5, R1_A1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t5, t5, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t2, t2, R1_B1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t2, t2, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        // iter 2
        AscendC::Adds(t5, t5, R1_A2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t5, t5, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t2, t2, R1_B2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t2, t2, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        // final
        AscendC::Adds(t5, t5, R1_A3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t2, t2, R1_B3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(t5, t5, t2, count);            // t5 = R1(z_c1²)
        AscendC::PipeBarrier<PIPE_V>();

        // erf_val = z_c1 * R1;  then 1 − erf_val
        AscendC::Mul(t5, t5, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t5, t5, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t5, t5, 1.0f, count);         // t5 = 1 − erf(z_c1)
        AscendC::PipeBarrier<PIPE_V>();

        // t2 = exp(z_c1²)  (overwrites xden, no longer needed)
        AscendC::Exp(t2, t4, count);
        AscendC::PipeBarrier<PIPE_V>();

        // t2 = r_acc = r1 = (1 − erf_val) · exp(z_c1²)
        AscendC::Mul(t2, t5, t2, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ==========================================================
        // Region 2: z ∈ (0.46875, 4]
        //   r2 = P2(z_c2) / Q2(z_c2),  z_c2 = clamp(z, 0.46875, 4)
        // ==========================================================
        // t3 = min(z, 4)
        AscendC::Adds(t3, t1, -THRESH2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(t3, t1, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        // t3 = max(t3, 0.46875) = t3 + Relu(0.46875 − t3)
        AscendC::Muls(t4, t3, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t4, t4, THRESH1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t4, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(t3, t3, t4, count);            // t3 = z_c2
        AscendC::PipeBarrier<PIPE_V>();

        // Horner on t3 (= z_c2):
        //   xnum = C8·t3; xden = t3 (+ first-iter fuse with C0, D0)
        //   iters i=1..6;  final + C7 / + D7;  r2 = xnum / xden
        AscendC::Muls(t4, t3, R2_C8, count);        // xnum
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t4, t4, R2_C0, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t4, t4, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t5, t3, R2_D0, count);        // xden init (fused first iter)
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t5, t5, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
#define ERFCX_R2_STEP(CI, DI)                                                   \
        AscendC::Adds(t4, t4, (CI), count); AscendC::PipeBarrier<PIPE_V>();     \
        AscendC::Mul(t4, t4, t3, count);    AscendC::PipeBarrier<PIPE_V>();     \
        AscendC::Adds(t5, t5, (DI), count); AscendC::PipeBarrier<PIPE_V>();     \
        AscendC::Mul(t5, t5, t3, count);    AscendC::PipeBarrier<PIPE_V>()
        ERFCX_R2_STEP(R2_C1, R2_D1);
        ERFCX_R2_STEP(R2_C2, R2_D2);
        ERFCX_R2_STEP(R2_C3, R2_D3);
        ERFCX_R2_STEP(R2_C4, R2_D4);
        ERFCX_R2_STEP(R2_C5, R2_D5);
        ERFCX_R2_STEP(R2_C6, R2_D6);
#undef ERFCX_R2_STEP
        AscendC::Adds(t4, t4, R2_C7, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t5, t5, R2_D7, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(t4, t4, t5, count);            // t4 = r2
        AscendC::PipeBarrier<PIPE_V>();

        // sel23 = step(z − 0.46875) — hard 0/1 via clamp((·)·SHARPNESS, 0, 1)
        AscendC::Adds(t5, t1, -THRESH1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t5, t5, STEP_SHARPNESS, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t5, t5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t5, t5, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t5, t5, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t5, t5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t5, t5, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t5, t5, 1.0f, count);         // t5 = sel23
        AscendC::PipeBarrier<PIPE_V>();

        // Blend: r_acc += sel23 · (r2 − r_acc)
        AscendC::Sub(t4, t4, t2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t4, t4, t5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(t2, t2, t4, count);            // r_acc updated
        AscendC::PipeBarrier<PIPE_V>();

        // ==========================================================
        // Region 3: z > 4
        //   r3 = (1/√π − ysq · R3(ysq)) / z_c3,  z_c3 = max(z, 4),  ysq = 1/z_c3²
        // NOTE: t1 (= z) is repurposed as xden scratch; recomputed before mask build.
        // ==========================================================
        // t3 = z_c3 = max(z, 4) = Relu(z − 4) + 4
        AscendC::Adds(t3, t1, -THRESH2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t3, t3, THRESH2, count);      // t3 = z_c3
        AscendC::PipeBarrier<PIPE_V>();

        // t4 = z_c3²;  t5 = Duplicate(1);  t5 = 1 / z_c3² = ysq
        AscendC::Mul(t4, t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Duplicate(t5, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(t5, t5, t4, count);            // t5 = ysq ∈ (0, 1/16]
        AscendC::PipeBarrier<PIPE_V>();

        // Horner on t5 (= ysq). xnum → t4, xden → t1 (reusing z buffer).
        AscendC::Muls(t4, t5, R3_P5, count);        // xnum
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t4, t4, R3_P0, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t4, t4, t5, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t1, t5, R3_Q0, count);        // xden init (fused first iter); overwrites z
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t1, t1, t5, count);
        AscendC::PipeBarrier<PIPE_V>();
#define ERFCX_R3_STEP(PI, QI)                                                   \
        AscendC::Adds(t4, t4, (PI), count); AscendC::PipeBarrier<PIPE_V>();     \
        AscendC::Mul(t4, t4, t5, count);    AscendC::PipeBarrier<PIPE_V>();     \
        AscendC::Adds(t1, t1, (QI), count); AscendC::PipeBarrier<PIPE_V>();     \
        AscendC::Mul(t1, t1, t5, count);    AscendC::PipeBarrier<PIPE_V>()
        ERFCX_R3_STEP(R3_P1, R3_Q1);
        ERFCX_R3_STEP(R3_P2, R3_Q2);
        ERFCX_R3_STEP(R3_P3, R3_Q3);
#undef ERFCX_R3_STEP
        AscendC::Adds(t4, t4, R3_P4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t1, t1, R3_Q4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(t4, t4, t1, count);            // t4 = xnum/xden
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t4, t4, t5, count);            // t4 = ysq · R3_poly
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t4, t4, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t4, t4, SQRPI, count);        // t4 = 1/√π − ysq · R3_poly
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(t4, t4, t3, count);            // t4 = r3
        AscendC::PipeBarrier<PIPE_V>();

        // Recompute t1 = |x| (was clobbered as R3's xden).
        AscendC::Abs(t1, xLocal, count);
        AscendC::PipeBarrier<PIPE_V>();

        // sel3 = step(z − 4) in t3
        AscendC::Adds(t3, t1, -THRESH2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t3, t3, STEP_SHARPNESS, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t3, t3, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t3, t3, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t3, t3, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(t3, t3, 1.0f, count);         // t3 = sel3
        AscendC::PipeBarrier<PIPE_V>();

        // Blend: r_acc += sel3 · (r3 − r_acc) → r_acc_pos
        AscendC::Sub(t4, t4, t2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t4, t4, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(t2, t2, t4, count);            // t2 = r_acc_pos (final for x ≥ 0)
        AscendC::PipeBarrier<PIPE_V>();

        // ==========================================================
        // Negative-x lift:
        //   result = r_acc_pos + 2·neg_mask·(exp(min(x,0)²) − r_acc_pos)
        //   min(x,0)² zeroes the lift exponent when x ≥ 0, so the
        //   mask·delta multiply cannot produce inf·0 = NaN for
        //   large positive x. For large negative x the exp saturates to
        //   +∞ and result → +∞ (matches torch.special.erfcx).
        // ==========================================================
        // t3 = neg_mask = Relu(−x / (|x| + eps))  ∈ {0, 1}
        AscendC::Adds(t3, t1, SIGN_EPS, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(t3, xLocal, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t3, t3, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(t3, t3, count);
        AscendC::PipeBarrier<PIPE_V>();

        // t4 = min(x, 0)² = ((x − |x|)/2)²
        AscendC::Sub(t4, xLocal, t1, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t4, t4, 0.5f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(t4, t4, t4, count);
        AscendC::PipeBarrier<PIPE_V>();

        // t4 = 2·(exp(min(x,0)²) − r_acc_pos)
        AscendC::Exp(t4, t4, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(t4, t4, t2, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(t4, t4, 2.0f, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal = r_acc_pos + neg_mask · t4
        AscendC::Mul(t4, t4, t3, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(yLocal, t2, t4, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<float> yLocal = outQueueY_.DeQue<float>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf3_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf4_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbuf5_;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

__global__ __aicore__ __vector__ void erfcx_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, uint32_t tileSize)
{
    KernelErfcx op;
    op.Init(x, y, totalLength, blockLength, tileSize);
    op.Process();
}

// 5. NPU dispatch
torch::Tensor erfcx_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto y = erfcx_meta(x);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t totalLength = x.numel();
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "erfcx_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                erfcx_kernel<<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileSize);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Erfcx", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("erfcx", erfcx_npu);
}

} // namespace Erfcx
} // namespace ops_multimodal_fusion
