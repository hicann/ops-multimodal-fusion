/*!
 * \file pdist_backward.asc
 * \brief RegBase PdistBackward gradient operator for Ascend NPU (dav-3510).
 *
 * torch.ops.ops_multimodal_fusion.pdist_backward(grad, input, p, pdist_output) -> output
 *   grad         : [N * (N - 1) / 2], same dtype as input
 *   input        : [N, D], fp16 / bfloat16 / fp32
 *   p            : scalar float, distance norm
 *   pdist_output : [N * (N - 1) / 2], same dtype as input
 *   output       : [N, D], same dtype as input
 *
 * Computes the gradient of pdist w.r.t. the input.
 * For each pair (i, j) with i < j, stored at linear index k:
 *   output[i] += grad[k] * g(x_i - x_j, dist[k], p)
 *   output[j] -= grad[k] * g(x_i - x_j, dist[k], p)
 * where g is the per-dimension gradient formula.
 *
 * Core math is strict RegBase: feature tiles are loaded to UB, cast to fp32
 * when needed, and processed with Reg vector operations.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <limits>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace PdistBackward {

static constexpr int64_t kSafetyBytes = 4096;
static constexpr int64_t kMaxTileElems = 2048;
static constexpr int64_t kModeZero = 0;
static constexpr int64_t kModeOne = 1;
static constexpr int64_t kModeTwo = 2;
static constexpr int64_t kModeGeneral = 3;
static constexpr int64_t kModeInf = 4;

/* ── Schema registration ───────────────────────────────────────────────── */

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("pdist_backward(Tensor grad, Tensor input, float p, Tensor pdist_output) -> Tensor");
}

/* ── Helpers ───────────────────────────────────────────────────────────── */

static int64_t pair_count(int64_t n)
{
    return (n <= 1) ? 0 : (n * (n - 1)) / 2;
}

static void check_common(const torch::Tensor &grad,
                         const torch::Tensor &input,
                         double p,
                         const torch::Tensor &pdist_output)
{
    TORCH_CHECK(input.dim() == 2,
                "pdist_backward: expected a 2-D input tensor, got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat32 ||
                input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kBFloat16,
                "pdist_backward: only float32, float16 and bfloat16 are "
                "supported on dav-3510, got ", input.scalar_type());
    TORCH_CHECK(p >= 0.0 && p == p,
                "pdist_backward: p must be non-negative and not NaN");
    TORCH_CHECK(grad.scalar_type() == input.scalar_type(),
                "pdist_backward: grad dtype must match input dtype, got ",
                grad.scalar_type(), " vs ", input.scalar_type());
    TORCH_CHECK(pdist_output.scalar_type() == input.scalar_type(),
                "pdist_backward: pdist_output dtype must match input dtype, got ",
                pdist_output.scalar_type(), " vs ", input.scalar_type());
    TORCH_CHECK(grad.device() == input.device() &&
                pdist_output.device() == input.device(),
                "pdist_backward: all tensors must be on the same device");

    int64_t n = input.size(0);
    int64_t pc = pair_count(n);
    TORCH_CHECK(grad.dim() == 1 && grad.size(0) == pc,
                "pdist_backward: grad must be 1-D with size N*(N-1)/2, got shape [",
                grad.sizes(), "]");
    TORCH_CHECK(pdist_output.dim() == 1 && pdist_output.size(0) == pc,
                "pdist_backward: pdist_output must be 1-D with size N*(N-1)/2, "
                "got shape [", pdist_output.sizes(), "]");
}

torch::Tensor pdist_backward_meta(const torch::Tensor &grad,
                                  const torch::Tensor &input,
                                  double p,
                                  const torch::Tensor &pdist_output)
{
    check_common(grad, input, p, pdist_output);
    return torch::empty({input.size(0), input.size(1)}, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("pdist_backward", pdist_backward_meta);
}

/* ── Tiling ────────────────────────────────────────────────────────────── */

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t n, int64_t d, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "pdist_backward: coreNum must be positive");

    // UB layout: x_i tile (T), x_j tile (T), x_i fp32, x_j fp32, accum fp32, scalar
    int64_t bytesPerElem =
        2 * elemSize +                                  // x_i, x_j in original dtype
        2 * static_cast<int64_t>(sizeof(float)) +       // x_i fp32, x_j fp32
        static_cast<int64_t>(sizeof(float));            // accum fp32
    int64_t scalarBytes = 128;
    int64_t tileElems = (static_cast<int64_t>(ubSize) - kSafetyBytes - scalarBytes) /
                        bytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min<int64_t>(tileElems, kMaxTileElems);
    if (d > 0) {
        TORCH_CHECK(tileElems > 0,
                    "pdist_backward: UB is too small for one aligned feature tile");
    } else {
        tileElems = std::max<int64_t>(tileElems, alignElems);
    }

    int64_t tileCount = (d + tileElems - 1) / tileElems;
    int64_t totalJobs = n * tileCount;
    int64_t numBlocks = std::min<int64_t>(coreNum, totalJobs);
    numBlocks = std::max<int64_t>(numBlocks, 1);
    int64_t jobsPerBlock = (totalJobs + numBlocks - 1) / numBlocks;
    return std::make_tuple(numBlocks, jobsPerBlock, tileElems);
}

/* ── Reg-based cast helpers ────────────────────────────────────────────── */

template <typename T>
__simd_vf__ inline void CastToFloatRegVf(__ubuf__ float *dstAddr,
                                         __ubuf__ T *srcAddr,
                                         uint32_t count,
                                         uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<T> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, T, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T>
__aicore__ inline void CastToFloatReg(AscendC::LocalTensor<float> &dst,
                                      AscendC::LocalTensor<T> &src,
                                      int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastToFloatRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

template <typename T, AscendC::RoundMode ROUND>
__simd_vf__ inline void CastFromFloatRegVf(__ubuf__ T *dstAddr,
                                           __ubuf__ float *srcAddr,
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castTrait = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        ROUND};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<T> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<T, float, castTrait>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

template <typename T, AscendC::RoundMode ROUND>
__aicore__ inline void CastFromFloatReg(AscendC::LocalTensor<T> &dst,
                                        AscendC::LocalTensor<float> &src,
                                        int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFromFloatRegVf<T, ROUND>>(
        dstAddr, srcAddr, elementCount, chunkCount);
}

/* ── Reg-based zero init ───────────────────────────────────────────────── */

__simd_vf__ inline void ZeroFloatVf(__ubuf__ float *dstAddr,
                                    uint32_t count,
                                    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, zeroReg, mask);
    }
}

__aicore__ inline void ZeroFloat(AscendC::LocalTensor<float> &dst, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ZeroFloatVf>((__ubuf__ float *)dst.GetPhyAddr(),
                             elementCount, chunkCount);
}

/* ── Per-mode gradient functions (vectorized, fp32) ───────────────────── */

/* p = 1: contribution = grad * sign(x_i - x_j) */
__simd_vf__ inline void PdistBackwardOneVf(__ubuf__ float *accAddr,
                                           __ubuf__ float *xiAddr,
                                           __ubuf__ float *xjAddr,
                                           float grad,
                                           float sign,  // +1 if i<j, -1 if j<i
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, xiReg, xjReg, diffReg, signVecReg;
    AscendC::Reg::RegTensor<float> oneReg, negOneReg, gradReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg gtMask, ltMask;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xiReg, xiAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xjReg, xjAddr + offset);
        AscendC::Reg::Sub(diffReg, xiReg, xjReg, mask);
        // sign(xi - xj)
        AscendC::Reg::Duplicate<float>(signVecReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(negOneReg, -1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(
            gtMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(
            ltMask, diffReg, 0.0f, mask);
        AscendC::Reg::Select<float>(signVecReg, oneReg, signVecReg, gtMask);
        AscendC::Reg::Select<float>(signVecReg, negOneReg, signVecReg, ltMask);
        // acc += (sign * grad) * signVec
        AscendC::Reg::Duplicate<float>(gradReg, sign * grad, mask);
        AscendC::Reg::Mul(diffReg, gradReg, signVecReg, mask);
        AscendC::Reg::Add(accReg, accReg, diffReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

/* p = 2: contribution = grad * (x_i - x_j) / dist */
__simd_vf__ inline void PdistBackwardTwoVf(__ubuf__ float *accAddr,
                                           __ubuf__ float *xiAddr,
                                           __ubuf__ float *xjAddr,
                                           float grad,
                                           float dist,
                                           float sign,  // +1/-1 for pair ordering
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, xiReg, xjReg, diffReg, distReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xiReg, xiAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xjReg, xjAddr + offset);
        AscendC::Reg::Sub(diffReg, xiReg, xjReg, mask);
        // (sign * grad / dist) * diff
        float scale = sign * grad / dist;
        AscendC::Reg::Muls(diffReg, diffReg, scale, mask);
        AscendC::Reg::Add(accReg, accReg, diffReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

/* general p (p > 0, p != 1, 2, inf):
 *   contribution = grad * |x_i - x_j|^(p-1) * sign(x_i - x_j) / dist^(p-1) */
__simd_vf__ inline void PdistBackwardGeneralVf(__ubuf__ float *accAddr,
                                               __ubuf__ float *xiAddr,
                                               __ubuf__ float *xjAddr,
                                               float grad,
                                               float dist,
                                               float p,
                                               float sign,
                                               uint32_t count,
                                               uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    float exponent = p - 1.0f;
    AscendC::Reg::RegTensor<float> accReg, xiReg, xjReg, diffReg, absReg;
    AscendC::Reg::RegTensor<float> oneReg, negOneReg, zeroReg, safeAbsReg, powReg;
    AscendC::Reg::RegTensor<float> signVecReg;
    AscendC::Reg::RegTensor<float> distReg, denomReg, contribReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg zeroMask, gtMask, ltMask;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xiReg, xiAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xjReg, xjAddr + offset);
        AscendC::Reg::Sub(diffReg, xiReg, xjReg, mask);
        AscendC::Reg::Abs(absReg, diffReg, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(negOneReg, -1.0f, mask);
        AscendC::Reg::Duplicate<float>(signVecReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(
            gtMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(
            ltMask, diffReg, 0.0f, mask);
        AscendC::Reg::Select<float>(signVecReg, oneReg, signVecReg, gtMask);
        AscendC::Reg::Select<float>(signVecReg, negOneReg, signVecReg, ltMask);
        // Handle zero diffs: replace with 1 for safe log, mask out later
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(
            zeroMask, absReg, 0.0f, mask);
        safeAbsReg = absReg;
        AscendC::Reg::Select<float>(safeAbsReg, oneReg, safeAbsReg, zeroMask);
        // |diff|^(p-1) = exp((p-1) * ln(|diff|))
        AscendC::Reg::Ln(powReg, safeAbsReg, mask);
        AscendC::Reg::Muls(powReg, powReg, exponent, mask);
        AscendC::Reg::Exp(powReg, powReg, mask);
        // dist^(p-1) = exp((p-1) * ln(dist))
        AscendC::Reg::Duplicate<float>(distReg, dist, mask);
        AscendC::Reg::Ln(denomReg, distReg, mask);
        AscendC::Reg::Muls(denomReg, denomReg, exponent, mask);
        AscendC::Reg::Exp(denomReg, denomReg, mask);
        // contrib = grad * sign * sign(diff) * |diff|^(p-1) / dist^(p-1)
        AscendC::Reg::Mul(powReg, powReg, signVecReg, mask);
        AscendC::Reg::Muls(powReg, powReg, sign * grad, mask);
        AscendC::Reg::Div(contribReg, powReg, denomReg, mask);
        // Zero out where input diff was zero
        AscendC::Reg::Select<float>(contribReg, zeroReg, contribReg, zeroMask);
        AscendC::Reg::Add(accReg, accReg, contribReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

/* p = inf: contribution = grad * sign(x_i - x_j) only where |x_i - x_j| == dist */
__simd_vf__ inline void PdistBackwardInfVf(__ubuf__ float *accAddr,
                                           __ubuf__ float *xiAddr,
                                           __ubuf__ float *xjAddr,
                                           float grad,
                                           float dist,
                                           float sign,
                                           float compareTol,
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, xiReg, xjReg, diffReg, absReg;
    AscendC::Reg::RegTensor<float> signVecReg, oneReg, negOneReg, zeroReg, contribReg;
    AscendC::Reg::RegTensor<float> distReg, deltaReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg gtMask, ltMask, eqMask;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xiReg, xiAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xjReg, xjAddr + offset);
        AscendC::Reg::Sub(diffReg, xiReg, xjReg, mask);
        AscendC::Reg::Abs(absReg, diffReg, mask);
        // sign(xi - xj)
        AscendC::Reg::Duplicate<float>(signVecReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(negOneReg, -1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(
            gtMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(
            ltMask, diffReg, 0.0f, mask);
        AscendC::Reg::Select<float>(signVecReg, oneReg, signVecReg, gtMask);
        AscendC::Reg::Select<float>(signVecReg, negOneReg, signVecReg, ltMask);
        // Only where |diff| reaches dist. Low-precision input/pdist values can
        // round through different paths, so use a tiny dtype-selected tolerance.
        AscendC::Reg::Duplicate<float>(distReg, dist, mask);
        AscendC::Reg::Sub(deltaReg, absReg, distReg, mask);
        AscendC::Reg::Abs(deltaReg, deltaReg, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(
            eqMask, deltaReg, compareTol, mask);
        AscendC::Reg::Muls(contribReg, signVecReg, sign * grad, mask);
        AscendC::Reg::Select<float>(contribReg, contribReg, zeroReg, eqMask);
        AscendC::Reg::Add(accReg, accReg, contribReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

/* ── AICORE wrappers ──────────────────────────────────────────────────── */

template <int64_t Mode>
__aicore__ inline void PdistBackwardStep(AscendC::LocalTensor<float> &acc,
                                         AscendC::LocalTensor<float> &xi,
                                         AscendC::LocalTensor<float> &xj,
                                         float grad,
                                          float dist,
                                          float p,
                                          float sign,
                                          int64_t count,
                                          float infCompareTol)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    __ubuf__ float *accAddr = (__ubuf__ float *)acc.GetPhyAddr();
    __ubuf__ float *xiAddr = (__ubuf__ float *)xi.GetPhyAddr();
    __ubuf__ float *xjAddr = (__ubuf__ float *)xj.GetPhyAddr();
    if constexpr (Mode == kModeZero) {
        // p = 0: gradient is 0, nothing to accumulate
        (void)accAddr; (void)xiAddr; (void)xjAddr;
        (void)grad; (void)dist; (void)p; (void)sign; (void)infCompareTol;
        (void)elementCount; (void)chunkCount;
    } else if constexpr (Mode == kModeOne) {
        asc_vf_call<PdistBackwardOneVf>(
            accAddr, xiAddr, xjAddr, grad, sign, elementCount, chunkCount);
    } else if constexpr (Mode == kModeTwo) {
        asc_vf_call<PdistBackwardTwoVf>(
            accAddr, xiAddr, xjAddr, grad, dist, sign, elementCount, chunkCount);
    } else if constexpr (Mode == kModeGeneral) {
        asc_vf_call<PdistBackwardGeneralVf>(
            accAddr, xiAddr, xjAddr, grad, dist, p, sign,
            elementCount, chunkCount);
    } else {
        // kModeInf
        asc_vf_call<PdistBackwardInfVf>(
            accAddr, xiAddr, xjAddr, grad, dist, sign, infCompareTol,
            elementCount, chunkCount);
    }
}

/* ── Kernel ───────────────────────────────────────────────────────────── */

template <typename T, int64_t Mode>
class KernelPdistBackward {
    static constexpr bool kIsFloat = std::is_same<T, float>::value;
    static constexpr bool kIsBf16 = std::is_same<T, bfloat16_t>::value;
    static constexpr AscendC::RoundMode kCastOutRound =
        kIsBf16 ? AscendC::RoundMode::CAST_RINT : AscendC::RoundMode::CAST_NONE;

public:
    __aicore__ inline KernelPdistBackward() {}

    __aicore__ inline void Init(GM_ADDR grad,
                                GM_ADDR input,
                                GM_ADDR pdistOutput,
                                GM_ADDR output,
                                int64_t n,
                                int64_t d,
                                float p,
                                int64_t tileElems,
                                int64_t jobsPerBlock)
    {
        gradGm_.SetGlobalBuffer((__gm__ T *)grad);
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        pdistGm_.SetGlobalBuffer((__gm__ T *)pdistOutput);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        n_ = n;
        d_ = d;
        p_ = p;
        tileElems_ = tileElems;
        tileCount_ = (d_ + tileElems_ - 1) / tileElems_;
        alignElems_ = 32 / static_cast<int64_t>(sizeof(T));

        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t totalJobs = n_ * tileCount_;
        int64_t jobStart = blockIdx * jobsPerBlock;
        jobCount_ = totalJobs - jobStart;
        if (jobCount_ > jobsPerBlock) {
            jobCount_ = jobsPerBlock;
        }
        if (jobCount_ < 0) {
            jobCount_ = 0;
        }
        jobStart_ = jobStart;

        pipe_.InitBuffer(tbufXi_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufXj_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufXiFloat_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufXjFloat_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufAccum_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufOutput_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufScalar_, 64);
        pipe_.InitBuffer(tbufScalarFloat_, 64);
    }

    __aicore__ inline void Process()
    {
        for (int64_t localJob = 0; localJob < jobCount_; ++localJob) {
            int64_t job = jobStart_ + localJob;
            int64_t tile = job % tileCount_;
            int64_t i = job / tileCount_;  // row index
            int64_t featureStart = tile * tileElems_;
            int64_t count = d_ - featureStart;
            if (count > tileElems_) {
                count = tileElems_;
            }
            ProcessRowTile(i, featureStart, count);
        }
    }

private:
    /* Read a single scalar from a GlobalTensor. */
    __aicore__ inline float ReadScalar(const AscendC::GlobalTensor<T> &gm,
                                       int64_t offset)
    {
        AscendC::LocalTensor<T> scalarLocal = tbufScalar_.template Get<T>();
        AscendC::DataCopyExtParams copyOne;
        copyOne.blockCount = 1;
        copyOne.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOne.srcStride = 0;
        copyOne.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padOne{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(scalarLocal, gm[offset], copyOne, padOne);
        AscendC::PipeBarrier<PIPE_ALL>();
        if constexpr (!kIsFloat) {
            AscendC::LocalTensor<float> scalarFloat =
                tbufScalarFloat_.template Get<float>();
            CastToFloatReg<T>(scalarFloat, scalarLocal, 1);
            AscendC::PipeBarrier<PIPE_ALL>();
            return scalarFloat.GetValue(0);
        } else {
            return scalarLocal.GetValue(0);
        }
    }

    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t count)
    {
        AscendC::DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = static_cast<uint32_t>(count * sizeof(T));
        params.srcStride = 0;
        params.dstStride = 0;
        return params;
    }

    __aicore__ inline int64_t PairIndex(int64_t i, int64_t j) const
    {
        return i * (2 * n_ - i - 1) / 2 + (j - i - 1);
    }

    __aicore__ inline float InfCompareTol() const
    {
        if constexpr (kIsFloat) {
            return 0.0f;
        } else if constexpr (kIsBf16) {
            return 8.0e-3f;
        } else {
            return 2.0e-3f;
        }
    }

    __aicore__ inline void ProcessRowTile(int64_t i,
                                          int64_t featureStart,
                                          int64_t count)
    {
        int64_t alignedCount =
            ((count + alignElems_ - 1) / alignElems_) * alignElems_;

        AscendC::LocalTensor<T> xiLocal = tbufXi_.template Get<T>();
        AscendC::LocalTensor<T> xjLocal = tbufXj_.template Get<T>();
        AscendC::LocalTensor<float> xiFloat = tbufXiFloat_.template Get<float>();
        AscendC::LocalTensor<float> xjFloat = tbufXjFloat_.template Get<float>();
        AscendC::LocalTensor<float> accumLocal = tbufAccum_.template Get<float>();

        // Zero accumulator
        ZeroFloat(accumLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_ALL>();

        // Load x_i tile and cast to fp32
        AscendC::DataCopyPadExtParams<T> padVector{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};
        AscendC::DataCopyPad(
            xiLocal, inputGm_[i * d_ + featureStart], CopyParams(count), padVector);
        AscendC::PipeBarrier<PIPE_ALL>();
        if constexpr (kIsFloat) {
            // No cast needed; xiFloat aliases xiLocal
        } else {
            CastToFloatReg<T>(xiFloat, xiLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        // Iterate over all other rows j != i
        for (int64_t j = 0; j < n_; ++j) {
            if (j == i) {
                continue;
            }

            // Determine pair index (always maps to upper-triangular index)
            int64_t pidx = 0;
            if (i < j) {
                pidx = PairIndex(i, j);
            } else {
                pidx = PairIndex(j, i);
            }
            // sign is always +1: the contribution to output[i] from any
            // unordered pair {i,j} is +grad * g(x_i - x_j).
            constexpr float sign = 1.0f;

            // Read grad and pdist_output scalars
            float grad = ReadScalar(gradGm_, pidx);
            float dist = ReadScalar(pdistGm_, pidx);

            // Skip pair if grad is zero or dist is zero (for modes that divide)
            if (grad == 0.0f) {
                continue;
            }
            if constexpr (Mode == kModeTwo || Mode == kModeGeneral) {
                if (dist == 0.0f) {
                    continue;
                }
            }

            // Load x_j tile and cast to fp32
            AscendC::DataCopyPad(
                xjLocal, inputGm_[j * d_ + featureStart],
                CopyParams(count), padVector);
            AscendC::PipeBarrier<PIPE_ALL>();
            if constexpr (kIsFloat) {
                PdistBackwardStep<Mode>(
                    accumLocal, xiLocal, xjLocal,
                    grad, dist, p_, sign, alignedCount, InfCompareTol());
            } else {
                CastToFloatReg<T>(xjFloat, xjLocal, alignedCount);
                AscendC::PipeBarrier<PIPE_ALL>();
                PdistBackwardStep<Mode>(
                    accumLocal, xiFloat, xjFloat,
                    grad, dist, p_, sign, alignedCount, InfCompareTol());
            }
            AscendC::PipeBarrier<PIPE_ALL>();
        }

        // Write back to output
        AscendC::DataCopyExtParams copyOutput;
        copyOutput.blockCount = 1;
        copyOutput.blockLen = static_cast<uint32_t>(count * sizeof(T));
        copyOutput.srcStride = 0;
        copyOutput.dstStride = 0;
        int64_t outputOffset = i * d_ + featureStart;
        if constexpr (kIsFloat) {
            AscendC::DataCopyPad(
                outputGm_[outputOffset], accumLocal, copyOutput);
        } else {
            AscendC::LocalTensor<T> outLocal = tbufOutput_.template Get<T>();
            CastFromFloatReg<T, kCastOutRound>(outLocal, accumLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyPad(outputGm_[outputOffset], outLocal, copyOutput);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> gradGm_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> pdistGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXi_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXj_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXiFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXjFloat_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufAccum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufScalar_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufScalarFloat_;
    int64_t n_ = 0;
    int64_t d_ = 0;
    float p_ = 0.0f;
    int64_t tileElems_ = 0;
    int64_t tileCount_ = 0;
    int64_t alignElems_ = 1;
    int64_t jobStart_ = 0;
    int64_t jobCount_ = 0;
};

/* ── Launch & dispatch ────────────────────────────────────────────────── */

template <typename T, int64_t Mode>
__global__ __aicore__ __vector__ void pdist_backward_kernel(
    GM_ADDR grad, GM_ADDR input, GM_ADDR pdistOutput, GM_ADDR output,
    int64_t n, int64_t d, float p, int64_t tileElems, int64_t jobsPerBlock)
{
    KernelPdistBackward<T, Mode> op;
    op.Init(grad, input, pdistOutput, output, n, d, p, tileElems, jobsPerBlock);
    op.Process();
}

template <int64_t Mode>
static void launch_kernel(const torch::Tensor &grad,
                          const torch::Tensor &input,
                          const torch::Tensor &pdistOutput,
                          const torch::Tensor &output,
                          int64_t n,
                          int64_t d,
                          float p,
                          int64_t numBlocks,
                          int64_t jobsPerBlock,
                          int64_t tileElems)
{
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto gradPtr = (GM_ADDR)grad.data_ptr();
    auto inputPtr = (GM_ADDR)input.data_ptr();
    auto pdistPtr = (GM_ADDR)pdistOutput.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    AT_DISPATCH_SWITCH(
        input.scalar_type(), "pdist_backward_npu",
        AT_DISPATCH_CASE(torch::kFloat32, [&] {
            pdist_backward_kernel<float, Mode><<<numBlocks, nullptr, stream>>>(
                gradPtr, inputPtr, pdistPtr, outputPtr,
                n, d, p, tileElems, jobsPerBlock);
        })
        AT_DISPATCH_CASE(torch::kFloat16, [&] {
            pdist_backward_kernel<half, Mode><<<numBlocks, nullptr, stream>>>(
                gradPtr, inputPtr, pdistPtr, outputPtr,
                n, d, p, tileElems, jobsPerBlock);
        })
        AT_DISPATCH_CASE(torch::kBFloat16, [&] {
            pdist_backward_kernel<bfloat16_t, Mode><<<numBlocks, nullptr, stream>>>(
                gradPtr, inputPtr, pdistPtr, outputPtr,
                n, d, p, tileElems, jobsPerBlock);
        })
    );
}

torch::Tensor pdist_backward_npu(const torch::Tensor &grad,
                                 const torch::Tensor &input,
                                 double p,
                                 const torch::Tensor &pdist_output)
{
    check_common(grad, input, p, pdist_output);
    const c10::OptionalDeviceGuard guard(input.device());

    auto inputC = input.contiguous();
    auto gradC = grad.contiguous();
    auto pdistC = pdist_output.contiguous();
    int64_t n = inputC.size(0);
    int64_t d = inputC.size(1);
    auto output = torch::empty({n, d}, input.options());

    if (output.numel() == 0) {
        return output;
    }

    int64_t numBlocks = 1;
    int64_t jobsPerBlock = 1;
    int64_t tileElems = 1;
    std::tie(numBlocks, jobsPerBlock, tileElems) =
        calc_tiling_params(n, d, inputC.element_size());

    float pFloat = static_cast<float>(p);
    auto acl_call = [=]() -> int {
        if (p == 0.0) {
            launch_kernel<kModeZero>(
                gradC, inputC, pdistC, output, n, d, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == 1.0) {
            launch_kernel<kModeOne>(
                gradC, inputC, pdistC, output, n, d, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == 2.0) {
            launch_kernel<kModeTwo>(
                gradC, inputC, pdistC, output, n, d, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == std::numeric_limits<double>::infinity()) {
            launch_kernel<kModeInf>(
                gradC, inputC, pdistC, output, n, d, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else {
            launch_kernel<kModeGeneral>(
                gradC, inputC, pdistC, output, n, d, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("PdistBackward", acl_call);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("pdist_backward", pdist_backward_npu);
}

} // namespace PdistBackward
} // namespace ops_multimodal_fusion
