/*!
 * \file c2_cbrt.asc
 * \brief Caffe2 Cbrt operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * Schema:  c2_cbrt(Tensor self) -> Tensor
 *   Elementwise real cube root  y = cbrt(x) = sign(x) * |x|^(1/3).
 *   dtype fp32 / fp16; output dtype/shape == self.
 *
 * Caffe2 reference: UnaryElementwiseOp<TensorTypes<float>, CbrtFunctor> ->
 *   math::Cbrt(N, X, Y) (caffe2/operators/cbrt_op.{h,cu}); float-only forward.
 *   Real cube root: cbrt(-8)=-2, cbrt(0)=0, cbrt(+/-inf)=+/-inf, nan->nan.
 *
 * dav-3510 has Reg Abs/Ln/Exp but no native cbrt/pow, so:
 *   a   = max(|x|, floor)          (floor keeps ln input finite>0; floor>0 representable)
 *   t   = exp(ln(a) / 3)           (= |x|^(1/3), always finite>=0)
 *   sign = (x>0)? +1 : (x<0)? -1 : 0     (two Compares + two Select; avoids EQ-on-0)
 *   y   = sign * t                 (x==0 -> sign 0 -> y 0)
 *   nan input -> nan (explicit Compare<NE>(x,x) + Select, mirrors bessel_j0).
 *   +/-inf flow through naturally: |inf|->ln inf->exp inf, sign +/-1 -> +/-inf.
 *
 * 3-layer Reg shape (mirrors csrc/bessel_j0, templated to fp32/fp16):
 *   Layer 1 __simd_vf__ C2CbrtRegVf<T>  - chunked LoadAlign + compute + StoreAlign
 *   Layer 2 __aicore__ C2CbrtReg<T>     - GetPhyAddr cast + asc_vf_call
 *   Layer 3 KernelC2Cbrt<T>             - streaming CopyIn/Compute/CopyOut
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <tuple>

namespace ops_multimodal_fusion {
namespace C2Cbrt {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;
constexpr int64_t TOTAL_TILE_BUFFERS = 4;  // inQueue x2 + outQueue x2

// ===================== Kernel -- 3-layer Reg shape =====================

template <typename T>
__simd_vf__ inline void C2CbrtRegVf(
    __ubuf__ T *dstAddr, __ubuf__ T *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    T floorVal;
    if constexpr (std::is_same_v<T, half>) {
        floorVal = static_cast<T>(6.103515625e-05f);  // fp16 min normal
    } else {
        floorVal = static_cast<T>(1.0e-30f);
    }
    const T oneThird = static_cast<T>(0.3333333432674408f);
    const T zeroT = static_cast<T>(0.0f);

    AscendC::Reg::RegTensor<T> xReg, aReg, tReg, signReg, oneReg, negOneReg, outReg;

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);

        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);

        // t = |x|^(1/3) via exp(ln(max(|x|,floor))/3)
        AscendC::Reg::Abs(aReg, xReg, mask);
        AscendC::Reg::Maxs(aReg, aReg, floorVal, mask);
        AscendC::Reg::Ln(aReg, aReg, mask);
        AscendC::Reg::Muls(aReg, aReg, oneThird, mask);
        AscendC::Reg::Exp(tReg, aReg, mask);

        // sign = (x>0)?+1 : (x<0)?-1 : 0
        AscendC::Reg::Duplicate<T>(signReg, zeroT, mask);
        AscendC::Reg::Duplicate<T>(oneReg, static_cast<T>(1.0f), mask);
        AscendC::Reg::Duplicate<T>(negOneReg, static_cast<T>(-1.0f), mask);
        AscendC::Reg::MaskReg gtMask, ltMask;
        AscendC::Reg::Compares<T, AscendC::CMPMODE::GT>(gtMask, xReg, zeroT, mask);
        AscendC::Reg::Select<T>(signReg, oneReg, signReg, gtMask);
        AscendC::Reg::Compares<T, AscendC::CMPMODE::LT>(ltMask, xReg, zeroT, mask);
        AscendC::Reg::Select<T>(signReg, negOneReg, signReg, ltMask);

        AscendC::Reg::Mul(outReg, signReg, tReg, mask);

        // nan -> nan
        AscendC::Reg::MaskReg nanMask;
        AscendC::Reg::Compare<T, AscendC::CMPMODE::NE>(nanMask, xReg, xReg, mask);
        AscendC::Reg::Select<T>(outReg, xReg, outReg, nanMask);

        if constexpr (sizeof(T) == 4) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + offset, outReg, mask);
        } else {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B16>(
                dstAddr + offset, outReg, mask);
        }
    }
}

template <typename T>
__aicore__ inline void C2CbrtReg(
    const AscendC::LocalTensor<T> &dst, const AscendC::LocalTensor<T> &src, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<C2CbrtRegVf<T>>(dstAddr, srcAddr, elementCount, chunkCount);
}

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_cbrt(Tensor self) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor c2_cbrt_meta(const torch::Tensor &self)
{
    TORCH_CHECK(self.scalar_type() == torch::kFloat32 ||
                self.scalar_type() == torch::kFloat16,
                "c2_cbrt: self dtype must be float32 / float16, got ",
                self.scalar_type(),
                ". int32 / bf16 / int64 / fp64 are deferred on this platform.");
    return torch::empty_like(self);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_cbrt", c2_cbrt_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_cbrt: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / TOTAL_TILE_BUFFERS / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) tileBytes = BLOCK_BYTES;
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) tileElems = 8;
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel harness =====================

template <typename T>
class KernelC2Cbrt {
public:
    __aicore__ inline KernelC2Cbrt() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) curLength_ = 0;
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockIdx * blockLength);

        int64_t tileBytes =
            ((tileLength_ * static_cast<int64_t>(sizeof(T)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(inQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto inLocal = inQueue_.template AllocTensor<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(inLocal, xGm_[offset], p, pad);
        inQueue_.EnQue(inLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto inLocal = inQueue_.template DeQue<T>();
        auto outLocal = outQueue_.template AllocTensor<T>();
        C2CbrtReg<T>(outLocal, inLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.template DeQue<T>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void c2_cbrt_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelC2Cbrt<T> op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor c2_cbrt_npu(const torch::Tensor &self)
{
    const auto dtype = self.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 || dtype == torch::kFloat16,
                "c2_cbrt: self dtype must be float32 / float16, got ", dtype,
                ". int32 / bf16 / int64 / fp64 are deferred on this platform.");

    const c10::OptionalDeviceGuard guard(self.device());
    auto self_contig = self.contiguous();
    auto out = torch::empty_like(self_contig);

    const int64_t numel = self_contig.numel();
    if (numel == 0) {
        return out;
    }

    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(numel, self_contig.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto x_ptr = (GM_ADDR)self_contig.data_ptr();
    auto y_ptr = (GM_ADDR)out.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            self_contig.scalar_type(), "c2_cbrt_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_cbrt_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, numel, blockLength, tileElems);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_cbrt_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, numel, blockLength, tileElems);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2Cbrt", acl_call);

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_cbrt", c2_cbrt_npu);
}

} // namespace C2Cbrt
} // namespace ops_multimodal_fusion
