/*!
 * \file quantized_relu.asc
 * \brief Quantized ReLU activation for Ascend NPU (dav-3510)
 *
 *   y = max(x, zero_point)   (elementwise, integer dtypes)
 *
 * Mirrors PyTorch CUDA's relu_quantized_cuda_ (aten/src/ATen/native/quantized/
 * cuda/Activation.cu): clamp the underlying integer storage of a quantized
 * tensor from below at zero_point. ops_multimodal_fusion does not expose PyTorch's
 * quantized tensor type, so the operator is exposed on plain integer tensors
 * (int8 / uint8 / int32) with zero_point passed as an int64 scalar argument.
 *
 * RegBase 3-layer shape (__simd_vf__ / __aicore__ wrapper / kernel harness):
 *   - __simd_vf__: AscendC::Reg::Maxs<T>(reg, reg, zp, mask) - one scalar
 *     clamp per chunk, no Compare/Select needed.
 *   - wrapper:    LocalTensor.GetPhyAddr() -> __ubuf__ T*, asc_vf_call.
 *   - harness:    DataCopyPad in / compute / DataCopyPad out, double-buffered.
 *
 * Algorithm follows the exponential.asc Reg::Maxs/Reg::Mins clamp template
 * (csrc/exponential/dav-3510/exponential.asc:114-178), specialized to a
 * single Maxs and integer dtype dispatch.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <limits>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace QuantizedReLU {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("quantized_relu(Tensor x, int zero_point) -> Tensor");
}

// ===================== 2. Meta =====================

static void check_zero_point_range(torch::ScalarType dtype, int64_t zero_point)
{
    int64_t lo = 0, hi = 0;
    switch (dtype) {
        case torch::kChar:
            lo = std::numeric_limits<int8_t>::min();
            hi = std::numeric_limits<int8_t>::max();
            break;
        case torch::kByte:
            lo = std::numeric_limits<uint8_t>::min();
            hi = std::numeric_limits<uint8_t>::max();
            break;
        case torch::kInt32:
            lo = std::numeric_limits<int32_t>::min();
            hi = std::numeric_limits<int32_t>::max();
            break;
        default:
            TORCH_CHECK(false,
                "quantized_relu: only int8/uint8/int32 are supported, got ", dtype);
    }
    TORCH_CHECK(zero_point >= lo && zero_point <= hi,
        "quantized_relu: zero_point=", zero_point,
        " is out of range [", lo, ", ", hi, "] for dtype ", dtype);
}

torch::Tensor quantized_relu_meta(const torch::Tensor &x, int64_t zero_point)
{
    check_zero_point_range(x.scalar_type(), zero_point);
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("quantized_relu", quantized_relu_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(
    int64_t totalLength, int64_t elemSize)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // UB usage per element: VECIN double-buffer + VECOUT double-buffer.
    constexpr static int64_t BUFFER_NUM = 2;
    constexpr static int64_t MAX_TILE_ELEMS = 32768;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "quantized_relu: coreNum must be positive.");

    int64_t numBlocks = std::min(coreNum,
        (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;

    int64_t bytesPerElem = PIPELINE_DEPTH * BUFFER_NUM * elemSize;
    int64_t tileElems = static_cast<int64_t>(ubSize) / bytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min(tileElems, MAX_TILE_ELEMS);
    TORCH_CHECK(tileElems > 0,
        "quantized_relu: UB too small for one aligned tile.");
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

// ===================== 4. Kernel =====================

// Layer 1: __simd_vf__ vector function. Loads a chunk into a RegTensor,
// applies the scalar Maxs clamp, stores back. Mask handles the partial-chunk
// tail; the masked Maxs+StoreAlign only writes lanes <= remaining, so reading
// past `count` in the UB tile buffer is benign (mask zeroes / store-skips
// those lanes). StoreDist::DIST_NORM_B8 covers int8/uint8 and DIST_NORM_B32
// covers int32; switched via `if constexpr` on `sizeof(T)` so the lookup
// stays inside the templated body (matches exponential.asc's pattern).
template <typename T>
__simd_vf__ inline void QuantizedReluRegVf(
    __ubuf__ T *dstAddr, __ubuf__ T *srcAddr,
    T zeroPoint, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> xReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset    = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, srcAddr + offset);
        AscendC::Reg::Maxs(xReg, xReg, zeroPoint, mask);   // y = max(x, zp)
        if constexpr (sizeof(T) == 1) {
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B8>(
                dstAddr + offset, xReg, mask);
        } else {
            // sizeof(T) == 4 (int32_t); the dispatch layer rejects all
            // other widths so this branch is unreachable for them.
            AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
                dstAddr + offset, xReg, mask);
        }
    }
}

// Layer 2: __aicore__ wrapper. Bridges LocalTensor -> __ubuf__ T* via
// GetPhyAddr() + (__ubuf__ T*) cast (required to avoid GP page faults; see
// rms_norm_gated.asc:52-54). Computes chunkCount and dispatches asc_vf_call.
template <typename T>
__aicore__ inline void QuantizedReluReg(
    AscendC::LocalTensor<T> &dst, AscendC::LocalTensor<T> &src,
    T zeroPoint, int64_t count)
{
    __ubuf__ T *dstAddr = (__ubuf__ T *)dst.GetPhyAddr();
    __ubuf__ T *srcAddr = (__ubuf__ T *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount   = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<QuantizedReluRegVf<T>>(
        dstAddr, srcAddr, zeroPoint, elementCount, chunkCount);
}

// Layer 3: kernel / harness. Per-tile CopyIn -> compute -> CopyOut with a
// double-buffered VECIN / VECOUT queue pair; tail tile handled identically
// (DataCopyPad takes the actual byte length).
template <typename T>
class KernelQuantizedReLU {
public:
    static constexpr int64_t PIPELINE_DEPTH = 2;

    __aicore__ inline KernelQuantizedReLU() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileElems,
        T zeroPoint)
    {
        zeroPoint_ = zeroPoint;
        int64_t blockIdx = AscendC::GetBlockIdx();
        blockBase_ = blockLength * blockIdx;
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockBase_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockBase_);

        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tileElems * sizeof(T));
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileElems * sizeof(T));

        int64_t currentBlockLength = totalLength - blockBase_;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_   = tileElems;
        tileNum_             = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_  = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            ProcessTile(i * elementNumPerTile_, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            ProcessTile(tileNum_ * elementNumPerTile_, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen   = static_cast<uint32_t>(count * sizeof(T));
        copyParams.srcStride  = 0;
        copyParams.dstStride  = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};

        // CopyIn
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);

        // Compute (Layer 2 wrapper -> Layer 1 vf)
        xLocal = inQueueX_.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY_.template AllocTensor<T>();
        AscendC::PipeBarrier<PIPE_ALL>();
        QuantizedReluReg<T>(yLocal, xLocal, zeroPoint_, count);
        AscendC::PipeBarrier<PIPE_ALL>();
        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);

        // CopyOut
        yLocal = outQueueY_.template DeQue<T>();
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    T zeroPoint_ = 0;
    int64_t blockBase_           = 0;
    int64_t elementNumPerTile_   = 0;
    int64_t tileNum_             = 0;
    int64_t tailTileElementNum_  = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void quantized_relu_kernel(
    GM_ADDR x, GM_ADDR y,
    int64_t totalLength, int64_t blockLength, uint32_t tileElems,
    T zeroPoint)
{
    KernelQuantizedReLU<T> op;
    op.Init(x, y, totalLength, blockLength, tileElems, zeroPoint);
    op.Process();
}

// ===================== 5. NPU Dispatch =====================

torch::Tensor quantized_relu_npu(const torch::Tensor &x, int64_t zero_point)
{
    check_zero_point_range(x.scalar_type(), zero_point);

    const c10::OptionalDeviceGuard guard(x.device());
    auto y = torch::empty_like(x);

    int64_t totalLength = x.numel();
    if (totalLength == 0) {
        return y;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t numBlocks, blockLength, tileElems;
    std::tie(numBlocks, blockLength, tileElems) =
        calc_tiling_params(totalLength, x.element_size());

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "quantized_relu_npu",
            AT_DISPATCH_CASE(torch::kChar, [&] {
                using scalar_t = int8_t;
                quantized_relu_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength,
                    static_cast<uint32_t>(tileElems),
                    static_cast<scalar_t>(zero_point));
            })
            AT_DISPATCH_CASE(torch::kByte, [&] {
                using scalar_t = uint8_t;
                quantized_relu_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength,
                    static_cast<uint32_t>(tileElems),
                    static_cast<scalar_t>(zero_point));
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                quantized_relu_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength,
                    static_cast<uint32_t>(tileElems),
                    static_cast<scalar_t>(zero_point));
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("QuantizedReLU", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("quantized_relu", quantized_relu_npu);
}

} // namespace QuantizedReLU
} // namespace ops_multimodal_fusion
