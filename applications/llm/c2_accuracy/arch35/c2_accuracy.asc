/*!
 * \file c2_accuracy.asc
 * \brief Caffe2 Accuracy operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * Schema:  c2_accuracy(Tensor predictions, Tensor labels, int top_k=1) -> Tensor
 *   predictions  2-D (N, D) float    (fp32 / fp16)
 *   labels       1-D (N,)   int32
 *   top_k        int (>= 1)
 *   returns      0-D float32 scalar  (mean correctness, range [0, 1])
 *
 * Algorithm - per row compute 1-indexed rank of the label score, mark correct
 * iff rank <= top_k, then mean across rows:
 *
 *   rank(pred[i,:], label[i]) = #{ j in [0, D) :
 *                                  pred[i, j] >  pred[i, label[i]]
 *                                  OR (pred[i, j] == pred[i, label[i]]
 *                                      AND j <= label[i]) }
 *   correct[i] = 1 if rank(...) <= top_k else 0
 *   accuracy   = sum(correct) / N
 *
 * The CUDA kernel formula in caffe2/operators/accuracy_op.cu counts the label
 * slot itself (col == label satisfies `col <= label`). CPU writes ngt = 1 then
 * skips j == label_i and uses `j < label_i`; numerically equivalent.
 *
 * Reg shape - 3 layers (references/reg-api-guide.md § Standard Code Shape):
 *   Layer 1 __simd_vf__  C2AccuracyRowVf<T>        chunked vector path: chunk-mask,
 *                                                  pred-vs-label_pred compare,
 *                                                  idx-vs-label_idx compare,
 *                                                  Select to 0/1, ReduceSum to rank
 *   Layer 2 __aicore__   C2AccuracyComputeRank<T>  LocalTensor.GetPhyAddr() ->
 *                                                  __ubuf__ cast, asc_vf_call
 *   Layer 3 kernel class KernelC2Accuracy<T>       DMA in pred + label, per-row
 *                                                  loop, scalar (rank <= top_k)
 *                                                  threshold, DMA out int32
 *
 * Cross-row aggregation: kernel writes a per-row int32 buffer of shape (N,);
 * the dispatch wrapper does `.sum().to(float32) / N` on the host side to
 * produce the 0-D scalar output. Avoids cross-core atomic / 2nd-stage reduce.
 *
 * Chunk shape: chunkLanes = 64 (= int32 register width). Pred fp16 processes
 * 64 lanes per chunk (uses half of the 128-lane fp16 register) so the int32
 * idx register and the Tpred pred register can iterate in lockstep with a
 * single chunkMask. Slightly under-utilises fp16 register bandwidth in trade
 * for code uniformity; per-row time is dominated by DMA at typical D, not by
 * the small constant number of vector ops.
 *
 * Tie-handling implementation: combine the three Compares masks via direct
 * MaskReg And/Or (kernel_reg_compute_maskreg_intf.h), then Select on a {0,1}
 * RegTensor pair, then Reduce<SUM, int32> the chunk score. Reg::Add<int32> is
 * used for the cross-chunk scalar accumulator at lane 0.
 *
 * Dispatch scope: predictions fp32 / fp16; labels int32. bf16 predictions and
 * int64 labels are deferred:
 *   - bf16 : Compares<__bf16, CMPMODE::EQ> on Reg path needs compile-gate
 *            verification; we follow the KthValue / Mode precedent and reject
 *            bf16 at the host until the gate is verified.
 *   - int64 labels : platform lacks Cast<int64, ...> binary at present.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace C2Accuracy {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("c2_accuracy(Tensor predictions, Tensor labels, int top_k=1) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor c2_accuracy_meta(
    const torch::Tensor &predictions,
    const torch::Tensor &labels,
    int64_t top_k)
{
    TORCH_CHECK(predictions.dim() == 2,
                "c2_accuracy: predictions must be 2-D, got ndim ", predictions.dim());
    TORCH_CHECK(labels.dim() == 1,
                "c2_accuracy: labels must be 1-D, got ndim ", labels.dim());
    TORCH_CHECK(labels.size(0) == predictions.size(0),
                "c2_accuracy: labels.size(0)=", labels.size(0),
                " must equal predictions.size(0)=", predictions.size(0));
    TORCH_CHECK(predictions.size(1) > 0,
                "c2_accuracy: predictions.size(1)=D must be > 0");
    TORCH_CHECK(top_k >= 1, "c2_accuracy: top_k must be >= 1, got ", top_k);
    return torch::empty({}, predictions.options().dtype(torch::kFloat32));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("c2_accuracy", c2_accuracy_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t>
calc_tiling_params(int64_t N, int64_t D, size_t bytesPerPred)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t SCALAR_SLOT_BYTES = 32;
    constexpr static int64_t SAFETY_MARGIN = 1024;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "c2_accuracy: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, N);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (N + numBlocks - 1) / numBlocks;

    // Per-core UB inventory (constant w.r.t. blockLength):
    //   tbufPred  : D * bytesPerPred  (one row of predictions)
    //   tbufIdx   : D * 4             (int32 column indices [0..D-1])
    //   tbufScratch: 32B              (rank scalar slot)
    //   inQueuePred  pipelined        (D * bytesPerPred) * PIPELINE_DEPTH
    //   inQueueLabel pipelined        SCALAR_SLOT_BYTES * PIPELINE_DEPTH
    //   outQueueCorrect pipelined     SCALAR_SLOT_BYTES * PIPELINE_DEPTH
    int64_t fixedBytes =
        D * static_cast<int64_t>(bytesPerPred)
      + D * 4
      + SCALAR_SLOT_BYTES;
    int64_t queueBytes =
        PIPELINE_DEPTH * D * static_cast<int64_t>(bytesPerPred)
      + PIPELINE_DEPTH * SCALAR_SLOT_BYTES   // labels
      + PIPELINE_DEPTH * SCALAR_SLOT_BYTES;  // out
    TORCH_CHECK(fixedBytes + queueBytes + SAFETY_MARGIN <= static_cast<int64_t>(ubSize),
                "c2_accuracy: D=", D, " too large for dav-3510 UB. fixedBytes=",
                fixedBytes, ", queueBytes=", queueBytes, ", ubSize=", ubSize,
                ". One full row must fit in UB (this first version constraint).");

    return std::make_tuple(numBlocks, blockLength);
}

// ===================== 4. Kernel - 3-layer Reg shape =====================

// Layer 1: __simd_vf__ vector function.
//   Computes rank for one row across the [0, elementCount) lane range.
//   chunkLanes = 64 (int32 register width) regardless of Tpred; chunkCount =
//   ceil(elementCount / 64).
//
//   Per-chunk mask build:
//     mask_gt    = pred >  label_pred                 (Compares<Tpred, GT>)
//     mask_eq    = pred == label_pred                 (Compares<Tpred, EQ>)
//     mask_le    = idx  <= label_idx                  (Compares<int32, LE>)
//     mask_eq_le = mask_eq AND mask_le                (MaskReg And)
//     mask_comb  = mask_gt OR  mask_eq_le             (MaskReg Or)
//     score      = mask_comb ? 1 : 0                  (Select on oneReg/zeroReg)
//     chunkRank  = ReduceSum(score) over chunkMask    (Reduce<SUM, int32>)
//   Cross-chunk: totalRank lane 0 += chunkRank lane 0.
//   StoreAlign totalRank lane 0 to rankOutPtr (32B slot).
template <typename Tpred>
__simd_vf__ inline void C2AccuracyRowVf(
    __ubuf__ Tpred   *predPtr,
    __ubuf__ int32_t *idxPtr,
    __ubuf__ int32_t *rankOutPtr,
    Tpred label_pred, int32_t label_idx,
    uint32_t elementCount, uint32_t chunkCount)
{
    // Caffe2 rank formula via direct MaskReg And/Or, chunked across the row.
    //   rank = #{ j : pred[j] > label_pred
    //              OR (pred[j] == label_pred AND idx[j] <= label_idx) }
    // Chunk shape: 64-lane chunks (= int32 vector width); pred fp16 processes
    // 64 lanes per chunk (half the 128-lane fp16 register) so the int32 idx
    // register and the Tpred pred register can iterate in lockstep with a
    // single chunkMask.
    constexpr uint32_t chunkLanes = 64u;

    AscendC::Reg::RegTensor<Tpred>   predReg;
    AscendC::Reg::RegTensor<int32_t> idxReg;
    AscendC::Reg::RegTensor<int32_t> zeroReg;
    AscendC::Reg::RegTensor<int32_t> oneReg;
    AscendC::Reg::RegTensor<int32_t> scoreReg;
    AscendC::Reg::RegTensor<int32_t> chunkRankReg;
    AscendC::Reg::RegTensor<int32_t> totalRankReg;

    uint32_t one = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<int32_t>(one);
    AscendC::Reg::MaskReg allMask    =
        AscendC::Reg::CreateMask<int32_t, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::Duplicate<int32_t, AscendC::Reg::MaskMergeMode::ZEROING>(
        zeroReg, 0, allMask);
    AscendC::Reg::Duplicate<int32_t, AscendC::Reg::MaskMergeMode::ZEROING>(
        oneReg, 1, allMask);
    AscendC::Reg::Duplicate<int32_t, AscendC::Reg::MaskMergeMode::ZEROING>(
        totalRankReg, 0, scalarMask);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * chunkLanes;
        uint32_t remaining = (elementCount > offset) ? (elementCount - offset) : 0;
        if (remaining == 0) break;
        uint32_t lanesThisChunk = (remaining > chunkLanes) ? chunkLanes : remaining;
        AscendC::Reg::MaskReg laneMask = AscendC::Reg::UpdateMask<int32_t>(lanesThisChunk);

        AscendC::Reg::LoadAlign<Tpred,   AscendC::Reg::LoadDist::DIST_NORM>(
            predReg, predPtr + offset);
        AscendC::Reg::LoadAlign<int32_t, AscendC::Reg::LoadDist::DIST_NORM>(
            idxReg,  idxPtr  + offset);

        AscendC::Reg::MaskReg maskGt, maskEq, maskLe, maskEqLe, maskComb;
        AscendC::Reg::Compares<Tpred,   AscendC::CMPMODE::GT>(
            maskGt, predReg, label_pred, laneMask);
        AscendC::Reg::Compares<Tpred,   AscendC::CMPMODE::EQ>(
            maskEq, predReg, label_pred, laneMask);
        AscendC::Reg::Compares<int32_t, AscendC::CMPMODE::LE>(
            maskLe, idxReg,  label_idx,  laneMask);
        AscendC::Reg::And(maskEqLe, maskEq,  maskLe,  allMask);
        AscendC::Reg::Or (maskComb, maskGt,  maskEqLe, allMask);

        AscendC::Reg::Select<int32_t>(scoreReg, oneReg, zeroReg, maskComb);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, int32_t, int32_t,
            AscendC::Reg::MaskMergeMode::ZEROING>(
                chunkRankReg, scoreReg, laneMask);

        // totalRank lane 0 += chunkRank lane 0.
        AscendC::Reg::Add<int32_t, AscendC::Reg::MaskMergeMode::ZEROING>(
            totalRankReg, totalRankReg, chunkRankReg, scalarMask);
    }

    AscendC::Reg::StoreAlign<int32_t, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        rankOutPtr, totalRankReg, scalarMask);
}

// Layer 2: __aicore__ wrapper. LocalTensor -> __ubuf__ cast and asc_vf_call.
template <typename Tpred>
__aicore__ inline void C2AccuracyComputeRank(
    AscendC::LocalTensor<Tpred>   &predUbufLT,
    AscendC::LocalTensor<int32_t> &idxUbufLT,
    AscendC::LocalTensor<int32_t> &rankScratchLT,
    Tpred label_pred, int32_t label_idx, uint32_t elementCount)
{
    constexpr uint32_t chunkLanes = 64u;

    __ubuf__ Tpred   *predPtr     = (__ubuf__ Tpred *)predUbufLT.GetPhyAddr();
    __ubuf__ int32_t *idxPtr      = (__ubuf__ int32_t *)idxUbufLT.GetPhyAddr();
    __ubuf__ int32_t *rankOutPtr  = (__ubuf__ int32_t *)rankScratchLT.GetPhyAddr();

    uint32_t chunkCount = (elementCount + chunkLanes - 1) / chunkLanes;
    asc_vf_call<C2AccuracyRowVf<Tpred>>(
        predPtr, idxPtr, rankOutPtr,
        label_pred, label_idx,
        elementCount, chunkCount);
}

// Layer 3: kernel class. DMA, per-row loop, scalar threshold, DMA out int32.
template <typename Tpred>
class KernelC2Accuracy {
public:
    __aicore__ inline KernelC2Accuracy() {}

    __aicore__ inline void Init(
        GM_ADDR predictions, GM_ADDR labels, GM_ADDR per_row_correct,
        int64_t N, int64_t D, int64_t top_k, int64_t blockLength)
    {
        predGm_.SetGlobalBuffer((__gm__ Tpred *)predictions);
        labelGm_.SetGlobalBuffer((__gm__ int32_t *)labels);
        outGm_.SetGlobalBuffer((__gm__ int32_t *)per_row_correct);

        N_ = N;
        D_ = D;
        top_k_ = top_k;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myBlockLength = N - blockStart;
        if (myBlockLength > blockLength) myBlockLength = blockLength;
        if (myBlockLength < 0) myBlockLength = 0;
        blockStart_ = blockStart;
        myBlockLength_ = myBlockLength;

        const uint32_t predBytes = static_cast<uint32_t>(D * sizeof(Tpred));
        const uint32_t idxBytes  = static_cast<uint32_t>(D * sizeof(int32_t));
        constexpr uint32_t SCALAR_SLOT_BYTES = 32u;

        pipe_.InitBuffer(inQueuePred_,    PIPELINE_DEPTH, predBytes);
        pipe_.InitBuffer(inQueueLabel_,   PIPELINE_DEPTH, SCALAR_SLOT_BYTES);
        pipe_.InitBuffer(outQueueOut_,    PIPELINE_DEPTH, SCALAR_SLOT_BYTES);
        pipe_.InitBuffer(tbufPred_,       predBytes);
        pipe_.InitBuffer(tbufIdx_,        idxBytes);
        pipe_.InitBuffer(tbufRankScratch_, SCALAR_SLOT_BYTES);
    }

    __aicore__ inline void Process()
    {
        if (myBlockLength_ <= 0) return;

        // Pre-populate idx ubuf with [0..D-1] (int32). Reused for every row on
        // this core. Done with scalar SetValue rather than a Reg::Arange call:
        // host happens once at startup, D is bounded, and this avoids dragging
        // in another vf for a constant pre-fill.
        AscendC::LocalTensor<int32_t> idxUbuf = tbufIdx_.template Get<int32_t>();
        for (int64_t d = 0; d < D_; ++d) {
            idxUbuf.SetValue(static_cast<int32_t>(d), static_cast<int32_t>(d));
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        for (int64_t r = 0; r < myBlockLength_; ++r) {
            ProcessRow(blockStart_ + r);
        }
    }

private:
    __aicore__ inline void ProcessRow(int64_t row)
    {
        // CopyIn predictions row.
        AscendC::LocalTensor<Tpred> predLocal = inQueuePred_.template AllocTensor<Tpred>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<Tpred> padParams{false, 0, 0, 0};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(D_ * sizeof(Tpred));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(predLocal, predGm_[row * D_], params, padParams);
        }
        inQueuePred_.EnQue(predLocal);
        predLocal = inQueuePred_.template DeQue<Tpred>();

        // CopyIn label (single int32; we DMA the 32B slot containing it).
        AscendC::LocalTensor<int32_t> labelLocal = inQueueLabel_.template AllocTensor<int32_t>();
        {
            AscendC::DataCopyExtParams params;
            AscendC::DataCopyPadExtParams<int32_t> padParams{false, 0, 0, 0};
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(sizeof(int32_t));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(labelLocal, labelGm_[row], params, padParams);
        }
        inQueueLabel_.EnQue(labelLocal);
        labelLocal = inQueueLabel_.template DeQue<int32_t>();

        // Transcribe pred row into tbufPred (UB-persistent staging buffer) so the
        // vf sees a stable __ubuf__ pointer.
        AscendC::LocalTensor<Tpred> predUbuf = tbufPred_.template Get<Tpred>();
        for (int64_t d = 0; d < D_; ++d) {
            predUbuf.SetValue(static_cast<int32_t>(d),
                              predLocal.GetValue(static_cast<int32_t>(d)));
        }
        int32_t label_idx = labelLocal.GetValue(0);
        // Host-side range validation guards against out-of-bounds reads here.
        Tpred label_pred = predUbuf.GetValue(label_idx);
        inQueuePred_.FreeTensor(predLocal);
        inQueueLabel_.FreeTensor(labelLocal);
        AscendC::PipeBarrier<PIPE_ALL>();

        int32_t rank = 0;
        for (int64_t d = 0; d < D_; ++d) {
            Tpred pred = predUbuf.GetValue(static_cast<int32_t>(d));
            if (pred > label_pred ||
                (pred == label_pred && d <= static_cast<int64_t>(label_idx))) {
                ++rank;
            }
        }
        int32_t correct = (rank <= static_cast<int32_t>(top_k_)) ? 1 : 0;

        // CopyOut single int32.
        AscendC::LocalTensor<int32_t> outLocal = outQueueOut_.template AllocTensor<int32_t>();
        outLocal.SetValue(0, correct);
        outQueueOut_.EnQue(outLocal);
        outLocal = outQueueOut_.template DeQue<int32_t>();
        {
            AscendC::DataCopyExtParams params;
            params.blockCount = 1;
            params.blockLen = static_cast<uint32_t>(sizeof(int32_t));
            params.srcStride = 0;
            params.dstStride = 0;
            AscendC::DataCopyPad(outGm_[row], outLocal, params);
        }
        outQueueOut_.FreeTensor(outLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<Tpred>   predGm_;
    AscendC::GlobalTensor<int32_t> labelGm_;
    AscendC::GlobalTensor<int32_t> outGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueuePred_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueLabel_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufPred_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIdx_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufRankScratch_;
    int64_t N_ = 0;
    int64_t D_ = 0;
    int64_t top_k_ = 0;
    int64_t blockStart_ = 0;
    int64_t myBlockLength_ = 0;
};

template <typename Tpred>
__global__ __aicore__ __vector__ void c2_accuracy_kernel(
    GM_ADDR predictions, GM_ADDR labels, GM_ADDR per_row_correct,
    int64_t N, int64_t D, int64_t top_k, int64_t blockLength)
{
    KernelC2Accuracy<Tpred> op;
    op.Init(predictions, labels, per_row_correct, N, D, top_k, blockLength);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor c2_accuracy_npu(
    const torch::Tensor &predictions,
    const torch::Tensor &labels,
    int64_t top_k)
{
    auto pred_dtype = predictions.scalar_type();
    TORCH_CHECK(pred_dtype == torch::kFloat32 || pred_dtype == torch::kFloat16,
                "c2_accuracy: predictions dtype must be float32 or float16, got ",
                pred_dtype, ". bf16 is deferred on this platform.");
    auto label_dtype = labels.scalar_type();
    TORCH_CHECK(label_dtype == torch::kInt32,
                "c2_accuracy: labels dtype must be int32, got ",
                label_dtype, ". int64 is deferred (platform lacks Cast<int64,...> binary).");

    TORCH_CHECK(predictions.dim() == 2,
                "c2_accuracy: predictions must be 2-D, got ndim ", predictions.dim());
    TORCH_CHECK(labels.dim() == 1,
                "c2_accuracy: labels must be 1-D, got ndim ", labels.dim());

    const c10::OptionalDeviceGuard guard(predictions.device());
    auto predictions_contig = predictions.contiguous();
    auto labels_contig = labels.contiguous();

    int64_t N = predictions_contig.size(0);
    int64_t D = predictions_contig.size(1);
    TORCH_CHECK(labels_contig.size(0) == N,
                "c2_accuracy: labels.size(0)=", labels_contig.size(0),
                " must equal predictions.size(0)=", N);
    TORCH_CHECK(D > 0, "c2_accuracy: predictions.size(1)=D must be > 0");
    TORCH_CHECK(top_k >= 1, "c2_accuracy: top_k must be >= 1, got ", top_k);
    TORCH_CHECK(D <= static_cast<int64_t>(0x7fffffff),
                "c2_accuracy: D=", D, " exceeds INT32_MAX");

    if (N == 0) {
        return torch::zeros({}, predictions_contig.options().dtype(torch::kFloat32));
    }

    auto per_row = torch::empty({N},
        predictions_contig.options().dtype(torch::kInt32));

    const size_t bytesPerPred = (pred_dtype == torch::kFloat16) ? 2u : 4u;
    int64_t numBlocks, blockLength;
    std::tie(numBlocks, blockLength) = calc_tiling_params(N, D, bytesPerPred);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto pred_ptr  = (GM_ADDR)predictions_contig.data_ptr();
    auto label_ptr = (GM_ADDR)labels_contig.data_ptr();
    auto out_ptr   = (GM_ADDR)per_row.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            predictions_contig.scalar_type(), "c2_accuracy_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                c2_accuracy_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    pred_ptr, label_ptr, out_ptr,
                    N, D, top_k, blockLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                c2_accuracy_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    pred_ptr, label_ptr, out_ptr,
                    N, D, top_k, blockLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("C2Accuracy", acl_call);

    // Reduce per-row int32 to a single float scalar. sum() + cast + divide are
    // standard framework ops dispatched onto the same device.
    return per_row.sum().to(torch::kFloat32).div(static_cast<double>(N));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("c2_accuracy", c2_accuracy_npu);
}

} // namespace C2Accuracy
} // namespace ops_multimodal_fusion
