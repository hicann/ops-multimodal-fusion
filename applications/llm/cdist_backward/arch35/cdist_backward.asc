/*!
 * \file cdist_backward.asc
 * \brief RegBase cdist_backward x1-gradient operator for Ascend NPU (dav-3510).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <limits>
#include <type_traits>
#include <vector>

namespace ops_multimodal_fusion {
namespace CdistBackward {

static constexpr int64_t kSafetyBytes = 4096;
static constexpr int64_t kMaxTileElems = 2048;
static constexpr int64_t kModeZero = 0;
static constexpr int64_t kModeOne = 1;
static constexpr int64_t kModeLtTwo = 2;
static constexpr int64_t kModeTwo = 3;
static constexpr int64_t kModeGeneral = 4;
static constexpr int64_t kModeInf = 5;
static constexpr int64_t kMaxBatchDims = 8;

struct BatchBroadcastInfo {
    int64_t rank = 0;
    int64_t outShape[kMaxBatchDims] = {};
    int64_t x1Shape[kMaxBatchDims] = {};
    int64_t x2Shape[kMaxBatchDims] = {};
    int64_t x1Stride[kMaxBatchDims] = {};
    int64_t x2Stride[kMaxBatchDims] = {};
};

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("cdist_backward(Tensor grad, Tensor x1, Tensor x2, float p, Tensor cdist) -> Tensor");
}

static std::vector<int64_t> batch_shape(const torch::Tensor &x)
{
    std::vector<int64_t> shape;
    shape.reserve(std::max<int64_t>(x.dim() - 2, 0));
    for (int64_t dim = 0; dim < x.dim() - 2; ++dim) {
        shape.push_back(x.size(dim));
    }
    return shape;
}

static std::vector<int64_t> make_shape_with_tail(
    const std::vector<int64_t> &batch, int64_t a, int64_t b)
{
    std::vector<int64_t> shape = batch;
    shape.push_back(a);
    shape.push_back(b);
    return shape;
}

static int64_t product(const std::vector<int64_t> &shape)
{
    int64_t out = 1;
    for (int64_t value : shape) {
        out *= value;
    }
    return out;
}

static void fill_batch_shape_and_stride(const torch::Tensor &x,
                                        int64_t rank,
                                        int64_t *shape,
                                        int64_t *stride)
{
    int64_t batchRank = x.dim() - 2;
    int64_t leading = rank - batchRank;
    for (int64_t i = 0; i < rank; ++i) {
        if (i < leading) {
            shape[i] = 1;
            stride[i] = 0;
        } else {
            int64_t srcDim = i - leading;
            shape[i] = x.size(srcDim);
            int64_t s = x.size(-2) * x.size(-1);
            for (int64_t d = batchRank - 1; d > srcDim; --d) {
                s *= x.size(d);
            }
            stride[i] = s;
        }
    }
}

static BatchBroadcastInfo make_batch_broadcast_info(
    const std::vector<int64_t> &batch,
    const torch::Tensor &x1,
    const torch::Tensor &x2)
{
    TORCH_CHECK(static_cast<int64_t>(batch.size()) <= kMaxBatchDims,
                "cdist_backward: batch rank exceeds supported max rank ",
                kMaxBatchDims);
    BatchBroadcastInfo info;
    info.rank = static_cast<int64_t>(batch.size());
    for (int64_t i = 0; i < info.rank; ++i) {
        info.outShape[i] = batch[i];
    }
    fill_batch_shape_and_stride(x1, info.rank, info.x1Shape, info.x1Stride);
    fill_batch_shape_and_stride(x2, info.rank, info.x2Shape, info.x2Stride);
    return info;
}

static void check_common(const torch::Tensor &grad,
                         const torch::Tensor &x1,
                         const torch::Tensor &x2,
                         double p,
                         const torch::Tensor &cdist)
{
    TORCH_CHECK(x1.dim() >= 2,
                "cdist_backward: x1 must have rank >= 2, got ", x1.dim());
    TORCH_CHECK(x2.dim() >= 2,
                "cdist_backward: x2 must have rank >= 2, got ", x2.dim());
    TORCH_CHECK(p >= 0.0 && p == p,
                "cdist_backward: cdist only supports non-negative p values");
    TORCH_CHECK(x1.scalar_type() == torch::kFloat16 ||
                x1.scalar_type() == torch::kFloat32,
                "cdist_backward: expected Half or Float inputs on dav-3510 Reg path, got ",
                x1.scalar_type());
    TORCH_CHECK(x1.scalar_type() == x2.scalar_type() &&
                x1.scalar_type() == grad.scalar_type() &&
                x1.scalar_type() == cdist.scalar_type(),
                "cdist_backward: grad, x1, x2 and cdist must have the same dtype");
    TORCH_CHECK(x1.device() == x2.device() &&
                x1.device() == grad.device() &&
                x1.device() == cdist.device(),
                "cdist_backward: all tensors must be on the same device");
    TORCH_CHECK(x1.size(-1) == x2.size(-1),
                "cdist_backward: x1.size(-1) must match x2.size(-1), got ",
                x1.size(-1), " and ", x2.size(-1));

    auto batch = at::infer_size(batch_shape(x1), batch_shape(x2));
    int64_t r1 = x1.size(-2);
    int64_t r2 = x2.size(-2);
    auto distanceShape = make_shape_with_tail(batch, r1, r2);
    TORCH_CHECK(cdist.sizes() == distanceShape,
                "cdist_backward: cdist shape must be expanded_batch + [r1, r2]");
    TORCH_CHECK(grad.sizes() == distanceShape,
                "cdist_backward: grad shape must match cdist shape");
}

static std::vector<int64_t> output_shape(const torch::Tensor &x1,
                                         const torch::Tensor &x2)
{
    auto batch = at::infer_size(batch_shape(x1), batch_shape(x2));
    return make_shape_with_tail(batch, x1.size(-2), x1.size(-1));
}

torch::Tensor cdist_backward_meta(const torch::Tensor &grad,
                                  const torch::Tensor &x1,
                                  const torch::Tensor &x2,
                                  double p,
                                  const torch::Tensor &cdist)
{
    check_common(grad, x1, x2, p, cdist);
    return torch::empty(output_shape(x1, x2), x1.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("cdist_backward", cdist_backward_meta);
}

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t batchCount, int64_t r1, int64_t m, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "cdist_backward: coreNum must be positive");

    int64_t bytesPerElem = 3 * static_cast<int64_t>(sizeof(float)) + 3 * elemSize;
    int64_t tileElems = (static_cast<int64_t>(ubSize) - kSafetyBytes - 32) / bytesPerElem;
    int64_t alignElems = 32 / elemSize;
    tileElems = (tileElems / alignElems) * alignElems;
    tileElems = std::min<int64_t>(tileElems, kMaxTileElems);
    TORCH_CHECK(tileElems > 0,
                "cdist_backward: UB is too small for one aligned tile");

    int64_t tileCount = (m + tileElems - 1) / tileElems;
    int64_t jobCount = batchCount * r1 * tileCount;
    int64_t numBlocks = std::min<int64_t>(coreNum, jobCount);
    numBlocks = std::max<int64_t>(numBlocks, 1);
    int64_t jobsPerBlock = (jobCount + numBlocks - 1) / numBlocks;
    return std::make_tuple(numBlocks, jobsPerBlock, tileElems);
}

__simd_vf__ inline void ZeroFloatVf(__ubuf__ float *dstAddr,
                                    uint32_t count,
                                    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, zeroReg, mask);
    }
}

__simd_vf__ inline void CastHalfToFloatVf(__ubuf__ float *dstAddr,
                                          __ubuf__ half *srcAddr,
                                          uint32_t count,
                                          uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<half> srcReg;
    AscendC::Reg::RegTensor<float> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__simd_vf__ inline void CastFloatToHalfVf(__ubuf__ half *dstAddr,
                                          __ubuf__ float *srcAddr,
                                          uint32_t count,
                                          uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> srcReg;
    AscendC::Reg::RegTensor<half> dstReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            srcReg, srcAddr + offset);
        AscendC::Reg::Cast<half, float, castToHalf>(dstReg, srcReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, dstReg, mask);
    }
}

__simd_vf__ inline void CdistBackwardOneVf(__ubuf__ float *accAddr,
                                           __ubuf__ float *x1Addr,
                                           __ubuf__ float *x2Addr,
                                           float grad,
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, x1Reg, x2Reg, diffReg, signReg;
    AscendC::Reg::RegTensor<float> oneReg, negOneReg, tmpReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg gtMask, ltMask;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x1Reg, x1Addr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x2Reg, x2Addr + offset);
        AscendC::Reg::Sub(diffReg, x1Reg, x2Reg, mask);
        AscendC::Reg::Duplicate<float>(signReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(negOneReg, -1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(gtMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(ltMask, diffReg, 0.0f, mask);
        AscendC::Reg::Select<float>(signReg, oneReg, signReg, gtMask);
        AscendC::Reg::Select<float>(signReg, negOneReg, signReg, ltMask);
        AscendC::Reg::Muls(tmpReg, signReg, grad, mask);
        AscendC::Reg::Add(accReg, accReg, tmpReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__simd_vf__ inline void CdistBackwardTwoVf(__ubuf__ float *accAddr,
                                           __ubuf__ float *x1Addr,
                                           __ubuf__ float *x2Addr,
                                           float grad,
                                           float dist,
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, x1Reg, x2Reg, diffReg, distReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x1Reg, x1Addr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x2Reg, x2Addr + offset);
        AscendC::Reg::Sub(diffReg, x1Reg, x2Reg, mask);
        AscendC::Reg::Muls(diffReg, diffReg, grad, mask);
        AscendC::Reg::Duplicate<float>(distReg, dist, mask);
        AscendC::Reg::Div(diffReg, diffReg, distReg, mask);
        AscendC::Reg::Add(accReg, accReg, diffReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__simd_vf__ inline void CdistBackwardLtTwoVf(__ubuf__ float *accAddr,
                                             __ubuf__ float *x1Addr,
                                             __ubuf__ float *x2Addr,
                                             float grad,
                                             float dist,
                                             float p,
                                             uint32_t count,
                                             uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, x1Reg, x2Reg, diffReg, absReg;
    AscendC::Reg::RegTensor<float> signReg, oneReg, negOneReg, zeroReg;
    AscendC::Reg::RegTensor<float> safeAbsReg, powReg, distReg, denomReg, contribReg;
    float exponent = p - 1.0f;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg gtMask, ltMask, zeroMask;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x1Reg, x1Addr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x2Reg, x2Addr + offset);
        AscendC::Reg::Sub(diffReg, x1Reg, x2Reg, mask);
        AscendC::Reg::Abs(absReg, diffReg, mask);
        AscendC::Reg::Duplicate<float>(signReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(negOneReg, -1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(gtMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(ltMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(zeroMask, absReg, 0.0f, mask);
        AscendC::Reg::Select<float>(signReg, oneReg, signReg, gtMask);
        AscendC::Reg::Select<float>(signReg, negOneReg, signReg, ltMask);
        safeAbsReg = absReg;
        AscendC::Reg::Select<float>(safeAbsReg, oneReg, safeAbsReg, zeroMask);
        AscendC::Reg::Ln(powReg, safeAbsReg, mask);
        AscendC::Reg::Muls(powReg, powReg, exponent, mask);
        AscendC::Reg::Exp(powReg, powReg, mask);
        AscendC::Reg::Duplicate<float>(distReg, dist, mask);
        AscendC::Reg::Ln(denomReg, distReg, mask);
        AscendC::Reg::Muls(denomReg, denomReg, exponent, mask);
        AscendC::Reg::Exp(denomReg, denomReg, mask);
        AscendC::Reg::Mul(contribReg, signReg, powReg, mask);
        AscendC::Reg::Muls(contribReg, contribReg, grad, mask);
        AscendC::Reg::Div(contribReg, contribReg, denomReg, mask);
        AscendC::Reg::Select<float>(contribReg, zeroReg, contribReg, zeroMask);
        AscendC::Reg::Add(accReg, accReg, contribReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__simd_vf__ inline void CdistBackwardGeneralVf(__ubuf__ float *accAddr,
                                               __ubuf__ float *x1Addr,
                                               __ubuf__ float *x2Addr,
                                               float grad,
                                               float dist,
                                               float p,
                                               uint32_t count,
                                               uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, x1Reg, x2Reg, diffReg, absReg;
    AscendC::Reg::RegTensor<float> oneReg, zeroReg, safeAbsReg, powReg;
    AscendC::Reg::RegTensor<float> distReg, denomReg, contribReg;
    float numeratorExponent = p - 2.0f;
    float denomExponent = p - 1.0f;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg zeroMask;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x1Reg, x1Addr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x2Reg, x2Addr + offset);
        AscendC::Reg::Sub(diffReg, x1Reg, x2Reg, mask);
        AscendC::Reg::Abs(absReg, diffReg, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(zeroMask, absReg, 0.0f, mask);
        safeAbsReg = absReg;
        AscendC::Reg::Select<float>(safeAbsReg, oneReg, safeAbsReg, zeroMask);
        AscendC::Reg::Ln(powReg, safeAbsReg, mask);
        AscendC::Reg::Muls(powReg, powReg, numeratorExponent, mask);
        AscendC::Reg::Exp(powReg, powReg, mask);
        AscendC::Reg::Duplicate<float>(distReg, dist, mask);
        AscendC::Reg::Ln(denomReg, distReg, mask);
        AscendC::Reg::Muls(denomReg, denomReg, denomExponent, mask);
        AscendC::Reg::Exp(denomReg, denomReg, mask);
        AscendC::Reg::Mul(contribReg, diffReg, powReg, mask);
        AscendC::Reg::Muls(contribReg, contribReg, grad, mask);
        AscendC::Reg::Div(contribReg, contribReg, denomReg, mask);
        AscendC::Reg::Select<float>(contribReg, zeroReg, contribReg, zeroMask);
        AscendC::Reg::Add(accReg, accReg, contribReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__simd_vf__ inline void CdistBackwardInfVf(__ubuf__ float *accAddr,
                                           __ubuf__ float *x1Addr,
                                           __ubuf__ float *x2Addr,
                                           float grad,
                                           float dist,
                                           uint32_t count,
                                           uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accReg, x1Reg, x2Reg, diffReg, absReg;
    AscendC::Reg::RegTensor<float> signReg, oneReg, negOneReg, zeroReg, contribReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg gtMask, ltMask, eqMask;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            accReg, accAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x1Reg, x1Addr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            x2Reg, x2Addr + offset);
        AscendC::Reg::Sub(diffReg, x1Reg, x2Reg, mask);
        AscendC::Reg::Abs(absReg, diffReg, mask);
        AscendC::Reg::Duplicate<float>(signReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(zeroReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(oneReg, 1.0f, mask);
        AscendC::Reg::Duplicate<float>(negOneReg, -1.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::GT>(gtMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(ltMask, diffReg, 0.0f, mask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(eqMask, absReg, dist, mask);
        AscendC::Reg::Select<float>(signReg, oneReg, signReg, gtMask);
        AscendC::Reg::Select<float>(signReg, negOneReg, signReg, ltMask);
        AscendC::Reg::Muls(contribReg, signReg, grad, mask);
        AscendC::Reg::Select<float>(contribReg, contribReg, zeroReg, eqMask);
        AscendC::Reg::Add(accReg, accReg, contribReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            accAddr + offset, accReg, mask);
    }
}

__aicore__ inline void ZeroFloat(AscendC::LocalTensor<float> &dst, int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ZeroFloatVf>((__ubuf__ float *)dst.GetPhyAddr(),
                             elementCount, chunkCount);
}

__aicore__ inline void CastHalfToFloat(AscendC::LocalTensor<float> &dst,
                                       AscendC::LocalTensor<half> &src,
                                       int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastHalfToFloatVf>((__ubuf__ float *)dst.GetPhyAddr(),
                                   (__ubuf__ half *)src.GetPhyAddr(),
                                   elementCount, chunkCount);
}

__aicore__ inline void CastFloatToHalf(AscendC::LocalTensor<half> &dst,
                                       AscendC::LocalTensor<float> &src,
                                       int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<CastFloatToHalfVf>((__ubuf__ half *)dst.GetPhyAddr(),
                                   (__ubuf__ float *)src.GetPhyAddr(),
                                   elementCount, chunkCount);
}

template <int64_t Mode>
__aicore__ inline void CdistBackwardStep(AscendC::LocalTensor<float> &acc,
                                         AscendC::LocalTensor<float> &x1,
                                         AscendC::LocalTensor<float> &x2,
                                         float grad,
                                         float dist,
                                         float p,
                                         int64_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    if constexpr (Mode == kModeOne) {
        asc_vf_call<CdistBackwardOneVf>(
            (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ float *)x1.GetPhyAddr(),
            (__ubuf__ float *)x2.GetPhyAddr(), grad, elementCount, chunkCount);
    } else if constexpr (Mode == kModeLtTwo) {
        asc_vf_call<CdistBackwardLtTwoVf>(
            (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ float *)x1.GetPhyAddr(),
            (__ubuf__ float *)x2.GetPhyAddr(), grad, dist, p,
            elementCount, chunkCount);
    } else if constexpr (Mode == kModeTwo) {
        asc_vf_call<CdistBackwardTwoVf>(
            (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ float *)x1.GetPhyAddr(),
            (__ubuf__ float *)x2.GetPhyAddr(), grad, dist,
            elementCount, chunkCount);
    } else if constexpr (Mode == kModeGeneral) {
        asc_vf_call<CdistBackwardGeneralVf>(
            (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ float *)x1.GetPhyAddr(),
            (__ubuf__ float *)x2.GetPhyAddr(), grad, dist, p,
            elementCount, chunkCount);
    } else {
        asc_vf_call<CdistBackwardInfVf>(
            (__ubuf__ float *)acc.GetPhyAddr(), (__ubuf__ float *)x1.GetPhyAddr(),
            (__ubuf__ float *)x2.GetPhyAddr(), grad, dist,
            elementCount, chunkCount);
    }
}

template <typename T, int64_t Mode>
class KernelCdistBackward {
public:
    __aicore__ inline KernelCdistBackward() {}

    __aicore__ inline void Init(GM_ADDR grad,
                                GM_ADDR x1,
                                GM_ADDR x2,
                                GM_ADDR cdist,
                                GM_ADDR output,
                                BatchBroadcastInfo broadcastInfo,
                                int64_t batchCount,
                                int64_t r1,
                                int64_t r2,
                                int64_t m,
                                float p,
                                int64_t tileElems,
                                int64_t jobsPerBlock)
    {
        gradGm_.SetGlobalBuffer((__gm__ T *)grad);
        x1Gm_.SetGlobalBuffer((__gm__ T *)x1);
        x2Gm_.SetGlobalBuffer((__gm__ T *)x2);
        cdistGm_.SetGlobalBuffer((__gm__ T *)cdist);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        broadcastInfo_ = broadcastInfo;
        batchCount_ = batchCount;
        r1_ = r1;
        r2_ = r2;
        m_ = m;
        p_ = p;
        tileElems_ = tileElems;
        tileCount_ = (m_ + tileElems_ - 1) / tileElems_;
        jobStart_ = AscendC::GetBlockIdx() * jobsPerBlock;
        jobCount_ = batchCount_ * r1_ * tileCount_ - jobStart_;
        if (jobCount_ > jobsPerBlock) {
            jobCount_ = jobsPerBlock;
        }
        if (jobCount_ < 0) {
            jobCount_ = 0;
        }
        pipe_.InitBuffer(tbufX1_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufX2_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufX1Float_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufX2Float_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufAccum_, tileElems_ * sizeof(float));
        pipe_.InitBuffer(tbufOutput_, tileElems_ * sizeof(T));
        pipe_.InitBuffer(tbufScalar_, 64);
        alignElems_ = 32 / static_cast<int64_t>(sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (int64_t localJob = 0; localJob < jobCount_; ++localJob) {
            int64_t job = jobStart_ + localJob;
            int64_t tile = job % tileCount_;
            int64_t tmp = job / tileCount_;
            int64_t i = tmp % r1_;
            int64_t batch = tmp / r1_;
            int64_t featureStart = tile * tileElems_;
            int64_t count = m_ - featureStart;
            if (count > tileElems_) {
                count = tileElems_;
            }
            ProcessTile(batch, i, featureStart, count);
        }
    }

private:
    __aicore__ inline float ReadScalar(const AscendC::GlobalTensor<T> &gm, int64_t offset)
    {
        AscendC::LocalTensor<T> scalarLocal = tbufScalar_.template Get<T>();
        AscendC::DataCopyExtParams copyOne;
        copyOne.blockCount = 1;
        copyOne.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOne.srcStride = 0;
        copyOne.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padOne{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(scalarLocal, gm[offset], copyOne, padOne);
        AscendC::PipeBarrier<PIPE_ALL>();
        if constexpr (std::is_same<T, half>::value) {
            half value = scalarLocal.GetValue(0);
            return static_cast<float>(value);
        } else {
            return scalarLocal.GetValue(0);
        }
    }

    __aicore__ inline void ProcessTile(int64_t batch,
                                       int64_t i,
                                       int64_t featureStart,
                                       int64_t count)
    {
        int64_t alignedCount = ((count + alignElems_ - 1) / alignElems_) * alignElems_;
        AscendC::LocalTensor<T> x1Local = tbufX1_.template Get<T>();
        AscendC::LocalTensor<T> x2Local = tbufX2_.template Get<T>();
        AscendC::LocalTensor<float> x1Float = tbufX1Float_.template Get<float>();
        AscendC::LocalTensor<float> x2Float = tbufX2Float_.template Get<float>();
        AscendC::LocalTensor<float> accumLocal = tbufAccum_.template Get<float>();

        ZeroFloat(accumLocal, alignedCount);
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams copyVector;
        copyVector.blockCount = 1;
        copyVector.blockLen = static_cast<uint32_t>(count * sizeof(T));
        copyVector.srcStride = 0;
        copyVector.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padVector{
            true, 0, static_cast<uint8_t>(alignedCount - count), static_cast<T>(0)};

        if constexpr (Mode != kModeZero) {
            int64_t x1Offset = BatchOffset(
                batch, broadcastInfo_.x1Shape, broadcastInfo_.x1Stride) +
                i * m_ + featureStart;
            AscendC::DataCopyPad(x1Local, x1Gm_[x1Offset], copyVector, padVector);
            AscendC::PipeBarrier<PIPE_ALL>();
            if constexpr (std::is_same<T, half>::value) {
                CastHalfToFloat(x1Float, x1Local, alignedCount);
            }
            AscendC::PipeBarrier<PIPE_ALL>();

            for (int64_t j = 0; j < r2_; ++j) {
                int64_t distanceOffset = (batch * r1_ + i) * r2_ + j;
                float grad = ReadScalar(gradGm_, distanceOffset);
                float dist = ReadScalar(cdistGm_, distanceOffset);
                if constexpr (Mode == kModeLtTwo || Mode == kModeTwo || Mode == kModeGeneral) {
                    if (dist == 0.0f) {
                        continue;
                    }
                }

                int64_t x2Offset = BatchOffset(
                    batch, broadcastInfo_.x2Shape, broadcastInfo_.x2Stride) +
                    j * m_ + featureStart;
                AscendC::DataCopyPad(x2Local, x2Gm_[x2Offset], copyVector, padVector);
                AscendC::PipeBarrier<PIPE_ALL>();
                if constexpr (std::is_same<T, half>::value) {
                    CastHalfToFloat(x2Float, x2Local, alignedCount);
                    AscendC::PipeBarrier<PIPE_ALL>();
                    if constexpr (Mode == kModeInf) {
                        if (m_ == 1) {
                            CdistBackwardStep<kModeOne>(
                                accumLocal, x1Float, x2Float, grad, dist, p_, alignedCount);
                        } else {
                            CdistBackwardStep<Mode>(
                                accumLocal, x1Float, x2Float, grad, dist, p_, alignedCount);
                        }
                    } else {
                        CdistBackwardStep<Mode>(
                            accumLocal, x1Float, x2Float, grad, dist, p_, alignedCount);
                    }
                } else {
                    if constexpr (Mode == kModeInf) {
                        if (m_ == 1) {
                            CdistBackwardStep<kModeOne>(
                                accumLocal, x1Local, x2Local, grad, dist, p_, alignedCount);
                        } else {
                            CdistBackwardStep<Mode>(
                                accumLocal, x1Local, x2Local, grad, dist, p_, alignedCount);
                        }
                    } else {
                        CdistBackwardStep<Mode>(
                            accumLocal, x1Local, x2Local, grad, dist, p_, alignedCount);
                    }
                }
                AscendC::PipeBarrier<PIPE_ALL>();
            }
        }

        AscendC::DataCopyExtParams copyOutput;
        copyOutput.blockCount = 1;
        copyOutput.blockLen = static_cast<uint32_t>(count * sizeof(T));
        copyOutput.srcStride = 0;
        copyOutput.dstStride = 0;
        int64_t outputOffset = (batch * r1_ + i) * m_ + featureStart;
        if constexpr (std::is_same<T, half>::value) {
            AscendC::LocalTensor<half> outLocal = tbufOutput_.template Get<half>();
            CastFloatToHalf(outLocal, accumLocal, alignedCount);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyPad(outputGm_[outputOffset], outLocal, copyOutput);
        } else {
            AscendC::DataCopyPad(outputGm_[outputOffset], accumLocal, copyOutput);
        }
    }

    __aicore__ inline int64_t BatchOffset(
        int64_t batch, const int64_t *shape, const int64_t *stride)
    {
        int64_t offset = 0;
        int64_t tmp = batch;
        for (int64_t d = broadcastInfo_.rank - 1; d >= 0; --d) {
            int64_t coord = tmp % broadcastInfo_.outShape[d];
            tmp /= broadcastInfo_.outShape[d];
            if (shape[d] != 1) {
                offset += coord * stride[d];
            }
        }
        return offset;
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> gradGm_;
    AscendC::GlobalTensor<T> x1Gm_;
    AscendC::GlobalTensor<T> x2Gm_;
    AscendC::GlobalTensor<T> cdistGm_;
    AscendC::GlobalTensor<T> outputGm_;
    BatchBroadcastInfo broadcastInfo_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX1Float_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufX2Float_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufAccum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOutput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufScalar_;
    int64_t batchCount_ = 0;
    int64_t r1_ = 0;
    int64_t r2_ = 0;
    int64_t m_ = 0;
    float p_ = 0.0f;
    int64_t tileElems_ = 0;
    int64_t tileCount_ = 0;
    int64_t jobStart_ = 0;
    int64_t jobCount_ = 0;
    int64_t alignElems_ = 1;
};

template <typename T, int64_t Mode>
__global__ __aicore__ __vector__ void cdist_backward_kernel(
    GM_ADDR grad, GM_ADDR x1, GM_ADDR x2, GM_ADDR cdist, GM_ADDR output,
    BatchBroadcastInfo broadcastInfo,
    int64_t batchCount, int64_t r1, int64_t r2, int64_t m, float p,
    int64_t tileElems, int64_t jobsPerBlock)
{
    KernelCdistBackward<T, Mode> op;
    op.Init(grad, x1, x2, cdist, output,
            broadcastInfo, batchCount, r1, r2, m, p, tileElems, jobsPerBlock);
    op.Process();
}

template <int64_t Mode>
static void launch_kernel(const torch::Tensor &grad,
                          const torch::Tensor &x1,
                          const torch::Tensor &x2,
                          const torch::Tensor &cdist,
                          const torch::Tensor &output,
                          BatchBroadcastInfo broadcastInfo,
                          int64_t batchCount,
                          int64_t r1,
                          int64_t r2,
                          int64_t m,
                          float p,
                          int64_t numBlocks,
                          int64_t jobsPerBlock,
                          int64_t tileElems)
{
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto gradPtr = (GM_ADDR)grad.data_ptr();
    auto x1Ptr = (GM_ADDR)x1.data_ptr();
    auto x2Ptr = (GM_ADDR)x2.data_ptr();
    auto cdistPtr = (GM_ADDR)cdist.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    AT_DISPATCH_SWITCH(
        x1.scalar_type(), "cdist_backward_npu",
        AT_DISPATCH_CASE(torch::kFloat16, [&] {
            cdist_backward_kernel<half, Mode><<<numBlocks, nullptr, stream>>>(
                gradPtr, x1Ptr, x2Ptr, cdistPtr, outputPtr,
                broadcastInfo,
                batchCount, r1, r2, m, p, tileElems, jobsPerBlock);
        })
        AT_DISPATCH_CASE(torch::kFloat32, [&] {
            cdist_backward_kernel<float, Mode><<<numBlocks, nullptr, stream>>>(
                gradPtr, x1Ptr, x2Ptr, cdistPtr, outputPtr,
                broadcastInfo,
                batchCount, r1, r2, m, p, tileElems, jobsPerBlock);
        })
    );
}

torch::Tensor cdist_backward_npu(const torch::Tensor &grad,
                                 const torch::Tensor &x1,
                                 const torch::Tensor &x2,
                                 double p,
                                 const torch::Tensor &cdist)
{
    check_common(grad, x1, x2, p, cdist);
    const c10::OptionalDeviceGuard guard(x1.device());

    auto batch = at::infer_size(batch_shape(x1), batch_shape(x2));
    int64_t batchCount = product(batch);
    int64_t r1 = x1.size(-2);
    int64_t r2 = x2.size(-2);
    int64_t m = x1.size(-1);
    auto x1Shape = make_shape_with_tail(batch, r1, m);
    auto broadcastInfo = make_batch_broadcast_info(batch, x1, x2);

    auto x1C = x1.contiguous();
    auto x2C = x2.contiguous();

    auto gradC = grad.contiguous();
    auto cdistC = cdist.contiguous();
    auto output = torch::empty(x1Shape, x1.options());

    if (batchCount == 0 || r1 == 0 || m == 0) {
        return output;
    }

    int64_t numBlocks = 1;
    int64_t jobsPerBlock = 1;
    int64_t tileElems = 1;
    std::tie(numBlocks, jobsPerBlock, tileElems) =
        calc_tiling_params(batchCount, r1, m, x1C.element_size());

    float pFloat = static_cast<float>(p);
    // When the task queue is enabled the kernel launch below runs deferred on a
    // worker thread, after this function has already returned. The launch reads
    // each tensor's data pointer at that later point, so the dispatch must keep
    // every tensor it touches alive until then. The contiguous copies and the
    // caller-recomputed cdist are function-local, so a by-reference capture would
    // dangle once this frame unwinds, freeing their storage before the queued
    // launch reads it ("Tensor that doesn't have storage" / inner error, masked
    // only by ASCEND_LAUNCH_BLOCKING). Capturing by value bumps each tensor's
    // reference count, holding the storage alive across the deferred launch; the
    // record_stream calls then defer allocator reuse of any freshly allocated
    // copy until the async kernel that consumes it has finished on the stream.
    auto acl_call = [=]() mutable -> int {
        c10::Stream recordStream = c10_npu::getCurrentNPUStream().unwrap();
        gradC.record_stream(recordStream);
        x1C.record_stream(recordStream);
        x2C.record_stream(recordStream);
        cdistC.record_stream(recordStream);
        output.record_stream(recordStream);
        if (p == 0.0 || r2 == 0) {
            launch_kernel<kModeZero>(
                gradC, x1C, x2C, cdistC, output, broadcastInfo,
                batchCount, r1, r2, m, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == 1.0) {
            launch_kernel<kModeOne>(
                gradC, x1C, x2C, cdistC, output, broadcastInfo,
                batchCount, r1, r2, m, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p < 2.0) {
            launch_kernel<kModeLtTwo>(
                gradC, x1C, x2C, cdistC, output, broadcastInfo,
                batchCount, r1, r2, m, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == 2.0) {
            launch_kernel<kModeTwo>(
                gradC, x1C, x2C, cdistC, output, broadcastInfo,
                batchCount, r1, r2, m, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else if (p == std::numeric_limits<double>::infinity()) {
            launch_kernel<kModeInf>(
                gradC, x1C, x2C, cdistC, output, broadcastInfo,
                batchCount, r1, r2, m, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        } else {
            launch_kernel<kModeGeneral>(
                gradC, x1C, x2C, cdistC, output, broadcastInfo,
                batchCount, r1, r2, m, pFloat,
                numBlocks, jobsPerBlock, tileElems);
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("CdistBackward", acl_call);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("cdist_backward", cdist_backward_npu);
}

} // namespace CdistBackward
} // namespace ops_multimodal_fusion
