/*!
 * \file nested_remove_pad.asc
 * \brief Nested-tensor remove-padding operator for Ascend NPU (dav-3510),
 *        RegBase implementation (UB->UB whole-chunk copy via Reg::LoadAlign
 *        + StoreAlign).
 *
 * Schema:
 *   nested_remove_pad(Tensor padded, Tensor lengths) -> Tensor
 *
 *   padded   : 3-D (B, max_L, D), contiguous, dtype in {fp32, fp16, int32}
 *   lengths  : 1-D (B,) int64, per-batch valid row count L_i in [0, max_L]
 *   out      : 2-D (sum_i L_i, D), same dtype
 *
 *   For each batch i:
 *     out[outOff_i : outOff_i + L_i, :]  =  padded[i, 0:L_i, :]
 *
 *   In row-major layout, padded[i, 0:L_i, :] is a contiguous L_i*D block,
 *   so per-batch transfer is a single contiguous DMA-in -> UB->UB Reg copy
 *   -> DMA-out triple. No strided gather needed.
 *
 * Constraint: D * sizeof(T) % 32 == 0  (DMA / Reg row 32B alignment;
 *   fp32 D%8, fp16 D%16, int32 D%8).
 *
 * 3-layer Reg shape:
 *   Layer 1 vf function:
 *     NestedRemovePadCopyVf<T>  : whole-chunk UB->UB copy
 *                                 (LoadAlign src + StoreAlign dst), modelled
 *                                 after csrc/index_copy/.../IndexCopyAxisCopyVf
 *   Layer 2 __aicore__ wrapper:
 *     NestedRemovePadCopy<T>    : GetPhyAddr cast + asc_vf_call
 *   Layer 3 kernel class:
 *     KernelNestedRemovePad<T>  : per-batch DMA-in to inLocal -> Reg vf
 *                                 copy -> DMA-out from outLocal; meta(B,2)
 *                                 driven per-batch [L_i, outOff_i] via
 *                                 LocalTensor::GetValue.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace NestedRemovePad {

constexpr static int64_t PIPELINE_DEPTH = 2;
constexpr static int64_t SAFETY_BYTES   = 1024;
constexpr static int64_t META_FIELDS    = 2;   // L_i, outOff_i (element offset)

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("nested_remove_pad(Tensor padded, Tensor lengths) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor nested_remove_pad_meta(
    const torch::Tensor &padded, const torch::Tensor &lengths)
{
    TORCH_CHECK(padded.dim() == 3,
                "nested_remove_pad: padded must be 3-D (B, max_L, D), got ",
                padded.dim(), "-D");
    TORCH_CHECK(lengths.dim() == 1,
                "nested_remove_pad: lengths must be 1-D, got ", lengths.dim(), "-D");
    TORCH_CHECK(lengths.size(0) == padded.size(0),
                "nested_remove_pad: lengths.size(0)=", lengths.size(0),
                " must equal padded.size(0)=", padded.size(0));
    TORCH_CHECK(lengths.scalar_type() == torch::kInt64,
                "nested_remove_pad: lengths must be int64, got ", lengths.scalar_type());

    // Compute total output rows from lengths on CPU.
    auto lengths_cpu = lengths.cpu().contiguous();
    const int64_t *p = lengths_cpu.const_data_ptr<int64_t>();
    int64_t sumL = 0;
    const int64_t B = padded.size(0);
    const int64_t maxL = padded.size(1);
    for (int64_t i = 0; i < B; ++i) {
        TORCH_CHECK(p[i] >= 0 && p[i] <= maxL,
                    "nested_remove_pad: lengths[", i, "]=", p[i],
                    " must be in [0, max_L=", maxL, "]");
        sumL += p[i];
    }
    return torch::empty({sumL, padded.size(2)}, padded.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("nested_remove_pad", nested_remove_pad_meta);
}

// ===================== 3. Kernel - 3-layer Reg shape =====================

// --------- Layer 1 vf function ---------
//
// Whole-chunk UB->UB copy. Same pattern as csrc/index_copy/dav-3510
// IndexCopyAxisCopyVf<T>: LoadAlign source RegTensor, StoreAlign destination.
// Mask handles tail elements when elementCount is not a multiple of
// vectorLength. Used to route per-batch padded[i, 0:L_i, :] data from the
// in-queue UB buffer to the out-queue UB buffer before DMA-out.

template <typename T>
__simd_vf__ inline void NestedRemovePadCopyVf(
    __ubuf__ T *srcAddr, __ubuf__ T *dstAddr,
    uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    AscendC::Reg::RegTensor<T> reg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<T>(remaining);
        AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(
            reg, srcAddr + offset);
        AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, reg, mask);
    }
}

// --------- Layer 2 wrapper ---------

template <typename T>
__aicore__ inline void NestedRemovePadCopy(
    AscendC::LocalTensor<T> &src, AscendC::LocalTensor<T> &dst,
    int64_t elementCount)
{
    __ubuf__ T *srcPtr = (__ubuf__ T *)src.GetPhyAddr();
    __ubuf__ T *dstPtr = (__ubuf__ T *)dst.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(T);
    uint32_t elementCountU = static_cast<uint32_t>(elementCount);
    uint32_t chunkCount = (elementCountU + vectorLength - 1) / vectorLength;
    asc_vf_call<NestedRemovePadCopyVf<T>>(srcPtr, dstPtr, elementCountU, chunkCount);
}

// --------- Layer 3 kernel class ---------

template <typename T>
class KernelNestedRemovePad {
public:
    __aicore__ inline KernelNestedRemovePad() {}

    __aicore__ inline void Init(
        GM_ADDR paddedPtr, GM_ADDR outputPtr, GM_ADDR metaPtr,
        int64_t batchSize, int64_t maxL, int64_t D,
        int64_t maxRowsPerBatch, int64_t blockBatchLength)
    {
        paddedGm_.SetGlobalBuffer((__gm__ T *)paddedPtr);
        outputGm_.SetGlobalBuffer((__gm__ T *)outputPtr);
        metaGm_.SetGlobalBuffer((__gm__ int64_t *)metaPtr);
        batchSize_ = batchSize;
        maxL_ = maxL;
        D_    = D;

        int64_t blockStart = blockBatchLength * AscendC::GetBlockIdx();
        int64_t myLength = batchSize - blockStart;
        if (myLength > blockBatchLength) myLength = blockBatchLength;
        if (myLength < 0) myLength = 0;
        blockStart_ = blockStart;
        myLength_   = myLength;

        // chunkBytes = max per-batch L_i * D * T bytes (worst case).
        const uint32_t chunkBytes =
            static_cast<uint32_t>(maxRowsPerBatch * D * sizeof(T));
        const uint32_t metaBytes  =
            static_cast<uint32_t>(batchSize * META_FIELDS * sizeof(int64_t));

        pipe_.InitBuffer(tbufMeta_,    metaBytes);
        pipe_.InitBuffer(inQueueX_,    PIPELINE_DEPTH, chunkBytes);
        pipe_.InitBuffer(outQueueY_,   PIPELINE_DEPTH, chunkBytes);
    }

    __aicore__ inline void Process()
    {
        if (myLength_ <= 0) return;

        // 1. DMA meta into UB (small: B * 2 * 8 bytes).
        AscendC::LocalTensor<int64_t> metaLocal = tbufMeta_.template Get<int64_t>();
        AscendC::DataCopyExtParams cpMeta;
        cpMeta.blockCount = 1;
        cpMeta.blockLen   =
            static_cast<uint32_t>(batchSize_ * META_FIELDS * sizeof(int64_t));
        cpMeta.srcStride = 0; cpMeta.dstStride = 0;
        AscendC::DataCopyPadExtParams<int64_t> padI{false, 0, 0,
                                                    static_cast<int64_t>(0)};
        AscendC::DataCopyPad(metaLocal, metaGm_, cpMeta, padI);
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyPadExtParams<T> padT{false, 0, 0, T{}};

        // 2. Per-batch DMA-in -> Reg vf copy -> DMA-out.
        for (int64_t i = blockStart_; i < blockStart_ + myLength_; ++i) {
            const int64_t L_i      = metaLocal.GetValue(i * META_FIELDS + 0);
            const int64_t outOff_i = metaLocal.GetValue(i * META_FIELDS + 1);
            if (L_i <= 0) continue;
            const int64_t numel  = L_i * D_;
            const uint32_t bytes = static_cast<uint32_t>(numel * sizeof(T));

            // DMA in: padded[i, 0:L_i, :] (contiguous L_i*D elements).
            AscendC::LocalTensor<T> inLocal = inQueueX_.template AllocTensor<T>();
            AscendC::DataCopyExtParams cpIn;
            cpIn.blockCount = 1;
            cpIn.blockLen   = bytes;
            cpIn.srcStride  = 0; cpIn.dstStride = 0;
            AscendC::DataCopyPad(inLocal,
                                 paddedGm_[i * maxL_ * D_],
                                 cpIn, padT);
            inQueueX_.EnQue(inLocal);
            inLocal = inQueueX_.template DeQue<T>();

            // Reg vf UB->UB copy.
            AscendC::LocalTensor<T> outLocal = outQueueY_.template AllocTensor<T>();
            NestedRemovePadCopy<T>(inLocal, outLocal, numel);
            outQueueY_.EnQue(outLocal);
            inQueueX_.FreeTensor(inLocal);

            // DMA out: outLocal -> output[outOff_i : outOff_i + numel].
            outLocal = outQueueY_.template DeQue<T>();
            AscendC::DataCopyExtParams cpOut;
            cpOut.blockCount = 1;
            cpOut.blockLen   = bytes;
            cpOut.srcStride  = 0; cpOut.dstStride = 0;
            AscendC::DataCopyPad(outputGm_[outOff_i], outLocal, cpOut);
            outQueueY_.FreeTensor(outLocal);
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T>       paddedGm_;
    AscendC::GlobalTensor<T>       outputGm_;
    AscendC::GlobalTensor<int64_t> metaGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>             tbufMeta_;
    AscendC::TQue<AscendC::QuePosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    int64_t batchSize_   = 0;
    int64_t maxL_        = 0;
    int64_t D_           = 0;
    int64_t blockStart_  = 0;
    int64_t myLength_    = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void nested_remove_pad_kernel(
    GM_ADDR padded, GM_ADDR output, GM_ADDR meta,
    int64_t batchSize, int64_t maxL, int64_t D,
    int64_t maxRowsPerBatch, int64_t blockBatchLength)
{
    KernelNestedRemovePad<T> op;
    op.Init(padded, output, meta,
            batchSize, maxL, D,
            maxRowsPerBatch, blockBatchLength);
    op.Process();
}

// ===================== 4. NPU dispatch =====================

torch::Tensor nested_remove_pad_npu(
    const torch::Tensor &padded, const torch::Tensor &lengths)
{
    auto dtype = padded.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "nested_remove_pad: only float32 / float16 / int32 supported, got ",
                dtype);
    TORCH_CHECK(padded.dim() == 3,
                "nested_remove_pad: padded must be 3-D (B, max_L, D), got ",
                padded.dim(), "-D");
    TORCH_CHECK(lengths.dim() == 1,
                "nested_remove_pad: lengths must be 1-D, got ", lengths.dim(), "-D");
    TORCH_CHECK(lengths.size(0) == padded.size(0),
                "nested_remove_pad: lengths.size(0)=", lengths.size(0),
                " must equal padded.size(0)=", padded.size(0));
    TORCH_CHECK(lengths.scalar_type() == torch::kInt64,
                "nested_remove_pad: lengths must be int64, got ",
                lengths.scalar_type());

    const int64_t B    = padded.size(0);
    const int64_t maxL = padded.size(1);
    const int64_t D    = padded.size(2);
    TORCH_CHECK(B >= 1, "nested_remove_pad: batch B must be >= 1, got ", B);
    TORCH_CHECK(D >= 1, "nested_remove_pad: D must be >= 1, got ", D);
    TORCH_CHECK(maxL >= 0,
                "nested_remove_pad: max_L must be >= 0, got ", maxL);

    const size_t bytesPerT = (dtype == torch::kFloat16) ? 2u : 4u;
    const int64_t alignElems = 32 / static_cast<int64_t>(bytesPerT);
    TORCH_CHECK(D % alignElems == 0,
                "nested_remove_pad: D=", D,
                " must be a multiple of ", alignElems,
                " (32B / sizeof(", dtype, ")) for Reg::LoadAlign / DMA row alignment");

    // Host-side scan: validate per-batch L_i, build meta = [L_i, outOff_i].
    auto lengths_cpu = lengths.cpu().contiguous();
    const int64_t *p = lengths_cpu.const_data_ptr<int64_t>();
    int64_t sumL = 0;
    int64_t maxRowsPerBatch = 0;

    auto meta_cpu = torch::empty({B, META_FIELDS}, lengths.options().device(torch::kCPU));
    int64_t *q = meta_cpu.data_ptr<int64_t>();

    for (int64_t i = 0; i < B; ++i) {
        int64_t L_i = p[i];
        TORCH_CHECK(L_i >= 0 && L_i <= maxL,
                    "nested_remove_pad: lengths[", i, "]=", L_i,
                    " must be in [0, max_L=", maxL, "]");
        q[i * META_FIELDS + 0] = L_i;
        q[i * META_FIELDS + 1] = sumL * D;   // element offset into output
        sumL += L_i;
        maxRowsPerBatch = std::max(maxRowsPerBatch, L_i);
    }

    // UB capacity check (2 queues x pipeline + meta).
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "nested_remove_pad: coreNum must be positive");

    int64_t chunkBytes = maxRowsPerBatch * D * static_cast<int64_t>(bytesPerT);
    int64_t metaBytes  = B * META_FIELDS * static_cast<int64_t>(sizeof(int64_t));
    int64_t needUb = 2 * PIPELINE_DEPTH * chunkBytes + metaBytes + SAFETY_BYTES;
    TORCH_CHECK(needUb <= static_cast<int64_t>(ubSize),
                "nested_remove_pad: UB need ", needUb,
                " exceeds UB capacity ", ubSize,
                " (max(L_i)=", maxRowsPerBatch, ", D=", D,
                ", bytes_per_elem=", bytesPerT, ")");

    int64_t numBlocks = std::min(coreNum, B);
    if (numBlocks < 1) numBlocks = 1;
    int64_t blockBatchLength = (B + numBlocks - 1) / numBlocks;

    auto padded_c = padded.contiguous();
    auto out      = torch::empty({sumL, D}, padded_c.options());

    // Short-circuit: nothing to copy.
    if (sumL == 0) return out;

    const c10::OptionalDeviceGuard guard(padded.device());
    auto meta_npu = meta_cpu.to(padded.device(), /*non_blocking=*/false);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto paddedPtr = (GM_ADDR)padded_c.data_ptr();
    auto outPtr    = (GM_ADDR)out.data_ptr();
    auto metaPtr   = (GM_ADDR)meta_npu.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            padded_c.scalar_type(), "nested_remove_pad_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                nested_remove_pad_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    paddedPtr, outPtr, metaPtr,
                    B, maxL, D,
                    maxRowsPerBatch, blockBatchLength);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                nested_remove_pad_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    paddedPtr, outPtr, metaPtr,
                    B, maxL, D,
                    maxRowsPerBatch, blockBatchLength);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                nested_remove_pad_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    paddedPtr, outPtr, metaPtr,
                    B, maxL, D,
                    maxRowsPerBatch, blockBatchLength);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("NestedRemovePad", acl_call);

    return out;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("nested_remove_pad", nested_remove_pad_npu);
}

} // namespace NestedRemovePad
} // namespace ops_multimodal_fusion
