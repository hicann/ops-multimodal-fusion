/*!
 * \file max_unpool3d.asc
 * \brief MaxUnpool3d forward operator for Ascend NPU (arch35), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.max_unpool3d(input, indices, kernel_size,
 *                                   stride=[], padding=[], output_size=[])
 *     -> output
 *
 * input   : [C, D, H, W] or [N, C, D, H, W], fp16/fp32 pooled values
 * indices : same shape as input, int64 flattened offsets in each output spatial slice
 * output  : same rank and dtype as input; all positions zero-filled before scatter
 *
 * Implementation shape:
 *   Layer 1 __simd_vf__: Reg::Duplicate + StoreAlign zero-fill tile helper.
 *   Layer 2 __aicore__ wrapper: LocalTensor.GetPhyAddr -> __ubuf__ and asc_vf_call.
 *   Layer 3 kernel class: per (N,C) slice zero-fill, then scalar index-driven scatter.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <array>
#include <tuple>
#include <type_traits>
#include <vector>

namespace ops_multimodal_fusion {
namespace MaxUnpool3d {

static constexpr int64_t kBlockBytes = 32;
static constexpr int64_t kSafetyBytes = 512;
static constexpr int64_t kDav3510VectorRegBytes = 256;

static int64_t align_up(int64_t value, int64_t align)
{
    return ((value + align - 1) / align) * align;
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("max_unpool3d(Tensor input, Tensor indices, int[] kernel_size, "
          "int[] stride=[], int[] padding=[], int[] output_size=[]) -> Tensor");
}

struct Unpool3dParams {
    std::array<int64_t, 3> kernel;
    std::array<int64_t, 3> stride;
    std::array<int64_t, 3> padding;
    std::array<int64_t, 3> output;
};

static std::array<int64_t, 3> parse_triple(
    at::IntArrayRef ref, const char *name, bool allowEmpty,
    const std::array<int64_t, 3> &emptyValue)
{
    if (ref.empty() && allowEmpty) {
        return emptyValue;
    }
    if (ref.size() == 1) {
        return {ref[0], ref[0], ref[0]};
    }
    TORCH_CHECK(ref.size() == 3,
                "max_unpool3d: ", name,
                " must be an int or contain exactly three integers, got ",
                ref.size(), " values");
    return {ref[0], ref[1], ref[2]};
}

static Unpool3dParams parse_params(
    const torch::Tensor &input, at::IntArrayRef kernelSize,
    at::IntArrayRef strideRef, at::IntArrayRef paddingRef,
    at::IntArrayRef outputSize)
{
    Unpool3dParams p;
    p.kernel = parse_triple(kernelSize, "kernel_size", false, {0, 0, 0});
    for (int i = 0; i < 3; ++i) {
        TORCH_CHECK(p.kernel[i] > 0,
                    "max_unpool3d: kernel_size entries must be positive");
    }

    p.stride = parse_triple(strideRef, "stride", true, p.kernel);
    for (int i = 0; i < 3; ++i) {
        TORCH_CHECK(p.stride[i] > 0,
                    "max_unpool3d: stride entries must be positive");
    }

    p.padding = parse_triple(paddingRef, "padding", true, {0, 0, 0});
    for (int i = 0; i < 3; ++i) {
        TORCH_CHECK(p.padding[i] >= 0,
                    "max_unpool3d: padding entries must be non-negative");
    }

    std::array<int64_t, 3> inSpatial = {
        input.size(input.dim() - 3),
        input.size(input.dim() - 2),
        input.size(input.dim() - 1)};
    std::array<int64_t, 3> defaultOutput;
    for (int i = 0; i < 3; ++i) {
        defaultOutput[i] =
            (inSpatial[i] - 1) * p.stride[i] - 2 * p.padding[i] + p.kernel[i];
        TORCH_CHECK(defaultOutput[i] > 0,
                    "max_unpool3d: inferred output_size must be positive");
    }

    if (outputSize.empty()) {
        p.output = defaultOutput;
    } else {
        int64_t spatialStart = 0;
        if (outputSize.size() == 3) {
            spatialStart = 0;
        } else if (outputSize.size() == 5) {
            spatialStart = 2;
        } else {
            TORCH_CHECK(false,
                        "max_unpool3d: output_size must contain 3 spatial dims "
                        "or 5 full output dims, got ", outputSize.size(),
                        " values");
        }
        p.output = {
            outputSize[spatialStart],
            outputSize[spatialStart + 1],
            outputSize[spatialStart + 2]};
        for (int i = 0; i < 3; ++i) {
            int64_t minSize = defaultOutput[i] - p.stride[i];
            int64_t maxSize = defaultOutput[i] + p.stride[i];
            TORCH_CHECK(p.output[i] > minSize && p.output[i] < maxSize,
                        "max_unpool3d: invalid output_size[", i, "]=", p.output[i],
                        " for default size ", defaultOutput[i],
                        " and stride ", p.stride[i],
                        " (valid range is (", minSize, ", ", maxSize, "))");
        }
    }
    return p;
}

static void check_common(
    const torch::Tensor &input, const torch::Tensor &indices,
    at::IntArrayRef kernelSize, at::IntArrayRef strideRef,
    at::IntArrayRef paddingRef, at::IntArrayRef outputSize)
{
    TORCH_CHECK(input.dim() == 4 || input.dim() == 5,
                "max_unpool3d: expected 4-D or 5-D input, got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "max_unpool3d: expected Half or Float input on arch35 Reg path, got ",
                input.scalar_type());
    TORCH_CHECK(indices.scalar_type() == torch::kInt64,
                "max_unpool3d: indices must be int64, got ",
                indices.scalar_type());
    TORCH_CHECK(indices.sizes() == input.sizes(),
                "max_unpool3d: indices must have the same shape as input");
    int64_t N = (input.dim() == 5) ? input.size(0) : 1;
    int64_t C = (input.dim() == 5) ? input.size(1) : input.size(0);
    int64_t inD = input.size(input.dim() - 3);
    int64_t inH = input.size(input.dim() - 2);
    int64_t inW = input.size(input.dim() - 1);
    if (N == 0 || C == 0) {
        (void)parse_params(input, kernelSize, strideRef, paddingRef, outputSize);
        return;
    }
    TORCH_CHECK(inD > 0 && inH > 0 && inW > 0,
                "max_unpool3d: input spatial dimensions must be non-empty");
    (void)parse_params(input, kernelSize, strideRef, paddingRef, outputSize);
}

torch::Tensor max_unpool3d_meta(
    const torch::Tensor &input, const torch::Tensor &indices,
    at::IntArrayRef kernelSize, at::IntArrayRef strideRef,
    at::IntArrayRef paddingRef, at::IntArrayRef outputSize)
{
    check_common(input, indices, kernelSize, strideRef, paddingRef, outputSize);
    Unpool3dParams p =
        parse_params(input, kernelSize, strideRef, paddingRef, outputSize);
    if (input.dim() == 4) {
        return torch::empty(
            {input.size(0), p.output[0], p.output[1], p.output[2]},
            input.options());
    }
    return torch::empty(
        {input.size(0), input.size(1), p.output[0], p.output[1], p.output[2]},
        input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("max_unpool3d", max_unpool3d_meta);
}

static std::tuple<int64_t, int64_t, uint32_t> calc_tiling_params(
    int64_t nc, int64_t outSpatial, size_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "max_unpool3d: coreNum must be positive");

    int64_t vectorElems = kDav3510VectorRegBytes / static_cast<int64_t>(sizeof(float));
    int64_t maxTileElems =
        (static_cast<int64_t>(ubSize) - kSafetyBytes - 2 * kBlockBytes) /
        static_cast<int64_t>(elemSize);
    maxTileElems = (maxTileElems / vectorElems) * vectorElems;
    TORCH_CHECK(maxTileElems >= vectorElems,
                "max_unpool3d: UB capacity is insufficient for zero-fill tile");
    uint32_t zeroTileElems = static_cast<uint32_t>(
        std::min<int64_t>(align_up(outSpatial, vectorElems), maxTileElems));
    int64_t numBlocks = std::max<int64_t>(1, std::min<int64_t>(nc, coreNum));
    int64_t blockSliceLength = (nc + numBlocks - 1) / numBlocks;
    return std::make_tuple(numBlocks, blockSliceLength, zeroTileElems);
}

__simd_vf__ inline void MaxUnpool3dZeroFillFloatVf(
    __ubuf__ float *dstAddr, uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> zeroReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            zeroReg, 0.0f, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            dstAddr + offset, zeroReg, mask);
    }
}

__simd_vf__ inline void MaxUnpool3dZeroFillHalfVf(
    __ubuf__ half *dstAddr, uint32_t elementCount, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> zeroFloatReg;
    AscendC::Reg::RegTensor<half> zeroHalfReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = elementCount - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            zeroFloatReg, 0.0f, mask);
        AscendC::Reg::Cast<half, float, castToHalf>(zeroHalfReg, zeroFloatReg, mask);
        AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
            dstAddr + offset, zeroHalfReg, mask);
    }
}

template <typename T>
__aicore__ inline void MaxUnpool3dZeroFill(
    AscendC::LocalTensor<T> local, uint32_t elementCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    if constexpr (std::is_same<T, half>::value) {
        asc_vf_call<MaxUnpool3dZeroFillHalfVf>(
            (__ubuf__ half *)local.GetPhyAddr(), elementCount, chunkCount);
    } else {
        asc_vf_call<MaxUnpool3dZeroFillFloatVf>(
            (__ubuf__ float *)local.GetPhyAddr(), elementCount, chunkCount);
    }
}

template <typename T>
class KernelMaxUnpool3d {
public:
    __aicore__ inline KernelMaxUnpool3d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR indices, GM_ADDR output,
        int64_t NC, int64_t inSpatial, int64_t outSpatial,
        int64_t blockSliceLength, uint32_t zeroTileElems)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        indicesGm_.SetGlobalBuffer((__gm__ int64_t *)indices);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        NC_ = NC;
        inSpatial_ = inSpatial;
        outSpatial_ = outSpatial;
        blockSliceLength_ = blockSliceLength;
        zeroTileElems_ = zeroTileElems;

        uint32_t zeroBytes = static_cast<uint32_t>(
            zeroTileElems_ * static_cast<uint32_t>(sizeof(T)));
        pipe_.InitBuffer(tbufZero_, zeroBytes);
        pipe_.InitBuffer(tbufValue_, static_cast<uint32_t>(kBlockBytes));
        pipe_.InitBuffer(tbufIndex_, static_cast<uint32_t>(kBlockBytes));
    }

    __aicore__ inline void Process()
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t start = blockIdx * blockSliceLength_;
        int64_t end = start + blockSliceLength_;
        if (end > NC_) {
            end = NC_;
        }
        for (int64_t slice = start; slice < end; ++slice) {
            ZeroOutputSlice(slice);
            ScatterSlice(slice);
        }
    }

private:
    __aicore__ inline void ZeroOutputSlice(int64_t slice)
    {
        AscendC::LocalTensor<T> zeroLocal = tbufZero_.template Get<T>();
        int64_t base = slice * outSpatial_;
        int64_t remaining = outSpatial_;
        int64_t offset = 0;
        while (remaining > 0) {
            uint32_t count = static_cast<uint32_t>(
                remaining < static_cast<int64_t>(zeroTileElems_) ?
                remaining : static_cast<int64_t>(zeroTileElems_));
            MaxUnpool3dZeroFill<T>(zeroLocal, count);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyExtParams copyOut;
            copyOut.blockCount = 1;
            copyOut.blockLen = static_cast<uint32_t>(count * sizeof(T));
            copyOut.srcStride = 0;
            copyOut.dstStride = 0;
            AscendC::DataCopyPad(outputGm_[base + offset], zeroLocal, copyOut);
            remaining -= count;
            offset += count;
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void ScatterSlice(int64_t slice)
    {
        AscendC::LocalTensor<T> valueLocal = tbufValue_.template Get<T>();
        AscendC::LocalTensor<int64_t> indexLocal = tbufIndex_.template Get<int64_t>();
        AscendC::DataCopyExtParams copyValue;
        copyValue.blockCount = 1;
        copyValue.blockLen = static_cast<uint32_t>(sizeof(T));
        copyValue.srcStride = 0;
        copyValue.dstStride = 0;
        AscendC::DataCopyExtParams copyIndex;
        copyIndex.blockCount = 1;
        copyIndex.blockLen = static_cast<uint32_t>(sizeof(int64_t));
        copyIndex.srcStride = 0;
        copyIndex.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padValue{false, 0, 0, T{}};
        AscendC::DataCopyPadExtParams<int64_t> padIndex{
            false, 0, 0, static_cast<int64_t>(0)};

        int64_t inBase = slice * inSpatial_;
        int64_t outBase = slice * outSpatial_;
        for (int64_t i = 0; i < inSpatial_; ++i) {
            AscendC::DataCopyPad(
                valueLocal, inputGm_[inBase + i], copyValue, padValue);
            AscendC::DataCopyPad(
                indexLocal, indicesGm_[inBase + i], copyIndex, padIndex);
            AscendC::PipeBarrier<PIPE_ALL>();
            int64_t idx = indexLocal.GetValue(0);
            AscendC::DataCopyPad(outputGm_[outBase + idx], valueLocal, copyValue);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<int64_t> indicesGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufZero_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufValue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufIndex_;
    int64_t NC_ = 0;
    int64_t inSpatial_ = 0;
    int64_t outSpatial_ = 0;
    int64_t blockSliceLength_ = 0;
    uint32_t zeroTileElems_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void max_unpool3d_kernel(
    GM_ADDR input, GM_ADDR indices, GM_ADDR output,
    int64_t NC, int64_t inSpatial, int64_t outSpatial,
    int64_t blockSliceLength, uint32_t zeroTileElems)
{
    KernelMaxUnpool3d<T> op;
    op.Init(input, indices, output, NC, inSpatial, outSpatial,
            blockSliceLength, zeroTileElems);
    op.Process();
}

torch::Tensor max_unpool3d_npu(
    const torch::Tensor &input, const torch::Tensor &indices,
    at::IntArrayRef kernelSize, at::IntArrayRef strideRef,
    at::IntArrayRef paddingRef, at::IntArrayRef outputSize)
{
    check_common(input, indices, kernelSize, strideRef, paddingRef, outputSize);
    Unpool3dParams p =
        parse_params(input, kernelSize, strideRef, paddingRef, outputSize);
    const c10::OptionalDeviceGuard guard(input.device());

    torch::Tensor inputC = input.contiguous();
    torch::Tensor indicesC = indices.contiguous();

    bool is5D = (input.dim() == 5);
    int64_t N = is5D ? inputC.size(0) : 1;
    int64_t C = is5D ? inputC.size(1) : inputC.size(0);
    int64_t inD = inputC.size(inputC.dim() - 3);
    int64_t inH = inputC.size(inputC.dim() - 2);
    int64_t inW = inputC.size(inputC.dim() - 1);
    int64_t inSpatial = inD * inH * inW;
    int64_t outSpatial = p.output[0] * p.output[1] * p.output[2];

    std::vector<int64_t> outShape;
    if (is5D) {
        outShape = {N, C, p.output[0], p.output[1], p.output[2]};
    } else {
        outShape = {C, p.output[0], p.output[1], p.output[2]};
    }
    torch::Tensor output = torch::empty(outShape, inputC.options());

    int64_t NC = N * C;
    if (NC == 0 || inputC.numel() == 0) {
        return output;
    }

    auto indicesCpu = indicesC.cpu();
    int64_t minIndex = indicesCpu.min().item<int64_t>();
    int64_t maxIndex = indicesCpu.max().item<int64_t>();
    TORCH_CHECK(minIndex >= 0,
                "max_unpool3d: found negative index ", minIndex);
    TORCH_CHECK(maxIndex < outSpatial,
                "max_unpool3d: found index ", maxIndex,
                " outside output spatial size ", outSpatial);

    int64_t numBlocks = 1;
    int64_t blockSliceLength = 1;
    uint32_t zeroTileElems = 0;
    std::tie(numBlocks, blockSliceLength, zeroTileElems) =
        calc_tiling_params(NC, outSpatial, inputC.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto indexPtr = (GM_ADDR)indicesC.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    auto aclCall = [=]() -> int {
        AT_DISPATCH_SWITCH(
            inputC.scalar_type(), "max_unpool3d_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                max_unpool3d_kernel<float><<<numBlocks, nullptr, stream>>>(
                    inputPtr, indexPtr, outputPtr, NC, inSpatial, outSpatial,
                    blockSliceLength, zeroTileElems);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                max_unpool3d_kernel<half><<<numBlocks, nullptr, stream>>>(
                    inputPtr, indexPtr, outputPtr, NC, inSpatial, outSpatial,
                    blockSliceLength, zeroTileElems);
            }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("MaxUnpool3dReg", aclCall);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("max_unpool3d", max_unpool3d_npu);
}

} // namespace MaxUnpool3d
} // namespace ops_multimodal_fusion
