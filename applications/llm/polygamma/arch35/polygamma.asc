/*!
 * \file polygamma.asc
 * \brief Polygamma operator psi^(n)(x) for Ascend NPU (dav-3510)
 *
 * torch.special.polygamma(n, input) -- the n-th derivative of digamma.
 *
 * Scope: float32, x > 0, integer order n in [1, 6]. (n = 0 is torch.digamma.)
 *
 * Algorithm (shift-and-asymptotic, branchless):
 *   Let N = 8. By the recurrence  psi^(n)(x) = psi^(n)(x + 1) - (-1)^n n! / x^(n+1):
 *     psi^(n)(x) = psi^(n)(x + N) + (-1)^(n+1) n! * sum_{k=0..N-1} 1/(x+k)^(n+1)
 *   For x' = x + N >= 8 the Bernoulli asymptotic expansion is accurate well below
 *   float32 eps for every n in the supported range:
 *     psi^(n)(x') ~ (-1)^(n-1) * [ (n-1)!/x'^n + n!/(2 x'^(n+1))
 *        + sum_{k>=1} B_{2k} (2k+n-1)! / ((2k)! x'^(2k+n)) ]
 *   With inv_x = 1/x' and u = inv_x^2 the polynomial factor is evaluated as
 *     poly = (n-1)! + inv_x * ( n!/2 + inv_x * (c1 + u*(c2 + u*(c3 + u*c4))) )
 *     asymp = inv_x^n * poly
 *   Final:
 *     psi^(n)(x) = (-1)^(n+1) * (asymp + n! * recur_sum)
 *
 * Coefficients c_k = B_{2k} * (2k+n-1)! / (2k)! are precomputed on the host.
 * For x <= 0 the formula is NOT the analytic continuation of polygamma
 * (no reflection is applied on dav-3510).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <array>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Polygamma {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("polygamma(Tensor x, int n) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor polygamma_meta(const torch::Tensor &x, int64_t n)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32,
                "polygamma: only float32 is supported on dav-3510, got ", x.scalar_type());
    TORCH_CHECK(n >= 1 && n <= 6,
                "polygamma: only order n in [1, 6] is supported on dav-3510, got n=", n,
                " (use torch.digamma for n=0)");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("polygamma", polygamma_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 2 queues (VECIN x + VECOUT y) each double-buffered, plus 4 scratch TBufs.
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 2 + 4; // = 8
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // align to 32 bytes
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// ===================== 4. Kernel =====================

template <typename T>
class KernelPolygamma {
public:
    __aicore__ inline KernelPolygamma() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize,
        int32_t nOrder, T sign, T factorialN, T factorialNm1, T halfNFact,
        T c1, T c2, T c3, T c4)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueX_,  PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tbufXp_,    tileSize);  // x+k, x', then q = inv_x^n (for n>=3)
        pipe_.InitBuffer(tbufInv_,   tileSize);  // 1/(x+k)^(n+1), then 1/x'
        pipe_.InitBuffer(tbufSum_,   tileSize);  // running reciprocal-power sum
        pipe_.InitBuffer(tbufOnes_,  tileSize);  // 1.0 constant, later u = 1/x'^2

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        if (currentBlockLength < 0) {
            currentBlockLength = 0;
        }
        elementNumPerTile_ = tileSize / sizeof(T);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;

        nOrder_       = nOrder;
        sign_         = sign;
        factorialN_   = factorialN;
        factorialNm1_ = factorialNm1;
        halfNFact_    = halfNFact;
        c1_ = c1; c2_ = c2; c3_ = c3; c4_ = c4;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    static constexpr int64_t SHIFT_N = 8; // recurrence shifts, matches digamma

    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY_.AllocTensor<T>();
        auto bufXp   = tbufXp_.Get<T>();
        auto bufInv  = tbufInv_.Get<T>();
        auto bufSum  = tbufSum_.Get<T>();
        auto bufOnes = tbufOnes_.Get<T>();

        // ---- Init running accumulators ----
        AscendC::Duplicate(bufSum,  (T)0.0f, count);
        AscendC::Duplicate(bufOnes, (T)1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ---- Phase 1: recurrence sum  S = sum_{k=0..N-1} 1 / (x + k)^(n+1) ----
        // bufXp dual-roles: holds (x+k), then overwritten with the power accumulator.
        for (int64_t k = 0; k < SHIFT_N; ++k) {
            AscendC::Adds(bufXp, xLocal, (T)((float)k), count);               // x + k
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(bufInv, bufOnes, bufXp, count);                      // 1/(x+k)
            AscendC::PipeBarrier<PIPE_V>();

            // bufXp <- 1/(x+k)^2 (x+k no longer needed for this k)
            AscendC::Mul(bufXp, bufInv, bufInv, count);
            AscendC::PipeBarrier<PIPE_V>();
            // Multiply in bufInv an additional (n - 1) times to reach 1/(x+k)^(n+1).
            for (int32_t m = 0; m < nOrder_ - 1; ++m) {
                AscendC::Mul(bufXp, bufXp, bufInv, count);
                AscendC::PipeBarrier<PIPE_V>();
            }

            AscendC::Add(bufSum, bufSum, bufXp, count);                       // S += term
            AscendC::PipeBarrier<PIPE_V>();
        }

        // ---- Phase 2: asymptotic expansion at x' = x + N ----
        AscendC::Adds(bufXp, xLocal, (T)((float)SHIFT_N), count);             // bufXp = x'
        AscendC::PipeBarrier<PIPE_V>();
        inQueueX_.FreeTensor(xLocal);

        AscendC::Div(bufInv, bufOnes, bufXp, count);                          // bufInv = 1/x'
        AscendC::PipeBarrier<PIPE_V>();

        // u = 1/x'^2. Overwrite bufOnes (the 1.0 constant is no longer needed).
        AscendC::Mul(bufOnes, bufInv, bufInv, count);
        AscendC::PipeBarrier<PIPE_V>();

        // q = inv_x^n.  For n >= 3 we build it in bufXp (x' itself is no longer used).
        //   n == 1 -> q lives in bufInv
        //   n == 2 -> q == u,  lives in bufOnes
        //   n >= 3 -> q starts at inv_x^3 = u * inv_x, then multiplied by inv_x as needed.
        if (nOrder_ >= 3) {
            AscendC::Mul(bufXp, bufOnes, bufInv, count);                      // inv_x^3
            AscendC::PipeBarrier<PIPE_V>();
            for (int32_t m = 0; m < nOrder_ - 3; ++m) {
                AscendC::Mul(bufXp, bufXp, bufInv, count);
                AscendC::PipeBarrier<PIPE_V>();
            }
        }

        // Horner on u for  T = c1 + u*(c2 + u*(c3 + u*c4)).  Accumulator lives in yLocal.
        AscendC::Duplicate(yLocal, c4_, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(yLocal, yLocal, bufOnes, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(yLocal, yLocal, c3_, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(yLocal, yLocal, bufOnes, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(yLocal, yLocal, c2_, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(yLocal, yLocal, bufOnes, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(yLocal, yLocal, c1_, count);                            // yLocal = T
        AscendC::PipeBarrier<PIPE_V>();

        // inner = T * inv_x + n!/2
        AscendC::Mul(yLocal, yLocal, bufInv, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(yLocal, yLocal, halfNFact_, count);
        AscendC::PipeBarrier<PIPE_V>();

        // poly = inner * inv_x + (n-1)!
        AscendC::Mul(yLocal, yLocal, bufInv, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(yLocal, yLocal, factorialNm1_, count);
        AscendC::PipeBarrier<PIPE_V>();

        // asymp = q * poly  (q location depends on n)
        if (nOrder_ == 1) {
            AscendC::Mul(yLocal, yLocal, bufInv, count);
        } else if (nOrder_ == 2) {
            AscendC::Mul(yLocal, yLocal, bufOnes, count);
        } else {
            AscendC::Mul(yLocal, yLocal, bufXp, count);
        }
        AscendC::PipeBarrier<PIPE_V>();

        // bufSum := n! * S
        AscendC::Muls(bufSum, bufSum, factorialN_, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal = sign * (asymp + n! * S)
        AscendC::Add(yLocal, yLocal, bufSum, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(yLocal, yLocal, sign_, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY_.DeQue<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufXp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInv_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOnes_;
    int64_t elementNumPerTile_    = 0;
    int64_t tileNum_              = 0;
    int64_t tailTileElementNum_   = 0;
    int32_t nOrder_               = 0;
    T sign_         = (T)1.0f;
    T factorialN_   = (T)1.0f;
    T factorialNm1_ = (T)1.0f;
    T halfNFact_    = (T)0.5f;
    T c1_ = (T)0.0f;
    T c2_ = (T)0.0f;
    T c3_ = (T)0.0f;
    T c4_ = (T)0.0f;
};

template <typename T>
__global__ __aicore__ __vector__ void polygamma_kernel(
    GM_ADDR x, GM_ADDR y,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize,
    int32_t nOrder,
    T sign, T factorialN, T factorialNm1, T halfNFact,
    T c1, T c2, T c3, T c4)
{
    KernelPolygamma<T> op;
    op.Init(x, y, totalLength, blockLength, tileSize,
            nOrder, sign, factorialN, factorialNm1, halfNFact, c1, c2, c3, c4);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

// Precomputed, in host float64 for accuracy, then down-cast to float32 for the kernel.
// Returns (sign, n!, (n-1)!, n!/2, c1, c2, c3, c4) where
//   sign = (-1)^(n+1)
//   c_k  = B_{2k} * (2k + n - 1)! / (2k)!   for k = 1..4
// Uses B_2 = 1/6, B_4 = -1/30, B_6 = 1/42, B_8 = -1/30.
static std::array<float, 8> polygamma_coefficients(int64_t n)
{
    // (n+7)! for n=6 is 13!, so we need factorials up to 13.
    double fact[14];
    fact[0] = 1.0;
    for (int i = 1; i < 14; ++i) {
        fact[i] = fact[i - 1] * i;
    }

    const double sign         = (n % 2 == 0) ? -1.0 : 1.0; // (-1)^(n+1)
    const double factorial_n  = fact[n];
    const double factorial_m1 = fact[n - 1];
    const double half_n_fact  = 0.5 * factorial_n;

    const double c1 =  fact[n + 1] / 12.0;        //  B_2 * (n+1)! / 2!
    const double c2 = -fact[n + 3] / 720.0;       //  B_4 * (n+3)! / 4!
    const double c3 =  fact[n + 5] / 30240.0;     //  B_6 * (n+5)! / 6!
    const double c4 = -fact[n + 7] / 1209600.0;   //  B_8 * (n+7)! / 8!

    return { static_cast<float>(sign),
             static_cast<float>(factorial_n),
             static_cast<float>(factorial_m1),
             static_cast<float>(half_n_fact),
             static_cast<float>(c1),
             static_cast<float>(c2),
             static_cast<float>(c3),
             static_cast<float>(c4) };
}

torch::Tensor polygamma_npu(const torch::Tensor &input, int64_t n)
{
    TORCH_CHECK(input.scalar_type() == torch::kFloat32,
                "polygamma: only float32 is supported on dav-3510, got ", input.scalar_type());
    TORCH_CHECK(n >= 1 && n <= 6,
                "polygamma: only order n in [1, 6] is supported on dav-3510, got n=", n,
                " (use torch.digamma for n=0)");

    const c10::OptionalDeviceGuard guard(input.device());
    auto x = input.contiguous();
    auto y = torch::empty_like(x);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int64_t totalLength = x.numel();
    if (totalLength == 0) {
        return y;
    }
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    const auto coefs = polygamma_coefficients(n);
    const int32_t nOrder = static_cast<int32_t>(n);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "polygamma_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                polygamma_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileSize,
                    nOrder,
                    coefs[0], coefs[1], coefs[2], coefs[3],
                    coefs[4], coefs[5], coefs[6], coefs[7]);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Polygamma", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("polygamma", polygamma_npu);
}

} // namespace Polygamma
} // namespace ops_multimodal_fusion
