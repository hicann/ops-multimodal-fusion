/*!
 * \file max.asc
 * \brief Max (reduction) operator with indices for Ascend NPU
 *
 * max_dim(x, dim, keepdim) -> (values, indices)
 *   values = max values along specified dimension
 *   indices = argmax indices (first occurrence) along specified dimension
 *
 * Two-pass approach per tile:
 *   Pass 1: forward scan to find max values via element-wise Max
 *   Pass 2: backward scan to find first matching index via Exp-based mask
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Max {

// 1. Register the operator's schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("max_dim(Tensor x, int dim, bool keepdim) -> (Tensor values, Tensor indices)");
}

// 2. Meta function: shape/dtype inference without computation
std::tuple<torch::Tensor, torch::Tensor> max_dim_meta(const torch::Tensor &x, int64_t dim, bool keepdim)
{
    int64_t ndim = x.dim();
    TORCH_CHECK(ndim > 0, "max_dim requires at least 1 dimension");
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");

    auto sizes = x.sizes().vec();
    if (keepdim) {
        sizes[dim] = 1;
    } else {
        sizes.erase(sizes.begin() + dim);
    }
    auto values = torch::empty(sizes, x.options());
    auto indices = torch::empty(sizes, x.options().dtype(torch::kInt64));
    return std::make_tuple(values, indices);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("max_dim", max_dim_meta);
}

// 3. Tiling parameter calculation
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t outerSize)
{
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 1 VECIN queue + 3 VECOUT queues (values, indices, scratch)
    constexpr static int64_t BUFFER_NUM = 4;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, outerSize);
    if (numBlocks <= 0) numBlocks = 1;
    int64_t blockLength = (outerSize + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / PIPELINE_DEPTH / BUFFER_NUM;
    tileSize = (tileSize / 32) * 32;
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// 4. Kernel implementation
//
// Layout: input is viewed as outerSize x dimSize x innerSize (contiguous).
// Each core handles a block of outer indices. For each outer index, we
// find the max value and its first-occurrence index along dimSize,
// producing innerSize output values and innerSize output indices.
// Inner dimension is processed in tiles for large innerSize.
//
// Index tracking uses an Exp-based soft mask:
//   mask = exp(-1e10 * |slice - maxVal|)
// which is ~1 where slice == maxVal and ~0 elsewhere.
// Backward iteration ensures the first occurrence index is retained.
template <typename T>
class KernelMax {
public:
    __aicore__ inline KernelMax() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR values, GM_ADDR indices,
        int64_t outerSize, int64_t blockOuter, uint32_t tileSize,
        int64_t dimSize, int64_t innerSize)
    {
        xGm_.SetGlobalBuffer((__gm__ T *)x);
        valGm_.SetGlobalBuffer((__gm__ T *)values);
        idxGm_.SetGlobalBuffer((__gm__ T *)indices);

        int64_t outerStart = blockOuter * AscendC::GetBlockIdx();
        currentBlockOuter_ = outerSize - outerStart;
        if (currentBlockOuter_ > blockOuter) currentBlockOuter_ = blockOuter;
        outerStart_ = outerStart;
        dimSize_ = dimSize;
        innerSize_ = innerSize;
        elementNumPerTile_ = tileSize / sizeof(T);

        pipe_.InitBuffer(inQueue_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(valQueue_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(idxQueue_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tmpQueue_, PIPELINE_DEPTH, tileSize);
    }

    __aicore__ inline void Process()
    {
        for (int64_t o = 0; o < currentBlockOuter_; ++o) {
            ProcessOuter(outerStart_ + o);
        }
    }

private:
    __aicore__ inline void ProcessOuter(int64_t outerIdx)
    {
        int64_t innerRemaining = innerSize_;
        int64_t innerOffset = 0;
        while (innerRemaining > 0) {
            int64_t tileCount = innerRemaining;
            if (tileCount > elementNumPerTile_) tileCount = elementNumPerTile_;
            ProcessTile(outerIdx, innerOffset, tileCount);
            innerOffset += tileCount;
            innerRemaining -= tileCount;
        }
    }

    __aicore__ inline AscendC::LocalTensor<T> LoadSlice(int64_t outerIdx, int64_t dimIdx,
        int64_t innerOffset, int64_t count)
    {
        int64_t srcOffset = outerIdx * dimSize_ * innerSize_ + dimIdx * innerSize_ + innerOffset;
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(T);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<T> xLocal = inQueue_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[srcOffset], copyParams, padParams);
        inQueue_.EnQue(xLocal);
        return inQueue_.DeQue<T>();
    }

    __aicore__ inline void ProcessTile(int64_t outerIdx, int64_t innerOffset, int64_t count)
    {
        AscendC::LocalTensor<T> valLocal = valQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> idxLocal = idxQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> tmpLocal = tmpQueue_.AllocTensor<T>();

        // ===== Pass 1: Find max values (forward scan) =====
        // Initialize from first dim slice
        {
            auto xLocal = LoadSlice(outerIdx, 0, innerOffset, count);
            AscendC::Muls(valLocal, xLocal, (T)1, count);
            AscendC::PipeBarrier<PIPE_V>();
            inQueue_.FreeTensor(xLocal);
        }

        for (int64_t d = 1; d < dimSize_; ++d) {
            auto xLocal = LoadSlice(outerIdx, d, innerOffset, count);
            AscendC::Max(valLocal, valLocal, xLocal, count);
            AscendC::PipeBarrier<PIPE_V>();
            inQueue_.FreeTensor(xLocal);
        }

        // ===== Pass 2: Find first matching index (backward scan) =====
        // Initialize all indices to dimSize-1; backward iteration will
        // overwrite with smaller indices, leaving the first occurrence.
        AscendC::Duplicate(idxLocal, (T)(dimSize_ - 1), count);
        AscendC::PipeBarrier<PIPE_V>();

        for (int64_t d = dimSize_ - 1; d >= 0; --d) {
            auto xLocal = LoadSlice(outerIdx, d, innerOffset, count);

            // Compute soft equality mask:
            //   mask = exp(-1e10 * |slice - maxVal|)
            //   ~= 1.0 where slice == maxVal, ~= 0.0 elsewhere
            AscendC::Sub(xLocal, xLocal, valLocal, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Abs(xLocal, xLocal, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(xLocal, xLocal, (T)(-1e10f), count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Exp(xLocal, xLocal, count);
            AscendC::PipeBarrier<PIPE_V>();
            // xLocal ~= 1 where match, ~= 0 where no match

            // Update indices: idxLocal = idxLocal*(1-mask) + d*mask
            //   = idxLocal - mask*idxLocal + d*mask
            AscendC::Muls(tmpLocal, xLocal, (T)d, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(xLocal, xLocal, idxLocal, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(idxLocal, idxLocal, xLocal, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(idxLocal, idxLocal, tmpLocal, count);
            AscendC::PipeBarrier<PIPE_V>();

            inQueue_.FreeTensor(xLocal);
        }

        // Free scratch buffer
        tmpQueue_.EnQue(tmpLocal);
        tmpLocal = tmpQueue_.DeQue<T>();
        tmpQueue_.FreeTensor(tmpLocal);

        // Write max values to GM
        int64_t dstOffset = outerIdx * innerSize_ + innerOffset;
        AscendC::DataCopyExtParams outCopyParams;
        outCopyParams.blockCount = 1;
        outCopyParams.blockLen = count * sizeof(T);
        outCopyParams.srcStride = 0;
        outCopyParams.dstStride = 0;

        valQueue_.EnQue(valLocal);
        valLocal = valQueue_.DeQue<T>();
        AscendC::DataCopyPad(valGm_[dstOffset], valLocal, outCopyParams);
        valQueue_.FreeTensor(valLocal);

        // Write float indices to GM
        idxQueue_.EnQue(idxLocal);
        idxLocal = idxQueue_.DeQue<T>();
        AscendC::DataCopyPad(idxGm_[dstOffset], idxLocal, outCopyParams);
        idxQueue_.FreeTensor(idxLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, valGm_, idxGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> valQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> idxQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> tmpQueue_;
    int64_t outerStart_ = 0;
    int64_t currentBlockOuter_ = 0;
    int64_t dimSize_ = 0;
    int64_t innerSize_ = 0;
    int64_t elementNumPerTile_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void max_kernel(GM_ADDR x, GM_ADDR values, GM_ADDR indices,
    int64_t outerSize, int64_t blockOuter, uint32_t tileSize,
    int64_t dimSize, int64_t innerSize)
{
    KernelMax<T> op;
    op.Init(x, values, indices, outerSize, blockOuter, tileSize, dimSize, innerSize);
    op.Process();
}

// 5. NPU dispatch function
std::tuple<torch::Tensor, torch::Tensor> max_dim_npu(const torch::Tensor &x, int64_t dim, bool keepdim)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto x_contig = x.contiguous();

    int64_t ndim = x_contig.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");

    int64_t outerSize = 1;
    for (int64_t i = 0; i < dim; ++i) outerSize *= x_contig.size(i);
    int64_t dimSize = x_contig.size(dim);
    TORCH_CHECK(dimSize > 0, "cannot reduce on a dimension of size 0");
    int64_t innerSize = 1;
    for (int64_t i = dim + 1; i < ndim; ++i) innerSize *= x_contig.size(i);

    // Convert to float32 for kernel computation (handles float16 precision
    // and int32 support transparently)
    auto original_dtype = x_contig.scalar_type();
    auto x_f32 = x_contig;
    if (original_dtype != torch::kFloat32) {
        x_f32 = x_contig.to(torch::kFloat32);
    }

    // Create output shape
    auto out_sizes = x_contig.sizes().vec();
    if (keepdim) {
        out_sizes[dim] = 1;
    } else {
        out_sizes.erase(out_sizes.begin() + dim);
    }

    // Allocate float32 outputs for kernel
    auto values_f32 = torch::empty(out_sizes, x_f32.options());
    auto indices_f32 = torch::empty(out_sizes, x_f32.options());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t numBlocks, blockOuter, tileSize;
    std::tie(numBlocks, blockOuter, tileSize) = calc_tiling_params(outerSize);

    auto x_ptr = (GM_ADDR)x_f32.data_ptr();
    auto val_ptr = (GM_ADDR)values_f32.data_ptr();
    auto idx_ptr = (GM_ADDR)indices_f32.data_ptr();

    auto acl_call = [=]() -> int {
        using scalar_t = float;
        max_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
            x_ptr, val_ptr, idx_ptr,
            outerSize, blockOuter, tileSize, dimSize, innerSize);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("MaxDim", acl_call);

    // Convert values back to original dtype
    auto values = (original_dtype == torch::kFloat32) ? values_f32 : values_f32.to(original_dtype);
    // Convert float32 indices to int64
    auto indices = indices_f32.round().to(torch::kInt64);

    return std::make_tuple(values, indices);
}

// Register the NPU implementation
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("max_dim", max_dim_npu);
}

} // namespace Max
} // namespace ops_multimodal_fusion
