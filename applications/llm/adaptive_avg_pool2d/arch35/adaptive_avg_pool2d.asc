/*!
 * \file adaptive_avg_pool2d.asc
 * \brief AdaptiveAvgPool2d forward operator for Ascend NPU (dav-3510), RegBase path.
 *
 * Per output window: copy input rows into UB via DataCopyPad, accumulate row
 * sums with Reg VF code, average, and write back via DataCopyPad.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <tuple>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace AdaptiveAvgPool2d {

static constexpr int64_t kBlockBytes = 32;
static constexpr int64_t kScalarSlotBytes = 32;

static int64_t align_up(int64_t value, int64_t align)
{
    return ((value + align - 1) / align) * align;
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("adaptive_avg_pool2d(Tensor self, int[2] output_size) -> Tensor");
}

static std::pair<int64_t, int64_t> parse_output_size(at::IntArrayRef outputSize)
{
    TORCH_CHECK(outputSize.size() == 2,
                "adaptive_avg_pool2d: output_size must contain exactly two integers");
    int64_t outH = outputSize[0];
    int64_t outW = outputSize[1];
    TORCH_CHECK(outH > 0 && outW > 0,
                "adaptive_avg_pool2d: output_size entries must be positive");
    return std::make_pair(outH, outW);
}

static void check_common(const torch::Tensor &self, at::IntArrayRef outputSize)
{
    auto parsed = parse_output_size(outputSize);
    int64_t outH = parsed.first;
    int64_t outW = parsed.second;
    TORCH_CHECK(self.dim() == 3 || self.dim() == 4,
                "adaptive_avg_pool2d: expected 3-D or 4-D input, got ",
                self.dim(), "-D");
    TORCH_CHECK(self.scalar_type() == torch::kFloat16 ||
                self.scalar_type() == torch::kFloat32,
                "adaptive_avg_pool2d: expected Half or Float input on dav-3510 Reg path, got ",
                self.scalar_type());
    int64_t inH = self.size(self.dim() - 2);
    int64_t inW = self.size(self.dim() - 1);
    TORCH_CHECK(inH > 0 && inW > 0,
                "adaptive_avg_pool2d: input spatial dimensions must be non-empty");
    TORCH_CHECK(inH >= outH && inW >= outW,
                "adaptive_avg_pool2d: this dav-3510 Reg implementation supports downsampling only");
}

torch::Tensor adaptive_avg_pool2d_meta(
    const torch::Tensor &self, at::IntArrayRef outputSize)
{
    auto parsed = parse_output_size(outputSize);
    int64_t outH = parsed.first;
    int64_t outW = parsed.second;
    check_common(self, outputSize);
    if (self.dim() == 3) {
        return torch::empty({self.size(0), outH, outW}, self.options());
    }
    return torch::empty({self.size(0), self.size(1), outH, outW}, self.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("adaptive_avg_pool2d", adaptive_avg_pool2d_meta);
}

static std::tuple<int64_t, int64_t, uint32_t> calc_tiling_params(
    int64_t totalOutputs, int64_t inW, size_t elemSize)
{
    (void)totalOutputs;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "adaptive_avg_pool2d: coreNum must be positive");

    int64_t elemAlign = kBlockBytes / static_cast<int64_t>(elemSize);
    int64_t inputAligned = align_up(inW, elemAlign);
    int64_t inputBytes = align_up(inputAligned * static_cast<int64_t>(elemSize), kBlockBytes);

    int64_t bytes = inputBytes + 2 * kScalarSlotBytes + 512;
    TORCH_CHECK(bytes <= static_cast<int64_t>(ubSize),
                "adaptive_avg_pool2d: input width ", inW,
                " exceeds dav-3510 UB capacity for this Reg implementation");
    return std::make_tuple(
        static_cast<int64_t>(1), totalOutputs, static_cast<uint32_t>(inputAligned));
}

__simd_vf__ inline void InitFloatScalarVf(__ubuf__ float *addr, float value)
{
    AscendC::Reg::RegTensor<float> valueReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::Duplicate<float>(valueReg, value, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        addr, valueReg, mask);
}

__simd_vf__ inline void AccumulateRowFloatVf(
    __ubuf__ float *accumAddr, __ubuf__ float *xAddr,
    uint32_t start, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> sumReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        uint32_t lanes = remaining > vectorLength ? vectorLength : remaining;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(lanes);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + start + offset);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumReg, xReg, mask);
        AscendC::Reg::Add(accumReg, accumReg, sumReg, scalarMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, scalarMask);
}

__simd_vf__ inline void AccumulateRowHalfVf(
    __ubuf__ float *accumAddr, __ubuf__ half *xAddr,
    uint32_t start, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> sumReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        uint32_t lanes = remaining > vectorLength ? vectorLength : remaining;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(lanes);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + start + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, xHalfReg, mask);
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumReg, xReg, mask);
        AscendC::Reg::Add(accumReg, accumReg, sumReg, scalarMask);
    }
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, scalarMask);
}

__simd_vf__ inline void StoreScaledFloatVf(
    __ubuf__ float *outAddr, __ubuf__ float *accumAddr, float scale)
{
    AscendC::Reg::RegTensor<float> accumReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::Muls(accumReg, accumReg, scale, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        outAddr, accumReg, mask);
}

__simd_vf__ inline void ScaleAccumFloatVf(__ubuf__ float *accumAddr, float scale)
{
    AscendC::Reg::RegTensor<float> accumReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::Muls(accumReg, accumReg, scale, mask);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        accumAddr, accumReg, mask);
}

__simd_vf__ inline void StoreScaledHalfVf(
    __ubuf__ half *outAddr, __ubuf__ float *accumAddr, float scale)
{
    static constexpr AscendC::Reg::CastTrait castToHalf = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::NO_SAT,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::CAST_NONE};
    AscendC::Reg::RegTensor<float> accumReg;
    AscendC::Reg::RegTensor<half> outReg;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(scalarCount);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
        accumReg, accumAddr);
    AscendC::Reg::Muls(accumReg, accumReg, scale, mask);
    AscendC::Reg::Cast<half, float, castToHalf>(outReg, accumReg, mask);
    AscendC::Reg::StoreAlign<half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
        outAddr, outReg, mask);
}

__aicore__ inline void InitFloatScalar(AscendC::LocalTensor<float> accumLocal, float value)
{
    asc_vf_call<InitFloatScalarVf>(
        (__ubuf__ float *)accumLocal.GetPhyAddr(), value);
}

__aicore__ inline void AccumulateRowFloat(
    AscendC::LocalTensor<float> accumLocal, AscendC::LocalTensor<float> xLocal,
    uint32_t start, uint32_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t chunkCount = (count + vectorLength - 1) / vectorLength;
    asc_vf_call<AccumulateRowFloatVf>(
        (__ubuf__ float *)accumLocal.GetPhyAddr(),
        (__ubuf__ float *)xLocal.GetPhyAddr(), start, count, chunkCount);
}

__aicore__ inline void AccumulateRowHalf(
    AscendC::LocalTensor<float> accumLocal, AscendC::LocalTensor<half> xLocal,
    uint32_t start, uint32_t count)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t chunkCount = (count + vectorLength - 1) / vectorLength;
    asc_vf_call<AccumulateRowHalfVf>(
        (__ubuf__ float *)accumLocal.GetPhyAddr(),
        (__ubuf__ half *)xLocal.GetPhyAddr(), start, count, chunkCount);
}

__aicore__ inline void StoreScaledFloat(
    AscendC::LocalTensor<float> outLocal, AscendC::LocalTensor<float> accumLocal,
    float scale)
{
    asc_vf_call<StoreScaledFloatVf>(
        (__ubuf__ float *)outLocal.GetPhyAddr(),
        (__ubuf__ float *)accumLocal.GetPhyAddr(), scale);
}

__aicore__ inline void ScaleAccumFloat(
    AscendC::LocalTensor<float> accumLocal, float scale)
{
    asc_vf_call<ScaleAccumFloatVf>(
        (__ubuf__ float *)accumLocal.GetPhyAddr(), scale);
}

__aicore__ inline void StoreScaledHalf(
    AscendC::LocalTensor<half> outLocal, AscendC::LocalTensor<float> accumLocal,
    float scale)
{
    asc_vf_call<StoreScaledHalfVf>(
        (__ubuf__ half *)outLocal.GetPhyAddr(),
        (__ubuf__ float *)accumLocal.GetPhyAddr(), scale);
}

template <typename T>
class KernelAdaptiveAvgPool2d {
public:
    __aicore__ inline KernelAdaptiveAvgPool2d() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR output, int64_t N, int64_t C,
        int64_t inH, int64_t inW, int64_t outH, int64_t outW, uint32_t inputAligned)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        N_ = N;
        C_ = C;
        inH_ = inH;
        inW_ = inW;
        outH_ = outH;
        outW_ = outW;
        inputAligned_ = inputAligned;

        uint32_t inputBytes = AlignUpBytes(
            inputAligned * static_cast<uint32_t>(sizeof(T)));
        pipe_.InitBuffer(tbufInput_, inputBytes);
        pipe_.InitBuffer(tbufAccum_, static_cast<uint32_t>(kScalarSlotBytes));
        pipe_.InitBuffer(tbufOut_, static_cast<uint32_t>(kScalarSlotBytes));
    }

    __aicore__ inline void Process()
    {
        for (int64_t n = 0; n < N_; ++n) {
            for (int64_t c = 0; c < C_; ++c) {
                for (int64_t oh = 0; oh < outH_; ++oh) {
                    int64_t hStart = StartIndex(oh, inH_, outH_);
                    int64_t hEnd = EndIndex(oh + 1, inH_, outH_);
                    for (int64_t ow = 0; ow < outW_; ++ow) {
                        int64_t wStart = StartIndex(ow, inW_, outW_);
                        int64_t wEnd = EndIndex(ow + 1, inW_, outW_);
                        int64_t outputIndex =
                            ((n * C_ + c) * outH_ + oh) * outW_ + ow;
                        ComputeAndStoreWindow(
                            n, c, hStart, hEnd, wStart, wEnd, outputIndex);
                    }
                }
            }
        }
    }

private:
    __aicore__ inline uint32_t AlignUpBytes(uint32_t bytes)
    {
        int64_t aligned =
            ((static_cast<int64_t>(bytes) + kBlockBytes - 1) / kBlockBytes) * kBlockBytes;
        if (aligned < kBlockBytes) {
            aligned = kBlockBytes;
        }
        return static_cast<uint32_t>(aligned);
    }

    __aicore__ inline int64_t StartIndex(int64_t outIndex, int64_t inSize, int64_t outSize)
    {
        int64_t index = 0;
        int64_t target = outIndex * inSize;
        while ((index + 1) * outSize <= target) {
            ++index;
        }
        return index;
    }

    __aicore__ inline int64_t EndIndex(int64_t outIndexNext, int64_t inSize, int64_t outSize)
    {
        int64_t index = 1;
        int64_t target = outIndexNext * inSize;
        while (index * outSize < target) {
            ++index;
        }
        if (index > inSize) {
            index = inSize;
        }
        return index;
    }

    __aicore__ inline void StoreOutput(int64_t outputIndex, AscendC::LocalTensor<float> accumLocal, float scale)
    {
        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        if constexpr (std::is_same<T, half>::value) {
            AscendC::LocalTensor<T> outLocal = tbufOut_.template Get<T>();
            StoreScaledHalf(outLocal, accumLocal, scale);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyPad(outputGm_[outputIndex], outLocal, copyOut);
            AscendC::PipeBarrier<PIPE_ALL>();
        } else {
            AscendC::LocalTensor<T> outLocal = tbufOut_.template Get<T>();
            StoreScaledFloat(outLocal, accumLocal, scale);
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::DataCopyPad(outputGm_[outputIndex], outLocal, copyOut);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
    }

    __aicore__ inline void ComputeAndStoreWindow(
        int64_t n, int64_t c, int64_t hStart, int64_t hEnd,
        int64_t wStart, int64_t wEnd, int64_t outputIndex)
    {
        int64_t kh = hEnd - hStart;
        int64_t kw = wEnd - wStart;
        AscendC::LocalTensor<float> accumLocal = tbufAccum_.template Get<float>();
        InitFloatScalar(accumLocal, 0.0f);
        AscendC::PipeBarrier<PIPE_V>();
        if (kh <= 0 || kw <= 0) {
            StoreOutput(outputIndex, accumLocal, 1.0f);
            return;
        }

        AscendC::DataCopyExtParams copyIn;
        copyIn.blockCount = 1;
        copyIn.blockLen = static_cast<uint32_t>(kw * sizeof(T));
        copyIn.srcStride = 0;
        copyIn.dstStride = 0;
        int64_t elemAlign = kBlockBytes / static_cast<int64_t>(sizeof(T));
        uint32_t windowAligned = static_cast<uint32_t>(
            ((kw + elemAlign - 1) / elemAlign) * elemAlign);
        uint32_t rightPadding = windowAligned - static_cast<uint32_t>(kw);
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(rightPadding), static_cast<T>(0)};

        for (int64_t h = hStart; h < hEnd; ++h) {
            int64_t rowBase = ((n * C_ + c) * inH_ + h) * inW_ + wStart;
            AscendC::LocalTensor<T> xLocal = tbufInput_.template Get<T>();
            AscendC::DataCopyPad(xLocal, inputGm_[rowBase], copyIn, padParams);
            AscendC::PipeBarrier<PIPE_ALL>();
            if constexpr (std::is_same<T, half>::value) {
                AccumulateRowHalf(
                    accumLocal, xLocal, 0, static_cast<uint32_t>(kw));
            } else {
                AccumulateRowFloat(
                    accumLocal, xLocal, 0, static_cast<uint32_t>(kw));
            }
            AscendC::PipeBarrier<PIPE_V>();
        }

        float scale = 1.0f / static_cast<float>(kh * kw);
        StoreOutput(outputIndex, accumLocal, scale);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufAccum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOut_;
    int64_t N_ = 0;
    int64_t C_ = 0;
    int64_t inH_ = 0;
    int64_t inW_ = 0;
    int64_t outH_ = 0;
    int64_t outW_ = 0;
    uint32_t inputAligned_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void adaptive_avg_pool2d_kernel(
    GM_ADDR input, GM_ADDR output,
    int64_t N, int64_t C, int64_t inH, int64_t inW, int64_t outH, int64_t outW,
    uint32_t inputAligned)
{
    if (AscendC::GetBlockIdx() != 0 || AscendC::GetSubBlockIdx() != 0) {
        return;
    }
    KernelAdaptiveAvgPool2d<T> op;
    op.Init(input, output, N, C, inH, inW, outH, outW, inputAligned);
    op.Process();
}

torch::Tensor adaptive_avg_pool2d_npu(
    const torch::Tensor &self, at::IntArrayRef outputSize)
{
    auto parsed = parse_output_size(outputSize);
    int64_t outH = parsed.first;
    int64_t outW = parsed.second;
    check_common(self, outputSize);
    const c10::OptionalDeviceGuard guard(self.device());
    torch::Tensor input = self.contiguous();
    bool is4D = (input.dim() == 4);
    int64_t N = is4D ? input.size(0) : 1;
    int64_t C = is4D ? input.size(1) : input.size(0);
    int64_t inH = is4D ? input.size(2) : input.size(1);
    int64_t inW = is4D ? input.size(3) : input.size(2);
    int64_t totalOutputs = N * C * outH * outW;
    torch::Tensor output = is4D
        ? torch::empty({N, C, outH, outW}, input.options())
        : torch::empty({C, outH, outW}, input.options());
    if (totalOutputs == 0) {
        return output;
    }

    uint32_t inputAligned = 0;
    std::tie(std::ignore, std::ignore, inputAligned) =
        calc_tiling_params(totalOutputs, inW, input.element_size());

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)input.data_ptr();
    auto outputPtr = (GM_ADDR)output.data_ptr();
    auto aclCall = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input.scalar_type(), "adaptive_avg_pool2d_npu",
            AT_DISPATCH_CASE(at::ScalarType::Half, [&] {
                adaptive_avg_pool2d_kernel<half><<<1, nullptr, stream>>>(
                    inputPtr, outputPtr, N, C, inH, inW, outH, outW, inputAligned);
            })
            AT_DISPATCH_CASE(at::ScalarType::Float, [&] {
                adaptive_avg_pool2d_kernel<float><<<1, nullptr, stream>>>(
                    inputPtr, outputPtr, N, C, inH, inW, outH, outW, inputAligned);
            }));
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("AdaptiveAvgPool2dReg", aclCall);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("adaptive_avg_pool2d", adaptive_avg_pool2d_npu);
}

} // namespace AdaptiveAvgPool2d
} // namespace ops_multimodal_fusion
