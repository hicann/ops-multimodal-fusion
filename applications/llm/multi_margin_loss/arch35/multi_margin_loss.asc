/*!
 * \file multi_margin_loss.asc
 * \brief MultiMarginLoss forward operator for Ascend NPU (dav-3510), strict RegBase path.
 *
 * torch.ops.ops_multimodal_fusion.multi_margin_loss(input, target, p=1, margin=1.0, weight=None, reduction=1)
 *
 * input:  [C] or [N, C], fp16/fp32
 * target: scalar for 1-D input or [N] for 2-D input, int64
 * weight: optional [C], same dtype as input
 * reduction: 0 none, 1 mean, 2 sum
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <algorithm>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace MultiMarginLoss {

static constexpr int64_t kReductionNone = 0;
static constexpr int64_t kReductionMean = 1;
static constexpr int64_t kReductionSum = 2;
static constexpr int64_t kScalarSlotBytes = 32;
static constexpr int64_t kFloatScalarSlotLanes = kScalarSlotBytes / static_cast<int64_t>(sizeof(float));
static constexpr int64_t kDav3510VectorRegBytes = 256;

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("multi_margin_loss(Tensor input, Tensor target, Scalar p=1, "
          "Scalar margin=1.0, Tensor? weight=None, int reduction=1) -> Tensor");
}

static int64_t scalar_to_p(const c10::Scalar &p)
{
    double pValue = p.toDouble();
    TORCH_CHECK(pValue == 1.0 || pValue == 2.0,
                "multi_margin_loss: p must be 1 or 2, got ", pValue);
    return static_cast<int64_t>(pValue);
}

static float scalar_to_margin(const c10::Scalar &margin)
{
    return static_cast<float>(margin.to<double>());
}

static void check_common(
    const torch::Tensor &input, const torch::Tensor &target,
    int64_t pValue, const c10::optional<torch::Tensor> &weightOpt,
    int64_t reduction)
{
    TORCH_CHECK(input.dim() == 1 || input.dim() == 2,
                "multi_margin_loss: expected 1-D or 2-D input, got ",
                input.dim(), "-D");
    TORCH_CHECK(input.scalar_type() == torch::kFloat16 ||
                input.scalar_type() == torch::kFloat32,
                "multi_margin_loss: expected Half or Float input on dav-3510 Reg path, got ",
                input.scalar_type());
    TORCH_CHECK(target.scalar_type() == torch::kInt64,
                "multi_margin_loss: target must have dtype int64");
    if (input.dim() == 1) {
        TORCH_CHECK(target.dim() == 0,
                    "multi_margin_loss: target must be a scalar for 1-D input");
    } else {
        TORCH_CHECK(target.dim() == 1 && target.size(0) == input.size(0),
                    "multi_margin_loss: target shape must be [N] for 2-D input");
    }
    TORCH_CHECK(reduction == kReductionNone ||
                reduction == kReductionMean ||
                reduction == kReductionSum,
                "multi_margin_loss: reduction must be 0 (none), 1 (mean), or 2 (sum), got ",
                reduction);
    TORCH_CHECK(pValue == 1 || pValue == 2,
                "multi_margin_loss: p must be 1 or 2, got ", pValue);
    int64_t sampleCount = (input.dim() == 1) ? 1 : input.size(0);
    int64_t classCount = input.size(input.dim() - 1);
    TORCH_CHECK(classCount > 0 || sampleCount == 0,
                "multi_margin_loss: class dimension C must be greater than 0");
    if (weightOpt.has_value()) {
        const auto &weight = weightOpt.value();
        TORCH_CHECK(weight.defined(), "multi_margin_loss: weight is undefined");
        TORCH_CHECK(weight.dim() == 1 && weight.size(0) == classCount,
                    "multi_margin_loss: weight must have shape [C]");
        TORCH_CHECK(weight.scalar_type() == input.scalar_type(),
                    "multi_margin_loss: weight dtype must match input dtype");
    }
}

torch::Tensor multi_margin_loss_meta(
    const torch::Tensor &input, const torch::Tensor &target,
    const c10::Scalar &p, const c10::Scalar &margin,
    const c10::optional<torch::Tensor> &weightOpt, int64_t reduction)
{
    (void)margin;
    int64_t pValue = scalar_to_p(p);
    check_common(input, target, pValue, weightOpt, reduction);
    if (input.dim() == 2 && reduction == kReductionNone) {
        return torch::empty({input.size(0)}, input.options());
    }
    return torch::empty({}, input.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("multi_margin_loss", multi_margin_loss_meta);
}

static std::tuple<int64_t, int64_t, int64_t, int64_t>
calc_tiling_params(int64_t classCount, size_t elemSize, bool hasWeight)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);

    int64_t elemAlign = 32 / static_cast<int64_t>(elemSize);
    int64_t alignedInput = ((classCount + elemAlign - 1) / elemAlign) * elemAlign;
    int64_t alignedFloat = ((classCount + kFloatScalarSlotLanes - 1) /
                            kFloatScalarSlotLanes) * kFloatScalarSlotLanes;
    int64_t vectorLength = kDav3510VectorRegBytes / static_cast<int64_t>(sizeof(float));
    int64_t chunkCount = (classCount + vectorLength - 1) / vectorLength;

    int64_t bytes =
        alignedInput * static_cast<int64_t>(elemSize) +
        alignedFloat * static_cast<int64_t>(sizeof(float)) +
        chunkCount * kScalarSlotBytes +
        kScalarSlotBytes +
        kScalarSlotBytes;
    if (hasWeight) {
        bytes += alignedInput * static_cast<int64_t>(elemSize);
    }
    bytes += 1024;
    TORCH_CHECK(bytes <= static_cast<int64_t>(ubSize),
                "multi_margin_loss: class dimension C=", classCount,
                " exceeds dav-3510 UB capacity for this Reg implementation");
    return std::make_tuple(alignedInput, alignedFloat, chunkCount, vectorLength);
}

__simd_vf__ inline void MultiMarginLossFloatVf(
    __ubuf__ float *xAddr, __ubuf__ float *notTargetAddr, __ubuf__ float *sumAddr,
    float positiveValue, float margin, uint32_t pValue, uint32_t count,
    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> notTargetReg;
    AscendC::Reg::RegTensor<float> hingeReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::MaskReg reluMask;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            xReg, xAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            notTargetReg, notTargetAddr + offset);
        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            zeroReg, 0.0f, mask);
        AscendC::Reg::Adds(hingeReg, xReg, margin - positiveValue, mask);
        AscendC::Reg::Mul(hingeReg, hingeReg, notTargetReg, mask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(
            reluMask, hingeReg, zeroReg, mask);
        AscendC::Reg::Select<float>(hingeReg, hingeReg, zeroReg, reluMask);
        if (pValue == 2) {
            AscendC::Reg::Mul(hingeReg, hingeReg, hingeReg, mask);
        }
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumReg, hingeReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + chunk * kFloatScalarSlotLanes, sumReg, scalarMask);
    }
}

__simd_vf__ inline void MultiMarginLossHalfVf(
    __ubuf__ half *xAddr, __ubuf__ float *notTargetAddr, __ubuf__ float *sumAddr,
    float positiveValue, float margin, uint32_t pValue, uint32_t count,
    uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    static constexpr AscendC::Reg::CastTrait castToFloat = {
        AscendC::Reg::RegLayout::ZERO,
        AscendC::Reg::SatMode::UNKNOWN,
        AscendC::Reg::MaskMergeMode::ZEROING,
        AscendC::RoundMode::UNKNOWN};

    AscendC::Reg::RegTensor<half> xHalfReg;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> notTargetReg;
    AscendC::Reg::RegTensor<float> hingeReg;
    AscendC::Reg::RegTensor<float> zeroReg;
    AscendC::Reg::RegTensor<float> sumReg;
    AscendC::Reg::MaskReg reluMask;
    uint32_t scalarCount = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<float>(scalarCount);

    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t offset = chunk * vectorLength;
        uint32_t remaining = count - offset;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign<half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
            xHalfReg, xAddr + offset);
        AscendC::Reg::Cast<float, half, castToFloat>(xReg, xHalfReg, mask);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(
            notTargetReg, notTargetAddr + offset);
        AscendC::Reg::Duplicate<float, AscendC::Reg::MaskMergeMode::ZEROING>(
            zeroReg, 0.0f, mask);
        AscendC::Reg::Adds(hingeReg, xReg, margin - positiveValue, mask);
        AscendC::Reg::Mul(hingeReg, hingeReg, notTargetReg, mask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::GT>(
            reluMask, hingeReg, zeroReg, mask);
        AscendC::Reg::Select<float>(hingeReg, hingeReg, zeroReg, reluMask);
        if (pValue == 2) {
            AscendC::Reg::Mul(hingeReg, hingeReg, hingeReg, mask);
        }
        AscendC::Reg::Reduce<
            AscendC::Reg::ReduceType::SUM, float, float,
            AscendC::Reg::MaskMergeMode::ZEROING>(sumReg, hingeReg, mask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(
            sumAddr + chunk * kFloatScalarSlotLanes, sumReg, scalarMask);
    }
}

__aicore__ inline void MultiMarginLossFloat(
    AscendC::LocalTensor<float> xLocal, AscendC::LocalTensor<float> notTargetLocal,
    AscendC::LocalTensor<float> sumLocal, float positiveValue, float margin,
    uint32_t pValue, uint32_t count, uint32_t chunkCount)
{
    asc_vf_call<MultiMarginLossFloatVf>(
        (__ubuf__ float *)xLocal.GetPhyAddr(),
        (__ubuf__ float *)notTargetLocal.GetPhyAddr(),
        (__ubuf__ float *)sumLocal.GetPhyAddr(),
        positiveValue, margin, pValue, count, chunkCount);
}

__aicore__ inline void MultiMarginLossHalf(
    AscendC::LocalTensor<half> xLocal, AscendC::LocalTensor<float> notTargetLocal,
    AscendC::LocalTensor<float> sumLocal, float positiveValue, float margin,
    uint32_t pValue, uint32_t count, uint32_t chunkCount)
{
    asc_vf_call<MultiMarginLossHalfVf>(
        (__ubuf__ half *)xLocal.GetPhyAddr(),
        (__ubuf__ float *)notTargetLocal.GetPhyAddr(),
        (__ubuf__ float *)sumLocal.GetPhyAddr(),
        positiveValue, margin, pValue, count, chunkCount);
}

template <typename T>
class KernelMultiMarginLoss {
public:
    __aicore__ inline KernelMultiMarginLoss() {}

    __aicore__ inline void Init(
        GM_ADDR input, GM_ADDR target, GM_ADDR weight, GM_ADDR output,
        int64_t sampleCount, int64_t classCount, int64_t pValue, float margin,
        bool hasWeight, int64_t reduction, int64_t inputStride0, int64_t inputStride1,
        int64_t targetStride0, int64_t weightStride0, int64_t inputAligned,
        int64_t floatAligned, int64_t chunkCount)
    {
        inputGm_.SetGlobalBuffer((__gm__ T *)input);
        targetGm_.SetGlobalBuffer((__gm__ int64_t *)target);
        outputGm_.SetGlobalBuffer((__gm__ T *)output);
        if (hasWeight) {
            weightGm_.SetGlobalBuffer((__gm__ T *)weight);
        }
        sampleCount_ = sampleCount;
        classCount_ = classCount;
        pValue_ = pValue;
        margin_ = margin;
        hasWeight_ = hasWeight;
        reduction_ = reduction;
        inputStride0_ = inputStride0;
        inputStride1_ = inputStride1;
        targetStride0_ = targetStride0;
        weightStride0_ = weightStride0;
        inputAligned_ = inputAligned;
        floatAligned_ = floatAligned;
        chunkCount_ = chunkCount;

        pipe_.InitBuffer(tbufInput_, inputAligned * sizeof(T));
        pipe_.InitBuffer(tbufNotTarget_, floatAligned * sizeof(float));
        pipe_.InitBuffer(tbufSum_, chunkCount * kScalarSlotBytes);
        pipe_.InitBuffer(tbufOut_, kScalarSlotBytes);
        pipe_.InitBuffer(tbufTarget_, kScalarSlotBytes);
        if (hasWeight) {
            pipe_.InitBuffer(tbufWeight_, inputAligned * sizeof(T));
        }
    }

    __aicore__ inline void Process()
    {
        if (AscendC::GetBlockIdx() != 0) {
            return;
        }
        if (hasWeight_) {
            LoadWeight();
        }
        float reduced = 0.0f;
        for (int64_t n = 0; n < sampleCount_; ++n) {
            float sampleLoss = ProcessSample(n);
            if (reduction_ == kReductionNone) {
                StoreOutput(n, sampleLoss);
            } else {
                reduced += sampleLoss;
            }
        }
        if (reduction_ == kReductionMean) {
            reduced = (sampleCount_ > 0) ? (reduced / static_cast<float>(sampleCount_)) : 0.0f;
            StoreOutput(0, reduced);
        } else if (reduction_ == kReductionSum) {
            StoreOutput(0, reduced);
        }
    }

private:
    __aicore__ inline void LoadWeight()
    {
        AscendC::LocalTensor<T> weightLocal = tbufWeight_.template Get<T>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = static_cast<uint32_t>(classCount_ * sizeof(T));
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(inputAligned_ - classCount_), static_cast<T>(0)};
        if (weightStride0_ == 1) {
            AscendC::DataCopyPad(weightLocal, weightGm_, copyParams, padParams);
        } else {
            AscendC::DataCopyExtParams copyOne;
            copyOne.blockCount = 1;
            copyOne.blockLen = static_cast<uint32_t>(sizeof(T));
            copyOne.srcStride = 0;
            copyOne.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padOne{false, 0, 0, static_cast<T>(0)};
            for (int64_t j = 0; j < classCount_; ++j) {
                AscendC::DataCopyPad(weightLocal[j], weightGm_[j * weightStride0_],
                                     copyOne, padOne);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline float ProcessSample(int64_t sample)
    {
        AscendC::LocalTensor<T> inputLocal = tbufInput_.template Get<T>();
        AscendC::LocalTensor<int64_t> targetLocal = tbufTarget_.template Get<int64_t>();
        AscendC::LocalTensor<float> notTargetLocal = tbufNotTarget_.template Get<float>();
        AscendC::LocalTensor<float> sumLocal = tbufSum_.template Get<float>();

        LoadInput(sample, inputLocal);
        LoadTarget(sample, targetLocal);
        AscendC::PipeBarrier<PIPE_ALL>();

        int64_t targetValue = targetLocal.GetValue(0);
        if (targetValue < 0 || targetValue >= classCount_) {
            return 0.0f;
        }
        for (int64_t j = 0; j < floatAligned_; ++j) {
            notTargetLocal.SetValue(j, 1.0f);
        }
        notTargetLocal.SetValue(targetValue, 0.0f);
        AscendC::PipeBarrier<PIPE_ALL>();

        float positiveValue = ReadAsFloat(inputLocal, targetValue);
        if constexpr (std::is_same<T, half>::value) {
            MultiMarginLossHalf(inputLocal, notTargetLocal, sumLocal, positiveValue,
                                margin_, static_cast<uint32_t>(pValue_),
                                static_cast<uint32_t>(classCount_),
                                static_cast<uint32_t>(chunkCount_));
        } else {
            MultiMarginLossFloat(inputLocal, notTargetLocal, sumLocal, positiveValue,
                                 margin_, static_cast<uint32_t>(pValue_),
                                 static_cast<uint32_t>(classCount_),
                                 static_cast<uint32_t>(chunkCount_));
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        float total = 0.0f;
        for (int64_t chunk = 0; chunk < chunkCount_; ++chunk) {
            total += sumLocal.GetValue(chunk * kFloatScalarSlotLanes);
        }
        float weightValue = 1.0f;
        if (hasWeight_) {
            AscendC::LocalTensor<T> weightLocal = tbufWeight_.template Get<T>();
            weightValue = ReadAsFloat(weightLocal, targetValue);
        }
        return total * weightValue / static_cast<float>(classCount_);
    }

    __aicore__ inline void LoadInput(int64_t sample, AscendC::LocalTensor<T> inputLocal)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = static_cast<uint32_t>(classCount_ * sizeof(T));
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0, static_cast<uint8_t>(inputAligned_ - classCount_), static_cast<T>(0)};
        int64_t rowOffset = sample * inputStride0_;
        if (inputStride1_ == 1) {
            AscendC::DataCopyPad(inputLocal, inputGm_[rowOffset], copyParams, padParams);
        } else {
            AscendC::DataCopyExtParams copyOne;
            copyOne.blockCount = 1;
            copyOne.blockLen = static_cast<uint32_t>(sizeof(T));
            copyOne.srcStride = 0;
            copyOne.dstStride = 0;
            AscendC::DataCopyPadExtParams<T> padOne{false, 0, 0, static_cast<T>(0)};
            for (int64_t j = 0; j < classCount_; ++j) {
                AscendC::DataCopyPad(inputLocal[j], inputGm_[rowOffset + j * inputStride1_],
                                     copyOne, padOne);
            }
        }
    }

    __aicore__ inline void LoadTarget(int64_t sample, AscendC::LocalTensor<int64_t> targetLocal)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = static_cast<uint32_t>(sizeof(int64_t));
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<int64_t> padParams{
            false, 0, 0, static_cast<int64_t>(0)};
        AscendC::DataCopyPad(targetLocal, targetGm_[sample * targetStride0_],
                             copyParams, padParams);
    }

    __aicore__ inline float ReadAsFloat(AscendC::LocalTensor<T> local, int64_t index)
    {
        if constexpr (std::is_same<T, half>::value) {
            half v = local.GetValue(index);
            return static_cast<float>(v);
        } else {
            return local.GetValue(index);
        }
    }

    __aicore__ inline void StoreOutput(int64_t index, float value)
    {
        AscendC::LocalTensor<T> outLocal = tbufOut_.template Get<T>();
        if constexpr (std::is_same<T, half>::value) {
            outLocal.SetValue(0, T(value));
        } else {
            outLocal.SetValue(0, value);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyExtParams copyOut;
        copyOut.blockCount = 1;
        copyOut.blockLen = static_cast<uint32_t>(sizeof(T));
        copyOut.srcStride = 0;
        copyOut.dstStride = 0;
        AscendC::DataCopyPad(outputGm_[index], outLocal, copyOut);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<int64_t> targetGm_;
    AscendC::GlobalTensor<T> weightGm_;
    AscendC::GlobalTensor<T> outputGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufInput_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufNotTarget_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufSum_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufOut_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufTarget_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufWeight_;
    int64_t sampleCount_ = 0;
    int64_t classCount_ = 0;
    int64_t pValue_ = 1;
    float margin_ = 1.0f;
    bool hasWeight_ = false;
    int64_t reduction_ = kReductionMean;
    int64_t inputStride0_ = 0;
    int64_t inputStride1_ = 1;
    int64_t targetStride0_ = 1;
    int64_t weightStride0_ = 1;
    int64_t inputAligned_ = 0;
    int64_t floatAligned_ = 0;
    int64_t chunkCount_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void multi_margin_loss_kernel(
    GM_ADDR input, GM_ADDR target, GM_ADDR weight, GM_ADDR output,
    int64_t sampleCount, int64_t classCount, int64_t pValue, float margin,
    bool hasWeight, int64_t reduction, int64_t inputStride0, int64_t inputStride1,
    int64_t targetStride0, int64_t weightStride0, int64_t inputAligned,
    int64_t floatAligned, int64_t chunkCount)
{
    KernelMultiMarginLoss<T> op;
    op.Init(input, target, weight, output, sampleCount, classCount, pValue, margin,
            hasWeight, reduction, inputStride0, inputStride1, targetStride0,
            weightStride0, inputAligned, floatAligned, chunkCount);
    op.Process();
}

torch::Tensor multi_margin_loss_npu(
    const torch::Tensor &input, const torch::Tensor &target,
    const c10::Scalar &p, const c10::Scalar &margin,
    const c10::optional<torch::Tensor> &weightOpt, int64_t reduction)
{
    int64_t pValue = scalar_to_p(p);
    float marginValue = scalar_to_margin(margin);
    check_common(input, target, pValue, weightOpt, reduction);
    const c10::OptionalDeviceGuard guard(input.device());

    int64_t sampleCount = (input.dim() == 1) ? 1 : input.size(0);
    int64_t classCount = input.size(input.dim() - 1);
    torch::Tensor output = (input.dim() == 2 && reduction == kReductionNone)
        ? torch::empty({sampleCount}, input.options())
        : torch::empty({}, input.options());
    if (sampleCount == 0 && reduction == kReductionNone) {
        return output;
    }

    bool hasWeight = weightOpt.has_value() && weightOpt.value().defined();
    auto inputC = input.contiguous();
    auto targetC = target.contiguous();
    auto weightC = hasWeight ? weightOpt.value().contiguous() : torch::Tensor();
    int64_t inputStride0 = (inputC.dim() == 1) ? 0 : inputC.stride(0);
    int64_t inputStride1 = (inputC.dim() == 1) ? inputC.stride(0) : inputC.stride(1);
    int64_t targetStride0 = (targetC.dim() == 0) ? 0 : targetC.stride(0);
    int64_t weightStride0 = hasWeight ? weightC.stride(0) : 1;

    int64_t inputAligned, floatAligned, chunkCount, vectorLength;
    std::tie(inputAligned, floatAligned, chunkCount, vectorLength) =
        calc_tiling_params(std::max<int64_t>(classCount, 1), input.element_size(), hasWeight);
    (void)vectorLength;

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto inputPtr = (GM_ADDR)inputC.data_ptr();
    auto targetPtr = (GM_ADDR)targetC.data_ptr();
    auto weightPtr = hasWeight ? (GM_ADDR)weightC.data_ptr() : (GM_ADDR)nullptr;
    auto outputPtr = (GM_ADDR)output.data_ptr();
    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            input.scalar_type(), "multi_margin_loss_npu",
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                multi_margin_loss_kernel<half><<<1, nullptr, stream>>>(
                    inputPtr, targetPtr, weightPtr, outputPtr, sampleCount, classCount,
                    pValue, marginValue, hasWeight, reduction, inputStride0, inputStride1,
                    targetStride0, weightStride0, inputAligned, floatAligned, chunkCount);
            })
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                multi_margin_loss_kernel<float><<<1, nullptr, stream>>>(
                    inputPtr, targetPtr, weightPtr, outputPtr, sampleCount, classCount,
                    pValue, marginValue, hasWeight, reduction, inputStride0, inputStride1,
                    targetStride0, weightStride0, inputAligned, floatAligned, chunkCount);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("MultiMarginLoss", acl_call);
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("multi_margin_loss", multi_margin_loss_npu);
}

} // namespace MultiMarginLoss
} // namespace ops_multimodal_fusion
