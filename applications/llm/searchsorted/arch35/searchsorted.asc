/*!
 * \file searchsorted.asc
 * \brief Searchsorted operator for Ascend NPU (dav-3510), RegBase implementation.
 *
 * torch.searchsorted(sorted_sequence, values, *, out_int32=False, right=False) -> Tensor
 *   For each query value v, returns the smallest i such that sorted_sequence[i] >= v
 *   (left-side insertion). Output shape matches values.shape; dtype = int64.
 *
 * Algorithm — single-pass vector count per query:
 *
 *   sorted_sequence is loaded once into UB at Init (every AIV gets its own copy).
 *   Per query value v:
 *     1. Reg::Compares<T, LT>(ltMask, sortedReg, v, validMask)  -> bitmask of lanes where sorted[i] < v
 *     2. Reg::Reduce<SUM, T, T, ZEROING>(countReg, onesReg, ltMask)  -> count of LT-lanes = insertion idx
 *   Layer 3 reads the T-typed count from a 32B scratch slot and casts to int32 via scalar static_cast.
 *
 *   Why T-typed scratch (not int32):
 *     Reg::Reduce dst/src and the mask all live in T's lane domain (T-lanes = VECTOR_REG_WIDTH/sizeof(T);
 *     for fp16=128, fp32/int32=64). Mixing fp16 mask with int32 reduce would mismatch lane widths.
 *     T-typed ones+sum keeps everything in one domain. Counts fit exactly in every supported T:
 *     fp16 holds integers up to 2048 exactly (>> 128); fp32 up to 2^24; int32 trivially.
 *
 * Dispatch scope (first version):
 *   - 1-D sorted_sequence only (TORCH_CHECK)
 *   - N = sorted_sequence.size(0) <= vec_width per dtype (TORCH_CHECK; chunked path deferred)
 *   - dtype fp32 / fp16 / int32 (must match between sorted_sequence and values)
 *   - right=False (left-side insertion); right=True deferred
 *   - out_int32=False (output is always int64); out_int32=True deferred
 *   - sorter parameter not exposed in schema (deferred)
 *
 * Output layout: int32 idx written to lane 0 of each 32B int32 scratch slot with lane 1 = 0,
 * DMA'd out as int64 low/high. Avoids an int32->int64 Cast that has no binary on this platform.
 *
 * 3-layer Reg shape:
 *   Layer 1: __simd_vf__ SearchsortedCountVf<T>  - LoadAlign + Compares<LT> + Reduce<SUM>
 *   Layer 2: __aicore__ SearchsortedCount<T>     - LocalTensor -> (__ubuf__ T*) cast, asc_vf_call
 *   Layer 3: KernelSearchsortedReg<T>            - DMA, per-tile values stream, per-query vf, idx pack
 *
 * UB layout per core:
 *   tbufSorted:       N * sizeof(T)               // sorted_sequence (persistent, loaded once at Init)
 *   inQueueValues:    PIPELINE_DEPTH * queriesPerTile * sizeof(T)
 *   tbufScratch:      queriesPerTile * 32B        // per-query T-typed count slot
 *   outQueueIndices:  queriesPerTile * sizeof(int64)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ops_multimodal_fusion {
namespace Searchsorted {

// ===================== 1. Schema =====================

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("searchsorted(Tensor sorted_sequence, Tensor values, "
          "bool out_int32=False, bool right=False) -> Tensor");
}

// ===================== 2. Meta =====================

torch::Tensor searchsorted_meta(
    const torch::Tensor &sorted_sequence, const torch::Tensor &values,
    bool out_int32, bool right)
{
    TORCH_CHECK(sorted_sequence.dim() == 1,
                "searchsorted: only 1-D sorted_sequence is supported in this version, got ",
                sorted_sequence.dim(), "-D");
    TORCH_CHECK(sorted_sequence.scalar_type() == values.scalar_type(),
                "searchsorted: sorted_sequence dtype (", sorted_sequence.scalar_type(),
                ") must match values dtype (", values.scalar_type(), ")");
    TORCH_CHECK(!out_int32,
                "searchsorted: out_int32=True is deferred; output is always int64 in this version");
    TORCH_CHECK(!right,
                "searchsorted: right=True is deferred; only left-side insertion is supported");
    return torch::empty(values.sizes(), values.options().dtype(torch::kInt64));
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("searchsorted", searchsorted_meta);
}

// ===================== 3. Tiling =====================

static std::tuple<int64_t, int64_t, int64_t>
calc_tiling_params(int64_t M, int64_t N, size_t bytesPerT)
{
    constexpr static int64_t MIN_QUERIES_PER_CORE = 1;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    constexpr static int64_t QUERIES_PER_TILE_PREFERRED = 32;
    constexpr static int64_t SCALAR_SLOT_BYTES = 32;

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "searchsorted: coreNum must be positive");

    int64_t numBlocks = std::min(coreNum,
        (M + MIN_QUERIES_PER_CORE - 1) / MIN_QUERIES_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (M + numBlocks - 1) / numBlocks;

    int64_t sortedBytes = N * static_cast<int64_t>(bytesPerT);
    int64_t bytesPerStagedQuery =
        static_cast<int64_t>(PIPELINE_DEPTH) * static_cast<int64_t>(bytesPerT)
      + SCALAR_SLOT_BYTES
      + static_cast<int64_t>(sizeof(int64_t));

    constexpr static int64_t SAFETY_MARGIN = 1024;
    int64_t budgetForStaging =
        static_cast<int64_t>(ubSize) - sortedBytes - SAFETY_MARGIN;
    TORCH_CHECK(budgetForStaging >= bytesPerStagedQuery,
                "searchsorted: N=", N, " too large for dav-3510 UB. sortedBytes=",
                sortedBytes, ", ubSize=", ubSize);

    int64_t queriesPerTile = budgetForStaging / bytesPerStagedQuery;
    if (queriesPerTile > QUERIES_PER_TILE_PREFERRED) {
        queriesPerTile = QUERIES_PER_TILE_PREFERRED;
    }
    if (queriesPerTile < 1) queriesPerTile = 1;
    if (queriesPerTile > blockLength) queriesPerTile = blockLength;

    return std::make_tuple(numBlocks, blockLength, queriesPerTile);
}

// ===================== 4. Kernel — 3-layer Reg shape =====================

// Layer 1: __simd_vf__ — LoadAlign sorted_sequence into a RegTensor, Compares<LT> against the
// query scalar, then Reduce<SUM> the trailing-fill-safe ones-vector under ltMask.
// Trailing-fill semantics: UpdateMask<T>(elementCount) restricts the valid lane range, and
// Compares<...>(..., validMask) leaves out-of-range lanes outside ltMask, so the trailing
// junk in sortedReg never contributes to the sum.
template <typename T>
__simd_vf__ inline void SearchsortedCountVf(
    __ubuf__ T *sortedPtr, T value, __ubuf__ T *countOutPtr,
    uint32_t elementCount)
{
    AscendC::Reg::RegTensor<T> sortedReg;
    AscendC::Reg::RegTensor<T> onesReg;
    AscendC::Reg::RegTensor<T> countReg;

    AscendC::Reg::MaskReg validMask = AscendC::Reg::UpdateMask<T>(elementCount);
    uint32_t scalarOne = 1;
    AscendC::Reg::MaskReg scalarMask = AscendC::Reg::UpdateMask<T>(scalarOne);

    AscendC::Reg::LoadAlign<T, AscendC::Reg::LoadDist::DIST_NORM>(sortedReg, sortedPtr);

    T oneValue;
    if constexpr (std::is_same_v<T, half>) {
        oneValue = T(1.0f);
    } else {
        oneValue = static_cast<T>(1);
    }
    AscendC::Reg::Duplicate<T, AscendC::Reg::MaskMergeMode::ZEROING>(
        onesReg, oneValue, validMask);

    AscendC::Reg::MaskReg ltMask;
    AscendC::Reg::Compares<T, AscendC::CMPMODE::LT>(
        ltMask, sortedReg, value, validMask);

    AscendC::Reg::Reduce<
        AscendC::Reg::ReduceType::SUM, T, T, AscendC::Reg::MaskMergeMode::ZEROING>(
            countReg, onesReg, ltMask);

    AscendC::Reg::StoreAlign<T, AscendC::Reg::StoreDist::DIST_NORM_B32>(
        countOutPtr, countReg, scalarMask);
}

// Layer 2: __aicore__ wrapper. LocalTensor -> __ubuf__ T* via GetPhyAddr; never reinterpret_cast
// on GM addresses (would page-fault inside the vf).
template <typename T>
__aicore__ inline void SearchsortedCount(
    AscendC::LocalTensor<T> &sortedUbufLT, T value,
    AscendC::LocalTensor<T> &scratchLT, uint32_t slotIdx,
    uint32_t elementCount)
{
    constexpr uint32_t SCALAR_SLOT_LANES_T = 32 / sizeof(T);
    __ubuf__ T *sortedPtr = (__ubuf__ T *)sortedUbufLT.GetPhyAddr();
    __ubuf__ T *outPtr    = (__ubuf__ T *)scratchLT.GetPhyAddr()
                            + slotIdx * SCALAR_SLOT_LANES_T;
    asc_vf_call<SearchsortedCountVf<T>>(sortedPtr, value, outPtr, elementCount);
}

// Layer 3: kernel class — DMA, sorted-once load, per-tile values stream, per-query vf, idx pack.
template <typename T>
class KernelSearchsortedReg {
public:
    __aicore__ inline KernelSearchsortedReg() {}

    __aicore__ inline void Init(GM_ADDR sortedSeq, GM_ADDR values, GM_ADDR indices,
        int64_t N, int64_t M, int64_t blockLength, uint32_t queriesPerTile)
    {
        sortedGm_.SetGlobalBuffer((__gm__ T *)sortedSeq);
        valuesGm_.SetGlobalBuffer((__gm__ T *)values);
        indicesGm_.SetGlobalBuffer((__gm__ int32_t *)indices);

        N_ = N;
        M_ = M;
        queriesPerTile_ = queriesPerTile;

        int64_t blockStart = blockLength * AscendC::GetBlockIdx();
        int64_t myBlockLength = M - blockStart;
        if (myBlockLength > blockLength) myBlockLength = blockLength;
        if (myBlockLength < 0) myBlockLength = 0;
        blockStart_ = blockStart;
        myBlockLength_ = myBlockLength;

        const uint32_t sortedBytes  = static_cast<uint32_t>(N * sizeof(T));
        const uint32_t valuesBytes  = queriesPerTile * static_cast<uint32_t>(sizeof(T));
        const uint32_t scratchBytes = queriesPerTile * 32u;
        const uint32_t outBytes     = queriesPerTile * static_cast<uint32_t>(sizeof(int64_t));

        pipe_.InitBuffer(tbufSorted_,                       sortedBytes);
        pipe_.InitBuffer(inQueueValues_,   PIPELINE_DEPTH,  valuesBytes);
        pipe_.InitBuffer(tbufScratch_,                      scratchBytes);
        pipe_.InitBuffer(outQueueIndices_, 1u,              outBytes);

        // One-time DataCopyPad sorted_sequence into UB; the persistent buffer is reused for
        // every query on this AIV.
        AscendC::LocalTensor<T> sortedLocal = tbufSorted_.template Get<T>();
        AscendC::DataCopyExtParams sortedCp;
        AscendC::DataCopyPadExtParams<T> sortedPad{false, 0, 0, 0};
        sortedCp.blockCount = 1;
        sortedCp.blockLen   = sortedBytes;
        sortedCp.srcStride  = 0;
        sortedCp.dstStride  = 0;
        AscendC::DataCopyPad(sortedLocal, sortedGm_, sortedCp, sortedPad);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void Process()
    {
        if (myBlockLength_ <= 0) return;
        int64_t consumed = 0;
        while (consumed < myBlockLength_) {
            int64_t tileCount = myBlockLength_ - consumed;
            if (tileCount > static_cast<int64_t>(queriesPerTile_)) {
                tileCount = queriesPerTile_;
            }
            ProcessTile(blockStart_ + consumed, tileCount);
            consumed += tileCount;
        }
    }

private:
    __aicore__ inline void ProcessTile(int64_t queryStart, int64_t count)
    {
        AscendC::LocalTensor<T> sortedLocal = tbufSorted_.template Get<T>();
        AscendC::LocalTensor<T> scratch     = tbufScratch_.template Get<T>();

        // Load this tile's query values.
        AscendC::LocalTensor<T> valuesLocal = inQueueValues_.template AllocTensor<T>();
        AscendC::DataCopyExtParams valuesCp;
        AscendC::DataCopyPadExtParams<T> valuesPad{false, 0, 0, 0};
        valuesCp.blockCount = 1;
        valuesCp.blockLen   = static_cast<uint32_t>(count * sizeof(T));
        valuesCp.srcStride  = 0;
        valuesCp.dstStride  = 0;
        AscendC::DataCopyPad(valuesLocal, valuesGm_[queryStart], valuesCp, valuesPad);
        inQueueValues_.EnQue(valuesLocal);
        valuesLocal = inQueueValues_.template DeQue<T>();
        AscendC::PipeBarrier<PIPE_ALL>();

        constexpr uint32_t SCALAR_SLOT_LANES_T = 32 / sizeof(T);

        for (int64_t q = 0; q < count; ++q) {
            T value = valuesLocal.GetValue(q);
            SearchsortedCount<T>(
                sortedLocal, value, scratch,
                static_cast<uint32_t>(q), static_cast<uint32_t>(N_));
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        inQueueValues_.FreeTensor(valuesLocal);

        // Pack T-typed counts -> int32 stride-2 layout (lane 0 = idx, lane 1 = 0).
        AscendC::LocalTensor<int32_t> outIdx = outQueueIndices_.template AllocTensor<int32_t>();
        for (int64_t q = 0; q < count; ++q) {
            T tval = scratch.GetValue(q * SCALAR_SLOT_LANES_T);
            int32_t idx;
            if constexpr (std::is_same_v<T, half>) {
                idx = static_cast<int32_t>(static_cast<float>(tval));
            } else {
                idx = static_cast<int32_t>(tval);
            }
            outIdx.SetValue(static_cast<int32_t>(2 * q),     idx);
            outIdx.SetValue(static_cast<int32_t>(2 * q + 1), 0);
        }
        outQueueIndices_.EnQue(outIdx);
        outIdx = outQueueIndices_.template DeQue<int32_t>();

        AscendC::DataCopyExtParams outCp;
        outCp.blockCount = 1;
        outCp.blockLen   = static_cast<uint32_t>(count * sizeof(int64_t));
        outCp.srcStride  = 0;
        outCp.dstStride  = 0;
        AscendC::DataCopyPad(indicesGm_[queryStart * 2], outIdx, outCp);
        outQueueIndices_.FreeTensor(outIdx);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> sortedGm_;
    AscendC::GlobalTensor<T> valuesGm_;
    AscendC::GlobalTensor<int32_t> indicesGm_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>                tbufSorted_;
    AscendC::TQue<AscendC::TPosition::VECIN,  PIPELINE_DEPTH> inQueueValues_;
    AscendC::TBuf<AscendC::TPosition::VECCALC>                tbufScratch_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1>              outQueueIndices_;
    int64_t N_ = 0;
    int64_t M_ = 0;
    int64_t blockStart_ = 0;
    int64_t myBlockLength_ = 0;
    uint32_t queriesPerTile_ = 0;
};

template <typename T>
__global__ __aicore__ __vector__ void searchsorted_kernel(
    GM_ADDR sortedSeq, GM_ADDR values, GM_ADDR indices,
    int64_t N, int64_t M, int64_t blockLength, uint32_t queriesPerTile)
{
    KernelSearchsortedReg<T> op;
    op.Init(sortedSeq, values, indices, N, M, blockLength, queriesPerTile);
    op.Process();
}

// ===================== 5. NPU dispatch =====================

torch::Tensor searchsorted_npu(
    const torch::Tensor &sorted_sequence, const torch::Tensor &values,
    bool out_int32, bool right)
{
    auto dtype = sorted_sequence.scalar_type();
    TORCH_CHECK(dtype == torch::kFloat32 ||
                dtype == torch::kFloat16 ||
                dtype == torch::kInt32,
                "searchsorted (RegBase): only float32 / float16 / int32 are supported, "
                "got ", dtype);
    TORCH_CHECK(values.scalar_type() == dtype,
                "searchsorted: sorted_sequence dtype (", dtype,
                ") must match values dtype (", values.scalar_type(), ")");
    TORCH_CHECK(sorted_sequence.dim() == 1,
                "searchsorted: only 1-D sorted_sequence is supported in this version, got ",
                sorted_sequence.dim(), "-D");
    TORCH_CHECK(!out_int32,
                "searchsorted: out_int32=True is deferred; output is always int64 in this version");
    TORCH_CHECK(!right,
                "searchsorted: right=True is deferred; only left-side insertion is supported");

    const int64_t N = sorted_sequence.size(0);
    // Per-dtype vec_width: VECTOR_REG_WIDTH / sizeof(T). dav-3510 vector reg = 256 bytes ->
    // fp32/int32 = 64 lanes, fp16 = 128 lanes. Larger N requires a chunked reduce path
    // (deferred to a follow-up).
    const int64_t vecWidth = (dtype == torch::kFloat16) ? 128 : 64;
    TORCH_CHECK(N <= vecWidth,
                "searchsorted: N=", N, " exceeds vec_width=", vecWidth, " for dtype ", dtype,
                "; chunked path is deferred");
    TORCH_CHECK(N <= static_cast<int64_t>(0x7fffffff),
                "searchsorted: N=", N, " exceeds INT32_MAX");

    const c10::OptionalDeviceGuard guard(sorted_sequence.device());
    auto sorted_contig = sorted_sequence.contiguous();
    auto values_contig = values.contiguous();
    auto values_flat   = values_contig.view({-1});
    const int64_t M    = values_flat.numel();

    auto indices_flat = torch::empty({M}, values_contig.options().dtype(torch::kInt64));
    auto indices      = indices_flat.view(values_contig.sizes());

    if (M == 0 || N == 0) {
        if (N == 0 && M > 0) {
            indices.zero_();
        }
        return indices;
    }

    const size_t bytesPerT =
        (dtype == torch::kFloat16) ? 2u : 4u;

    int64_t numBlocks, blockLength, queriesPerTile;
    std::tie(numBlocks, blockLength, queriesPerTile) =
        calc_tiling_params(M, N, bytesPerT);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto sorted_ptr  = (GM_ADDR)sorted_contig.data_ptr();
    auto values_ptr  = (GM_ADDR)values_flat.data_ptr();
    auto indices_ptr = (GM_ADDR)indices_flat.data_ptr();
    const uint32_t queriesPerTileU = static_cast<uint32_t>(queriesPerTile);

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            sorted_contig.scalar_type(), "searchsorted_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                searchsorted_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    sorted_ptr, values_ptr, indices_ptr,
                    N, M, blockLength, queriesPerTileU);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                searchsorted_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    sorted_ptr, values_ptr, indices_ptr,
                    N, M, blockLength, queriesPerTileU);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                searchsorted_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    sorted_ptr, values_ptr, indices_ptr,
                    N, M, blockLength, queriesPerTileU);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("Searchsorted", acl_call);

    return indices;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("searchsorted", searchsorted_npu);
}

} // namespace Searchsorted
} // namespace ops_multimodal_fusion
