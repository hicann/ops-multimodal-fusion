/*!
 * \file kaiserwindow.asc
 * \brief Kaiser window operator for Ascend NPU
 *
 *   w[n] = I0(beta · sqrt(max(0, 1 - t²))) / I0(beta),
 *       t = 2n / (N - 1) - 1
 *
 * Matches torch.kaiser_window(window_length, periodic, beta):
 *   - If periodic is true, PyTorch internally computes with N' = N + 1
 *     samples and drops the last; this kernel uses the same convention -
 *     caller must prepare an input index tensor of length
 *     N' = window_length + int(periodic) and slice the output to length
 *     window_length if periodic.
 *
 * I0(x) is the modified Bessel function of the first kind (order 0).
 * We evaluate it via Abramowitz & Stegun 9.8.1 / 9.8.2 (Hastings-style
 * rational approximations, peak relative error ~1.6e-7, good enough for
 * fp32):
 *
 *   Region 1 (x ~= 3.75):
 *       I0(x) ~= Σ Aₖ · (x/3.75)^{2k},  k = 0..6
 *
 *   Region 2 (x > 3.75):
 *       I0(x) · sqrt(x) · e^{-x} ~= Σ Bₖ · (3.75/x)^k,  k = 0..8
 *
 * SIMD strategy (matches erfcx.asc): each region is evaluated on a
 * clamped input (bx_c1 = min(bx, 3.75); bx_c2 = max(bx, 3.75)) so every
 * intermediate stays finite, then blended by a Relu-based hard step at
 * bx = 3.75.
 *
 * To make the window peak exactly 1.0, the host precomputes
 *   inv_i0_beta = 1 / I0(beta)
 * using the *same* A&S approximation as the kernel, so the ratio
 *   I0(bx) * inv_i0_beta
 * is exactly 1.0 when bx = beta.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <cmath>
#include <type_traits>

namespace ops_multimodal_fusion {
namespace KaiserWindow {

// ---- A&S 9.8 I0 coefficients (host-shared) ---------------------------------
static constexpr float KW_SPLIT = 3.75f;
static constexpr float KW_INV_SPLIT = 1.0f / 3.75f;

static constexpr float KW_A0 = 1.0f;
static constexpr float KW_A1 = 3.5156229f;
static constexpr float KW_A2 = 3.0899424f;
static constexpr float KW_A3 = 1.2067492f;
static constexpr float KW_A4 = 0.2659732f;
static constexpr float KW_A5 = 0.0360768f;
static constexpr float KW_A6 = 0.0045813f;

static constexpr float KW_B0 =  0.39894228f;
static constexpr float KW_B1 =  0.01328592f;
static constexpr float KW_B2 =  0.00225319f;
static constexpr float KW_B3 = -0.00157565f;
static constexpr float KW_B4 =  0.00916281f;
static constexpr float KW_B5 = -0.02057706f;
static constexpr float KW_B6 =  0.02635537f;
static constexpr float KW_B7 = -0.01647633f;
static constexpr float KW_B8 =  0.00392377f;

// Host-side I0 using the SAME approximation as the kernel, so that
// inv_i0_beta · I0_kernel(beta) = 1.0 exactly at the window peak.
static inline float kw_host_i0(float x)
{
    x = std::fabs(x);
    if (x <= KW_SPLIT) {
        const float t = x * KW_INV_SPLIT;
        const float tt = t * t;
        float p = KW_A6;
        p = p * tt + KW_A5;
        p = p * tt + KW_A4;
        p = p * tt + KW_A3;
        p = p * tt + KW_A2;
        p = p * tt + KW_A1;
        p = p * tt + KW_A0;
        return p;
    }
    const float t = KW_SPLIT / x;
    float p = KW_B8;
    p = p * t + KW_B7;
    p = p * t + KW_B6;
    p = p * t + KW_B5;
    p = p * t + KW_B4;
    p = p * t + KW_B3;
    p = p * t + KW_B2;
    p = p * t + KW_B1;
    p = p * t + KW_B0;
    return p * std::exp(x) / std::sqrt(x);
}

// 1. Schema registration
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("kaiserwindow(Tensor x, float beta, int window_length, bool periodic) -> Tensor");
}

// 2. Meta function
torch::Tensor kaiserwindow_meta(const torch::Tensor &x, double beta, int64_t window_length, bool periodic)
{
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("kaiserwindow", kaiserwindow_meta);
}

// 3. Tiling parameter calculation
std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t totalLength)
{
    constexpr static int64_t MIN_ELEMS_PER_CORE = 1024;
    constexpr static int64_t PIPELINE_DEPTH = 2;
    // 2 queues * PIPELINE_DEPTH + 4 TBuf scratch = 8 tile-sized buffers
    constexpr static int64_t TOTAL_BUFS = PIPELINE_DEPTH * 2 + 4;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t numBlocks = std::min(coreNum, (totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    numBlocks = std::max(numBlocks, static_cast<int64_t>(1));
    int64_t blockLength = (totalLength + numBlocks - 1) / numBlocks;
    int64_t tileSize = ubSize / TOTAL_BUFS;
    tileSize = (tileSize / 32) * 32; // 32B aligned
    return std::make_tuple(numBlocks, blockLength, tileSize);
}

// 4. Kernel implementation
class KernelKaiserWindow {
public:
    __aicore__ inline KernelKaiserWindow() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
        int64_t totalLength, int64_t blockLength, uint32_t tileSize,
        float invAlpha, float beta, float invI0Beta)
    {
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockLength * AscendC::GetBlockIdx());
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockLength * AscendC::GetBlockIdx());

        pipe_.InitBuffer(inQueueX_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(outQueueY_, PIPELINE_DEPTH, tileSize);
        pipe_.InitBuffer(tbufA_, tileSize);
        pipe_.InitBuffer(tbufB_, tileSize);
        pipe_.InitBuffer(tbufC_, tileSize);
        pipe_.InitBuffer(tbufD_, tileSize);

        invAlpha_   = invAlpha;
        beta_       = beta;
        invI0Beta_  = invI0Beta;

        int64_t currentBlockLength = totalLength - AscendC::GetBlockIdx() * blockLength;
        if (currentBlockLength > blockLength) {
            currentBlockLength = blockLength;
        }
        elementNumPerTile_ = tileSize / sizeof(float);
        tileNum_ = currentBlockLength / elementNumPerTile_;
        tailTileElementNum_ = currentBlockLength - tileNum_ * elementNumPerTile_;
    }

    __aicore__ inline void Process()
    {
        for (int64_t i = 0; i < tileNum_; ++i) {
            int64_t offset = i * elementNumPerTile_;
            CopyIn(offset, elementNumPerTile_);
            Compute(elementNumPerTile_);
            CopyOut(offset, elementNumPerTile_);
        }
        if (tailTileElementNum_ > 0) {
            int64_t offset = tileNum_ * elementNumPerTile_;
            CopyIn(offset, tailTileElementNum_);
            Compute(tailTileElementNum_);
            CopyOut(offset, tailTileElementNum_);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        AscendC::LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        const float STEP_SHARPNESS = 1.0e6f;

        AscendC::LocalTensor<float> xLocal = inQueueX_.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQueueY_.AllocTensor<float>();
        auto ta = tbufA_.Get<float>();
        auto tb = tbufB_.Get<float>();
        auto tc = tbufC_.Get<float>();
        auto td = tbufD_.Get<float>();

        // ---- Prologue: build bx = beta · sqrt(max(0, 1 - t²)), t = x * invAlpha - 1 ----
        // yLocal = t = x * invAlpha - 1   (temporary use of output buffer)
        AscendC::Muls(yLocal, xLocal, invAlpha_, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(yLocal, yLocal, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();

        // xLocal = t² (input indices no longer needed)
        AscendC::Mul(xLocal, yLocal, yLocal, count);
        AscendC::PipeBarrier<PIPE_V>();

        // xLocal = max(0, 1 - t²)
        AscendC::Muls(xLocal, xLocal, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(xLocal, xLocal, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(xLocal, xLocal, count);
        AscendC::PipeBarrier<PIPE_V>();

        // xLocal = sqrt(max(0, 1 - t²))
        AscendC::Sqrt(xLocal, xLocal, count);
        AscendC::PipeBarrier<PIPE_V>();

        // xLocal = bx = beta · sqrt(max(0, 1 - t²))   ∈ [0, beta]
        AscendC::Muls(xLocal, xLocal, beta_, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ==========================================================
        // Region 1: bx ~= 3.75
        //   I0_reg1 = Σ Aₖ · ((bx_c1/3.75)²)^k,  bx_c1 = min(bx, 3.75)
        // Result accumulates into yLocal.
        // ==========================================================
        // ta = bx_c1 = bx - Relu(bx - 3.75) = min(bx, 3.75)
        AscendC::Adds(ta, xLocal, -KW_SPLIT, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(ta, ta, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(ta, xLocal, ta, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ta = bx_c1 / 3.75
        AscendC::Muls(ta, ta, KW_INV_SPLIT, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ta = tt = (bx_c1 / 3.75)²   (Horner variable)
        AscendC::Mul(ta, ta, ta, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal = A6, then Horner: yLocal = yLocal * tt + Aₖ for k = 5..0
        AscendC::Duplicate(yLocal, KW_A6, count);
        AscendC::PipeBarrier<PIPE_V>();
#define KW_HORNER_STEP_A(COEF)                                                   \
        AscendC::Mul(yLocal, yLocal, ta, count);   AscendC::PipeBarrier<PIPE_V>(); \
        AscendC::Adds(yLocal, yLocal, (COEF), count); AscendC::PipeBarrier<PIPE_V>()
        KW_HORNER_STEP_A(KW_A5);
        KW_HORNER_STEP_A(KW_A4);
        KW_HORNER_STEP_A(KW_A3);
        KW_HORNER_STEP_A(KW_A2);
        KW_HORNER_STEP_A(KW_A1);
        KW_HORNER_STEP_A(KW_A0);
#undef KW_HORNER_STEP_A
        // yLocal now holds I0_reg1 (valid for bx ~= 3.75, clamped-region value otherwise).

        // ==========================================================
        // Region 2: bx > 3.75
        //   I0_reg2 = poly_B(3.75/bx_c2) · exp(bx_c2) / sqrt(bx_c2),
        //   bx_c2 = max(bx, 3.75)
        // Stored in tc.
        // ==========================================================
        // ta = bx_c2 = max(bx, 3.75) = 3.75 + Relu(bx - 3.75)
        AscendC::Adds(ta, xLocal, -KW_SPLIT, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(ta, ta, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(ta, ta, KW_SPLIT, count);       // ta = bx_c2
        AscendC::PipeBarrier<PIPE_V>();

        // tb = 3.75 / bx_c2   (Horner variable)
        AscendC::Duplicate(tb, KW_SPLIT, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(tb, tb, ta, count);
        AscendC::PipeBarrier<PIPE_V>();

        // tc = B8, then Horner: tc = tc * tb + Bₖ for k = 7..0
        AscendC::Duplicate(tc, KW_B8, count);
        AscendC::PipeBarrier<PIPE_V>();
#define KW_HORNER_STEP_B(COEF)                                               \
        AscendC::Mul(tc, tc, tb, count);    AscendC::PipeBarrier<PIPE_V>();  \
        AscendC::Adds(tc, tc, (COEF), count); AscendC::PipeBarrier<PIPE_V>()
        KW_HORNER_STEP_B(KW_B7);
        KW_HORNER_STEP_B(KW_B6);
        KW_HORNER_STEP_B(KW_B5);
        KW_HORNER_STEP_B(KW_B4);
        KW_HORNER_STEP_B(KW_B3);
        KW_HORNER_STEP_B(KW_B2);
        KW_HORNER_STEP_B(KW_B1);
        KW_HORNER_STEP_B(KW_B0);
#undef KW_HORNER_STEP_B
        // tc = poly_B(3.75 / bx_c2)

        // td = exp(bx_c2)
        AscendC::Exp(td, ta, count);
        AscendC::PipeBarrier<PIPE_V>();

        // tb = sqrt(bx_c2)   (reuse tb, 3.75/bx_c2 no longer needed)
        AscendC::Sqrt(tb, ta, count);
        AscendC::PipeBarrier<PIPE_V>();

        // tc = tc · exp(bx_c2)
        AscendC::Mul(tc, tc, td, count);
        AscendC::PipeBarrier<PIPE_V>();

        // tc = I0_reg2 = poly · exp(bx_c2) / sqrt(bx_c2)
        AscendC::Div(tc, tc, tb, count);
        AscendC::PipeBarrier<PIPE_V>();

        // ==========================================================
        // Blend: I0 = I0_reg1 + step(bx - 3.75) · (I0_reg2 - I0_reg1)
        // ==========================================================
        // ta = hard step: clamp((bx - 3.75) · SHARPNESS, 0, 1) via two Relus
        AscendC::Adds(ta, xLocal, -KW_SPLIT, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(ta, ta, STEP_SHARPNESS, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(ta, ta, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tb, ta, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(tb, tb, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Relu(tb, tb, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(tb, tb, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(ta, tb, 1.0f, count);           // ta = step
        AscendC::PipeBarrier<PIPE_V>();

        // tc = I0_reg2 - I0_reg1
        AscendC::Sub(tc, tc, yLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        // tc = step · (I0_reg2 - I0_reg1)
        AscendC::Mul(tc, tc, ta, count);
        AscendC::PipeBarrier<PIPE_V>();
        // yLocal = I0(bx) = I0_reg1 + step · (I0_reg2 - I0_reg1)
        AscendC::Add(yLocal, yLocal, tc, count);
        AscendC::PipeBarrier<PIPE_V>();

        // yLocal = I0(bx) / I0(beta)
        AscendC::Muls(yLocal, yLocal, invI0Beta_, count);
        AscendC::PipeBarrier<PIPE_V>();

        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        AscendC::LocalTensor<float> yLocal = outQueueY_.DeQue<float>();
        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        AscendC::DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQueueY_.FreeTensor(yLocal);
    }

    static constexpr int64_t PIPELINE_DEPTH = 2;
    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, PIPELINE_DEPTH> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, PIPELINE_DEPTH> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufA_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufB_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufC_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tbufD_;
    float invAlpha_  = 0.0f;
    float beta_      = 0.0f;
    float invI0Beta_ = 1.0f;
    int64_t elementNumPerTile_ = 0;
    int64_t tileNum_ = 0;
    int64_t tailTileElementNum_ = 0;
};

__global__ __aicore__ __vector__ void kaiserwindow_kernel(
    GM_ADDR x, GM_ADDR y,
    int64_t totalLength, int64_t blockLength, uint32_t tileSize,
    float invAlpha, float beta, float invI0Beta)
{
    KernelKaiserWindow op;
    op.Init(x, y, totalLength, blockLength, tileSize, invAlpha, beta, invI0Beta);
    op.Process();
}

// 5. NPU dispatch
torch::Tensor kaiserwindow_npu(const torch::Tensor &x, double beta, int64_t window_length, bool periodic)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto y = kaiserwindow_meta(x, beta, window_length, periodic);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    // Caller must prepare x as arange(window_length + int(periodic)) so the
    // formula's denominator (N' - 1) has the PyTorch-matching value.
    const int64_t effective_N = window_length + (periodic ? 1 : 0);
    TORCH_CHECK(x.numel() == effective_N,
        "kaiserwindow: x must have length window_length + int(periodic); got ",
        x.numel(), " vs expected ", effective_N);

    // inv_alpha = 2 / (N' - 1). When N' <= 1 the window is degenerate; the
    // caller is expected to short-circuit that case (torch.kaiser_window
    // returns ones({1}) for window_length == 1).
    const float invAlpha = (effective_N > 1)
        ? (2.0f / static_cast<float>(effective_N - 1))
        : 0.0f;
    const float betaF = static_cast<float>(beta);
    const float i0Beta = kw_host_i0(betaF);
    const float invI0Beta = (i0Beta > 0.0f) ? (1.0f / i0Beta) : 1.0f;

    int64_t totalLength = x.numel();
    int64_t numBlocks, blockLength, tileSize;
    std::tie(numBlocks, blockLength, tileSize) = calc_tiling_params(totalLength);

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "kaiserwindow_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                kaiserwindow_kernel<<<numBlocks, nullptr, stream>>>(
                    x_ptr, y_ptr, totalLength, blockLength, tileSize,
                    invAlpha, betaF, invI0Beta);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("KaiserWindow", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("kaiserwindow", kaiserwindow_npu);
}

} // namespace KaiserWindow
} // namespace ops_multimodal_fusion
