/*!
 * \file modified_bessel_k0.asc
 * \brief RegBase-form modified_bessel_k0 for Ascend NPU (dav-3510)
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <tuple>

namespace ops_multimodal_fusion {
namespace ModifiedBesselK0 {

constexpr int64_t BLOCK_BYTES = 32;
constexpr int64_t MIN_ELEMS_PER_CORE = 1024;

#define I0_SMALL_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, smallArgReg, qReg, mask);          \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

#define I0_LARGE_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, largeArgReg, qReg, mask);          \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

#define K0_SMALL_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, smallPolyArgReg, qReg, mask);      \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

#define K0_LARGE_STEP(COEFF)                                      \
    pReg = qReg;                                                  \
    qReg = currReg;                                               \
    AscendC::Reg::Mul(nextReg, largePolyArgReg, qReg, mask);      \
    AscendC::Reg::Sub(nextReg, nextReg, pReg, mask);              \
    AscendC::Reg::Adds(nextReg, nextReg, COEFF, mask);            \
    currReg = nextReg;

__simd_vf__ inline void ModifiedBesselI0RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg, absReg, smallArgReg, largeArgReg;
    AscendC::Reg::RegTensor<float> pReg, qReg, currReg, nextReg, smallResReg, largeResReg, tmpReg, sqrtReg;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg smallMask;
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::Abs(absReg, xReg, mask);

        AscendC::Reg::Muls(smallArgReg, absReg, 0.5f, mask);
        AscendC::Reg::Adds(smallArgReg, smallArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, -4.41534164647933937950e-18f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        I0_SMALL_STEP(+3.33079451882223809783e-17f)
        I0_SMALL_STEP(-2.43127984654795469359e-16f)
        I0_SMALL_STEP(+1.71539128555513303061e-15f)
        I0_SMALL_STEP(-1.16853328779934516808e-14f)
        I0_SMALL_STEP(+7.67618549860493561688e-14f)
        I0_SMALL_STEP(-4.85644678311192946090e-13f)
        I0_SMALL_STEP(+2.95505266312963983461e-12f)
        I0_SMALL_STEP(-1.72682629144155570723e-11f)
        I0_SMALL_STEP(+9.67580903537323691224e-11f)
        I0_SMALL_STEP(-5.18979560163526290666e-10f)
        I0_SMALL_STEP(+2.65982372468238665035e-9f)
        I0_SMALL_STEP(-1.30002500998624804212e-8f)
        I0_SMALL_STEP(+6.04699502254191894932e-8f)
        I0_SMALL_STEP(-2.67079385394061173391e-7f)
        I0_SMALL_STEP(+1.11738753912010371815e-6f)
        I0_SMALL_STEP(-4.41673835845875056359e-6f)
        I0_SMALL_STEP(+1.64484480707288970893e-5f)
        I0_SMALL_STEP(-5.75419501008210370398e-5f)
        I0_SMALL_STEP(+1.88502885095841655729e-4f)
        I0_SMALL_STEP(-5.76375574538582365885e-4f)
        I0_SMALL_STEP(+1.63947561694133579842e-3f)
        I0_SMALL_STEP(-4.32430999505057594430e-3f)
        I0_SMALL_STEP(+1.05464603945949983183e-2f)
        I0_SMALL_STEP(-2.37374148058994688156e-2f)
        I0_SMALL_STEP(+4.93052842396707084878e-2f)
        I0_SMALL_STEP(-9.49010970480476444210e-2f)
        I0_SMALL_STEP(+1.71620901522208775349e-1f)
        I0_SMALL_STEP(-3.04682672343198398683e-1f)
        I0_SMALL_STEP(+6.76795274409476084995e-1f)
        AscendC::Reg::Sub(smallResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(smallResReg, smallResReg, 0.5f, mask);
        AscendC::Reg::Exp(tmpReg, absReg, mask);
        AscendC::Reg::Mul(smallResReg, smallResReg, tmpReg, mask);

        AscendC::Reg::Duplicate<float>(tmpReg, 32.0f, mask);
        AscendC::Reg::Div(largeArgReg, tmpReg, absReg, mask);
        AscendC::Reg::Adds(largeArgReg, largeArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, -7.23318048787475395456e-18f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        I0_LARGE_STEP(-4.83050448594418207126e-18f)
        I0_LARGE_STEP(+4.46562142029675999901e-17f)
        I0_LARGE_STEP(+3.46122286769746109310e-17f)
        I0_LARGE_STEP(-2.82762398051658348494e-16f)
        I0_LARGE_STEP(-3.42548561967721913462e-16f)
        I0_LARGE_STEP(+1.77256013305652638360e-15f)
        I0_LARGE_STEP(+3.81168066935262242075e-15f)
        I0_LARGE_STEP(-9.55484669882830764870e-15f)
        I0_LARGE_STEP(-4.15056934728722208663e-14f)
        I0_LARGE_STEP(+1.54008621752140982691e-14f)
        I0_LARGE_STEP(+3.85277838274214270114e-13f)
        I0_LARGE_STEP(+7.18012445138366623367e-13f)
        I0_LARGE_STEP(-1.79417853150680611778e-12f)
        I0_LARGE_STEP(-1.32158118404477131188e-11f)
        I0_LARGE_STEP(-3.14991652796324136454e-11f)
        I0_LARGE_STEP(+1.18891471078464383424e-11f)
        I0_LARGE_STEP(+4.94060238822496958910e-10f)
        I0_LARGE_STEP(+3.39623202570838634515e-9f)
        I0_LARGE_STEP(+2.26666899049817806459e-8f)
        I0_LARGE_STEP(+2.04891858946906374183e-7f)
        I0_LARGE_STEP(+2.89137052083475648297e-6f)
        I0_LARGE_STEP(+6.88975834691682398426e-5f)
        I0_LARGE_STEP(+3.36911647825569408990e-3f)
        I0_LARGE_STEP(+8.04490411014108831608e-1f)
        AscendC::Reg::Sub(largeResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(largeResReg, largeResReg, 0.5f, mask);
        AscendC::Reg::Exp(tmpReg, absReg, mask);
        AscendC::Reg::Mul(largeResReg, largeResReg, tmpReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, absReg, mask);
        AscendC::Reg::Div(largeResReg, largeResReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(smallMask, absReg, 8.0f, mask);
        AscendC::Reg::Select<float>(tmpReg, smallResReg, largeResReg, smallMask);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, tmpReg, mask);
    }
}

__aicore__ inline void ModifiedBesselI0Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ModifiedBesselI0RegVf>(dstAddr, srcAddr, elementCount, chunkCount);
}

__simd_vf__ inline void ModifiedBesselK0RegVf(
    __ubuf__ float *dstAddr, __ubuf__ float *srcAddr, __ubuf__ float *i0Addr, uint32_t count, uint32_t chunkCount)
{
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    AscendC::Reg::RegTensor<float> xReg, i0Reg, pReg, qReg, currReg, nextReg;
    AscendC::Reg::RegTensor<float> smallPolyArgReg, largePolyArgReg, smallResReg, largeResReg, tmpReg, sqrtReg, outReg;
    const float infValue = INFINITY;
    const float nanValue = NAN;
    for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
        uint32_t remaining = count - chunk * vectorLength;
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::MaskReg branchMask;
        AscendC::Reg::MaskReg specialMask;
        uint32_t offset = chunk * vectorLength;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(xReg, srcAddr + offset);
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_NORM>(i0Reg, i0Addr + offset);

        AscendC::Reg::Mul(smallPolyArgReg, xReg, xReg, mask);
        AscendC::Reg::Adds(smallPolyArgReg, smallPolyArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, +1.37446543561352307156e-16f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        K0_SMALL_STEP(+4.25981614279661018399e-14f)
        K0_SMALL_STEP(+1.03496952576338420167e-11f)
        K0_SMALL_STEP(+1.90451637722020886025e-09f)
        K0_SMALL_STEP(+2.53479107902614945675e-07f)
        K0_SMALL_STEP(+2.28621210311945178607e-05f)
        K0_SMALL_STEP(+1.26461541144692592338e-03f)
        K0_SMALL_STEP(+3.59799365153615016266e-02f)
        K0_SMALL_STEP(+3.44289899924628486886e-01f)
        K0_SMALL_STEP(-5.35327393233902768720e-01f)
        AscendC::Reg::Sub(smallResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(smallResReg, smallResReg, 0.5f, mask);
        AscendC::Reg::Muls(tmpReg, xReg, 0.5f, mask);
        AscendC::Reg::Ln(tmpReg, tmpReg, mask);
        AscendC::Reg::Mul(tmpReg, tmpReg, i0Reg, mask);
        AscendC::Reg::Sub(smallResReg, smallResReg, tmpReg, mask);

        AscendC::Reg::Duplicate<float>(tmpReg, 8.0f, mask);
        AscendC::Reg::Div(largePolyArgReg, tmpReg, xReg, mask);
        AscendC::Reg::Adds(largePolyArgReg, largePolyArgReg, -2.0f, mask);
        AscendC::Reg::Duplicate<float>(currReg, +5.30043377268626276149e-18f, mask);
        AscendC::Reg::Duplicate<float>(pReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(qReg, 0.0f, mask);
        K0_LARGE_STEP(-1.64758043015242134646e-17f)
        K0_LARGE_STEP(+5.21039150503902756861e-17f)
        K0_LARGE_STEP(-1.67823109680541210385e-16f)
        K0_LARGE_STEP(+5.51205597852431940784e-16f)
        K0_LARGE_STEP(-1.84859337734377901440e-15f)
        K0_LARGE_STEP(+6.34007647740507060557e-15f)
        K0_LARGE_STEP(-2.22751332699166985548e-14f)
        K0_LARGE_STEP(+8.03289077536357521100e-14f)
        K0_LARGE_STEP(-2.98009692317273043925e-13f)
        K0_LARGE_STEP(+1.14034058820847496303e-12f)
        K0_LARGE_STEP(-4.51459788337394416547e-12f)
        K0_LARGE_STEP(+1.85594911495471785253e-11f)
        K0_LARGE_STEP(-7.95748924447710747776e-11f)
        K0_LARGE_STEP(+3.57739728140030116597e-10f)
        K0_LARGE_STEP(-1.69753450938905987466e-09f)
        K0_LARGE_STEP(+8.57403401741422608519e-09f)
        K0_LARGE_STEP(-4.66048989768794782956e-08f)
        K0_LARGE_STEP(+2.76681363944501510342e-07f)
        K0_LARGE_STEP(-1.83175552271911948767e-06f)
        K0_LARGE_STEP(+1.39498137188764993662e-05f)
        K0_LARGE_STEP(-1.28495495816278026384e-04f)
        K0_LARGE_STEP(+1.56988388573005337491e-03f)
        K0_LARGE_STEP(-3.14481013119645005427e-02f)
        K0_LARGE_STEP(+2.44030308206595545468e+00f)
        AscendC::Reg::Sub(largeResReg, currReg, pReg, mask);
        AscendC::Reg::Muls(largeResReg, largeResReg, 0.5f, mask);
        AscendC::Reg::Muls(tmpReg, xReg, -1.0f, mask);
        AscendC::Reg::Exp(tmpReg, tmpReg, mask);
        AscendC::Reg::Mul(largeResReg, largeResReg, tmpReg, mask);
        AscendC::Reg::Sqrt<float, AscendC::Reg::MaskMergeMode::ZEROING, AscendC::Reg::RegTensor<float>>(
            sqrtReg, xReg, mask);
        AscendC::Reg::Div(largeResReg, largeResReg, sqrtReg, mask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::LE>(branchMask, xReg, 2.0f, mask);
        AscendC::Reg::Select<float>(outReg, smallResReg, largeResReg, branchMask);

        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(specialMask, xReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, infValue, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, specialMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(specialMask, xReg, 0.0f, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, nanValue, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, specialMask);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::EQ>(specialMask, xReg, infValue, mask);
        AscendC::Reg::Duplicate<float>(tmpReg, 0.0f, mask);
        AscendC::Reg::Select<float>(outReg, tmpReg, outReg, specialMask);
        AscendC::Reg::Compare<float, AscendC::CMPMODE::NE>(specialMask, xReg, xReg, mask);
        AscendC::Reg::Select<float>(outReg, xReg, outReg, specialMask);

        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_NORM_B32>(dstAddr + offset, outReg, mask);
    }
}

__aicore__ inline void ModifiedBesselK0Reg(
    const AscendC::LocalTensor<float> &dst, const AscendC::LocalTensor<float> &src,
    const AscendC::LocalTensor<float> &i0, int64_t count)
{
    __ubuf__ float *dstAddr = (__ubuf__ float *)dst.GetPhyAddr();
    __ubuf__ float *srcAddr = (__ubuf__ float *)src.GetPhyAddr();
    __ubuf__ float *i0Addr = (__ubuf__ float *)i0.GetPhyAddr();
    constexpr uint32_t vectorLength = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    uint32_t elementCount = static_cast<uint32_t>(count);
    uint32_t chunkCount = (elementCount + vectorLength - 1) / vectorLength;
    asc_vf_call<ModifiedBesselK0RegVf>(dstAddr, srcAddr, i0Addr, elementCount, chunkCount);
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("modified_bessel_k0(Tensor x) -> Tensor");
}

torch::Tensor modified_bessel_k0_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "modified_bessel_k0 only supports float32");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("modified_bessel_k0", modified_bessel_k0_meta);
}

std::tuple<int64_t, int64_t, int64_t> calc_tiling_params(int64_t numel, int64_t elemSize)
{
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive");

    int64_t numBlocks = std::min(coreNum, (numel + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t blockLength = (numel + numBlocks - 1) / numBlocks;
    int64_t tileBytes = (static_cast<int64_t>(ubSize) / 6 / BLOCK_BYTES) * BLOCK_BYTES;
    if (tileBytes < BLOCK_BYTES) {
        tileBytes = BLOCK_BYTES;
    }
    int64_t tileElems = tileBytes / elemSize;
    if (tileElems < 8) {
        tileElems = 8;
    }
    return std::make_tuple(numBlocks, blockLength, tileElems);
}

class KernelModifiedBesselK0 {
public:
    __aicore__ inline KernelModifiedBesselK0() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
    {
        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalLength - blockIdx * blockLength;
        curLength_ = remaining < blockLength ? remaining : blockLength;
        if (curLength_ < 0) {
            curLength_ = 0;
        }
        tileLength_ = tileLength;
        xGm_.SetGlobalBuffer((__gm__ float*)x + blockIdx * blockLength);
        yGm_.SetGlobalBuffer((__gm__ float*)y + blockIdx * blockLength);

        int64_t tileBytes = ((tileLength_ * static_cast<int64_t>(sizeof(float)) + BLOCK_BYTES - 1) / BLOCK_BYTES) * BLOCK_BYTES;
        pipe_.InitBuffer(inQueue_, 2, tileBytes);
        pipe_.InitBuffer(outQueue_, 2, tileBytes);
        pipe_.InitBuffer(tmp0_, tileBytes);
        pipe_.InitBuffer(tmp1_, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (int64_t offset = 0; offset < curLength_; offset += tileLength_) {
            int64_t count = (curLength_ - offset < tileLength_) ? (curLength_ - offset) : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t count)
    {
        auto inLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(inLocal, xGm_[offset], p, pad);
        inQueue_.EnQue(inLocal);
    }

    __aicore__ inline void Compute(int64_t count)
    {
        auto inLocal = inQueue_.DeQue<float>();
        auto outLocal = outQueue_.AllocTensor<float>();
        auto i0Local = tmp0_.Get<float>();
        ModifiedBesselI0Reg(i0Local, inLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        ModifiedBesselK0Reg(outLocal, inLocal, i0Local, count);
        AscendC::PipeBarrier<PIPE_V>();
        inQueue_.FreeTensor(inLocal);
        outQueue_.EnQue(outLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t count)
    {
        auto outLocal = outQueue_.DeQue<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yGm_[offset], outLocal, p);
        outQueue_.FreeTensor(outLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<float> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp0_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_;
    int64_t curLength_ = 0;
    int64_t tileLength_ = 0;
};

__global__ __aicore__ __vector__ void modified_bessel_k0_kernel(
    GM_ADDR x, GM_ADDR y, int64_t totalLength, int64_t blockLength, int64_t tileLength)
{
    KernelModifiedBesselK0 op;
    op.Init(x, y, totalLength, blockLength, tileLength);
    op.Process();
}

torch::Tensor modified_bessel_k0_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "modified_bessel_k0 only supports float32");

    auto input = x.contiguous();
    auto y = torch::empty_like(input);
    int64_t totalLength = input.numel();
    if (totalLength == 0) {
        return y;
    }

    int64_t numBlocks, blockLength, tileLength;
    std::tie(numBlocks, blockLength, tileLength) = calc_tiling_params(totalLength, input.element_size());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto xPtr = (GM_ADDR)input.data_ptr();
    auto yPtr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        modified_bessel_k0_kernel<<<numBlocks, nullptr, stream>>>(xPtr, yPtr, totalLength, blockLength, tileLength);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("ModifiedBesselK0", acl_call);
    return y;
}

