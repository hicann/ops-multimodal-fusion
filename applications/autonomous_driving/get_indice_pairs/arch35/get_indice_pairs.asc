/*!
 * \file get_indice_pairs.asc
 * \brief Sparse-convolution submanifold index-pair neighbour lookup (Ascend C, SIMT, arch35 / Ascend950PR).
 *
 * torch.ops.ops_multimodal_fusion.get_indice_pairs_subm_lookup(coords, spatial_shape, ksize,
 *     dilation, sorted_enc, sorted_row) -> Tensor neighbor
 *   coords     : (N, ndim) int64 -- input voxel coordinates (row order == index order)
 *   spatial_shape / ksize / dilation : int lists, length ndim
 *   sorted_enc : (N,) int64  -- linear encodings of the input coords, ascending
 *                (enc_i = sum_d coords[i,d] * prod(spatial_shape[d+1:])), produced host-side by torch.sort
 *   sorted_row : (N,) int32  -- original input row of each sorted position (== torch.sort's indices)
 *   neighbor   : (N, K) int32 -- neighbor[i*K+k] = input row of the submanifold neighbour of voxel i
 *                under kernel offset k (row-major K = prod(ksize)), or -1 when the offset leaves the
 *                active voxel set.
 *
 * Semantics (aligns with mmcv_sparse_conv.py get_indice_pairs_pure, subm path):
 *   For every active voxel i and every kernel offset koff (row-major over ksize, dim-0 slowest):
 *     cand = coords[i] + (koff - center) * dilation          (center = (ksize-1)/2 per dim)
 *     if cand is within [0, spatial_shape) AND cand is an active voxel of the input set:
 *         neighbour[i, k] = the input row whose coords == cand
 *                          (== torch.sort's inverse permutation applied to the lower_bound position)
 *     else: neighbour[i, k] = -1
 *
 * This is the "kernel-lookup" half of a host-orchestrated submanifold convolution index-pair
 * generation (the model path mmcv_sparse_conv.py get_indice_pairs_fast). The host sorts the input
 * encodings once (torch.sort, O(N log N), cheap on NPU) and this kernel performs the (N*K)
 * batched membership / row lookups that torch.searchsorted does orders of magnitude slower on NPU.
 * Because every candidate lookup is an exact replica of the pure-torch lower_bound semantics, the
 * kernel output is bit-identical to the reference and downstream packing (per-k prefix ranks /
 * scatter, host-side cumsum/nonzero) stays unchanged -- the whole get_indice_pairs result remains
 * value-identical to get_indice_pairs_pure.
 *
 * Grid: 1-D grid-stride over the (N*K) pair space; one SIMT thread per pair. No atomics, no shared
 * memory, no cross-block communication. Lower-bound reads walk sorted_enc (shared by all threads ->
 * L2 friendly).
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>

// Workaround for a known ACL header collision (see ops-sparse REVIEW.md §5.2):
// torch_npu's bundled self-consistent ACL headers (torch_npu/include/third_party/
// acl/inc/acl/) quote-include "acl/acl_base_rt.h" / "acl/acl_base_mdl.h" relative
// paths that the compiler cannot resolve against that directory, so they fall
// through to the CANN toolkit's <ASCEND_HOME_PATH>/include/acl/ copies. The two
// sets share the INC_EXTERNAL_ACL_ACL_BASE_RT_H_ / INC_EXTERNAL_ACL_ACL_BASE_MODEL_H_
// include guards, but the CANN copies omit the `aclmdlRITask` typedef, which breaks
// compilation. Pre-including torch_npu's own copies here sets the guards (with the
// typedef present) before any torch_npu header pulls the toolkit's incompatible
// copies in, so they are skipped by the include guard.
// Guarded by __has_include: on toolchains whose torch_npu does not ship these bundled ACL
// headers there is no collision to work around and the relative path does not resolve.
#if __has_include("third_party/acl/inc/acl/acl_base_rt.h")
#include "third_party/acl/inc/acl/acl_base_rt.h"
#include "third_party/acl/inc/acl/acl_base_mdl.h"
#endif

#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "simt_api/asc_simt.h"
#include <algorithm>
#include <cstdint>
#include <tuple>
#include <vector>

using namespace AscendC;

namespace ops_multimodal_fusion {
namespace GetIndicePairsSubm {

constexpr int32_t SIMT_THREADS = 2048;
constexpr int32_t MAX_NDIM = 4;

// C1 (addmv.asc convention): every argument check lives here, runs host-side and synchronously,
// before any device work or kernel launch.
static void gip_subm_check(const torch::Tensor &coords, at::IntArrayRef spatialShape,
                           at::IntArrayRef ksize, at::IntArrayRef dilation,
                           const torch::Tensor &sortedEnc, const torch::Tensor &sortedRow,
                           int64_t *outN, int64_t *outK, bool checkDevice)
{
    // K1 dims
    TORCH_CHECK(coords.dim() == 2, "get_indice_pairs_subm_lookup: coords must be 2-D (N, ndim), got ",
                coords.dim(), "-D");
    TORCH_CHECK(sortedEnc.dim() == 1, "get_indice_pairs_subm_lookup: sorted_enc must be 1-D, got ",
                sortedEnc.dim(), "-D");
    TORCH_CHECK(sortedRow.dim() == 1, "get_indice_pairs_subm_lookup: sorted_row must be 1-D, got ",
                sortedRow.dim(), "-D");
    const int64_t ndim = coords.size(1);
    const int64_t N = coords.size(0);
    TORCH_CHECK(ndim >= 1 && ndim <= MAX_NDIM,
                "get_indice_pairs_subm_lookup: ndim (coords.size(1)) must be in [1, ", MAX_NDIM,
                "], got ", ndim);
    TORCH_CHECK(spatialShape.size() == static_cast<size_t>(ndim),
                "get_indice_pairs_subm_lookup: spatial_shape must have ndim entries (", ndim,
                "), got ", spatialShape.size());
    TORCH_CHECK(ksize.size() == static_cast<size_t>(ndim),
                "get_indice_pairs_subm_lookup: ksize must have ndim entries (", ndim,
                "), got ", ksize.size());
    TORCH_CHECK(dilation.size() == static_cast<size_t>(ndim),
                "get_indice_pairs_subm_lookup: dilation must have ndim entries (", ndim,
                "), got ", dilation.size());
    // K2 length consistency
    TORCH_CHECK(N > 0, "get_indice_pairs_subm_lookup: N (coords.size(0)) must be positive, got ", N);
    TORCH_CHECK(sortedEnc.size(0) == N,
                "get_indice_pairs_subm_lookup: sorted_enc length (", sortedEnc.size(0),
                ") must equal N (", N, ")");
    TORCH_CHECK(sortedRow.size(0) == N,
                "get_indice_pairs_subm_lookup: sorted_row length (", sortedRow.size(0),
                ") must equal N (", N, ")");
    // K3 parameter positivity / int32 range (kernel offset arithmetic uses int32)
    int64_t K = 1;
    for (size_t d = 0; d < ksize.size(); ++d) {
        TORCH_CHECK(ksize[d] >= 1, "get_indice_pairs_subm_lookup: ksize[", d, "] must be >= 1, got ",
                    ksize[d]);
        TORCH_CHECK(spatialShape[d] >= 1, "get_indice_pairs_subm_lookup: spatial_shape[", d,
                    "] must be >= 1, got ", spatialShape[d]);
        TORCH_CHECK(dilation[d] >= 1, "get_indice_pairs_subm_lookup: dilation[", d,
                    "] must be >= 1, got ", dilation[d]);
        TORCH_CHECK(ksize[d] < static_cast<int64_t>(INT32_MAX),
                    "get_indice_pairs_subm_lookup: ksize[", d, "] (", ksize[d], ") exceeds int32 range");
        TORCH_CHECK(spatialShape[d] < static_cast<int64_t>(INT32_MAX),
                    "get_indice_pairs_subm_lookup: spatial_shape[", d, "] (", spatialShape[d],
                    ") exceeds int32 range");
        K *= ksize[d];
    }
    TORCH_CHECK(K < static_cast<int64_t>(INT32_MAX),
                "get_indice_pairs_subm_lookup: kernel volume K (", K, ") exceeds int32 range");
    TORCH_CHECK(N < static_cast<int64_t>(INT32_MAX) / 8,
                "get_indice_pairs_subm_lookup: N (", N, ") too large for int32 index bookkeeping");
    // K4 dtypes -- reject here, not via a dispatch fallback.
    TORCH_CHECK(coords.scalar_type() == torch::kLong,
                "get_indice_pairs_subm_lookup: coords must be int64, got ", coords.scalar_type());
    TORCH_CHECK(sortedEnc.scalar_type() == torch::kLong,
                "get_indice_pairs_subm_lookup: sorted_enc must be int64, got ", sortedEnc.scalar_type());
    TORCH_CHECK(sortedRow.scalar_type() == torch::kInt,
                "get_indice_pairs_subm_lookup: sorted_row must be int32, got ", sortedRow.scalar_type());
    // K5 contiguity -- kernel does raw pointer arithmetic.
    TORCH_CHECK(coords.is_contiguous(), "get_indice_pairs_subm_lookup: coords must be contiguous");
    TORCH_CHECK(sortedEnc.is_contiguous(), "get_indice_pairs_subm_lookup: sorted_enc must be contiguous");
    TORCH_CHECK(sortedRow.is_contiguous(), "get_indice_pairs_subm_lookup: sorted_row must be contiguous");
    // K6 device
    if (checkDevice) {
        TORCH_CHECK(coords.device().is_privateuseone(),
                    "get_indice_pairs_subm_lookup: coords must be on an NPU device, got ",
                    coords.device());
        TORCH_CHECK(sortedEnc.device() == coords.device() && sortedRow.device() == coords.device(),
                    "get_indice_pairs_subm_lookup: sorted_enc/sorted_row must be on the same device "
                    "as coords");
    }
    *outN = N;
    *outK = K;
}

// 1. schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("get_indice_pairs_subm_lookup(Tensor coords, int[] spatial_shape, int[] ksize, "
          "int[] dilation, Tensor sorted_enc, Tensor sorted_row) -> Tensor");
}

// 2. meta: neighbour buffer (N, K) int32
torch::Tensor gip_subm_meta(const torch::Tensor &coords, at::IntArrayRef spatialShape,
                            at::IntArrayRef ksize, at::IntArrayRef dilation,
                            const torch::Tensor &sortedEnc, const torch::Tensor &sortedRow)
{
    int64_t N = 0, K = 0;
    gip_subm_check(coords, spatialShape, ksize, dilation, sortedEnc, sortedRow, &N, &K,
                   /*checkDevice=*/false);
    auto opts = coords.options().dtype(at::kInt);
    return torch::empty({N, K}, opts);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("get_indice_pairs_subm_lookup", gip_subm_meta);
}

// 3. tiling: dynamic core count (R2), no TPipe member (R3), scalars not arrays (R4).
std::tuple<int64_t, int64_t> calc_tiling(int64_t NK)
{
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = platform->GetCoreNumAiv();
    if (coreNum <= 0) {
        coreNum = 1;
    }
    int64_t numBlocks = std::min<int64_t>(coreNum, (NK + SIMT_THREADS - 1) / SIMT_THREADS);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    int64_t threadsX = SIMT_THREADS;
    if (NK < threadsX) {
        threadsX = std::max<int64_t>(1, NK);
    }
    return std::make_tuple(numBlocks, threadsX);
}

// 4. Per-pair submanifold lookup kernel.
//
// One SIMT thread owns one (i, k) pair: it computes the candidate coordinate
// cand = coords[i] + (koff - center) * dilation, rejects out-of-range candidates, linear-encodes
// cand with the mixed-radix multipliers derived from spatial_shape (dim-0 slowest, identical to the
// host-side enc = sum_d coord[d] * prod(spatial_shape[d+1:])), then lower-bounds sorted_enc to test
// membership. On a hit it emits sorted_row[lower_bound] -- the original row of the neighbour voxel.
// koff is the row-major (dim-0 slowest) mixed-radix decomposition of k, matching the pure-torch
// _kernel_offsets flattening.
__simt_vf__ __aicore__ LAUNCH_BOUND(SIMT_THREADS) inline void GipSubmLookup(
    __gm__ const int64_t *coords, __gm__ const int64_t *params, __gm__ const int64_t *sortedEnc,
    __gm__ const int32_t *sortedRow, __gm__ int32_t *neighbor, int64_t N, int32_t ndim, int32_t K)
{
    const int32_t tx = Simt::GetThreadIdx<0>();
    const int32_t tnumX = Simt::GetThreadNum<0>();
    const int32_t blockIdx = Simt::GetBlockIdx();
    const int32_t blockNum = Simt::GetBlockNum();
    const int64_t totalThreads = static_cast<int64_t>(blockNum) * tnumX;
    const int64_t NK = N * static_cast<int64_t>(K);

    // params packs shape / ksize / dilation as three MAX_NDIM-length blocks (host side pads).
    int64_t shapeL[MAX_NDIM];
    int64_t ksizeL[MAX_NDIM];
    int64_t dilL[MAX_NDIM];
#pragma unroll
    for (int32_t d = 0; d < MAX_NDIM; ++d) {
        shapeL[d] = params[d];
        ksizeL[d] = params[MAX_NDIM + d];
        dilL[d] = params[2 * MAX_NDIM + d];
    }

    for (int64_t p = tx + static_cast<int64_t>(blockIdx) * tnumX; p < NK; p += totalThreads) {
        const int64_t i = p / K;
        int32_t krem = static_cast<int32_t>(p - i * K);
        int32_t koff[MAX_NDIM];
        for (int32_t d = ndim - 1; d >= 0; --d) {
            koff[d] = krem % static_cast<int32_t>(ksizeL[d]);
            krem /= static_cast<int32_t>(ksizeL[d]);
        }
        const __gm__ int64_t *crow = coords + i * ndim;
        int64_t code = 0;
        bool inRange = true;
        for (int32_t d = 0; d < ndim; ++d) {
            const int64_t center = (ksizeL[d] - 1) / 2;
            const int64_t cd = crow[d] + (static_cast<int64_t>(koff[d]) - center) * dilL[d];
            if (cd < 0 || cd >= shapeL[d]) {
                inRange = false;
                break;
            }
            code = code * shapeL[d] + cd;
        }
        int32_t res = -1;
        if (inRange) {
            // lower_bound(sorted_enc, code): first position whose key >= code.
            int64_t lo = 0;
            int64_t hi = N;
            while (lo < hi) {
                const int64_t mid = (lo + hi) >> 1;
                if (sortedEnc[mid] < code) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            if (lo < N && sortedEnc[lo] == code) {
                res = sortedRow[lo];
            }
        }
        neighbor[p] = res;
    }
}

// 5. Kernel dispatcher (1-D grid over pairs).
__global__ __aicore__ __vector__ void gip_subm_lookup_kernel(
    GM_ADDR coords, GM_ADDR params, GM_ADDR sortedEnc, GM_ADDR sortedRow, GM_ADDR neighbor,
    int64_t N, int32_t ndim, int32_t K, int64_t threadsX)
{
    const __gm__ int64_t *coordsGm = reinterpret_cast<const __gm__ int64_t *>(coords);
    const __gm__ int64_t *paramsGm = reinterpret_cast<const __gm__ int64_t *>(params);
    const __gm__ int64_t *encGm = reinterpret_cast<const __gm__ int64_t *>(sortedEnc);
    const __gm__ int32_t *rowGm = reinterpret_cast<const __gm__ int32_t *>(sortedRow);
    __gm__ int32_t *nbrGm = reinterpret_cast<__gm__ int32_t *>(neighbor);
    asc_vf_call<GipSubmLookup>(dim3(static_cast<uint32_t>(threadsX), 1, 1), coordsGm, paramsGm,
                               encGm, rowGm, nbrGm, N, ndim, K);
}

// 6. NPU dispatch
torch::Tensor gip_subm_npu(const torch::Tensor &coords, at::IntArrayRef spatialShape,
                           at::IntArrayRef ksize, at::IntArrayRef dilation,
                           const torch::Tensor &sortedEnc, const torch::Tensor &sortedRow)
{
    int64_t N = 0, K = 0;
    // C1: all validation first, synchronously, before any device operation or launch.
    gip_subm_check(coords, spatialShape, ksize, dilation, sortedEnc, sortedRow, &N, &K,
                   /*checkDevice=*/true);

    // R1 (review mandatory, HIGH): sorted_row value range. The kernel writes sorted_row[lower_bound]
    // straight into neighbour, and downstream code uses neighbour as a row index into the input
    // features; an out-of-range value would silently propagate a bad index. Reduce on-device
    // (amin/amax) and pull both scalars with ONE host sync.
    {
        auto agg = torch::stack({sortedRow.min(), sortedRow.max()}).cpu();
        const auto *iv = agg.data_ptr<int32_t>();
        const int64_t lo = iv[0];
        const int64_t hi = iv[1];
        TORCH_CHECK(lo >= 0 && hi < N,
                    "get_indice_pairs_subm_lookup: sorted_row must be in [0, N=", N,
                    ") -- got range [", lo, ", ", hi, "]");
    }

    const c10::OptionalDeviceGuard guard(coords.device());

    auto neighbor = gip_subm_meta(coords, spatialShape, ksize, dilation, sortedEnc, sortedRow);
    const int64_t ndim = coords.size(1);
    const int64_t NK = N * K;

    // Build the small device-side params buffer (shape | ksize | dilation, each MAX_NDIM wide).
    std::vector<int64_t> paramsVec(3 * MAX_NDIM, 0);
    for (size_t d = 0; d < ksize.size(); ++d) {
        paramsVec[d] = spatialShape[d];
        paramsVec[MAX_NDIM + d] = ksize[d];
        paramsVec[2 * MAX_NDIM + d] = dilation[d];
    }
    // NOTE: build the params buffer on CPU first (TensorOptions WITHOUT a device), then copy H2D.
    // Passing coords.options() (device = NPU) to from_blob would treat the host paramsVec pointer as
    // a device address and the .clone() would issue an invalid D2D memcpy.
    auto paramsOpts = torch::TensorOptions().dtype(at::kLong);
    auto paramsCpu = torch::from_blob(paramsVec.data(), {static_cast<int64_t>(3 * MAX_NDIM)},
                                      paramsOpts)
                         .clone();
    auto paramsDev = paramsCpu.to(coords.device());

    int64_t numBlocks, threadsX;
    std::tie(numBlocks, threadsX) = calc_tiling(NK);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto acl_call = [=]() -> int {
        gip_subm_lookup_kernel<<<numBlocks, nullptr, stream>>>(
            (GM_ADDR)coords.data_ptr(), (GM_ADDR)paramsDev.data_ptr(),
            (GM_ADDR)sortedEnc.data_ptr(), (GM_ADDR)sortedRow.data_ptr(),
            (GM_ADDR)neighbor.data_ptr(), N, static_cast<int32_t>(ndim),
            static_cast<int32_t>(K), threadsX);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("GetIndicePairsSubmLookup", acl_call);
    return neighbor;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("get_indice_pairs_subm_lookup", gip_subm_npu);
}

} // namespace GetIndicePairsSubm
} // namespace ops_multimodal_fusion
