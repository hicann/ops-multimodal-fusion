/*!
 * \file indice_conv.asc
 * \brief Sparse-convolution indice_conv Ascend C operator (SIMT model, arch35 / Ascend950PR).
 *
 * torch.ops.ops_multimodal_fusion.indice_conv(gathered, filters, k_idx, s_idx, P) -> Tensor
 *   gathered : (P, C_in),  fp32 / fp16
 *   filters  : (K, C_in, C_out), same dtype as gathered
 *   k_idx    : (P,) int32  -- kernel-offset index of each pair. REQUIRED: 0 <= k_idx[p] < K
 *                             (K = filters.size(0)); validated host-side, OOB rejects.
 *   s_idx    : (P,) int32  -- destination row (in the P-row output) of each pair.
 *                             REQUIRED: 0 <= s_idx[p] < P AND s_idx duplicate-free
 *                             (injective) -- see Contract below.
 *   P        : pair count
 *   out      : (P, C_out), same dtype -- partial[s_idx[p]] = gathered[p] @ filters[k_idx[p]]
 *
 * Contract (the NPU dispatch enforces items 1-2; item 3 is by contract only):
 *   1. k_idx[p] in [0, K) and s_idx[p] in [0, P) for every p.  Enforced in the NPU
 *      dispatch (indice_conv_npu) before any kernel work: on-device amin/amax reduced and
 *      pulled with a single host sync. An OOB value would otherwise silently read/write GM
 *      outside gathered / filters / partial (see indice_conv_check R1).
 *   2. P == gathered.size(0) == k_idx.size(0) == s_idx.size(0) (structural checks).
 *   3. s_idx MUST have NO duplicate entries. The kernel writes partial[s_idx[p]] from SIMT
 *      threads in parallel; two pairs with an equal s_idx race on the same output row
 *      (non-atomic, not even deterministic last-writer-wins) -> the result is UNDEFINED.
 *      This is the "kernel-compute" half of a host-gather sparse conv, so the supported
 *      caller (mmcv_sparse_conv.build_k) passes s_idx = identity (0..P-1), which is
 *      injective and therefore safe. Any other caller must supply an injective s_idx.
 *
 * Semantics (aligns with mmcv_sparse_conv.py indice_conv_fast):
 *   output[s_idx[p], :] = gathered[p, :] @ filters[k_idx[p], :, :]
 *
 * This is the "kernel-compute" half of a host-gather + kernel-compute sparse
 * convolution (the model passes s_idx = identity so the returned partial is a
 * plain (P, C_out) per-pair matmul result that the host scatters into the output
 * voxel buffer via index_add_).
 *
 * Design: per-pair SIMT matmul. The valid (input, output, kernel-offset) triples
 * arrive k-major (indice_pairs is (K, 2, N)), so consecutive threads read the
 * same filter matrix -> L2 locality. Each thread owns one pair and a 16-channel
 * block (y grid) so the accumulator stays in 16 registers (a full C_out-wide
 * accumulator blows the SIMT register budget for C_out=32/64 -> vector core
 * exception). The store to the partial buffer is indexed through s_idx so the
 * compiler cannot prove the store address is affine in the pair loop and
 * vectorize it into an illegal strided vector store (which faults the vector
 * core on this arch).
 *
 * The compute function is templated on C_OUT (compile-time) so the accumulator
 * lives in registers and the inner loops unroll. A generic fallback (thread per
 * pair, scalar per output channel) covers any other C_out and fp16.
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>

// Workaround for a known ACL header collision (see ops-sparse REVIEW.md §5.2):
// torch_npu's bundled self-consistent ACL headers (torch_npu/include/third_party/
// acl/inc/acl/) quote-include "acl/acl_base_rt.h" / "acl/acl_base_mdl.h" relative
// paths that the compiler cannot resolve against that directory, so they fall
// through to the CANN toolkit's <ASCEND_HOME_PATH>/include/acl/ copies. The two
// sets share the INC_EXTERNAL_ACL_ACL_BASE_RT_H_ / INC_EXTERNAL_ACL_ACL_BASE_MODEL_H_
// include guards, but the CANN copies omit the `aclmdlRITask` typedef, which breaks
// compilation. Pre-including torch_npu's own copies here sets the guards (with the
// typedef present) before any torch_npu header pulls the toolkit's incompatible
// copies in, so they are skipped by the include guard.
// Guarded by __has_include: on toolchains whose torch_npu does not ship these bundled ACL
// headers there is no collision to work around and the relative path does not resolve.
#if __has_include("third_party/acl/inc/acl/acl_base_rt.h")
#include "third_party/acl/inc/acl/acl_base_rt.h"
#include "third_party/acl/inc/acl/acl_base_mdl.h"
#endif

#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "simt_api/asc_simt.h"
#include <algorithm>
#include <cstdint>
#include <tuple>
#include <type_traits>

using namespace AscendC;

namespace ops_multimodal_fusion {
namespace IndiceConv {

constexpr int32_t SIMT_THREADS = 2048;
constexpr int32_t BLK = 16;                       // register accumulator width per thread (channels)

// Fused multiply-add accumulation. float uses the SIMT fmaf intrinsic; other
// dtypes fall back to mul+add.
template <typename T>
__aicore__ inline T FmaAcc(T a, T b, T acc)
{
    return a * b + acc;
}

template <>
__aicore__ inline float FmaAcc<float>(float a, float b, float acc)
{
    return fmaf(a, b, acc);
}

// Hard constraint C1 (addmv.asc): every argument check lives here, runs host-side
// and synchronously, before any device work or kernel launch. AT_DISPATCH_SWITCH
// therefore only ever maps an already validated dtype to a template instance.
static void indice_conv_check(const torch::Tensor &gathered, const torch::Tensor &filters,
                              const torch::Tensor &k_idx, const torch::Tensor &s_idx,
                              int64_t P, bool checkDevice)
{
    // K1 dims
    TORCH_CHECK(gathered.dim() == 2, "indice_conv: gathered must be 2-D (P, C_in), got ",
                gathered.dim(), "-D");
    TORCH_CHECK(filters.dim() == 3, "indice_conv: filters must be 3-D (K, C_in, C_out), got ",
                filters.dim(), "-D");
    TORCH_CHECK(k_idx.dim() == 1, "indice_conv: k_idx must be 1-D, got ", k_idx.dim(), "-D");
    TORCH_CHECK(s_idx.dim() == 1, "indice_conv: s_idx must be 1-D, got ", s_idx.dim(), "-D");
    // K2 length consistency
    TORCH_CHECK(P >= 0, "indice_conv: P must be non-negative, got ", P);
    TORCH_CHECK(gathered.size(0) == P,
                "indice_conv: gathered rows (", gathered.size(0), ") must equal P (", P, ")");
    TORCH_CHECK(k_idx.size(0) == P,
                "indice_conv: k_idx length (", k_idx.size(0), ") must equal P (", P, ")");
    TORCH_CHECK(s_idx.size(0) == P,
                "indice_conv: s_idx length (", s_idx.size(0), ") must equal P (", P, ")");
    TORCH_CHECK(filters.size(1) == gathered.size(1),
                "indice_conv: filters C_in (", filters.size(1),
                ") must match gathered C_in (", gathered.size(1), ")");
    TORCH_CHECK(filters.size(2) > 0, "indice_conv: C_out must be positive, got ", filters.size(2));
    // K3 int32 range (kernel indices are int32)
    TORCH_CHECK(P < static_cast<int64_t>(INT32_MAX),
                "indice_conv: P (", P, ") exceeds int32 range");
    TORCH_CHECK(gathered.size(1) < static_cast<int64_t>(INT32_MAX),
                "indice_conv: C_in (", gathered.size(1), ") exceeds int32 range");
    TORCH_CHECK(filters.size(2) < static_cast<int64_t>(INT32_MAX),
                "indice_conv: C_out (", filters.size(2), ") exceeds int32 range");
    // K4 dtype whitelist -- C1 core item, must reject here and not via AT_DISPATCH fallback.
    TORCH_CHECK(gathered.scalar_type() == torch::kFloat32 || gathered.scalar_type() == torch::kFloat16,
                "indice_conv: only float32 and float16 are supported, got ", gathered.scalar_type());
    TORCH_CHECK(filters.scalar_type() == gathered.scalar_type(),
                "indice_conv: filters dtype must match gathered dtype, got ",
                filters.scalar_type());
    TORCH_CHECK(k_idx.scalar_type() == torch::kInt32,
                "indice_conv: k_idx must be int32, got ", k_idx.scalar_type());
    TORCH_CHECK(s_idx.scalar_type() == torch::kInt32,
                "indice_conv: s_idx must be int32, got ", s_idx.scalar_type());
    // K5 contiguity -- kernel does raw pointer arithmetic on these tensors.
    TORCH_CHECK(gathered.is_contiguous(), "indice_conv: gathered must be contiguous");
    TORCH_CHECK(filters.is_contiguous(), "indice_conv: filters must be contiguous");
    TORCH_CHECK(k_idx.is_contiguous(), "indice_conv: k_idx must be contiguous");
    TORCH_CHECK(s_idx.is_contiguous(), "indice_conv: s_idx must be contiguous");
    // K6 device
    if (checkDevice) {
        TORCH_CHECK(gathered.device().is_privateuseone(),
                    "indice_conv: gathered must be on an NPU device, got ", gathered.device());
        TORCH_CHECK(filters.device() == gathered.device() && k_idx.device() == gathered.device() &&
                        s_idx.device() == gathered.device(),
                    "indice_conv: filters, k_idx and s_idx must be on the same device as gathered");
    }
    // R1 (review mandatory, HIGH): k_idx / s_idx value ranges. The kernel indexes GM
    // buffers directly with these values (filter row k_idx[p], partial row s_idx[p]), so an
    // out-of-range value would silently read/write GM out of bounds (wrong results, or
    // corruption of an adjacent tensor). Reduce on-device (amin/amax) and pull all four
    // scalars with ONE host sync (stack -> single .cpu()): the model path already
    // synchronises immediately before calling this op, so this is a short extra drain, not a
    // new pipeline bubble. Runs only in the NPU dispatch (checkDevice=true): the Meta path
    // operates on meta tensors that carry no data and cannot be reduced.
    // P == 0 means k_idx/s_idx are empty -- there is nothing to validate, and NPU amin/amax
    // over an empty tensor is not a safe sentinel, so the guard must be explicit.
    if (checkDevice && P > 0) {
        auto agg = torch::stack({k_idx.min(), k_idx.max(),
                                 s_idx.min(), s_idx.max()})
                       .cpu();  // one host sync
        const auto *iv = agg.data_ptr<int32_t>();
        const int64_t kLo = iv[0], kHi = iv[1], sLo = iv[2], sHi = iv[3];
        TORCH_CHECK(kLo >= 0 && kHi < filters.size(0),
                    "indice_conv: k_idx must be in [0, K=", filters.size(0),
                    ") -- got k_idx range [", kLo, ", ", kHi, "]");
        TORCH_CHECK(sLo >= 0 && sHi < P,
                    "indice_conv: s_idx must be in [0, P=", P,
                    ") -- got s_idx range [", sLo, ", ", sHi, "]");
    }
}

// 1. schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("indice_conv(Tensor gathered, Tensor filters, Tensor k_idx, Tensor s_idx, int P) -> Tensor");
}

// 2. meta: output (P, C_out)
torch::Tensor indice_conv_meta(const torch::Tensor &gathered, const torch::Tensor &filters,
                               const torch::Tensor &k_idx, const torch::Tensor &s_idx,
                               int64_t P)
{
    indice_conv_check(gathered, filters, k_idx, s_idx, P, /*checkDevice=*/false);
    auto C_out = filters.size(2);
    return torch::zeros({P, C_out}, gathered.options());
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("indice_conv", indice_conv_meta);
}

// 3. tiling: dynamic core count (R2), no TPipe member (R3), scalars not arrays (R4).
// SIMT grid: x = pair (SIMT_THREADS threads per core); for C_out>16 the channels
// are split into 16-channel blocks (y dimension) so total threads/core stay
// within SIMT_THREADS. Blocks are capped to what P needs.
std::tuple<int64_t, int64_t, int64_t> calc_tiling(int64_t P, int64_t C_out)
{
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = platform->GetCoreNumAiv();
    if (coreNum <= 0) {
        coreNum = 1;
    }
    int64_t cblocks = (C_out + BLK - 1) / BLK;
    if (cblocks <= 0) {
        cblocks = 1;
    }
    int64_t nthreadsX = SIMT_THREADS / cblocks;
    if (nthreadsX <= 0) {
        nthreadsX = 1;
    }
    int64_t numBlocks = std::min<int64_t>(coreNum,
                                          (P + nthreadsX - 1) / nthreadsX);
    if (numBlocks <= 0) {
        numBlocks = 1;
    }
    return std::make_tuple(numBlocks, nthreadsX, cblocks);
}

// 4a. Per-pair matmul kernel (fast path for the real-model c16/c4x16 shapes).
//
// This is the "kernel-compute" half of a host-gather + kernel-compute hybrid:
//   host  flattens the valid (input, output, kernel-offset) triples in k-major order
//         and gathers input rows -> gathered (P, C_in), k_idx (P), s_idx (P);
//   kernel computes partial[s_idx[p]] = gathered[p] @ filters[k_idx[p]] for every pair;
//   host  scatters partial into output via output.index_add_(out_idx, partial).
//
// The pairs arrive k-major (indice_pairs is (K, 2, N)), so consecutive threads read
// the same filter matrix -> L2 locality. Each thread owns one pair and a 16-channel
// block (y grid) so the accumulator stays in 16 registers (a full C_OUT-wide
// accumulator blows the SIMT register budget for C_OUT=32/64). The store to the
// partial buffer is indexed through s_idx (= identity) so the compiler cannot prove
// the store address is affine in the pair loop and vectorize it into an illegal
// strided vector store (which faults the vector core on this arch).
template <typename T, int32_t COUT>
__simt_vf__ __aicore__ LAUNCH_BOUND(SIMT_THREADS) inline void IndiceConvPairMatmul(
    __gm__ const T *gathered, __gm__ const T *filters, __gm__ const int32_t *k_idx,
    __gm__ const int32_t *s_idx, __gm__ T *partial, int32_t P, int32_t C_in)
{
    const int32_t tx = Simt::GetThreadIdx<0>();
    const int32_t tnumX = Simt::GetThreadNum<0>();
    const int32_t cb = Simt::GetThreadIdx<1>();
    const int32_t blockIdx = Simt::GetBlockIdx();
    const int32_t blockNum = Simt::GetBlockNum();
    const int64_t totalThreadsX = static_cast<int64_t>(blockNum) * tnumX;
    const int32_t cbase = cb * BLK;

    for (int64_t p = tx + static_cast<int64_t>(blockIdx) * tnumX; p < P; p += totalThreadsX) {
        const int32_t k = k_idx[p];
        const int32_t si = s_idx[p];
        const __gm__ T *gr = gathered + p * static_cast<int64_t>(C_in);
        const __gm__ T *fr = filters + static_cast<int64_t>(k) * C_in * COUT + cbase;
        T acc[BLK];
#pragma unroll
        for (int32_t c = 0; c < BLK; ++c) {
            acc[c] = static_cast<T>(0);
        }
        for (int32_t i = 0; i < C_in; ++i) {
            const T gv = gr[i];
            // vectorize over the 16-channel block: fr[i*COUT .. i*COUT+15] is contiguous.
            const __gm__ float4 *fr4 = reinterpret_cast<const __gm__ float4 *>(fr + i * COUT);
#pragma unroll
            for (int32_t c = 0; c < BLK; c += 4) {
                float4 fv = fr4[c / 4];
                acc[c + 0] = FmaAcc(gv, fv.x, acc[c + 0]);
                acc[c + 1] = FmaAcc(gv, fv.y, acc[c + 1]);
                acc[c + 2] = FmaAcc(gv, fv.z, acc[c + 2]);
                acc[c + 3] = FmaAcc(gv, fv.w, acc[c + 3]);
            }
        }
        __gm__ T *srow = partial + static_cast<int64_t>(si) * COUT + cbase;
#pragma unroll
        for (int32_t c = 0; c < BLK; ++c) {
            srow[c] = acc[c];
        }
    }
}

// 4b. Generic fallback for any C_out (one thread per pair, scalar per output channel).
template <typename T>
__simt_vf__ __aicore__ LAUNCH_BOUND(SIMT_THREADS) inline void IndiceConvPairMatmulGeneric(
    __gm__ const T *gathered, __gm__ const T *filters, __gm__ const int32_t *k_idx,
    __gm__ const int32_t *s_idx, __gm__ T *partial, int32_t P, int32_t C_in, int32_t C_out)
{
    const int32_t tx = Simt::GetThreadIdx<0>();
    const int32_t tnumX = Simt::GetThreadNum<0>();
    const int32_t blockIdx = Simt::GetBlockIdx();
    const int32_t blockNum = Simt::GetBlockNum();
    const int64_t totalThreads = static_cast<int64_t>(blockNum) * tnumX;
    for (int64_t p = tx + static_cast<int64_t>(blockIdx) * tnumX; p < P; p += totalThreads) {
        const int32_t k = k_idx[p];
        const int32_t si = s_idx[p];
        const __gm__ T *gr = gathered + p * static_cast<int64_t>(C_in);
        const __gm__ T *fr = filters + static_cast<int64_t>(k) * C_in * C_out;
        for (int32_t c = 0; c < C_out; ++c) {
            T acc = static_cast<T>(0);
            for (int32_t i = 0; i < C_in; ++i) {
                acc = FmaAcc(gr[i], fr[i * static_cast<int64_t>(C_out) + c], acc);
            }
            partial[static_cast<int64_t>(si) * C_out + c] = acc;
        }
    }
}

// 5. Kernel dispatcher (2D grid: x = pair, y = 16-chan block).
// float uses the float4-vectorized path; half falls back to the scalar generic path.
template <typename T>
__global__ __aicore__ __vector__ void indice_conv_kernel(
    GM_ADDR gathered, GM_ADDR filters, GM_ADDR k_idx, GM_ADDR s_idx, GM_ADDR partial,
    int32_t P, int32_t C_in, int32_t C_out, int32_t nthreadsX, int32_t cblocks)
{
    const __gm__ T *gGm = reinterpret_cast<const __gm__ T *>(gathered);
    const __gm__ T *fGm = reinterpret_cast<const __gm__ T *>(filters);
    const __gm__ int32_t *kGm = reinterpret_cast<const __gm__ int32_t *>(k_idx);
    const __gm__ int32_t *sGm = reinterpret_cast<const __gm__ int32_t *>(s_idx);
    __gm__ T *partGm = reinterpret_cast<__gm__ T *>(partial);

    if constexpr (std::is_same<T, float>::value) {
        if (C_out == 16) {
            asc_vf_call<IndiceConvPairMatmul<float, 16>>(dim3(nthreadsX, 1, 1), gGm, fGm, kGm, sGm, partGm, P, C_in);
        } else if (C_out == 32) {
            asc_vf_call<IndiceConvPairMatmul<float, 32>>(dim3(nthreadsX, 2, 1), gGm, fGm, kGm, sGm, partGm, P, C_in);
        } else if (C_out == 64) {
            asc_vf_call<IndiceConvPairMatmul<float, 64>>(dim3(nthreadsX, 4, 1), gGm, fGm, kGm, sGm, partGm, P, C_in);
        } else {
            asc_vf_call<IndiceConvPairMatmulGeneric<float>>(dim3(nthreadsX * cblocks, 1, 1), gGm, fGm, kGm, sGm,
                                                            partGm, P, C_in, C_out);
        }
    } else {
        asc_vf_call<IndiceConvPairMatmulGeneric<T>>(dim3(nthreadsX * cblocks, 1, 1), gGm, fGm, kGm, sGm,
                                                    partGm, P, C_in, C_out);
    }
}

// 6. NPU dispatch
torch::Tensor indice_conv_npu(const torch::Tensor &gathered, const torch::Tensor &filters,
                              const torch::Tensor &k_idx, const torch::Tensor &s_idx,
                              int64_t P)
{
    // C1: all validation first, synchronously, before any device operation or launch.
    indice_conv_check(gathered, filters, k_idx, s_idx, P, /*checkDevice=*/true);

    const c10::OptionalDeviceGuard guard(gathered.device());

    auto partial = indice_conv_meta(gathered, filters, k_idx, s_idx, P);
    if (gathered.numel() == 0 || P == 0) {
        return partial;
    }
    int64_t C_in = filters.size(1);
    int64_t C_out = filters.size(2);
    int64_t numBlocks, nthreadsX, cblocks;
    std::tie(numBlocks, nthreadsX, cblocks) = calc_tiling(P, C_out);

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            gathered.scalar_type(), "indice_conv_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                using scalar_t = float;
                indice_conv_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    (GM_ADDR)gathered.data_ptr(), (GM_ADDR)filters.data_ptr(), (GM_ADDR)k_idx.data_ptr(),
                    (GM_ADDR)s_idx.data_ptr(), (GM_ADDR)partial.data_ptr(), (int32_t)P, (int32_t)C_in,
                    (int32_t)C_out, (int32_t)nthreadsX, (int32_t)cblocks);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                using scalar_t = half;
                indice_conv_kernel<scalar_t><<<numBlocks, nullptr, stream>>>(
                    (GM_ADDR)gathered.data_ptr(), (GM_ADDR)filters.data_ptr(), (GM_ADDR)k_idx.data_ptr(),
                    (GM_ADDR)s_idx.data_ptr(), (GM_ADDR)partial.data_ptr(), (int32_t)P, (int32_t)C_in,
                    (int32_t)C_out, (int32_t)nthreadsX, (int32_t)cblocks);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("IndiceConv", acl_call);
    return partial;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("indice_conv", indice_conv_npu);
}

} // namespace IndiceConv
} // namespace ops_multimodal_fusion
