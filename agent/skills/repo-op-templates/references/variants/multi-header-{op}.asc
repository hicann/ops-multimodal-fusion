/*!
 * \file {op}.asc
 * \brief {Op} operator template (multi-header fusion variant) for Ascend NPU
 *
 * // TEMPLATE: 本文件是「复杂融合算子多头文件变体」的薄 .asc（只做 host / schema / 注册），
 * //           kernel 与 tiling 逻辑拆到同目录头文件里。适用于 tiling 复杂、有多套模板实例的融合算子。
 * // TEMPLATE: 全局替换 {op}(snake_case) / {Op}(PascalCase)。参照真实算子：applications/llm/swi_glu/arch35/swi_glu.asc。
 * // TEMPLATE: 真实复杂算子通常把职责拆成多个同目录头，例如 swi_glu 的
 * //           {op}_apt.h（__global__ launcher）/ {op}_host_tiling.h（host CalcTiling）/
 * //           {op}_tiling.h（TilingData 结构体，host+kernel 共享）/ {op}_impl.hpp（kernel 类）。
 * //           本模板用单个伴随头 {op}_impl.h 示意上述拆分职责，落地时可再拆细。
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"

// TEMPLATE: 引入同目录头 —— launcher + host tiling + TilingData 结构体 + kernel 类（本示意合并为一个头）。
#include "{op}_impl.h"

namespace ops_multimodal_fusion {
namespace {Op} {

// 1. Schema
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("{op}(Tensor x) -> Tensor");
}

// 2. Meta function
// TEMPLATE: 按融合算子实际语义推断输出 shape/dtype（本示意直接同形状 empty_like）。
torch::Tensor {op}_meta(const torch::Tensor &x)
{
    TORCH_CHECK(x.dim() >= 1, "{op}: input must have at least 1 dimension");
    return torch::empty_like(x);
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("{op}", {op}_meta);
}

// 3. NPU dispatch
// TEMPLATE: host 侧 contiguous -> 拆 row/col -> 映射 dtype -> 调 CalcTiling 得 config（blockDim + tiling struct）
//           -> 按 dtype <<<>>> 直调对应 launcher，tiling struct 按值随 <<<>>> 传入 kernel。
torch::Tensor {op}_npu(const torch::Tensor &x)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto x_contig = x.contiguous();
    auto z = {op}_meta(x_contig);
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t lastDim = x_contig.size(-1);
    int64_t colLen = lastDim;
    int64_t rowLen = x_contig.numel() / lastDim;

    int32_t dtype;
    switch (x_contig.scalar_type()) {
        case torch::kFloat32:  dtype = {Op}Host::DT_FLOAT; break;
        case torch::kFloat16:  dtype = {Op}Host::DT_FLOAT16; break;
        case torch::kBFloat16: dtype = {Op}Host::DT_BF16; break;
        default: TORCH_CHECK(false, "{op}: unsupported dtype ", x_contig.scalar_type());
    }

    auto config = {Op}Host::Calc{Op}Tiling(
        static_cast<uint64_t>(rowLen), static_cast<uint64_t>(colLen), dtype);

    auto x_ptr = (GM_ADDR)x_contig.data_ptr();
    auto z_ptr = (GM_ADDR)z.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x_contig.scalar_type(), "{op}_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                {op}_fp32<<<config.blockDim, nullptr, stream>>>(
                    x_ptr, z_ptr, nullptr, config.tiling);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                {op}_fp16<<<config.blockDim, nullptr, stream>>>(
                    x_ptr, z_ptr, nullptr, config.tiling);
            })
            AT_DISPATCH_CASE(torch::kBFloat16, [&] {
                {op}_bf16<<<config.blockDim, nullptr, stream>>>(
                    x_ptr, z_ptr, nullptr, config.tiling);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("{Op}", acl_call);
    return z;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("{op}", {op}_npu);
}

} // namespace {Op}
} // namespace ops_multimodal_fusion
