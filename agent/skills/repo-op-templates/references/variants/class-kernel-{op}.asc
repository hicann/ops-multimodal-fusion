/*!
 * \file {op}.asc
 * \brief {Op} operator template (class-kernel variant) for Ascend NPU
 *
 * // TEMPLATE: 本文件是「class 化 kernel 变体」骨架，适用于需要行归约 / 多执行路径的算子（如 normalization）。
 * // TEMPLATE: 与单文件 elementwise 骨架的区别：kernel 逻辑封装进模板类 Kernel{Op}<T>（Init/Process），
 * //           __global__ 只是薄 launcher，按 dtype 实例化不同的类型参数再 <<<>>> 直调。
 * // TEMPLATE: 全局替换 {op}(snake_case) / {Op}(PascalCase)。参照真实算子：applications/llm/layer_norm/arch35/layer_norm.asc。
 * // TEMPLATE: 本骨架按「整行放得下 UB」的单路径写；若 hidden 很大需分块，另加 tiled 路径（见 layer_norm.asc 的 ProcessTiled）。
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>
#include <cmath>

namespace ops_multimodal_fusion {
namespace {Op} {

constexpr int64_t BLOCK_BYTES = 32;

__aicore__ inline int64_t AlignBytes(int64_t elems, int64_t elemSize)
{
    return (elems * elemSize + BLOCK_BYTES - 1) / BLOCK_BYTES * BLOCK_BYTES;
}

// 1. Register the operator's schema
// TEMPLATE: 按算子实际入参改写；如需权重/偏置参数（layer_norm 风格）在此追加 Tensor 参数。
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("{op}(Tensor x, float eps=1e-6) -> Tensor");
}

// 2. Meta function
// TEMPLATE: 校验维度约定（本骨架假设 x 为 2D: (rows, hiddenSize)），推断输出 shape/dtype。
torch::Tensor {op}_meta(const torch::Tensor &x, double eps)
{
    TORCH_CHECK(x.dim() == 2, "x must be 2D tensor (rows, hidden_size)");
    auto y = torch::empty_like(x);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("{op}", {op}_meta);
}

// 3. Kernel class: 每行独立处理，封装 Init（地址/UB 分配）+ Process（逐行归约与计算）
template <typename T>
class Kernel{Op} {
    static_assert(sizeof(T) == 2 || sizeof(T) == 4, "Only float and half supported");

public:
    __aicore__ inline Kernel{Op}() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y,
        int64_t totalRows, int64_t hiddenSize, int64_t rowsPerBlock, float epsilon)
    {
        hiddenSize_ = hiddenSize;
        epsilon_    = epsilon;
        invHiddenSize_ = 1.0f / static_cast<float>(hiddenSize);

        int64_t blockIdx = AscendC::GetBlockIdx();
        int64_t remaining = totalRows - blockIdx * rowsPerBlock;
        curRows_ = (remaining < rowsPerBlock) ? remaining : rowsPerBlock;

        // TEMPLATE: 多核地址偏移 —— 每个 block 负责 rowsPerBlock 行。
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockIdx * rowsPerBlock * hiddenSize);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockIdx * rowsPerBlock * hiddenSize);

        int64_t bytes = AlignBytes(hiddenSize, sizeof(T));
        alignedHidden_ = bytes / static_cast<int64_t>(sizeof(T));
        pipe_.InitBuffer(xInQueue_, 2, bytes);
        pipe_.InitBuffer(yOutQueue_, 2, bytes);
        pipe_.InitBuffer(reduceBuf_, BLOCK_BYTES);
    }

    __aicore__ inline void Process()
    {
        if (curRows_ <= 0) return;
        for (int64_t row = 0; row < curRows_; ++row) {
            ProcessRow(row);
        }
    }

private:
    __aicore__ inline AscendC::DataCopyExtParams CopyParams(int64_t bytes)
    {
        AscendC::DataCopyExtParams p;
        p.blockCount = 1;  p.blockLen = bytes;
        p.srcStride  = 0;  p.dstStride = 0;
        return p;
    }

    __aicore__ inline void ProcessRow(int64_t row)
    {
        int64_t H = hiddenSize_;
        int64_t n = alignedHidden_;

        // CopyIn: 取一整行
        AscendC::DataCopyPadExtParams<T> pad{true, 0, 0, static_cast<T>(0)};
        auto xLocal = xInQueue_.template AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[row * H], CopyParams(H * sizeof(T)), pad);
        xInQueue_.EnQue(xLocal);
        xLocal = xInQueue_.template DeQue<T>();

        // TEMPLATE: 行归约示例 —— 求行和/均值。ReduceSum 会把对齐补齐的尾元也算进去，
        //           如尾元非 0 需按 layer_norm.asc 的做法逐个减掉；此处假设整行对齐。
        auto reduce = reduceBuf_.template Get<T>();
        AscendC::ReduceSum(reduce, xLocal, xLocal, n);
        float mean = static_cast<float>(reduce.GetValue(0)) * invHiddenSize_;

        // TEMPLATE: 核心逐元素计算 —— 替换为本算子语义（本例：减去行均值）。
        auto yLocal = yOutQueue_.template AllocTensor<T>();
        AscendC::Adds(yLocal, xLocal, static_cast<T>(-mean), n);
        AscendC::PipeBarrier<PIPE_V>();
        yOutQueue_.EnQue(yLocal);
        xInQueue_.FreeTensor(xLocal);

        // CopyOut
        yLocal = yOutQueue_.template DeQue<T>();
        AscendC::DataCopyPad(yGm_[row * H], yLocal, CopyParams(H * sizeof(T)));
        yOutQueue_.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> xInQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> yOutQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> reduceBuf_;
    int64_t hiddenSize_    = 0;
    int64_t curRows_       = 0;
    int64_t alignedHidden_ = 0;
    float epsilon_       = 0.0f;
    float invHiddenSize_ = 0.0f;
};

// 4. Thin __global__ launchers: 每个 dtype 一个薄壳，实例化对应类型的 Kernel{Op}<T>
__global__ __aicore__ __vector__ void {op}_fp32(
    GM_ADDR x, GM_ADDR y,
    int64_t totalRows, int64_t hiddenSize, int64_t rowsPerBlock, float epsilon)
{
    Kernel{Op}<float> op;
    op.Init(x, y, totalRows, hiddenSize, rowsPerBlock, epsilon);
    op.Process();
}

__global__ __aicore__ __vector__ void {op}_fp16(
    GM_ADDR x, GM_ADDR y,
    int64_t totalRows, int64_t hiddenSize, int64_t rowsPerBlock, float epsilon)
{
    Kernel{Op}<half> op;
    op.Init(x, y, totalRows, hiddenSize, rowsPerBlock, epsilon);
    op.Process();
}

// 5. NPU dispatch function
// TEMPLATE: host 侧按行切核（rowsPerBlock / blockNum），按 dtype 选择对应 launcher 直调。
torch::Tensor {op}_npu(const torch::Tensor &x, double eps)
{
    const c10::OptionalDeviceGuard guard(x.device());
    auto y = {op}_meta(x, eps);

    int64_t totalRows = x.size(0);
    int64_t hiddenSize = x.size(1);
    if (totalRows <= 0 || hiddenSize <= 0) {
        return y;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    float epsilon = static_cast<float>(eps);

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = ascendcPlatform->GetCoreNumAiv();
    TORCH_CHECK(coreNum > 0, "coreNum must be positive.");
    int64_t rowsPerBlock = (totalRows + coreNum - 1) / coreNum;
    int64_t blockNum = (totalRows + rowsPerBlock - 1) / rowsPerBlock;
    blockNum = std::max(blockNum, static_cast<int64_t>(1));

    auto x_ptr = (GM_ADDR)x.data_ptr();
    auto y_ptr = (GM_ADDR)y.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            x.scalar_type(), "{op}_npu",
            AT_DISPATCH_CASE(torch::kFloat32, [&] {
                {op}_fp32<<<blockNum, nullptr, stream>>>(
                    x_ptr, y_ptr, totalRows, hiddenSize, rowsPerBlock, epsilon);
            })
            AT_DISPATCH_CASE(torch::kFloat16, [&] {
                {op}_fp16<<<blockNum, nullptr, stream>>>(
                    x_ptr, y_ptr, totalRows, hiddenSize, rowsPerBlock, epsilon);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("{Op}", acl_call);
    return y;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("{op}", {op}_npu);
}

} // namespace {Op}
} // namespace ops_multimodal_fusion
